# Preserve ordinary source as text, and hashed upstream inputs byte for byte.
* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
# Source handoff patches carry exact bytes, including upstream CRLF witnesses.
# A single-space blank context line is required unified-diff syntax.
*.patch -text whitespace=-blank-at-eol,-blank-at-eof
**/fixtures/upstream/rustc-checkout/** -text -whitespace
vendor/** -text

# Original pinned parser lexer fixtures intentionally contain whitespace errors.
vendor/ra-ap-parser/test_data/** -whitespace
