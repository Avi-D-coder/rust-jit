+                    left: PrimitiveType::Usize,
+                    right: PrimitiveType::Usize,
+                }
+            );
+            assert_eq!(
+                recipe.recipe().exit,
+                RecipeExit::Next(index.pc(right, Phase::Entry).unwrap())
+            );
+            let after_rhs = parsed
+                .initial_thunk(&handle, &index, &index.pc(id, Phase::Operand(1)).unwrap())
+                .unwrap();
