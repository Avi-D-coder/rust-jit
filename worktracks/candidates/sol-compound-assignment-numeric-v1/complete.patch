+//! Supplemental LRR transaction controls with genuine source-lowered operands.
+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    ir::{op::Op, pc::Phase, recipe::VerifiedRecipe},
+    source::snapshot::{CfgSet, SourceBlob},
+    syntax::{outline::BodyHandle, parse::ParsedFile},
+    vm::{
+        numeric::PanicKind,
+        step::{StepOutcome, step},
+    },
+};
+struct Context {
+    parsed: ParsedFile,
+    handle: BodyHandle,
+    frame: Frame,
+    store: GuestStore,
+}
+fn reached(fuel: u64) -> (Context, VerifiedRecipe, NodeId) {
+    let text = "fn main(){let mut a=255u8;a+=1u8;}";
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity::current(),
+    )
+    .unwrap();
+    let outline = parsed
+        .outline(
+            Digest::of_bytes(b"LRR compound transaction source"),
+            vec![],
+            &CfgSet::guest_default(),
+        )
+        .unwrap();
+    let handle = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap()
+        .clone();
+    let body = parsed.index_body(&handle, Default::default()).unwrap();
+    let pc = body.pc(NodeId(0), Phase::Entry).unwrap();
+    let mut store = GuestStore::new(1, 1000, 1_000_000).unwrap();
+    let mut frame = Frame::new(body, pc, &mut store).unwrap();
+    frame.set_fuel_limit(fuel).unwrap();
+    let mut c = Context {
+        parsed,
+        handle,
+        frame,
+        store,
+    };
+    for _ in 0..64 {
+        let recipe = c
+            .parsed
+            .initial_thunk(&c.handle, &c.frame.body, c.frame.pc())
+            .unwrap();
+        if let Some(binding) = recipe.recipe().operations.iter().find_map(|op| match op {
+            Op::CompoundHint { binding, .. } => Some(*binding),
+            _ => None,
+        }) {
+            return (c, recipe, binding);
+        }
+        assert!(matches!(
+            step(&mut c.frame, &mut c.store, &recipe).unwrap(),
+            StepOutcome::Next(_) | StepOutcome::Dispatch
+        ));
+    }
+    panic!("source compound PC not reached");
+}
+#[test]
+fn source_suffixed_compound_overflow_preserves_destination_and_publishes_no_result() {
+    let (mut c, entry, binding) = reached(1000);
+    let destination = c.frame.binding_cell_for_test(binding).unwrap();
+    let before = c.store.state(destination).unwrap();
+    let epoch = c.store.location_epoch(destination).unwrap();
+    assert!(matches!(
+        step(&mut c.frame, &mut c.store, &entry).unwrap(),
+        StepOutcome::Next(_)
+    ));
+    for _ in 0..32 {
+        let recipe = c
+            .parsed
+            .initial_thunk(&c.handle, &c.frame.body, c.frame.pc())
+            .unwrap();
+        if recipe
+            .recipe()
+            .operations
+            .iter()
+            .any(|op| matches!(op, Op::NumericBinary { .. }))
+        {
+            let computed = recipe
+                .recipe()
+                .operations
+                .iter()
+                .find_map(|op| match op {
+                    Op::NumericBinary { destination, .. } => Some(*destination),
+                    _ => None,
+                })
+                .unwrap();
+            assert!(c.frame.cell(computed).is_err());
+            let handles = c.store.budget().handles();
+            let StepOutcome::GuestPanic(panic) = step(&mut c.frame, &mut c.store, &recipe).unwrap()
+            else {
+                panic!("source u8 compound must overflow");
+            };
+            assert_eq!(panic.kind, PanicKind::Overflow);
+            assert_eq!(c.store.state(destination).unwrap(), before);
+            assert_eq!(c.store.location_epoch(destination).unwrap(), epoch);
+            // Existing numeric entry prepares one frame-owned result cell
+            // before checked arithmetic, but publishes no result or ticket.
+            let result_cell = c.frame.cell(computed).unwrap();
+            assert_eq!(c.store.state(result_cell).unwrap(), CellState::Uninit);
+            assert_eq!(
+                c.store.owner(result_cell).unwrap(),
+                CellOwner::FrameSlot {
+                    frame: c.frame.anchor,
+                    slot: computed.0,
+                }
+            );
+            assert_eq!(c.store.budget().handles(), handles + 1);
+            assert_eq!(c.frame.counters.started_by_opcode[16], 0);
+            assert_eq!(c.frame.counters.started_by_opcode[10], 1);
+            assert_eq!(c.frame.status(), FrameStatus::Panicked);
+            return;
+        }
+        assert!(matches!(
+            step(&mut c.frame, &mut c.store, &recipe).unwrap(),
+            StepOutcome::Next(_) | StepOutcome::Dispatch
+        ));
+    }
+    panic!("checked source arithmetic not reached");
+}
+#[test]
+fn forged_rigid_binding_source_refuses_before_compound_opcode_or_operand_entry() {
+    let (mut c, recipe, binding) = reached(1000);
+    let cell = c.frame.binding_cell_for_test(binding).unwrap();
+    let state = c.store.state(cell).unwrap();
+    c.frame.binding_sources[binding.0 as usize] = Some(crate::traits::term::TyTerm::Param(
+        crate::traits::term::ParamKey {
+            definition: c.frame.body.body().definition,
+            ordinal: 0,
+        },
+    ));
+    let source = c.frame.binding_sources[binding.0 as usize].clone();
+    let fuel = c.frame.fuel.snapshot().used;
+    let handles = c.store.budget().handles();
+    let bytes = c.store.budget().bytes();
+    let error = step(&mut c.frame, &mut c.store, &recipe).unwrap_err();
+    assert_eq!(error.code, "LRR-E-GENERIC-BINDING");
+    assert_eq!(c.frame.fuel.snapshot().used, fuel);
+    assert_eq!(c.frame.counters.started_by_opcode[40], 0);
+    assert_eq!(c.frame.counters.started_by_opcode[10], 0);
+    assert_eq!(c.frame.counters.started_by_opcode[16], 0);
+    assert_eq!(c.store.state(cell).unwrap(), state);
+    assert_eq!(c.frame.binding_sources[binding.0 as usize], source);
+    assert_eq!(c.store.budget().handles(), handles);
+    assert_eq!(c.store.budget().bytes(), bytes);
+}
+#[test]
+fn compound_fuel_refusal_keeps_exact_initialized_prefix_without_operand_replay() {
+    let (probe, _, _) = reached(1000);
+    let prefix = probe.frame.fuel.snapshot().used;
+    let (mut c, recipe, binding) = reached(prefix);
+    let cell = c.frame.binding_cell_for_test(binding).unwrap();
+    let state = c.store.state(cell).unwrap();
+    let operations = c.frame.counters.operations_started;
+    let handles = c.store.budget().handles();
+    let bytes = c.store.budget().bytes();
+    let error = step(&mut c.frame, &mut c.store, &recipe).unwrap_err();
+    assert_eq!(error.code, "LRR-E-RUNTIME-RESOURCE");
+    assert_eq!(error.message, "guest opcode fuel exhausted");
+    assert_eq!(c.frame.fuel.snapshot().used, prefix);
+    assert_eq!(c.frame.counters.operations_started, operations);
+    assert_eq!(c.frame.counters.started_by_opcode[40], 0);
+    assert_eq!(c.frame.counters.started_by_opcode[10], 0);
+    assert_eq!(c.store.state(cell).unwrap(), state);
+    assert_eq!(c.store.budget().handles(), handles);
+    assert_eq!(c.store.budget().bytes(), bytes);
+}
