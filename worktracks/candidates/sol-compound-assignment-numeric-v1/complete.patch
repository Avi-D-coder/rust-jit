+/// Intrinsic literal source types are independent of printed type names and
+/// runtime substitution. This proof reads no digits, values, descriptors or
+/// later uses; an unsuffixed literal is deliberately not closed by fallback.
+fn compound_intrinsic_initializer(
+    mut expression: ast::Expr,
+) -> Result<Option<PrimitiveType>, Diagnostic> {
+    fn suffix(suffix: Option<&str>) -> Option<PrimitiveType> {
+        Some(match suffix? {
+            "i8" => PrimitiveType::I8,
+            "i16" => PrimitiveType::I16,
+            "i32" => PrimitiveType::I32,
+            "i64" => PrimitiveType::I64,
+            "isize" => PrimitiveType::Isize,
+            "u8" => PrimitiveType::U8,
+            "u16" => PrimitiveType::U16,
+            "u32" => PrimitiveType::U32,
+            "u64" => PrimitiveType::U64,
+            "usize" => PrimitiveType::Usize,
+            "f32" => PrimitiveType::F32,
+            "f64" => PrimitiveType::F64,
+            _ => return None,
+        })
+    }
+    let mut negative = false;
+    let mut inverted = false;
+    for _ in 0..256 {
+        if expression
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()))
+        {
+            return Ok(None);
+        }
+        match expression {
+            ast::Expr::ParenExpr(group) => {
+                let Some(inner) = group.expr() else {
+                    return Ok(None);
+                };
+                expression = inner;
+            }
+            ast::Expr::PrefixExpr(prefix) => {
+                match prefix.op_token().as_ref().map(|token| token.text()) {
+                    Some("-") => negative = true,
+                    Some("!") => inverted = true,
+                    _ => return Ok(None),
+                }
+                let Some(inner) = prefix.expr() else {
+                    return Ok(None);
+                };
+                expression = inner;
+            }
+            ast::Expr::Literal(literal) => {
+                let token = literal.token();
+                let primitive = match token.kind() {
+                    SyntaxKind::INT_NUMBER => {
+                        ast::IntNumber::cast(token).and_then(|number| suffix(number.suffix()))
+                    }
+                    SyntaxKind::FLOAT_NUMBER => {
+                        ast::FloatNumber::cast(token).and_then(|number| suffix(number.suffix()))
+                    }
+                    _ => None,
+                };
+                let Some(primitive) = primitive else {
+                    return Ok(None);
+                };
+                if negative
+                    && matches!(
+                        primitive,
+                        PrimitiveType::U8
+                            | PrimitiveType::U16
+                            | PrimitiveType::U32
+                            | PrimitiveType::U64
+                            | PrimitiveType::Usize
+                    )
+                    || inverted && matches!(primitive, PrimitiveType::F32 | PrimitiveType::F64)
+                {
+                    return Ok(None);
+                }
+                return Ok(Some(primitive));
+            }
+            _ => return Ok(None),
+        }
+    }
+    Err(Diagnostic::new(
+        "LRR-E-BODY-INDEX-LIMIT",
+        "compound intrinsic initializer source nesting budget".into(),
+    ))
+}
