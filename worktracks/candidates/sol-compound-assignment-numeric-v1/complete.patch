+//! Source-only compound assignment admission controls, testing pending.
+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    ir::op::AssignKind,
+    source::snapshot::{CfgSet, SourceBlob},
+    syntax::body_index::BodyIndexLimits,
+};
+const LOOP: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/for-loop-while/loop-break-cont.rs"
+);
+const REFERENCE: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/binop/compound-assign-by-ref.rs"
+);
+fn world(text: &str, edition: u16) -> (ParsedFile, BodyHandle, BodyIndex) {
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    let outline = parsed
+        .outline(
+            Digest::of_bytes(b"LRR compound source world"),
+            vec![],
+            &CfgSet::guest_default(),
+        )
+        .unwrap();
+    let handle = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap()
+        .clone();
+    let index = parsed
+        .index_body(&handle, BodyIndexLimits::default())
+        .unwrap();
+    (parsed, handle, index)
+}
+fn at(index: &BodyIndex, handle: &BodyHandle, absolute: usize, written: &str) -> NodeId {
+    let start = u32::try_from(absolute).unwrap() - handle.range.start;
+    index
+        .nodes()
+        .iter()
+        .find(|node| {
+            node.range.start == start
+                && node.range.end == start + u32::try_from(written.len()).unwrap()
+        })
+        .unwrap()
+        .id
+}
+fn entry(text: &str, edition: u16, written: &str) -> Result<VerifiedRecipe, Diagnostic> {
+    let (parsed, handle, index) = world(text, edition);
+    let id = at(&index, &handle, text.find(written).unwrap(), written);
+    parsed.initial_thunk(&handle, &index, &index.pc(id, Phase::Entry).unwrap())
+}
+fn kind(recipe: &VerifiedRecipe) -> AssignKind {
+    recipe
+        .recipe()
+        .operations
+        .iter()
+        .find_map(|op| match op {
+            Op::CompoundHint { kind, .. } => Some(*kind),
+            _ => None,
+        })
+        .unwrap()
+}
+#[test]
+fn unchanged_loop_suffixed_local_selects_primitive_rhs_before_lhs_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (parsed, handle, index) = world(LOOP, edition);
+        let written = "i += 1_usize";
+        let occurrences = LOOP.match_indices(written).collect::<Vec<_>>();
+        assert_eq!(occurrences.len(), 3);
+        for (absolute, _) in occurrences {
+            let id = at(&index, &handle, absolute, written);
+            let node = &index.nodes()[id.0 as usize];
+            assert_eq!(node.operands.len(), 2);
+            let left = node.operands[0];
+            let right = node.operands[1];
+            let recipe = parsed
+                .initial_thunk(&handle, &index, &index.pc(id, Phase::Entry).unwrap())
+                .unwrap();
