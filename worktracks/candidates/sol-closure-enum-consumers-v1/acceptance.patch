+//! Genuine source/key/shape component regressions, not whole upstream execution.
+use super::*;
+use crate::{
+    core::digest::{StableEncode, StableEncoder},
+    traits::{
+        subst::{self, Substitution},
+        term::{Binder, BoundKind, GenericArg, InferVarKey, ParamKey, TyTerm},
+        unify::Unifier,
+    },
+};
+fn genuine(
+    text: &str,
+) -> (
+    World,
+    Frame,
+    GuestStore,
+    TyTerm,
+    crate::runtime::shape::TypeId,
+) {
+    let mut w = world(text, 2024);
+    let p = plan(&mut w);
+    let (frame, mut store) = reached(&p, &w);
+    let mut instance = typed(&mut w, p, &frame, &mut store);
+    let (term, descriptor) = instance.runtime_view(&store).unwrap();
+    while !matches!(
+        instance.cleanup_next(&mut store).unwrap(),
+        CleanupStep::Complete
+    ) {}
+    (w, frame, store, term, descriptor)
+}
+#[test]
+fn closure_source_atom_survives_substitution_shift_and_empty_instantiation() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let mut substitution = Substitution::default();
+    let p = ParamKey {
+        definition: Digest::of_bytes(b"ordinary generic parameter"),
+        ordinal: 0,
+    };
+    substitution.insert(p, GenericArg::Type(t.clone())).unwrap();
+    assert_eq!(substitution.apply(&TyTerm::Param(p)).unwrap(), t);
+    assert_eq!(substitution.apply(&t).unwrap(), t);
+    assert_eq!(subst::shift(&t, 9, 0).unwrap(), t);
+    assert!(subst::validate_closed(&t).is_ok());
+}
+#[test]
+fn closure_atoms_are_exact_source_identity_not_signature_or_capture_layout_equality() {
+    let (_, _, _, a, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let (_, _, _, b, _) = genuine("#![no_implicit_prelude] fn main(){let g=||{};}");
+    assert_ne!(a, b);
+    assert_ne!(a.fingerprint(), b.fingerprint());
+    let mut u = Unifier::new(Digest::of_bytes(b"closure source equality only"));
+    assert!(u.unify(&a, &a).is_ok());
+    assert!(u.unify(&a, &b).is_err());
+}
+#[test]
+fn closure_source_unification_retains_atom_without_callable_or_copy_grant() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let transaction = Digest::of_bytes(b"closure source unification");
+    let variable = InferVarKey {
+        transaction,
+        ordinal: 0,
+    };
+    let mut u = Unifier::new(transaction);
+    u.unify(&TyTerm::Infer(variable), &t).unwrap();
+    assert_eq!(u.binding(variable), Some(&t));
+}
+#[test]
+fn closure_detection_visits_array_reference_tuple_function_and_nominal_arguments() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let nested = TyTerm::Function(Box::new(Binder {
+        variables: vec![BoundKind::Type],
+        value: crate::traits::term::FunctionSignature {
+            parameters: vec![TyTerm::Tuple(vec![TyTerm::Ref(
+                crate::traits::term::RegionTerm::Static,
+                false,
+                Box::new(TyTerm::Array(
+                    Box::new(t.clone()),
+                    crate::traits::term::ConstTerm::Value(0),
+                )),
+            )])],
+            result: Box::new(TyTerm::Nominal(
+                Digest::of_bytes(b"genuine metadata container identity"),
+                vec![GenericArg::Type(t)],
+            )),
+        },
+    }));
+    assert!(nested.contains_closure().unwrap());
+    assert!(
+        !TyTerm::Primitive(PrimitiveType::Usize)
+            .contains_closure()
+            .unwrap()
+    );
+}
+#[test]
+fn closure_stable_encoding_has_its_own_retained_tag_and_key_domain() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let TyTerm::Closure(key) = t else { panic!() };
+    let mut e = StableEncoder::new(TyTerm::DOMAIN);
+    e.u32(15);
+    e.record(key.as_ref());
+    assert_eq!(
+        TyTerm::Closure(std::sync::Arc::clone(&key)).fingerprint(),
+        e.finish()
+    );
+    assert_ne!(
+        TyTerm::Closure(std::sync::Arc::clone(&key)).fingerprint(),
+        TyTerm::Tuple(vec![]).fingerprint()
+    );
+}
+#[test]
+fn dedicated_descriptor_never_derives_tuple_copy_or_native_layout_authority() {
+    let (_, _, s, _, id) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let d = s.type_descriptor(id).unwrap();
+    assert_eq!(
+        d.shape,
+        crate::runtime::shape::ShapeCategory::ClosureEnvironment
+    );
