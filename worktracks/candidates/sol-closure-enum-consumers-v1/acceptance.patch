+#[test]
+fn scalar_literal_construction_keeps_existing_numeric_record_materialization() {
+    let mut s = GuestStore::new(1, 10000, 10_000_000).unwrap();
+    let guard = s.begin_construction(&[TypeId(6)]).unwrap();
+    let ticket = s.integer_literal(false, 1, "1".into()).unwrap();
+    assert_eq!(s.peek_ticket(ticket).unwrap().type_id, 0);
+    s.construction_push(guard, 0, ticket).unwrap();
+    let ty = s
+        .intern_type(crate::runtime::shape::TypeKey::Tuple(Box::new([TypeId(6)])))
+        .unwrap();
+    let ticket = s.commit_construction(guard, ty).unwrap();
+    while let Some(field) = s.aggregate_cleanup_next(ticket).unwrap() {
+        s.discard(field).unwrap();
+    }
+    s.discard(ticket).unwrap();
+}
