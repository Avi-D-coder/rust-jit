+    assert!(matches!(
+        d.key.as_ref(),
+        crate::runtime::shape::TypeKey::ClosureEnvironment(_)
+    ));
+}
+#[test]
+fn transaction_scan_keeps_concrete_closure_distinct_from_inference_frontier() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    assert!(!crate::frontend::call_contracts::contains_transaction_term(
