+#[test]
+fn pure_substitution_preserves_closure_key_inside_higher_ranked_binder() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let f = TyTerm::Function(Box::new(Binder {
+        variables: vec![BoundKind::Type],
