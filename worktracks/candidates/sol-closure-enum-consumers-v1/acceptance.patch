+#[test]
+fn owning_editions_remain_distinct_actual_closure_keys() {
+    let mut keys = vec![];
+    for edition in [2015, 2018, 2021, 2024] {
+        let mut w = world("#![no_implicit_prelude] fn main(){let f=||{};}", edition);
+        let p = plan(&mut w);
+        let (f, mut s) = reached(&p, &w);
+        let mut v = typed(&mut w, p, &f, &mut s);
+        let (t, _) = v.runtime_view(&s).unwrap();
+        assert!(t.validate_opaque_shape().is_ok());
+        assert!(!keys.contains(&t));
+        keys.push(t);
+        v.cleanup_next(&mut s).unwrap();
+    }
+}
+#[test]
+fn closure_projection_and_owning_read_frontiers_preserve_actual_published_owner() {
+    let mut w = world("#![no_implicit_prelude] fn main(){let f=||{};}", 2024);
+    let p = plan(&mut w);
+    let (mut f, mut s) = reached(&p, &w);
+    let v = typed(&mut w, p, &f, &mut s);
+    let v = pending(&mut w, v, &mut f, &s);
+    let r = publish(&mut w, v, &mut f, &mut s);
+    let cell = f.cell(r.slot()).unwrap();
+    let before = s.owner_inventory_for_test();
+    assert_eq!(
+        s.admit_owning_read(cell).unwrap_err().code,
+        "LRR-E-CLOSURE-REPRESENTATION"
+    );
+    assert!(
+        s.project_tuple(&crate::runtime::place::Place::cell(cell), 0)
+            .is_err()
+    );
+    assert_eq!(before, s.owner_inventory_for_test());
+    f.cleanup_published_closure(&r, &mut s).unwrap();
+}
