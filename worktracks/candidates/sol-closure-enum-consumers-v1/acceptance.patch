+#[test]
+fn genuine_source_type_publishes_shared_arc_key_without_reallocating_on_view_clone() {
+    let mut w = world("#![no_implicit_prelude] fn main(){let f=||{};}", 2024);
+    let p = plan(&mut w);
+    let (f, mut s) = reached(&p, &w);
+    let mut v = typed(&mut w, p, &f, &mut s);
+    let a = v.publication_source().symbolic();
+    let b = v.publication_source().symbolic();
+    let (TyTerm::Closure(a), TyTerm::Closure(b)) = (&a, &b) else {
+        panic!()
+    };
+    assert!(std::sync::Arc::ptr_eq(a, b));
+    let cloned = TyTerm::Closure(std::sync::Arc::clone(a));
+    let TyTerm::Closure(c) = cloned else { panic!() };
+    assert!(std::sync::Arc::ptr_eq(a, &c));
+    assert!(
+        v.publication_source().metadata_bytes().unwrap()
+            >= std::mem::size_of::<crate::traits::closure_identity::ClosureKey>()
+    );
+    v.cleanup_next(&mut s).unwrap();
+}
+#[test]
+fn substitution_arc_clone_preserves_allocation_and_key_contents_without_copy_permission() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let copied = Substitution::default().apply(&t).unwrap();
+    let (TyTerm::Closure(a), TyTerm::Closure(b)) = (&t, &copied) else {
+        panic!()
+    };
+    assert!(std::sync::Arc::ptr_eq(a, b));
+    assert_eq!(t.fingerprint(), copied.fingerprint());
+}
+#[test]
+fn independent_symbolic_owner_accounts_retained_key_after_genuine_source_owner_retires() {
+    let (_, _, _, t, _) = genuine("#![no_implicit_prelude] fn main(){let f=||{};}");
+    let bytes = std::mem::size_of::<crate::traits::closure_identity::ClosureKey>();
+    assert_eq!(t.heap_bytes(), Some(bytes));
+    let nested = TyTerm::Tuple(vec![t.clone(), t]);
+    assert!(nested.heap_bytes().unwrap() >= 2 * bytes);
+    assert!(nested.validate_opaque_shape().is_ok());
+}
