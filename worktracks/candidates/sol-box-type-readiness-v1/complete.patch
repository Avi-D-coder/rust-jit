+//! Pure symbolic substitution controls, not solved source trait witnesses.
+use super::*;
+use crate::{ir::op::PrimitiveType, traits::term::ConstTerm};
+#[test]
+fn exact_box_target_substitution_preserves_unit_scalar_and_array_terms() {
+    let owner = Digest::of_bytes(b"disclosed source-data impl owner");
+    let target = ParamKey {
+        definition: owner,
+        ordinal: 0,
+    };
+    for pointee in [
+        TyTerm::Primitive(PrimitiveType::Unit),
+        TyTerm::Primitive(PrimitiveType::Isize),
+        TyTerm::Array(
+            Box::new(TyTerm::Primitive(PrimitiveType::I8)),
+            ConstTerm::Value(300),
+        ),
+    ] {
+        assert_eq!(
+            substitute_target_parameter(&TyTerm::Param(target), target, &pointee).unwrap(),
+            pointee
+        );
+    }
+}
+#[test]
+fn same_ordinal_from_foreign_owner_is_not_the_box_target_parameter() {
+    let actual = ParamKey {
+        definition: Digest::of_bytes(b"source actual impl"),
+        ordinal: 0,
+    };
+    let foreign = ParamKey {
+        definition: Digest::of_bytes(b"source other impl"),
+        ordinal: 0,
+    };
+    let term = TyTerm::Param(foreign);
+    assert_eq!(
+        substitute_target_parameter(&term, actual, &TyTerm::Primitive(PrimitiveType::Unit))
+            .unwrap(),
+        term
+    );
+}
