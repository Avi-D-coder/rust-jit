+//! Preregistered original source components; never full Box execution.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::key::OutlineKey,
+    source::box_contract_headers::capture_box_targets,
+    source::{
+        box_type_headers::{
+            BoxPointeeSyntax, BoxTypeRole, capture_box_impl_parameters, capture_box_type_header,
+        },
+        changes::SourceSelection,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{
+        box_source_headers::{BoxHeaderRole as Role, capture_box_headers},
+        parse::ParsedFile,
+    },
+    traits::term::TyTerm,
+};
+const SCALAR: &str = include_str!("../../fixtures/upstream/rustc-checkout/tests/ui/box/new-box.rs");
+const ARRAYS: &str = include_str!(
+    "../../fixtures/upstream/rustc-checkout/tests/ui/box/box-fixed-array-coerce-unsized-match.rs"
+);
+const BOXED: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/library/alloc/src/boxed.rs");
+fn parsed(text: &str, edition: u16, module: &[&str]) -> (ParsedFile, SourceSelection, CfgSet) {
+    let cfg = CfgSet::guest_default();
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    let source = SourceSelection {
+        path: SourcePath::new(format!("{}.rs", module.join("/"))).unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(module[0].as_bytes()),
+            module_path: module[1..].iter().map(|s| s.to_string()).collect(),
+            cfg: cfg.fingerprint(),
+        },
+    };
+    (parsed, source, cfg)
+}
+fn definition(
+    parsed: &ParsedFile,
+    source: &SourceSelection,
+    cfg: &CfgSet,
+    name: &str,
+) -> lrr::source::manifest::DefKey {
+    parsed
+        .outline(
+            source.outline.crate_key,
+            source.outline.module_path.clone(),
+            cfg,
+        )
+        .unwrap()
+        .items
+        .into_iter()
+        .find(|row| row.def_key.declared_name == name)
+        .unwrap()
+        .def_key
+}
+#[test]
+fn original_box_scalar_header_uses_exact_parameter_source_in_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (parsed, source, cfg) = parsed(SCALAR, edition, &["consumer"]);
+        let def = definition(&parsed, &source, &cfg, "f");
+        let site = capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::Parameter(0))
+            .unwrap();
+        assert_eq!(site.box_name(), Some("Box"));
+        assert!(matches!(site.pointee(),BoxPointeeSyntax::Name(name) if name=="isize"));
+        assert_eq!(site.source(), &source);
+        assert_eq!(site.definition(), &def);
+    }
+}
+#[test]
+fn original_box_array_function_pointer_results_retain_length_source_ranges() {
+    let (parsed, source, cfg) = parsed(ARRAYS, 2024, &["consumer"]);
+    let def = definition(&parsed, &source, &cfg, "foo");
+    for (ordinal, count) in [(0, "1"), (1, "20"), (2, "300"), (3, "4000")] {
+        let site = capture_box_type_header(
+            &parsed,
+            &source,
+            &cfg,
+            &def,
+            BoxTypeRole::FunctionPointerResult(ordinal),
+        )
+        .unwrap();
+        let BoxPointeeSyntax::ArrayName { element, length } = site.pointee() else {
+            panic!("original array shape absent")
+        };
+        assert_eq!(element, "i8");
+        assert_eq!(&ARRAYS[length.start as usize..length.end as usize], count);
+    }
+}
+#[test]
+fn original_dyn_header_stays_an_explicit_source_type_prerequisite() {
+    let (parsed, source, cfg) = parsed(SCALAR, 2024, &["consumer"]);
+    let def = definition(&parsed, &source, &cfg, "g");
+    let site =
+        capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::Parameter(0)).unwrap();
+    assert!(matches!(site.pointee(), BoxPointeeSyntax::Unsupported));
+}
+#[test]
+fn actual_box_impl_target_captures_owning_generic_ordinal_not_a_printed_type() {
+    let (parsed, source, cfg) = parsed(BOXED, 2024, &["alloc", "boxed"]);
+    let headers = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    let targets = capture_box_targets(&parsed, &headers, &cfg).unwrap();
+    let binder = capture_box_impl_parameters(&parsed, &headers, &targets, &cfg).unwrap();
+    let target = targets.target(Role::DerefImpl).unwrap();
+    let TyTerm::Param(key) = binder.target_term() else {
+        panic!("actual owning Target parameter absent")
+    };
+    assert_eq!(key.definition, binder.definition().fingerprint());
+    assert_eq!(key.ordinal, binder.parameters()[0].ordinal);
+    assert_eq!(binder.target_identity(), target.fingerprint());
+}
+#[test]
+fn source_box_type_header_refuses_foreign_definition_and_cfg() {
+    let (parsed, source, cfg) = parsed(SCALAR, 2024, &["consumer"]);
+    let mut def = definition(&parsed, &source, &cfg, "f");
+    def.crate_key = Digest::of_bytes(b"foreign");
+    assert!(
+        capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::Parameter(0)).is_err()
+    );
+    let def = definition(&parsed, &source, &cfg, "f");
+    let mut changed = cfg;
+    changed.atoms.insert("foreign_cfg".into());
+    assert!(
+        capture_box_type_header(&parsed, &source, &changed, &def, BoxTypeRole::Parameter(0))
+            .is_err()
+    );
+}
+
+#[test]
+fn disclosed_unit_header_adapter_retains_tuple_unit_without_name_lookup() {
+    // Original Unit Box::new(()) call readiness remains in the predecessor;
+    // this outside-upstream adapter isolates a declared Unit source header.
+    let (parsed, source, cfg) =
+        parsed("fn unit_box()->Box<()> {Box::new(())}", 2024, &["consumer"]);
+    let def = definition(&parsed, &source, &cfg, "unit_box");
+    let site = capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::Result).unwrap();
+    assert!(matches!(site.pointee(), BoxPointeeSyntax::Unit));
+}
