diff --git a/crates/lrr/src/traits/box_target_substitution.rs b/crates/lrr/src/traits/box_target_substitution.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/traits/box_target_substitution.rs
@@ -0,0 +1,258 @@
+//! Exact source-owned Box Target instantiation. M019–M023 goal/witness/projection
+//! fulfillment is absent: the result is conditional data, never a solved witness.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::memo::Database,
+    frontend::{
+        box_source_admission::compiler_contract::{
+            CurrentBoxLibraryContract, type_readiness::CurrentBoxPointee,
+        },
+        compile_input_catalog::CompileInputCatalog,
+    },
+    source::{box_type_headers::BoxImplParameters, changes::PreparedSourceView},
+    syntax::{box_source_headers::BoxHeaderRole as Role, signatures::GenericKind},
+    traits::{
+        subst::Substitution,
+        term::{
+            Binder, BoundKind, GenericArg, ParamEnv, ParamKey, ProjectionKey, TraitRef, TyTerm,
+        },
+    },
+};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-BOX-TARGET-SOURCE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "Box Target source substitution metadata bound".into(),
+    )
+}
+/// Driver retains/replays full opaque source/library proof before using this
+/// conditional plan. Its identity is agreement data, never a WitnessKey.
+pub(crate) struct ConditionalBoxTarget<'a> {
+    library: &'a CurrentBoxLibraryContract<'a>,
+    pointee: &'a CurrentBoxPointee,
+    binder: &'a BoxImplParameters,
+    environment: ParamEnv,
+    predicates: Vec<TraitRef>,
+    goal: TraitRef,
+    projection: ProjectionKey,
+    instantiated: TyTerm,
+    source_candidate: Digest,
+    identity: Digest,
+    bytes: usize,
+}
+pub(crate) enum BoxGoalReadiness<'a> {
+    GoalEngineRequired {
+        goal: &'a TraitRef,
+        projection: &'a ProjectionKey,
+        caller_environment: &'a ParamEnv,
+        impl_environment: &'a ParamEnv,
+        predicates: &'a [TraitRef],
+        candidate: Digest,
+        other_candidates: &'a [Digest],
+        trait_header: &'a crate::syntax::outline::HeaderRecipe,
+    },
+}
+impl<'a> ConditionalBoxTarget<'a> {
+    pub(crate) fn capture_current(
+        db: &Database,
+        source: &PreparedSourceView,
+        compiler: &CompileInputCatalog,
+        library: &'a CurrentBoxLibraryContract<'a>,
+        pointee: &'a CurrentBoxPointee,
+        binder: &'a BoxImplParameters,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        library.revalidate(db, source, compiler)?;
+        pointee.revalidate(db, source, compiler, library)?;
+        let header = library.header(Role::DerefImpl)?;
+        if binder.definition() != header.definition()
+            || binder.header() != header.header()
+            || binder.target_identity() != library.impl_target().fingerprint()
+            || !library
+                .source_headers()
+                .iter()
+                .any(|file| file.source() == binder.source())
+        {
+            return Err(fault(
+                "Box Target impl/binder is not actual current selected library source",
+            ));
+        }
+        let parameters = binder.parameters();
+        let TyTerm::Param(target) = binder.target_term() else {
+            return Err(fault("Box Target is not actual owning parameter"));
+        };
+        if parameters.len() != 2
+            || parameters.iter().any(|p| p.kind != GenericKind::Type)
+            || target.definition != binder.definition().fingerprint()
+            || target.ordinal != parameters[0].ordinal
+        {
+            return Err(fault("Box owning source generic shape differs"));
+        }
+        let allocator = ParamKey {
+            definition: binder.definition().fingerprint(),
+            ordinal: parameters[1].ordinal,
+        };
+        let measured = pointee.term().measure().ok_or_else(limit)?;
+        let bytes = std::mem::size_of::<Self>()
+            .checked_add(library.metadata_bytes())
+            .and_then(|n| n.checked_add(pointee.metadata_bytes()))
+            .and_then(|n| n.checked_add(binder.metadata_bytes()))
+            .and_then(|n| n.checked_add(measured.1.checked_mul(8)?))
+            .and_then(|n| {
+                n.checked_add(
+                    32 * std::mem::size_of::<TyTerm>() + 8 * std::mem::size_of::<TraitRef>(),
+                )
+            })
+            .filter(|n| *n <= byte_limit && byte_limit <= 32 << 20)
+            .ok_or_else(limit)?;
+        let global = TyTerm::Nominal(
+            library.header(Role::Global)?.definition().fingerprint(),
+            vec![],
+        );
+        let implementation_parameters =
+            vec![(BoundKind::Type, *target), (BoundKind::Type, allocator)];
+        // Captured approved impl has T:?Sized (no implicit Sized predicate) and
+        // A:Allocator with A's normal implicit Sized bound. These are assumptions,
+        // not concrete proof of Global or the requested Deref goal.
+        let environment = ParamEnv::new(
+            binder.definition().fingerprint(),
+            implementation_parameters,
+            vec![
+                Binder {
+                    variables: vec![],
+                    value: TraitRef {
+                        trait_key: library.header(Role::Allocator)?.definition().fingerprint(),
+                        self_ty: TyTerm::Param(allocator),
+                        args: vec![],
+                    },
+                },
+                Binder {
+                    variables: vec![],
+                    value: TraitRef {
+                        trait_key: library.header(Role::Sized)?.definition().fingerprint(),
+                        self_ty: TyTerm::Param(allocator),
+                        args: vec![],
+                    },
+                },
+            ],
+        )?;
+        let mut substitution = Substitution::default();
+        substitution.insert(*target, GenericArg::Type(pointee.term().clone()))?;
+        substitution.insert(allocator, GenericArg::Type(global.clone()))?;
+        let mut predicates = Vec::new();
+        predicates
+            .try_reserve_exact(environment.predicates().len())
+            .map_err(|_| limit())?;
+        for predicate in environment.predicates() {
+            if !predicate.variables.is_empty() || !predicate.value.args.is_empty() {
+                return Err(fault(
+                    "Box impl predicate binder requires ordered goal integration",
+                ));
+            }
+            predicates.push(TraitRef {
+                trait_key: predicate.value.trait_key,
+                self_ty: substitution.apply(&predicate.value.self_ty)?,
+                args: vec![],
+            });
+        }
+        let instantiated =
+            substitute_target_parameter(binder.target_term(), *target, pointee.term())?;
+        let boxed = TyTerm::Nominal(
+            library.header(Role::OwnedBox)?.definition().fingerprint(),
+            vec![
+                GenericArg::Type(pointee.term().clone()),
+                GenericArg::Type(global),
+            ],
+        );
+        let goal = TraitRef {
+            trait_key: library.header(Role::DerefTrait)?.definition().fingerprint(),
+            self_ty: boxed,
+            args: vec![],
+        };
+        let projection = ProjectionKey {
+            trait_ref: goal.clone(),
+            item: library.trait_target().definition().fingerprint(),
+            item_args: vec![],
+        };
+        let source_candidate = header
+            .impl_source()
+            .ok_or_else(|| fault("Box active source impl identity absent"))?;
+        let mut e = StableEncoder::new("lrr/v1/conditional-source-box-target-substitution");
+        e.digest(library.identity());
+        e.digest(pointee.identity());
+        e.record(binder);
+        e.record(&environment);
+        e.sequence(&predicates, |e, goal| e.record(goal));
+        e.record(&goal);
+        e.record(&projection);
+        e.record(&instantiated);
+        e.digest(source_candidate);
+        Ok(Self {
+            library,
+            pointee,
+            binder,
+            environment,
+            predicates,
+            goal,
+            projection,
+            instantiated,
+            source_candidate,
+            identity: e.finish(),
+            bytes,
+        })
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+        compiler: &CompileInputCatalog,
+    ) -> Result<(), Diagnostic> {
+        self.library.revalidate(db, source, compiler)?;
+        self.pointee
+            .revalidate(db, source, compiler, self.library)?;
+        if self.binder.target_identity() != self.library.impl_target().fingerprint() {
+            return Err(fault("Box Target source substitution changed"));
+        }
+        Ok(())
+    }
+    pub(crate) fn instantiated_target(&self) -> &TyTerm {
+        &self.instantiated
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn readiness(&self) -> Result<BoxGoalReadiness<'_>, Diagnostic> {
+        Ok(BoxGoalReadiness::GoalEngineRequired {
+            goal: &self.goal,
+            projection: &self.projection,
+            caller_environment: self.pointee.environment(),
+            impl_environment: &self.environment,
+            predicates: &self.predicates,
+            candidate: self.source_candidate,
+            other_candidates: self.library.unknown_candidates(),
+            trait_header: self.library.header(Role::DerefTrait)?.header(),
+        })
+    }
+}
+/// Pure symbolic transform, deliberately not a source authority constructor.
+/// Foreign owner keys remain rigid because existing Substitution is simultaneous.
+fn substitute_target_parameter(
+    target: &TyTerm,
+    parameter: ParamKey,
+    pointee: &TyTerm,
+) -> Result<TyTerm, Diagnostic> {
+    let mut substitution = Substitution::default();
+    substitution.insert(parameter, GenericArg::Type(pointee.clone()))?;
+    substitution.apply(target)
+}
