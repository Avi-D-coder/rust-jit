+/// Finite library semantics for source type preparation only. No call/PC,
+/// concrete type/goal witness or execution permission is created by this join.
+pub(crate) struct CurrentBoxLibraryContract<'a> {
+    facet: &'a BoxCompilerFacet,
+    catalog: &'a CurrentBoxSourceCatalog,
+    targets: &'a [Arc<BoxTargetHeaders>],
+    trait_target: &'a BoxTargetHeader,
+    impl_target: &'a BoxTargetHeader,
+    dependencies: Vec<DependencyStamp>,
+    identity: Digest,
+    bytes: usize,
+}
+impl<'a> CurrentBoxLibraryContract<'a> {
+    pub(crate) fn capture_current(
+        db: &Database,
+        source: &PreparedSourceView,
+        compiler: &CompileInputCatalog,
+        facet: &'a BoxCompilerFacet,
+        catalog: &'a CurrentBoxSourceCatalog,
+        targets: &'a [Arc<BoxTargetHeaders>],
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        catalog.revalidate(db, source)?;
+        facet.require_current(&source.selection().outline.parse.profile, compiler)?;
+        if targets.len() > 5 || byte_limit > MAX_BYTES {
+            return Err(limit());
+        }
+        for headers in &catalog.headers {
+            facet.require_reviewed_source(headers)?;
+        }
+        let trait_target = find_target(targets, Role::DerefTrait)?;
+        let impl_target = find_target(targets, Role::DerefImpl)?;
+        let mut bytes = std::mem::size_of::<Self>()
+            .checked_add(catalog.metadata_bytes())
+            .and_then(|n| n.checked_add(facet.metadata_bytes()))
+            .and_then(|n| n.checked_add(8 * std::mem::size_of::<DependencyStamp>()))
+            .ok_or_else(limit)?;
+        for target in targets {
+            bytes = bytes
+                .checked_add(target.metadata_bytes())
+                .filter(|n| *n <= byte_limit)
+                .ok_or_else(limit)?;
+        }
+        if bytes > byte_limit {
+            return Err(limit());
+        }
+        let mut dependencies = Vec::new();
+        dependencies.try_reserve_exact(8).map_err(|_| limit())?;
+        for target in [trait_target, impl_target] {
+            validate_target(
+                db,
+                catalog,
+                targets,
+                target,
+                &mut dependencies,
+                &mut bytes,
+                byte_limit,
+            )?;
+        }
+        let mut e = StableEncoder::new("lrr/v1/current-source-box-library-contract");
+        e.digest(facet.fingerprint());
+        e.digest(catalog.identity());
+        e.record(trait_target);
+        e.record(impl_target);
+        e.sequence(&dependencies, |e, stamp| e.record(stamp));
+        Ok(Self {
+            facet,
+            catalog,
+            targets,
+            trait_target,
+            impl_target,
+            dependencies,
+            identity: e.finish(),
+            bytes,
+        })
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+        compiler: &CompileInputCatalog,
+    ) -> Result<(), Diagnostic> {
+        self.catalog.revalidate(db, source)?;
+        self.facet
+            .require_current(&source.selection().outline.parse.profile, compiler)?;
+        for stamp in &self.dependencies {
+            let DependencyStamp::Input { key, fingerprint } = stamp else {
+                return Err(fault("Box library dependencies must be actual inputs"));
+            };
+            if db
+                .published_input(key)
+                .is_none_or(|(_, current)| current != *fingerprint)
+            {
+                return Err(fault("Box library Target publication changed"));
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn header(
+        &self,
+        role: Role,
+    ) -> Result<&crate::syntax::box_source_headers::BoxSourceHeader, Diagnostic> {
+        self.catalog.header(role)
+    }
+    pub(crate) fn source_headers(&self) -> &[Arc<BoxSourceHeaders>] {
+        &self.catalog.headers
+    }
+    pub(crate) fn impl_target(&self) -> &BoxTargetHeader {
+        self.impl_target
+    }
+    pub(crate) fn trait_target(&self) -> &BoxTargetHeader {
+        self.trait_target
+    }
+    pub(crate) fn unknown_candidates(&self) -> &[Digest] {
+        &self.catalog.unknown
+    }
+    pub(crate) fn target_captures(&self) -> &[Arc<BoxTargetHeaders>] {
+        self.targets
+    }
+}
