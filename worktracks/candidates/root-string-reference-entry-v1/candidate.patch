+    frame
+        .initialize_parameters(&packet, &parameter_contracts, store)
+        .unwrap();
+    let effects = (
+        store.budget().handles(),
+        store.budget().bytes(),
+        frame.fuel_snapshot(),
+    );
+    assert!(
+        frame
+            .initialize_parameters(&packet, &parameter_contracts, store)
+            .is_err()
+    );
+    assert_eq!(
+        (
+            store.budget().handles(),
+            store.budget().bytes(),
+            frame.fuel_snapshot()
+        ),
+        effects
+    );
+    let mut scopes = vec![scope];
