+#[test]
+fn original_byte_comparison_does_not_infer_rhs_descriptor_from_lhs_layout() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = start_source(ORIGINAL, edition, 1000);
+        let contexts = macros.contexts().unwrap();
+        let (id, op) = reach_comparison(&mut db, &mut run, &contexts);
+        let Op::NumericBinary { left, right, .. } = op else {
+            panic!("comparison")
+        };
+        assert!(matches!(
+            run.frame.source_view(left).unwrap(),
+            Some(TyTerm::Ref(_, false, _))
+        ));
+        assert!(matches!(
+            run.frame.source_view(right).unwrap(),
+            Some(TyTerm::Ref(_, false, _))
+        ));
+        // The real source recipes reached both operands. A numeric hint may
+        // select scalar width, but cannot demand identical PartialEq operands.
+        assert_eq!(run.frame.hint(right).unwrap(), None);
+        run.prepare_macro_byte_comparison(&mut db, &contexts, id)
+            .unwrap();
+        assert!(
+            run.frame
+                .prepare_byte_comparison(&op, &run.store)
+                .unwrap()
+                .is_some()
+        );
+        db.finish_run().unwrap();
+    }
+}
