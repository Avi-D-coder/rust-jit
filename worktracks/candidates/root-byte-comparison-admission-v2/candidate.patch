diff --git a/crates/lrr/src/runtime/cell_byte_comparison_tests.rs b/crates/lrr/src/runtime/cell_byte_comparison_tests.rs
--- a/crates/lrr/src/runtime/cell_byte_comparison_tests.rs
+++ b/crates/lrr/src/runtime/cell_byte_comparison_tests.rs
@@ -246,3 +246,92 @@
     assert_eq!(fuel.snapshot().used, 257);
     assert!(cursor.terminal);
 }
+
+#[test]
+fn new_comparison_admission_rejects_foreign_stale_or_already_advanced_cursors_without_effects() {
+    let mut first = store();
+    let left = operand(&mut first, b"left", &[7; 600], ByteLiteralTarget::Array);
+    let right = operand(&mut first, b"right", &[7; 600], ByteLiteralTarget::Slice);
+    let mut second = store();
+    let other_left = operand(&mut second, b"left", &[7; 600], ByteLiteralTarget::Array);
+    let other_right = operand(&mut second, b"right", &[7; 600], ByteLiteralTarget::Slice);
+    assert_eq!(
+        (left.bits(), right.bits()),
+        (other_left.bits(), other_right.bits())
+    );
+    let mut cursor = first.prepare_static_byte_comparison(left, right).unwrap();
+    let before = (
+        first.budget.handles(),
+        first.budget.bytes(),
+        second.budget.handles(),
+        second.budget.bytes(),
+    );
+    first
+        .admit_static_byte_comparison(&cursor, left, right)
+        .unwrap();
+    assert!(
+        second
+            .admit_static_byte_comparison(&cursor, other_left, other_right)
+            .is_err()
+    );
+    assert!(
+        first
+            .admit_static_byte_comparison(&cursor, right, left)
+            .is_err()
+    );
+    let mut fuel = RunFuel::new(600).unwrap();
+    assert_eq!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticByteComparisonPoll::Dispatch { pairs: 256 }
+    );
+    assert!(
+        first
+            .admit_static_byte_comparison(&cursor, left, right)
+            .is_err()
+    );
+    assert_eq!(fuel.snapshot().used, 256);
+    assert_eq!(
+        (
+            first.budget.handles(),
+            first.budget.bytes(),
+            second.budget.handles(),
+            second.budget.bytes()
+        ),
+        before
+    );
+    // Continuation remains valid for its existing owner; refusal to start a new
+    // operation must neither consume it nor turn its prior charges into a replay.
+    assert_eq!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticByteComparisonPoll::Dispatch { pairs: 256 }
+    );
+    assert_eq!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticByteComparisonPoll::Complete {
+            equal: true,
+            pairs: 88
+        }
+    );
+    assert!(
+        first
+            .admit_static_byte_comparison(&cursor, left, right)
+            .is_err()
+    );
+    let cursor = first.prepare_static_byte_comparison(left, right).unwrap();
+    let reference = first.reference_from_cell(left).unwrap();
+    let root = first.references.get(reference).unwrap().root.cell;
+    first.cells.get_mut(root).unwrap().location_epoch += 1;
+    let before = (first.budget.handles(), first.budget.bytes());
+    assert!(
+        first
+            .admit_static_byte_comparison(&cursor, left, right)
+            .is_err()
+    );
+    assert_eq!((first.budget.handles(), first.budget.bytes()), before);
+}
