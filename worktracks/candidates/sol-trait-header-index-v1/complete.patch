diff --git a/xtask/tests/trait_header_index.rs b/xtask/tests/trait_header_index.rs
new file mode 100644
--- /dev/null
+++ b/xtask/tests/trait_header_index.rs
@@ -0,0 +1,365 @@
+//! Source-component M019 controls. Original execution/diagnostics remain unexecuted.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    source::snapshot::{CfgSet, SourceBlob, SourcePath},
+    syntax::{outline::ScopeKey, parse::ParsedFile},
+    traits::{
+        header::{HeaderCaptureLimits, HeaderKind, HeaderTypeForm, PredicateKind},
+        index::HeaderIndexModel,
+    },
+};
+fn capture(text: &str, unit: u8, edition: u16) -> lrr::traits::header::CapturedSourceHeaders {
+    let mut profile = ProfileIdentity::current();
+    profile.edition = edition;
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        profile,
+    )
+    .unwrap();
+    parsed
+        .capture_trait_headers(
+            SourcePath::new("fixture.rs").unwrap(),
+            ScopeKey {
+                crate_key: Digest([unit; 32]),
+                module_path: vec![],
+                owner: None,
+            },
+            &CfgSet::guest_default(),
+            HeaderCaptureLimits::default(),
+        )
+        .unwrap()
+}
+#[test]
+fn m019_original_conditional_blanket_keeps_predicates_and_no_body_tokens() {
+    let source = include_str!(
+        "../../fixtures/upstream/rustc-checkout/tests/ui/traits/multidispatch-conditional-impl-not-considered.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let catalog = capture(source, 31, edition);
