+        let index =
+            HeaderIndexModel::from_fragments(vec![a, b], HeaderCaptureLimits::default()).unwrap();
+        index.check_all_buckets_against_full_catalog().unwrap();
+        let reverse = HeaderIndexModel::from_fragments(
+            vec![
+                capture("trait P {} impl<T> P for (T,) {}", 40, 2018),
