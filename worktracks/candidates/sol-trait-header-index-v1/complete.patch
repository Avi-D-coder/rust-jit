+//! Conservative deterministic candidate metadata. Membership is never fulfillment.
+use super::header::*;
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{InputKey, InputValue},
+        key::{BucketKey, QueryKey, SealedNameKey},
+        memo::Database,
+        seals::{SealDomain, SealKey},
+        value::QueryValue,
+    },
+    frontend::names::NameLookup,
+    source::manifest::{ItemKind, Namespace},
+    syntax::outline::ScopeKey,
+};
+use std::collections::BTreeMap;
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+enum TraitBucket {
+    Exact(Digest),
+    Inherent,
+    Unresolved,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+enum SelfBucket {
+    Nominal(Digest),
+    Tuple(u32),
+    Array,
+    Slice,
+    Reference(bool),
+    Never,
+    Blanket,
+    Unresolved,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct Row {
+    fragment: usize,
+    header: usize,
+    identity: Digest,
+    trait_bucket: TraitBucket,
+    self_bucket: SelfBucket,
+}
+impl StableEncode for Row {
+    const DOMAIN: &'static str = "lrr/v5/trait-candidate-row/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.identity);
+        match self.trait_bucket {
+            TraitBucket::Exact(d) => {
+                e.u8(0);
+                e.digest(d);
+            }
+            TraitBucket::Inherent => e.u8(1),
+            TraitBucket::Unresolved => e.u8(2),
+        }
+        match self.self_bucket {
+            SelfBucket::Nominal(d) => {
+                e.u8(0);
+                e.digest(d);
+            }
+            SelfBucket::Tuple(n) => {
+                e.u8(1);
+                e.u32(n);
+            }
+            SelfBucket::Array => e.u8(2),
+            SelfBucket::Slice => e.u8(3),
+            SelfBucket::Reference(m) => {
+                e.u8(4);
+                e.bool(m);
+            }
+            SelfBucket::Never => e.u8(5),
+            SelfBucket::Blanket => e.u8(6),
+            SelfBucket::Unresolved => e.u8(7),
+        }
+    }
+}
+fn bare_path(t: &HeaderType) -> Option<&str> {
+    let HeaderTypeForm::Path(segments) = &t.form else {
+        return None;
+    };
+    if segments.len() != 1
+        || segments[0].absolute_separator
+        || segments[0].type_anchor
+        || segments[0].parenthesized
+    {
+        return None;
+    }
+    segments[0].name.as_deref()
+}
+fn constructor(t: &HeaderType, nominal: impl FnOnce(&str) -> Option<Digest>) -> SelfBucket {
+    match &t.form {
+        HeaderTypeForm::Parameter(_) => SelfBucket::Blanket,
+        HeaderTypeForm::Tuple(v) => {
+            u32::try_from(v.len()).map_or(SelfBucket::Unresolved, SelfBucket::Tuple)
+        }
+        HeaderTypeForm::Array(..) => SelfBucket::Array,
+        HeaderTypeForm::Slice(_) => SelfBucket::Slice,
+        HeaderTypeForm::Reference { mutable, .. } => SelfBucket::Reference(*mutable),
+        HeaderTypeForm::Never => SelfBucket::Never,
+        _ => bare_path(t)
+            .and_then(nominal)
+            .map_or(SelfBucket::Unresolved, SelfBucket::Nominal),
+    }
+}
+fn unique<T>(mut values: impl Iterator<Item = T>) -> Option<T> {
+    let first = values.next()?;
+    if values.next().is_some() {
+        None
+    } else {
+        Some(first)
+    }
+}
+/// Disclosed property-test model only. It has no catalog certificate or current
+/// Type-namespace proof, so its candidates cannot become executable selection.
+#[derive(Debug)]
+pub struct HeaderIndexModel {
+    fragments: Vec<CapturedSourceHeaders>,
+    rows: Vec<Row>,
+    buckets: BTreeMap<(TraitBucket, SelfBucket), Vec<usize>>,
+    metadata_bytes: usize,
+    metadata_ceiling: usize,
+}
+impl HeaderIndexModel {
+    pub fn from_fragments(
+        mut fragments: Vec<CapturedSourceHeaders>,
+        limits: HeaderCaptureLimits,
+    ) -> Result<Self, Diagnostic> {
+        let limits = limits.validate()?;
+        if fragments.len() > 4096 {
+            return Err(limit());
+        }
+        fragments.sort_by_key(StableEncode::fingerprint);
+        if fragments
+            .windows(2)
+            .any(|p| p[0].fingerprint() == p[1].fingerprint())
+        {
+            return Err(fault("duplicate header source attachment"));
+        }
+        let count = fragments.iter().try_fold(0usize, |n, f| {
+            n.checked_add(f.headers.len())
+                .filter(|n| *n <= limits.headers)
+                .ok_or_else(limit)
+        })?;
+        let bytes = fragments.iter().try_fold(
+            fragments
+                .capacity()
+                .checked_mul(std::mem::size_of::<CapturedSourceHeaders>())
+                .ok_or_else(limit)?,
+            |n, f| n.checked_add(f.metadata_bytes).ok_or_else(limit),
+        )?;
+        let mut rows = Vec::new();
+        rows.try_reserve_exact(count).map_err(|_| limit())?;
+        for (fi, f) in fragments.iter().enumerate() {
+            for (hi, h) in f.headers.iter().enumerate() {
+                if let HeaderKind::Impl {
+                    trait_type,
+                    self_type,
+                    ..
+                } = &h.kind
+                {
+                    let trait_bucket = match trait_type {
+                        None => TraitBucket::Inherent,
+                        Some(t) => bare_path(t)
+                            .and_then(|name| {
+                                unique(
+                                    f.headers
+                                        .iter()
+                                        .filter(|d| {
+                                            matches!(d.kind, HeaderKind::Trait { alias: false, .. })
+                                                && d.context.scope == h.context.scope
+                                                && d.definition.declared_name == name
+                                        })
+                                        .map(|d| d.definition.fingerprint()),
+                                )
+                            })
+                            .map_or(TraitBucket::Unresolved, TraitBucket::Exact),
+                    };
+                    let self_bucket = constructor(self_type, |name| {
+                        unique(
+                            f.nominals
+                                .iter()
+                                .filter(|d| {
+                                    d.context.scope == h.context.scope
+                                        && d.definition.declared_name == name
+                                })
+                                .map(|d| d.definition.fingerprint()),
+                        )
+                    });
+                    rows.push(Row {
+                        fragment: fi,
+                        header: hi,
+                        identity: h.exact_identity(),
+                        trait_bucket,
+                        self_bucket,
+                    });
+                }
+            }
+        }
+        rows.sort_by_key(|r| r.identity);
+        if rows.windows(2).any(|p| p[0].identity == p[1].identity) {
+            return Err(fault("duplicate impl source identity"));
+        }
+        Self::finish(fragments, rows, bytes, limits)
+    }
+    fn finish(
+        fragments: Vec<CapturedSourceHeaders>,
+        rows: Vec<Row>,
+        bytes: usize,
+        limits: HeaderCaptureLimits,
+    ) -> Result<Self, Diagnostic> {
+        // BTree nodes and each one-row capacity are conservatively charged before insertion.
+        let overhead = rows
+            .len()
+            .checked_mul(256)
+            .and_then(|n| n.checked_add(rows.capacity().checked_mul(std::mem::size_of::<Row>())?))
+            .ok_or_else(limit)?;
+        let mut bytes = bytes
+            .checked_add(overhead)
+            .filter(|n| *n <= limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        let mut buckets = BTreeMap::<(TraitBucket, SelfBucket), Vec<usize>>::new();
+        for (ordinal, row) in rows.iter().enumerate() {
+            let b = buckets
+                .entry((row.trait_bucket, row.self_bucket))
+                .or_default();
+            b.try_reserve_exact(1).map_err(|_| limit())?;
+            b.push(ordinal);
+        }
+        let capacity_bytes = buckets.values().try_fold(0usize, |n, b| {
+            n.checked_add(b.capacity().checked_mul(std::mem::size_of::<usize>())?)
+                .ok_or_else(limit)
+        })?;
+        bytes = bytes
+            .checked_add(capacity_bytes)
+            .filter(|n| *n <= limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        Ok(Self {
+            fragments,
+            rows,
+            buckets,
+            metadata_bytes: bytes,
+            metadata_ceiling: limits.metadata_bytes,
+        })
+    }
+    pub fn header_count(&self) -> usize {
+        self.fragments.iter().map(|f| f.headers.len()).sum()
+    }
+    pub fn metadata_bytes(&self) -> usize {
+        self.metadata_bytes
+    }
+    fn indexed(&self, t: TraitBucket, s: SelfBucket) -> Result<Vec<Digest>, Diagnostic> {
+        self.metadata_bytes
+            .checked_add(
+                self.rows
+                    .len()
+                    .checked_mul(std::mem::size_of::<Digest>())
+                    .ok_or_else(limit)?,
+            )
+            .filter(|n| *n <= self.metadata_ceiling)
+            .ok_or_else(limit)?;
+        let mut ids = Vec::new();
+        ids.try_reserve_exact(self.rows.len())
+            .map_err(|_| limit())?;
+        for ((tb, sb), entries) in &self.buckets {
+            if (if t == TraitBucket::Inherent {
+                *tb == TraitBucket::Inherent
+            } else {
+                *tb != TraitBucket::Inherent
+                    && (*tb == t || *tb == TraitBucket::Unresolved || t == TraitBucket::Unresolved)
+            }) && (*sb == s
+                || matches!(sb, SelfBucket::Blanket | SelfBucket::Unresolved)
+                || matches!(s, SelfBucket::Blanket | SelfBucket::Unresolved))
+            {
+                for ordinal in entries {
+                    ids.push(self.rows[*ordinal].identity);
+                }
+            }
+        }
+        ids.sort_unstable();
+        Ok(ids)
+    }
+    fn full_catalog(&self, t: TraitBucket, s: SelfBucket) -> Result<Vec<Digest>, Diagnostic> {
+        // Deliberately no bucket iteration: all retained headers are inspected independently.
+        self.metadata_bytes
+            .checked_add(
+                self.rows
+                    .len()
+                    .checked_mul(2 * std::mem::size_of::<Digest>())
+                    .ok_or_else(limit)?,
+            )
+            .filter(|n| *n <= self.metadata_ceiling)
+            .ok_or_else(limit)?;
+        let mut ids = Vec::new();
+        ids.try_reserve_exact(self.rows.len())
+            .map_err(|_| limit())?;
+        for fragment in &self.fragments {
+            for header in &fragment.headers {
+                if !matches!(header.kind, HeaderKind::Impl { .. }) {
+                    continue;
+                }
+                let row = self
+                    .rows
+                    .iter()
+                    .find(|r| r.identity == header.exact_identity())
+                    .ok_or_else(|| fault("full catalog impl omitted from index rows"))?;
+                let different_trait = matches!((t,row.trait_bucket),(TraitBucket::Exact(a),TraitBucket::Exact(b)) if a!=b)
+                    || matches!(
+                        (t, row.trait_bucket),
+                        (
+                            TraitBucket::Inherent,
+                            TraitBucket::Exact(_) | TraitBucket::Unresolved
+                        ) | (
+                            TraitBucket::Exact(_) | TraitBucket::Unresolved,
+                            TraitBucket::Inherent
+                        )
+                    );
+                let different_self = !matches!(s, SelfBucket::Blanket | SelfBucket::Unresolved)
+                    && !matches!(
+                        row.self_bucket,
+                        SelfBucket::Blanket | SelfBucket::Unresolved
+                    )
+                    && s != row.self_bucket;
+                if !different_trait && !different_self {
+                    ids.push(header.exact_identity());
+                }
+            }
+        }
+        ids.sort_unstable();
+        Ok(ids)
+    }
+    /// Metadata property oracle. Never evaluates predicates or proves applicability.
+    pub fn check_all_buckets_against_full_catalog(&self) -> Result<(), Diagnostic> {
+        self.rows
+            .len()
+            .checked_mul(self.header_count())
+            .and_then(|n| n.checked_mul(self.rows.len()))
+            .and_then(|n| n.checked_mul(3))
+            .filter(|n| *n <= 1_000_000)
+            .ok_or_else(limit)?;
+        for row in &self.rows {
+            for (t, s) in [
+                (row.trait_bucket, row.self_bucket),
+                (row.trait_bucket, SelfBucket::Unresolved),
+                (TraitBucket::Unresolved, row.self_bucket),
+            ] {
+                if self.indexed(t, s)? != self.full_catalog(t, s)? {
+                    return Err(fault("indexed candidates differ from full-catalog oracle"));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+impl StableEncode for HeaderIndexModel {
+    const DOMAIN: &'static str = "lrr/v5/header-index-model/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.sequence(&self.fragments, |e, f| e.record(f));
+        e.sequence(&self.rows, |e, r| e.record(r));
+    }
+}
+fn required(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TRAIT-CATALOG-REQUIRED", message.into())
+}
+/// Published ImplCatalog admission. Its data is not a SourceView or trait goal.
+pub struct CurrentImplCandidateIndex {
+    model: HeaderIndexModel,
+    seal: SealKey,
+    publication: Digest,
+    source_revision: u64,
+    query_revision: u64,
+    limits: HeaderCaptureLimits,
+}
+impl CurrentImplCandidateIndex {
+    pub fn capture_current(
+        db: &Database,
+        seal: &SealKey,
+        limits: HeaderCaptureLimits,
+    ) -> Result<Self, Diagnostic> {
+        let limits = limits.validate()?;
+        let (input, publication) = published_catalog(db, seal)?;
+        if !input.source_replacements.is_empty()
+            || input
+                .declaration_inventory
+                .scan_handles()
+                .iter()
+                .any(|s| s.generated_origin().is_some() || s.scope().owner.is_some())
+        {
+            return Err(required(
+                "generated/replaced header needs exact token-aware source/context lowering",
+            ));
+        }
+        let scans = input.declaration_inventory.scan_handles();
+        if scans.len() > 4096 {
+            return Err(limit());
+        }
+        let mut fragments = Vec::new();
+        fragments
+            .try_reserve_exact(scans.len())
+            .map_err(|_| limit())?;
+        let mut total_bytes = 0usize;
+        for scan in scans {
+            let parse_key = QueryKey::ParseFile(scan.parse().clone());
+            let memo = db
+                .memo(&parse_key)
+                .filter(|m| m.verified_revision == db.revision())
+                .ok_or_else(|| {
+                    required("current immutable parse query needs explicit source preparation")
+                })?;
+            let QueryValue::ParseFile(parsed) = memo.value.as_ref() else {
+                return Err(fault("parse memo variant differs"));
+            };
+            if parsed.key() != *scan.parse() {
+                return Err(fault("parse memo source/profile differs"));
+            }
+            let Some((InputValue::CrateCfg(cfg), _)) =
+                db.published_input(&InputKey::CrateCfg(scan.scope().crate_key))
+            else {
+                return Err(required("owning source cfg is unpublished"));
+            };
+            if cfg.fingerprint() != scan.cfg() {
+                return Err(fault("source cfg/header catalog differs"));
+            }
+            let fragment = parsed.capture_trait_headers(
+                scan.path().clone(),
+                scan.scope().clone(),
+                cfg,
+                limits,
+            )?;
+            if fragment.scan_identity != scan.fingerprint() {
+                return Err(fault("captured source header inventory differs"));
+            }
+            validate_fragment(db, &fragment)?;
+            total_bytes = total_bytes
+                .checked_add(fragment.metadata_bytes)
+                .filter(|n| *n <= limits.metadata_bytes)
+                .ok_or_else(limit)?;
+            fragments.push(fragment);
+        }
+        let mut model = HeaderIndexModel::from_fragments(fragments, limits)?;
+        // Replace disclosed local-name model keys with only actual current Type lookups.
+        for ordinal in 0..model.rows.len() {
+            let (t, s) = current_row_buckets(db, seal, &model.fragments, model.rows[ordinal])?;
+            model.rows[ordinal].trait_bucket = t;
+            model.rows[ordinal].self_bucket = s;
+        }
+        let bytes = model.fragments.iter().try_fold(
+            model
+                .fragments
+                .capacity()
+                .checked_mul(std::mem::size_of::<CapturedSourceHeaders>())
+                .ok_or_else(limit)?,
+            |n, f| n.checked_add(f.metadata_bytes).ok_or_else(limit),
+        )?;
+        drop(model.buckets);
+        let model = HeaderIndexModel::finish(model.fragments, model.rows, bytes, limits)?;
+        Ok(Self {
+            model,
+            seal: seal.clone(),
+            publication,
+            source_revision: db.source_revision(),
+            query_revision: db.revision(),
+            limits,
+        })
+    }
+    pub fn revalidate(&self, db: &Database) -> Result<(), Diagnostic> {
+        if self.source_revision != db.source_revision() || self.query_revision != db.revision() {
+            return Err(fault(
+                "catalog input universe/revision changed; fresh capture required",
+            ));
+        }
+        let (_, stamp) = published_catalog(db, &self.seal)?;
+        if stamp != self.publication {
+            return Err(fault("catalog publication changed"));
+        }
+        for f in &self.model.fragments {
+            validate_fragment(db, f)?;
+        }
+        for row in &self.model.rows {
+            let actual = current_row_buckets(db, &self.seal, &self.model.fragments, *row)?;
+            if actual != (row.trait_bucket, row.self_bucket) {
+                return Err(fault(
+                    "header Type readiness changed; fresh capture required",
+                ));
+            }
+        }
+        Ok(())
+    }
+    /// Source-header-to-source-header structural candidates only. M018 must supply
+    /// the later reached symbolic goal producer; no caller TyTerm/descriptor factory.
+    pub fn candidates_for_header_current(
+        &self,
+        db: &Database,
+        header: Digest,
+    ) -> Result<Vec<&SourceTraitHeader>, Diagnostic> {
+        self.revalidate(db)?;
+        let row = self
+            .model
+            .rows
+            .iter()
+            .find(|r| r.identity == header)
+            .ok_or_else(|| fault("query header is outside the captured catalog"))?;
+        if row.trait_bucket == TraitBucket::Unresolved {
+            return Err(required(
+                "query header exact trait Type publication is not ready",
+            ));
+        }
+        let ids = self.model.indexed(row.trait_bucket, row.self_bucket)?;
+        self.model
+            .metadata_bytes
+            .checked_add(
+                ids.capacity()
+                    .checked_mul(std::mem::size_of::<Digest>())
+                    .ok_or_else(limit)?,
+            )
+            .and_then(|n| {
+                n.checked_add(
+                    ids.len()
+                        .checked_mul(std::mem::size_of::<&SourceTraitHeader>())?,
+                )
+            })
+            .filter(|n| *n <= self.limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        let mut selected = Vec::new();
+        selected.try_reserve_exact(ids.len()).map_err(|_| limit())?;
+        for row in &self.model.rows {
+            if ids.binary_search(&row.identity).is_ok() {
+                selected.push(&self.model.fragments[row.fragment].headers[row.header]);
+            }
+        }
+        #[cfg(debug_assertions)]
+        if ids != self.model.full_catalog(row.trait_bucket, row.self_bucket)? {
+            return Err(fault("current index differs from full-catalog oracle"));
+        }
+        Ok(selected)
+    }
+}
+fn published_catalog<'a>(
+    db: &'a Database,
+    key: &SealKey,
+) -> Result<(&'a crate::db::seals::DiscoveryInput, Digest), Diagnostic> {
+    key.validate()?;
+    if !matches!(key.domain, SealDomain::ImplCatalog { .. }) {
+        return Err(required(
+            "only an actual ImplCatalogSeal admits enumeration",
+        ));
+    }
+    let Some((InputValue::DiscoverySeal(input), stamp)) =
+        db.published_input(&InputKey::DiscoverySeal(key.clone()))
+    else {
+        return Err(required("current complete impl catalog is unpublished"));
+    };
+    if input.seal.key() != *key {
+        return Err(fault("published impl catalog identity differs"));
+    }
+    if !matches!(db.published_input(&InputKey::ExpansionEpoch),Some((InputValue::ExpansionEpoch(epoch),_)) if *epoch==key.epoch)
+    {
+        return Err(fault("catalog expansion epoch stale or absent"));
+    }
+    if !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(graph),_)) if graph.fingerprint()==input.source_dependencies)
+    {
+        return Err(fault("catalog source dependency graph stale"));
+    }
+    validate_discovery_current(db, input, key)?;
+    Ok((input, stamp))
+}
+fn current_name(
+    db: &Database,
+    catalog: &SealKey,
+    scope: &ScopeKey,
+    edition: u16,
+    name: &str,
+) -> Option<crate::frontend::names::NameDefinition> {
+    if scope.owner.is_some() {
+        return None;
+    } // Lexical owner/generic ribs require M018 context.
+    let seal = SealKey {
+        domain: SealDomain::Scope {
+            id: scope.fingerprint(),
+            namespace: Namespace::Type,
+        },
+        unit_graph: catalog.unit_graph,
+        epoch: catalog.epoch,
+    };
+    let (InputValue::DiscoverySeal(input), _) =
+        db.published_input(&InputKey::DiscoverySeal(seal.clone()))?;
+    if validate_discovery_current(db, input, &seal).is_err() {
+        return None;
+    }
+    let certified = input.scope.as_ref()?;
+    if certified.scope != *scope
+        || certified.namespace != Namespace::Type
+        || certified.edition != edition
+    {
+        return None;
+    }
+    let key = QueryKey::SealedName(Box::new(SealedNameKey {
+        seal,
+        bucket: BucketKey {
+            scope: scope.clone(),
+            namespace: Namespace::Type,
+            name: name.into(),
+        },
+    }));
+    let memo = db
+        .memo(&key)
+        .filter(|m| m.verified_revision == db.revision())?;
+    let QueryValue::SealedName {
+        key: actual,
+        lookup: NameLookup::Defined(d),
+    } = memo.value.as_ref()
+    else {
+        return None;
+    };
+    if QueryKey::SealedName(actual.clone()) != key
+        || d.namespace != Namespace::Type
+        || !matches!(d.definition_edition, 2015 | 2018 | 2021 | 2024)
+    {
+        return None;
+    }
+    Some(d.clone())
+}
+fn validate_fragment(db: &Database, f: &CapturedSourceHeaders) -> Result<(), Diagnostic> {
+    let Some((InputValue::SourceBlob(blob), _)) =
+        db.published_input(&InputKey::SourceBlob(f.source.content))
+    else {
+        return Err(required("actual source blob is unpublished"));
+    };
+    if Digest::of_bytes(blob.bytes()) != f.source.content {
+        return Err(fault("source blob content differs"));
+    }
+    if !matches!(db.published_input(&InputKey::CrateCfg(f.scope.crate_key)),Some((InputValue::CrateCfg(cfg),_)) if cfg.fingerprint()==f.cfg)
+    {
+        return Err(fault("owning cfg changed"));
+    }
+    for h in &f.headers {
+        validate_header(db, &f.source, &h.definition, &h.header, &h.context)?;
+        for m in &h.associated {
+            validate_header(db, &f.source, &m.definition, &m.header, &m.context)?;
+            if let Some(body) = &m.body
+                && !matches!(db.published_input(&InputKey::DefinitionBody(m.definition.fingerprint())),Some((InputValue::DefinitionBody(actual),_)) if actual==body)
+            {
+                return Err(fault("associated body attachment changed"));
+            }
+        }
+    }
+    for n in &f.nominals {
+        if !matches!(
+            n.definition.item_kind,
+            ItemKind::Struct | ItemKind::Enum | ItemKind::Union
+        ) {
+            return Err(fault("nominal kind differs"));
+        }
+        validate_header(db, &f.source, &n.definition, &n.header, &n.context)?;
+    }
+    Ok(())
+}
+fn validate_header(
+    db: &Database,
+    source: &crate::syntax::parse::ParseKey,
+    definition: &crate::source::manifest::DefKey,
+    header: &crate::syntax::outline::HeaderRecipe,
+    context: &crate::syntax::outline::DeclarationContext,
+) -> Result<(), Diagnostic> {
+    let id = definition.fingerprint();
+    if !matches!(db.published_input(&InputKey::DefinitionSource(id)),Some((InputValue::DefinitionSource(actual),_)) if actual==source)
+        || !matches!(db.published_input(&InputKey::DefinitionHeader(id)),Some((InputValue::DefinitionHeader(actual),_)) if actual==header)
+        || !matches!(db.published_input(&InputKey::DeclarationContext(id)),Some((InputValue::DeclarationContext(actual),_)) if actual==context)
+    {
+        return Err(fault(
+            "actual source definition/header/context publication differs",
+        ));
+    }
+    Ok(())
+}
+
+/// Replay the existing DiscoverySeal provider's source/record premises read-only.
+/// Missing query preparation is not serviced by this metadata consumer.
+fn validate_discovery_current(
+    db: &Database,
+    input: &crate::db::seals::DiscoveryInput,
+    key: &SealKey,
+) -> Result<(), Diagnostic> {
+    if input.seal.key() != *key
+        || input.sources.len() > 4096
+        || input.records.len() > 100_000
+        || input.seal.input_dependencies().len() > 100_000
+        || !db.compiler_inputs_match(&input.compiler_inputs)
+    {
+        return Err(fault("discovery compiler/source universe or bounds differ"));
+    }
+    if !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(graph),_)) if graph.fingerprint()==input.source_dependencies)
+    {
+        return Err(fault("discovery source graph stale"));
+    }
+    for source in &input.sources {
+        if !matches!(db.published_input(&InputKey::CapturedSource(source.location_identity())),Some((InputValue::CapturedSource(actual),_)) if actual==source)
+        {
+            return Err(fault("catalog selected source context changed"));
+        }
+        let query = QueryKey::Outline(source.outline.clone());
+        let memo = db
+            .memo(&query)
+            .filter(|m| m.verified_revision == db.revision())
+            .ok_or_else(|| required("current outline query needs explicit preparation"))?;
+        let QueryValue::Outline(outline) = memo.value.as_ref() else {
+            return Err(fault("current source outline variant differs"));
+        };
+        if input
+            .seal
+            .input_dependencies()
+            .binary_search(&(query.fingerprint(), outline.fingerprint()))
+            .is_err()
+        {
+            return Err(fault("source outline differs from actual seal dependency"));
+        }
+    }
+    for descriptor in &input.records {
+        if !matches!(db.published_input(&InputKey::ExpansionRecord(descriptor.key.fingerprint())),Some((InputValue::ExpansionRecord(record),_)) if record.key()==&descriptor.key && record.descriptor().fingerprint()==descriptor.fingerprint())
+        {
+            return Err(fault("catalog expansion record changed"));
+        }
+        if descriptor
+            .key
+            .procedural_epoch
+            .is_some_and(|epoch| epoch != key.epoch)
+        {
+            return Err(fault("catalog record epoch differs"));
+        }
+    }
+    Ok(())
+}
+
+fn current_row_buckets(
+    db: &Database,
+    seal: &SealKey,
+    fragments: &[CapturedSourceHeaders],
+    row: Row,
+) -> Result<(TraitBucket, SelfBucket), Diagnostic> {
+    let fragment = &fragments[row.fragment];
+    let h = &fragment.headers[row.header];
+    let HeaderKind::Impl {
+        trait_type,
+        self_type,
+        ..
+    } = &h.kind
+    else {
+        return Err(fault("candidate is not an impl"));
+    };
+    let trait_bucket = match trait_type {
+        None => TraitBucket::Inherent,
+        Some(t) => bare_path(t)
+            .and_then(|name| {
+                current_name(db, seal, &h.context.scope, h.source.profile.edition, name)
+            })
+            .filter(|definition| {
+                fragments.iter().flat_map(|f| &f.headers).any(|d| {
+                    d.definition.fingerprint() == definition.identity
+                        && d.definition.crate_key == definition.defining_unit
+                        && d.source.profile.edition == definition.definition_edition
+                        && matches!(d.kind, HeaderKind::Trait { alias: false, .. })
+                })
+            })
+            .map_or(TraitBucket::Unresolved, |d| TraitBucket::Exact(d.identity)),
+    };
+    let self_bucket = constructor(self_type, |name| {
+        current_name(db, seal, &h.context.scope, h.source.profile.edition, name)
+            .filter(|definition| {
+                fragments.iter().any(|f| {
+                    f.source.profile.edition == definition.definition_edition
+                        && f.nominals.iter().any(|n| {
+                            n.definition.fingerprint() == definition.identity
+                                && n.definition.crate_key == definition.defining_unit
+                        })
+                })
+            })
+            .map(|d| d.identity)
+    });
+    Ok((trait_bucket, self_bucket))
+}
