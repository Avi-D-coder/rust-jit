+//! Read-only pinned AST adapter. No body entry, expansion, lookup or trait solving.
+use super::{
+    ast_adapter::{range, semantic_name},
+    declaration_scan::DeclarationScanLimits,
+    outline::{DeclarationContext, ItemOutline, ScopeKey},
+    parse::ParsedFile,
+    signatures::{DefinitionParameter, GenericKind, capture_generics},
+    spans::SourceRange,
+};
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    source::{
+        manifest::ItemKind,
+        snapshot::{CfgSet, SourcePath},
+    },
+    traits::{
+        header::*,
+        term::{BoundKind, ParamKey, RegionTerm},
+    },
+};
+use ra_ap_syntax::{
+    AstNode, SyntaxNode,
+    ast::{self, HasGenericArgs, HasName, HasTypeBounds},
+};
+
+struct Capture {
+    limits: HeaderCaptureLimits,
+    bytes: usize,
+    nodes: usize,
+    tokens: usize,
+    owner: Digest,
+    self_owner: Digest,
+    generics: Vec<HeaderParameter>,
+    binders: Vec<Vec<HeaderParameter>>,
+}
+impl Capture {
+    fn add(&mut self, n: usize) -> Result<(), Diagnostic> {
+        self.bytes = self
+            .bytes
+            .checked_add(n)
+            .filter(|n| *n <= self.limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        Ok(())
+    }
+    fn step(&mut self, depth: usize) -> Result<(), Diagnostic> {
+        self.nodes = self
+            .nodes
+            .checked_add(1)
+            .filter(|n| *n <= self.limits.nodes)
+            .ok_or_else(limit)?;
+        if depth >= self.limits.depth {
+            return Err(limit());
+        }
+        Ok(())
+    }
+    fn list<T>(&mut self, n: usize) -> Result<Vec<T>, Diagnostic> {
+        self.add(n.checked_mul(std::mem::size_of::<T>()).ok_or_else(limit)?)?;
+        let mut v = Vec::new();
+        v.try_reserve_exact(n).map_err(|_| limit())?;
+        Ok(v)
+    }
+    fn owned_tokens(
+        &mut self,
+        node: &SyntaxNode,
+    ) -> Result<Vec<super::ast_adapter::TokenRecipe>, Diagnostic> {
+        let count = node
+            .descendants_with_tokens()
+            .filter_map(|e| e.into_token())
+            .filter(|t| !t.kind().is_trivia())
+            .count();
+        self.tokens = self
+            .tokens
+            .checked_add(count)
+            .filter(|n| *n <= self.limits.tokens)
+            .ok_or_else(limit)?;
+        let mut result = self.list(count)?;
+        for t in node
+            .descendants_with_tokens()
+            .filter_map(|e| e.into_token())
+            .filter(|t| !t.kind().is_trivia())
+        {
+            self.add(t.text().len())?;
+            let mut text = String::new();
+            text.try_reserve_exact(t.text().len())
+                .map_err(|_| limit())?;
+            text.push_str(t.text());
+            result.push(super::ast_adapter::TokenRecipe {
+                kind: t.kind() as u16,
+                text,
+            });
+        }
+        Ok(result)
+    }
+    fn parameters(
+        &mut self,
+        list: Option<ast::GenericParamList>,
+        owner: Digest,
+    ) -> Result<Vec<HeaderParameter>, Diagnostic> {
+        if let Some(l) = &list {
+            let count = l.generic_params().count();
+            let tokens = l
+                .syntax()
+                .descendants_with_tokens()
+                .filter_map(|e| e.into_token())
+                .filter(|t| !t.kind().is_trivia())
+                .count();
+            let bytes = count
+                .checked_mul(
+                    std::mem::size_of::<HeaderParameter>()
+                        + std::mem::size_of::<DefinitionParameter>(),
+                )
+                .and_then(|n| {
+                    n.checked_add(
+                        tokens
+                            .checked_mul(std::mem::size_of::<super::ast_adapter::TokenRecipe>())?,
+                    )
+                })
+                .and_then(|n| {
+                    n.checked_add(usize::from(l.syntax().text_range().len()).checked_mul(4)?)
+                })
+                .ok_or_else(limit)?;
+            self.add(bytes)?;
+        }
+        let parameters = capture_generics(list)?;
+        self.add(
+            parameters
+                .len()
+                .checked_mul(std::mem::size_of::<HeaderParameter>())
+                .ok_or_else(limit)?,
+        )?;
+        let mut result = Vec::new();
+        result
+            .try_reserve_exact(parameters.len())
+            .map_err(|_| limit())?;
+        for DefinitionParameter {
+            ordinal,
+            kind,
+            name,
+            bounds,
+            default,
+            const_type,
+        } in parameters
+        {
+            result.push(HeaderParameter {
+                key: ParamKey {
+                    definition: owner,
+                    ordinal,
+                },
+                kind: match kind {
+                    GenericKind::Lifetime => BoundKind::Region,
+                    GenericKind::Type => BoundKind::Type,
+                    GenericKind::Const => BoundKind::Const,
+                },
+                name,
+                bounds,
+                default,
+                const_type,
+            });
+        }
+        Ok(result)
+    }
+    fn binder(
+        &mut self,
+        binder: Option<ast::ForBinder>,
+    ) -> Result<Vec<HeaderParameter>, Diagnostic> {
+        let Some(binder) = binder else {
+            return Ok(Vec::new());
+        };
+        let mut e = StableEncoder::new("lrr/v5/header-binder-source/v1");
+        e.digest(self.owner);
+        let r = range(binder.syntax().text_range());
+        e.u32(r.start);
+        e.u32(r.end);
+        let result = self.parameters(binder.generic_param_list(), e.finish())?;
+        // Non-lifetime binder forms stay explicit unresolved syntax in downstream readiness.
+        Ok(result)
+    }
+    fn unsupported_bound_shadow(&self, name: &str) -> bool {
+        self.binders.iter().rev().any(|binder| {
+            binder
+                .iter()
+                .any(|p| p.kind != BoundKind::Region && p.name == name)
+        })
+    }
+    fn param(&self, name: &str, kind: BoundKind) -> Option<ParamKey> {
+        if kind != BoundKind::Region && self.unsupported_bound_shadow(name) {
+            return None;
+        }
+        self.generics
+            .iter()
+            .rev()
+            .find(|p| p.name == name && p.kind == kind)
+            .map(|p| p.key)
+    }
+    fn region(
+        &mut self,
+        lifetime: Option<ast::Lifetime>,
+        position: SourceRange,
+    ) -> Result<HeaderRegion, Diagnostic> {
+        let Some(l) = lifetime else {
+            return Ok(HeaderRegion::Known(RegionTerm::Local {
+                definition: self.owner,
+                start: position.start,
+                end: position.end,
+            }));
+        };
+        let name = l.syntax().text().to_string();
+        self.add(name.capacity())?;
+        if name == "'static" {
+            return Ok(HeaderRegion::Known(RegionTerm::Static));
+        }
+        for (depth, binder) in self.binders.iter().rev().enumerate() {
+            if let Some((index, _)) = binder.iter().enumerate().find(|(_, p)| {
+                p.kind == BoundKind::Region
+                    && format!("'{}", p.name.trim_start_matches('\'')) == name
+            }) {
+                return Ok(HeaderRegion::Known(RegionTerm::Bound {
+                    depth: u32::try_from(depth).map_err(|_| limit())?,
+                    index: u32::try_from(index).map_err(|_| limit())?,
+                }));
+            }
+        }
+        let semantic = name.trim_start_matches('\'');
+        if let Some(p) = self
+            .param(semantic, BoundKind::Region)
+            .or_else(|| self.param(&name, BoundKind::Region))
+        {
+            return Ok(HeaderRegion::Known(RegionTerm::Param(p)));
+        }
+        Ok(HeaderRegion::Unresolved(self.owned_tokens(l.syntax())?))
+    }
+    fn constant(&mut self, c: ast::ConstArg) -> Result<HeaderConst, Diagnostic> {
+        let tokens = self.owned_tokens(c.syntax())?;
+        if tokens.len() == 1
+            && let Some(p) =
+                semantic_name(&tokens[0].text).and_then(|n| self.param(&n, BoundKind::Const))
+        {
+            return Ok(HeaderConst::Parameter(p));
+        }
+        Ok(HeaderConst::RequiredExpression {
+            range: range(c.syntax().text_range()),
+            tokens,
+        })
+    }
+    fn ty(&mut self, ty: ast::Type, depth: usize) -> Result<HeaderType, Diagnostic> {
+        self.step(depth)?;
+        let r = range(ty.syntax().text_range());
+        let tokens = self.owned_tokens(ty.syntax())?;
+        let form = match ty {
+            ast::Type::PathType(p) => {
+                let Some(path) = p.path() else {
+                    return Err(fault("header path is structurally incomplete"));
+                };
+                let count = path.segments().count();
+                let mut segments = self.list(count)?;
+                for s in path.segments() {
+                    let name = s.name_ref().and_then(|n| semantic_name(n.text()));
+                    if let Some(n) = &name {
+                        self.add(n.capacity())?;
+                    }
+                    let args = s.generic_arg_list();
+                    let mut arguments =
+                        self.list(args.as_ref().map_or(0, |a| a.generic_args().count()))?;
+                    if let Some(args) = args {
+                        for arg in args.generic_args() {
+                            arguments.push(match arg {
+                                ast::GenericArg::TypeArg(a) => {
+                                    let ty = a
+                                        .ty()
+                                        .ok_or_else(|| fault("header type argument absent"))?;
+                                    let ts = self.owned_tokens(ty.syntax())?;
+                                    if ts.len() == 1
+                                        && let Some(key) = semantic_name(&ts[0].text)
+                                            .and_then(|name| self.param(&name, BoundKind::Const))
+                                    {
+                                        HeaderArgument::Const(HeaderConst::Parameter(key))
+                                    } else {
+                                        self.add(std::mem::size_of::<HeaderType>())?;
+                                        HeaderArgument::Type(Box::new(self.ty(ty, depth + 1)?))
+                                    }
+                                }
+                                ast::GenericArg::LifetimeArg(a) => HeaderArgument::Region(
+                                    self.region(a.lifetime(), range(a.syntax().text_range()))?,
+                                ),
+                                ast::GenericArg::ConstArg(a) => {
+                                    HeaderArgument::Const(self.constant(a)?)
+                                }
+                                ast::GenericArg::AssocTypeArg(a) => HeaderArgument::Associated {
+                                    name: a.name_ref().and_then(|n| semantic_name(n.text())),
+                                    tokens: self.owned_tokens(a.syntax())?,
+                                },
+                            });
+                        }
+                    }
+                    segments.push(HeaderPathSegment {
+                        name,
+                        arguments,
+                        parenthesized: s.parenthesized_arg_list().is_some(),
+                        type_anchor: s.type_anchor().is_some(),
+                        absolute_separator: s.coloncolon_token().is_some(),
+                    });
+                }
+                if segments.len() == 1
+                    && segments[0].arguments.is_empty()
+                    && !segments[0].absolute_separator
+                    && !segments[0].type_anchor
+                    && !segments[0].parenthesized
+                {
+                    if segments[0]
+                        .name
+                        .as_deref()
+                        .is_some_and(|name| self.unsupported_bound_shadow(name))
+                    {
+                        HeaderTypeForm::RequiredSyntax
+                    } else if let Some(p) = segments[0]
+                        .name
+                        .as_deref()
+                        .and_then(|n| self.param(n, BoundKind::Type))
+                    {
+                        HeaderTypeForm::Parameter(p)
+                    } else if segments[0].name.as_deref() == Some("Self") {
+                        HeaderTypeForm::SelfType(self.self_owner)
+                    } else {
+                        HeaderTypeForm::Path(segments)
+                    }
+                } else {
+                    HeaderTypeForm::Path(segments)
+                }
+            }
+            ast::Type::TupleType(t) => {
+                let mut v = self.list(t.fields().count())?;
+                for ty in t.fields() {
+                    v.push(self.ty(ty, depth + 1)?);
+                }
+                HeaderTypeForm::Tuple(v)
+            }
+            ast::Type::ArrayType(t) => {
+                self.add(std::mem::size_of::<HeaderType>())?;
+                HeaderTypeForm::Array(
+                    Box::new(self.ty(
+                        t.ty().ok_or_else(|| fault("array element header absent"))?,
+                        depth + 1,
+                    )?),
+                    self.constant(
+                        t.const_arg()
+                            .ok_or_else(|| fault("array length header absent"))?,
+                    )?,
+                )
+            }
+            ast::Type::SliceType(t) => {
+                self.add(std::mem::size_of::<HeaderType>())?;
+                HeaderTypeForm::Slice(Box::new(self.ty(
+                    t.ty().ok_or_else(|| fault("slice element header absent"))?,
+                    depth + 1,
+                )?))
+            }
+            ast::Type::RefType(t) => {
+                self.add(std::mem::size_of::<HeaderType>())?;
+                HeaderTypeForm::Reference {
+                    region: self.region(t.lifetime(), r)?,
+                    mutable: t.mut_token().is_some(),
+                    pointee: Box::new(self.ty(
+                        t.ty().ok_or_else(|| fault("reference header absent"))?,
+                        depth + 1,
+                    )?),
+                }
+            }
+            ast::Type::ParenType(t) => {
+                self.ty(
+                    t.ty().ok_or_else(|| fault("parenthesized header absent"))?,
+                    depth + 1,
+                )?
+                .form
+            }
+            ast::Type::NeverType(_) => HeaderTypeForm::Never,
+            _ => HeaderTypeForm::RequiredSyntax,
+        };
+        Ok(HeaderType {
+            range: r,
+            tokens,
+            form,
+        })
+    }
+    fn bounds(&mut self, list: Option<ast::TypeBoundList>) -> Result<Vec<HeaderBound>, Diagnostic> {
+        let Some(list) = list else {
+            return Ok(Vec::new());
+        };
+        let mut result = self.list(list.bounds().count())?;
+        for b in list.bounds() {
+            let binder = self.binder(b.for_binder())?;
+            self.push_binder(&binder)?;
+            let ty = b.ty().map(|t| self.ty(t, 0)).transpose()?;
+            let lifetime = b
+                .lifetime()
+                .map(|l| self.region(Some(l), range(b.syntax().text_range())))
+                .transpose()?;
+            if !binder.is_empty() {
+                self.binders.pop();
+            }
+            result.push(HeaderBound {
+                range: range(b.syntax().text_range()),
+                binder,
+                modifier: if b.const_token().is_some()
+                    || b.tilde_token().is_some()
+                    || b.async_token().is_some()
+                    || b.use_token().is_some()
+                {
+                    BoundModifier::RequiredConstOrOther
+                } else if b.question_mark_token().is_some() {
+                    BoundModifier::Relaxed
+                } else {
+                    BoundModifier::Ordinary
+                },
+                ty,
+                lifetime,
+                tokens: self.owned_tokens(b.syntax())?,
+            });
+        }
+        Ok(result)
+    }
+    fn push_binder(&mut self, p: &[HeaderParameter]) -> Result<(), Diagnostic> {
+        if p.is_empty() {
+            return Ok(());
+        }
+        if self.binders.len() >= self.limits.depth {
+            return Err(limit());
+        }
+        self.add(
+            std::mem::size_of::<Vec<HeaderParameter>>()
+                + p.len()
+                    .checked_mul(std::mem::size_of::<HeaderParameter>())
+                    .ok_or_else(limit)?,
+        )?;
+        self.binders.try_reserve_exact(1).map_err(|_| limit())?;
+        let mut retained = self.list(p.len())?;
+        retained.extend_from_slice(p);
+        self.add(parameter_heap(p)?)?;
+        self.binders.push(retained);
+        Ok(())
+    }
+    fn predicates(
+        &mut self,
+        list: Option<ast::GenericParamList>,
+        where_clause: Option<ast::WhereClause>,
+    ) -> Result<Vec<HeaderPredicate>, Diagnostic> {
+        let parameter_count = list.as_ref().map_or(0, |l| l.generic_params().count());
+        let where_count = where_clause.as_ref().map_or(0, |w| w.predicates().count());
+        let mut result = self.list(
+            parameter_count
+                .checked_mul(2)
+                .and_then(|n| n.checked_add(where_count))
+                .ok_or_else(limit)?,
+        )?;
+        if let Some(list) = list {
+            for p in list.generic_params() {
+                let r = range(p.syntax().text_range());
+                match p {
+                    ast::GenericParam::TypeParam(p) => {
+                        let name = p
+                            .name()
+                            .and_then(|n| semantic_name(n.text()))
+                            .ok_or_else(|| fault("type parameter name absent"))?;
+                        let key = self
+                            .param(&name, BoundKind::Type)
+                            .ok_or_else(|| fault("actual type parameter identity absent"))?;
+                        let before_subject = self.bytes;
+                        let subject = HeaderType {
+                            range: r,
+                            tokens: self.owned_tokens(p.syntax())?,
+                            form: HeaderTypeForm::Parameter(key),
+                        };
+                        let subject_heap =
+                            self.bytes.checked_sub(before_subject).ok_or_else(limit)?;
+                        self.add(subject_heap)?;
+                        let before_bounds = self.bytes;
+                        let bounds = self.bounds(p.type_bound_list())?;
+                        let bound_heap = self.bytes.checked_sub(before_bounds).ok_or_else(limit)?;
+                        self.add(bound_heap)?;
+                        let count = bounds
+                            .iter()
+                            .filter(|b| b.modifier == BoundModifier::Relaxed)
+                            .count();
+                        let mut relaxed = self.list(count)?;
+                        relaxed.extend(
+                            bounds
+                                .iter()
+                                .filter(|b| b.modifier == BoundModifier::Relaxed)
+                                .cloned(),
+                        );
+                        result.push(HeaderPredicate {
+                            range: r,
+                            binder: Vec::new(),
+                            kind: PredicateKind::ImplicitSized {
+                                subject: subject.clone(),
+                                relaxed,
+                            },
+                        });
+                        if !bounds.is_empty() {
+                            result.push(HeaderPredicate {
+                                range: r,
+                                binder: Vec::new(),
+                                kind: PredicateKind::Bound { subject, bounds },
+                            });
+                        }
+                    }
+                    ast::GenericParam::LifetimeParam(p) => {
+                        let subject = self.region(p.lifetime(), r)?;
+                        let bounds = self.bounds(p.type_bound_list())?;
+                        if !bounds.is_empty() {
+                            result.push(HeaderPredicate {
+                                range: r,
+                                binder: Vec::new(),
+                                kind: PredicateKind::RegionOutlives { subject, bounds },
+                            });
+                        }
+                    }
+                    ast::GenericParam::ConstParam(_) => {}
+                }
+            }
+        }
+        if let Some(w) = where_clause {
+            for p in w.predicates() {
+                let binder = self.binder(p.for_binder())?;
+                self.push_binder(&binder)?;
+                let bounds = self.bounds(p.type_bound_list())?;
+                let kind = if let Some(ty) = p.ty() {
+                    PredicateKind::Bound {
+                        subject: self.ty(ty, 0)?,
+                        bounds,
+                    }
+                } else if let Some(l) = p.lifetime() {
+                    PredicateKind::RegionOutlives {
+                        subject: self.region(Some(l), range(p.syntax().text_range()))?,
+                        bounds,
+                    }
+                } else {
+                    PredicateKind::RequiredSyntax(self.owned_tokens(p.syntax())?)
+                };
+                if !binder.is_empty() {
+                    self.binders.pop();
+                }
+                result.push(HeaderPredicate {
+                    range: range(p.syntax().text_range()),
+                    binder,
+                    kind,
+                });
+            }
+        }
+        Ok(result)
+    }
+    fn associated(
+        &mut self,
+        parsed: &ParsedFile,
+        outline: &super::outline::Outline,
+        item: &ItemOutline,
+        node: &SyntaxNode,
+        trait_owner: bool,
+    ) -> Result<AssociatedHeader, Diagnostic> {
+        let old_owner = self.owner;
+        let old_generics = std::mem::take(&mut self.generics);
+        self.owner = item.def_key.fingerprint();
+        let list = node.children().find_map(ast::GenericParamList::cast);
+        let parameters = self.parameters(list.clone(), self.owner)?;
+        // Keep the actual parent and own namespaces. Own keys shadow same-spelled parent keys.
+        let retained_count = old_generics
+            .len()
+            .checked_add(parameters.len())
+            .ok_or_else(limit)?;
+        self.generics = self.list(retained_count)?;
+        self.add(
+            parameter_heap(&old_generics)?
+                .checked_add(parameter_heap(&parameters)?)
+                .ok_or_else(limit)?,
+        )?;
+        self.generics.extend_from_slice(&old_generics);
+        self.generics.extend_from_slice(&parameters);
+        let where_clause = node.children().find_map(ast::WhereClause::cast);
+        let mut predicates = self.predicates(list, where_clause)?;
+        let extra = ast::Fn::cast(node.clone())
+            .and_then(|f| f.param_list())
+            .map_or(0, |p| p.params().count())
+            .checked_add(3)
+            .ok_or_else(limit)?;
+        self.add(
+            extra
+                .checked_mul(std::mem::size_of::<HeaderPredicate>())
+                .ok_or_else(limit)?,
+        )?;
+        predicates.try_reserve_exact(extra).map_err(|_| limit())?;
+        let mut parameter_types = Vec::new();
+        let mut receiver = Vec::new();
+        let (kind, declared_type) = if let Some(f) = ast::Fn::cast(node.clone()) {
+            if let Some(p) = f.param_list() {
+                parameter_types = self.list(p.params().count())?;
+                if let Some(s) = p.self_param() {
+                    receiver = self.owned_tokens(s.syntax())?;
+                }
+                for p in p.params() {
+                    if let Some(t) = p.ty() {
+                        parameter_types.push(self.ty(t, 0)?);
+                    } else {
+                        predicates.push(HeaderPredicate {
+                            range: range(p.syntax().text_range()),
+                            binder: Vec::new(),
+                            kind: PredicateKind::RequiredSyntax(self.owned_tokens(p.syntax())?),
+                        });
+                    }
+                }
+            }
+            (
+                AssociatedKind::Method,
+                f.ret_type()
+                    .and_then(|r| r.ty())
+                    .map(|t| self.ty(t, 0))
+                    .transpose()?,
+            )
+        } else if let Some(t) = ast::TypeAlias::cast(node.clone()) {
+            let before_bounds = self.bytes;
+            let bounds = self.bounds(t.type_bound_list())?;
+            let bound_heap = self.bytes.checked_sub(before_bounds).ok_or_else(limit)?;
+            // Associated type identity is not a nominal or inferred projection. Retain its
+            // definition's Self position until M023 produces a genuine ProjectionKey.
+            let subject = HeaderType {
+                range: item.header_span,
+                tokens: Vec::new(),
+                form: HeaderTypeForm::AssociatedType(self.owner),
+            };
+            if trait_owner {
+                self.add(bound_heap)?;
+                let mut relaxed = self.list(
+                    bounds
+                        .iter()
+                        .filter(|b| b.modifier == BoundModifier::Relaxed)
+                        .count(),
+                )?;
+                relaxed.extend(
+                    bounds
+                        .iter()
+                        .filter(|b| b.modifier == BoundModifier::Relaxed)
+                        .cloned(),
+                );
+                predicates.push(HeaderPredicate {
+                    range: item.header_span,
+                    binder: Vec::new(),
+                    kind: PredicateKind::ImplicitSized {
+                        subject: subject.clone(),
+                        relaxed,
+                    },
+                });
+            }
+            if !bounds.is_empty() {
+                predicates.push(HeaderPredicate {
+                    range: item.header_span,
+                    binder: Vec::new(),
+                    kind: PredicateKind::Bound { subject, bounds },
+                });
+            }
+            (
+                AssociatedKind::Type,
+                t.ty().map(|t| self.ty(t, 0)).transpose()?,
+            )
+        } else if let Some(t) = ast::Const::cast(node.clone()) {
+            (
+                AssociatedKind::Constant,
+                t.ty().map(|t| self.ty(t, 0)).transpose()?,
+            )
+        } else {
+            return Err(fault("unsupported associated declaration header"));
+        };
+        self.add(
+            item.header
+                .estimated_bytes()
+                .checked_add(scope_heap(&item.scope)?)
+                .and_then(|n| n.checked_add(std::mem::size_of::<AssociatedHeader>()))
+                .ok_or_else(limit)?,
+        )?;
+        let result = AssociatedHeader {
+            definition: item.def_key.clone(),
+            context: DeclarationContext {
+                scope: item.scope.clone(),
+                range: item.declaration_span,
+            },
+            header: item.header.clone(),
+            kind,
+            generics: parameters,
+            predicates,
+            parameter_types,
+            receiver,
+            declared_type,
+            body: item.body.clone(),
+        };
+        self.owner = old_owner;
+        self.generics = old_generics;
+        // These borrowed parameters document the source/outline ownership boundary.
+        if parsed.key() != outline_source(outline) {
+            return Err(fault("associated source/outline changed"));
+        }
+        Ok(result)
+    }
+}
+fn parameter_heap(p: &[HeaderParameter]) -> Result<usize, Diagnostic> {
+    let mut bytes = 0usize;
+    for p in p {
+        bytes = bytes.checked_add(p.name.capacity()).ok_or_else(limit)?;
+        for tokens in [&p.bounds, &p.default, &p.const_type] {
+            bytes = bytes
+                .checked_add(
+                    tokens
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<super::ast_adapter::TokenRecipe>())
+                        .ok_or_else(limit)?,
+                )
+                .ok_or_else(limit)?;
+            for token in tokens {
+                bytes = bytes.checked_add(token.text.capacity()).ok_or_else(limit)?;
+            }
+        }
+    }
+    Ok(bytes)
+}
+fn scope_heap(scope: &ScopeKey) -> Result<usize, Diagnostic> {
+    if scope.module_path.len() > 256 || scope.module_path.iter().any(|p| p.len() > 64 * 1024) {
+        return Err(limit());
+    }
+    scope.module_path.iter().try_fold(
+        scope
+            .module_path
+            .capacity()
+            .checked_mul(std::mem::size_of::<String>())
+            .ok_or_else(limit)?,
+        |n, p| n.checked_add(p.capacity()).ok_or_else(limit),
+    )
+}
+fn outline_source(outline: &super::outline::Outline) -> super::parse::ParseKey {
+    super::parse::ParseKey {
+        content: outline.content,
+        profile: outline.profile.clone(),
+    }
+}
+impl ParsedFile {
+    pub fn capture_trait_headers(
+        &self,
+        path: SourcePath,
+        scope: ScopeKey,
+        cfg: &CfgSet,
+        limits: HeaderCaptureLimits,
+    ) -> Result<CapturedSourceHeaders, Diagnostic> {
+        let limits = limits.validate()?;
+        path.heap_bytes()
+            .checked_add(scope_heap(&scope)?)
+            .and_then(|n| n.checked_add(self.profile.semantics.capacity()))
+            .filter(|n| *n <= limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        if self.generated_origin.is_some() || scope.owner.is_some() {
+            return Err(fault(
+                "generated or attached header needs exact token-origin/context producer",
+            ));
+        }
+        let scan = self.scan_declarations(
+            path.clone(),
+            scope.clone(),
+            cfg,
+            DeclarationScanLimits {
+                nodes: limits.nodes,
+                impls: limits.headers,
+                producers: 100_000,
+                depth: limits.depth,
+                metadata_bytes: limits.metadata_bytes,
+            },
+        )?;
+        let outline = self.outline(scope.crate_key, scope.module_path.clone(), cfg)?;
+        let count = outline
+            .items
+            .iter()
+            .filter(|i| matches!(i.def_key.item_kind, ItemKind::Trait | ItemKind::Impl))
+            .count();
+        if count > limits.headers {
+            return Err(limit());
+        }
+        let mut capture = Capture {
+            limits,
+            bytes: std::mem::size_of::<CapturedSourceHeaders>(),
+            nodes: 0,
+            tokens: 0,
+            owner: scope.crate_key,
+            self_owner: scope.crate_key,
+            generics: Vec::new(),
+            binders: Vec::new(),
+        };
+        capture.add(
+            path.heap_bytes()
+                .checked_add(scope_heap(&scope)?)
+                .and_then(|n| n.checked_add(self.profile.semantics.capacity()))
+                .ok_or_else(limit)?,
+        )?;
+        let nominal_count = outline
+            .items
+            .iter()
+            .filter(|i| {
+                matches!(
+                    i.def_key.item_kind,
+                    ItemKind::Struct | ItemKind::Enum | ItemKind::Union
+                )
+            })
+            .count();
+        if nominal_count > limits.headers {
+            return Err(limit());
+        }
+        let mut nominals = capture.list(nominal_count)?;
+        for item in outline.items.iter().filter(|i| {
+            matches!(
+                i.def_key.item_kind,
+                ItemKind::Struct | ItemKind::Enum | ItemKind::Union
+            )
+        }) {
+            capture.add(
+                item.header
+                    .estimated_bytes()
+                    .checked_add(scope_heap(&item.scope)?)
+                    .and_then(|n| n.checked_add(item.def_key.declared_name.capacity()))
+                    .ok_or_else(limit)?,
+            )?;
+            nominals.push(HeaderNominal {
+                definition: item.def_key.clone(),
+                context: DeclarationContext {
+                    scope: item.scope.clone(),
+                    range: item.declaration_span,
+                },
+                header: item.header.clone(),
+            });
+        }
+        let mut headers = capture.list(count)?;
+        let tree = self.parsed.tree();
+        let mut total_members = 0usize;
+        for item in outline
+            .items
+            .iter()
+            .filter(|i| matches!(i.def_key.item_kind, ItemKind::Trait | ItemKind::Impl))
+        {
+            let mut found = None;
+            for node in tree.syntax().descendants() {
+                capture.step(0)?;
+                if range(node.text_range()) == item.declaration_span
+                    && (ast::Trait::can_cast(node.kind()) || ast::Impl::can_cast(node.kind()))
+                {
+                    if found.replace(node).is_some() {
+                        return Err(fault("header AST attachment is ambiguous"));
+                    }
+                }
+            }
+            let node = found.ok_or_else(|| fault("header AST attachment absent"))?;
+            capture.owner = item.def_key.fingerprint();
+            capture.self_owner = capture.owner;
+            let list = node.children().find_map(ast::GenericParamList::cast);
+            capture.generics = capture.parameters(list.clone(), capture.owner)?;
+            let predicates =
+                capture.predicates(list, node.children().find_map(ast::WhereClause::cast))?;
+            let (kind, container) = if let Some(t) = ast::Trait::cast(node.clone()) {
+                (
+                    HeaderKind::Trait {
+                        supertraits: capture.bounds(t.type_bound_list())?,
+                        alias: t.eq_token().is_some(),
+                        auto_trait: t.auto_token().is_some(),
+                        unsafe_trait: t.unsafe_token().is_some(),
+                    },
+                    t.assoc_item_list(),
+                )
+            } else if let Some(i) = ast::Impl::cast(node) {
+                (
+                    HeaderKind::Impl {
+                        trait_type: i
+                            .trait_()
+                            .map(|t| capture.ty(t, 0).map(Box::new))
+                            .transpose()?,
+                        self_type: Box::new(
+                            capture.ty(
+                                i.self_ty()
+                                    .ok_or_else(|| fault("impl self header absent"))?,
+                                0,
+                            )?,
+                        ),
+                        negative: i.excl_token().is_some(),
+                        unsafe_impl: i.unsafe_token().is_some(),
+                        default_impl: i.default_token().is_some(),
+                    },
+                    i.assoc_item_list(),
+                )
+            } else {
+                return Err(fault("header kind mismatch"));
+            };
+            let mut associated = Vec::new();
+            if let Some(c) = container {
+                let expected_owner = if item.def_key.item_kind == ItemKind::Impl {
+                    item.header.fingerprint()
+                } else {
+                    item.def_key.fingerprint()
+                };
+                let members = outline
+                    .items
+                    .iter()
+                    .filter(|m| {
+                        m.scope.owner == Some(expected_owner)
+                            && m.scope.crate_key == item.scope.crate_key
+                            && m.scope.module_path == item.scope.module_path
+                            && item.declaration_span.start <= m.declaration_span.start
+                            && m.declaration_span.end <= item.declaration_span.end
+                            && matches!(
+                                m.def_key.item_kind,
+                                ItemKind::Function | ItemKind::TypeAlias | ItemKind::Constant
+                            )
+                    })
+                    .collect::<Vec<_>>();
+                total_members = total_members
+                    .checked_add(members.len())
+                    .filter(|n| *n <= limits.members)
+                    .ok_or_else(limit)?;
+                associated = capture.list(members.len())?;
+                for member in members {
+                    let n = c
+                        .syntax()
+                        .children()
+                        .find(|n| range(n.text_range()) == member.declaration_span)
+                        .ok_or_else(|| fault("associated source/header attachment absent"))?;
+                    associated.push(capture.associated(
+                        self,
+                        &outline,
+                        member,
+                        &n,
+                        item.def_key.item_kind == ItemKind::Trait,
+                    )?);
+                }
+            }
+            capture.add(
+                item.header
+                    .estimated_bytes()
+                    .checked_add(scope_heap(&item.scope)?)
+                    .and_then(|n| n.checked_add(std::mem::size_of::<SourceTraitHeader>()))
+                    .ok_or_else(limit)?,
+            )?;
+            let scan_identity = if item.def_key.item_kind == ItemKind::Impl {
+                Some(
+                    scan.impls()
+                        .iter()
+                        .find(|i| i.range == item.declaration_span)
+                        .ok_or_else(|| fault("impl header missing from structural inventory"))?
+                        .identity,
+                )
+            } else {
+                None
+            };
+            headers.push(SourceTraitHeader {
+                source: self.key(),
+                path: path.clone(),
+                cfg: cfg.fingerprint(),
+                definition: item.def_key.clone(),
+                context: DeclarationContext {
+                    scope: item.scope.clone(),
+                    range: item.declaration_span,
+                },
+                header: item.header.clone(),
+                kind,
+                generics: std::mem::take(&mut capture.generics),
+                predicates,
+                associated,
+                scan_identity,
+            });
+        }
+        // Account every retained capacity before returning the immutable payload.
+        let nominal_bytes = nominals.iter().try_fold(
+            nominals
+                .capacity()
+                .checked_mul(std::mem::size_of::<HeaderNominal>())
+                .ok_or_else(limit)?,
+            |n, item| {
+                n.checked_add(item.header.estimated_bytes())
+                    .and_then(|n| {
+                        scope_heap(&item.context.scope)
+                            .ok()
+                            .and_then(|m| n.checked_add(m))
+                    })
+                    .and_then(|n| n.checked_add(item.definition.declared_name.capacity()))
+                    .and_then(|n| {
+                        n.checked_add(
+                            item.definition
+                                .module_path
+                                .capacity()
+                                .checked_mul(std::mem::size_of::<String>())?,
+                        )
+                    })
+                    .and_then(|n| {
+                        n.checked_add(
+                            item.definition
+                                .module_path
+                                .iter()
+                                .try_fold(0usize, |n, s| n.checked_add(s.capacity()))?,
+                        )
+                    })
+                    .ok_or_else(limit)
+            },
+        )?;
+        let metadata_bytes = crate::traits::header::captured_capacity_bytes(&headers)?
+            .checked_add(nominal_bytes)
+            .ok_or_else(limit)?
+            .checked_add(std::mem::size_of::<CapturedSourceHeaders>())
+            .and_then(|n| scope_heap(&scope).ok().and_then(|m| n.checked_add(m)))
+            .and_then(|n| n.checked_add(path.heap_bytes()))
+            .and_then(|n| n.checked_add(self.profile.semantics.capacity()))
+            .filter(|n| *n <= limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        Ok(CapturedSourceHeaders {
+            source: self.key(),
+            path,
+            cfg: cfg.fingerprint(),
+            scope,
+            headers,
+            nominals,
+            scan_identity: scan.fingerprint(),
+            pending_producers: scan.producers().len(),
+            metadata_bytes,
+        })
+    }
+}
diff --git a/crates/lrr/src/traits/header.rs b/crates/lrr/src/traits/header.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/traits/header.rs
@@ -0,0 +1,792 @@
+//! Immutable source header data. No solver, dictionary, descriptor or body permission.
+use super::term::{ConstTerm, ParamKey, RegionTerm, TyTerm};
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    source::{manifest::DefKey, snapshot::SourcePath},
+    syntax::{
+        ast_adapter::TokenRecipe,
+        outline::{BodyHandle, DeclarationContext, HeaderRecipe, ScopeKey},
+        parse::ParseKey,
+        spans::SourceRange,
+    },
+};
+#[derive(Clone, Copy, Debug)]
+pub struct HeaderCaptureLimits {
+    pub headers: usize,
+    pub members: usize,
+    pub nodes: usize,
+    pub tokens: usize,
+    pub depth: usize,
+    pub metadata_bytes: usize,
+}
+impl Default for HeaderCaptureLimits {
+    fn default() -> Self {
+        Self {
+            headers: 10_000,
+            members: 100_000,
+            nodes: 1_000_000,
+            tokens: 1_000_000,
+            depth: 256,
+            metadata_bytes: 32 * 1024 * 1024,
+        }
+    }
+}
+impl HeaderCaptureLimits {
+    pub(crate) fn validate(self) -> Result<Self, Diagnostic> {
+        let maximum = Self::default();
+        if self.headers > maximum.headers
+            || self.members > maximum.members
+            || self.nodes > maximum.nodes
+            || self.tokens > maximum.tokens
+            || self.depth > maximum.depth
+            || self.metadata_bytes > maximum.metadata_bytes
+        {
+            return Err(fault("capture limits exceed fixed M019 ceilings"));
+        }
+        Ok(self)
+    }
+}
+pub(crate) fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TRAIT-HEADER", message.into())
+}
+pub(crate) fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "trait header count/depth/token/metadata limit".into(),
+    )
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct HeaderParameter {
+    pub key: ParamKey,
+    pub kind: super::term::BoundKind,
+    pub name: String,
+    pub bounds: Vec<TokenRecipe>,
+    pub default: Vec<TokenRecipe>,
+    pub const_type: Vec<TokenRecipe>,
+}
+impl StableEncode for HeaderParameter {
+    const DOMAIN: &'static str = "lrr/v5/trait-header-parameter/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.key);
+        e.u32(self.kind.tag());
+        e.string(&self.name);
+        encode_tokens(e, &self.bounds);
+        encode_tokens(e, &self.default);
+        encode_tokens(e, &self.const_type);
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum HeaderRegion {
+    Known(RegionTerm),
+    Unresolved(Vec<TokenRecipe>),
+}
+impl StableEncode for HeaderRegion {
+    const DOMAIN: &'static str = "lrr/v5/header-region/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        match self {
+            Self::Known(t) => {
+                e.u8(0);
+                e.record(t);
+            }
+            Self::Unresolved(t) => {
+                e.u8(1);
+                encode_tokens(e, t);
+            }
+        }
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum HeaderConst {
+    Parameter(ParamKey),
+    RequiredExpression {
+        range: SourceRange,
+        tokens: Vec<TokenRecipe>,
+    },
+}
+impl StableEncode for HeaderConst {
+    const DOMAIN: &'static str = "lrr/v5/header-const/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        match self {
+            Self::Parameter(p) => {
+                e.u8(0);
+                e.record(p);
+            }
+            Self::RequiredExpression { range, tokens } => {
+                e.u8(1);
+                encode_range(e, *range);
+                encode_tokens(e, tokens);
+            }
+        }
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum HeaderArgument {
+    Type(Box<HeaderType>),
+    Region(HeaderRegion),
+    Const(HeaderConst),
+    Associated {
+        name: Option<String>,
+        tokens: Vec<TokenRecipe>,
+    },
+}
+impl StableEncode for HeaderArgument {
+    const DOMAIN: &'static str = "lrr/v5/header-argument/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        match self {
+            Self::Type(t) => {
+                e.u8(0);
+                e.record(t.as_ref());
+            }
+            Self::Region(t) => {
+                e.u8(1);
+                e.record(t);
+            }
+            Self::Const(t) => {
+                e.u8(2);
+                e.record(t);
+            }
+            Self::Associated { name, tokens } => {
+                e.u8(3);
+                e.option(name, |e, s| e.string(s));
+                encode_tokens(e, tokens);
+            }
+        }
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct HeaderPathSegment {
+    pub name: Option<String>,
+    pub arguments: Vec<HeaderArgument>,
+    pub parenthesized: bool,
+    pub type_anchor: bool,
+    pub absolute_separator: bool,
+}
+impl StableEncode for HeaderPathSegment {
+    const DOMAIN: &'static str = "lrr/v5/header-path-segment/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.option(&self.name, |e, s| e.string(s));
+        e.sequence(&self.arguments, |e, a| e.record(a));
+        e.bool(self.parenthesized);
+        e.bool(self.type_anchor);
+        e.bool(self.absolute_separator);
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct HeaderType {
+    pub range: SourceRange,
+    pub tokens: Vec<TokenRecipe>,
+    pub form: HeaderTypeForm,
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum HeaderTypeForm {
+    Parameter(ParamKey),
+    SelfType(Digest),
+    AssociatedType(Digest),
+    Tuple(Vec<HeaderType>),
+    Array(Box<HeaderType>, HeaderConst),
+    Slice(Box<HeaderType>),
+    Reference {
+        region: HeaderRegion,
+        mutable: bool,
+        pointee: Box<HeaderType>,
+    },
+    Path(Vec<HeaderPathSegment>),
+    Never,
+    RequiredSyntax,
+}
+impl HeaderType {
+    /// Only existing symbolic APIs' closed structure/actual parameters. Paths and
+    /// `Self` cannot acquire source definition identity from their spelling.
+    pub fn symbolic(&self) -> Option<TyTerm> {
+        match &self.form {
+            HeaderTypeForm::Parameter(p) => Some(TyTerm::Param(*p)),
+            HeaderTypeForm::Tuple(v) if v.is_empty() => {
+                Some(TyTerm::Primitive(crate::ir::op::PrimitiveType::Unit))
+            }
+            HeaderTypeForm::Tuple(v) => v
+                .iter()
+                .map(Self::symbolic)
+                .collect::<Option<Vec<_>>>()
+                .map(TyTerm::Tuple),
+            HeaderTypeForm::Array(t, HeaderConst::Parameter(p)) => {
+                Some(TyTerm::Array(Box::new(t.symbolic()?), ConstTerm::Param(*p)))
+            }
+            HeaderTypeForm::Slice(t) => Some(TyTerm::Slice(Box::new(t.symbolic()?))),
+            HeaderTypeForm::Reference {
+                region: HeaderRegion::Known(r),
+                mutable,
+                pointee,
+            } => Some(TyTerm::Ref(
+                r.clone(),
+                *mutable,
+                Box::new(pointee.symbolic()?),
+            )),
+            HeaderTypeForm::Never => Some(TyTerm::Never),
+            _ => None,
+        }
+    }
+}
+impl StableEncode for HeaderType {
+    const DOMAIN: &'static str = "lrr/v5/header-type/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        encode_range(e, self.range);
+        encode_tokens(e, &self.tokens);
+        match &self.form {
+            HeaderTypeForm::Parameter(p) => {
+                e.u8(0);
+                e.record(p);
+            }
+            HeaderTypeForm::SelfType(d) => {
+                e.u8(1);
+                e.digest(*d);
+            }
+            HeaderTypeForm::Tuple(v) => {
+                e.u8(2);
+                e.sequence(v, |e, t| e.record(t));
+            }
+            HeaderTypeForm::Array(t, c) => {
+                e.u8(3);
+                e.record(t.as_ref());
+                e.record(c);
+            }
+            HeaderTypeForm::Slice(t) => {
+                e.u8(4);
+                e.record(t.as_ref());
+            }
+            HeaderTypeForm::Reference {
+                region,
+                mutable,
+                pointee,
+            } => {
+                e.u8(5);
+                e.record(region);
+                e.bool(*mutable);
+                e.record(pointee.as_ref());
+            }
+            HeaderTypeForm::Path(p) => {
+                e.u8(6);
+                e.sequence(p, |e, s| e.record(s));
+            }
+            HeaderTypeForm::AssociatedType(d) => {
+                e.u8(9);
+                e.digest(*d);
+            }
+            HeaderTypeForm::Never => e.u8(7),
+            HeaderTypeForm::RequiredSyntax => e.u8(8),
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum BoundModifier {
+    Ordinary,
+    Relaxed,
+    RequiredConstOrOther,
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct HeaderBound {
+    pub range: SourceRange,
+    pub binder: Vec<HeaderParameter>,
+    pub modifier: BoundModifier,
+    pub ty: Option<HeaderType>,
+    pub lifetime: Option<HeaderRegion>,
+    pub tokens: Vec<TokenRecipe>,
+}
+impl StableEncode for HeaderBound {
+    const DOMAIN: &'static str = "lrr/v5/header-bound/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        encode_range(e, self.range);
+        e.sequence(&self.binder, |e, p| e.record(p));
+        e.u8(match self.modifier {
+            BoundModifier::Ordinary => 0,
+            BoundModifier::Relaxed => 1,
+            BoundModifier::RequiredConstOrOther => 2,
+        });
+        e.option(&self.ty, |e, t| e.record(t));
+        e.option(&self.lifetime, |e, t| e.record(t));
+        encode_tokens(e, &self.tokens);
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum PredicateKind {
+    Bound {
+        subject: HeaderType,
+        bounds: Vec<HeaderBound>,
+    },
+    RegionOutlives {
+        subject: HeaderRegion,
+        bounds: Vec<HeaderBound>,
+    },
+    ImplicitSized {
+        subject: HeaderType,
+        relaxed: Vec<HeaderBound>,
+    },
+    RequiredSyntax(Vec<TokenRecipe>),
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct HeaderPredicate {
+    pub range: SourceRange,
+    pub binder: Vec<HeaderParameter>,
+    pub kind: PredicateKind,
+}
+impl StableEncode for HeaderPredicate {
+    const DOMAIN: &'static str = "lrr/v5/header-predicate/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        encode_range(e, self.range);
+        e.sequence(&self.binder, |e, p| e.record(p));
+        match &self.kind {
+            PredicateKind::Bound { subject, bounds } => {
+                e.u8(0);
+                e.record(subject);
+                e.sequence(bounds, |e, b| e.record(b));
+            }
+            PredicateKind::RegionOutlives { subject, bounds } => {
+                e.u8(1);
+                e.record(subject);
+                e.sequence(bounds, |e, b| e.record(b));
+            }
+            PredicateKind::ImplicitSized { subject, relaxed } => {
+                e.u8(2);
+                e.record(subject);
+                e.sequence(relaxed, |e, b| e.record(b));
+            }
+            PredicateKind::RequiredSyntax(t) => {
+                e.u8(3);
+                encode_tokens(e, t);
+            }
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AssociatedKind {
+    Method,
+    Type,
+    Constant,
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct AssociatedHeader {
+    pub definition: DefKey,
+    pub context: DeclarationContext,
+    pub header: HeaderRecipe,
+    pub kind: AssociatedKind,
+    pub generics: Vec<HeaderParameter>,
+    pub predicates: Vec<HeaderPredicate>,
+    pub parameter_types: Vec<HeaderType>,
+    pub receiver: Vec<TokenRecipe>,
+    pub declared_type: Option<HeaderType>,
+    pub body: Option<BodyHandle>,
+}
+impl StableEncode for AssociatedHeader {
+    const DOMAIN: &'static str = "lrr/v5/associated-header/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.definition);
+        e.record(&self.context);
+        e.record(&self.header);
+        e.u8(match self.kind {
+            AssociatedKind::Method => 0,
+            AssociatedKind::Type => 1,
+            AssociatedKind::Constant => 2,
+        });
+        e.sequence(&self.generics, |e, p| e.record(p));
+        e.sequence(&self.predicates, |e, p| e.record(p));
+        e.sequence(&self.parameter_types, |e, t| e.record(t));
+        encode_tokens(e, &self.receiver);
+        e.option(&self.declared_type, |e, t| e.record(t));
+        e.option(&self.body, |e, b| e.record(b));
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum HeaderKind {
+    Trait {
+        supertraits: Vec<HeaderBound>,
+        alias: bool,
+        auto_trait: bool,
+        unsafe_trait: bool,
+    },
+    Impl {
+        trait_type: Option<Box<HeaderType>>,
+        self_type: Box<HeaderType>,
+        negative: bool,
+        unsafe_impl: bool,
+        default_impl: bool,
+    },
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SourceTraitHeader {
+    pub(crate) source: ParseKey,
+    pub(crate) path: SourcePath,
+    pub(crate) cfg: Digest,
+    pub(crate) definition: DefKey,
+    pub(crate) context: DeclarationContext,
+    pub(crate) header: HeaderRecipe,
+    pub(crate) kind: HeaderKind,
+    pub(crate) generics: Vec<HeaderParameter>,
+    pub(crate) predicates: Vec<HeaderPredicate>,
+    pub(crate) associated: Vec<AssociatedHeader>,
+    pub(crate) scan_identity: Option<Digest>,
+}
+impl SourceTraitHeader {
+    pub fn source(&self) -> &ParseKey {
+        &self.source
+    }
+    pub fn definition(&self) -> &DefKey {
+        &self.definition
+    }
+    pub fn context(&self) -> &DeclarationContext {
+        &self.context
+    }
+    pub fn header(&self) -> &HeaderRecipe {
+        &self.header
+    }
+    pub fn kind(&self) -> &HeaderKind {
+        &self.kind
+    }
+    pub fn generics(&self) -> &[HeaderParameter] {
+        &self.generics
+    }
+    pub fn predicates(&self) -> &[HeaderPredicate] {
+        &self.predicates
+    }
+    pub fn associated(&self) -> &[AssociatedHeader] {
+        &self.associated
+    }
+    pub fn exact_identity(&self) -> Digest {
+        self.fingerprint()
+    }
+}
+impl StableEncode for SourceTraitHeader {
+    const DOMAIN: &'static str = "lrr/v5/source-trait-header/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.source);
+        e.string(self.path.as_str());
+        e.digest(self.cfg);
+        e.record(&self.definition);
+        e.record(&self.context);
+        e.record(&self.header);
+        match &self.kind {
+            HeaderKind::Trait {
+                supertraits,
+                alias,
+                auto_trait,
+                unsafe_trait,
+            } => {
+                e.u8(0);
+                e.sequence(supertraits, |e, b| e.record(b));
+                e.bool(*alias);
+                e.bool(*auto_trait);
+                e.bool(*unsafe_trait);
+            }
+            HeaderKind::Impl {
+                trait_type,
+                self_type,
+                negative,
+                unsafe_impl,
+                default_impl,
+            } => {
+                e.u8(1);
+                e.option(trait_type, |e, t| e.record(t.as_ref()));
+                e.record(self_type.as_ref());
+                e.bool(*negative);
+                e.bool(*unsafe_impl);
+                e.bool(*default_impl);
+            }
+        }
+        e.sequence(&self.generics, |e, p| e.record(p));
+        e.sequence(&self.predicates, |e, p| e.record(p));
+        e.sequence(&self.associated, |e, m| e.record(m));
+        e.option(&self.scan_identity, |e, d| e.digest(*d));
+    }
+}
+#[derive(Clone, Debug)]
+pub(crate) struct HeaderNominal {
+    pub definition: DefKey,
+    pub context: DeclarationContext,
+    pub header: HeaderRecipe,
+}
+impl StableEncode for HeaderNominal {
+    const DOMAIN: &'static str = "lrr/v5/header-nominal-attachment/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.definition);
+        e.record(&self.context);
+        e.record(&self.header);
+    }
+}
+#[derive(Debug)]
+pub struct CapturedSourceHeaders {
+    pub(crate) source: ParseKey,
+    pub(crate) path: SourcePath,
+    pub(crate) cfg: Digest,
+    pub(crate) scope: ScopeKey,
+    pub(crate) headers: Vec<SourceTraitHeader>,
+    pub(crate) nominals: Vec<HeaderNominal>,
+    pub(crate) scan_identity: Digest,
+    pub(crate) pending_producers: usize,
+    pub(crate) metadata_bytes: usize,
+}
+impl CapturedSourceHeaders {
+    pub fn source(&self) -> &ParseKey {
+        &self.source
+    }
+    pub fn headers(&self) -> &[SourceTraitHeader] {
+        &self.headers
+    }
+    pub fn metadata_bytes(&self) -> usize {
+        self.metadata_bytes
+    }
+    pub fn pending_producers(&self) -> usize {
+        self.pending_producers
+    }
+}
+impl StableEncode for CapturedSourceHeaders {
+    const DOMAIN: &'static str = "lrr/v5/trait-header-fragment/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.source);
+        e.string(self.path.as_str());
+        e.digest(self.cfg);
+        e.record(&self.scope);
+        e.digest(self.scan_identity);
+        e.sequence(&self.headers, |e, h| e.record(h));
+        e.sequence(&self.nominals, |e, n| e.record(n));
+        e.u64(self.pending_producers as u64);
+    }
+}
+pub(crate) fn encode_tokens(e: &mut StableEncoder, t: &[TokenRecipe]) {
+    e.sequence(t, |e, t| e.record(t));
+}
+pub(crate) fn encode_range(e: &mut StableEncoder, r: SourceRange) {
+    e.u32(r.start);
+    e.u32(r.end);
+}
+
+/// Checked owned-capacity accounting shared by capture and catalog admission.
+pub(crate) fn captured_capacity_bytes(
+    headers: &Vec<SourceTraitHeader>,
+) -> Result<usize, Diagnostic> {
+    struct Size {
+        bytes: usize,
+        work: usize,
+    }
+    impl Size {
+        fn add(&mut self, n: usize) -> Result<(), Diagnostic> {
+            self.bytes = self
+                .bytes
+                .checked_add(n)
+                .filter(|n| *n <= 32 * 1024 * 1024)
+                .ok_or_else(limit)?;
+            Ok(())
+        }
+        fn vec<T>(&mut self, v: &Vec<T>) -> Result<(), Diagnostic> {
+            self.add(
+                v.capacity()
+                    .checked_mul(std::mem::size_of::<T>())
+                    .ok_or_else(limit)?,
+            )
+        }
+        fn step(&mut self, depth: usize) -> Result<(), Diagnostic> {
+            self.work = self
+                .work
+                .checked_add(1)
+                .filter(|n| *n <= 1_000_000)
+                .ok_or_else(limit)?;
+            if depth >= 256 {
+                return Err(limit());
+            }
+            Ok(())
+        }
+        fn tokens(&mut self, t: &Vec<TokenRecipe>) -> Result<(), Diagnostic> {
+            self.vec(t)?;
+            for t in t {
+                self.add(t.text.capacity())?;
+            }
+            Ok(())
+        }
+        fn params(&mut self, p: &Vec<HeaderParameter>) -> Result<(), Diagnostic> {
+            self.vec(p)?;
+            for p in p {
+                self.add(p.name.capacity())?;
+                self.tokens(&p.bounds)?;
+                self.tokens(&p.default)?;
+                self.tokens(&p.const_type)?;
+            }
+            Ok(())
+        }
+        fn region(&mut self, r: &HeaderRegion) -> Result<(), Diagnostic> {
+            if let HeaderRegion::Unresolved(t) = r {
+                self.tokens(t)?;
+            }
+            Ok(())
+        }
+        fn constant(&mut self, c: &HeaderConst) -> Result<(), Diagnostic> {
+            if let HeaderConst::RequiredExpression { tokens, .. } = c {
+                self.tokens(tokens)?;
+            }
+            Ok(())
+        }
+        fn ty(&mut self, t: &HeaderType, depth: usize) -> Result<(), Diagnostic> {
+            self.step(depth)?;
+            self.tokens(&t.tokens)?;
+            match &t.form {
+                HeaderTypeForm::Tuple(v) => {
+                    self.vec(v)?;
+                    for t in v {
+                        self.ty(t, depth + 1)?;
+                    }
+                }
+                HeaderTypeForm::Array(t, c) => {
+                    self.add(std::mem::size_of::<HeaderType>())?;
+                    self.ty(t, depth + 1)?;
+                    self.constant(c)?;
+                }
+                HeaderTypeForm::Slice(t) => {
+                    self.add(std::mem::size_of::<HeaderType>())?;
+                    self.ty(t, depth + 1)?;
+                }
+                HeaderTypeForm::Reference {
+                    region, pointee, ..
+                } => {
+                    self.region(region)?;
+                    self.add(std::mem::size_of::<HeaderType>())?;
+                    self.ty(pointee, depth + 1)?;
+                }
+                HeaderTypeForm::Path(p) => {
+                    self.vec(p)?;
+                    for p in p {
+                        if let Some(n) = &p.name {
+                            self.add(n.capacity())?;
+                        }
+                        self.vec(&p.arguments)?;
+                        for a in &p.arguments {
+                            match a {
+                                HeaderArgument::Type(t) => {
+                                    self.add(std::mem::size_of::<HeaderType>())?;
+                                    self.ty(t, depth + 1)?;
+                                }
+                                HeaderArgument::Region(r) => self.region(r)?,
+                                HeaderArgument::Const(c) => self.constant(c)?,
+                                HeaderArgument::Associated { name, tokens } => {
+                                    if let Some(n) = name {
+                                        self.add(n.capacity())?;
+                                    }
+                                    self.tokens(tokens)?;
+                                }
+                            }
+                        }
+                    }
+                }
+                _ => {}
+            }
+            Ok(())
+        }
+        fn bounds(&mut self, b: &Vec<HeaderBound>) -> Result<(), Diagnostic> {
+            self.vec(b)?;
+            for b in b {
+                self.params(&b.binder)?;
+                if let Some(t) = &b.ty {
+                    self.ty(t, 0)?;
+                }
+                if let Some(r) = &b.lifetime {
+                    self.region(r)?;
+                }
+                self.tokens(&b.tokens)?;
+            }
+            Ok(())
+        }
+        fn predicates(&mut self, p: &Vec<HeaderPredicate>) -> Result<(), Diagnostic> {
+            self.vec(p)?;
+            for p in p {
+                self.step(0)?;
+                self.params(&p.binder)?;
+                match &p.kind {
+                    PredicateKind::Bound { subject, bounds } => {
+                        self.ty(subject, 0)?;
+                        self.bounds(bounds)?;
+                    }
+                    PredicateKind::RegionOutlives { subject, bounds } => {
+                        self.region(subject)?;
+                        self.bounds(bounds)?;
+                    }
+                    PredicateKind::ImplicitSized { subject, relaxed } => {
+                        self.ty(subject, 0)?;
+                        self.bounds(relaxed)?;
+                    }
+                    PredicateKind::RequiredSyntax(t) => self.tokens(t)?,
+                }
+            }
+            Ok(())
+        }
+        fn header(&mut self, h: &HeaderRecipe) -> Result<(), Diagnostic> {
+            self.add(h.profile.semantics.capacity())?;
+            self.tokens(&h.tokens)?;
+            self.tokens(&h.context)?;
+            self.vec(&h.attributes)?;
+            for a in &h.attributes {
+                self.add(a.name.capacity())?;
+                self.tokens(&a.tokens)?;
+            }
+            if let crate::syntax::outline::Visibility::Restricted(t) = &h.visibility {
+                self.tokens(t)?;
+            }
+            Ok(())
+        }
+        fn definition(&mut self, d: &DefKey) -> Result<(), Diagnostic> {
+            self.vec(&d.module_path)?;
+            for n in &d.module_path {
+                self.add(n.capacity())?;
+            }
+            self.add(d.declared_name.capacity())
+        }
+        fn scope(&mut self, s: &ScopeKey) -> Result<(), Diagnostic> {
+            self.vec(&s.module_path)?;
+            for n in &s.module_path {
+                self.add(n.capacity())?;
+            }
+            Ok(())
+        }
+    }
+    let mut s = Size { bytes: 0, work: 0 };
+    s.vec(headers)?;
+    for h in headers {
+        s.step(0)?;
+        s.add(h.source.profile.semantics.capacity())?;
+        s.add(h.path.heap_bytes())?;
+        s.definition(&h.definition)?;
+        s.scope(&h.context.scope)?;
+        s.header(&h.header)?;
+        s.params(&h.generics)?;
+        s.predicates(&h.predicates)?;
+        match &h.kind {
+            HeaderKind::Trait { supertraits, .. } => s.bounds(supertraits)?,
+            HeaderKind::Impl {
+                trait_type,
+                self_type,
+                ..
+            } => {
+                if let Some(t) = trait_type {
+                    s.add(std::mem::size_of::<HeaderType>())?;
+                    s.ty(t, 0)?;
+                }
+                s.add(std::mem::size_of::<HeaderType>())?;
+                s.ty(self_type, 0)?;
+            }
+        }
+        s.vec(&h.associated)?;
+        for m in &h.associated {
+            s.definition(&m.definition)?;
+            s.scope(&m.context.scope)?;
+            s.header(&m.header)?;
+            s.params(&m.generics)?;
+            s.predicates(&m.predicates)?;
+            s.vec(&m.parameter_types)?;
+            for t in &m.parameter_types {
+                s.ty(t, 0)?;
+            }
+            s.tokens(&m.receiver)?;
+            if let Some(t) = &m.declared_type {
+                s.ty(t, 0)?;
+            }
+        }
+    }
+    Ok(s.bytes)
+}
