+#[test]
+fn m019_cfg_and_cold_body_semantic_identity_controls() {
+    let first = capture(
+        "trait P { fn f<T: X>(&self) { unknown!(side_effect); } } #[cfg(any())] impl P for Missing {} impl P for () { fn f<T: X>(&self) { panic!() } }",
+        38,
+        2024,
+    );
+    let second = capture(
+        "trait P { fn f<T: X>(&self) { totally_different(); } } #[cfg(any())] impl P for Missing {} impl P for () { fn f<T: X>(&self) { loop {} } }",
+        38,
+        2024,
+    );
+    assert_eq!(first.headers().len(), 2);
+    assert_eq!(second.headers().len(), 2);
+    for (a, b) in first.headers().iter().zip(second.headers()) {
+        assert_eq!(a.header().fingerprint(), b.header().fingerprint());
+        assert_eq!(
+            a.associated()[0].header.fingerprint(),
+            b.associated()[0].header.fingerprint()
+        );
+    }
+    assert_ne!(first.source().content, second.source().content);
+}
