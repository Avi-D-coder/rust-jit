+#[test]
+fn m019_actual_seal_required_and_wrong_domain_refuses() {
+    use lrr::{
+        db::{
+            memo::Database,
+            seals::{SealDomain, SealKey},
+        },
+        traits::index::CurrentImplCandidateIndex,
+    };
+    let db = Database::default();
+    let query_revision = db.revision();
+    let source_revision = db.source_revision();
+    let impl_key = SealKey {
+        domain: SealDomain::ImplCatalog {
+            id: Digest([42; 32]),
+        },
+        unit_graph: Digest([43; 32]),
+        epoch: 1,
+    };
+    assert!(
+        CurrentImplCandidateIndex::capture_current(&db, &impl_key, HeaderCaptureLimits::default())
+            .is_err()
+    );
+    let wrong = SealKey {
+        domain: SealDomain::TestCatalog {
+            id: Digest([42; 32]),
+        },
+        ..impl_key
+    };
+    assert!(
+        CurrentImplCandidateIndex::capture_current(&db, &wrong, HeaderCaptureLimits::default())
+            .is_err()
+    );
+    assert_eq!(db.revision(), query_revision);
+    assert_eq!(db.source_revision(), source_revision);
+    assert!(db.trace.events.is_empty());
+    assert!(db.trace.counts.is_empty());
+}
+#[test]
+fn m019_source_binders_self_and_const_parameters_keep_exact_namespaces() {
+    use lrr::traits::{
+        header::{HeaderArgument, HeaderConst, HeaderRegion},
+        term::{ConstTerm, RegionTerm, TyTerm},
+    };
+    let source = "trait X<'a, const N: usize> {} trait P<T> { fn f(&self) -> Self; } impl<T, const N: usize> X<'static,N> for [();N] where for<'b> T: X<'b,N> {}";
+    let fragment = capture(source, 44, 2024);
+    let p = fragment
+        .headers()
+        .iter()
+        .find(|h| h.definition().declared_name == "P")
+        .unwrap();
+    assert!(
+        matches!(p.associated()[0].declared_type.as_ref().unwrap().form,HeaderTypeForm::SelfType(owner) if owner==p.definition().fingerprint())
+    );
+    let i = fragment
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+        .unwrap();
+    assert!(
+        matches!(i.kind(),HeaderKind::Impl {self_type,..} if matches!(self_type.symbolic(),Some(TyTerm::Array(_,ConstTerm::Param(_)))))
+    );
+    let where_bound = i
+        .predicates()
+        .iter()
+        .find(|p| !p.binder.is_empty())
+        .unwrap();
+    let PredicateKind::Bound { bounds, .. } = &where_bound.kind else {
+        panic!("expected bound")
+    };
+    let HeaderTypeForm::Path(segments) = &bounds[0].ty.as_ref().unwrap().form else {
+        panic!("expected source path")
+    };
+    assert!(matches!(
+        &segments[0].arguments[0],
+        HeaderArgument::Region(HeaderRegion::Known(RegionTerm::Bound {
+            depth: 0,
+            index: 0
+        }))
+    ));
+    assert!(
+        matches!(&segments[0].arguments[1],HeaderArgument::Const(HeaderConst::Parameter(key)) if *key==i.generics()[1].key)
+    );
+    // Non-lifetime binder semantics need ordered M017/M020 admission. Their
+    // spelling must never bind an outer same-named parameter or ambient type.
+    let blocked = capture("trait Z {} impl<T> Z for T where for<T> T: Z {}", 46, 2024);
+    let i = blocked
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+        .unwrap();
+    let p = i
+        .predicates()
+        .iter()
+        .find(|p| !p.binder.is_empty())
+        .unwrap();
+    assert!(
+        matches!(&p.kind,PredicateKind::Bound {subject,..} if matches!(subject.form,HeaderTypeForm::RequiredSyntax) && subject.symbolic().is_none())
+    );
+}
