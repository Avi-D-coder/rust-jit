+//! Actual unchanged upstream assertion operand and LRR source-authority controls.
+//! These stop before string comparison and are not whole-fixture passes.
+use super::*;
+use crate::{
+    ir::op::PrimitiveType,
+    runtime::shape::TypeKey,
+    traits::term::{RegionTerm, TyTerm},
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/unicode-escape-sequences.rs"
+);
+fn reached(
+    db: &mut Database,
+    run: &mut RunMachine,
+    contexts: &[crate::engine::runtime_macros::RuntimeMacroContext<'_>],
+) -> (crate::engine::install::RecipeId, LiteralRecipe, SlotId) {
+    tests::reach_literal_kind(db, run, contexts, LiteralKind::String, true)
+}
+fn effects(run: &RunMachine) -> (u64, u32, usize, usize, u64) {
+    (
+        run.frame.counters().operations_started,
+        run.store.budget().handles(),
+        run.store.budget().bytes(),
+        run.store.type_metadata_bytes(),
+        run.frame.fuel_snapshot().used,
+    )
+}
+#[test]
+fn unchanged_unicode_macro_string_operand_requires_current_source_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(ORIGINAL, edition, 1000);
+        let contexts = macros.contexts().unwrap();
+        let (id, literal, destination) = reached(&mut db, &mut run, &contexts);
+        let Some(DecodedLiteral::String(payload)) = &literal.decoded else {
+            panic!("unchanged original UTF8 operand");
+        };
+        assert_eq!(payload.text(), "☃");
+        let before = effects(&run);
+        assert!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .is_err()
+        );
+        assert_eq!(effects(&run), before);
+        assert!(run.prepare_macro_byte_literal(&mut db, &[], id).is_err());
+        assert_eq!(effects(&run), before);
+        run.prepare_macro_byte_literal(&mut db, &contexts, id)
+            .unwrap();
+        assert_eq!(effects(&run), before);
+        run.frame
+            .require_macro_byte_literal(&literal, destination)
+            .unwrap();
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+        assert_eq!(
+            run.frame.source_view(destination).unwrap(),
+            Some(TyTerm::Ref(
+                RegionTerm::Static,
+                false,
+                Box::new(TyTerm::Str)
+            ))
+        );
+        let reference_type = run
+            .store
+            .find_type(&TypeKey::Ref {
+                mutable: false,
+                target: crate::runtime::shape::TypeId(16),
+            })
+            .unwrap();
+        let cell = run.frame.cell(destination).unwrap();
+        let reference = run.store.reference_from_cell(cell).unwrap();
+        let ticket = run.store.reference_ticket(reference).unwrap();
+        assert_eq!(
+            run.store.peek_ticket(ticket).unwrap().type_id,
+            reference_type.0
+        );
+        run.store.discard(ticket).unwrap();
+        assert_eq!(run.frame.counters().operations_started, before.0 + 1);
+        db.finish_run().unwrap();
+    }
+}
+#[test]
+fn macro_string_certificate_cannot_change_kind_span_slot_or_source_context() {
+    let (mut db, mut run, macros, _) = tests::start_source(ORIGINAL, 2024, 1000);
+    let contexts = macros.contexts().unwrap();
+    let (id, literal, destination) = reached(&mut db, &mut run, &contexts);
+    run.prepare_macro_byte_literal(&mut db, &contexts, id)
+        .unwrap();
+    let before = effects(&run);
+    let mut wrong = literal.clone();
+    wrong.kind = LiteralKind::ByteString;
+    assert!(
+        run.frame
+            .require_macro_byte_literal(&wrong, destination)
+            .is_err()
+    );
+    wrong = literal.clone();
+    wrong.source.relative_end += 1;
+    assert!(
+        run.frame
+            .require_macro_byte_literal(&wrong, destination)
+            .is_err()
+    );
+    assert!(
+        run.frame
+            .require_macro_byte_literal(&literal, SlotId(u32::MAX))
+            .is_err()
+    );
+    // Current macro authority cannot overwrite a conflicting reached source type.
+    run.frame
+        .set_source_view(destination, Some(TyTerm::Primitive(PrimitiveType::U8)))
+        .unwrap();
+    assert!(
+        step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap()
+        )
+        .is_err()
+    );
+    assert_eq!(effects(&run), before);
+    db.finish_run().unwrap();
+}
+#[test]
+fn unchanged_macro_string_operand_refuses_republished_source_before_effects() {
+    let (mut db, mut run, macros, inputs) = tests::start_source(ORIGINAL, 2024, 1000);
+    let contexts = macros.contexts().unwrap();
+    let (id, _, _) = reached(&mut db, &mut run, &contexts);
+    run.prepare_macro_byte_literal(&mut db, &contexts, id)
+        .unwrap();
+    let before = effects(&run);
+    db.finish_run().unwrap();
+    inputs.publish(&mut db).unwrap();
+    db.begin_run().unwrap();
+    assert!(matches!(
+        run.poll_with_runtime_macros(&mut db, &contexts),
+        RunPoll::Fault(Diagnostic {
+            code: "LRR-E-INTERNAL-SNAPSHOT",
+            ..
+        })
+    ));
+    assert_eq!(effects(&run), before);
+    db.finish_run().unwrap();
+}
