+/// Bytes may share physical storage, but their decoder/source types are distinct.
+#[derive(Clone)]
+enum MacroLiteralPayload {
+    Bytes(ByteStringLiteral),
+    Utf8(StringLiteral),
+}
+impl MacroLiteralPayload {
+    fn from_literal(literal: &LiteralRecipe) -> Result<Self, Diagnostic> {
+        match (literal.kind, &literal.decoded) {
+            (LiteralKind::ByteString, Some(DecodedLiteral::ByteString(payload))) => {
+                Ok(Self::Bytes(payload.clone()))
+            }
+            (LiteralKind::String, Some(DecodedLiteral::String(payload))) => {
+                Ok(Self::Utf8(payload.clone()))
+            }
+            _ => Err(call_fault("macro immutable literal decoder kind differs")),
+        }
+    }
+    fn allocated_bytes(&self) -> Option<usize> {
+        match self {
+            Self::Bytes(payload) => payload.allocated_bytes(),
+            Self::Utf8(payload) => payload.allocated_bytes(),
+        }
+    }
+    fn same_decoded_payload(&self, other: &Self) -> bool {
+        match (self, other) {
+            (Self::Bytes(left), Self::Bytes(right)) => left.same_decoded_payload(right),
+            (Self::Utf8(left), Self::Utf8(right)) => left.same_decoded_payload(right),
+            _ => false,
+        }
+    }
+}
 
