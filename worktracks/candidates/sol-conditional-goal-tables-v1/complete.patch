+//! M021/M022 component model controls, not source selection or stock execution.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    ir::op::PrimitiveType,
+    source::snapshot::{CfgSet, SourceBlob, SourcePath},
+    syntax::{outline::ScopeKey, parse::ParsedFile},
+    traits::{
+        canonical::{CanonicalContextModel, CanonicalLimits, GoalModel},
+        header::{CapturedSourceHeaders, HeaderCaptureLimits, HeaderKind, SourceTraitHeader},
+        table::{
+            CandidatePairModel, CycleKindModel, EdgeKindModel, GoalTablesModel,
+            PredicateChildModel, TableError, TableLimit, TableLimits, TableOutcomeModel,
+            TableState,
+        },
+        term::{Binder, GenericArg, InferVarKey, ParamEnv, TraitRef, TyTerm},
+    },
+};
+use std::collections::BTreeMap;
+const ADAPTER: &str = "trait A {} trait B {} impl A for () where (): B {} impl B for () {} impl A for ((),) {} impl !B for u8 {}";
+fn headers(text: &str) -> CapturedSourceHeaders {
+    let mut profile = ProfileIdentity::current();
+    profile.edition = 2015;
+    ParsedFile::parse_declarations(&SourceBlob::new(text.as_bytes().to_vec()).unwrap(), profile)
+        .unwrap()
+        .capture_trait_headers(
+            SourcePath::new("table_fixture.rs").unwrap(),
+            ScopeKey {
+                crate_key: Digest([117; 32]),
+                module_path: vec![],
+                owner: None,
+            },
+            &CfgSet::guest_default(),
+            HeaderCaptureLimits::default(),
+        )
+        .unwrap()
+}
+fn cx() -> CanonicalContextModel {
+    CanonicalContextModel {
+        transaction: Digest([118; 32]),
+        profile: ProfileIdentity::current(),
+        unit: Digest([119; 32]),
+        world: Digest([120; 32]),
+        catalog: Digest([121; 32]),
+        cfg: Digest([122; 32]),
+        source_namespace: Digest([123; 32]),
+        epoch: 1,
+        source_revision: 1,
+        query_revision: 1,
+        max_universe: 1,
+        excluded_dictionary_slots: vec![],
+    }
+}
+fn table(limits: TableLimits) -> GoalTablesModel {
+    GoalTablesModel::new(&cx(), limits, CanonicalLimits::default()).unwrap()
+}
+fn goal(
+    t: &mut GoalTablesModel,
+    h: &CapturedSourceHeaders,
+    tag: PrimitiveType,
+    kind: CycleKindModel,
+    residual: bool,
+) -> Digest {
+    let definition = h
+        .headers()
+        .iter()
+        .find(|x| matches!(x.kind(), HeaderKind::Trait { .. }))
+        .unwrap()
+        .definition()
+        .fingerprint();
+    let env = ParamEnv::new(definition, vec![], vec![]).unwrap();
+    // The closed Primitive argument and cycle/child labels are explicit table
+    // model adapters, not actual source Type namespace or auto-rule authority.
+    t.intern(
+        &cx(),
+        &Binder {
+            variables: vec![],
+            value: GoalModel::Implemented(TraitRef {
+                trait_key: definition,
+                self_ty: TyTerm::Primitive(PrimitiveType::Unit),
+                args: vec![GenericArg::Type(TyTerm::Primitive(tag))],
+            }),
+        },
+        &env,
+        &BTreeMap::new(),
+        kind,
+        residual,
+    )
+    .unwrap()
+}
+fn positive(h: &CapturedSourceHeaders) -> &SourceTraitHeader {
+    h.headers()
+        .iter()
+        .find(|x| {
+            matches!(
+                x.kind(),
+                HeaderKind::Impl {
+                    negative: false,
+                    ..
+                }
+            ) && x.predicates().is_empty()
+        })
+        .unwrap()
+}
+fn conditional(h: &CapturedSourceHeaders) -> &SourceTraitHeader {
+    h.headers()
+        .iter()
+        .find(|x| {
+            matches!(
+                x.kind(),
+                HeaderKind::Impl {
+                    negative: false,
+                    ..
+                }
+            ) && !x.predicates().is_empty()
+        })
+        .unwrap()
+}
+fn add(
+    t: &mut GoalTablesModel,
+    key: Digest,
+    h: &SourceTraitHeader,
+    child: Option<Digest>,
+    edge: EdgeKindModel,
+) {
+    let children = h
+        .predicates()
+        .iter()
+        .enumerate()
+        .map(|(ordinal, _)| PredicateChildModel {
+            ordinal,
+            goal: child.unwrap(),
+            edge,
+        })
+        .collect();
+    t.add_candidate_model(&cx(), key, h, &[], children).unwrap();
+}
+#[test]
+fn m021_original_conditional_false_predicate_and_cold_unrelated_table() {
+    let original = headers(include_str!(
+        "../../fixtures/upstream/rustc-checkout/tests/ui/traits/multidispatch-conditional-impl-not-considered.rs"
+    ));
+    let h = headers(ADAPTER);
+    let mut t = table(TableLimits::default());
+    let root = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let missing = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U16,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let cold = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U32,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    // Every genuine original pending header predicate remains mapped; the
+    // false child is a disclosed model, not a source-proven Clone judgment.
+    add(
+        &mut t,
+        root,
+        conditional(&original),
+        Some(missing),
+        EdgeKindModel::Ordinary,
+    );
+    assert!(matches!(
+        t.evaluate_model(&cx(), root, || false).unwrap().outcome,
+        TableOutcomeModel::NoSolution
+    ));
+    assert_eq!(t.state(cold), Some(TableState::New));
+    assert!(t.outcome(cold).is_none());
+}
+#[test]
+fn m021_conditional_success_does_not_skip_any_header_predicate() {
+    let h = headers(ADAPTER);
+    let mut t = table(TableLimits::default());
+    let root = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let child = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U16,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    assert!(
+        t.add_candidate_model(&cx(), root, conditional(&h), &[], vec![])
+            .is_err()
+    );
+    assert_eq!(t.counters().strands, 0);
+    add(&mut t, child, positive(&h), None, EdgeKindModel::Ordinary);
+    add(
+        &mut t,
+        root,
+        conditional(&h),
+        Some(child),
+        EdgeKindModel::Ordinary,
+    );
+    let result = t.evaluate_model(&cx(), root, || false).unwrap();
+    let TableOutcomeModel::Unique(answer) = result.outcome else {
+        panic!("conditional model did not discharge")
+    };
+    assert_eq!(answer.header, conditional(&h).exact_identity());
+    assert_eq!(answer.children.len(), conditional(&h).predicates().len());
+    assert!(!answer.provisional_auto);
+    assert_eq!(result.counters.visited, 2);
+    assert_eq!(
+        result
+            .transitions
+            .iter()
+            .filter(|e| e.to == TableState::Evaluating)
+            .count(),
+        2
+    );
+    assert_eq!(
+        result
+            .transitions
+            .iter()
+            .filter(|e| e.to == TableState::Complete)
+            .count(),
+        2
+    );
+}
+#[test]
+fn m021_conflicting_candidate_never_forces_children_or_constrains_sibling() {
+    let h = headers(ADAPTER);
+    let mut t = table(TableLimits::default());
+    let root = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let cold = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U16,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let children = conditional(&h)
+        .predicates()
+        .iter()
+        .enumerate()
+        .map(|(ordinal, _)| PredicateChildModel {
+            ordinal,
+            goal: cold,
+            edge: EdgeKindModel::Ordinary,
+        })
+        .collect();
+    t.add_candidate_model(
+        &cx(),
+        root,
+        conditional(&h),
+        &[CandidatePairModel {
+            template: TyTerm::Tuple(vec![]),
+            demand: TyTerm::Tuple(vec![TyTerm::Primitive(PrimitiveType::Unit)]),
+        }],
+        children,
+    )
+    .unwrap();
+    add(&mut t, root, positive(&h), None, EdgeKindModel::Ordinary);
+    assert!(matches!(
+        t.evaluate_model(&cx(), root, || false).unwrap().outcome,
+        TableOutcomeModel::Unique(_)
+    ));
+    assert_eq!(t.state(cold), Some(TableState::New));
+}
+#[test]
+fn m021_distinct_impls_remain_ambiguous_and_order_independent() {
+    let h = headers(ADAPTER);
+    let candidates = h
+        .headers()
+        .iter()
+        .filter(|h| {
+            matches!(
+                h.kind(),
+                HeaderKind::Impl {
+                    negative: false,
+                    ..
+                }
+            ) && h.predicates().is_empty()
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(candidates.len(), 2);
+    let run = |reverse| {
+        let mut t = table(TableLimits::default());
+        let key = goal(
+            &mut t,
+            &h,
+            PrimitiveType::U8,
+            CycleKindModel::Ordinary,
+            false,
+        );
+        let mut candidates = candidates.clone();
+        if reverse {
+            candidates.reverse();
+        }
+        for h in candidates {
+            add(&mut t, key, h, None, EdgeKindModel::Ordinary);
+        }
+        t.evaluate_model(&cx(), key, || false).unwrap().outcome
+    };
+    let a = run(false);
+    assert_eq!(a, run(true));
+    let TableOutcomeModel::Ambiguous(ids) = a else {
+        panic!("overlap model selected first impl")
+    };
+    assert_eq!(ids.len(), 2);
+    assert!(ids[0] < ids[1]);
+}
+#[test]
+fn m022_inductive_cycle_requires_finite_base_and_preserves_residual_inference() {
+    let original = headers(include_str!(
+        "../../fixtures/upstream/rustc-checkout/tests/ui/traits/solver-cycles/inductive-canonical-cycle.rs"
+    ));
+    assert!(
+        original
+            .headers()
+            .iter()
+            .filter(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+            .count()
+            >= 3
+    );
+    let h = headers(ADAPTER);
+    for residual in [false, true] {
+        let mut t = table(TableLimits::default());
+        let key = goal(
+            &mut t,
+            &h,
+            PrimitiveType::U8,
+            CycleKindModel::Ordinary,
+            residual,
+        );
+        add(
+            &mut t,
+            key,
+            conditional(&h),
+            Some(key),
+            EdgeKindModel::Ordinary,
+        );
+        let result = t.evaluate_model(&cx(), key, || false).unwrap();
+        assert!(if residual {
+            matches!(result.outcome, TableOutcomeModel::Unresolved(_))
+        } else {
+            matches!(result.outcome, TableOutcomeModel::NoSolution)
+        });
+    }
+    let mut t = table(TableLimits::default());
+    let a = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let b = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U16,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    add(&mut t, a, conditional(&h), Some(b), EdgeKindModel::Ordinary);
+    add(&mut t, b, positive(&h), None, EdgeKindModel::Ordinary);
+    assert!(matches!(
+        t.evaluate_model(&cx(), a, || false).unwrap().outcome,
+        TableOutcomeModel::Unique(_)
+    ));
+}
+#[test]
+fn m022_approved_auto_model_commits_only_successful_noncyclic_premises() {
+    let h = headers(
+        "trait A {} trait B {} trait C {} impl A for () where (): B, (): C {} impl B for () where (): A {} impl C for () {}",
+    );
+    let source = h
+        .headers()
