+#[test]
+fn m022_mid_work_cancellation_and_reduced_work_do_not_commit_partial_tables() {
+    use lrr::traits::term::ConstTerm;
+    let h = headers(ADAPTER);
+    let mut t = table(TableLimits::default());
+    let env = ParamEnv::new(h.headers()[0].definition().fingerprint(), vec![], vec![]).unwrap();
+    let mut keys = vec![];
+    for ordinal in 0..100 {
+        keys.push(
+            t.intern(
+                &cx(),
+                &Binder {
+                    variables: vec![],
+                    value: GoalModel::ConstEqual(
+                        ConstTerm::Value(ordinal),
+                        ConstTerm::Value(ordinal),
+                    ),
+                },
+                &env,
+                &BTreeMap::new(),
+                CycleKindModel::Ordinary,
+                false,
+            )
+            .unwrap(),
+        );
+    }
+    for pair in keys.windows(2) {
+        add(
+            &mut t,
+            pair[0],
+            conditional(&h),
+            Some(pair[1]),
+            EdgeKindModel::Ordinary,
+        );
+    }
+    add(
+        &mut t,
+        *keys.last().unwrap(),
+        positive(&h),
+        None,
+        EdgeKindModel::Ordinary,
+    );
+    let mut polls = 0;
+    let before = t.counters();
+    let result = t.evaluate_model(&cx(), keys[0], || {
+        polls += 1;
+        polls == 2
+    });
+    assert!(matches!(result, Err(TableError::Cancelled(_))));
+    assert_eq!(polls, 2);
+    assert_eq!(t.counters().work, before.work);
+    for key in keys {
+        assert_eq!(t.state(key), Some(TableState::New));
+        assert!(t.outcome(key).is_none());
+    }
+    // Closed leaf has a real candidate but the remaining evaluation budget is
+    // deliberately exhausted after admission. No cached absence is published.
+    let mut limits = TableLimits::default();
+    let mut probe = table(limits);
+    let key = goal(
+        &mut probe,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    add(&mut probe, key, positive(&h), None, EdgeKindModel::Ordinary);
+    limits.work = probe.counters().work;
+    let mut exact = table(limits);
+    let key = goal(
+        &mut exact,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    add(&mut exact, key, positive(&h), None, EdgeKindModel::Ordinary);
+    assert!(matches!(
+        exact.evaluate_model(&cx(), key, || false),
+        Err(TableError::Overflow(TableLimit::Work, _))
+    ));
+    assert_eq!(exact.state(key), Some(TableState::New));
+    assert!(exact.outcome(key).is_none());
+}
