+#[test]
+fn m022_cancellation_work_and_depth_never_publish_absence() {
+    let h = headers(ADAPTER);
+    let mut t = table(TableLimits::default());
+    let key = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    add(&mut t, key, positive(&h), None, EdgeKindModel::Ordinary);
+    let before = t.counters();
+    assert!(matches!(
+        t.evaluate_model(&cx(), key, || true),
+        Err(TableError::Cancelled(_))
+    ));
+    assert_eq!(t.state(key), Some(TableState::New));
+    assert!(t.outcome(key).is_none());
+    assert_eq!(t.counters().work, before.work);
+    let mut limits = TableLimits::default();
+    limits.depth = 0;
+    let mut t = table(limits);
+    let key = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let child = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U16,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    add(
+        &mut t,
+        key,
+        conditional(&h),
+        Some(child),
+        EdgeKindModel::Ordinary,
+    );
+    assert!(matches!(
+        t.evaluate_model(&cx(), key, || false),
+        Err(TableError::Overflow(TableLimit::Depth, _))
+    ));
+    assert_eq!(t.state(key), Some(TableState::New));
+    let mut limits = TableLimits::default();
+    limits.depth = 2;
+    let mut t = table(limits);
+    let a = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U8,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let b = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U16,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    let c = goal(
+        &mut t,
+        &h,
+        PrimitiveType::U32,
+        CycleKindModel::Ordinary,
+        false,
+    );
+    add(&mut t, a, conditional(&h), Some(b), EdgeKindModel::Ordinary);
+    add(&mut t, b, conditional(&h), Some(c), EdgeKindModel::Ordinary);
+    add(&mut t, c, positive(&h), None, EdgeKindModel::Ordinary);
+    assert!(matches!(
+        t.evaluate_model(&cx(), a, || false),
+        Err(TableError::Overflow(TableLimit::Depth, _))
+    ));
+    assert_eq!(t.state(a), Some(TableState::New));
+    let mut limits = TableLimits::default();
+    limits.work = 0;
+    let mut t = table(limits);
+    let env = ParamEnv::new(Digest([127; 32]), vec![], vec![]).unwrap();
+    assert!(matches!(
+        t.intern(
+            &cx(),
+            &Binder {
+                variables: vec![],
+                value: GoalModel::TypeEqual(
+                    TyTerm::Primitive(PrimitiveType::Unit),
+                    TyTerm::Primitive(PrimitiveType::Unit)
+                )
+            },
+            &env,
+            &BTreeMap::new(),
+            CycleKindModel::Ordinary,
+            false
+        ),
+        Err(TableError::Overflow(TableLimit::Work, _))
+    ));
+    assert_eq!(t.counters().tables, 0);
+}
