+fn m022_negative_mixed_and_escaping_edges_prevent_auto_shortcut() {
+    let original = headers(include_str!(
+        "../../fixtures/upstream/rustc-checkout/tests/ui/traits/negative-impls/negated-auto-traits-rpass.rs"
+    ));
+    let negative = original
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { negative: true, .. }))
+        .unwrap();
+    let h = headers(ADAPTER);
+    for mode in 0..4 {
+        let mut t = table(TableLimits::default());
+        let kind = CycleKindModel::StructuralAuto;
+        let a = goal(&mut t, &h, PrimitiveType::U8, kind, false);
+        let edge = if mode == 2 {
+            EdgeKindModel::Projection
+        } else {
+            EdgeKindModel::StructuralAuto
+        };
+        if mode == 1 {
+            let b = goal(
+                &mut t,
+                &h,
+                PrimitiveType::U16,
+                CycleKindModel::Ordinary,
+                false,
+            );
+            add(&mut t, a, conditional(&h), Some(b), EdgeKindModel::Ordinary);
+            add(
+                &mut t,
+                b,
+                conditional(&h),
+                Some(a),
+                EdgeKindModel::StructuralAuto,
+            );
+        } else {
+            add(&mut t, a, conditional(&h), Some(a), edge);
+        }
+        if mode == 0 {
+            t.record_negative_header_model(&cx(), a, negative).unwrap();
+        }
+        if mode == 3 {
+            let b = goal(
+                &mut t,
+                &h,
+                PrimitiveType::U16,
+                CycleKindModel::Ordinary,
+                false,
+            );
+            add(&mut t, b, positive(&h), None, EdgeKindModel::Ordinary);
+            let escape = headers("trait Z {} impl Z for () where (): Z, (): Z {}");
+            let hdr = conditional(&escape);
+            let children = hdr
+                .predicates()
+                .iter()
+                .enumerate()
+                .map(|(ordinal, _)| PredicateChildModel {
+                    ordinal,
+                    goal: if ordinal == 0 { a } else { b },
+                    edge: if ordinal == 0 {
+                        EdgeKindModel::StructuralAuto
+                    } else {
+                        EdgeKindModel::Ordinary
+                    },
+                })
+                .collect();
+            t.add_candidate_model(&cx(), a, hdr, &[], children).unwrap();
+        }
+        assert!(matches!(
+            t.evaluate_model(&cx(), a, || false).unwrap().outcome,
+            TableOutcomeModel::NoSolution
+        ));
+    }
