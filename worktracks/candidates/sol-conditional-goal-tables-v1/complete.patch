+//! Bounded conditional/cycle data model. No result is an admitted trait witness.
+use super::{
+    canonical::{
+        CanonicalContextModel, CanonicalError, CanonicalGoalModel, CanonicalLimits,
+        CurrentGoalPrerequisite, GoalModel,
+    },
+    header::{HeaderKind, SourceTraitHeader},
+    index::CurrentImplCandidateIndex,
+    term::{Binder, InferVarKey, ParamEnv, TyTerm},
+    unify::candidate::{CandidateFactoryModel, CandidateTransaction, ConstraintAttempt},
+};
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::memo::Database,
+};
+use std::collections::{BTreeMap, BTreeSet, VecDeque};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum TableState {
+    New,
+    Evaluating,
+    Suspended,
+    Complete,
+}
+/// Declared MODEL classification only. The approved structural source-rule
+/// producer is required before any production table may use coinduction.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CycleKindModel {
+    Ordinary,
+    Projection,
+    StructuralAuto,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum EdgeKindModel {
+    Ordinary,
+    Projection,
+    StructuralAuto,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct PredicateChildModel {
+    pub ordinal: usize,
+    pub goal: Digest,
+    pub edge: EdgeKindModel,
+}
+pub struct CandidatePairModel {
+    pub template: TyTerm,
+    pub demand: TyTerm,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct TableLimits {
+    pub tables: usize,
+    pub strands: usize,
+    pub work: usize,
+    pub depth: usize,
+    pub canonical_bytes: usize,
+    pub metadata_bytes: usize,
+}
+impl Default for TableLimits {
+    fn default() -> Self {
+        Self {
+            tables: 50_000,
+            strands: 200_000,
+            work: 1_000_000,
+            depth: 256,
+            canonical_bytes: 1024 * 1024,
+            metadata_bytes: 32 * 1024 * 1024,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum TableLimit {
+    Tables,
+    Strands,
+    Work,
+    Depth,
+    CanonicalBytes,
+    MetadataBytes,
+}
+#[derive(Clone, Copy, Debug, Default)]
+pub struct TableCounters {
+    pub tables: usize,
+    pub strands: usize,
+    pub work: usize,
+    pub canonical_bytes: usize,
+    pub metadata_bytes: usize,
+    pub visited: usize,
+}
+#[derive(Debug)]
+pub enum TableError {
+    Overflow(TableLimit, TableCounters),
+    Cancelled(TableCounters),
+    Stale,
+    Invalid(&'static str),
+    Canonical(CanonicalError),
+    Source(Diagnostic),
+}
+impl std::fmt::Display for TableError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Overflow(l, c) => write!(f, "trait table overflow {l:?}: {c:?}"),
+            Self::Cancelled(c) => write!(f, "trait table cancelled: {c:?}"),
+            Self::Stale => f.write_str("trait table model context changed"),
+            Self::Invalid(s) => f.write_str(s),
+            Self::Canonical(e) => write!(f, "{e}"),
+            Self::Source(e) => f.write_str(&e.message),
+        }
+    }
+}
+impl std::error::Error for TableError {}
+/// Canonical answer/path DATA, never WitnessKey or permission. Child keys retain
+/// dependency paths; distinct source impl identities cannot collapse.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct AnswerModel {
+    pub header: Digest,
+    pub children: Vec<Digest>,
+    pub provisional_auto: bool,
+}
+impl StableEncode for AnswerModel {
+    const DOMAIN: &'static str = "lrr/v5/conditional-table-answer-model/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.header);
+        e.sequence(&self.children, |e, k| e.digest(*k));
+        e.bool(self.provisional_auto);
+    }
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum TableOutcomeModel {
+    Unique(AnswerModel),
+    Ambiguous(Vec<Digest>),
+    Unresolved(Vec<Digest>),
+    NoSolution,
+}
+impl StableEncode for TableOutcomeModel {
+    const DOMAIN: &'static str = "lrr/v5/conditional-table-outcome-model/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        match self {
+            Self::Unique(answer) => {
+                e.u8(0);
+                e.record(answer);
+            }
+            Self::Ambiguous(ids) => {
+                e.u8(1);
+                e.sequence(ids, |e, id| e.digest(*id));
+            }
+            Self::Unresolved(ids) => {
+                e.u8(2);
+                e.sequence(ids, |e, id| e.digest(*id));
+            }
+            Self::NoSolution => e.u8(3),
+        }
+    }
+}
+#[derive(Clone, Copy, Debug)]
+pub struct TableTransitionModel {
+    pub goal: Digest,
+    pub from: TableState,
+    pub to: TableState,
+}
+pub struct TableResultModel {
+    pub outcome: TableOutcomeModel,
+    pub counters: TableCounters,
+    pub transitions: Vec<TableTransitionModel>,
+}
+enum LocalMatch {
+    Matched,
+    Unresolved,
+    Conflict,
+}
+struct Strand {
+    header: Digest,
+    children: Vec<PredicateChildModel>,
+    matching: LocalMatch,
+    // Retain only this candidate's private staged substitution/pending headers.
+    // It is never published into a sibling or the caller's source environment.
+    _transaction: CandidateTransaction,
+}
+struct GoalTable {
+    _canonical: CanonicalGoalModel,
+    kind: CycleKindModel,
+    residual_inference: bool,
+    negative: bool,
+    strands: Vec<Strand>,
+    state: TableState,
+    outcome: Option<TableOutcomeModel>,
+}
+pub struct GoalTablesModel {
+    context: Digest,
+    limits: TableLimits,
+    canonical_limits: CanonicalLimits,
+    tables: BTreeMap<Digest, GoalTable>,
+    factory: CandidateFactoryModel,
+    counters: TableCounters,
+}
+fn context_identity(c: &CanonicalContextModel) -> Result<Digest, TableError> {
+    c.profile.validate_source().map_err(TableError::Source)?;
+    if c.epoch == 0 || c.excluded_dictionary_slots.len() > 50_000 {
+        return Err(TableError::Invalid("invalid table context"));
+    }
+    let mut e = StableEncoder::new("lrr/v5/conditional-table-context-model/v1");
+    e.u16(c.profile.edition);
+    e.string(&c.profile.semantics);
+    for d in [c.unit, c.world, c.catalog, c.cfg, c.source_namespace] {
+        e.digest(d);
+    }
+    e.u64(c.epoch);
+    e.u64(c.source_revision);
+    e.u64(c.query_revision);
+    e.u32(c.max_universe);
+    // Caller transaction nonce is deliberately absent, just as in canonical
+    // goal identity. Exclusions remain exact and ordered by their producer.
+    e.sequence(&c.excluded_dictionary_slots, |e, d| e.digest(*d));
+    Ok(e.finish())
+}
+impl GoalTablesModel {
+    pub fn new(
+        c: &CanonicalContextModel,
+        limits: TableLimits,
+        canonical_limits: CanonicalLimits,
+    ) -> Result<Self, TableError> {
+        let hard = TableLimits::default();
+        if limits.tables > hard.tables
+            || limits.strands > hard.strands
+            || limits.work > hard.work
+            || limits.depth > hard.depth
+            || limits.canonical_bytes > hard.canonical_bytes
+            || limits.metadata_bytes > hard.metadata_bytes
+        {
+            return Err(TableError::Invalid("table limits exceed fixed ceilings"));
+        }
+        let context = context_identity(c)?;
+        let canonical_limits = canonical_limits.validate().map_err(TableError::Canonical)?;
+        Ok(Self {
+            context,
+            limits,
+            canonical_limits,
+            tables: BTreeMap::new(),
+            factory: CandidateFactoryModel::new(context, canonical_limits)
+                .map_err(TableError::Canonical)?,
+            counters: TableCounters::default(),
+        })
+    }
+    fn check_current(&self, c: &CanonicalContextModel) -> Result<(), TableError> {
+        if context_identity(c)? != self.context {
+            Err(TableError::Stale)
+        } else {
+            Ok(())
+        }
+    }
+    fn reserve(
+        &self,
+        canonical: usize,
+        metadata: usize,
+        tables: usize,
+        strands: usize,
+    ) -> Result<TableCounters, TableError> {
+        let mut next = self.counters;
+        for (slot, amount, max, name) in [
+            (
+                &mut next.canonical_bytes,
+                canonical,
+                self.limits.canonical_bytes,
+                TableLimit::CanonicalBytes,
+            ),
+            (
+                &mut next.metadata_bytes,
+                metadata,
+                self.limits.metadata_bytes,
+                TableLimit::MetadataBytes,
+            ),
+            (
+                &mut next.tables,
+                tables,
+                self.limits.tables,
+                TableLimit::Tables,
+            ),
+            (
+                &mut next.strands,
+                strands,
+                self.limits.strands,
+                TableLimit::Strands,
+            ),
+        ] {
+            *slot = slot
+                .checked_add(amount)
+                .filter(|n| *n <= max)
+                .ok_or(TableError::Overflow(name, self.counters))?;
+        }
+        Ok(next)
+    }
+    pub fn intern(
+        &mut self,
+        c: &CanonicalContextModel,
+        goal: &Binder<GoalModel>,
+        env: &ParamEnv,
+        universes: &BTreeMap<InferVarKey, u32>,
+        kind: CycleKindModel,
+        residual_inference: bool,
+    ) -> Result<Digest, TableError> {
+        self.check_current(c)?;
+        // Closed versus residual-inference status is derived, not a caller's
+        // false flag hiding canonical inference variables.
+        let canonical = CanonicalGoalModel::capture(c, goal, env, universes, self.canonical_limits)
+            .map_err(TableError::Canonical)?;
+        let residual_inference = residual_inference || !canonical.variables().is_empty();
+        let key = canonical.fingerprint();
+        let work = self
+            .counters
+            .work
+            .checked_add(canonical.encoded().len())
+            .filter(|n| *n <= self.limits.work)
+            .ok_or(TableError::Overflow(TableLimit::Work, self.counters))?;
+        if let Some(old) = self.tables.get(&key) {
+            if old.kind != kind || old.residual_inference != residual_inference {
+                return Err(TableError::Invalid(
+                    "conflicting canonical table model classification",
+                ));
+            }
+            self.counters.work = work;
+            return Ok(key);
+        }
+        let mut counters = self.reserve(
+            canonical.metadata_bytes(),
+            std::mem::size_of::<GoalTable>() + 128,
+            1,
+            0,
+        )?;
+        counters.work = work;
+        self.tables.insert(
+            key,
+            GoalTable {
+                _canonical: canonical,
+                kind,
+                residual_inference,
+                negative: false,
+                strands: vec![],
+                state: TableState::New,
+                outcome: None,
+            },
+        );
+        self.counters = counters;
+        Ok(key)
+    }
+    pub fn state(&self, key: Digest) -> Option<TableState> {
+        self.tables.get(&key).map(|t| t.state)
+    }
+    pub fn outcome(&self, key: Digest) -> Option<&TableOutcomeModel> {
+        self.tables.get(&key).and_then(|t| t.outcome.as_ref())
+    }
+    pub fn counters(&self) -> TableCounters {
+        self.counters
+    }
+    pub fn add_candidate_model(
+        &mut self,
+        c: &CanonicalContextModel,
+        key: Digest,
+        header: &SourceTraitHeader,
+        pairs: &[CandidatePairModel],
+        children: Vec<PredicateChildModel>,
+    ) -> Result<(), TableError> {
+        self.check_current(c)?;
+        let table = self
+            .tables
+            .get(&key)
+            .ok_or(TableError::Invalid("unknown parent goal"))?;
+        if table.state != TableState::New {
+            return Err(TableError::Invalid("table candidates already evaluated"));
+        }
+        if !matches!(
+            header.kind(),
+            HeaderKind::Impl {
+                trait_type: Some(_),
+                negative: false,
+                default_impl: false,
+                ..
+            }
+        ) {
+            return Err(TableError::Invalid(
+                "ordinary positive source impl required",
+            ));
+        }
+        let id = header.exact_identity();
+        if table.strands.iter().any(|s| s.header == id) {
+            return Err(TableError::Invalid("duplicate source impl strand"));
+        }
+        // Each source predicate must have its own exact indexed child. Model
+        // callers cannot silently omit a pending condition or duplicate a slot.
+        if children.len() != header.predicates().len()
+            || children
+                .iter()
+                .enumerate()
+                .any(|(i, x)| x.ordinal != i || !self.tables.contains_key(&x.goal))
+        {
+            return Err(TableError::Invalid(
+                "pending source predicate child mapping incomplete",
+            ));
+        }
+        if pairs.len() > self.limits.strands {
+            return Err(TableError::Overflow(TableLimit::Strands, self.counters));
+        }
+        let mut pair_bytes = 0usize;
+        let mut pair_work = 0usize;
+        for p in pairs {
+            for t in [&p.template, &p.demand] {
+                let (nodes, bytes) = t.measure().ok_or(TableError::Overflow(
+                    TableLimit::MetadataBytes,
+                    self.counters,
+                ))?;
+                pair_bytes = pair_bytes
+                    .checked_add(bytes)
+                    .and_then(|n| n.checked_add(std::mem::size_of::<TyTerm>()))
+                    .filter(|n| *n <= self.limits.metadata_bytes / 4)
+                    .ok_or(TableError::Overflow(
+                        TableLimit::MetadataBytes,
+                        self.counters,
+                    ))?;
+                pair_work = pair_work
+                    .checked_add(nodes)
+                    .filter(|n| *n <= self.limits.work)
+                    .ok_or(TableError::Overflow(TableLimit::Work, self.counters))?;
+            }
+        }
+        let header_bytes = header
+            .candidate_snapshot_bytes()
+            .map_err(TableError::Source)?;
+        let bytes =
+            header_bytes
+                .checked_add(header.generics().len().checked_mul(512).ok_or(
+                    TableError::Overflow(TableLimit::MetadataBytes, self.counters),
+                )?)
+                .and_then(|n| {
+                    n.checked_add(
+                        children
+                            .capacity()
+                            .checked_mul(std::mem::size_of::<PredicateChildModel>())?,
+                    )
+                })
+                .and_then(|n| n.checked_add(std::mem::size_of::<Strand>() + 256))
+                .ok_or(TableError::Overflow(
+                    TableLimit::MetadataBytes,
+                    self.counters,
+                ))?;
+        let mut counters = self.reserve(0, bytes, 0, 1)?;
+        pair_work = pair_work
+            .checked_add(header_bytes)
+            .ok_or(TableError::Overflow(TableLimit::Work, self.counters))?;
+        counters.work = counters
+            .work
+            .checked_add(pair_work)
+            .filter(|n| *n <= self.limits.work)
+            .ok_or(TableError::Overflow(TableLimit::Work, self.counters))?;
+        if counters
+            .metadata_bytes
+            .checked_add(pair_bytes.checked_mul(4).ok_or(TableError::Overflow(
+                TableLimit::MetadataBytes,
+                self.counters,
+            ))?)
+            .filter(|n| *n <= self.limits.metadata_bytes)
+            .is_none()
+        {
+            return Err(TableError::Overflow(
+                TableLimit::MetadataBytes,
+                self.counters,
+            ));
+        }
+        let mut transaction = self.factory.start(header).map_err(TableError::Canonical)?;
+        let mut instantiated = Vec::new();
+        instantiated
+            .try_reserve_exact(pairs.len())
+            .map_err(|_| TableError::Overflow(TableLimit::MetadataBytes, self.counters))?;
+        for p in pairs {
+            instantiated.push((
+                transaction
+                    .instantiate_type_model(&p.template)
+                    .map_err(TableError::Source)?,
+                p.demand.clone(),
+            ));
+        }
+        let remaining = self
+            .limits
+            .work
+            .checked_sub(counters.work)
+            .ok_or(TableError::Overflow(TableLimit::Work, self.counters))?;
+        let (attempt, used) = transaction
+            .attempt_constraints_counted(&instantiated, remaining.min(self.canonical_limits.work));
+        counters.work = counters
+            .work
+            .checked_add(used)
+            .filter(|n| *n <= self.limits.work)
+            .ok_or(TableError::Overflow(TableLimit::Work, self.counters))?;
+        let matching = match attempt {
+            ConstraintAttempt::MatchedPending => LocalMatch::Matched,
+            ConstraintAttempt::Conflict(_) => LocalMatch::Conflict,
+            ConstraintAttempt::Unresolved(_) => LocalMatch::Unresolved,
+            ConstraintAttempt::Overflow(e) => return Err(TableError::Canonical(e)),
+            ConstraintAttempt::Invalid(e) => return Err(TableError::Source(e)),
+        };
+        let table = self.tables.get_mut(&key).expect("checked parent");
+        table
+            .strands
+            .try_reserve_exact(1)
+            .map_err(|_| TableError::Overflow(TableLimit::MetadataBytes, self.counters))?;
+        table.strands.push(Strand {
+            header: id,
+            children,
+            matching,
+            _transaction: transaction,
+        });
+        self.counters = counters;
+        Ok(())
+    }
+    /// An actual captured negative header can block the MODEL auto shortcut.
+    /// Its source goal relation remains unadmitted, including nightly syntax.
+    pub fn record_negative_header_model(
+        &mut self,
+        c: &CanonicalContextModel,
+        key: Digest,
+        header: &SourceTraitHeader,
+    ) -> Result<(), TableError> {
+        self.check_current(c)?;
+        if !matches!(header.kind(), HeaderKind::Impl { negative: true, .. }) {
+            return Err(TableError::Invalid("negative header fact required"));
+        }
+        let t = self
+            .tables
+            .get_mut(&key)
+            .ok_or(TableError::Invalid("unknown negative goal"))?;
+        if t.state != TableState::New {
+            return Err(TableError::Invalid("negative facts already evaluated"));
+        }
+        t.negative = true;
+        Ok(())
+    }
+    /// Invocation-local worklists and results commit together. Cancellation or
+    /// overflow leaves every previous table state/outcome unchanged.
+    pub fn evaluate_model(
+        &mut self,
+        c: &CanonicalContextModel,
+        root: Digest,
+        mut cancelled: impl FnMut() -> bool,
+    ) -> Result<TableResultModel, TableError> {
+        self.check_current(c)?;
+        if !self.tables.contains_key(&root) {
+            return Err(TableError::Invalid("unknown demand root"));
+        }
+        let mut work = Work {
+            counters: self.counters,
+            limits: self.limits,
+            cancelled: &mut cancelled,
+        };
+        work.poll()?;
+        // Conservative scratch preflight covers graph/reverse edges, SCC sets,
+        // simultaneous fixpoint snapshots, and result/path publication clones.
+        let scratch = self
+            .counters
+            .metadata_bytes
+            .checked_mul(8)
+            .filter(|n| *n <= self.limits.metadata_bytes)
+            .ok_or(TableError::Overflow(
+                TableLimit::MetadataBytes,
+                self.counters,
+            ))?;
+        let _scratch_reservation = scratch;
+        let graph = self.reached_graph(root, &mut work)?;
+        let mut transitions = Vec::new();
+        transitions
+            .try_reserve_exact(graph.len().checked_mul(2).ok_or(TableError::Overflow(
+                TableLimit::MetadataBytes,
+                work.counters,
+            ))?)
+            .map_err(|_| TableError::Overflow(TableLimit::MetadataBytes, work.counters))?;
+        for key in graph.keys() {
+            work.step()?;
+            transitions.push(TableTransitionModel {
+                goal: *key,
+                from: self.tables[key].state,
+                to: TableState::Evaluating,
+            });
+        }
+        let components = components(root, &graph, &mut work)?;
+        let mut outcomes = BTreeMap::new();
+        for component in components {
+            self.evaluate_component(&component, &graph, &mut outcomes, &mut work)?;
+        }
+        // Reserve bounded answer/path snapshots before publishing any state.
+        let mut answer_bytes = 0usize;
+        for value in outcomes.values() {
+            work.step()?;
+            let n = match value {
+                TableOutcomeModel::Unique(a) => a
+                    .children
+                    .len()
+                    .checked_mul(32)
+                    .and_then(|n| n.checked_add(128)),
+                TableOutcomeModel::Ambiguous(v) | TableOutcomeModel::Unresolved(v) => {
+                    v.len().checked_mul(32).and_then(|n| n.checked_add(64))
+                }
+                TableOutcomeModel::NoSolution => Some(64),
+            }
+            .ok_or(TableError::Overflow(
+                TableLimit::MetadataBytes,
+                work.counters,
+            ))?;
+            answer_bytes = answer_bytes
+                .checked_add(n)
+                .filter(|n| *n <= self.limits.metadata_bytes)
+                .ok_or(TableError::Overflow(
+                    TableLimit::MetadataBytes,
+                    work.counters,
+                ))?;
+        }
+        if self
+            .counters
+            .metadata_bytes
+            .checked_add(answer_bytes)
+            .filter(|n| *n <= self.limits.metadata_bytes)
+            .is_none()
+        {
+            return Err(TableError::Overflow(
+                TableLimit::MetadataBytes,
+                work.counters,
+            ));
+        }
+        let result = outcomes.get(&root).expect("reached root").clone();
+        work.poll()?;
+        work.counters.visited = graph.len();
+        for (key, value) in outcomes {
+            let t = self.tables.get_mut(&key).expect("reached table");
+            t.state = if matches!(value, TableOutcomeModel::Unresolved(_)) {
+                TableState::Suspended
+            } else {
+                TableState::Complete
+            };
+            transitions.push(TableTransitionModel {
+                goal: key,
+                from: TableState::Evaluating,
+                to: t.state,
+            });
+            t.outcome = Some(value);
+        }
+        self.counters.work = work.counters.work;
+        self.counters.visited = work.counters.visited;
+        Ok(TableResultModel {
+            outcome: result,
+            counters: work.counters,
+            transitions,
+        })
+    }
+    fn reached_graph(
+        &self,
+        root: Digest,
+        work: &mut Work<'_>,
+    ) -> Result<BTreeMap<Digest, Vec<Digest>>, TableError> {
+        let mut graph = BTreeMap::new();
+        let mut pending = VecDeque::from([root]);
+        let mut seen = BTreeSet::from([root]);
+        while let Some(key) = pending.pop_front() {
+            work.step()?;
+            let t = &self.tables[&key];
+            let mut children = BTreeSet::new();
+            for s in &t.strands {
+                work.step()?;
+                if matches!(s.matching, LocalMatch::Conflict) {
+                    continue;
+                }
+                for child in &s.children {
+                    work.step()?;
+                    children.insert(child.goal);
+                    if seen.insert(child.goal) {
+                        pending.push_back(child.goal);
+                    }
+                }
+            }
+            graph.insert(key, children.into_iter().collect());
+        }
+        Ok(graph)
+    }
+    fn evaluate_component(
+        &self,
+        keys: &[Digest],
+        graph: &BTreeMap<Digest, Vec<Digest>>,
+        outcomes: &mut BTreeMap<Digest, TableOutcomeModel>,
+        work: &mut Work<'_>,
+    ) -> Result<(), TableError> {
+        let members = keys.iter().copied().collect::<BTreeSet<_>>();
+        let cyclic = keys.len() > 1 || graph[&keys[0]].contains(&keys[0]);
+        let mut approved = cyclic;
+        for key in keys {
+            work.step()?;
+            let t = &self.tables[key];
+            approved &=
+                t.kind == CycleKindModel::StructuralAuto && !t.negative && !t.residual_inference;
+        }
+        for key in keys {
+            for s in &self.tables[key].strands {
+                work.step()?;
+                if matches!(s.matching, LocalMatch::Conflict) {
+                    continue;
+                }
+                for edge in &s.children {
+                    work.step()?;
+                    if edge.edge != EdgeKindModel::StructuralAuto
+                        || self.tables[&edge.goal].kind != CycleKindModel::StructuralAuto
+                    {
+                        approved = false;
+                    }
+                }
+            }
+        }
+        // Least fixpoint for ordinary goals, greatest provisional fixpoint only
+        // for the declared approved-auto MODEL. No stack backedge is an answer.
+        let mut grounded = if approved {
+            members.clone()
+        } else {
+            BTreeSet::new()
+        };
+        loop {
+            let mut next = grounded.clone();
+            for key in keys {
+                work.step()?;
+                let mut viable = false;
+                for s in &self.tables[key].strands {
+                    work.step()?;
+                    if !matches!(s.matching, LocalMatch::Matched) {
+                        continue;
+                    }
+                    let mut success = true;
+                    for e in &s.children {
+                        work.step()?;
+                        success &= if members.contains(&e.goal) {
+                            grounded.contains(&e.goal)
+                        } else {
+                            matches!(outcomes.get(&e.goal), Some(TableOutcomeModel::Unique(_)))
+                        };
+                    }
+                    viable |= success;
+                }
+                if approved {
+                    if !viable {
+                        next.remove(key);
+                    }
+                } else if viable {
+                    next.insert(*key);
+                }
+            }
+            if next == grounded {
+                break;
+            }
+            grounded = next;
+        }
+        // Propagate unresolved premises through a cyclic strand before
+        // concluding inductive absence. A relevant residual candidate cannot
+        // disappear merely because its canonical child is on this SCC.
+        let mut unresolved = BTreeSet::new();
+        for key in keys {
+            if cyclic && self.tables[key].residual_inference {
+                unresolved.insert(*key);
+            }
+        }
+        loop {
+            let mut next = unresolved.clone();
+            for key in keys {
+                for s in &self.tables[key].strands {
+                    work.step()?;
+                    if matches!(s.matching, LocalMatch::Conflict) {
+                        continue;
+                    }
+                    let mut hard_false = false;
+                    let mut pending = matches!(s.matching, LocalMatch::Unresolved);
+                    for edge in &s.children {
+                        work.step()?;
+                        if members.contains(&edge.goal) {
+                            pending |= unresolved.contains(&edge.goal);
+                        } else {
+                            match outcomes.get(&edge.goal).expect("child SCC finalized") {
+                                TableOutcomeModel::NoSolution => hard_false = true,
+                                TableOutcomeModel::Ambiguous(_)
+                                | TableOutcomeModel::Unresolved(_) => pending = true,
+                                TableOutcomeModel::Unique(_) => {}
+                            }
+                        }
+                    }
+                    if pending && !hard_false {
+                        next.insert(*key);
+                    }
+                }
+            }
+            if next == unresolved {
+                break;
+            }
+            unresolved = next;
+        }
+        let mut applicable: BTreeMap<Digest, Vec<&Strand>> = BTreeMap::new();
+        for key in keys {
+            let mut accepted = Vec::new();
+            for s in &self.tables[key].strands {
+                work.step()?;
+                if !matches!(s.matching, LocalMatch::Matched) {
+                    continue;
+                }
+                let mut success = true;
+                for edge in &s.children {
+                    work.step()?;
+                    success &= if members.contains(&edge.goal) {
+                        grounded.contains(&edge.goal)
+                    } else {
+                        matches!(outcomes.get(&edge.goal), Some(TableOutcomeModel::Unique(_)))
+                    };
+                }
+                if success {
+                    accepted.push(s);
+                }
+            }
+            accepted.sort_by_key(|s| s.header);
+            applicable.insert(*key, accepted);
+        }
+        let mut uncertain = unresolved.clone();
+        for key in keys {
+            if applicable[key].len() > 1 {
+                uncertain.insert(*key);
+            }
+        }
+        loop {
+            let mut next = uncertain.clone();
+            for key in keys {
+                for s in &applicable[key] {
+                    work.step()?;
+                    for edge in &s.children {
+                        work.step()?;
+                        if uncertain.contains(&edge.goal) {
+                            next.insert(*key);
+                        }
+                    }
+                }
+            }
+            if next == uncertain {
+                break;
+            }
+            uncertain = next;
+        }
+        for key in keys {
+            work.step()?;
+            let accepted = &applicable[key];
+            let value = if uncertain.contains(key) {
+                let ids = self.tables[key]
+                    .strands
+                    .iter()
+                    .filter(|s| !matches!(s.matching, LocalMatch::Conflict))
+                    .map(|s| s.header)
+                    .collect::<BTreeSet<_>>()
+                    .into_iter()
+                    .collect::<Vec<_>>();
+                if accepted.is_empty() {
+                    TableOutcomeModel::Unresolved(ids)
+                } else {
+                    TableOutcomeModel::Ambiguous(ids)
+                }
+            } else if let Some(s) = accepted.first() {
+                TableOutcomeModel::Unique(AnswerModel {
+                    header: s.header,
+                    children: s.children.iter().map(|e| e.goal).collect(),
+                    provisional_auto: approved,
+                })
+            } else {
+                TableOutcomeModel::NoSolution
+            };
+            outcomes.insert(*key, value);
+        }
+        Ok(())
+    }
+}
+struct Work<'a> {
+    counters: TableCounters,
+    limits: TableLimits,
+    cancelled: &'a mut dyn FnMut() -> bool,
+}
+impl Work<'_> {
+    fn poll(&mut self) -> Result<(), TableError> {
+        if (self.cancelled)() {
+            Err(TableError::Cancelled(self.counters))
+        } else {
+            Ok(())
+        }
+    }
+    fn step(&mut self) -> Result<(), TableError> {
+        self.counters.work = self
+            .counters
+            .work
+            .checked_add(1)
+            .filter(|n| *n <= self.limits.work)
+            .ok_or(TableError::Overflow(TableLimit::Work, self.counters))?;
+        if self.counters.work % 256 == 0 {
+            self.poll()?;
+        }
+        Ok(())
+    }
+}
+/// Iterative deterministic Kosaraju; reversed dependency order means children
+/// are finalized before callers. Stack depth is explicitly bounded even on a
+/// long acyclic goal chain; no recursive host call is used.
+fn components(
+    root: Digest,
+    graph: &BTreeMap<Digest, Vec<Digest>>,
+    work: &mut Work<'_>,
+) -> Result<Vec<Vec<Digest>>, TableError> {
+    let mut seen = BTreeSet::new();
+    let mut order = Vec::new();
+    // Every graph node is reachable from this actual demand root. Start there,
+    // rather than digest order accidentally shortening the active DFS path.
+    for root in std::iter::once(&root) {
+        if !seen.insert(*root) {
+            continue;
+        }
+        if work.limits.depth == 0 {
+            return Err(TableError::Overflow(TableLimit::Depth, work.counters));
+        }
+        let mut stack = vec![(*root, 0usize)];
+        while let Some((key, at)) = stack.last_mut() {
+            work.step()?;
+            if let Some(child) = graph[key].get(*at) {
+                *at += 1;
+                if seen.insert(*child) {
+                    if stack.len() >= work.limits.depth {
+                        return Err(TableError::Overflow(TableLimit::Depth, work.counters));
+                    }
+                    stack.push((*child, 0));
+                }
+            } else {
+                let (key, _) = stack.pop().expect("nonempty DFS");
+                order.push(key);
+            }
+        }
+    }
+    let mut reverse: BTreeMap<Digest, Vec<Digest>> = BTreeMap::new();
+    for key in graph.keys() {
+        work.step()?;
+        reverse.insert(*key, vec![]);
+    }
+    for (key, edges) in graph {
+        for child in edges {
+            work.step()?;
+            reverse.get_mut(child).expect("reached child").push(*key);
+        }
+    }
+    seen.clear();
+    let mut result = Vec::new();
+    for root in order.into_iter().rev() {
+        if !seen.insert(root) {
+            continue;
+        }
+        let mut component = vec![];
+        let mut pending = vec![root];
+        while let Some(key) = pending.pop() {
+            work.step()?;
+            component.push(key);
+            for parent in &reverse[&key] {
+                work.step()?;
+                if seen.insert(*parent) {
+                    pending.push(*parent);
+                }
+            }
+        }
+        component.sort_unstable();
+        result.push(component);
+    }
+    result.reverse();
+    Ok(result)
+}
+/// Genuine current source-header agreement only. It intentionally cannot mint
+/// a completed table/trait witness while M018/M019/normalization remain missing.
