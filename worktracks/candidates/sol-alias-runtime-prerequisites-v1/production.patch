+//! Original-module generated alias replay. Names alone never establish item hygiene.
+use super::*;
+use crate::{expand::generated_syntax::GeneratedSyntaxInput, syntax::token_wire::NameContextKey};
+fn owner<'a>(
+    unit: &GeneratedSyntaxInput,
+    owners: &[&'a SourceDeclarative],
+) -> Result<Option<&'a SourceDeclarative>, Diagnostic> {
+    let mut found: Option<&SourceDeclarative> = None;
+    for candidate in owners {
+        let source = candidate.module_source();
+        let matches = source
+            .outline()
+            .item_invocations
+            .iter()
+            .filter(|c| {
+                c.item_input == unit.items.record().key().invocation
+                    && c.attribute_input.is_none()
+                    && c.scope == unit.scope
+            })
+            .count();
+        if matches == 0 {
+            continue;
+        };
+        if matches != 1
+            || unit.scope.owner.is_some()
+            || unit.scope.crate_key != source.selection().outline.crate_key
+        {
+            return Err(fault("generated alias original caller is ambiguous"));
+        };
+        if let Some(old) = found {
+            if !old.module_source().same_publication(source) {
+                return Err(fault("generated alias actual original owners differ"));
+            }
+        } else {
+            found = Some(*candidate)
+        };
+    }
+    Ok(found)
+}
+/// Exact original invocation-owner data, not a type/visibility/completeness certificate.
+pub(super) fn original_owner_data(
+    db: &Database,
+    identity: Digest,
+    sources: &[&crate::source::changes::PreparedSourceView],
+    max: usize,
+) -> Result<Option<(usize, ScopeKey, String)>, Diagnostic> {
+    db.require_coordinator()?;
+    if sources.len() > 100_000 || max > MAX_BYTES {
+        return Err(limit());
+    };
+    let Some((InputValue::DefinitionSource(parse), _)) =
+        db.published_input(&InputKey::DefinitionSource(identity))
+    else {
+        return Ok(None);
+    };
+    let Some((InputValue::GeneratedSyntax(unit), _)) =
+        db.published_input(&InputKey::GeneratedSyntax(parse.content))
+    else {
+        return Ok(None);
+    };
+    if unit.key != *parse {
+        return Err(fault("generated alias selected parse differs"));
+    };
+    let Some(definition) = unit.definitions.get(&identity) else {
+        return Ok(None);
+    };
+    if definition.item_kind != ItemKind::TypeAlias {
+        return Ok(None);
+    };
+    let bytes = unit
+        .scope
+        .heap_bytes()
+        .checked_add(definition.declared_name.capacity())
+        .and_then(|n| n.checked_add(128))
+        .filter(|n| *n <= max)
+        .ok_or_else(limit)?;
+    let _ = bytes;
+    let mut found = None;
+    for (i, s) in sources.iter().enumerate() {
+        if s.outline().item_invocations.iter().any(|c| {
+            c.item_input == unit.items.record().key().invocation
+                && c.attribute_input.is_none()
+                && c.scope == unit.scope
+        }) {
+            if found.is_some() {
+                return Err(fault("generated alias original source catalogue ambiguous"));
+            };
+            found = Some(i);
+        }
+    }
+    Ok(found.map(|i| (i, unit.scope.clone(), definition.declared_name.clone())))
+}
+fn same_class(
+    db: &Database,
+    next: &NameDefinition,
+    comparison: NameContextKey,
+    owners: &[&SourceDeclarative],
+) -> Result<bool, Diagnostic> {
+    if let Some(source) = provider_for(db, next.identity, owners)? {
+        let (k, f) = source.macro_index().original_root_hygiene()?;
+        return Ok(f.name_item(k)? == comparison);
+    };
+    let Some((InputValue::DefinitionSource(parse), _)) =
+        db.published_input(&InputKey::DefinitionSource(next.identity))
+    else {
+        return Ok(false);
+    };
+    let Some((InputValue::GeneratedSyntax(unit), _)) =
+        db.published_input(&InputKey::GeneratedSyntax(parse.content))
+    else {
+        return Ok(false);
+    };
+    if unit.key != *parse {
+        return Err(fault("generated alias next parse differs"));
+    };
+    let Some(header) = unit
+        .items
+        .items()
+        .iter()
+        .find(|h| h.key.fingerprint() == next.identity)
+    else {
+        return Ok(false);
+    };
+    let Some(name) = &header.name else {
+        return Ok(false);
+    };
+    let Some(span) = unit
+        .items
+        .tokens()
+        .spans()
+        .iter()
+        .find(|s| s.key() == name.span)
+    else {
+        return Err(fault("generated alias next marked name missing"));
+    };
+    Ok(unit.items.item_class(span.context)? == comparison)
+}
