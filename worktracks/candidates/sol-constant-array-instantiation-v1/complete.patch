+fn constant_cancellation_and_resource_preflight_create_no_guest_values() {
+    let mut s = GuestStore::new(1, 2, 32 << 20).unwrap();
+    let w = array(PrimitiveType::Unit, 3);
+    let v = decoded(&w, &[ValueRepr::unit(); 3]);
+    let ty = s
