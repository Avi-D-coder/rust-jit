+    fn nested_fixture() -> (ConstValue, ConstantWireType) {
+        let wire = ConstantWireType::Array {
+            element: Box::new(ConstantWireType::Array {
+                element: Box::new(ConstantWireType::Scalar(PrimitiveType::Unit)),
+                length: 2,
+            }),
+            length: 2,
