+#[test]
+fn actual_empty_prelude_planner_alias_named_return_keeps_caller_rigid_source_all_editions() {
+    let text = "#![no_implicit_prelude] fn chosen<T>(x:T){let alias=x;let out=id(alias);}fn id<U>(value:U)->U{value}fn main(){}";
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, view, published, names, parsed, index, owner) = world(text, "chosen", edition);
+        let entered = published
+            .enter_body(view.selection(), &owner.body().key())
+            .unwrap();
+        let patterns =
+            CurrentPatternNames::prepare(&db, &view, &owner, &entered, &names, SOURCE_VIEW_BUDGET)
+                .unwrap();
+        let locals = entered
+            .local_index(
+                view.selection(),
+                &owner.body().key(),
+                patterns.resolutions(),
+                &[],
+            )
+            .unwrap();
+        let env = runtime_environment(&owner);
+        let alias = parsed
+            .source_view_alias_plan(
+                &owner,
+                &index,
+                &site(
+                    text,
+                    &owner,
+                    &index,
+                    "let alias=x;",
+                    crate::ir::pc::Phase::Commit,
+                ),
+            )
+            .unwrap();
+        let seed = declared_binding_view(
+            &db,
+            &parsed,
+            &index,
+            &view,
+            &names,
+            &locals,
+            owner.clone(),
+            &alias.source,
+            Some(&env),
+            TypeId(6),
+            SOURCE_VIEW_BUDGET,
+        )
+        .unwrap();
+        let argument = local_alias_view(
+            &db,
+            &view,
+            &names,
+            &locals,
+            owner.clone(),
+            &alias,
+            &seed,
+            SOURCE_VIEW_BUDGET,
+        )
+        .unwrap();
+        let call = parsed
+            .source_view_named_call_plan(
+                &owner,
+                &index,
+                &site(
+                    text,
+                    &owner,
+                    &index,
+                    "id(alias)",
+                    crate::ir::pc::Phase::Entry,
+                ),
+            )
+            .unwrap();
+        let QueryPoll::Ready(Ok(result)) = named_function_return_view(
+            &mut db,
+            &view,
+            &[&view],
+            &names,
+            &locals,
+            owner,
+            &call,
+            &[&argument],
+            TypeId(6),
+            SOURCE_VIEW_BUDGET,
+        ) else {
+            panic!()
+        };
+        let before = db.trace.events.len();
+        let certificate = result
+            .admit_current(&db, &view, Some(&env), SOURCE_VIEW_BUDGET)
+            .unwrap();
+        assert_eq!(certificate.source().term(), seed.source.term());
+        assert!(matches!(certificate.source().term(), TyTerm::Param(_)));
+        assert_ne!(
+            certificate.source().term(),
+            &TyTerm::Primitive(crate::ir::op::PrimitiveType::I32)
