+//! Exact pinned outward export spellings, and captured automatic-prelude policy.
+//! A catalog is source data, never authority for an installed library generation.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{InputKey, InputValue},
+        memo::Database,
+    },
+    source::changes::PreparedSourceView,
+    syntax::{
+        imports::{ImportBudget, ImportKind, ImportSegment},
+        outline::{ScopeKey, Visibility},
+    },
+};
+use ra_ap_syntax::{
+    AstNode, Edition,
+    ast::{self, HasAttrs, HasModuleItem, HasName, HasVisibility},
+};
+use std::collections::{BTreeMap, BTreeSet};
+const PIN: &str = "ae0fe511b15ab760d7e963b13389d1bc2ab42b18";
+const LIBRARY_EDITION: u16 = 2024;
+const LIMIT: usize = 32 * 1024 * 1024;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-SOURCE-TYPE-CONTEXT", message.into())
+}
+fn budget() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "Value-prelude source metadata budget".into(),
+    )
+}
+fn pinned_sources() -> [(&'static str, &'static str); 10] {
+    [
+        (
+            "library/core/src/prelude/mod.rs",
+            include_str!("value_prelude_sources/library/core/src/prelude/mod.rs"),
+        ),
+        (
+            "library/core/src/prelude/v1.rs",
+            include_str!("value_prelude_sources/library/core/src/prelude/v1.rs"),
+        ),
+        (
+            "library/std/src/prelude/mod.rs",
+            include_str!("value_prelude_sources/library/std/src/prelude/mod.rs"),
+        ),
+        (
+            "library/std/src/prelude/v1.rs",
+            include_str!("value_prelude_sources/library/std/src/prelude/v1.rs"),
+        ),
+        (
+            "library/core/src/mem/mod.rs",
+            include_str!("value_prelude_sources/library/core/src/mem/mod.rs"),
+        ),
+        (
+            "library/core/src/option.rs",
+            include_str!("value_prelude_sources/library/core/src/option.rs"),
+        ),
+        (
+            "library/core/src/result.rs",
+            include_str!("value_prelude_sources/library/core/src/result.rs"),
+        ),
+        (
+            "library/std/src/lib.rs",
+            include_str!("value_prelude_sources/library/std/src/lib.rs"),
+        ),
+        (
+            "library/core/Cargo.toml",
+            include_str!("value_prelude_sources/library/core/Cargo.toml"),
+        ),
+        (
+            "library/std/Cargo.toml",
+            include_str!("value_prelude_sources/library/std/Cargo.toml"),
+        ),
+    ]
+}
+/// Complete conservative union of outward spellings (all namespaces, including
+/// unstable exports). Presence does not establish a Value declaration kind.
+#[derive(Debug)]
+pub(crate) struct ValuePreludeCatalog {
+    core: BTreeMap<u16, BTreeSet<String>>,
+    standard: BTreeMap<u16, BTreeSet<String>>,
+    variants: BTreeMap<String, Digest>,
+    identity: Digest,
+    bytes: usize,
+}
+fn harmless_attributes(node: &ra_ap_syntax::SyntaxNode) -> Result<(), Diagnostic> {
+    for attr in node.children().filter_map(ast::Attr::cast) {
+        let text = attr.syntax().text().to_string();
+        let meta = attr
+            .meta()
+            .ok_or_else(|| fault("prelude export attribute syntax absent"))?;
+        // The pinned file's rustfmt-only conditional changes no exported name.
+        if matches!(&meta, ast::Meta::CfgAttrMeta(_)) {
+            if !text
+                .split_whitespace()
+                .collect::<String>()
+                .contains("cfg_attr(rustfmt,rustfmt::skip)")
+            {
+                return Err(fault("prelude cfg-dependent export closure is unresolved"));
+            }
+        } else if matches!(&meta, ast::Meta::CfgMeta(_)) {
+            return Err(fault("prelude cfg-dependent export closure is unresolved"));
+        }
+    }
+    Ok(())
+}
+fn exports(
+    items: impl Iterator<Item = ast::Item>,
+    scope: &ScopeKey,
+    mut glob: impl FnMut(&[ImportSegment]) -> Result<BTreeSet<String>, Diagnostic>,
+) -> Result<BTreeSet<String>, Diagnostic> {
+    let mut names = BTreeSet::new();
+    let mut retained = 0usize;
+    let mut imports = ImportBudget::default();
+    for (ordinal, item) in items.enumerate() {
+        if ordinal >= 100_000 {
+            return Err(budget());
+        }
+        harmless_attributes(item.syntax())?;
+        let ast::Item::Use(import) = item else {
+            return Err(fault(
+                "prelude export closure contains an unsupported public item",
+            ));
+        };
+        if import
+            .visibility()
+            .is_none_or(|v| v.syntax().text().to_string() != "pub")
+        {
+            return Err(fault(
+                "prelude export closure contains a nonpublic or restricted use",
+            ));
+        }
+        for leaf in crate::syntax::imports::collect(
+            &import,
+            scope,
+            Digest::of_bytes(import.syntax().text().to_string().as_bytes()),
+            &Visibility::Public,
+            &mut imports,
+        )? {
+            let additions = match leaf.kind {
+                ImportKind::Glob => glob(&leaf.path)?,
+                ImportKind::Anonymous => {
+                    return Err(fault(
+                        "prelude anonymous export needs exact outward-name admission",
+                    ));
+                }
+                ImportKind::Named { alias } => {
+                    let name = if let Some(alias) = alias {
+                        alias
+                    } else {
+                        match leaf.path.last() {
+                            Some(ImportSegment::Name(name)) => name.clone(),
+                            Some(ImportSegment::SelfModule) => {
+                                match leaf.path.iter().rev().nth(1) {
+                                    Some(ImportSegment::Name(name)) => name.clone(),
+                                    _ => {
+                                        return Err(fault(
+                                            "prelude self reexport lacks exact target name",
+                                        ));
+                                    }
+                                }
+                            }
+                            _ => return Err(fault("prelude named export target is unresolved")),
+                        }
+                    };
+                    BTreeSet::from([name])
+                }
+            };
+            for name in additions {
+                let name = crate::frontend::names::owned_name(&name, LIBRARY_EDITION)?
+                    .as_str()
+                    .to_owned();
+                retained = retained
+                    .checked_add(name.capacity())
+                    .and_then(|n| n.checked_add(128 + std::mem::size_of::<String>()))
+                    .filter(|n| *n <= LIMIT)
+                    .ok_or_else(budget)?;
+                names.insert(name);
+            }
+        }
+    }
+    Ok(names)
+}
+fn parsed(text: &str) -> Result<ast::SourceFile, Diagnostic> {
+    let parsed = ast::SourceFile::parse(text, Edition::Edition2024);
+    if !parsed.errors().is_empty() {
+        return Err(fault("pinned prelude export syntax is incomplete"));
+    }
+    let root = parsed.tree();
+    harmless_attributes(root.syntax())?;
+    Ok(root)
+}
+fn v1(text: &str, unit: Digest) -> Result<BTreeSet<String>, Diagnostic> {
+    let root = parsed(text)?;
+    let mut public = Vec::new();
+    for item in root.items() {
+        // This private module is selected only by explicit named outer exports;
+        // its glob cannot add another outward spelling. Exact source-pin equality
+        // below retains its full body; no wildcard target is inferred here.
+        if let ast::Item::Module(module) = &item {
+            if module.visibility().is_none()
+                && module
+                    .name()
+                    .is_some_and(|n| n.text() == "ambiguous_macros_only")
+            {
+                continue;
+            }
+        }
+        if public.len() >= 100_000 {
+            return Err(budget());
+        }
+        public.push(item);
+    }
+    exports(
+        public.into_iter(),
+        &ScopeKey {
+            crate_key: unit,
+            module_path: vec!["prelude".into(), "v1".into()],
+            owner: None,
+        },
+        |_| Err(fault("prelude v1 glob export is unresolved")),
+    )
+}
+fn editions(
+    text: &str,
+    unit: Digest,
+    v1: &BTreeSet<String>,
+    core: Option<&BTreeMap<u16, BTreeSet<String>>>,
+) -> Result<BTreeMap<u16, BTreeSet<String>>, Diagnostic> {
+    let root = parsed(text)?;
+    let mut result = BTreeMap::new();
+    let mut modules = BTreeSet::new();
+    for item in root.items() {
+        let ast::Item::Module(module) = item else {
+            return Err(fault("prelude edition root export is unresolved"));
+        };
+        harmless_attributes(module.syntax())?;
+        if module
+            .visibility()
+            .is_none_or(|v| v.syntax().text().to_string() != "pub")
+        {
+            return Err(fault("prelude edition module visibility differs"));
+        }
+        let name = module
+            .name()
+            .ok_or_else(|| fault("prelude edition module name absent"))?
+            .text()
+            .to_string();
+        if !modules.insert(name.clone()) {
+            return Err(fault("duplicate prelude edition module"));
+        }
+        if name == "v1" {
+            if module.item_list().is_some() {
+                return Err(fault("prelude v1 module target differs"));
+            }
+            continue;
+        }
+        let edition = match name.as_str() {
+            "rust_2015" => 2015,
+            "rust_2018" => 2018,
+            "rust_2021" => 2021,
+            "rust_2024" => 2024,
+            "rust_future" => {
+                continue;
+            }
+            _ => return Err(fault("unknown prelude edition module")),
+        };
+        let body = module
+            .item_list()
+            .ok_or_else(|| fault("prelude edition export body absent"))?;
+        let selected_core = core.and_then(|rows| rows.get(&edition));
+        let names = exports(
+            body.items(),
+            &ScopeKey {
+                crate_key: unit,
+                module_path: vec!["prelude".into(), name.clone()],
+                owner: None,
+            },
+            |path| match path {
+                [ImportSegment::Super, ImportSegment::Name(name)] if name == "v1" => Ok(v1.clone()),
+                [
+                    ImportSegment::Name(core_name),
+                    ImportSegment::Name(prelude),
+                    ImportSegment::Name(module),
+                ] if core_name == "core" && prelude == "prelude" && module == &name => {
+                    selected_core
+                        .cloned()
+                        .ok_or_else(|| fault("prelude core glob generation is unmatched"))
+                }
+                _ => Err(fault("prelude glob/reexport export closure is unresolved")),
+            },
+        )?;
+        result.insert(edition, names);
+    }
+    if result.len() != 4
+        || modules
+            != BTreeSet::from(
+                [
+                    "v1",
+                    "rust_2015",
+                    "rust_2018",
+                    "rust_2021",
+                    "rust_2024",
+                    "rust_future",
+                ]
+                .map(str::to_owned),
+            )
+    {
+        return Err(fault("prelude edition export chain is incomplete"));
+    }
+    Ok(result)
+}
+fn variant_identity(
+    text: &str,
+    enum_name: &str,
+    name: &str,
+    tuple: bool,
+) -> Result<Digest, Diagnostic> {
+    // No function body is checked. Retain only the pinned enum declaration and
+    // exact variant syntax/position, independently of any runtime descriptor.
+    let root = ast::SourceFile::parse(text, Edition::Edition2024).tree();
+    let declaration = root
+        .items()
+        .filter_map(|item| {
+            if let ast::Item::Enum(item) = item {
+                Some(item)
+            } else {
+                None
+            }
+        })
+        .find(|item| item.name().is_some_and(|n| n.text() == enum_name))
+        .ok_or_else(|| fault("pinned prelude variant declaration is absent"))?;
+    let variant = declaration
+        .variant_list()
+        .ok_or_else(|| fault("pinned prelude variant list absent"))?
+        .variants()
+        .find(|item| item.name().is_some_and(|n| n.text() == name))
+        .ok_or_else(|| fault("pinned prelude variant header absent"))?;
+    if !matches!(
+        (tuple, variant.field_list()),
+        (false, None) | (true, Some(ast::FieldList::TupleFieldList(_)))
+    ) {
+        return Err(fault("pinned prelude variant form differs"));
+    }
+    let mut encoded = StableEncoder::new("lrr/v1/pinned-prelude-variant-source");
+    encoded.string(PIN);
+    encoded.u16(LIBRARY_EDITION);
+    encoded.digest(Digest::of_bytes(text.as_bytes()));
+    encoded.string(enum_name);
+    encoded.string(name);
+    encoded.u32(u32::from(variant.syntax().text_range().start()));
+    encoded.u32(u32::from(variant.syntax().text_range().end()));
+    encoded.string(&variant.syntax().text().to_string());
+    Ok(encoded.finish())
+}
+impl ValuePreludeCatalog {
+    pub(crate) fn pinned() -> Result<Self, Diagnostic> {
+        Self::from_sources(&pinned_sources())
+    }
+    fn from_sources(sources: &[(&str, &str)]) -> Result<Self, Diagnostic> {
+        let expected = pinned_sources();
+        if sources != expected.as_slice() {
+            return Err(fault("Value-prelude library export chain/pin differs"));
+        }
+        let mut encoded = StableEncoder::new("lrr/v1/pinned-value-prelude-export-spellings");
+        encoded.string(PIN);
+        encoded.u16(LIBRARY_EDITION);
+        let mut source_bytes = 0usize;
+        for (path, text) in sources {
+            source_bytes = source_bytes
+                .checked_add(text.len())
+                .filter(|n| *n <= LIMIT)
+                .ok_or_else(budget)?;
+            encoded.string(path);
+            encoded.digest(Digest::of_bytes(text.as_bytes()));
+        }
+        for index in [8, 9] {
+            let manifest: toml::Value = toml::from_str(sources[index].1)
+                .map_err(|_| fault("prelude library manifest syntax differs"))?;
+            if manifest
+                .get("package")
+                .and_then(|p| p.get("edition"))
+                .and_then(toml::Value::as_str)
+                != Some("2024")
+            {
+                return Err(fault("prelude library owning edition differs"));
+            }
+        }
+        source_bytes
+            .checked_mul(32)
+            .filter(|n| *n <= LIMIT)
+            .ok_or_else(budget)?;
+        let core_unit = Digest::of_bytes(sources[8].1.as_bytes());
+        let std_unit = Digest::of_bytes(sources[9].1.as_bytes());
+        let core_v1 = v1(sources[1].1, core_unit)?;
+        let standard_v1 = v1(sources[3].1, std_unit)?;
+        let core = editions(sources[0].1, core_unit, &core_v1, None)?;
+        let standard = editions(sources[2].1, std_unit, &standard_v1, Some(&core))?;
+        let variants = BTreeMap::from([
+            (
+                "None".into(),
+                variant_identity(sources[5].1, "Option", "None", false)?,
+            ),
+            (
+                "Some".into(),
+                variant_identity(sources[5].1, "Option", "Some", true)?,
+            ),
+            (
+                "Ok".into(),
+                variant_identity(sources[6].1, "Result", "Ok", true)?,
+            ),
+            (
+                "Err".into(),
+                variant_identity(sources[6].1, "Result", "Err", true)?,
+            ),
+        ]);
+        let mut bytes = std::mem::size_of::<Self>();
+        for (tag, rows) in [(0u32, &core), (1u32, &standard)] {
+            encoded.u32(tag);
+            encoded.u64(u64::try_from(rows.len()).map_err(|_| budget())?);
+            for (edition, names) in rows {
+                encoded.u64(u64::try_from(names.len()).map_err(|_| budget())?);
+                encoded.u16(*edition);
+                bytes = bytes
+                    .checked_add(128 + std::mem::size_of::<(u16, BTreeSet<String>)>())
+                    .ok_or_else(budget)?;
+                for name in names {
+                    encoded.string(name);
+                    bytes = bytes
+                        .checked_add(128 + std::mem::size_of::<String>())
+                        .and_then(|n| n.checked_add(name.capacity()))
+                        .filter(|n| *n <= LIMIT)
+                        .ok_or_else(budget)?;
+                }
+            }
+        }
+        encoded.u64(u64::try_from(variants.len()).map_err(|_| budget())?);
+        for (name, identity) in &variants {
+            encoded.string(name);
+            encoded.digest(*identity);
+            bytes = bytes
+                .checked_add(128 + std::mem::size_of::<(String, Digest)>())
+                .and_then(|n| n.checked_add(name.capacity()))
+                .filter(|n| *n <= LIMIT)
+                .ok_or_else(budget)?;
+        }
+        Ok(Self {
+            core,
+            standard,
+            variants,
+            identity: encoded.finish(),
+            bytes,
+        })
+    }
+    #[cfg(test)]
+    pub(crate) fn library_revision(&self) -> &'static str {
+        PIN
+    }
+    #[cfg(test)]
+    pub(crate) fn library_edition(&self) -> u16 {
+        LIBRARY_EDITION
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn contains_export_spelling(
+        &self,
+        standard: bool,
+        edition: u16,
+        name: &str,
+    ) -> Result<bool, Diagnostic> {
+        let name = crate::frontend::names::owned_name(name, edition)?;
+        let rows = if standard { &self.standard } else { &self.core };
+        Ok(rows
+            .get(&edition)
+            .ok_or_else(|| fault("unknown Value-prelude consumer edition"))?
+            .contains(name.as_str()))
+    }
+    pub(crate) fn variant_source_identity(&self, name: &str) -> Option<Digest> {
+        self.variants.get(name).copied()
+    }
+}
+/// Captured scope/policy identity. Only the disabled variant proves automatic
+/// absence. An implicit variant explicitly lacks matched selected-library world
+/// authority, even though its complete pinned source catalog can be inspected.
+#[derive(Debug)]
+pub(crate) struct CapturedValuePreludePolicy {
+    identity: Digest,
+    standard: bool,
+    disabled: bool,
+    custom: bool,
+    edition: u16,
+    catalog: Option<ValuePreludeCatalog>,
+}
+impl CapturedValuePreludePolicy {
+    pub(crate) fn capture(
+        db: &Database,
+        source: &PreparedSourceView,
+        scope: &ScopeKey,
+    ) -> Result<Self, Diagnostic> {
+        source.require_original_hygiene()?;
+        source.require_declaration_syntax()?;
+        if scope.owner.is_some()
+            || scope.crate_key != source.selection().outline.crate_key
+            || !scope
+                .module_path
+                .starts_with(&source.selection().outline.module_path)
+        {
+            return Err(fault("Value-prelude policy source/module owner differs"));
+        }
+        // Policy witnesses are source snapshots, not standalone current Value
+        // namespace authority. Reject stale captured publications even before
+        // the owning SourceView admission binds its exact live seal/membership.
+        for (key, value) in source.prepared_inputs() {
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != value.fingerprint())
+            {
+                return Err(fault("Value-prelude captured source publication changed"));
+            }
+        }
+        let parsed = db
+            .prepared_parse(&source.selection().outline.parse)
+            .ok_or_else(|| fault("Value-prelude current parser lease absent"))?;
+        let Some(InputValue::CrateCfg(cfg)) = source
+            .prepared_inputs()
+            .get(&InputKey::CrateCfg(scope.crate_key))
+        else {
+            return Err(fault("Value-prelude captured cfg absent"));
+        };
+        if cfg.fingerprint() != source.selection().outline.cfg
+            || db
+                .published_input(&InputKey::CrateCfg(scope.crate_key))
+                .is_none_or(|(_, actual)| actual != InputValue::CrateCfg(cfg.clone()).fingerprint())
+        {
+            return Err(fault("Value-prelude current cfg differs"));
+        }
+        let policy = source.macro_prelude_policy()?;
+        let disabled = policy
+            .disabled
+            .iter()
+            .any(|prefix| scope.module_path.starts_with(prefix));
+        let mut custom = false;
+        let mut scanned = 0usize;
+        for import in parsed
+            .parsed
+            .tree()
+            .syntax()
+            .descendants()
+            .filter_map(ast::Use::cast)
+        {
+            if import.syntax().ancestors().any(|node| {
+                ast::Fn::can_cast(node.kind())
+                    || ast::Const::can_cast(node.kind())
+                    || ast::Static::can_cast(node.kind())
+            }) {
+                continue;
+            }
+            scanned = scanned
+                .checked_add(1)
+                .filter(|n| *n <= 100_000)
+                .ok_or_else(budget)?;
+            let mut attrs = Vec::new();
+            for attr in import.attrs() {
+                if attrs.len() >= 100_000 {
+                    return Err(budget());
+                }
+                if let Some(meta) = attr.meta() {
+                    attrs.push(meta);
+                }
+            }
+            let (enabled, metas) = crate::syntax::attributes::effective_metas(attrs, cfg)?;
+            if enabled
+                && metas.iter().any(|meta| {
+                    meta.simple_name()
+                        .is_some_and(|name| name == "prelude_import")
+                })
+            {
+                custom = true;
+            }
+        }
+        let catalog = if disabled || custom {
+            None
+        } else {
+            Some(ValuePreludeCatalog::pinned()?)
+        };
+        let mut encoded = StableEncoder::new("lrr/v1/captured-value-prelude-policy");
+        encoded.record(source.selection());
+        encoded.record(scope);
+        encoded.digest(cfg.fingerprint());
+        encoded.bool(policy.standard);
+        encoded.bool(disabled);
+        encoded.bool(custom);
+        encoded.u16(parsed.edition);
+        encoded.option(&catalog, |encoded, catalog| {
+            encoded.digest(catalog.identity())
+        });
+        Ok(Self {
+            identity: encoded.finish(),
+            standard: policy.standard,
+            disabled,
+            custom,
+            edition: parsed.edition,
+            catalog,
+        })
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    #[cfg(test)]
+    pub(crate) fn standard(&self) -> bool {
+        self.standard
+    }
+    #[cfg(test)]
+    pub(crate) fn disabled(&self) -> bool {
+        self.disabled
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(
+                self.catalog
+                    .as_ref()
+                    .map_or(0, ValuePreludeCatalog::metadata_bytes),
+            )
+            .filter(|n| *n <= LIMIT)
+            .ok_or_else(budget)
+    }
+    pub(crate) fn require_automatic_absence(&self, name: &str) -> Result<(), Diagnostic> {
+        crate::frontend::names::owned_name(name, self.edition)?;
+        if self.custom {
+            return Err(fault(
+                "Value-prelude/pattern witness needs current custom prelude_import source seal",
+            ));
+        }
+        if self.disabled {
+            return Ok(());
+        }
+        let catalog = self
+            .catalog
+            .as_ref()
+            .ok_or_else(|| fault("Value-prelude/pattern witness export catalog absent"))?;
+        if catalog.contains_export_spelling(self.standard, self.edition, name)? {
+            let _pinned_variant_source = catalog.variant_source_identity(name);
+            return Err(fault(
+                "Value-prelude/pattern witness present export needs selected declaration/source-kind authority",
+            ));
+        }
+        // No selected-library-generation certificate exists in current prepared
+        // inputs. In particular the ae0fe source pin is not the installed b940
+        // Rust 1.99 compiler/sysroot. Macro facade unit equality is insufficient.
+        Err(fault(
+            "Value-prelude/pattern witness needs matched selected Value-prelude library generation; fixture source pin is not installed sysroot authority",
+        ))
+    }
+}
