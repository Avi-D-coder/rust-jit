+    where
+        P: [const] FnOnce(&T) -> bool + [const] Destruct,
+        T: [const] Destruct,
+    {
+        if let Some(x) = self {
+            if predicate(&x) {
+                return Some(x);
+            }
+        }
+        None
+    }
