+//! Source-only preregistered controls. No matched installed-library or guest pass.
+use super::*;
+#[test]
+fn pristine_closed_export_spelling_union_keeps_all_editions_and_source_pin() {
+    let catalog = ValuePreludeCatalog::pinned().unwrap();
+    assert_eq!(
+        catalog.library_revision(),
+        "ae0fe511b15ab760d7e963b13389d1bc2ab42b18"
+    );
+    assert_eq!(catalog.library_edition(), 2024);
+    for edition in [2015, 2018, 2021, 2024] {
+        for standard in [false, true] {
+            for name in [
+                "None", "Some", "Ok", "Err", "Option", "Result", "Copy", "drop",
+            ] {
+                assert!(
+                    catalog
+                        .contains_export_spelling(standard, edition, name)
+                        .unwrap()
+                );
+            }
+            assert!(
+                !catalog
+                    .contains_export_spelling(standard, edition, "v")
+                    .unwrap()
+            );
+            assert!(
+                !catalog
+                    .contains_export_spelling(standard, edition, "x")
+                    .unwrap()
+            );
+            assert!(
+                !catalog
+                    .contains_export_spelling(standard, edition, "_a")
+                    .unwrap()
+            );
+            assert_eq!(
+                catalog
+                    .contains_export_spelling(standard, edition, "TryInto")
+                    .unwrap(),
+                edition >= 2021
+            );
+            assert_eq!(
+                catalog
+                    .contains_export_spelling(standard, edition, "Future")
+                    .unwrap(),
+                edition >= 2024
+            );
+            assert_eq!(
+                catalog
+                    .contains_export_spelling(standard, edition, "Vec")
+                    .unwrap(),
+                standard
+            );
+        }
+    }
+    assert!(catalog.contains_export_spelling(true, 2027, "x").is_err());
+}
+#[test]
+fn pinned_option_result_variant_headers_are_distinct_source_identities_not_world_authority() {
+    let catalog = ValuePreludeCatalog::pinned().unwrap();
+    let identities =
+        ["None", "Some", "Ok", "Err"].map(|name| catalog.variant_source_identity(name).unwrap());
+    for (i, left) in identities.iter().enumerate() {
+        for right in identities.iter().skip(i + 1) {
+            assert_ne!(left, right);
+        }
+    }
+    // Their presence does not classify an arbitrary caller pattern as Binding.
+}
+#[test]
+fn missing_or_changed_export_header_glob_cfg_and_library_edition_refuse_pin() {
+    let original = pinned_sources();
+    for (index, needle, replacement) in [
+        (1, "self, None, Some", "self, Some"),
+        (0, "pub use super::v1::*;", "pub use mystery::*;"),
+        (
+            1,
+            "pub use crate::mem::drop;",
+            "#[cfg(feature=\"missing\")] pub use crate::mem::drop;",
+        ),
+        (5, "pub enum Option<T>", "pub enum Changed<T>"),
+        (8, "edition = \"2024\"", "edition = \"2021\""),
+    ] {
+        assert!(original[index].1.contains(needle));
+        let changed = original[index].1.replacen(needle, replacement, 1);
+        let mut supplied = original.to_vec();
+        supplied[index].1 = &changed;
+        assert!(ValuePreludeCatalog::from_sources(&supplied).is_err());
+    }
+    let mut removed = original.to_vec();
+    removed.pop();
+    assert!(ValuePreludeCatalog::from_sources(&removed).is_err());
+}
