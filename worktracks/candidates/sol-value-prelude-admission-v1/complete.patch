+//! Actual captured policy/component controls, not rewritten stock programs.
+use super::super::tests::{COPY, INFER, parameter_alias, publish_scope, world};
+use super::super::tests::{runtime_environment, site, world_unsealed};
+use super::*;
+const NO_IMPLICIT: &str =
+    "#![no_implicit_prelude] fn chosen<T>(x:T){let alias=x;let later=alias;}fn main(){}";
+#[test]
+fn captured_empty_prelude_proves_ordinary_parameter_alias_all_editions_without_recovering_param() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view, env, plan) =
+            parameter_alias(NO_IMPLICIT, "chosen", "let alias=x;", edition, true);
+        let before = db.trace.events.len();
+        let proof = plan
+            .admit_current(&db, &view, Some(&env), SOURCE_VIEW_BUDGET)
+            .unwrap();
+        assert_eq!(proof.source().term(), plan.source.term());
+        assert!(matches!(proof.source().term(), TyTerm::Param(_)));
+        assert_eq!(proof.runtime(), TypeId(6));
+        proof.revalidate(&db, &view, Some(&env), &plan).unwrap();
+        assert_eq!(db.trace.events.len(), before);
+    }
+}
+#[test]
+fn unchanged_original_implicit_preludes_keep_selected_library_generation_prerequisite_all_editions()
+{
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view, env, plan) =
+            parameter_alias(COPY, "can_copy_copy", "let _a = v;", edition, true);
+        let before = db.trace.events.len();
+        let error = plan
+            .admit_current(&db, &view, Some(&env), SOURCE_VIEW_BUDGET)
+            .unwrap_err();
+        assert!(
+            error
+                .message
+                .contains("matched selected Value-prelude library generation")
+        );
+        assert_eq!(db.trace.events.len(), before);
+        // The actual INFER and None/Some/Ok/Err cases are also retained unchanged;
+        // existing named-return control continues to refuse unestablished authority.
+        assert!(INFER.contains("id(x)"));
