diff --git a/crates/lrr/src/frontend/source_view_pattern_admission.rs b/crates/lrr/src/frontend/source_view_pattern_admission.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/frontend/source_view_pattern_admission.rs
@@ -0,0 +1,164 @@
+//! Private, current-source pattern decisions; no caller blanket resolution map.
+use super::*;
+use crate::{
+    facade::value_prelude::CapturedValuePreludePolicy,
+    frontend::{source_locals::PatternResolution, source_macros::EnteredMacroIndex},
+    syntax::local_bindings::{BindingForm, PatternNameKind},
+};
+/// The owning current SourceView certificate binds this producer identity to its
+/// exact source/seal/world and all published input membership. The map is local
+/// replay metadata, not a public NameId/SourceViewId or a reusable world witness.
+pub(super) struct CurrentPatternNames {
+    policy: CapturedValuePreludePolicy,
+    resolutions: BTreeMap<Digest, PatternResolution>,
+    identity: Digest,
+}
+impl CurrentPatternNames {
+    pub(super) fn prepare(
+        db: &Database,
+        source: &PreparedSourceView,
+        owner: &DefinitionSourcePlan,
+        entered: &EnteredMacroIndex<'_>,
+        names: &NameNamespaces,
+        limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        let policy = CapturedValuePreludePolicy::capture(db, source, &owner.signature().scope)?;
+        let mut bytes = policy
+            .metadata_bytes()?
+            .checked_add(std::mem::size_of::<Self>())
+            .filter(|n| *n <= limit)
+            .ok_or_else(metadata_fault)?;
+        if entered.facts().bindings.len() > 256 {
+            return Err(metadata_fault());
+        }
+        bytes = bytes
+            .checked_add(
+                entered
+                    .facts()
+                    .bindings
+                    .len()
+                    .checked_mul(std::mem::size_of::<
+                        &crate::syntax::local_bindings::LocalBindingRecipe,
+                    >())
+                    .ok_or_else(metadata_fault)?,
+            )
+            .filter(|n| *n <= limit)
+            .ok_or_else(metadata_fault)?;
+        let mut ordered = Vec::new();
+        ordered
+            .try_reserve_exact(entered.facts().bindings.len())
+            .map_err(|_| metadata_fault())?;
+        ordered.extend(entered.facts().bindings.iter());
+        // The allocator may reserve more than requested. Account the actual
+        // retained capacity before any pattern resolution can be attached.
+        bytes = bytes
+            .checked_add(
+                ordered
+                    .capacity()
+                    .saturating_sub(entered.facts().bindings.len())
+                    .checked_mul(std::mem::size_of::<
+                        &crate::syntax::local_bindings::LocalBindingRecipe,
+                    >())
+                    .ok_or_else(metadata_fault)?,
+            )
+            .filter(|n| *n <= limit)
+            .ok_or_else(metadata_fault)?;
+        ordered.sort_by_key(|binding| {
+            (
+                binding.visible_from,
+                binding.name_range.start,
+                binding.identity,
+            )
+        });
+        let mut resolutions = BTreeMap::new();
+        for binding in ordered {
+            if binding.classification != PatternNameKind::BindingOrConstant
+                || !matches!(binding.form, BindingForm::Parameter | BindingForm::Let)
+            {
+                continue;
+            }
+            // A missing implicit/custom library world never becomes module-only
+            // absence. Other cold ambiguous bindings stay deferred.
+            if policy.require_automatic_absence(&binding.name).is_err() {
+                continue;
+            }
+            bytes = bytes
+                .checked_add(128 + std::mem::size_of::<(Digest, PatternResolution)>())
+                .filter(|n| *n <= limit)
+                .ok_or_else(metadata_fault)?;
+            // Suppress only this candidate while searching prior actual locals,
+            // block-wide items/imports and the module Value namespace. This is
+            // an ephemeral lookup view, never a Constant decision publication.
+            if resolutions
+                .insert(binding.identity, PatternResolution::Constant)
+                .is_some()
+            {
+                return Err(source_fault("duplicate current source pattern identity"));
+            }
+            let locals =
+                entered.local_index(source.selection(), &owner.body().key(), &resolutions, &[])?;
+            let at = if binding.form == BindingForm::Parameter {
+                owner.body().range.start
+            } else {
+                binding.pattern_range.start
+            };
+            let current = locals.lookup_ordinary(
+                OrdinaryNameSite {
+                    source: source.selection(),
+                    body: &owner.body().key(),
+                    at: u64::from(at),
+                    name: &binding.raw_name,
+                    context: locals.context(),
+                    namespace: Namespace::Value,
+                },
+                names,
+                None,
+            )?;
+            drop(locals);
+            resolutions.remove(&binding.identity);
+            match current {
+                NameLookup::Absent | NameLookup::LocalBinding(_) => {
+                    resolutions.insert(binding.identity, PatternResolution::Binding);
+                }
+                // A real function may be legally shadowed, but without an exact
+                // declaration-kind/pattern witness we preserve this frontier.
+                // Constants, constructors, imports, generated and pending rows
+                // never become invented bindings from a spelling or descriptor.
+                _ => {}
+            }
+        }
+        let mut encoded = StableEncoder::new("lrr/v1/current-source-view-pattern-admission");
+        encoded.digest(policy.identity());
+        encoded.digest(owner.signature().fingerprint());
+        encoded.record(&owner.body().key());
+        encoded.u32(u32::try_from(resolutions.len()).map_err(|_| metadata_fault())?);
+        for (identity, resolution) in &resolutions {
+            encoded.digest(*identity);
+            match resolution {
+                PatternResolution::Binding => encoded.u32(0),
+                _ => {
+                    return Err(source_fault(
+                        "pattern admission retained an unproven decision",
+                    ));
+                }
+            }
+        }
+        Ok(Self {
+            policy,
+            resolutions,
+            identity: encoded.finish(),
+        })
+    }
+    pub(super) fn resolutions(&self) -> &BTreeMap<Digest, PatternResolution> {
+        &self.resolutions
+    }
+    pub(super) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(super) fn refusal(&self, name: &str) -> Diagnostic {
+        self.policy.require_automatic_absence(name).err().unwrap_or_else(||source_fault("source-view current pattern name needs exact local/module declaration-kind authority"))
+    }
+}
