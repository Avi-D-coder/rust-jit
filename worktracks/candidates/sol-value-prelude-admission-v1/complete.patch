+        certificate
+            .revalidate(&db, &view, Some(&env), &result)
+            .unwrap();
+        assert_eq!(db.trace.events.len(), before);
+        assert!(db.trace.events.iter().all(|event| !matches!(
+            event.key,
+            crate::db::key::QueryKey::BodyStructure(_) | crate::db::key::QueryKey::Thunk(_)
+        )));
+    }
+}
