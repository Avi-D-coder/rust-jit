+        dependencies::SourceDependency,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{
+        declaration_scan::DeclarationScanLimits,
+        parse::{ParseKey, ParsedFile},
+    },
+};
+use std::sync::Arc;
