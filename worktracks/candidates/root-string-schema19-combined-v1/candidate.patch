+//! Bounded substring search over two genuine immutable UTF-8 roots.
+//! This physical cursor grants no source Pattern/member authority. It cannot be
+//! cached as a recipe, cloned for replay or resumed after any terminal outcome.
+use super::*;
+
+pub(crate) struct StaticStringSearch {
+    captured: StaticByteComparison,
+    candidate: u32,
+    matched: u32,
+}
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) enum StaticStringSearchPoll {
+    Dispatch { pairs: u32 },
+    Complete { contains: bool, pairs: u32 },
+}
+impl StaticStringSearch {
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+    }
+    pub(crate) fn require_operands(
+        &self,
+        haystack: CellId,
+        needle: CellId,
+    ) -> Result<(), Diagnostic> {
+        self.captured.require_operands(haystack, needle)
+    }
+}
+impl GuestStore {
+    pub(crate) fn prepare_static_string_search(
+        &self,
+        haystack: CellId,
+        needle: CellId,
+    ) -> Result<StaticStringSearch, Diagnostic> {
+        self.require_static_string_value(haystack)?;
+        self.require_static_string_value(needle)?;
+        Ok(StaticStringSearch {
+            captured: self.prepare_static_byte_comparison(haystack, needle)?,
+            candidate: 0,
+            matched: 0,
+        })
+    }
+    pub(crate) fn admit_static_string_search(
+        &self,
+        cursor: &StaticStringSearch,
+        haystack: CellId,
+        needle: CellId,
+    ) -> Result<(), Diagnostic> {
+        if cursor.candidate != 0 || cursor.matched != 0 {
+            return Err(lease_fault());
+        }
+        self.require_static_string_value(haystack)?;
+        self.require_static_string_value(needle)?;
+        self.admit_static_byte_comparison(&cursor.captured, haystack, needle)
+    }
+    pub(crate) fn advance_static_string_search(
+        &self,
+        cursor: &mut StaticStringSearch,
+        fuel: &mut RunFuel,
+    ) -> Result<StaticStringSearchPoll, Diagnostic> {
+        if cursor.captured.terminal {
+            return Err(lease_fault());
+        }
+        let outcome = self.static_string_search_chunk(cursor, fuel);
+        if !matches!(outcome, Ok(StaticStringSearchPoll::Dispatch { .. })) {
+            cursor.captured.terminal = true;
+        }
+        outcome
+    }
+    fn static_string_search_chunk(
+        &self,
+        cursor: &mut StaticStringSearch,
+        fuel: &mut RunFuel,
+    ) -> Result<StaticStringSearchPoll, Diagnostic> {
+        self.validate_static_byte_comparison(&cursor.captured)?;
+        let haystack = cursor.captured.left;
+        let needle = cursor.captured.right;
+        self.require_static_string_value(haystack.operand.cell)?;
+        self.require_static_string_value(needle.operand.cell)?;
+        fuel.poll()?;
+        if cursor.matched > needle.len || cursor.candidate > haystack.len {
+            return Err(lease_fault());
+        }
+        // An empty UTF-8 pattern occurs at the initial boundary. Polling still
+        // precedes this result, and the VM must charge its own opcode once.
+        if needle.len == 0 {
+            return Ok(StaticStringSearchPoll::Complete {
+                contains: true,
+                pairs: 0,
+            });
+        }
+        let Some(last) = haystack.len.checked_sub(needle.len) else {
+            return Ok(StaticStringSearchPoll::Complete {
+                contains: false,
+                pairs: 0,
+            });
+        };
+        let mut pairs = 0u32;
+        while pairs < PAIRS_PER_DISPATCH && cursor.candidate <= last {
+            fuel.charge()?;
+            let offset = cursor
+                .candidate
+                .checked_add(cursor.matched)
+                .ok_or_else(resource)?;
+            let left = self.comparison_byte(haystack, offset)?;
+            let right = self.comparison_byte(needle, cursor.matched)?;
+            pairs += 1;
+            if left == right {
+                cursor.matched = cursor.matched.checked_add(1).ok_or_else(resource)?;
+                if cursor.matched == needle.len {
+                    return Ok(StaticStringSearchPoll::Complete {
+                        contains: true,
+                        pairs,
+                    });
+                }
+            } else {
+                cursor.candidate = cursor.candidate.checked_add(1).ok_or_else(resource)?;
+                cursor.matched = 0;
+            }
+        }
+        if cursor.candidate > last {
+            Ok(StaticStringSearchPoll::Complete {
+                contains: false,
+                pairs,
+            })
+        } else {
+            Ok(StaticStringSearchPoll::Dispatch { pairs })
+        }
+    }
+}
