+// These are explicitly LRR component adapters, not shortened fixture passes.
+// Each method expression is copied from its exact original AST. The full
+// strlen program's const/iteration/indexing assertions remain outstanding;
+// raw-string-literal-unescaped-unicode is a check-pass compiler contract.
+fn upstream_empty_expression(nonempty_raw: bool) -> String {
+    const LENGTH: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/consts/const-eval/strlen.rs"
+    );
+    const RAW: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/str/raw-string-literal-unescaped-unicode.rs"
+    );
+    if nonempty_raw {
+        crate::syntax::string_fixture_facts::empty_method_expression(RAW, None)
+    } else {
+        crate::syntax::string_fixture_facts::empty_method_expression(LENGTH, Some("EMPTY"))
+    }
+}
+fn empty_component_adapter(nonempty_raw: bool) -> String {
+    let expression = upstream_empty_expression(nonempty_raw);
+    if nonempty_raw {
+        format!("fn main(){{assert!(!({expression}));}}")
+    } else {
+        format!("fn main(){{assert!({expression});}}")
+    }
+}
+#[test]
+fn upstream_empty_and_raw_nonempty_string_method_components_execute_actual_length_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        for nonempty_raw in [false, true] {
+            let source = empty_component_adapter(nonempty_raw);
+            let (mut db, mut run, macros, _) = tests::start_source(&source, edition, 10_000);
+            let contexts = macros.contexts().unwrap();
+            let report = match run.poll_with_runtime_macros(&mut db, &contexts) {
+                RunPoll::Completed(report) => report,
+                RunPoll::Fault(error) => {
+                    panic!("edition {edition} nonempty={nonempty_raw}: {error}")
+                }
+                RunPoll::NeedInput(input) => {
+                    panic!("edition {edition} nonempty={nonempty_raw}: {input:?}")
+                }
+                RunPoll::Panicked(report) => {
+                    panic!("edition {edition} nonempty={nonempty_raw}: {report:?}")
+                }
+            };
+            assert!(matches!(report.value, ValueSummary::Unit));
+            assert_eq!(report.opcode_counters.started_by_opcode[47], 1);
+            assert_eq!(report.opcode_counters.started_by_opcode[45], 0);
+            assert_eq!(report.opcode_counters.started_by_opcode[26], 1);
+            assert_eq!(
+                report.opcode_counters.operations_started,
+                report.opcode_counters.operations_completed
+            );
+            assert!(run.calls.is_empty() && run.pending.is_empty());
+            assert!(run.frame.active_scopes().is_empty());
+            db.finish_run().unwrap();
+        }
+    }
+}
+#[test]
+fn original_empty_method_source_result_and_fuel_refusals_precede_publication() {
+    let text = empty_component_adapter(false);
+    for mode in 0..3 {
+        let (mut db, mut run, macros, _) = tests::start_source(&text, 2024, 10_000);
+        let contexts = macros.contexts().unwrap();
+        let (id, source, destination) = reach_string_method(&mut db, &mut run, &contexts, 47);
+        let used = run.frame.fuel_snapshot().used;
+        if mode == 2 {
+            db.finish_run().unwrap();
+            let (mut db, mut run, macros, _) = tests::start_source(&text, 2024, used);
+            let contexts = macros.contexts().unwrap();
+            let (id, _, _) = reach_string_method(&mut db, &mut run, &contexts, 47);
+            let before = effects(&run);
+            assert_eq!(
+                step::step(
+                    &mut run.frame,
+                    &mut run.store,
+                    run.installed.get(id).unwrap()
+                )
+                .unwrap_err()
+                .code,
+                "LRR-E-RUNTIME-RESOURCE"
+            );
+            assert_eq!(effects(&run), before);
+            assert_eq!(run.frame.counters().started_by_opcode[47], 0);
+            db.finish_run().unwrap();
+            continue;
+        }
+        if mode == 0 {
+            run.frame
+                .set_source_view(
+                    source,
+                    Some(TyTerm::Ref(RegionTerm::Static, true, Box::new(TyTerm::Str))),
+                )
+                .unwrap();
+            assert!(
+                run.revalidate_primitive_method(&mut db, &contexts, id)
+                    .is_err()
+            );
+        } else {
+            // A strict result contract is an authority guard. Soft primitive
+            // argument expectations are checked later at their call boundary.
+            run.frame
+                .declared_hint(destination, Some(crate::runtime::shape::TypeId(2)))
+                .unwrap();
+            run.frame
+                .set_source_view(destination, Some(TyTerm::Primitive(PrimitiveType::Usize)))
+                .unwrap();
+        }
+        let before = effects(&run);
+        let error = step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap(),
+        )
+        .unwrap_err();
+        assert_eq!(
+            error.code,
+            if mode == 0 {
+                "LRR-E-INTERNAL-IR"
+            } else {
+                "LRR-E-GENERIC-BINDING"
+            }
+        );
+        assert_eq!(effects(&run), before);
+        assert_eq!(run.frame.counters().started_by_opcode[47], 0);
+        db.finish_run().unwrap();
+    }
+}
