+//! One run-bound str::contains operation; no query or native execution.
+use super::*;
+use crate::{
+    ir::op::{Op, PrimitiveType},
+    runtime::cell::byte_comparison::{StaticStringSearch, StaticStringSearchPoll},
+    traits::term::TyTerm,
+};
+pub(super) struct BoundStringSearch {
+    pc: PcKey,
+    operation_index: usize,
+    operation: Op,
+    haystack: CellId,
+    needle: CellId,
+    receiver_source: TyTerm,
+    pattern_source: TyTerm,
+    destination: CellId,
+    destination_epoch: u32,
+    scope: ScopeId,
+    prior_source: Option<TyTerm>,
+    physical: StaticStringSearch,
+}
+fn shared_str(source: Option<&TyTerm>) -> bool {
+    matches!(source, Some(TyTerm::Ref(_, false, target)) if target.as_ref() == &TyTerm::Str)
+}
+impl Frame {
+    pub(crate) fn has_string_search_activation(&self) -> bool {
+        self.string_search_activation.is_some()
+    }
+    pub(crate) fn string_search_operation_index(&self) -> Option<usize> {
+        self.string_search_activation
+            .as_ref()
+            .map(|a| a.operation_index)
+    }
+    fn search_metadata(
+        &self,
+        physical: &StaticStringSearch,
+        source: SlotId,
+        pattern: SlotId,
+    ) -> Result<(), Diagnostic> {
+        Self::metadata_bytes(&self.body, self.parameter_metadata_count())
+            .and_then(|n| n.checked_add(self.constructor_mapping_bytes))
+            .and_then(|n| n.checked_add(self.projection_bytes))
+            .and_then(|n| n.checked_add(self.source_field_bytes()?))
+            .and_then(|n| n.checked_add(self.macro_byte_literal_bytes()?))
+            .and_then(|n| n.checked_add(std::mem::size_of::<BoundStringSearch>()))
+            .and_then(|n| n.checked_add(physical.metadata_bytes()))
+            .and_then(|n| {
+                n.checked_add(
+                    self.source_view_ref(source)
+                        .ok()?
+                        .and_then(TyTerm::heap_bytes)?,
+                )
+            })
+            .and_then(|n| {
+                n.checked_add(
+                    self.source_view_ref(pattern)
+                        .ok()?
+                        .and_then(TyTerm::heap_bytes)?,
+                )
+            })
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        Ok(())
+    }
+    pub(crate) fn prepare_string_search(
+        &self,
+        op: &Op,
+        store: &GuestStore,
+    ) -> Result<Option<StaticStringSearch>, Diagnostic> {
+        let Op::StrContains {
+            source,
+            pattern,
+            destination,
+        } = op
+        else {
+            return Ok(None);
+        };
+        self.require_store(store)?;
+        if source == destination
+            || pattern == destination
+            || !shared_str(self.source_view_ref(*source)?)
+            || !shared_str(self.source_view_ref(*pattern)?)
+        {
+            return Err(invalid(
+                "str search requires actual shared str source and Pattern argument",
+            ));
+        }
+        self.preflight_primitive_operator_result(
+            *destination,
+            TypeId(2),
+            Some(PrimitiveType::Bool),
+            store,
+        )?;
+        self.preflight_primitive_operator_capacity(*destination, store)?;
+        let physical =
+            store.prepare_static_string_search(self.cell(*source)?, self.cell(*pattern)?)?;
+        self.search_metadata(&physical, *source, *pattern)?;
+        Ok(Some(physical))
+    }
+    pub(crate) fn begin_string_search(
+        &mut self,
+        index: usize,
+        op: &Op,
+        physical: StaticStringSearch,
+        store: &mut GuestStore,
+    ) -> Result<(), Diagnostic> {
+        self.require_store(store)?;
+        if self.status != FrameStatus::Running
+            || self.string_search_activation.is_some()
+            || self.byte_activation.is_some()
+            || self.byte_comparison_activation.is_some()
+            || self.copy_activation.is_some()
+            || self.cleanup_activation.is_some()
+            || self.constant_activation.is_some()
+        {
+            return Err(invalid("str search overlaps another bounded operation"));
+        }
+        let Op::StrContains {
+            source,
+            pattern,
+            destination,
+        } = op
+        else {
+            return Err(invalid("str search requires its exact contains operation"));
+        };
+        if source == destination
+            || pattern == destination
+            || !shared_str(self.source_view_ref(*source)?)
+            || !shared_str(self.source_view_ref(*pattern)?)
+        {
+            return Err(invalid("str search source views changed before entry"));
+        }
+        let haystack = self.cell(*source)?;
+        let needle = self.cell(*pattern)?;
+        store.admit_static_string_search(&physical, haystack, needle)?;
+        self.preflight_primitive_operator_result(
+            *destination,
+            TypeId(2),
+            Some(PrimitiveType::Bool),
+            store,
+        )?;
+        self.preflight_primitive_operator_capacity(*destination, store)?;
+        self.search_metadata(&physical, *source, *pattern)?;
+        let receiver_source = self
+            .source_view(*source)?
+            .ok_or_else(|| invalid("str receiver source absent"))?;
+        let pattern_source = self
+            .source_view(*pattern)?
+            .ok_or_else(|| invalid("str Pattern source absent"))?;
+        let prior_source = self.source_view(*destination)?;
+        self.reserve_primitive_operator_result(*destination, store)?;
+        let cell = self.prepare_write(*destination, store)?;
+        self.string_search_activation = Some(BoundStringSearch {
+            pc: self.pc.clone(),
+            operation_index: index,
+            operation: op.clone(),
+            haystack,
+            needle,
+            receiver_source,
+            pattern_source,
+            destination: cell,
+            destination_epoch: store.location_epoch(cell)?,
+            scope: self.slot(*destination)?.scope,
+            prior_source,
+            physical,
+        });
+        Ok(())
+    }
+    pub(crate) fn check_string_search_activation(
+        &self,
+        index: usize,
+        op: &Op,
+        store: &GuestStore,
+    ) -> Result<SlotId, Diagnostic> {
+        self.require_store(store)?;
+        let Op::StrContains {
+            source,
+            pattern,
+            destination,
+        } = op
+        else {
+            return Err(invalid("str search resumed at a different operation kind"));
+        };
+        let a = self
+            .string_search_activation
+            .as_ref()
+            .ok_or_else(|| invalid("str search continuation absent"))?;
+        if self.status != FrameStatus::Running
+            || self.pc != a.pc
+            || index != a.operation_index
+            || op != &a.operation
+            || self.cell(*source)? != a.haystack
+            || self.cell(*pattern)? != a.needle
+            || self.source_view_ref(*source)? != Some(&a.receiver_source)
+            || self.source_view_ref(*pattern)? != Some(&a.pattern_source)
+            || self.slot(*destination)?.cell != Some(a.destination)
+            || self.slot(*destination)?.scope != a.scope
+            || self.source_view_ref(*destination)? != a.prior_source.as_ref()
+            || store.location_epoch(a.destination)? != a.destination_epoch
+            || self.byte_activation.is_some()
+            || self.byte_comparison_activation.is_some()
+            || self.copy_activation.is_some()
+            || self.cleanup_activation.is_some()
+            || self.constant_activation.is_some()
+        {
+            return Err(invalid(
+                "str search continuation source, PC or result binding changed",
+            ));
+        }
+        a.physical.require_operands(a.haystack, a.needle)?;
+        self.preflight_primitive_operator_result(
+            *destination,
+            TypeId(2),
+            Some(PrimitiveType::Bool),
+            store,
+        )?;
+        Ok(*destination)
+    }
+    pub(crate) fn advance_string_search(
+        &mut self,
+        index: usize,
+        op: &Op,
+        store: &mut GuestStore,
+    ) -> Result<bool, Diagnostic> {
+        let destination = self.check_string_search_activation(index, op, store)?;
+        let mut active = self
+            .string_search_activation
+            .take()
+            .ok_or_else(|| invalid("str search continuation disappeared"))?;
+        let poll = store.advance_static_string_search(&mut active.physical, &mut self.fuel);
+        self.counters.fuel_used = self.fuel.snapshot().used;
+        match poll? {
+            StaticStringSearchPoll::Dispatch { pairs } => {
+                if pairs > 256 {
+                    return Err(invalid("str search exceeded dispatch pair bound"));
+                }
+                self.string_search_activation = Some(active);
+                Ok(false)
+            }
+            StaticStringSearchPoll::Complete { contains, pairs } => {
+                if pairs > 256 {
+                    return Err(invalid("str search exceeded completion pair bound"));
+                }
+                self.fuel.poll()?;
+                let ticket = store.ticket(ValueRepr::boolean(contains))?;
+                if let Err(error) = self.write(destination, ticket, store) {
+                    store.discard(ticket)?;
+                    return Err(error);
+                }
+                self.set_source_view(destination, Some(TyTerm::Primitive(PrimitiveType::Bool)))?;
+                Ok(true)
+            }
+        }
+    }
+}
