+/// Exact source expression for an explicitly labeled LRR component adapter.
+/// This supplies syntax text, never a runtime result or a fixture-pass receipt.
+pub(crate) fn empty_method_expression(source: &str, constant_name: Option<&str>) -> String {
+    use ra_ap_syntax::ast::{HasGenericArgs, HasName};
+    let parsed = parsed(source, 2024);
+    let tree = parsed.parsed.tree();
+    let call = if let Some(name) = constant_name {
+        let constant = tree
+            .syntax()
+            .descendants()
+            .filter_map(ast::Const::cast)
+            .find(|constant| constant.name().is_some_and(|actual| actual.text() == name))
+            .unwrap();
+        let ast::Expr::MethodCallExpr(call) = constant.body().unwrap() else {
+            panic!("original empty initializer is a method call")
+        };
+        call
+    } else {
+        tree.syntax()
+            .descendants()
+            .filter_map(ast::MethodCallExpr::cast)
+            .find(|call| {
+                call.name_ref()
+                    .is_some_and(|name| name.text() == "is_empty")
+            })
+            .unwrap()
+    };
+    assert!(
+        call.name_ref()
+            .is_some_and(|name| name.text() == "is_empty")
+    );
+    assert!(call.generic_arg_list().is_none());
+    let expression = call.syntax().text().to_string();
+    let range = call.syntax().text_range();
+    assert_eq!(
+        &source[u32::from(range.start()) as usize..u32::from(range.end()) as usize],
+        expression
+    );
+    expression
+}
