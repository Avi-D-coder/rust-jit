+#[test]
+fn unchanged_crlf_string_entire_main_including_source_contains_completes_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = start_complete_crlf(edition, 100_000);
+        let contexts = macros.contexts().unwrap();
+        let report = match run.poll_with_runtime_macros(&mut db, &contexts) {
+            RunPoll::Completed(report) => report,
+            RunPoll::Fault(error) => panic!("original CRLF main/{edition}: {error}"),
+            RunPoll::NeedInput(input) => panic!("original CRLF main/{edition}: {input:?}"),
+            RunPoll::Panicked(report) => panic!("original CRLF main/{edition}: {report:?}"),
+        };
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(report.live_edition, edition);
+        assert_eq!(report.opcode_counters.started_by_opcode[26], 5);
+        assert_eq!(report.opcode_counters.started_by_opcode[46], 1);
+        assert_eq!(report.opcode_counters.started_by_opcode[48], 1);
+        assert_eq!(
+            report.opcode_counters.operations_started,
+            report.opcode_counters.operations_completed
+        );
+        assert!(run.calls.is_empty() && run.pending.is_empty());
+        assert!(run.frame.active_scopes().is_empty());
+        db.finish_run().unwrap();
+    }
+}
+#[test]
+fn original_contains_argument_result_and_resumed_cancel_refuse_without_publication() {
+    for mode in 0..4 {
+        let (mut db, mut run, macros, _) = start_complete_crlf(2024, 100_000);
+        let contexts = macros.contexts().unwrap();
+        let (id, _, destination) = reach_string_method(&mut db, &mut run, &contexts, 48);
+        let pattern = run
+            .installed
+            .get(id)
+            .unwrap()
+            .recipe()
+            .operations
+            .iter()
+            .find_map(|op| {
+                if let Op::StrContains { pattern, .. } = op {
+                    Some(*pattern)
+                } else {
+                    None
+                }
+            })
+            .unwrap();
+        if mode == 3 {
+            let used = run.frame.fuel_snapshot().used;
+            db.finish_run().unwrap();
+            let (mut db, mut run, macros, _) = start_complete_crlf(2024, used);
+            let contexts = macros.contexts().unwrap();
+            let (id, _, _) = reach_string_method(&mut db, &mut run, &contexts, 48);
+            let before = effects(&run);
+            let error = step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap(),
+            )
+            .unwrap_err();
+            assert_eq!(error.code, "LRR-E-RUNTIME-RESOURCE");
+            assert_eq!(effects(&run), before);
+            assert_eq!(run.frame.counters().started_by_opcode[48], 0);
+            db.finish_run().unwrap();
+            continue;
+        }
+        if mode == 0 {
+            run.frame
+                .set_source_view(
+                    pattern,
+                    Some(TyTerm::Ref(RegionTerm::Static, true, Box::new(TyTerm::Str))),
+                )
+                .unwrap();
+            assert!(
+                run.revalidate_primitive_method(&mut db, &contexts, id)
+                    .is_err()
+            );
+        } else if mode == 1 {
+            // A strict result contract is an authority guard. Soft primitive
+            // argument expectations are checked later at their call boundary.
+            run.frame
+                .declared_hint(destination, Some(crate::runtime::shape::TypeId(2)))
+                .unwrap();
+            run.frame
+                .set_source_view(destination, Some(TyTerm::Primitive(PrimitiveType::Usize)))
+                .unwrap();
+        } else {
+            assert!(matches!(
+                step::step(
+                    &mut run.frame,
+                    &mut run.store,
+                    run.installed.get(id).unwrap()
+                )
+                .unwrap(),
+                StepOutcome::Dispatch
+            ));
+            assert!(run.frame.has_string_search_activation());
+            assert!(matches!(
+                run.store
+                    .state(run.frame.cell(destination).unwrap())
+                    .unwrap(),
+                crate::runtime::cell::CellState::Uninit
+            ));
+            assert_eq!(run.frame.counters().started_by_opcode[48], 1);
+            run.frame.fuel.cancellation().cancel();
+        }
+        let before = effects(&run);
+        let error = step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap(),
+        )
+        .unwrap_err();
+        assert_eq!(
+            error.code,
+            match mode {
+                0 => "LRR-E-INTERNAL-IR",
+                1 => "LRR-E-GENERIC-BINDING",
+                _ => "LRR-E-RUNTIME-RESOURCE",
+            }
+        );
+        assert_eq!(effects(&run), before);
+        assert_eq!(
+            run.frame.counters().started_by_opcode[48],
+            u64::from(mode == 2)
+        );
+        let terminal = effects(&run);
+        assert!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .is_err()
+        );
+        assert_eq!(effects(&run), terminal);
+        db.finish_run().unwrap();
+    }
+}
