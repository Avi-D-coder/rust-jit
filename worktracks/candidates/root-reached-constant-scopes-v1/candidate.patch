+#[test]
+fn unchanged_constant_ranges_complete_through_reached_scopes_all_editions() {
+    for (case, expected) in [
+        ("tests/ui/match/match-range-char-const.rs", include_bytes!(
+            "../../../../fixtures/upstream/rustc-checkout/tests/ui/match/match-range-char-const.rs"
+        ).as_slice()),
+        ("tests/ui/parser/issues/issue-21475.rs", include_bytes!(
+            "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/issues/issue-21475.rs"
+        ).as_slice()),
+    ] {
+        let path = fixtures().join(case);
+        assert_eq!(std::fs::read(&path).unwrap(), expected);
+        for edition in [2015, 2018, 2021, 2024] {
+            let outcome = standalone_edition_with_capture(&path, None, edition, true, None).unwrap();
+            let StandaloneOutcome::Captured(packet) = outcome else { panic!("capture route missing") };
+            let json = serde_json::to_value(&packet).unwrap();
+            assert_eq!(packet.exit_code(), 0, "{case}/{edition}: {json}");
+            assert!(packet.guest_complete(), "{case}/{edition}: {json}");
+            assert_eq!(packet.guest_stdout(), Some(&[][..]));
+            assert_eq!(packet.guest_stderr(), Some(&[][..]));
+            assert_eq!(json["terminal"]["value"]["kind"], "unit");
+            assert_eq!(json["snapshot"]["owning_edition"], edition);
+            assert!(json["capture"]["facts"]["vm_dispatches"].as_u64().unwrap() > 0);
+            let content = serde_json::to_value(Digest::of_bytes(expected)).unwrap();
+            assert!(json["snapshot"]["files"].as_array().unwrap().iter().any(|file| file["content"] == content));
+        }
+        assert_eq!(std::fs::read(&path).unwrap(), expected);
+    }
+}
