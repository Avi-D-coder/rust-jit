+//! Reached original-module metadata discovery in the existing captured world.
+//! No query provider, native execution or implicit procedural-macro authority.
+use crate::{
+    core::{diagnostic::Diagnostic, digest::StableEncode},
+    db::{
+        dependency::{InputKey, InputValue},
+        memo::Database,
+        poll::InputRequest,
+        seals::{SealDomain, SealKey},
+    },
+    expand::source_discovery::SourceDiscovery,
+    source::{changes::PreparedSourceView, manifest::Namespace, snapshot::Snapshot},
+};
+use std::{collections::BTreeSet, sync::Arc};
+fn invalid(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-CATALOG-INCOMPLETE", message.into())
+}
+pub(super) struct ReachedScopes {
+    parent: SealKey,
+    sources: Vec<PreparedSourceView>,
+    fulfilled: BTreeSet<SealKey>,
+}
+impl ReachedScopes {
+    pub(super) fn from_discovery(discovery: &SourceDiscovery) -> Result<Self, Diagnostic> {
+        let sources = discovery.completed_test_sources()?;
+        let bytes = sources.iter().try_fold(0usize, |bytes, source| {
+            bytes.checked_add(source.selection().metadata_bytes().ok()?)
+        });
+        if sources.len() > 100_000 || bytes.is_none_or(|bytes| bytes > 32 << 20) {
+            return Err(crate::runtime::arena::resource());
+        }
+        Ok(Self {
+            parent: discovery.key().clone(),
+            sources,
+            fulfilled: BTreeSet::new(),
+        })
+    }
+    pub(super) fn fulfill(
+        &mut self,
+        request: &InputRequest,
+        db: &mut Database,
+        compiler: &super::compile_inputs::PreparedCompileInputs,
+        snapshot: &mut Arc<Snapshot>,
+    ) -> Result<bool, Diagnostic> {
+        let InputRequest::Discover { key } = request else {
+            return Ok(false);
+        };
+        key.validate()?;
+        if key.unit_graph != self.parent.unit_graph
+            || key.epoch != self.parent.epoch
+            || !matches!(db.published_input(&InputKey::ExpansionEpoch),
+                Some((InputValue::ExpansionEpoch(epoch), _)) if *epoch == key.epoch)
+        {
+            return Err(invalid(
+                "reached scope request belongs to another world or epoch",
+            ));
+        }
+        let SealDomain::Scope { id, namespace } = &key.domain else {
+            return Ok(false);
+        };
+        if !matches!(namespace, Namespace::Value | Namespace::Type) {
+            return Ok(false);
+        }
+        let mut scopes = self
+            .sources
+            .iter()
+            .flat_map(|source| source.outline().scopes.keys())
+            .filter(|scope| scope.fingerprint() == *id);
+        let Some(scope) = scopes.next().cloned() else {
+            return Err(invalid(
+                "reached scope is absent from captured source membership",
+            ));
+        };
+        if scope.owner.is_some() || scopes.any(|other| other != &scope) {
+            return Err(invalid("reached module scope is lexical or ambiguous"));
+        }
+        if self.fulfilled.len() >= 256 || !self.fulfilled.insert(key.clone()) {
+            return Err(invalid("reached scope demand made no bounded progress"));
+        }
+        let mut discovery = SourceDiscovery::new(
+            self.sources.iter().map(PreparedSourceView::share).collect(),
+            scope,
+            *namespace,
+            key.unit_graph,
+            key.epoch,
+        )?
+        .with_declarative_compiler(
+            compiler.environment_identity(),
+            crate::expand::source_declarative::engine_version(),
+            compiler.catalog.clone(),
+        )?;
+        if discovery.key() != key {
+            return Err(invalid(
+                "reached discovery key differs from its exact request",
+            ));
+        }
+        compiler.discover_diagnostic(&mut discovery, db, snapshot)?;
+        discovery.publish(db)?;
+        if !matches!(db.published_input(&InputKey::DiscoverySeal(key.clone())),
+            Some((InputValue::DiscoverySeal(input), _)) if input.seal.key() == key)
+        {
+            return Err(invalid(
+                "reached scope discovery did not publish its requested seal",
+            ));
+        }
+        Ok(true)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn reached_scope_requests_refuse_foreign_world_epoch_scope_and_duplicate_progress() {
+        let path = std::path::Path::new(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/../../fixtures/upstream/rustc-checkout/tests/ui/match/match-range-char-const.rs"
+        ));
+        let (prepared, view, sources, mut snapshot) =
+            super::super::capture_standalone_edition(path, false, 2015).unwrap();
+        let (compiler, prepared, view, sources) =
+            super::super::compile_inputs::PreparedCompileInputs::prepare(
+                path, prepared, view, sources,
+            )
+            .unwrap();
+        let mut db = Database::default();
+        prepared.publish(&mut db).unwrap();
+        db.begin_expansion_epoch(1).unwrap();
+        let mut discovery = SourceDiscovery::new(
+            sources,
+            view.outline().root_scope.clone(),
+            Namespace::Value,
+            view.selection().outline.crate_key,
+            1,
+        )
+        .unwrap()
+        .with_declarative_compiler(
+            compiler.environment_identity(),
+            crate::expand::source_declarative::engine_version(),
+            compiler.catalog.clone(),
+        )
+        .unwrap();
+        compiler
+            .discover_diagnostic(&mut discovery, &mut db, &mut snapshot)
+            .unwrap();
+        discovery.publish(&mut db).unwrap();
+        let mut service = ReachedScopes::from_discovery(&discovery).unwrap();
+        let mut expected = discovery.key().clone();
+        expected.domain = SealDomain::Scope {
+            id: view.outline().root_scope.fingerprint(),
+            namespace: Namespace::Type,
+        };
+        let revision = db.revision();
+        for bad in [0, 1, 2] {
+            let mut key = expected.clone();
+            match bad {
+                0 => {
+                    key.unit_graph =
+                        crate::core::digest::Digest::of_bytes(b"another captured world")
+                }
+                1 => key.epoch += 1,
+                _ => {
+                    key.domain = SealDomain::Scope {
+                        id: crate::core::digest::Digest::of_bytes(b"unknown scope"),
+                        namespace: Namespace::Type,
+                    }
+                }
+            }
+            assert!(
+                service
+                    .fulfill(
+                        &InputRequest::Discover { key },
+                        &mut db,
+                        &compiler,
+                        &mut snapshot
+                    )
+                    .is_err()
+            );
+            assert_eq!(db.revision(), revision, "rejected request must not publish");
+        }
+        assert!(
+            !service
+                .fulfill(
+                    &InputRequest::CaptureCompileEnvironment {
+                        unit: expected.unit_graph
+                    },
+                    &mut db,
+                    &compiler,
+                    &mut snapshot
+                )
+                .unwrap()
+        );
+        assert_eq!(db.revision(), revision);
+        assert!(
+            service
+                .fulfill(
+                    &InputRequest::Discover {
+                        key: expected.clone()
+                    },
+                    &mut db,
+                    &compiler,
+                    &mut snapshot
+                )
+                .unwrap()
+        );
+        let sealed = db.revision();
+        assert!(
+            service
+                .fulfill(
+                    &InputRequest::Discover { key: expected },
+                    &mut db,
+                    &compiler,
+                    &mut snapshot
+                )
+                .is_err()
+        );
+        assert_eq!(
+            db.revision(),
+            sealed,
+            "duplicate request cannot repeat discovery"
+        );
+    }
+}
