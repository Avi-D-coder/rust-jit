+fn unchanged_upstream_newline_byte_tokens_keep_values_warnings_and_original_offsets_all_editions() {
+    // Component coverage only: these complete unchanged originals also require
+    // macro equality, ordinary strings, methods and include_str runtime support.
+    let cases: [(&str, &[&[u8]]); 3] = [
+        (
+            include_str!(
+                "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/crlf-in-byte-string-literal.rs"
+            ),
+            &[b"", b"", b"\n", b"\n"],
+        ),
+        (
+            include_str!(
+                "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/lexer-crlf-line-endings-string-literal-doc-comment.rs"
+            ),
+            &[b"byte string\nliteral"],
+        ),
+        (
+            include_str!("../../../../fixtures/upstream/rustc-checkout/tests/ui/str/str-escape.rs"),
+            &[b"a\x0cb", b"a\x0cb"],
+        ),
+    ];
+    assert!(cases[0].0.contains("\r\n") && cases[1].0.contains("\r\n"));
+    for (original, expected) in cases {
+        for edition in [2015, 2018, 2021, 2024] {
+            let parsed = ParsedFile::parse(
+                &SourceBlob::new(original.as_bytes().to_vec()).unwrap(),
+                ProfileIdentity {
+                    edition,
+                    ..ProfileIdentity::current()
+                },
+            )
+            .unwrap();
+            let outline = parsed
+                .outline(
+                    Digest::of_bytes(b"unchanged CRLF byte originals"),
+                    vec![],
+                    &CfgSet::guest_default(),
+                )
+                .unwrap();
+            let body = outline
+                .items
+                .iter()
+                .find(|item| item.def_key.declared_name == "main")
+                .unwrap()
+                .body
+                .as_ref()
+                .unwrap();
+            let tokens = parsed
+                .entered_body_root(body)
+                .unwrap()
+                .descendants_with_tokens()
+                .filter_map(|element| element.into_token())
+                .filter(|token| token.kind() == SyntaxKind::BYTE_STRING)
+                .collect::<Vec<_>>();
+            assert_eq!(tokens.len(), expected.len());
+            for (token, expected) in tokens.iter().zip(expected) {
+                let range = token.text_range();
+                let span = BodySpan {
+                    body_key: body.key(),
+                    relative_start: u32::from(range.start()) - body.range.start,
+                    relative_end: u32::from(range.end()) - body.range.start,
+                };
+                let spelling =
+                    &original[u32::from(range.start()) as usize..u32::from(range.end()) as usize];
+                assert_eq!(spelling, token.text());
+                // Use the actual pinned token even inside an unexpanded macro.
+                let byte_token = ast::ByteString::cast(token.clone()).unwrap();
+                let decoded = decode_token(&byte_token, &span).unwrap();
+                assert_eq!(decoded.bytes(), *expected);
+                assert_eq!(decoded.0.spelling, spelling);
+                decoded.require(spelling, &span).unwrap();
+                if spelling.contains("\r\n") {
+                    assert!(
+                        decoded
+                            .require(&spelling.replace("\r\n", "\n"), &span)
+                            .is_err()
+                    );
+                }
+            }
+        }
+    }
+}
