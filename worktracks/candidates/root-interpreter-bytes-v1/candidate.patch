+//! Ordinary exact-source byte-string admission. No descriptor -> source recovery.
+use super::*;
+use crate::{
+    ir::pc::SlotId,
+    runtime::{
+        cell::byte_literals::PreparedStaticBytes,
+        shape::{ByteLiteralTarget, TypeKey},
+    },
+    syntax::body_index::{ExpressionKind, NodeRole},
+    traits::term::{ConstTerm, RegionTerm, TyTerm},
+};
+pub(super) fn source(plan: &PreparedStaticBytes) -> Result<TyTerm, Diagnostic> {
+    let element = Box::new(TyTerm::Primitive(PrimitiveType::U8));
+    let target = match plan.target() {
+        ByteLiteralTarget::Slice => TyTerm::Slice(element),
+        ByteLiteralTarget::Array => TyTerm::Array(
+            element,
+            ConstTerm::Value(
+                u64::try_from(plan.len())
+                    .map_err(|_| invalid("byte-string source length overflow"))?,
+            ),
+        ),
+    };
+    Ok(TyTerm::Ref(RegionTerm::Static, false, Box::new(target)))
+}
+pub(super) fn prepare(
+    frame: &Frame,
+    store: &GuestStore,
+    literal: &LiteralRecipe,
+    destination: SlotId,
+    hint: Option<TypeId>,
+) -> Result<PreparedStaticBytes, Diagnostic> {
+    let Some(DecodedLiteral::ByteString(payload)) = &literal.decoded else {
+        return Err(invalid("byte-string pinned payload absent"));
+    };
+    payload.require(&literal.spelling, &literal.source)?;
+    let node = frame
+        .body
+        .nodes()
+        .get(frame.pc().node as usize)
+        .ok_or_else(|| invalid("byte-string indexed node absent"))?;
+    if node.role != NodeRole::Expression(ExpressionKind::Literal)
+        || frame.pc().phase != 0
+        || node.value != Some(destination)
+        || frame.body.span(node.id)? != literal.source
+    {
+        return Err(invalid(
+            "byte-string requires its exact ordinary literal entry",
+        ));
+    }
+    // An actual source context selects slice coercion. A runtime Ref type alone
+    // may constrain the result but cannot select/coerce its source identity.
+    let context = frame.source_view_ref(destination)?;
+    let view = match context {
+        None => ByteLiteralTarget::Array,
+        Some(TyTerm::Ref(RegionTerm::Static, false, target)) => match target.as_ref() {
+            TyTerm::Slice(element) if **element == TyTerm::Primitive(PrimitiveType::U8) => {
+                ByteLiteralTarget::Slice
+            }
+            TyTerm::Array(element, ConstTerm::Value(len))
+                if **element == TyTerm::Primitive(PrimitiveType::U8)
+                    && usize::try_from(*len).ok() == Some(payload.bytes().len()) =>
+            {
+                ByteLiteralTarget::Array
+            }
+            _ => {
+                return Err(invalid(
+                    "byte-string context has a different source pointee",
+                ));
+            }
+        },
+        Some(_) => {
+            return Err(invalid(
+                "byte-string cannot overwrite rigid, nominal, or nonstatic source context",
+            ));
+        }
+    };
+    // The normal write may require a new value cell. Preflight_write_type below
+    // rejects a live or mismatched destination before any ticket/root allocation.
+    let needs_cell = frame.literal_destination_needs_cell(destination)?;
+    let mut identity = crate::core::digest::StableEncoder::new("lrr/v1/static-byte-literal-site");
+    identity.record(frame.body.body());
+    identity.record(frame.body.profile());
+    identity.digest(frame.body.cfg().fingerprint());
+    identity.u32(literal.source.relative_start);
+    identity.u32(literal.source.relative_end);
+    let plan =
+        store.prepare_static_bytes(identity.finish(), payload.bytes(), view, hint, needs_cell)?;
+    let actual = source(&plan)?;
+    frame.preflight_source_view(destination, Some(&actual))?;
+    frame.preflight_literal(destination, Some(plan.reference_type()), hint, store)?;
+    Ok(plan)
+}
+pub(super) fn find_hint(len: Option<u32>, store: &GuestStore) -> Option<TypeId> {
+    let target = match len {
+        Some(len) => store.find_type(&TypeKey::Array {
+            element: TypeId(9),
+            len,
+        })?,
+        None => store.find_type(&TypeKey::Slice { element: TypeId(9) })?,
+    };
+    store.find_type(&TypeKey::Ref {
+        mutable: false,
+        target,
+    })
+}
+pub(super) fn prepare_hint(
+    store: &GuestStore,
+    op: &Op,
+) -> Result<Option<crate::runtime::cell::byte_literals::PreparedStaticByteHint>, Diagnostic> {
+    let hint = match op {
+        Op::SetHint { hint, .. } | Op::DeclareLocal { hint, .. } | Op::BindLocal { hint, .. } => {
+            hint
+        }
+        _ => return Ok(None),
+    };
+    let HintRecipe::StaticByteReference(context) = hint else {
+        return Ok(None);
+    };
+    store.prepare_static_byte_hint(context.len()).map(Some)
+}
+pub(super) fn materialize_hint(
+    len: Option<u32>,
+    store: &mut GuestStore,
+    plan: Option<&crate::runtime::cell::byte_literals::PreparedStaticByteHint>,
+) -> Result<TypeId, Diagnostic> {
+    let plan = plan.ok_or_else(|| invalid("static byte hint bypassed immutable admission"))?;
+    if plan.len() != len {
+        return Err(invalid("static byte hint batch belongs to another context"));
+    }
+    store.commit_static_byte_hint(plan)
+}
