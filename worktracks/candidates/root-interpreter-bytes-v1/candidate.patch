+/// No Clone, serialization or raw-owner constructor. Drop is not cancellation:
+/// the reached driver must abort/drain this exact cursor before terminal return.
+pub(crate) struct StaticByteChunkActivation {
+    plan: PreparedStaticBytes,
+    fields: Vec<CellId>,
+    initialized: Option<InitializedFields>,
+    allocation: Option<StaticLiteralId>,
+    object: Option<ObjectId>,
+    root: Option<CellId>,
+    reference: Option<RefId>,
+    ticket: Option<TicketId>,
+    next: usize,
+    charged: u64,
+    ready: bool,
+    failure: Option<Diagnostic>,
+    finished: bool,
+    metadata: usize,
+    heap: usize,
+}
+pub(crate) enum StaticByteChunkPoll {
+    Dispatch {
+        steps: u16,
+        bytes: u32,
+        cleaning: bool,
+    },
+    Ready,
+    Failed(Diagnostic),
+}
+impl StaticByteChunkActivation {
+    pub(crate) fn reference_type(&self) -> TypeId {
+        self.plan.reference_type()
+    }
+    pub(crate) fn target(&self) -> ByteLiteralTarget {
+        self.plan.target()
+    }
+    pub(crate) fn len(&self) -> usize {
+        self.plan.len()
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.metadata
+    }
+    pub(crate) fn fields_charged(&self) -> u64 {
+        self.charged
+    }
+    pub(crate) fn cleaning(&self) -> bool {
+        self.failure.is_some()
+    }
+    pub(crate) fn finished(&self) -> bool {
+        self.finished
+    }
