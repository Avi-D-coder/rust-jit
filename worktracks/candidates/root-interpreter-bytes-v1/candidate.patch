+                    self.cells
+                        .allocate(
+                            Cell {
+                                state: CellState::Uninit,
+                                declared: StorageContract::Exact(a.plan.types.array),
+                                writable: false,
+                                location_epoch: 1,
+                                owner: CellOwner::StaticLiteral(
+                                    a.allocation.ok_or_else(ownership)?,
