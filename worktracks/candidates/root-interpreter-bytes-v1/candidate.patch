+//! Current original local U8 byte-string annotation admission. Read-only: never
+//! discovers, expands, fetches guest thunks, evaluates constants, or grants layout.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{DependencyStamp, InputValue},
+        memo::{Database, NamespaceWitness},
+    },
+    frontend::{
+        names::{NameLookup, NameNamespaces},
+        source_locals::OrdinaryNameSite,
+    },
+    ir::{op::Op, pc::PcKey},
+    source::{changes::PreparedSourceView, manifest::Namespace},
+    syntax::{
+        body_index::BodyIndex,
+        byte_string_literals::StaticByteContext,
+        outline::BodyHandle,
+        parse::{ParseKey, ParsedFile},
+    },
+};
+use std::{collections::BTreeMap, sync::Arc};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-BYTE-STRING-CONTEXT", message.into())
+}
+fn charge(bytes: &mut usize, n: usize, limit: usize) -> Result<(), Diagnostic> {
+    *bytes = bytes
+        .checked_add(n)
+        .filter(|n| *n <= limit)
+        .ok_or_else(|| {
+            Diagnostic::new(
+                "LRR-E-METADATA-LIMIT",
+                "byte-string source admission metadata limit".into(),
+            )
+        })?;
+    Ok(())
+}
+/// No public constructor. A copied reference descriptor or syntax candidate is
+/// insufficient: this holds a current real Type/NoItem namespace witness.
+#[derive(Debug)]
+pub struct CurrentByteStringContext {
+    site: StaticByteContext,
+    parse: ParseKey,
+    index: Digest,
+    type_scope: Digest,
+    dependencies: Box<[DependencyStamp]>,
+    current: Arc<NamespaceWitness>,
+    bytes: usize,
+}
+impl PartialEq for CurrentByteStringContext {
+    fn eq(&self, other: &Self) -> bool {
+        self.site == other.site
+            && self.parse == other.parse
+            && self.index == other.index
+            && self.type_scope == other.type_scope
+            && self.dependencies == other.dependencies
+    }
+}
+impl Eq for CurrentByteStringContext {}
+impl CurrentByteStringContext {
+    pub(crate) fn capture_current(
+        db: &mut Database,
+        source: &PreparedSourceView,
+        index: &BodyIndex,
+        pc: &PcKey,
+        byte_limit: usize,
+    ) -> Result<Arc<Self>, Diagnostic> {
+        if byte_limit > 64 * 1024 * 1024 {
+            return Err(fault("byte-string admission limit exceeds contract"));
+        }
+        let mut bytes = std::mem::size_of::<Self>();
+        source.require_original_hygiene()?;
+        charge(&mut bytes, source.prepared_metadata_bytes()?, byte_limit)?;
+        let item = source
+            .outline()
+            .items
+            .iter()
+            .find(|item| {
+                item.body
+                    .as_ref()
+                    .is_some_and(|handle| handle.key() == pc.body)
+            })
+            .ok_or_else(|| fault("byte-string owning declaration/body missing"))?;
+        let handle = item
+            .body
+            .as_ref()
+            .ok_or_else(|| fault("byte-string body absent"))?;
+        let parsed = db
+            .prepared_parse(&source.selection().outline.parse)
+            .ok_or_else(|| fault("byte-string retained original parse missing"))?;
+        if index.profile() != &source.outline().profile
+            || index.cfg().fingerprint() != source.selection().outline.cfg
+        {
+            return Err(fault("byte-string owning profile/cfg differs"));
+        }
+        let site = parsed
+            .byte_string_context_site(handle, index, pc)?
+            .ok_or_else(|| fault("byte-string exact written annotation site missing"))?;
+        // This policy selector fails closed for custom/prelude-import policy;
+        // it grants no names. Actual Type absence comes only from the receipt.
+        if parsed
+            .binding_prelude_policy(source.captured_macro_cfg()?, &item.scope)?
+            .is_none()
+        {
+            return Err(fault(
+                "byte-string custom Type-prelude policy requires its producer",
+            ));
+        }
+        let certificate = db.lexical_scope_certificate(source.selection(), &item.scope)?;
+        let InputValue::DiscoverySeal(input) = certificate.as_ref() else {
+            return Err(fault("byte-string enclosing namespace variant differs"));
+        };
+        if !input.sources.contains(source.selection()) || input.seal.unresolved_frontiers() != 0 {
+            return Err(fault(
+                "byte-string actual completed source publication missing",
+            ));
+        }
+        let mut matching = input.type_scopes.iter().filter(|receipt| {
+            receipt.scope().scope == item.scope
+                && receipt.scope().edition == index.profile().edition
+        });
+        let receipt=matching.next().ok_or_else(||fault("byte-string current owning Type receipt missing; explicit source preparation required"))?;
+        if matching.next().is_some() {
+            return Err(fault("byte-string current owning Type receipt ambiguous"));
+        }
+        receipt.require_owner(&item.scope, index.profile())?;
+        receipt.require_current(db, input)?;
+        if receipt.scope().namespace != Namespace::Type || receipt.scope().names.contains_key("u8")
+        {
+            return Err(fault("byte-string written u8 has a source Type candidate"));
+        }
+        let type_scope = receipt.fingerprint();
+        let mut deps = BTreeMap::new();
+        // Track actual input rows through db.input; membership additions are
+        // separately retained/replayed by the immutable NamespaceWitness.
+        let namespace = db.lexical_namespace_stamps()?;
+        for (key, expected) in &namespace {
+            charge(
+                &mut bytes,
+                std::mem::size_of::<DependencyStamp>()
+                    .checked_add(128)
+                    .and_then(|n| n.checked_add(key.heap_bytes()))
+                    .ok_or_else(|| fault("byte-string dependency bytes overflow"))?,
+                byte_limit,
+            )?;
+            let value = db
+                .input(key)
+                .ok_or_else(|| fault("byte-string current input disappeared"))?;
+            if value.fingerprint() != *expected {
+                return Err(fault("byte-string input changed during capture"));
+            }
+            deps.insert(key.clone(), *expected);
+        }
+        if input.sources.len() > 256 {
+            return Err(fault("byte-string retained source universe limit"));
+        }
+        let mut views = Vec::new();
+        views
+            .try_reserve_exact(input.sources.len())
+            .map_err(|_| crate::runtime::arena::resource())?;
+        for selected in &input.sources {
+            let view = db
+                .prepared_source(selected)?
+                .ok_or_else(|| fault("byte-string retained source changed or expired"))?;
+            view.require_original_hygiene()?;
+            charge(&mut bytes, view.prepared_metadata_bytes()?, byte_limit)?;
+            for (key, value) in view.prepared_inputs() {
+                if !deps.contains_key(key) {
+                    charge(
+                        &mut bytes,
+                        std::mem::size_of::<DependencyStamp>()
+                            .checked_add(128)
+                            .and_then(|n| n.checked_add(key.heap_bytes()))
+                            .ok_or_else(|| fault("byte-string source dependency bytes overflow"))?,
+                        byte_limit,
+                    )?;
+                }
+                let actual = db
+                    .input(key)
+                    .ok_or_else(|| fault("byte-string prepared source input missing"))?;
+                if actual.fingerprint() != value.fingerprint() {
+                    return Err(fault("byte-string prepared source input changed"));
+                }
+                deps.insert(key.clone(), actual.fingerprint());
+            }
+            views.push(view);
+        }
+        // Type receipt already validates complete actual source membership. This
+        // pure original graph is only a lexical lookup helper, not absence proof.
+        charge(&mut bytes, 32 * 1024 * 1024, byte_limit)?;
+        let mut graph = NameNamespaces::from_outlines(
+            &views.iter().map(|view| view.outline()).collect::<Vec<_>>(),
+        )?;
+        let dependencies = source.source_dependencies()?;
+        for view in &views {
+            for (alias, unit) in dependencies
+                .aliases_for(
+                    view.selection().outline.crate_key,
+                    view.outline().profile.edition,
+                )?
+                .iter()
+            {
+                graph.dependency(
+                    view.selection().outline.crate_key,
+                    alias.as_str(),
+                    *unit,
+                    view.outline().profile.edition,
+                )?;
+            }
+        }
+        let imports = graph.resolve_imports()?;
+        if !imports.pending.is_empty()
+            || !imports.missing.is_empty()
+            || !imports.inaccessible.is_empty()
+            || !imports.ambiguous.is_empty()
+        {
+            return Err(fault(
+                "byte-string lexical import source preparation is incomplete",
+            ));
+        }
+        charge(
+            &mut bytes,
+            source
+                .captured_macro_blob()?
+                .bytes()
+                .len()
+                .checked_mul(128)
+                .ok_or_else(|| fault("byte-string entered source scratch overflow"))?,
+            byte_limit,
+        )?;
+        let published = source.replay_published_macro_index(input)?;
+        published.require_publication(source)?;
+        let mut entered = published.enter_body(source.selection(), &handle.key())?;
+        for (_, proof) in input
+            .runtime_no_item_proofs
+            .iter()
+            .filter(|(_, proof)| proof.body() == &handle.key())
+        {
+            let catalog=crate::frontend::runtime_macro_catalog::RuntimeMacroCatalog::standard_for_definition(index.profile(),proof.definition())?;
+            entered.accept_no_item_proof(source.selection(), &handle.key(), proof, &catalog)?;
+        }
+        let locals =
+            entered.local_index(source.selection(), &handle.key(), &BTreeMap::new(), &[])?;
+        let found = locals.lookup_ordinary(
+            OrdinaryNameSite {
+                source: source.selection(),
+                body: &handle.key(),
+                at: u64::from(site.type_at()),
+                name: "u8",
+                context: locals.context(),
+                namespace: Namespace::Type,
+            },
+            &graph,
+            None,
+        )?;
+        if found != NameLookup::Absent {
+            return Err(fault(
+                "byte-string lexical u8 candidate or unresolved producer requires preparation",
+            ));
+        }
+        let current = Arc::new(db.capture_namespace_witness()?);
+        charge(&mut bytes, current.metadata_bytes(), byte_limit)?;
+        charge(
+            &mut bytes,
+            parsed.key().profile.semantics.capacity(),
+            byte_limit,
+        )?;
+        let mut retained = std::mem::size_of::<Self>()
+            .checked_add(2 * std::mem::size_of::<usize>())
+            .and_then(|n| n.checked_add(parsed.key().profile.semantics.capacity()))
+            .and_then(|n| n.checked_add(current.metadata_bytes()))
+            .ok_or_else(|| fault("byte-string retained metadata overflow"))?;
+        for key in deps.keys() {
+            charge(
+                &mut retained,
+                std::mem::size_of::<DependencyStamp>()
+                    .checked_add(key.heap_bytes())
+                    .ok_or_else(|| fault("byte-string retained dependency overflow"))?,
+                byte_limit,
+            )?;
+        }
+        let mut retained_dependencies = Vec::new();
+        retained_dependencies
+            .try_reserve_exact(deps.len())
+            .map_err(|_| crate::runtime::arena::resource())?;
+        retained_dependencies.extend(
+            deps.into_iter()
+                .map(|(key, fingerprint)| DependencyStamp::Input { key, fingerprint }),
+        );
+        Ok(Arc::new(Self {
+            site,
+            parse: parsed.key(),
+            index: index.fingerprint(),
+            type_scope,
+            dependencies: retained_dependencies.into_boxed_slice(),
+            current,
+            bytes: retained,
+        }))
+    }
+    pub(crate) fn len(&self) -> Option<u32> {
+        self.site.len()
+    }
+    pub(crate) fn require_source(
+        &self,
+        parsed: &ParsedFile,
+        handle: &BodyHandle,
+        index: &BodyIndex,
+        key: &PcKey,
+    ) -> Result<(), Diagnostic> {
+        if parsed.key() != self.parse
+            || index.fingerprint() != self.index
+            || parsed
+                .byte_string_context_site(handle, index, key)?
+                .as_ref()
+                != Some(&self.site)
+        {
+            return Err(fault("byte-string admission source/body/phase changed"));
+        }
+        Ok(())
+    }
+    pub(crate) fn require(&self, body: &BodyIndex, key: &PcKey, op: &Op) -> Result<(), Diagnostic> {
+        if body.fingerprint() != self.index {
+            return Err(fault("byte-string immutable body index changed"));
+        }
+        self.site.require(body, key, op)
+    }
+    pub(crate) fn require_current(&self, db: &Database) -> Result<(), Diagnostic> {
+        self.current.require_current(db)?;
+        for dependency in &self.dependencies {
+            let DependencyStamp::Input { key, fingerprint } = dependency else {
+                return Err(fault("byte-string unexpected query dependency"));
+            };
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != *fingerprint)
+            {
+                return Err(fault("byte-string retained input changed"));
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn allocated_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn encode(&self, e: &mut StableEncoder) {
+        self.site.encode(e);
+        e.record(&self.parse);
+        e.digest(self.index);
+        e.digest(self.type_scope);
+        e.sequence(&self.dependencies, |e, dependency| e.record(dependency));
+    }
+}
