+//! Exact original RangePat endpoint sites. Syntax facts only, never name/type authority.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    ir::{
+        op::NumericBinary,
+        pc::{NodeId, PcKey, Phase, SlotId},
+    },
+    source::changes::{PreparedSourceView, SourceSelection},
+    syntax::{
+        ast_adapter::range,
+        body_index::{BodyIndex, ExpressionKind, NodeRole},
+        outline::BodyHandle,
+        parse::ParsedFile,
+        spans::{BodySpan, SourceRange},
+    },
+};
+use ra_ap_syntax::{
+    AstNode, SyntaxNode,
+    ast::{self, HasName, RangeItem, RangeOp},
+};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-CONST-RANGE-SOURCE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "range constant source site limit".into(),
+    )
+}
+fn relative(handle: &BodyHandle, node: &SyntaxNode) -> Result<SourceRange, Diagnostic> {
+    let r = range(node.text_range());
+    Ok(SourceRange {
+        start: r.start.checked_sub(handle.range.start).ok_or_else(limit)?,
+        end: r.end.checked_sub(handle.range.start).ok_or_else(limit)?,
+    })
+}
+fn exact(
+    index: &BodyIndex,
+    handle: &BodyHandle,
+    node: &SyntaxNode,
+    role: NodeRole,
+) -> Result<NodeId, Diagnostic> {
+    let r = relative(handle, node)?;
+    let mut rows = index
+        .nodes()
+        .iter()
+        .filter(|n| n.role == role && n.range == r);
+    let result = rows
+        .next()
+        .ok_or_else(|| fault("range constant structural owner absent"))?
+        .id;
+    if rows.next().is_some() {
+        return Err(fault("range constant structural owner ambiguous"));
+    }
+    Ok(result)
+}
+fn owning_body(node: &SyntaxNode, handle: &BodyHandle) -> bool {
+    node.ancestors()
+        .find_map(ast::Fn::cast)
+        .and_then(|f| f.body())
+        .is_some_and(|b| range(b.syntax().text_range()) == handle.range)
+}
+fn named_endpoint(pattern: &ast::Pat) -> bool {
+    match pattern {
+        ast::Pat::PathPat(path) => path.path().is_some(),
+        ast::Pat::IdentPat(path) => {
+            path.name().is_some()
+                && path.ref_token().is_none()
+                && path.mut_token().is_none()
+                && path.at_token().is_none()
+                && path.pat().is_none()
+        }
+        _ => false,
+    }
+}
+/// Path-pattern extension for the existing exact constant selector. No stand-alone
+/// identifier/variant pattern becomes a constant by spelling or module absence.
+pub(super) fn endpoint_pattern(
+    parsed: &ParsedFile,
+    handle: &BodyHandle,
+    selected: SourceRange,
+) -> Result<Option<ast::Pat>, Diagnostic> {
+    let root = parsed.entered_body_root(handle)?;
+    for (work, node) in root.descendants().enumerate() {
+        if work >= 100_000 {
+            return Err(limit());
+        }
+        let Some(path) = ast::Pat::cast(node) else {
+            continue;
+        };
+        if !named_endpoint(&path) {
+            continue;
+        }
+        if range(path.syntax().text_range()) != selected {
+            continue;
+        }
+        if !owning_body(path.syntax(), handle) {
+            return Err(fault("range path belongs to another function body"));
+        }
+        let Some(parent) = path.syntax().parent().and_then(ast::RangePat::cast) else {
+            return Ok(None);
+        };
+        if ![parent.start(), parent.end()]
+            .into_iter()
+            .flatten()
+            .any(|p| p.syntax() == path.syntax())
+        {
+            return Err(fault("range path is not an actual endpoint"));
+        }
+        return Ok(Some(path));
+    }
+    Ok(None)
+}
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct ScalarRangeConstantSite {
+    source: SourceSelection,
+    handle: BodyHandle,
+    index: Digest,
+    pc: PcKey,
+    span: BodySpan,
+    absolute: SourceRange,
+    owner: NodeId,
+    scrutinee: SlotId,
+    expected: SlotId,
+    test: SlotId,
+    upper: bool,
+    lower_present: bool,
+    upper_present: bool,
+    inclusive: bool,
+}
+impl ScalarRangeConstantSite {
+    pub(crate) fn require(&self, body: &BodyIndex, pc: &PcKey) -> Result<(), Diagnostic> {
+        if &self.pc != pc
+            || pc.body != self.handle.key()
+            || body.body() != &pc.body
+            || body.fingerprint() != self.index
+            || body.profile() != &self.source.outline.parse.profile
+            || body.cfg().fingerprint() != self.source.outline.cfg
+        {
+            return Err(fault("range constant current body/profile/site differs"));
+        }
+        let pattern = body
+            .nodes()
+            .get(pc.node as usize)
+            .ok_or_else(|| fault("range constant node absent"))?;
+        let owner = body
+            .nodes()
+            .get(self.owner.0 as usize)
+            .ok_or_else(|| fault("range constant match owner absent"))?;
+        if pattern.role != NodeRole::Pattern
+            || !pattern.scalar_range_phase
+            || owner.role != NodeRole::Expression(ExpressionKind::Match)
+            || owner.runtime_temporaries != [Some(self.expected), Some(self.test)]
+            || owner
+                .operands
+                .first()
+                .and_then(|n| body.nodes().get(n.0 as usize))
+                .and_then(|n| n.value)
+                != Some(self.scrutinee)
+            || self.span.body_key != pc.body
+            || self.span.relative_start >= self.span.relative_end
+            || self.span.relative_start < pattern.range.start
+            || self.span.relative_end > pattern.range.end
+            || self
+                .handle
+                .range
+                .start
+                .checked_add(self.span.relative_start)
+                != Some(self.absolute.start)
+            || self.handle.range.start.checked_add(self.span.relative_end)
+                != Some(self.absolute.end)
+            || (self.upper
+                && (!self.upper_present
+                    || pc.phase
+                        != if self.lower_present {
+                            Phase::Operand(0).code()?
+                        } else {
+                            Phase::Entry.code()?
+                        }))
