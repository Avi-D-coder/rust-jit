+        e.u32(self.owner.0);
+        e.u32(self.scrutinee.0);
+        e.u32(self.expected.0);
+        e.u32(self.test.0);
+        e.bool(self.upper);
+        e.bool(self.lower_present);
+        e.bool(self.upper_present);
