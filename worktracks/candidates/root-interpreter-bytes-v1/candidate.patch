+//! Header-only current original range-bound scalar context. Never enters a
+//! constant initializer, prepares a constant plan or requests an executable body.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{InputKey, InputValue},
+        memo::Database,
+        seals::SealKey,
+    },
+    frontend::constant_path_selection::{ConstantPathOutcome, ConstantPathSelection},
+    ir::op::PrimitiveType,
+    source::{
+        changes::{PreparedSourceView, SourceSelection},
+        manifest::ItemKind,
+    },
+    syntax::{outline::BodyHandle, range_bound_header::written_scalar, spans::SourceRange},
+};
+use std::collections::BTreeMap;
+
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-RANGE-BOUND-CONTEXT", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "range bound header context budget".into(),
+    )
+}
+
+/// Source evidence only: it neither evaluates the bound nor authorizes a range
+/// operator for that type. Every field and constructor is private to admission.
+#[derive(Debug)]
+pub(crate) struct CurrentRangeBoundContext {
+    selected: Digest,
+    caller: SourceSelection,
+    body: BodyHandle,
+    range: SourceRange,
+    target: SourceSelection,
+    definition: Digest,
+    header: Digest,
+    primitive: PrimitiveType,
+    type_parent: SealKey,
+    parent_fingerprint: Digest,
+    receipt: Digest,
+    dependencies: BTreeMap<InputKey, Digest>,
+    bytes: usize,
+    byte_limit: usize,
+}
+
+impl CurrentRangeBoundContext {
+    pub(crate) fn capture_current(
+        db: &Database,
+        selection: &ConstantPathSelection,
+        caller: &PreparedSourceView,
+        views: &[&PreparedSourceView],
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        if !(std::mem::size_of::<Self>() + 256..=MAX_BYTES).contains(&byte_limit)
+            || selection.metadata_bytes() > byte_limit
+        {
+            return Err(limit());
+        }
+        // This is the existing current path/member proof, including actual
+        // caller/target Value scopes, publication membership and retained views.
+        // Its structural capture never calls ConstantSourceAdmission or .constant.
+        selection.revalidate(db, caller, views)?;
+        let mut targets = views
+            .iter()
+            .copied()
+            .filter(|view| view.selection() == selection.target());
+        let target = targets
+            .next()
+            .ok_or_else(|| fault("selected bound source is not retained"))?;
+        if targets.next().is_some() {
+            return Err(fault("selected bound source is duplicated"));
+        }
+        target.require_original_hygiene()?;
+        target.require_declaration_syntax()?;
+        let definition = selection.definition();
+        let mut items = target
+            .outline()
+            .items
+            .iter()
+            .filter(|item| item.def_key.fingerprint() == definition);
+        let item = items
+            .next()
+            .ok_or_else(|| fault("selected bound declaration is absent"))?;
+        if items.next().is_some()
+            || item.def_key.item_kind != ItemKind::Constant
+            || item.scope.owner.is_some()
+            || item.body.as_ref() != Some(selection.body())
+            || item.scope != selection.context().scope
+            || item.declaration_span != selection.context().range
+            || item.header.profile != target.selection().outline.parse.profile
+        {
+            return Err(fault(
+                "bound requires its exact original direct constant declaration",
+            ));
+        }
+        if !matches!(db.published_input(&InputKey::DefinitionSource(definition)), Some((InputValue::DefinitionSource(parse), _)) if parse == &target.selection().outline.parse)
+            || !matches!(db.published_input(&InputKey::DefinitionHeader(definition)), Some((InputValue::DefinitionHeader(header), _)) if header == &item.header)
+            || !matches!(db.published_input(&InputKey::DefinitionBody(definition)), Some((InputValue::DefinitionBody(body), _)) if body == selection.body())
+            || !matches!(db.published_input(&InputKey::DeclarationContext(definition)), Some((InputValue::DeclarationContext(context), _)) if context == selection.context())
+        {
+            return Err(fault("bound current source/header/body/context differs"));
+        }
+        let (primitive, spelling) = written_scalar(&item.header, &item.def_key.declared_name)?;
+        let publication = db.source_view_scope_certificate(target.selection(), &item.scope)?;
+        let InputValue::DiscoverySeal(publication) = publication.as_ref() else {
+            return Err(fault("bound owning scope publication variant differs"));
+        };
+        let mut receipts = publication.type_scopes.iter().filter(|receipt| {
+            receipt.scope().scope == item.scope
+                && receipt.scope().edition == item.header.profile.edition
+        });
+        let receipt = receipts
+            .next()
+            .ok_or_else(|| fault("bound current owning Type namespace receipt prerequisite"))?;
+        if receipts.next().is_some() {
+            return Err(fault("bound owning Type receipt is ambiguous"));
+        }
+        receipt.require_owner(&item.scope, &item.header.profile)?;
+        receipt.require_current(db, publication)?;
+        if receipt.metadata_bytes()? > byte_limit {
+            return Err(limit());
+        }
+        // This is the real privately produced complete Type scope, checked
+        // above for exact owner/profile/currentness and unresolved frontiers.
+        // Any present entry (defined/ambiguous/denied/pending) forbids fallback.
+        if receipt.scope().namespace != crate::source::manifest::Namespace::Type
+            || receipt.scope().names.contains_key(spelling)
+        {
+            return Err(fault(
+                "bound written type selects a Type member; primitive fallback is not authorized",
+            ));
+        }
+        let caller_bytes = caller.selection().metadata_bytes()?;
+        let target_bytes = target.selection().metadata_bytes()?;
+        let mut bytes = std::mem::size_of::<Self>()
+            .checked_add(caller_bytes)
+            .and_then(|n| n.checked_add(target_bytes))
+            .and_then(|n| n.checked_add(std::mem::size_of::<BodyHandle>()))
+            .ok_or_else(limit)?;
+        if selection.dependencies().len() > Database::SOURCE_VIEW_INPUT_LIMIT {
+            return Err(limit());
+        }
+        for key in selection.dependencies().keys() {
+            bytes = bytes
+                .checked_add(std::mem::size_of::<(InputKey, Digest)>() + 128)
+                .and_then(|n| n.checked_add(key.heap_bytes()))
+                .filter(|n| *n <= byte_limit)
+                .ok_or_else(limit)?;
+        }
+        if bytes > byte_limit {
+            return Err(limit());
+        }
+        // Reservation/accounting precedes every retained allocating clone. The
+        // parent receipt itself stays in its actual immutable DB publication.
+        Ok(Self {
+            selected: selection.identity(),
+            caller: caller.selection().clone(),
+            body: selection.site().body().clone(),
+            range: selection.site().range(),
+            target: target.selection().clone(),
+            definition,
+            header: item.header.fingerprint(),
+            primitive,
+            type_parent: publication.seal.key(),
+            parent_fingerprint: publication.fingerprint(),
+            receipt: receipt.fingerprint(),
+            dependencies: selection.dependencies().clone(),
+            bytes,
+            byte_limit,
+        })
+    }
+    pub(crate) fn primitive(&self) -> PrimitiveType {
+        self.primitive
+    }
+    #[cfg(test)]
+    pub(crate) fn definition(&self) -> Digest {
+        self.definition
+    }
+    #[cfg(test)]
+    pub(crate) fn target(&self) -> &SourceSelection {
+        &self.target
+    }
+    pub(crate) fn dependencies(&self) -> &BTreeMap<InputKey, Digest> {
+        &self.dependencies
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn require_selection(
+        &self,
+        selected: &ConstantPathSelection,
+    ) -> Result<(), Diagnostic> {
+        if self.selected != selected.identity() {
+            return Err(fault(
+                "bound context belongs to another selected source member/site",
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        caller: &PreparedSourceView,
+        views: &[&PreparedSourceView],
+    ) -> Result<(), Diagnostic> {
+        if caller.selection() != &self.caller
+            || db.source_view_namespace_stamps()? != self.dependencies
+        {
+            return Err(fault(
+                "bound context caller/current input membership changed",
+            ));
+        }
+        let selection = match ConstantPathSelection::capture_current(
+            db,
+            caller,
+            &self.body,
+            self.range,
+            views,
+            self.byte_limit,
+        )? {
+            ConstantPathOutcome::Selected(selection) => selection,
+            other => return Err(other.prerequisite_error()),
+        };
+        let fresh = Self::capture_current(db, &selection, caller, views, self.byte_limit)?;
+        if self.identity() != fresh.identity() {
+            return Err(fault(
+                "bound context source/member/header/Type namespace changed",
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/current-range-bound-header-context");
+        e.digest(self.selected);
+        e.digest(self.caller.location_identity());
+        e.record(&self.caller.outline);
+        e.record(&self.body);
+        e.u32(self.range.start);
+        e.u32(self.range.end);
+        e.digest(self.target.location_identity());
+        e.record(&self.target.outline);
+        e.digest(self.definition);
+        e.digest(self.header);
+        e.u32(self.primitive.tag());
+        e.record(&self.type_parent);
+        e.digest(self.parent_fingerprint);
+        e.digest(self.receipt);
+        e.u64(self.dependencies.len() as u64);
+        for (key, fingerprint) in &self.dependencies {
+            e.record(key);
+            e.digest(*fingerprint);
+        }
+        e.finish()
+    }
+}
