+//! Source/authority controls only; neither VM execution nor full stock acceptance.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    db::key::{OutlineKey, QueryKey},
+    expand::{
+        source_declarative,
+        source_discovery::{SourceDiscovery, SourceDiscoveryStep},
+    },
+    frontend::compile_input_catalog::CompileInputCatalog,
+    source::{
+        changes::{PreparedSourceInputs, SourceSelectionOutcome, SourceUnitInput},
+        manifest::Namespace,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParseKey,
+};
+use std::sync::Arc;
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/issues/issue-21475.rs"
+);
+
+fn world(text: &str, edition: u16) -> (Database, PreparedSourceView) {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let path = SourcePath::new("tests/ui/parser/issues/issue-21475.rs").unwrap();
+    let cfg = CfgSet::guest_default();
+    let blob = SourceBlob::new(text.as_bytes().to_vec()).unwrap();
+    let owner = Digest::of_bytes(b"LRR header-only range bound source controls");
+    let selected = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: owner,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: owner,
+            module_path: vec![],
+            profile: profile.clone(),
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selected).unwrap() else {
+        panic!("actual original source absent")
+    };
+    let mut db = Database::default();
+    db.trace.detailed = true;
+    inputs.publish(&mut db).unwrap();
+    db.begin_expansion_epoch(1).unwrap();
+    for scope in view
+        .outline()
+        .scopes
+        .keys()
+        .filter(|scope| scope.owner.is_none())
+    {
+        let mut discovery = SourceDiscovery::new(
+            vec![view.share()],
+            scope.clone(),
+            Namespace::Value,
+            Digest::of_bytes(b"LRR header-only current bound world"),
+            1,
+        )
+        .unwrap()
+        .with_declarative_compiler(
+            Digest::of_bytes(b"LRR header-only current bound compiler"),
+            source_declarative::engine_version(),
+            Arc::new(CompileInputCatalog::standalone(&profile).unwrap()),
+        )
+        .unwrap();
+        match discovery.poll().unwrap() {
+            SourceDiscoveryStep::Sealed(_) => {}
+            SourceDiscoveryStep::Incomplete {
+                diagnostic,
+                blocked,
+            } => panic!("genuine source namespace incomplete: {diagnostic:?} {blocked:?}"),
+            _ => panic!(
+                "header-only source control unexpectedly needs expansion/attribute/procedural authority"
+            ),
+        }
+        discovery.publish(&mut db).unwrap();
+    }
+    (db, view)
+}
+fn selected(
+    db: &Database,
+    view: &PreparedSourceView,
+    text: &str,
+    needle: &str,
+    path_len: usize,
+) -> Box<ConstantPathSelection> {
+    let body = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let start = text.find(needle).unwrap();
+    let range = SourceRange::checked(
+        u32::try_from(start).unwrap(),
+        u32::try_from(start + path_len).unwrap(),
+    )
+    .unwrap();
+    let ConstantPathOutcome::Selected(selection) =
+        ConstantPathSelection::capture_current(db, view, body, range, &[view], MAX_BYTES).unwrap()
+    else {
+        panic!("actual current constant member was not selected")
+    };
+    selection
+}
+fn assert_no_initializer_demand(db: &Database) {
+    assert!(db.trace.events.iter().all(|event| !matches!(
+        &event.key,
+        QueryKey::Constant(_) | QueryKey::BodyStructure(_) | QueryKey::Thunk(_)
+    )));
+}
+
+#[test]
+fn unchanged_issue_21475_selected_header_proves_u32_without_entering_any_body_all_editions() {
+    // One unchanged whole original source is structurally prepared. These are
+    // source components under four LRR owners, not whole-main/configured passes.
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view) = world(ORIGINAL, edition);
+        let selection = selected(&db, &view, ORIGINAL, "m::START..=", 8);
+        let before = db.trace.events.len();
+        let context =
+            CurrentRangeBoundContext::capture_current(&db, &selection, &view, &[&view], MAX_BYTES)
+                .unwrap();
+        assert_eq!(context.primitive(), PrimitiveType::U32);
+        assert_eq!(context.definition(), selection.definition());
+        assert_eq!(context.target(), view.selection());
+        assert_eq!(context.target().outline.parse.profile.edition, edition);
+        assert!(context.metadata_bytes() <= MAX_BYTES);
+        assert!(
+            context
+                .dependencies()
+                .contains_key(&InputKey::DefinitionHeader(selection.definition()))
+        );
+        assert!(
+            context
+                .dependencies()
+                .contains_key(&InputKey::DiscoverySeal(context.type_parent.clone()))
+        );
+        context.require_selection(&selection).unwrap();
+        context.revalidate(&db, &view, &[&view]).unwrap();
+        assert_eq!(db.trace.events.len(), before);
+        assert_no_initializer_demand(&db);
+    }
+}
+
+#[test]
+fn macro_division_and_unrepresentable_initializer_literals_remain_cold() {
+    // LRR-specific demand control; deliberately not a compiler run-pass source.
+    // Success on an out-of-range literal also rules out eager magnitude decode.
+    let source = "const MAC:u32=missing_initializer!();const DIV:u32=1/0;const BIG:u32=340282366920938463463374607431768211456;fn main(){let _=MAC;let _=DIV;let _=BIG;}";
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view) = world(source, edition);
+        let before = db.trace.events.len();
+        for (needle, len) in [("=MAC;", 3), ("=DIV;", 3), ("=BIG;", 3)] {
+            let at = source.find(needle).unwrap() + 1;
+            let body = view
+                .outline()
+                .items
+                .iter()
+                .find(|item| item.def_key.declared_name == "main")
+                .unwrap()
+                .body
+                .as_ref()
+                .unwrap();
+            let range = SourceRange::checked(at as u32, (at + len) as u32).unwrap();
+            let ConstantPathOutcome::Selected(selection) = ConstantPathSelection::capture_current(
+                &db,
+                &view,
+                body,
+                range,
+                &[&view],
+                MAX_BYTES,
+            )
+            .unwrap() else {
+                panic!("actual cold constant path was not selected")
+            };
+            let context = CurrentRangeBoundContext::capture_current(
+                &db,
+                &selection,
+                &view,
