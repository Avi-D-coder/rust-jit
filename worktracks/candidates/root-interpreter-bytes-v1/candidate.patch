+/// Original local annotation certificate; copying a hint to another source site
+/// cannot attach primitive or static identity to a different local/value.
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct StaticByteContext {
+    body: crate::source::manifest::BodyKey,
+    declaration: crate::ir::pc::NodeId,
+    binding: crate::ir::pc::NodeId,
+    initializer: crate::ir::pc::SlotId,
+    len: Option<u32>,
+    type_at: u32,
+    profile: crate::core::digest::Digest,
+    cfg: crate::core::digest::Digest,
+}
+impl StaticByteContext {
+    pub(super) fn capture(
+        parsed: &super::parse::ParsedFile,
+        handle: &super::outline::BodyHandle,
+        index: &super::body_index::BodyIndex,
+        reference: &ast::RefType,
+        len: Option<u32>,
+    ) -> Result<Option<Self>, Diagnostic> {
+        if parsed.generated_origin.is_some() {
+            return Ok(None);
+        }
+        let Some(statement) = reference.syntax().ancestors().find_map(ast::LetStmt::cast) else {
+            return Ok(None);
+        };
+        let Some(initializer) = statement.initializer() else {
+            return Ok(None);
+        };
+        let Some(pattern) = statement.pat() else {
+            return Ok(None);
+        };
+        if !matches!(pattern, ast::Pat::IdentPat(_)) {
+            return Ok(None);
+        }
+        let find =
+            |syntax: &ra_ap_syntax::SyntaxNode| -> Result<crate::ir::pc::NodeId, Diagnostic> {
+                let range = syntax.text_range();
+                let start = u32::from(range.start()).checked_sub(handle.range.start);
+                let end = u32::from(range.end()).checked_sub(handle.range.start);
+                index
+                    .nodes()
+                    .iter()
+                    .find(|node| {
+                        Some(node.range.start) == start
+                            && Some(node.range.end) == end
+                            && if ast::Expr::can_cast(syntax.kind()) {
+                                matches!(node.role, super::body_index::NodeRole::Expression(_))
+                            } else if ast::Pat::can_cast(syntax.kind()) {
+                                node.role == super::body_index::NodeRole::Pattern
+                            } else {
+                                node.role == super::body_index::NodeRole::Statement
+                            }
+                    })
+                    .map(|node| node.id)
+                    .ok_or_else(|| {
+                        Diagnostic::new(
+                            "LRR-E-IR-VERIFY",
+                            "byte annotation owner not indexed".into(),
+                        )
+                    })
+            };
+        let initializer = index.nodes()[find(initializer.syntax())?.0 as usize]
+            .value
+            .ok_or_else(|| {
+                Diagnostic::new(
+                    "LRR-E-IR-VERIFY",
+                    "byte initializer has no value slot".into(),
+                )
+            })?;
+        Ok(Some(Self {
+            body: index.body().clone(),
+            declaration: find(statement.syntax())?,
+            binding: find(pattern.syntax())?,
+            initializer,
+            len,
+            type_at: u32::from(reference.syntax().text_range().start()),
+            profile: crate::core::digest::StableEncode::fingerprint(index.profile()),
+            cfg: index.cfg().fingerprint(),
+        }))
+    }
+    pub(crate) fn type_at(&self) -> u32 {
+        self.type_at
+    }
+    pub(crate) fn len(&self) -> Option<u32> {
+        self.len
+    }
+    pub(crate) fn require(
+        &self,
+        body: &super::body_index::BodyIndex,
+        key: &crate::ir::pc::PcKey,
+        op: &crate::ir::op::Op,
+    ) -> Result<(), Diagnostic> {
+        use crate::ir::{op::Op, pc::Phase};
+        if self.profile != crate::core::digest::StableEncode::fingerprint(body.profile())
+            || self.cfg != body.cfg().fingerprint()
+            || self.body != *body.body()
+            || key.body != self.body
+            || key.node != self.declaration.0
+        {
+            return Err(Diagnostic::new(
+                "LRR-E-IR-VERIFY",
+                "byte context source owner differs".into(),
+            ));
+        }
+        let good = match op {
+            Op::SetHint { child, .. } => {
+                key.phase == Phase::Entry.code()? && *child == self.initializer
+            }
+            Op::BindLocal {
+                binding, source, ..
+            } => {
+                key.phase == Phase::Commit.code()?
+                    && *binding == self.binding
+                    && *source == self.initializer
+            }
+            _ => false,
+        };
+        if !good {
+            return Err(Diagnostic::new(
+                "LRR-E-IR-VERIFY",
+                "byte context operation/phase/slots differ".into(),
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn encode(&self, e: &mut crate::core::digest::StableEncoder) {
+        e.record(&self.body);
+        e.u32(self.declaration.0);
+        e.u32(self.binding.0);
+        e.u32(self.initializer.0);
+        e.option(&self.len, |e, len| e.u32(*len));
+        e.u32(self.type_at);
+        e.digest(self.profile);
+        e.digest(self.cfg);
+    }
+}
