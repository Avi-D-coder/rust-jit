+impl ParsedFile {
+    pub(crate) fn scalar_range_constant_site(
+        &self,
+        source: &PreparedSourceView,
+        handle: &BodyHandle,
+        index: &BodyIndex,
+        pc: &PcKey,
+    ) -> Result<Option<ScalarRangeConstantSite>, Diagnostic> {
+        if !matches!(Phase::from_code(pc.phase), Phase::Entry | Phase::Operand(0)) {
+            return Ok(None);
+        }
+        let Some(node) = index.nodes().get(pc.node as usize) else {
+            return Err(fault("range constant PC node absent"));
+        };
+        if node.role != NodeRole::Pattern || !node.scalar_range_phase {
+            return Ok(None);
+        }
+        source.require_original_hygiene()?;
+        source.require_declaration_syntax()?;
+        if self.key() != source.selection().outline.parse
+            || index.body() != &handle.key()
+            || pc.body != handle.key()
+            || index.profile() != &self.profile
+            || index.cfg().fingerprint() != source.selection().outline.cfg
+        {
+            return Err(fault("range constant parser/source/index differs"));
+        }
+        source
+            .selection()
+            .metadata_bytes()?
+            .checked_add(std::mem::size_of::<ScalarRangeConstantSite>())
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(limit)?;
+        let root = self.entered_body_root(handle)?;
+        let mut selected = None;
+        for (work, syntax) in root.descendants().enumerate() {
+            if work >= 100_000 {
+                return Err(limit());
+            }
+            let Some(pattern) = ast::RangePat::cast(syntax) else {
+                continue;
+            };
+            if relative(handle, pattern.syntax())? == node.range {
+                if selected.is_some() {
+                    return Err(fault("range constant AST site ambiguous"));
+                }
+                selected = Some(pattern);
+            }
+        }
+        let pattern = selected.ok_or_else(|| fault("range constant actual RangePat absent"))?;
+        if !owning_body(pattern.syntax(), handle) {
+            return Err(fault("range constant belongs to another original body"));
+        }
+        if pattern
+            .syntax()
+            .children()
+            .any(|n| ast::Attr::can_cast(n.kind()))
+        {
+            return Err(fault(
+                "range constant attributes require source preparation",
+            ));
+        }
+        let inclusive = match pattern.op_kind() {
+            Some(RangeOp::Inclusive) => true,
+            Some(RangeOp::Exclusive) => false,
+            None => return Err(fault("range constant operator absent")),
+        };
+        let lower = pattern.start();
+        let upper = pattern.end();
+        if (lower.is_none() && upper.is_none()) || (inclusive && upper.is_none()) {
+            return Err(fault("range constant required endpoint absent"));
+        }
+        let is_upper = lower.is_none() || pc.phase == Phase::Operand(0).code()?;
+        if pc.phase == Phase::Operand(0).code()? && (lower.is_none() || upper.is_none()) {
+            return Err(fault("range constant unexpected upper continuation"));
+        }
+        let endpoint = if is_upper {
+            upper.as_ref()
+        } else {
+            lower.as_ref()
+        }
+        .ok_or_else(|| fault("range constant endpoint absent"))?;
+        if !named_endpoint(endpoint) {
+            return Ok(None);
+        }
+        let absolute = range(endpoint.syntax().text_range());
+        if endpoint_pattern(self, handle, absolute)?.is_none() {
+            return Err(fault("range constant endpoint path differs"));
+        }
+        let owner = pattern
+            .syntax()
+            .ancestors()
+            .find_map(ast::MatchExpr::cast)
+            .ok_or_else(|| fault("range constant match AST owner absent"))?;
+        let owner_id = exact(
+            index,
+            handle,
+            owner.syntax(),
+            NodeRole::Expression(ExpressionKind::Match),
+        )?;
+        let expression = owner
+            .expr()
+            .ok_or_else(|| fault("range constant match scrutinee absent"))?;
+        let expression_range = relative(handle, expression.syntax())?;
+        let match_node = &index.nodes()[owner_id.0 as usize];
+        let source_node = match_node
+            .operands
+            .first()
+            .and_then(|n| index.nodes().get(n.0 as usize))
+            .filter(|n| n.range == expression_range)
+            .ok_or_else(|| fault("range constant exact scrutinee operand differs"))?;
+        let [Some(expected), Some(test)] = match_node.runtime_temporaries else {
+            return Err(fault("range constant match temporary pair absent"));
+        };
+        let site = ScalarRangeConstantSite {
+            source: source.selection().clone(),
+            handle: handle.clone(),
+            index: index.fingerprint(),
+            pc: pc.clone(),
+            span: BodySpan {
+                body_key: pc.body.clone(),
+                relative_start: absolute
+                    .start
+                    .checked_sub(handle.range.start)
+                    .ok_or_else(limit)?,
+                relative_end: absolute
+                    .end
+                    .checked_sub(handle.range.start)
+                    .ok_or_else(limit)?,
+            },
+            absolute,
+            owner: owner_id,
+            scrutinee: source_node
+                .value
+                .ok_or_else(|| fault("range constant scrutinee value absent"))?,
+            expected,
+            test,
+            upper: is_upper,
+            lower_present: lower.is_some(),
+            upper_present: upper.is_some(),
+            inclusive,
+        };
+        site.require_source(source)?;
+        site.require(index, pc)?;
+        site.metadata_bytes()?;
+        Ok(Some(site))
+    }
