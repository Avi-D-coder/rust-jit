+//! A reached ordinary Literal owns its bounded immutable byte construction.
+//! Decoded payload sharing is agreement data, never a source/context producer.
+use super::*;
+use crate::{
+    ir::op::{DecodedLiteral, HintRecipe, LiteralKind, Op},
+    runtime::cell::byte_literals::{
+        PreparedStaticBytes, StaticByteChunkActivation, StaticByteChunkPoll,
+    },
+    syntax::byte_string_literals::ByteStringLiteral,
+    traits::term::TyTerm,
+};
+
+pub(super) struct BoundByteLiteral {
+    pc: PcKey,
+    operation_index: usize,
+    destination: SlotId,
+    scope: ScopeId,
+    cell: CellId,
+    cell_epoch: u32,
+    payload: ByteStringLiteral,
+    span: crate::syntax::spans::BodySpan,
+    hint: HintRecipe,
+    prior_source: Option<TyTerm>,
+    source: TyTerm,
+    physical: StaticByteChunkActivation,
+}
+impl Frame {
+    pub(crate) fn has_byte_literal_activation(&self) -> bool {
+        self.byte_activation.is_some()
+    }
+    pub(crate) fn byte_literal_operation_index(&self) -> Option<usize> {
+        self.byte_activation.as_ref().map(|a| a.operation_index)
+    }
+    pub(crate) fn byte_literal_cleaning(&self) -> bool {
+        self.byte_activation
+            .as_ref()
+            .is_some_and(|a| a.physical.cleaning())
+    }
+    /// Normal literal preflight and the single opcode charge already succeeded.
+    pub(crate) fn begin_byte_literal_op(
+        &mut self,
+        index: usize,
+        op: &Op,
+        plan: PreparedStaticBytes,
+        source: TyTerm,
+        store: &mut GuestStore,
+    ) -> Result<(), Diagnostic> {
+        self.require_store(store)?;
+        if self.status != FrameStatus::Running
+            || self.byte_activation.is_some()
+            || self.copy_activation.is_some()
+            || self.cleanup_activation.is_some()
+            || self.constant_activation.is_some()
+        {
+            return Err(invalid(
+                "byte literal construction overlaps another activation",
+            ));
+        }
+        let Op::Literal {
+            literal,
+            hint,
+            destination,
+        } = op
+        else {
+            return Err(invalid("byte literal construction requires Literal"));
+        };
+        let Some(DecodedLiteral::ByteString(payload)) = &literal.decoded else {
+            return Err(invalid("byte literal decoder certificate absent"));
+        };
+        if literal.kind != LiteralKind::ByteString
+            || plan.len() <= 256
+            || plan.len() != payload.bytes().len()
+        {
+            return Err(invalid("byte literal physical plan differs from source"));
+        }
+        self.preflight_source_view(*destination, Some(&source))?;
+        self.preflight_write_type(*destination, plan.reference_type(), store)?;
+        let prior_source = self.source_view_ref(*destination)?.cloned();
+        // Preparation reserves capacities only. A failed metadata/destination
+        // check cannot leave an unpublished guest owner detached from its frame.
+        let expected_target = plan.target();
+        let physical = store.prepare_static_byte_chunks(plan)?;
+        if physical.target() != expected_target {
+            return Err(invalid("byte physical target differs from admitted plan"));
+        }
+        Self::metadata_bytes(&self.body, self.parameter_metadata_count())
+            .and_then(|n| n.checked_add(self.constructor_mapping_bytes))
+            .and_then(|n| n.checked_add(self.projection_bytes))
+            .and_then(|n| n.checked_add(self.source_field_bytes()?))
+            .and_then(|n| n.checked_add(std::mem::size_of::<BoundByteLiteral>()))
+            .and_then(|n| n.checked_add(physical.metadata_bytes()))
+            .and_then(|n| n.checked_add(payload.allocated_bytes()?))
+            .and_then(|n| n.checked_add(source.heap_bytes()?))
+            .and_then(|n| n.checked_add(prior_source.as_ref().map_or(Some(0), TyTerm::heap_bytes)?))
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        let cell = self.prepare_write(*destination, store)?;
+        self.byte_activation = Some(BoundByteLiteral {
+            pc: self.pc.clone(),
+            operation_index: index,
+            destination: *destination,
+            scope: self.slot(*destination)?.scope,
+            cell,
+            cell_epoch: store.location_epoch(cell)?,
+            payload: payload.clone(),
+            span: literal.source.clone(),
+            hint: hint.clone(),
+            prior_source,
+            source,
+            physical,
+        });
+        Ok(())
+    }
+    pub(crate) fn check_byte_literal_activation(
+        &self,
+        index: usize,
+        op: &Op,
+        store: &GuestStore,
+    ) -> Result<(), Diagnostic> {
+        self.require_store(store)?;
+        let a = self
+            .byte_activation
+            .as_ref()
+            .ok_or_else(|| invalid("byte activation absent"))?;
+        let Op::Literal {
+            literal,
+            hint,
+            destination,
+        } = op
+        else {
+            return Err(invalid("byte activation resumed at a different opcode"));
+        };
+        let Some(DecodedLiteral::ByteString(payload)) = &literal.decoded else {
+            return Err(invalid("resumed byte literal decoder certificate absent"));
+        };
+        // O(1) comparison of the actual retained immutable decode. No new
+        // certificate, payload scan, decode or query is performed on Dispatch.
+        if self.status != FrameStatus::Running
+            || a.pc != self.pc
+            || a.operation_index != index
+            || a.destination != *destination
+            || literal.kind != LiteralKind::ByteString
+            || a.span != literal.source
+            || a.hint != *hint
+            || !a.payload.same_decoded_payload(payload)
+            || self.constant_activation.is_some()
+            || self.copy_activation.is_some()
+            || self.cleanup_activation.is_some()
+            || self.slot(*destination)?.cell != Some(a.cell)
+            || self.slot(*destination)?.scope != a.scope
+            || self.source_view_ref(*destination)? != a.prior_source.as_ref()
+            || store.location_epoch(a.cell)? != a.cell_epoch
+        {
+            return Err(invalid("byte activation source/op/storage binding changed"));
+        }
+        self.preflight_write_type(*destination, a.physical.reference_type(), store)?;
+        self.preflight_source_view(*destination, Some(&a.source))
+    }
+    pub(crate) fn advance_byte_literal_op(
+        &mut self,
+        index: usize,
+        op: &Op,
+        store: &mut GuestStore,
+    ) -> Result<bool, Diagnostic> {
+        self.check_byte_literal_activation(index, op, store)?;
+        let mut a = self
+            .byte_activation
+            .take()
+            .ok_or_else(|| invalid("byte activation disappeared"))?;
+        let poll = store.advance_static_byte_chunks(&mut a.physical, &mut self.fuel);
+        self.counters.fuel_used = self.fuel.snapshot().used;
+        match poll {
+            StaticByteChunkPoll::Dispatch {
+                steps,
+                bytes,
+                cleaning,
+            } => {
+                let valid = steps <= 256 && bytes <= 64 << 10 && cleaning == a.physical.cleaning();
+                self.byte_activation = Some(a);
+                if !valid {
+                    return Err(invalid("byte construction exceeded bounded dispatch"));
+                }
+                Ok(false)
+            }
+            StaticByteChunkPoll::Failed(error) => {
+                if !a.physical.finished() {
+                    self.byte_activation = Some(a);
+                }
+                Err(error)
+            }
+            StaticByteChunkPoll::Ready => {
+                // Reattach before fallible publication checks so engine error
+                // handling retains and drains the exact unfinished owner.
+                self.byte_activation = Some(a);
+                self.check_byte_literal_activation(index, op, store)?;
+                self.fuel.poll()?;
+                let a = self
+                    .byte_activation
+                    .as_ref()
+                    .ok_or_else(|| invalid("byte ready activation absent"))?;
+                if a.physical.fields_charged() != a.payload.bytes().len() as u64 {
+                    return Err(invalid(
+                        "byte construction omitted original element charges",
+                    ));
+                }
+                let mut a = self
+                    .byte_activation
+                    .take()
+                    .ok_or_else(|| invalid("byte ready activation disappeared"))?;
+                let ticket = match store.commit_static_byte_chunks(&mut a.physical) {
+                    Ok(ticket) => ticket,
+                    Err(error) => {
+                        self.byte_activation = Some(a);
+                        return Err(error);
+                    }
+                };
+                if let Err(error) = self.write(a.destination, ticket, store) {
+                    // A completed readonly run root may remain cached. The
+                    // failed destination must not leak its fresh transfer ticket.
+                    store.discard(ticket)?;
+                    return Err(error);
+                }
+                self.set_source_view(a.destination, Some(a.source))?;
+                Ok(true)
+            }
+        }
+    }
+    pub(crate) fn abort_byte_literal_op(
+        &mut self,
+        store: &mut GuestStore,
+        error: Diagnostic,
+    ) -> Result<(), Diagnostic> {
+        self.require_store(store)?;
+        let a = self
+            .byte_activation
+            .as_mut()
+            .ok_or_else(|| invalid("byte abort activation absent"))?;
+        store.abort_static_byte_chunks(&mut a.physical, error)
+    }
+    /// Rollback needs only the retained physical owner, not a current source view.
+    pub(crate) fn drain_byte_literal_op(
+        &mut self,
+        store: &mut GuestStore,
+    ) -> Result<bool, Diagnostic> {
+        self.require_store(store)?;
+        let mut a = self
+            .byte_activation
+            .take()
+            .ok_or_else(|| invalid("byte drain activation absent"))?;
+        if !a.physical.cleaning() {
+            self.byte_activation = Some(a);
+            return Err(invalid("byte drain requires a retained failure"));
+        }
+        match store.advance_static_byte_chunks(&mut a.physical, &mut self.fuel) {
+            StaticByteChunkPoll::Dispatch {
+                steps,
+                bytes,
+                cleaning,
+            } => {
+                self.byte_activation = Some(a);
+                if steps > 256 || bytes > 64 << 10 || !cleaning {
+                    return Err(invalid("byte rollback exceeded bounded dispatch"));
+                }
+                Ok(false)
+            }
+            StaticByteChunkPoll::Failed(error) => {
+                if !a.physical.finished() {
+                    self.byte_activation = Some(a);
+                }
+                Err(error)
+            }
+            StaticByteChunkPoll::Ready => {
+                self.byte_activation = Some(a);
+                Err(invalid("byte rollback attempted publication"))
+            }
+        }
+    }
+}
