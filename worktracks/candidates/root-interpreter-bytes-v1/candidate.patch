+//! Run-owned immutable byte arrays and genuine shared array/slice leases.
+//! This physical kernel grants no source namespace, Copy, or static-region proof.
+use super::super::shape::{ByteHintTypes, ByteLiteralTarget, ByteLiteralTypes};
+use super::*;
+const MAX_INLINE_BYTES: usize = 256;
+const MAX_STATIC_BYTES: usize = 1 << 20;
+#[path = "cell_byte_chunks.rs"]
+mod chunks;
+pub(crate) use chunks::{StaticByteChunkActivation, StaticByteChunkPoll};
+/// Private membership; neither a caller CellOwner nor a type ID can add roots.
+pub struct StaticLiteralRecord {
+    key: crate::core::digest::Digest,
+    root: Option<CellId>,
+    array_reference: Option<RefId>,
+    slice_reference: Option<RefId>,
+}
+pub(crate) struct PreparedStaticBytes {
+    session: StoreSession,
+    epoch: u32,
+    key: crate::core::digest::Digest,
+    types: ByteLiteralTypes,
+    bytes: Vec<u8>,
+    view: ByteLiteralTarget,
+    needs_cell: bool,
+    existing: Option<(StaticLiteralId, CellId, Option<RefId>)>,
+}
+impl PreparedStaticBytes {
+    pub(crate) fn reference_type(&self) -> TypeId {
+        self.types.reference
+    }
+    pub(crate) fn target(&self) -> ByteLiteralTarget {
+        self.view
+    }
+    pub(crate) fn len(&self) -> usize {
+        self.bytes.len()
+    }
+}
+impl GuestStore {
+    fn static_literal_member(
+        &self,
+        key: crate::core::digest::Digest,
+        view: ByteLiteralTarget,
+    ) -> Result<Option<(StaticLiteralId, CellId, Option<RefId>)>, Diagnostic> {
+        let Some(id) = self.static_literal_index.get(&key).copied() else {
+            return Ok(None);
+        };
+        let record = self.static_literals.get(id)?;
+        if record.key != key {
+            return Err(lease_fault());
+        }
+        let root = record.root.ok_or_else(lease_fault)?;
+        self.require_static_root(id, root)?;
+        let reference = match view {
+            ByteLiteralTarget::Array => record.array_reference,
+            ByteLiteralTarget::Slice => record.slice_reference,
+        };
+        if let Some(reference) = reference {
+            self.validate_reference_record(self.references.get(reference)?)?;
+        }
+        Ok(Some((id, root, reference)))
+    }
+    pub(crate) fn prepare_static_bytes(
+        &self,
+        key: crate::core::digest::Digest,
+        bytes: &[u8],
+        view: ByteLiteralTarget,
+        expected: Option<TypeId>,
+        needs_cell: bool,
+    ) -> Result<PreparedStaticBytes, Diagnostic> {
+        if bytes.len() > MAX_STATIC_BYTES {
+            return Err(Diagnostic::new(
+                "LRR-E-UNSUPPORTED",
+                "byte-string payload exceeds its decoder limit".into(),
+            ));
+        }
+        let len = u32::try_from(bytes.len()).map_err(|_| resource())?;
+        let types = self.types.preview_byte_literal_types(len, view)?;
+        if expected.is_some_and(|id| id != types.reference) {
+            return Err(ownership());
+        }
+        let existing = self.static_literal_member(key, view)?;
+        if let Some((_, root, _)) = existing {
+            if self.place_type(root)? != types.array {
+                return Err(ownership());
+            }
+            let (_, storage) = self.place_object(root)?;
+            if storage.fields.len() != bytes.len() {
+                return Err(ownership());
+            }
+            if bytes.len() <= MAX_INLINE_BYTES {
+                for (field, byte) in storage.fields.iter().zip(bytes) {
+                    if self.read_scalar(*field)?
+                        != ValueRepr::unsigned(TypeId(9), u64::from(*byte))?
+                    {
+                        return Err(ownership());
+                    }
+                }
+            }
+        }
+        let mut owned = Vec::new();
+        owned
+            .try_reserve_exact(bytes.len())
+            .map_err(|_| resource())?;
+        owned.extend_from_slice(bytes);
+        let plan = PreparedStaticBytes {
+            session: self.pattern_binding_session,
+            epoch: self.budget.epoch(),
+            key,
+            types,
+            bytes: owned,
+            view,
+            needs_cell,
+            existing,
+        };
+        self.preflight_static_byte_reservation(&plan)?;
+        Ok(plan)
+    }
+    fn static_byte_charge(&self, plan: &PreparedStaticBytes) -> Result<(u32, usize), Diagnostic> {
+        let fresh = usize::from(plan.existing.is_none());
+        let lease = usize::from(
+            plan.existing
+                .is_none_or(|(_, _, reference)| reference.is_none()),
+        );
+        let fields = if fresh == 1 { plan.bytes.len() } else { 0 };
+        let cells = fields
+            .checked_add(fresh)
+            .and_then(|n| n.checked_add(usize::from(plan.needs_cell)))
+            .ok_or_else(resource)?;
+        let handles = u32::try_from(cells)
+            .ok()
+            .and_then(|n| {
+                n.checked_add(
+                    u32::try_from(fresh.checked_mul(2)?.checked_add(lease)?.checked_add(1)?)
+                        .ok()?,
+                )
+            })
+            .ok_or_else(resource)?;
+        let heap = fields
+            .checked_mul(std::mem::size_of::<CellId>())
+            .and_then(|n| {
+                n.checked_add(if fresh == 1 {
+                    InitializedFields::estimated_bytes(fields)?
+                } else {
+                    0
+                })
+            })
+            .and_then(|n| {
+                n.checked_add(if fresh == 1 {
+                    128 + std::mem::size_of::<(crate::core::digest::Digest, StaticLiteralId)>()
+                } else {
+                    0
+                })
+            })
+            .and_then(|n| n.checked_add(plan.bytes.capacity()))
+            .and_then(|n| n.checked_add(plan.types.scratch_bytes().ok()?))
+            .and_then(|n| {
+                n.checked_add(if plan.bytes.len() > MAX_INLINE_BYTES {
+                    std::mem::size_of::<StaticByteChunkActivation>()
+                } else {
+                    0
+                })
+            })
+            .ok_or_else(resource)?;
+        let bytes = self
+            .cells
+            .reservation_bytes(cells)?
+            .checked_add(self.objects.reservation_bytes(fresh)?)
+            .and_then(|n| n.checked_add(self.static_literals.reservation_bytes(fresh).ok()?))
+            .and_then(|n| n.checked_add(self.references.reservation_bytes(lease).ok()?))
+            .and_then(|n| n.checked_add(self.tickets.reservation_bytes(1).ok()?))
+            .and_then(|n| n.checked_add(heap))
+            .ok_or_else(resource)?;
+        Ok((handles, bytes))
+    }
+    fn preflight_static_byte_reservation(
+        &self,
+        plan: &PreparedStaticBytes,
+    ) -> Result<(), Diagnostic> {
+        if plan.session != self.pattern_binding_session
+            || plan.epoch != self.budget.epoch()
+            || self.static_literal_member(plan.key, plan.view)? != plan.existing
+        {
+            return Err(stale());
+        }
+        let (handles, bytes) = self.static_byte_charge(plan)?;
+        self.budget.check(handles, bytes)
+    }
+    /// One immutable root per original source site/run; each reach publishes its
+    /// own ordinary single-use ticket. No guest handle enters a query/literal cache.
+    pub(crate) fn instantiate_static_bytes(
+        &mut self,
+        plan: PreparedStaticBytes,
+    ) -> Result<TicketId, Diagnostic> {
+        if plan.bytes.len() > MAX_INLINE_BYTES {
+            return Err(Diagnostic::new(
+                "LRR-E-UNSUPPORTED",
+                "large byte-string construction requires resumable literal progress".into(),
+            ));
+        }
+        self.preflight_static_byte_reservation(&plan)?;
+        let fresh = usize::from(plan.existing.is_none());
+        let lease = usize::from(
+            plan.existing
+                .is_none_or(|(_, _, reference)| reference.is_none()),
+        );
+        let mut fields = Vec::new();
+        if fresh == 1 {
+            fields
+                .try_reserve_exact(plan.bytes.len())
+                .map_err(|_| resource())?;
+        }
+        let initialized =
+            InitializedFields::complete(if fresh == 1 { plan.bytes.len() } else { 0 })?;
+        let heap = fields
+            .capacity()
+            .checked_mul(std::mem::size_of::<CellId>())
+            .and_then(|n| n.checked_add(initialized.owned_bytes()?))
+            .ok_or_else(resource)?;
+        let index_bytes = if fresh == 1 {
+            128 + std::mem::size_of::<(crate::core::digest::Digest, StaticLiteralId)>()
+        } else {
+            0
+        };
+        let (handles, bytes) = self.static_byte_charge(&plan)?;
+        let estimated = if fresh == 1 {
+            plan.bytes
+                .len()
+                .checked_mul(std::mem::size_of::<CellId>())
+                .and_then(|n| n.checked_add(InitializedFields::estimated_bytes(plan.bytes.len())?))
+                .ok_or_else(resource)?
+        } else {
+            0
+        };
+        self.budget.check(
+            handles,
+            bytes
+                .checked_add(heap.saturating_sub(estimated))
+                .ok_or_else(resource)?,
+        )?;
+        self.types.commit_byte_literal_types(&plan.types)?;
+        let cells = if fresh == 1 {
+            plan.bytes.len().checked_add(1).ok_or_else(resource)?
+        } else {
+            0
+        };
+        self.cells.reserve(
+            cells
+                .checked_add(usize::from(plan.needs_cell))
+                .ok_or_else(resource)?,
+            &mut self.budget,
+        )?;
+        self.objects.reserve(fresh, &mut self.budget)?;
+        self.static_literals.reserve(fresh, &mut self.budget)?;
+        self.references.reserve(lease, &mut self.budget)?;
+        self.tickets.reserve(1, &mut self.budget)?;
+        self.budget
+            .check(handles, heap.checked_add(index_bytes).ok_or_else(resource)?)?;
+        let (allocation, root, previous) = if let Some(existing) = plan.existing {
+            existing
+        } else {
+            let allocation: StaticLiteralId = self
+                .static_literals
+                .allocate(
+                    StaticLiteralRecord {
+                        key: plan.key,
+                        root: None,
+                        array_reference: None,
+                        slice_reference: None,
+                    },
+                    index_bytes,
+                    &mut self.budget,
+                )?
+                .into();
+            let object: ObjectId = self
+                .objects
+                .allocate(
+                    ObjectRecord {
+                        type_id: plan.types.array,
+                        storage: ObjectStorage::Constructing,
+                        owner: None,
+                    },
+                    heap,
+                    &mut self.budget,
+                )?
+                .into();
+            let root: CellId = self
+                .cells
+                .allocate(
+                    Cell {
+                        state: CellState::Uninit,
+                        declared: StorageContract::Exact(plan.types.array),
+                        writable: false,
+                        location_epoch: 1,
+                        owner: CellOwner::StaticLiteral(allocation),
+                        retired: false,
+                        numeric_record: None,
+                    },
+                    0,
+                    &mut self.budget,
+                )?
+                .into();
+            for (index, byte) in plan.bytes.iter().enumerate() {
+                let cell = self
+                    .cells
+                    .allocate(
+                        Cell {
+                            state: CellState::Live(ValueRepr::unsigned(
+                                TypeId(9),
+                                u64::from(*byte),
+                            )?),
+                            declared: StorageContract::Exact(TypeId(9)),
+                            writable: false,
+                            location_epoch: 1,
+                            owner: CellOwner::Field {
+                                object,
+                                index: u32::try_from(index).map_err(|_| resource())?,
+                            },
+                            retired: false,
+                            numeric_record: None,
+                        },
+                        0,
+                        &mut self.budget,
+                    )?
+                    .into();
+                fields.push(cell);
+            }
+            let record = self.objects.get_mut(object)?;
+            record.storage = ObjectStorage::Aggregate(AggregateStorage {
+                fields,
+                initialized,
+                next_cleanup: 0,
+                pending_cleanup: None,
+                variant: None,
+            });
+            record.owner = Some(ValueOwner::Cell(root));
+            self.cells.get_mut(root)?.state = CellState::Live(ValueRepr {
+                kind: 8,
+                type_id: plan.types.array.0,
+                payload: object.bits(),
+            });
+            self.static_literals.get_mut(allocation)?.root = Some(root);
+            self.static_literal_index.insert(plan.key, allocation);
+            (allocation, root, None)
+        };
+        let reference = if let Some(reference) = previous {
+            reference
+        } else {
+            let stamp = self.place_stamp(root)?;
+            let reference: RefId = self
+                .references
+                .allocate(
+                    ReferenceRecord {
+                        access: Access::Shared,
+                        owner: None,
+                        target: plan.types.target,
+                        root: stamp,
+                        enclosing: Vec::new(),
+                        final_cell: stamp,
+                        static_slice: if plan.view == ByteLiteralTarget::Slice {
+                            Some(allocation)
+                        } else {
+                            None
+                        },
+                    },
+                    0,
+                    &mut self.budget,
+                )?
+                .into();
+            let record = self.static_literals.get_mut(allocation)?;
+            match plan.view {
+                ByteLiteralTarget::Array => record.array_reference = Some(reference),
+                ByteLiteralTarget::Slice => record.slice_reference = Some(reference),
+            };
+            reference
+        };
+        let value = ValueRepr {
+            kind: 9,
+            type_id: plan.types.reference.0,
+            payload: reference.bits(),
+        };
+        self.tickets
+            .allocate(TransferTicket { value }, 0, &mut self.budget)
+            .map(TicketId::from)
+    }
+    pub(super) fn require_static_root(
+        &self,
+        id: StaticLiteralId,
+        root: CellId,
+    ) -> Result<(), Diagnostic> {
+        if self
+            .static_literal_index
+            .get(&self.static_literals.get(id)?.key)
+            != Some(&id)
+            || self.static_literals.get(id)?.root != Some(root)
+            || self.cells.get(root)?.owner != CellOwner::StaticLiteral(id)
+            || self.cells.get(root)?.writable
+        {
+            return Err(lease_fault());
+        }
+        Ok(())
+    }
+    pub(super) fn require_static_slice(
+        &self,
+        reference: &ReferenceRecord,
+        id: StaticLiteralId,
+    ) -> Result<(), Diagnostic> {
+        self.require_static_root(id, reference.root.cell)?;
+        if reference.access != Access::Shared
+            || reference.final_cell != reference.root
+            || !reference.enclosing.is_empty()
+            || !matches!(self.types.descriptor(reference.target)?.key.as_ref(),TypeKey::Slice{element} if *element==TypeId(9))
+        {
+            return Err(lease_fault());
+        }
+        let actual = self.place_type(reference.root.cell)?;
+        if !matches!(self.types.descriptor(actual)?.key.as_ref(),TypeKey::Array{element,..} if *element==TypeId(9))
+        {
+            return Err(lease_fault());
+        }
+        Ok(())
+    }
+    pub(crate) fn require_static_byte_value(
+        &self,
+        cell: CellId,
+        len: Option<u32>,
+    ) -> Result<(), Diagnostic> {
+        let value = self.admit_move(cell)?;
+        if value.kind != 9 {
+            return Err(ownership());
+        }
+        let reference = self.references.get(RefId::from_bits(value.payload))?;
+        self.validate_reference_record(reference)?;
+        let CellOwner::StaticLiteral(id) = self.cells.get(reference.root.cell)?.owner else {
+            return Err(lease_fault());
+        };
+        self.require_static_root(id, reference.root.cell)?;
+        match (len, self.types.descriptor(reference.target)?.key.as_ref()) {
+            (None, TypeKey::Slice { element })
+                if *element == TypeId(9) && reference.static_slice == Some(id) =>
+            {
+                Ok(())
+            }
+            (Some(expected), TypeKey::Array { element, len })
+                if *element == TypeId(9)
+                    && *len == expected
+                    && reference.static_slice.is_none() =>
+            {
+                Ok(())
+            }
+            _ => Err(ownership()),
+        }
+    }
+    pub(super) fn reject_static_mutation(&self, mut cell: CellId) -> Result<(), Diagnostic> {
+        // Only actual owning edges, never names or reference descriptor shape.
+        for _ in 0..256 {
+            match self.cells.get(cell)?.owner {
+                CellOwner::StaticLiteral(_) => return Err(access_fault()),
+                CellOwner::Field { object, .. } => match self.objects.get(object)?.owner {
+                    Some(ValueOwner::Cell(parent)) => cell = parent,
+                    _ => return Ok(()),
+                },
+                _ => return Ok(()),
+            }
+        }
+        Err(resource())
+    }
+}
