+#[test]
+fn same_source_static_allocation_reuses_lease_but_each_reach_owns_a_fresh_ticket() {
+    let mut store = GuestStore::new(1, 1000, 1 << 20).unwrap();
+    let key = crate::core::digest::Digest::of_bytes(b"same exact source site");
+    let first = store
+        .prepare_static_bytes(key, &[1, 2], ByteLiteralTarget::Array, None, false)
+        .unwrap();
+    let a = store.instantiate_static_bytes(first).unwrap();
+    let value = store.peek_ticket(a).unwrap();
+    let roots = occupied(&store, &store.static_literals);
+    let cells = occupied(&store, &store.cells);
+    let second = store
+        .prepare_static_bytes(key, &[1, 2], ByteLiteralTarget::Array, None, false)
+        .unwrap();
+    let b = store.instantiate_static_bytes(second).unwrap();
+    assert_ne!(a, b);
+    assert_eq!(store.peek_ticket(b).unwrap(), value);
+    assert_eq!(occupied(&store, &store.static_literals), roots);
+    assert_eq!(occupied(&store, &store.cells), cells);
+    assert_eq!(occupied(&store, &store.references), 1);
+    assert!(
+        store
+            .prepare_static_bytes(key, &[1, 3], ByteLiteralTarget::Array, None, false)
+            .is_err()
+    );
+    store.discard(a).unwrap();
+    assert_eq!(store.peek_ticket(b).unwrap(), value);
+    store.reset(2).unwrap();
+    assert!(store.peek_ticket(b).is_err());
+    assert!(store.static_literal_index.is_empty());
+}
