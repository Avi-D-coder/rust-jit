+            .into();
+        a.ticket = Some(ticket);
+        // No fallible operation follows these prevalidated same-store lookups.
+        // Incomplete Object/Uninit root/private record were never ordinary values.
+        if a.plan.existing.is_none() {
+            let object = a.object.expect("prevalidated private byte object");
+            let record = self
+                .objects
+                .get_mut(object)
+                .expect("prevalidated private byte object");
+            record.storage = ObjectStorage::Aggregate(AggregateStorage {
+                fields: std::mem::take(&mut a.fields),
+                initialized: a.initialized.take().expect("prevalidated byte bitmap"),
+                next_cleanup: 0,
+                pending_cleanup: None,
+                variant: None,
+            });
+            record.owner = Some(ValueOwner::Cell(root));
+            self.cells
+                .get_mut(root)
+                .expect("prevalidated private byte root")
+                .state = CellState::Live(ValueRepr {
+                kind: 8,
+                type_id: a.plan.types.array.0,
+                payload: object.bits(),
+            });
+            self.static_literals
+                .get_mut(allocation)
+                .expect("prevalidated private byte membership")
+                .root = Some(root);
+            self.static_literal_index.insert(a.plan.key, allocation);
+        }
+        if previous.is_none() {
+            let record = self
+                .static_literals
+                .get_mut(allocation)
+                .expect("prevalidated byte membership");
+            match a.plan.view {
+                ByteLiteralTarget::Array => record.array_reference = Some(reference),
+                ByteLiteralTarget::Slice => record.slice_reference = Some(reference),
+            }
+        }
+        a.reference = None;
+        a.ticket = None;
+        a.finished = true;
+        Ok(ticket)
+    }
+}
