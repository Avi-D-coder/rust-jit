+use super::*;
+fn occupied<T>(store: &GuestStore, arena: &GuestArena<T>) -> usize {
+    (1..=store.budget.handles())
+        .filter(|index| {
+            arena
+                .get(Handle::<T>::from_bits(
+                    (u64::from(store.budget.epoch()) << 32) | u64::from(*index),
+                ))
+                .is_ok()
+        })
+        .count()
