+        let initialized = InitializedFields::complete_static_bytes(count)?;
+        let heap = fields
+            .capacity()
+            .checked_mul(std::mem::size_of::<CellId>())
+            .and_then(|n| n.checked_add(initialized.owned_bytes()?))
+            .ok_or_else(resource)?;
+        let metadata = std::mem::size_of::<StaticByteChunkActivation>()
+            .checked_add(heap)
+            .and_then(|n| n.checked_add(plan.bytes.capacity()))
+            .and_then(|n| n.checked_add(plan.types.scratch_bytes().ok()?))
+            .filter(|n| *n <= MAX_METADATA)
+            .ok_or_else(resource)?;
