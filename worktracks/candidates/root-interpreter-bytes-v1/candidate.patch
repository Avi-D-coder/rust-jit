+//! The unchanged upstream main must finish; a source import or partial literal
+//! decode is not acceptance. No native compiler substitutes for this execution.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::{key::OutlineKey, memo::Database},
+    engine::run::{RunMachine, RunPoll, ValueSummary},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput},
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParseKey,
+};
+const ORIGINAL: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/tests/ui/parser/slowparse-bstring.rs");
+
+#[test]
+fn unchanged_large_byte_literal_entire_main_completes_all_editions() {
+    // Pinned run-pass/default2015 source contains one 400000-byte literal and
+    // discards it. Other editions are additional owning-profile configurations.
+    assert!(ORIGINAL.lines().any(|line| line == "//@ run-pass"));
+    for edition in [2015, 2018, 2021, 2024] {
+        let cfg = CfgSet::guest_default();
+        let profile = ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        };
+        let blob = SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap();
+        let content = blob.content();
+        let path = SourcePath::new("slowparse-bstring.rs").unwrap();
+        let unit = Digest::of_bytes(b"unchanged upstream large byte literal");
+        let selection = SourceSelection {
+            path: path.clone(),
+            outline: OutlineKey {
+                parse: ParseKey {
+                    content,
+                    profile: profile.clone(),
+                },
+                crate_key: unit,
+                module_path: vec![],
+                cfg: cfg.fingerprint(),
+            },
+        };
+        let inputs = PreparedSourceInputs::refresh(
+            None,
+            vec![SourceUnitInput {
+                path,
+                crate_key: unit,
+                module_path: vec![],
+                profile,
+                cfg,
+                blob,
+            }],
+            Default::default(),
+        )
+        .unwrap();
+        let mut db = Database::default();
+        inputs.publish(&mut db).unwrap();
+        let SourceSelectionOutcome::Selected(view) = inputs.select(&selection).unwrap() else {
+            panic!("original source not selected")
+        };
+        let body = view
+            .outline()
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == "main")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap()
+            .key();
+        assert_eq!(view.selection().outline.parse.content, content);
+        db.begin_run().unwrap();
+        let mut run = RunMachine::start_with_sources(&mut db, body, 1_000_000, vec![view.share()])
+            .into_ready()
+            .unwrap()
+            .unwrap();
+        let report = match run.poll(&mut db) {
+            RunPoll::Completed(report) => report,
+            RunPoll::Fault(error) => panic!("unchanged large byte main faulted: {error:?}"),
+            RunPoll::NeedInput(input) => panic!("unchanged large byte main suspended: {input:?}"),
+            RunPoll::Panicked(report) => panic!("unchanged large byte main panicked: {report:?}"),
+        };
+        assert_eq!(report.live_edition, edition);
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(report.opcode_counters.started_by_opcode[0], 1);
+        assert_eq!(view.selection().outline.parse.content, content);
+        db.finish_run().unwrap();
+    }
+}
