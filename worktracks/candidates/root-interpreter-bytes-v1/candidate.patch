+//! Exact pinned byte-string token decode; no reference lifetime/layout authority.
+use crate::{core::diagnostic::Diagnostic, syntax::spans::BodySpan};
+use ra_ap_syntax::{
+    AstNode, AstToken, SyntaxKind,
+    ast::{self, IsString},
+};
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct ByteStringLiteral(std::sync::Arc<ByteStringData>);
+#[derive(Debug, Eq, PartialEq)]
+struct ByteStringData {
+    bytes: Vec<u8>,
+    spelling: String,
+    source: BodySpan,
+}
+impl ByteStringLiteral {
+    /// Shared immutable decoder certificate; agreement only, never source authority.
+    pub(crate) fn same_decoded_payload(&self, other: &Self) -> bool {
+        std::sync::Arc::ptr_eq(&self.0, &other.0)
+    }
+    pub(crate) fn bytes(&self) -> &[u8] {
+        &self.0.bytes
+    }
+    pub(crate) fn require(&self, spelling: &str, source: &BodySpan) -> Result<(), Diagnostic> {
+        if self.0.spelling != spelling || self.0.source != *source {
+            return Err(Diagnostic::new(
+                "LRR-E-IR-VERIFY",
+                "byte-string decoded source certificate differs".into(),
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        self.0
+            .bytes
+            .capacity()
+            .checked_add(self.0.spelling.capacity())
+            .and_then(|n| {
+                n.checked_add(
+                    std::mem::size_of::<ByteStringData>() + 2 * std::mem::size_of::<usize>(),
+                )
+            })
+    }
+}
+pub(super) fn decode(
+    literal: &ast::Literal,
+    source: &BodySpan,
+) -> Result<ByteStringLiteral, Diagnostic> {
+    let invalid = || {
+        Diagnostic::new(
+            "LRR-E-UNSUPPORTED",
+            "byte-string requires a valid pinned byte token".into(),
+        )
+    };
+    let token = literal
+        .syntax()
+        .children_with_tokens()
+        .filter_map(|child| child.into_token())
+        .find(|token| token.kind() == SyntaxKind::BYTE_STRING)
+        .and_then(ast::ByteString::cast)
+        .ok_or_else(invalid)?;
+    decode_token(&token, source)
+}
+fn decode_token(
+    token: &ast::ByteString,
+    source: &BodySpan,
+) -> Result<ByteStringLiteral, Diagnostic> {
+    let invalid = || {
+        Diagnostic::new(
+            "LRR-E-UNSUPPORTED",
+            "byte-string requires a valid pinned byte token".into(),
+        )
+    };
+    if token.syntax().text().len() > 1024 * 1024 {
+        return Err(Diagnostic::new(
+            "LRR-E-BODY-INDEX-LIMIT",
+            "byte-string lexical payload exceeds source budget".into(),
+        ));
+    }
+    let range = token.text_range_between_quotes().ok_or_else(invalid)?;
+    let content = &token.text()[range - token.syntax().text_range().start()];
+    // rustc normalizes source CRLF before lexing. Preserve our source spelling
+    // and offsets, and normalize only the content passed to its pinned decoder.
+    let content = normalize_crlf(content)?;
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(content.len())
+        .map_err(|_| crate::runtime::arena::resource())?;
+    let mut failed = false;
+    let mut emit = |_, value: Result<u8, ra_ap_syntax::unescape::EscapeError>| match value {
+        Ok(value) => bytes.push(value),
+        Err(error) => failed |= error.is_fatal(),
+    };
+    if token.is_raw() {
+        // The pinned validator also rejects standalone CR and raw non-ASCII.
+        ra_ap_syntax::unescape::check_raw_byte_str(&content, &mut emit);
+    } else {
+        ra_ap_syntax::unescape::unescape_byte_str(&content, &mut emit);
+    }
+    if failed {
+        return Err(invalid());
+    }
+    Ok(ByteStringLiteral(std::sync::Arc::new(ByteStringData {
+        bytes,
+        spelling: token.text().to_owned(),
+        source: source.clone(),
+    })))
+}
+fn normalize_crlf(text: &str) -> Result<std::borrow::Cow<'_, str>, Diagnostic> {
+    if !text.contains("\r\n") {
+        return Ok(std::borrow::Cow::Borrowed(text));
+    }
+    let mut normalized = String::new();
+    normalized
+        .try_reserve_exact(text.len())
+        .map_err(|_| crate::runtime::arena::resource())?;
+    for line in text.split_inclusive('\n') {
+        if let Some(prefix) = line.strip_suffix("\r\n") {
+            normalized.push_str(prefix);
+            normalized.push('\n');
+        } else {
+            normalized.push_str(line);
+        }
+    }
+    Ok(std::borrow::Cow::Owned(normalized))
+}
