+//! Pure prediction for the three closed byte-literal descriptor keys.
+use super::*;
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub(crate) enum ByteLiteralTarget {
+    Array,
+    Slice,
+}
+pub(crate) struct ByteLiteralTypes {
+    count: usize,
+    keys: Vec<(TypeKey, TypeId)>,
+    pub(crate) array: TypeId,
+    pub(crate) target: TypeId,
+    pub(crate) reference: TypeId,
+}
+impl ByteLiteralTypes {
+    pub(crate) fn scratch_bytes(&self) -> Result<usize, Diagnostic> {
+        self.keys
+            .capacity()
+            .checked_mul(std::mem::size_of::<(TypeKey, TypeId)>())
+            .ok_or_else(super::super::arena::resource)
+    }
+}
+impl TypeRegistry {
+    pub(crate) fn preview_byte_literal_types(
+        &self,
+        len: u32,
+        view: ByteLiteralTarget,
+    ) -> Result<ByteLiteralTypes, Diagnostic> {
+        let mut keys = Vec::new();
+        keys.try_reserve_exact(3)
+            .map_err(|_| super::super::arena::resource())?;
+        let mut next = self.descriptors.len();
+        let mut select = |key: TypeKey| -> Result<TypeId, Diagnostic> {
+            if let Some(id) = self.find(&key) {
+                return Ok(id);
+            }
+            if next >= MAX_TYPES {
+                return Err(super::super::arena::resource());
+            }
+            let id = TypeId(
+                u32::try_from(next)
+                    .ok()
+                    .and_then(|n| n.checked_add(17))
+                    .ok_or_else(super::super::arena::resource)?,
+            );
+            next = next
+                .checked_add(1)
+                .ok_or_else(super::super::arena::resource)?;
+            keys.push((key, id));
+            Ok(id)
+        };
+        let array = select(TypeKey::Array {
+            element: TypeId(9),
+            len,
+        })?;
+        let target = match view {
+            ByteLiteralTarget::Array => array,
+            ByteLiteralTarget::Slice => select(TypeKey::Slice { element: TypeId(9) })?,
+        };
+        let reference = select(TypeKey::Ref {
+            mutable: false,
+            target,
+        })?;
+        // Fixed keys have no heap members. Charge the same index/key overhead
+        // as intern plus a descriptor for every new key, even spare capacity.
+        let per = std::mem::size_of::<TypeKey>()
+            .checked_add(2 * std::mem::size_of::<usize>())
+            .and_then(|n| n.checked_add(std::mem::size_of::<(Arc<TypeKey>, TypeId)>()))
+            .and_then(|n| n.checked_add(TYPE_ENTRY_OVERHEAD))
+            .and_then(|n| n.checked_add(std::mem::size_of::<TypeDescriptor>()))
+            .ok_or_else(super::super::arena::resource)?;
+        if self
+            .metadata_bytes()
+            .checked_add(
+                keys.len()
+                    .checked_mul(per)
+                    .ok_or_else(super::super::arena::resource)?,
+            )
+            .is_none_or(|n| n > self.max_metadata_bytes)
+        {
+            return Err(metadata_limit());
+        }
+        Ok(ByteLiteralTypes {
+            count: self.descriptors.len(),
+            keys,
+            array,
+            target,
+            reference,
+        })
+    }
+    pub(crate) fn commit_byte_literal_types(
+        &mut self,
+        plan: &ByteLiteralTypes,
+    ) -> Result<(), Diagnostic> {
+        if self.descriptors.len() != plan.count {
+            return Err(super::super::value::invalid());
+        }
+        for (key, expected) in &plan.keys {
+            if self.intern(key.clone())? != *expected {
+                return Err(super::super::value::invalid());
+            }
+        }
+        Ok(())
+    }
+}
+
+/// An immutable exact two-key annotation batch. This predicts descriptors only;
+/// the static byte annotation's source certificate remains independently required.
+pub(crate) struct ByteHintTypes {
+    count: usize,
+    keys: Vec<(TypeKey, TypeId)>,
+    len: Option<u32>,
+    reference: TypeId,
+}
+impl ByteHintTypes {
+    pub(crate) fn scratch_bytes(&self) -> Result<usize, Diagnostic> {
+        self.keys
+            .capacity()
+            .checked_mul(std::mem::size_of::<(TypeKey, TypeId)>())
+            .ok_or_else(super::super::arena::resource)
+    }
+    pub(crate) fn len(&self) -> Option<u32> {
+        self.len
+    }
+}
+impl TypeRegistry {
+    pub(crate) fn preview_byte_hint_types(
+        &self,
+        len: Option<u32>,
+    ) -> Result<ByteHintTypes, Diagnostic> {
+        let resource = super::super::arena::resource;
+        let mut keys = Vec::new();
+        keys.try_reserve_exact(2).map_err(|_| resource())?;
+        let mut next = self.descriptors.len();
+        let mut select = |key: TypeKey| -> Result<TypeId, Diagnostic> {
+            if let Some(id) = self.find(&key) {
+                return Ok(id);
+            }
+            if next >= MAX_TYPES {
+                return Err(resource());
+            }
+            let id = TypeId(
+                u32::try_from(next)
+                    .ok()
+                    .and_then(|n| n.checked_add(17))
+                    .ok_or_else(resource)?,
+            );
+            next = next.checked_add(1).ok_or_else(resource)?;
+            keys.push((key, id));
+            Ok(id)
+        };
+        let target = select(match len {
+            Some(len) => TypeKey::Array {
+                element: TypeId(9),
+                len,
+            },
+            None => TypeKey::Slice { element: TypeId(9) },
+        })?;
+        let reference = select(TypeKey::Ref {
+            mutable: false,
+            target,
+        })?;
+        let key_bytes = Self::byte_hint_key_bytes()?;
+        let per = key_bytes
+            .checked_add(std::mem::size_of::<TypeDescriptor>())
+            .ok_or_else(resource)?;
+        if self
+            .metadata_bytes()
+            .checked_add(keys.len().checked_mul(per).ok_or_else(resource)?)
+            .is_none_or(|n| n > self.max_metadata_bytes)
+        {
+            return Err(metadata_limit());
+        }
+        Ok(ByteHintTypes {
+            count: self.descriptors.len(),
+            keys,
+            len,
+            reference,
+        })
+    }
+    fn byte_hint_key_bytes() -> Result<usize, Diagnostic> {
+        std::mem::size_of::<TypeKey>()
+            .checked_add(2 * std::mem::size_of::<usize>())
+            .and_then(|n| n.checked_add(std::mem::size_of::<(Arc<TypeKey>, TypeId)>()))
+            .and_then(|n| n.checked_add(TYPE_ENTRY_OVERHEAD))
+            .ok_or_else(super::super::arena::resource)
+    }
+    pub(crate) fn commit_byte_hint_types(
+        &mut self,
+        plan: &ByteHintTypes,
+    ) -> Result<TypeId, Diagnostic> {
+        let resource = super::super::arena::resource;
+        if self.descriptors.len() != plan.count {
+            return Err(super::super::value::invalid());
+        }
+        // Both fallible vector reservation and the actual allocator capacity
+        // accounting precede the first logical key publication. Each intern
+        // below then has spare capacity and prepaid metadata for the full batch.
+        let key_bytes = plan
+            .keys
+            .len()
+            .checked_mul(Self::byte_hint_key_bytes()?)
+            .ok_or_else(resource)?;
+        let end = self
+            .descriptors
+            .len()
+            .checked_add(plan.keys.len())
+            .filter(|n| *n <= MAX_TYPES)
+            .ok_or_else(resource)?;
+        if self
+            .metadata_bytes()
+            .checked_add(key_bytes)
+            .and_then(|n| {
+                n.checked_add(
+                    end.saturating_sub(self.descriptors.capacity())
+                        .checked_mul(std::mem::size_of::<TypeDescriptor>())?,
+                )
+            })
+            .is_none_or(|n| n > self.max_metadata_bytes)
+        {
+            return Err(metadata_limit());
+        }
+        self.descriptors
+            .try_reserve_exact(plan.keys.len())
+            .map_err(|_| resource())?;
+        if self
+            .metadata_bytes()
+            .checked_add(key_bytes)
+            .is_none_or(|n| n > self.max_metadata_bytes)
+        {
+            return Err(metadata_limit());
+        }
+        for (key, expected) in &plan.keys {
+            if self.intern(key.clone())? != *expected {
+                return Err(super::super::value::invalid());
+            }
+        }
+        Ok(plan.reference)
+    }
+}
+
+#[cfg(test)]
+mod hint_batch_tests {
+    use super::*;
+    #[test]
+    fn static_byte_hint_metadata_and_count_refusals_publish_no_descriptor() {
+        // A genuine one-key table determines a deterministic budget that fits
+        // the old first insertion but not its required shared-ref second key.
+        let mut one = TypeRegistry::default();
+        let target = one.intern(TypeKey::Slice { element: TypeId(9) }).unwrap();
+        let limit = one.metadata_bytes();
+        let mut old = TypeRegistry::with_metadata_limit(limit);
+        let target2 = old.intern(TypeKey::Slice { element: TypeId(9) }).unwrap();
+        assert_eq!(target, target2);
+        assert!(
+            old.intern(TypeKey::Ref {
+                mutable: false,
+                target: target2
+            })
+            .is_err()
+        );
+        assert!(old.find(&TypeKey::Slice { element: TypeId(9) }).is_some());
+        let current = TypeRegistry::with_metadata_limit(limit);
+        assert!(current.preview_byte_hint_types(None).is_err());
+        assert_eq!(current.metadata_bytes(), 0);
+        assert!(current.descriptors.is_empty());
+        // Isolate the absolute count guard with a real complete index. The
+        // enlarged metadata budget is test-only so MAX_TYPES is reached first.
+        let mut full = TypeRegistry::default();
+        full.max_metadata_bytes = usize::MAX;
+        for len in 0..u32::try_from(MAX_TYPES - 1).unwrap() {
+            full.intern(TypeKey::Array {
+                element: TypeId(9),
+                len,
+            })
+            .unwrap();
+        }
+        let before = (full.descriptors.len(), full.metadata_bytes());
+        assert!(full.preview_byte_hint_types(None).is_err());
+        assert_eq!((full.descriptors.len(), full.metadata_bytes()), before);
+        assert!(full.find(&TypeKey::Slice { element: TypeId(9) }).is_none());
+    }
+    #[test]
+    fn static_byte_hint_batch_rejects_stale_plan_and_reuses_existing_keys() {
+        let mut registry = TypeRegistry::default();
+        let stale = registry.preview_byte_hint_types(None).unwrap();
+        registry
+            .intern(TypeKey::Array {
+                element: TypeId(9),
+                len: 99,
+            })
+            .unwrap();
+        let before = registry.metadata_bytes();
+        assert!(registry.commit_byte_hint_types(&stale).is_err());
+        assert_eq!(registry.metadata_bytes(), before);
+        assert!(
+            registry
+                .find(&TypeKey::Slice { element: TypeId(9) })
+                .is_none()
+        );
+        for len in [None, Some(3)] {
+            let plan = registry.preview_byte_hint_types(len).unwrap();
+            let reference = registry.commit_byte_hint_types(&plan).unwrap();
+            let before = registry.metadata_bytes();
+            let second = registry.preview_byte_hint_types(len).unwrap();
+            assert!(second.keys.is_empty());
+            assert_eq!(registry.commit_byte_hint_types(&second).unwrap(), reference);
+            assert_eq!(registry.metadata_bytes(), before);
+        }
+    }
+}
