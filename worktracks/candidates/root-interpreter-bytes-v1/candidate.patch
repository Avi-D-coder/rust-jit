+//! Header-only preparation for an actual reached original match. No constant
+//! initializer, macro expansion, guest effect or descriptor lookup occurs here.
+use super::*;
+use crate::{
+    frontend::{
+        constant_path_selection::{ConstantPathOutcome, ConstantPathSelection},
+        current_range_bound_context::CurrentRangeBoundContext,
+    },
+    syntax::{
+        body_index::{ExpressionKind, NodeRole},
+        outline::BodyHandle,
+        scalar_match_context::AdmittedScalarMatchContext,
+    },
+};
+use std::sync::Arc;
+const LIMIT: usize = 32 << 20;
+pub(super) struct MatchBoundContextPlan {
+    caller: usize,
+    body: BodyHandle,
+    context: Arc<AdmittedScalarMatchContext>,
+    bytes: usize,
+}
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-MATCH-BOUND-CONTEXT", message.into())
+}
+fn match_entry(body: &BodyIndex, key: &PcKey) -> Result<Option<PcKey>, Diagnostic> {
+    let Some(node) = body.nodes().get(key.node as usize) else {
+        return Err(fault("match context PC absent"));
+    };
+    if !matches!(
+        node.role,
+        NodeRole::Expression(ExpressionKind::Match) | NodeRole::MatchArm | NodeRole::Pattern
+    ) {
+        return Ok(None);
+    }
+    let mut parent = Some(NodeId(key.node));
+    for _ in 0..256 {
+        let Some(id) = parent else { return Ok(None) };
+        let node = body
+            .nodes()
+            .get(id.0 as usize)
+            .ok_or_else(|| fault("match context ancestor absent"))?;
+        if node.role == NodeRole::Expression(ExpressionKind::Match) {
+            return body.pc(id, Phase::Entry).map(Some);
+        }
+        parent = node.parent;
+    }
+    Err(fault("match context ancestry exceeds source bound"))
+}
+impl RunMachine {
+    fn capture_match_bound_context(
+        &self,
+        db: &Database,
+        entry: &PcKey,
+    ) -> Result<Option<MatchBoundContextPlan>, Diagnostic> {
+        let mut owners = self
+            .sources
+            .iter()
+            .enumerate()
+            .flat_map(|(ordinal, source)| {
+                source
+                    .outline()
+                    .items
+                    .iter()
+                    .filter_map(|item| item.body.as_ref())
+                    .filter(|body| body.key() == entry.body)
+                    .map(move |body| (ordinal, body))
+            });
+        let Some((caller, body)) = owners.next() else {
+            return Ok(None);
+        };
+        if owners.next().is_some() {
+            return Err(fault("match context caller source is duplicated"));
+        }
+        let source = &self.sources[caller];
+        let parsed = db
+            .prepared_parse(&source.selection().outline.parse)
+            .ok_or_else(|| fault("match context source parse is not prepared"))?;
+        let Some(site) = parsed.scalar_match_context_site(source, body, &self.frame.body, entry)?
+        else {
+            return Ok(None);
+        };
+        if self.sources.len() > 256 {
+            return Err(fault("match context retained source count limit"));
+        }
+        let views = self.sources.iter().collect::<Vec<_>>();
+        let selection = match ConstantPathSelection::capture_current(
+            db,
+            source,
+            body,
+            site.endpoint_range(),
+            &views,
+            LIMIT,
+        )? {
+            ConstantPathOutcome::Selected(selection) => selection,
+            // A local/other Value member cannot provide a constant result type.
+            // Existing ordinary syntax remains responsible for that reached form.
+            ConstantPathOutcome::LocalBinding(_) | ConstantPathOutcome::OtherValueMember(_) => {
+                return Ok(None);
+            }
+            other => return Err(other.prerequisite_error()),
+        };
+        let bound = Arc::new(CurrentRangeBoundContext::capture_current(
+            db, &selection, source, &views, LIMIT,
+        )?);
+        let context = AdmittedScalarMatchContext::capture_current(
+            db,
+            source,
+            &views,
+            (&site, &selection),
+            bound,
+            &self.frame.body,
+        )?;
+        let bytes = context
+            .metadata_bytes()
+            .checked_add(std::mem::size_of::<MatchBoundContextPlan>() + 128)
+            .filter(|n| *n <= LIMIT)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        Ok(Some(MatchBoundContextPlan {
+            caller,
+            body: body.clone(),
+            context: Arc::new(context),
+            bytes,
+        }))
+    }
+    pub(super) fn prepare_match_bound_recipe(
+        &mut self,
+        db: &Database,
+    ) -> QueryPoll<Option<crate::ir::recipe::VerifiedRecipe>> {
+        let key = self.frame.pc().clone();
+        let entry = match match_entry(&self.frame.body, &key) {
+            Ok(Some(entry)) => entry,
+            Ok(None) => return QueryPoll::Ready(Ok(None)),
+            Err(error) => return QueryPoll::Ready(Err(error)),
+        };
+        let mut fresh = None;
+        if !self.match_bound_contexts.contains_key(&entry) {
+            // Never apply a newly inferred type after its literal has run.
+            if key != entry {
+                return QueryPoll::Ready(Ok(None));
+            }
+            fresh = match self.capture_match_bound_context(db, &entry) {
+                Ok(Some(plan)) => Some(plan),
+                Ok(None) => return QueryPoll::Ready(Ok(None)),
+                Err(error) => return QueryPoll::Ready(Err(error)),
+            };
+        }
+        let Some(plan) = fresh
+            .as_ref()
+            .or_else(|| self.match_bound_contexts.get(&entry))
+        else {
+            return QueryPoll::Ready(Err(fault("match context plan disappeared")));
+        };
+        let total = if fresh.is_some() {
+            match self
+                .match_bound_context_bytes
+                .checked_add(plan.bytes)
+                .filter(|n| *n <= LIMIT && self.match_bound_contexts.len() < 4096)
+            {
+                Some(total) => total,
+                None => return QueryPoll::Ready(Err(crate::runtime::arena::resource())),
+            }
+        } else {
+            self.match_bound_context_bytes
+        };
+        let prepare = || {
+            plan.context.require_current(db)?;
+            let source = self
+                .sources
+                .get(plan.caller)
+                .ok_or_else(|| fault("match context caller source absent"))?;
+            let parsed = db
+                .prepared_parse(&source.selection().outline.parse)
+                .ok_or_else(|| fault("match context retained parse absent"))?;
+            // Source context does not establish that a reached identifier is
+            // a binding. Preserve the existing current namespace admission lane.
+            if parsed
+                .scalar_match_binding_site(&plan.body, &self.frame.body, &key)?
+                .is_some()
+            {
+                return Ok(None);
+            }
+            parsed
+                .initial_thunk_with_match_bound_context(
+                    &plan.body,
+                    &self.frame.body,
+                    &key,
+                    &plan.context,
+                    db,
+                )
+                .map(Some)
+        };
+        let recipe = match prepare() {
+            Ok(Some(recipe)) => recipe,
+            Ok(None) => return QueryPoll::Ready(Ok(None)),
+            Err(error) => return QueryPoll::Ready(Err(error)),
+        };
+        if let Some(plan) = fresh {
+            self.match_bound_contexts.insert(entry, plan);
+            self.match_bound_context_bytes = total;
+        }
+        QueryPoll::Ready(Ok(Some(recipe)))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn later_plain_binding_keeps_its_current_admission_after_bound_context() {
+        // LRR integration regression for two independently minted authorities;
+        // this adapted control is deliberately outside the original fixture tree.
+        const SOURCE: &str = "mod m {pub const START:u32=4;pub const END:u32=14;}fn main(){match 42 {m::START..=m::END=>{},value=>{let saved:u32=value;}}}";
+        for edition in [2015, 2018, 2021, 2024] {
+            let (mut db, source) =
+                crate::syntax::scalar_match_context::tests::world(SOURCE, edition);
+            let body = source
+                .outline()
+                .items
+                .iter()
+                .find(|item| item.def_key.declared_name == "main")
+                .unwrap()
+                .body
+                .as_ref()
+                .unwrap()
+                .key();
+            db.begin_run().unwrap();
+            let mut run =
+                RunMachine::start_with_sources(&mut db, body, 10_000, vec![source.share()])
+                    .into_ready()
+                    .unwrap()
+                    .unwrap();
+            let report = match run.poll(&mut db) {
+                RunPoll::Completed(report) => report,
+                RunPoll::Fault(error) => {
+                    panic!("reached binding failed {}: {}", error.code, error.message)
+                }
+                RunPoll::NeedInput(input) => {
+                    panic!("reached binding needs current preparation: {input:?}")
+                }
+                RunPoll::Panicked(report) => {
+                    panic!("reached binding panicked: {}", report.panic.description())
+                }
+            };
+            assert!(matches!(report.value, ValueSummary::Unit));
+            assert_eq!(
+                report.opcode_counters.started_by_opcode
+                    [usize::from(crate::ir::op::SOURCE_CONSTANT_OPCODE)],
+                2
+            );
+            assert_eq!(report.opcode_counters.started_by_opcode[7], 2);
+            assert_eq!(report.opcode_counters.started_by_opcode[10], 2);
+            assert_eq!(run.match_bound_contexts.len(), 1);
+            let inventory = run.store.owner_inventory_for_test();
+            assert!(
+                inventory.objects.is_empty()
+                    && inventory.guards.is_empty()
+                    && inventory.tickets.is_empty()
+            );
+        }
+    }
+}
