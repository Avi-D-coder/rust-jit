+pub(crate) fn world(
+    text: &str,
+    edition: u16,
+) -> (Database, PreparedSourceView, PreparedSourceInputs) {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let unit = Digest::of_bytes(b"byte literal reached source");
+    let blob = SourceBlob::new(text.as_bytes().to_vec()).unwrap();
+    let path = SourcePath::new("byte-source.rs").unwrap();
+    let cfg = CfgSet::guest_default();
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile: profile.clone(),
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let SourceSelectionOutcome::Selected(source) = inputs.select(&selection).unwrap() else {
+        panic!("actual original source missing")
+    };
+    let mut db = Database::default();
+    inputs.publish(&mut db).unwrap();
+    db.begin_expansion_epoch(1).unwrap();
+    let mut discovery = SourceDiscovery::new(
+        vec![source.share()],
+        source.outline().root_scope.clone(),
+        Namespace::Value,
+        Digest::of_bytes(b"byte-string actual source world"),
+        1,
+    )
+    .unwrap()
+    .with_declarative_compiler(
+        Digest::of_bytes(b"byte-string compiler inputs"),
+        crate::expand::source_declarative::engine_version(),
+        Arc::new(CompileInputCatalog::standalone(&profile).unwrap()),
+    )
+    .unwrap();
+    let mut sealed = false;
+    for _ in 0..100_000 {
+        match discovery.poll().unwrap() {
+            SourceDiscoveryStep::Sealed(_) => {
+                sealed = true;
+                break;
+            }
+            SourceDiscoveryStep::NeedExpansion { request } => discovery
+                .admit_expansion(Arc::new(request.expand().unwrap()))
+                .unwrap(),
+            SourceDiscoveryStep::NeedGeneratedExpansion { request } => discovery
+                .admit_expansion(Arc::new(request.expand().unwrap()))
+                .unwrap(),
+            SourceDiscoveryStep::Incomplete {
+                diagnostic,
+                blocked,
+            } => panic!("actual byte-string preparation incomplete: {diagnostic}; {blocked:?}"),
+            _ => panic!("byte-string source preparation requires another actual producer"),
+        }
+    }
+    assert!(sealed);
+    discovery.publish(&mut db).unwrap();
+    (db, source, inputs)
+}
+fn reached(source: &PreparedSourceView, db: &Database) -> (BodyHandle, BodyIndex, PcKey) {
+    let handle = source
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .clone()
+        .unwrap();
+    let parsed = db
+        .prepared_parse(&source.selection().outline.parse)
+        .unwrap();
+    let index = parsed
+        .index_body_with_cfg(
+            &handle,
+            source.captured_macro_cfg().unwrap(),
+            Default::default(),
+        )
+        .unwrap();
+    let pc = index
+        .nodes()
+        .iter()
+        .filter_map(|node| {
+            let key = index.pc(node.id, Phase::Entry).unwrap();
+            parsed
+                .byte_string_context_site(&handle, &index, &key)
+                .unwrap()
+                .map(|_| key)
+        })
+        .next()
+        .unwrap();
+    (handle, index, pc)
+}
