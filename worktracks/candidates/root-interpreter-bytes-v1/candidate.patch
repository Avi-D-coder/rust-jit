+//! Actual reached match-entry syntax; a named bound supplies no type authority here.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    ir::pc::{NodeId, PcKey, Phase, SlotId},
+    source::changes::PreparedSourceView,
+    syntax::{
+        ast_adapter::range,
+        body_index::{BodyIndex, ExpressionKind, NodeRole},
+        outline::BodyHandle,
+        parse::ParsedFile,
+        scalar_range_constant_sites::ScalarRangeConstantSite,
+        spans::{BodySpan, SourceRange},
+    },
+};
+use ra_ap_syntax::{
+    AstNode, AstToken, SyntaxKind,
+    ast::{self, RangeItem},
+};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-MATCH-BOUND-CONTEXT-SOURCE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "match bound context source limit".into(),
+    )
+}
+/// Syntax only. The coordinator must independently select the exact constant
+/// member and its current written Type namespace before using its result type.
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct ScalarMatchContextSite {
+    handle: BodyHandle,
+    parse: crate::syntax::parse::ParseKey,
+    index: Digest,
+    entry: PcKey,
+    literal: NodeId,
+    span: BodySpan,
+    bound: ScalarRangeConstantSite,
+}
+impl ScalarMatchContextSite {
+    pub(crate) fn entry(&self) -> &PcKey {
+        &self.entry
+    }
+    pub(crate) fn endpoint_range(&self) -> SourceRange {
+        self.bound.endpoint_range()
+    }
+    pub(crate) fn scrutinee(&self) -> SlotId {
+        self.bound.scrutinee()
+    }
+    pub(crate) fn require_source(&self, source: &PreparedSourceView) -> Result<(), Diagnostic> {
+        self.bound.require_source(source)
+    }
+    pub(crate) fn require_entry(&self, body: &BodyIndex, key: &PcKey) -> Result<(), Diagnostic> {
+        if key != &self.entry
+            || key.body != self.handle.key()
+            || key.phase != Phase::Entry.code()?
+            || body.fingerprint() != self.index
+            || body.body() != &self.handle.key()
+        {
+            return Err(fault("match bound entry body/index/phase differs"));
+        }
+        self.bound.require(body, self.bound.key())?;
+        let owner = body
+            .nodes()
+            .get(key.node as usize)
+            .ok_or_else(|| fault("match owner absent"))?;
+        let literal = body
+            .nodes()
+            .get(self.literal.0 as usize)
+            .ok_or_else(|| fault("match literal absent"))?;
+        if owner.role != NodeRole::Expression(ExpressionKind::Match)
+            || owner.operands.first() != Some(&self.literal)
+            || literal.parent != Some(owner.id)
+            || literal.role != NodeRole::Expression(ExpressionKind::Literal)
+            || literal.value != Some(self.scrutinee())
+            || body.span(self.literal)? != self.span
+            || self.span.body_key != key.body
+        {
+            return Err(fault("match literal exact operand/span/source differs"));
+        }
+        // The bound is in this actual match, not another match in the same body.
+        let mut parent = body
+            .nodes()
+            .get(self.bound.key().node as usize)
+            .and_then(|node| node.parent);
+        let mut found = false;
+        for _ in 0..256 {
+            let Some(id) = parent else { break };
+            let node = body
+                .nodes()
+                .get(id.0 as usize)
+                .ok_or_else(|| fault("match bound ancestor absent"))?;
+            if node.role == NodeRole::Expression(ExpressionKind::Match) {
+                found = id == owner.id;
+                break;
+            }
+            parent = node.parent;
+        }
+        if !found {
+            return Err(fault("bound belongs to another match"));
+        }
+        Ok(())
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.bound.metadata_bytes()?)
+            .and_then(|n| n.checked_add(self.parse.profile.semantics.capacity()))
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(limit)
+    }
+}
+impl StableEncode for ScalarMatchContextSite {
+    const DOMAIN: &'static str = "lrr/v1/scalar-match-bound-context-site";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.handle);
+        e.record(&self.parse);
+        e.digest(self.index);
+        e.record(&self.entry);
+        e.u32(self.literal.0);
+        e.u32(self.span.relative_start);
+        e.u32(self.span.relative_end);
+        e.record(&self.bound);
+    }
+}
+impl ParsedFile {
+    /// Narrow current producer: an actual unsuffixed integer literal and the
+    /// first enabled arm's named lower endpoint. Cold later arms and upper
+    /// endpoints are never searched to invent an expected type.
+    pub(crate) fn scalar_match_context_site(
+        &self,
+        source: &PreparedSourceView,
+        handle: &BodyHandle,
+        index: &BodyIndex,
+        key: &PcKey,
+    ) -> Result<Option<ScalarMatchContextSite>, Diagnostic> {
+        let Some(node) = index.nodes().get(key.node as usize) else {
+            return Err(fault("match entry node absent"));
+        };
+        if key.phase != Phase::Entry.code()?
+            || node.role != NodeRole::Expression(ExpressionKind::Match)
+        {
+            return Ok(None);
+        }
+        source.require_original_hygiene()?;
+        source.require_declaration_syntax()?;
+        if self.key() != source.selection().outline.parse
+            || index.body() != &handle.key()
+            || key.body != handle.key()
+            || index.profile() != &self.profile
+            || index.cfg().fingerprint() != source.selection().outline.cfg
+            || !source
+                .outline()
+                .items
+                .iter()
+                .any(|item| item.body.as_ref() == Some(handle))
+        {
+            return Err(fault("match entry parser/source/profile differs"));
+        }
+        let root = self.entered_body_root(handle)?;
+        let mut selected = None;
+        for (work, syntax) in root.descendants().enumerate() {
+            if work >= 100_000 {
+                return Err(limit());
+            }
+            let Some(matched) = ast::MatchExpr::cast(syntax) else {
+                continue;
+            };
+            let absolute = range(matched.syntax().text_range());
+            if absolute.start.checked_sub(handle.range.start) == Some(node.range.start)
+                && absolute.end.checked_sub(handle.range.start) == Some(node.range.end)
+            {
+                if selected.is_some() {
+                    return Err(fault("match entry AST is ambiguous"));
+                }
+                selected = Some(matched);
+            }
+        }
+        let matched = selected.ok_or_else(|| fault("match entry actual AST absent"))?;
+        if !matched
+            .syntax()
+            .ancestors()
+            .find_map(ast::Fn::cast)
+            .and_then(|function| function.body())
+            .is_some_and(|block| range(block.syntax().text_range()) == handle.range)
+        {
+            return Err(fault("match entry belongs to another original function"));
+        }
+        let Some(ast::Expr::Literal(literal)) = matched.expr() else {
+            return Ok(None);
+        };
+        let Some(integer) = ast::IntNumber::cast(literal.token()) else {
+            return Ok(None);
+        };
+        if literal.token().kind() != SyntaxKind::INT_NUMBER || integer.suffix().is_some() {
+            return Ok(None);
+        }
+        let Some(arms) = matched.match_arm_list() else {
+            return Err(fault("match arm list absent"));
+        };
+        for (work, arm) in arms.arms().enumerate() {
+            if work >= 10_000 {
+                return Err(limit());
+            }
+            let (enabled, attributed) = super::statement_cfg(arm.syntax(), index.cfg())?;
+            if !enabled {
+                continue;
+            }
+            if attributed {
+                return Err(fault("match bound attributes require source admission"));
+            }
+            let Some(ast::Pat::RangePat(pattern)) = arm.pat() else {
+                return Ok(None);
+            };
+            let Some(lower) = pattern.start() else {
+                return Ok(None);
+            };
+            if !matches!(lower, ast::Pat::IdentPat(_) | ast::Pat::PathPat(_)) {
+                return Ok(None);
+            }
+            let absolute = range(pattern.syntax().text_range());
+            let mut indexed = index.nodes().iter().filter(|item| {
+                item.role == NodeRole::Pattern
+                    && absolute.start.checked_sub(handle.range.start) == Some(item.range.start)
+                    && absolute.end.checked_sub(handle.range.start) == Some(item.range.end)
+            });
+            let pattern_node = indexed
+                .next()
+                .ok_or_else(|| fault("match range structural site absent"))?;
+            if indexed.next().is_some() {
+                return Err(fault("match range structural site ambiguous"));
+            }
+            let bound_key = index.pc(pattern_node.id, Phase::Entry)?;
+            let Some(bound) = self.scalar_range_constant_site(source, handle, index, &bound_key)?
+            else {
+                return Ok(None);
+            };
+            let literal_id = *node
+                .operands
+                .first()
+                .ok_or_else(|| fault("match scrutinee operand absent"))?;
+            let site = ScalarMatchContextSite {
+                handle: handle.clone(),
+                parse: self.key(),
+                index: index.fingerprint(),
+                entry: key.clone(),
+                literal: literal_id,
+                span: index.span(literal_id)?,
+                bound,
+            };
+            site.require_source(source)?;
+            site.require_entry(index, key)?;
+            site.metadata_bytes()?;
+            return Ok(Some(site));
+        }
+        Ok(None)
+    }
+}
+
+/// Opaque original header/site join. Stable source identity is separate from
+/// the process-local namespace witness, which must still pass at installation.
+#[derive(Debug)]
+pub struct AdmittedScalarMatchContext {
+    site: ScalarMatchContextSite,
+    bound: std::sync::Arc<crate::frontend::current_range_bound_context::CurrentRangeBoundContext>,
+    namespace: std::sync::Arc<crate::db::memo::NamespaceWitness>,
+    identity: Digest,
+    bytes: usize,
+}
+impl PartialEq for AdmittedScalarMatchContext {
+    fn eq(&self, other: &Self) -> bool {
+        self.identity == other.identity
+    }
+}
+impl Eq for AdmittedScalarMatchContext {}
+impl AdmittedScalarMatchContext {
+    pub(crate) fn capture_current(
+        db: &crate::db::memo::Database,
+        source: &PreparedSourceView,
+        views: &[&PreparedSourceView],
+        selected: (
+            &ScalarMatchContextSite,
+            &crate::frontend::constant_path_selection::ConstantPathSelection,
+        ),
+        bound: std::sync::Arc<
+            crate::frontend::current_range_bound_context::CurrentRangeBoundContext,
+        >,
+        index: &BodyIndex,
+    ) -> Result<Self, Diagnostic> {
+        let (site, selection) = selected;
+        site.require_entry(index, site.entry())?;
+        site.require_source(source)?;
+        bound.require_selection(selection)?;
+        bound.revalidate(db, source, views)?;
+        if selection.site().source() != source.selection()
+            || selection.site().body() != &site.handle
+            || selection.site().range() != site.endpoint_range()
+            || !matches!(
+                bound.primitive(),
+                crate::ir::op::PrimitiveType::I8
+                    | crate::ir::op::PrimitiveType::I16
+                    | crate::ir::op::PrimitiveType::I32
+                    | crate::ir::op::PrimitiveType::I64
+                    | crate::ir::op::PrimitiveType::Isize
+                    | crate::ir::op::PrimitiveType::U8
+                    | crate::ir::op::PrimitiveType::U16
+                    | crate::ir::op::PrimitiveType::U32
+                    | crate::ir::op::PrimitiveType::U64
+                    | crate::ir::op::PrimitiveType::Usize
+            )
+        {
+            return Err(fault(
+                "match integer context requires its exact selected original bound site",
+            ));
+        }
+        let namespace = db.capture_namespace_witness()?;
+        let bytes = std::mem::size_of::<Self>()
+            .checked_add(site.metadata_bytes()?)
+            .and_then(|n| n.checked_add(bound.metadata_bytes()))
+            .and_then(|n| n.checked_add(namespace.metadata_bytes()))
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(limit)?;
+        let mut identity = StableEncoder::new("lrr/v1/admitted-scalar-match-bound-context");
+        identity.record(site);
+        identity.digest(bound.identity());
+        Ok(Self {
+            site: site.clone(),
+            bound,
+            namespace: std::sync::Arc::new(namespace),
+            identity: identity.finish(),
+            bytes,
+        })
+    }
+    pub(crate) fn primitive(&self) -> crate::ir::op::PrimitiveType {
+        self.bound.primitive()
+    }
+    pub(crate) fn site(&self) -> &ScalarMatchContextSite {
+        &self.site
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn dependencies(
+        &self,
+    ) -> &std::collections::BTreeMap<crate::db::dependency::InputKey, Digest> {
+        self.bound.dependencies()
+    }
+    pub(crate) fn require_current(&self, db: &crate::db::memo::Database) -> Result<(), Diagnostic> {
+        self.namespace.require_current(db)
+    }
+    pub(crate) fn require_member(&self, index: &BodyIndex, key: &PcKey) -> Result<(), Diagnostic> {
+        self.site.require_entry(index, self.site.entry())?;
+        if key.body != self.site.entry().body {
+            return Err(fault("match context belongs to another body"));
+        }
+        index.pc(NodeId(key.node), Phase::from_code(key.phase))?;
+        let mut parent = Some(NodeId(key.node));
+        for _ in 0..256 {
+            let Some(id) = parent else { break };
+            let node = index
+                .nodes()
+                .get(id.0 as usize)
+                .ok_or_else(|| fault("match context member absent"))?;
+            if node.role == NodeRole::Expression(ExpressionKind::Match) {
+                return if id.0 == self.site.entry().node {
+                    Ok(())
+                } else {
+                    Err(fault("context member belongs to another match"))
+                };
+            }
+            parent = node.parent;
+        }
+        Err(fault("context member has no owning match"))
+    }
+    pub(crate) fn require_hint(
+        &self,
+        index: &BodyIndex,
+        key: &PcKey,
+        destination: SlotId,
+    ) -> Result<(), Diagnostic> {
+        self.site.require_entry(index, key)?;
+        if destination != self.site.scrutinee() {
+            return Err(fault("match bound context targets another source slot"));
+        }
+        Ok(())
+    }
+}
+impl StableEncode for AdmittedScalarMatchContext {
+    const DOMAIN: &'static str = "lrr/v1/admitted-scalar-match-bound-context-identity";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.identity);
+    }
+}
+
+impl ParsedFile {
+    pub(crate) fn initial_thunk_with_match_bound_context(
+        &self,
+        body: &BodyHandle,
+        index: &BodyIndex,
+        key: &PcKey,
+        context: &std::sync::Arc<AdmittedScalarMatchContext>,
+        db: &crate::db::memo::Database,
+    ) -> Result<crate::ir::recipe::VerifiedRecipe, Diagnostic> {
+        // Check the original witness before capturing an installation sidecar;
+        // an old source proof can never be refreshed into the current world.
+        context.require_current(db)?;
+        context.require_member(index, key)?;
+        if body != &context.site.handle
+            || self.key() != context.site.parse
+            || &self.profile != index.profile()
+        {
+            return Err(fault("context original parser/profile/body differs"));
+        }
+        let node = index
+            .nodes()
+            .get(key.node as usize)
+            .ok_or_else(|| fault("context recipe node absent"))?;
+        let start = body
+            .range
+            .start
+            .checked_add(node.range.start)
+            .ok_or_else(limit)?;
+        let end = body
+            .range
+            .start
+            .checked_add(node.range.end)
+            .ok_or_else(limit)?;
+        let root = self.entered_body_root(body)?;
+        let mut selected = None;
+        for (work, syntax) in root.descendants().enumerate() {
+            if work >= 100_000 {
+                return Err(limit());
+            }
+            if range(syntax.text_range()) != (SourceRange { start, end }) {
+                continue;
+            }
+            let correct = match node.role {
+                NodeRole::Expression(ExpressionKind::Match) => {
+                    ast::MatchExpr::can_cast(syntax.kind())
+                }
+                NodeRole::MatchArm => ast::MatchArm::can_cast(syntax.kind()),
+                NodeRole::Pattern => ast::Pat::can_cast(syntax.kind()),
+                _ => false,
+            };
+            if !correct {
+                continue;
+            }
+            if selected.is_some() {
+                return Err(fault("context recipe AST is ambiguous"));
+            }
+            selected = Some(syntax);
+        }
+        let syntax = selected.ok_or_else(|| fault("context recipe actual source absent"))?;
+        super::literal_match::prepare_bound_context(self, body, index, key, syntax, context)?
+            .with_namespace_witness(db)
+    }
+}
