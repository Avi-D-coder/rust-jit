+//! Whole unchanged main is distinct from the LRR authority/currentness controls.
+use super::*;
+use crate::{frontend::constant_construction::tests::world, ir::op::SOURCE_CONSTANT_OPCODE};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/match/match-range-char-const.rs"
+);
+fn start(text: &str, edition: u16, fuel: u64) -> (Database, RunMachine) {
+    let (mut db, view, _) = world(text, "LOW_RANGE", edition);
+    let body = view
+        .outline()
+        .items
+        .iter()
+        .find(|i| i.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap()
+        .key();
+    db.begin_run().unwrap();
+    let run = RunMachine::start_with_sources(&mut db, body, fuel, vec![view.share()])
+        .into_ready()
+        .unwrap()
+        .unwrap();
+    (db, run)
+}
+fn completed(db: &mut Database, run: &mut RunMachine) -> RunReport {
+    match run.poll(db) {
+        RunPoll::Completed(report) => report,
+        RunPoll::Fault(error) => panic!(
+            "original range main failed {}: {}",
+            error.code, error.message
+        ),
+        RunPoll::NeedInput(input) => panic!("original range main requires {input:?}"),
+        RunPoll::Panicked(panic) => {
+            panic!("original range main panicked {}", panic.panic.description())
+        }
+    }
+}
+fn reach_lower(db: &mut Database, run: &mut RunMachine) {
+    for _ in 0..256 {
+        let pc = run.frame.pc().clone();
+        if pc.phase == Phase::Entry.code().unwrap()
+            && run.frame.body.nodes()[pc.node as usize].scalar_range_phase
+        {
+            return;
+        }
+        let recipe = run.installed.resolve(db, pc).into_ready().unwrap().unwrap();
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(recipe).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+    }
+    panic!("actual original range entry was not reached");
+}
+fn draft(recipe: &VerifiedRecipe) -> RecipeDraft {
+    let r = recipe.recipe();
+    RecipeDraft {
+        key: r.key.clone(),
+        origin: r.origin.clone(),
+        operations: r.operations.to_vec(),
+        exits: vec![r.exit.clone()],
+        dependencies: r.dependencies.to_vec(),
+    }
+}
+#[test]
+fn unchanged_char_const_range_entire_main_queries_both_bounds_and_compares_twice_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run) = start(ORIGINAL, edition, 10_000);
+        let report = completed(&mut db, &mut run);
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(
+            report.opcode_counters.started_by_opcode[usize::from(SOURCE_CONSTANT_OPCODE)],
+            2
+        );
+        assert_eq!(report.opcode_counters.started_by_opcode[10], 2);
+        assert_eq!(run.constant_plans.len(), 2);
+        let mut definitions = run
+            .constant_plans
+            .values()
+            .map(|p| p.query_key().definition())
+            .collect::<Vec<_>>();
+        definitions.sort_unstable();
+        definitions.dedup();
+        assert_eq!(definitions.len(), 2);
+        assert!(run.constant_plans.values().all(|p| p.range.is_some()));
+        let inventory = run.store.owner_inventory_for_test();
+        assert!(
+            inventory.objects.is_empty()
+                && inventory.guards.is_empty()
+                && inventory.tickets.is_empty()
+        );
+    }
+}
+#[test]
+fn lower_false_keeps_dividing_upper_cold_but_true_lower_reaches_its_real_failure() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let cold = "const LOW_RANGE:i32=8;const HIGH_RANGE:i32=1/0;fn main(){match 5_i32{LOW_RANGE..=HIGH_RANGE=>(),_=>(),};}";
+        let (mut db, mut run) = start(cold, edition, 10_000);
+        let high = run.sources[0]
+            .outline()
+            .items
+            .iter()
+            .find(|i| i.def_key.declared_name == "HIGH_RANGE")
+            .unwrap()
+            .def_key
+            .fingerprint();
+        let report = completed(&mut db, &mut run);
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(
+            report.opcode_counters.started_by_opcode[usize::from(SOURCE_CONSTANT_OPCODE)],
+            1
+        );
+        assert_eq!(report.opcode_counters.started_by_opcode[10], 1);
+        assert_eq!(run.constant_plans.len(), 1);
+        assert!(
+            !db.trace
+                .events
+                .iter()
+                .any(|e| matches!(&e.key,QueryKey::Constant(key) if key.definition()==high))
+        );
+        let reached = "const LOW_RANGE:i32=0;const HIGH_RANGE:i32=1/0;fn main(){match 5_i32{LOW_RANGE..=HIGH_RANGE=>(),_=>(),};}";
+        let (mut db, mut run) = start(reached, edition, 10_000);
+        let RunPoll::Fault(error) = run.poll(&mut db) else {
+            panic!("actual reached dividing upper did not fail")
+        };
+        assert_eq!(error.code, "LRR-E-CONST-PANIC");
+        assert_eq!(
+            run.frame.counters.started_by_opcode[usize::from(SOURCE_CONSTANT_OPCODE)],
+            1
+        );
+        assert_eq!(run.frame.counters.started_by_opcode[10], 1);
+    }
+}
+#[test]
+fn opaque_range_recipe_rejects_public_route_wrong_slot_phase_origin_branch_and_dependencies() {
+    let (mut db, mut run) = start(ORIGINAL, 2024, 10_000);
+    reach_lower(&mut db, &mut run);
+    let verified = run
+        .prepare_source_constant_recipe(&mut db)
+        .into_ready()
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    let site = run
+        .constant_plans
+        .get(run.frame.pc())
+        .unwrap()
+        .range
+        .as_ref()
+        .unwrap();
+    let base = draft(&verified);
+    crate::ir::validate::verify_range_source_constant(base.clone(), &run.frame.body, site).unwrap();
+    assert!(crate::ir::validate::verify(base.clone(), &run.frame.body).is_err());
+    let mut wrong = base.clone();
+    wrong.key.phase = Phase::Operand(0).code().unwrap();
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+    let mut wrong = base.clone();
+    wrong.origin.span.relative_end -= 1;
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+    let mut wrong = base.clone();
+    let Op::NumericBinary { left, right, .. } = &mut wrong.operations[1] else {
+        panic!()
+    };
+    std::mem::swap(left, right);
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+    let mut wrong = base.clone();
+    let Op::SourceConstant { destination, .. } = &mut wrong.operations[0] else {
+        panic!()
+    };
+    *destination = site.test();
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+    let mut wrong = base.clone();
+    let RecipeExit::Branch { yes, no, .. } = &mut wrong.exits[0] else {
+        panic!()
+    };
+    std::mem::swap(yes, no);
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+    let mut wrong = base.clone();
+    wrong.dependencies.pop();
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+    let mut wrong = base.clone();
+    wrong.operations.insert(
+        0,
+        Op::Discard {
+            source: site.test(),
+        },
+    );
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+    let mut wrong = base;
+    wrong.dependencies.push(wrong.dependencies[0].clone());
+    assert!(
+        crate::ir::validate::verify_range_source_constant(wrong, &run.frame.body, site).is_err()
+    );
+}
+#[test]
+fn range_source_requires_fresh_use_and_current_epoch_before_opcode_or_owner_effect() {
+    let (mut db, mut run) = start(ORIGINAL, 2024, 10_000);
+    reach_lower(&mut db, &mut run);
+    let recipe = run
+        .prepare_source_constant_recipe(&mut db)
+        .into_ready()
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    let before = (
+        run.frame.pc().clone(),
+        run.frame.fuel.snapshot().used,
+        run.frame.counters.operations_started,
+        run.store.owner_inventory_for_test(),
+    );
+    let error = step::step(&mut run.frame, &mut run.store, &recipe).unwrap_err();
+    assert_eq!(
+        error.message,
+        "source constant lacks a current admitted use"
+    );
+    assert_eq!(
+        before,
+        (
+            run.frame.pc().clone(),
+            run.frame.fuel.snapshot().used,
+            run.frame.counters.operations_started,
+            run.store.owner_inventory_for_test()
+        )
+    );
+    db.finish_run().unwrap();
+    db.begin_expansion_epoch(2).unwrap();
+    db.begin_run().unwrap();
+    let plan = run.constant_plans.get(run.frame.pc()).unwrap();
+    let error = plan
+        .construction(&db, &run.sources)
+        .err()
+        .expect("old range selection survived the actual epoch publication barrier");
+    assert_eq!(error.code, "LRR-E-CONST-PATH-SOURCE");
+    assert_eq!(
+        before,
+        (
+            run.frame.pc().clone(),
+            run.frame.fuel.snapshot().used,
+            run.frame.counters.operations_started,
+            run.store.owner_inventory_for_test()
+        )
+    );
+}
