+//! Pure written-header shape extraction. This produces no namespace authority.
+use crate::{core::diagnostic::Diagnostic, ir::op::PrimitiveType, syntax::outline::HeaderRecipe};
+use ra_ap_syntax::SyntaxKind;
+
+const MAX_HEADER_TOKENS: usize = 4096;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-RANGE-BOUND-CONTEXT", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "range bound header context budget".into(),
+    )
+}
+
+// Actual outline headers exclude the initializer node but retain its '=' and
+// declaration ';'. Match only that canonical six-token suffix; visibility and
+// attributes remain owned by the already source-checked header, not this reader.
+// The frontend must validate its current Type receipt; spelling is not authority.
+pub(crate) fn written_scalar<'a>(
+    header: &'a HeaderRecipe,
+    name: &str,
+) -> Result<(PrimitiveType, &'a str), Diagnostic> {
+    if header.tokens.len() > MAX_HEADER_TOKENS {
+        return Err(limit());
+    }
+    let mut token_bytes = 0usize;
+    for token in &header.tokens {
+        token_bytes = token_bytes
+            .checked_add(token.text.len())
+            .filter(|n| *n <= 65_536)
+            .ok_or_else(limit)?;
+    }
+    let start = header
+        .tokens
+        .len()
+        .checked_sub(6)
+        .ok_or_else(|| fault("constant written scalar header prerequisite"))?;
+    let suffix = &header.tokens[start..];
+    if suffix[0].kind != SyntaxKind::CONST_KW as u16
+        || suffix[0].text != "const"
+        || suffix[1].kind != SyntaxKind::IDENT as u16
+        || suffix[1].text != name
+        || suffix[2].kind != SyntaxKind::COLON as u16
+        || suffix[2].text != ":"
+        || suffix[3].kind != SyntaxKind::IDENT as u16
+        || suffix[4].kind != SyntaxKind::EQ as u16
+        || suffix[4].text != "="
+        || suffix[5].kind != SyntaxKind::SEMICOLON as u16
+        || suffix[5].text != ";"
+    {
+        return Err(fault(
+            "constant requires an exact bare written scalar type header",
+        ));
+    }
+    let primitive = match suffix[3].text.as_str() {
+        "bool" => PrimitiveType::Bool,
+        "char" => PrimitiveType::Char,
+        "i8" => PrimitiveType::I8,
+        "i16" => PrimitiveType::I16,
+        "i32" => PrimitiveType::I32,
+        "i64" => PrimitiveType::I64,
+        "i128" => PrimitiveType::I128,
+        "isize" => PrimitiveType::Isize,
+        "u8" => PrimitiveType::U8,
+        "u16" => PrimitiveType::U16,
+        "u32" => PrimitiveType::U32,
+        "u64" => PrimitiveType::U64,
+        "u128" => PrimitiveType::U128,
+        "usize" => PrimitiveType::Usize,
+        "f32" => PrimitiveType::F32,
+        "f64" => PrimitiveType::F64,
+        _ => {
+            return Err(fault(
+                "constant declared alias or unsupported scalar type requires source normalization",
+            ));
+        }
+    };
+    Ok((primitive, &suffix[3].text))
+}
