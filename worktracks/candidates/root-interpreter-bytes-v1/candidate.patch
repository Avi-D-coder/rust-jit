+//! LRR cancellation/currentness controls executing unchanged upstream source.
+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    db::key::OutlineKey,
+    runtime::cell::{CellState, OwnerInventory},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput},
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParseKey,
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/slowparse-bstring.rs"
+);
+fn start(fuel: u64) -> (Database, RunMachine) {
+    let edition = 2024;
+    let cfg = CfgSet::guest_default();
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let blob = SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap();
+    let content = blob.content();
+    let path = SourcePath::new("slowparse-bstring.rs").unwrap();
+    let unit = Digest::of_bytes(b"unchanged upstream large byte literal");
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content,
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile,
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let mut db = Database::default();
+    inputs.publish(&mut db).unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selection).unwrap() else {
+        panic!("original source not selected")
+    };
+    let body = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap()
+        .key();
+    assert_eq!(view.selection().outline.parse.content, content);
+    db.begin_run().unwrap();
+    let run = RunMachine::start_with_sources(&mut db, body, fuel, vec![view.share()])
+        .into_ready()
+        .unwrap()
+        .unwrap();
+
+    (db, run)
+}
+fn first_chunk(db: &mut Database, run: &mut RunMachine) -> OwnerInventory {
+    for _ in 0..64 {
+        let pc = run.frame.pc().clone();
+        let id = run
+            .installed
+            .resolve(db, pc.clone())
+            .into_ready()
+            .unwrap()
+            .unwrap();
+        let recipe = run.installed.get(id).unwrap();
+        let destination = recipe.recipe().operations.iter().find_map(|op| match op {
+            Op::Literal { destination, .. } => Some(*destination),
+            _ => None,
+        });
+        let mut before = run.store.owner_inventory_for_test();
+        let prior = destination.and_then(|slot| run.frame.cell(slot).ok());
+        let outcome = step::step(&mut run.frame, &mut run.store, recipe).unwrap();
+        if let Some(destination) = destination {
+            assert!(matches!(outcome, StepOutcome::Dispatch));
+            assert_eq!(run.frame.pc(), &pc);
+            assert!(run.frame.has_byte_literal_activation());
+            if prior.is_none() {
+                before.cells.push((
+                    run.frame.cell(destination).unwrap().bits(),
+                    CellState::Uninit,
+                ));
+                before.cells.sort_by_key(|entry| entry.0);
+            }
+            return before;
+        }
+        assert!(matches!(outcome, StepOutcome::Next(_)));
+    }
+    panic!("unchanged main did not reach its byte literal");
+}
+#[test]
+fn unchanged_large_byte_literal_cancellation_and_fuel_drain_before_fault() {
+    for cancel in [false, true] {
+        let (mut db, mut run) = start(if cancel { 1_000_000 } else { 300 });
+        let baseline = first_chunk(&mut db, &mut run);
+        let used = run.frame.fuel.snapshot().used;
+        let pc = run.frame.pc().clone();
+        if cancel {
+            run.cancellation_token().cancel();
+        }
+        let RunPoll::Fault(error) = run.poll(&mut db) else {
+            panic!("interrupted byte construction completed");
+        };
+        assert_eq!(error.code, "LRR-E-RUNTIME-RESOURCE");
+        assert_eq!(
+            error.message,
+            if cancel {
+                "guest run cancellation requested"
+            } else {
+                "guest opcode fuel exhausted"
+            }
+        );
+        assert_eq!(
+            run.frame.fuel.snapshot().used,
+            if cancel { used } else { 300 }
+        );
+        assert_eq!(run.frame.pc(), &pc);
+        assert_eq!(run.frame.counters.started_by_opcode[0], 1);
+        assert!(!run.frame.has_byte_literal_activation());
+        assert_eq!(run.store.owner_inventory_for_test(), baseline);
+        db.finish_run().unwrap();
+    }
+}
+#[test]
+fn unchanged_large_byte_literal_source_replacement_drains_before_snapshot_fault() {
+    let (mut db, mut run) = start(1_000_000);
+    let baseline = first_chunk(&mut db, &mut run);
+    let used = run.frame.fuel.snapshot().used;
+    db.finish_run().unwrap();
+    // A real coordinator publication deletes the old source universe.
+    db.publish_inputs(Default::default()).unwrap();
+    db.begin_run().unwrap();
+    let RunPoll::Fault(error) = run.poll(&mut db) else {
+        panic!("stale literal source completed");
+    };
+    assert_eq!(error.code, "LRR-E-INTERNAL-SNAPSHOT");
+    assert_eq!(
+        error.message,
+        "byte literal dispatch source publication is stale"
+    );
+    assert_eq!(run.frame.fuel.snapshot().used, used);
+    assert_eq!(run.frame.counters.started_by_opcode[0], 1);
+    assert!(!run.frame.has_byte_literal_activation());
+    assert_eq!(run.store.owner_inventory_for_test(), baseline);
+    db.finish_run().unwrap();
+}
