+//! Partial original-main progress: both initial declarations, no assertion skipped
+//! or counted as passed. Later static/slice/Vec runtime obligations stay required.
+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    runtime::cell::GuestStore,
+    source::snapshot::{CfgSet, SourceBlob},
+    traits::term::{ConstTerm, RegionTerm, TyTerm},
+    vm::{
+        frame::Frame,
+        step::{StepOutcome, step},
+    },
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/array-slice-vec/byte-literals.rs"
+);
+fn entered(text: &str, edition: u16) -> (ParsedFile, BodyHandle, BodyIndex, Vec<ast::LetStmt>) {
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    let outline = parsed
+        .outline(
+            Digest::of_bytes(b"byte literal reached source"),
+            vec![],
+            &CfgSet::guest_default(),
+        )
+        .unwrap();
+    let body = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .clone()
+        .unwrap();
+    let index = parsed.index_body(&body, Default::default()).unwrap();
+    let declarations = parsed
+        .entered_body_root(&body)
+        .unwrap()
+        .descendants()
+        .filter_map(ast::LetStmt::cast)
+        .take(2)
+        .collect();
+    (parsed, body, index, declarations)
+}
+fn admitted_thunk(
+    db: &mut crate::db::memo::Database,
+    source: &crate::source::changes::PreparedSourceView,
+    parsed: &ParsedFile,
+    body: &BodyHandle,
+    index: &BodyIndex,
+    key: &PcKey,
+) -> Result<VerifiedRecipe, crate::core::diagnostic::Diagnostic> {
+    let recipe = if parsed.byte_string_context_site(body, index, key)?.is_some() {
+        let proof =
+            crate::frontend::byte_string_context::CurrentByteStringContext::capture_current(
+                db,
+                source,
+                index,
+                key,
+                64 << 20,
+            )?;
+        proof.require_current(db)?;
+        parsed.initial_thunk_with_byte_context(body, index, key, &proof)?
+    } else {
+        parsed.initial_thunk(body, index, key)?
+    };
+    recipe.revalidate_namespace(db)?;
+    Ok(recipe)
+}
+fn frame(
+    index: &BodyIndex,
+    key: PcKey,
+    recipe: &VerifiedRecipe,
+    fuel: u64,
+    handles: u32,
+) -> (Frame, GuestStore) {
+    let mut store = GuestStore::new(1, handles, 16 << 20).unwrap();
+    let mut frame = Frame::new(index.clone(), key.clone(), &mut store).unwrap();
+    frame.set_fuel_limit(fuel).unwrap();
+    let mut scope = match recipe.recipe().operations.first() {
+        Some(Op::ScopeEnter { scope }) => index.scopes()[scope.0 as usize].parent,
+        _ => Some(index.nodes()[key.node as usize].scope),
+    };
+    let mut ancestors = Vec::new();
+    while let Some(id) = scope {
+        ancestors.push(id);
+        scope = index.scopes()[id.0 as usize].parent;
+    }
+    for id in ancestors.into_iter().rev() {
+        frame.enter(id).unwrap();
+    }
+    (frame, store)
+}
+#[test]
+fn unchanged_original_first_two_static_byte_declarations_execute_normal_thunks_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (parsed, body, index, declarations) = entered(ORIGINAL, edition);
+        let (mut db, source, _source_lease) =
+            crate::frontend::byte_string_context::tests::world(ORIGINAL, edition);
+        let entry = index
+            .pc(
+                id_for(&index, &body, declarations[0].syntax()).unwrap(),
+                Phase::Entry,
+            )
+            .unwrap();
+        let first = admitted_thunk(&mut db, &source, &parsed, &body, &index, &entry).unwrap();
+        let stop = return_pc(&index, &body, declarations[1].syntax()).unwrap();
+        let (mut frame, mut store) = frame(&index, entry, &first, 1000, 10000);
+        let mut literal_count = 0;
+        let mut binding_count = 0;
+        for _ in 0..64 {
+            if *frame.pc() == stop {
+                break;
+            }
+            let recipe =
+                admitted_thunk(&mut db, &source, &parsed, &body, &index, frame.pc()).unwrap();
+            let literal = recipe.recipe().operations.iter().find_map(|op| match op {
+                Op::Literal {
+                    literal,
+                    destination,
+                    ..
+                } => Some((literal.clone(), *destination)),
+                _ => None,
+            });
+            let binding = recipe.recipe().operations.iter().find_map(|op| match op {
+                Op::BindLocal {
+                    binding,
+                    hint: HintRecipe::StaticByteReference(context),
+                    ..
+                } => Some((*binding, context.len())),
+                _ => None,
+            });
+            assert!(matches!(
+                step(&mut frame, &mut store, &recipe).unwrap(),
+                StepOutcome::Next(_) | StepOutcome::Dispatch
+            ));
+            if let Some((literal, destination)) = literal {
+                literal_count += 1;
+                let Some(DecodedLiteral::ByteString(payload)) = &literal.decoded else {
+                    panic!("not original byte-string")
+                };
+                assert_eq!(payload.bytes(), [97, 240, 9]);
+                let expected = if literal_count == 1 {
+                    TyTerm::Slice(Box::new(TyTerm::Primitive(PrimitiveType::U8)))
+                } else {
+                    TyTerm::Array(
+                        Box::new(TyTerm::Primitive(PrimitiveType::U8)),
+                        ConstTerm::Value(3),
+                    )
+                };
+                assert_eq!(
+                    frame.source_view(destination).unwrap(),
+                    Some(TyTerm::Ref(RegionTerm::Static, false, Box::new(expected)))
+                );
+                let start = body.range.start + literal.source.relative_start;
+                let end = body.range.start + literal.source.relative_end;
+                assert_eq!(&ORIGINAL[start as usize..end as usize], literal.spelling);
+            }
+            if let Some((binding, len)) = binding {
+                binding_count += 1;
+                store
+                    .require_static_byte_value(frame.binding_cell_for_test(binding).unwrap(), len)
+                    .unwrap();
+            }
+        }
+        assert_eq!(*frame.pc(), stop);
+        assert_eq!((literal_count, binding_count), (2, 2));
+        // This is the genuine next source PC, before its actual assert macro.
+        let next_node = &index.nodes()[stop.node as usize];
+        let next_start = body.range.start.checked_add(next_node.range.start).unwrap() as usize;
+        assert!(ORIGINAL[next_start..].starts_with("assert_eq!(b'a', 97u8)"));
+        let next = parsed.initial_thunk(&body, &index, &stop).unwrap();
+        assert!(next.recipe().operations.iter().all(
+            |op| !matches!(op,Op::Literal{literal,..} if literal.kind==LiteralKind::ByteString)
+        ));
+    }
+}
