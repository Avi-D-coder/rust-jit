+fn byte_literal_roots_and_shared_return_tickets_survive_frame_cleanup_until_run_reset() {
+    for view in [ByteLiteralTarget::Array, ByteLiteralTarget::Slice] {
+        let mut store = GuestStore::new(1, 1000, 1 << 20).unwrap();
+        let frame = store.new_frame_anchor().unwrap();
+        let plan = store
+            .prepare_static_bytes(
+                crate::core::digest::Digest::of_bytes(b"physical literal site"),
+                &[97, 240, 9],
+                view,
+                None,
+                false,
+            )
+            .unwrap();
+        let ty = plan.reference_type();
+        let ticket = store.instantiate_static_bytes(plan).unwrap();
+        let value = store.peek_ticket(ticket).unwrap();
+        let reference = RefId::from_bits(value.payload);
+        let root = store.references.get(reference).unwrap().root.cell;
+        assert!(matches!(
+            store.cells.get(root).unwrap().owner,
+            CellOwner::StaticLiteral(_)
+        ));
+        assert_ne!(
+            store.cells.get(root).unwrap().owner,
+            CellOwner::FrameSlot { frame, slot: 0 }
+        );
+        let caller = store
+            .new_cell(
+                StorageContract::Exact(ty),
+                false,
+                CellOwner::FrameSlot { frame, slot: 0 },
+            )
+            .unwrap();
+        store.initialize(caller, ticket).unwrap();
+        let returned = store.reference_ticket(reference).unwrap();
+        let dropped = store.begin_drop(caller).unwrap();
+        store.discard(dropped).unwrap();
+        store.retire_cell(caller).unwrap();
+        assert_eq!(store.peek_ticket(returned).unwrap(), value);
+        store
+            .validate_reference_record(store.references.get(reference).unwrap())
+            .unwrap();
+        assert_eq!(occupied(&store, &store.static_literals), 1);
+        assert_eq!(occupied(&store, &store.references), 1);
+        let (_, storage) = store.place_object(root).unwrap();
+        assert_eq!(
+            storage
+                .fields
+                .iter()
+                .map(|field| store.read_scalar(*field).unwrap().payload)
+                .collect::<Vec<_>>(),
+            [97, 240, 9]
+        );
+        let mut wrong = GuestStore::new(1, 1000, 1 << 20).unwrap();
+        assert!(wrong.reference_ticket(reference).is_err());
+        // Outstanding returned tickets/shared leases are part of this whole-run
+        // terminal reset, not frame-owned or host-static leaked allocations.
+        store.reset(2).unwrap();
+        assert_eq!(occupied(&store, &store.static_literals), 0);
+        assert_eq!(occupied(&store, &store.references), 0);
+        assert_eq!(occupied(&store, &store.objects), 0);
+        assert_eq!(occupied(&store, &store.cells), 0);
+        assert_eq!(occupied(&store, &store.tickets), 0);
+        assert_eq!(store.budget.handles(), 0);
+        assert_eq!(store.budget.bytes(), 0);
+        assert!(store.peek_ticket(returned).is_err());
+        assert!(store.reference_ticket(reference).is_err());
+    }
