+    pub(crate) fn prepare_static_byte_chunks(
+        &mut self,
+        plan: PreparedStaticBytes,
+    ) -> Result<StaticByteChunkActivation, Diagnostic> {
+        self.preflight_static_byte_reservation(&plan)?;
