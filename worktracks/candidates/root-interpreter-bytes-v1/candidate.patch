+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    source::snapshot::{CfgSet, SourceBlob},
+    syntax::parse::ParsedFile,
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/array-slice-vec/byte-literals.rs"
+);
+#[test]
+fn unchanged_original_byte_string_tokens_keep_pinned_decoded_bytes_and_exact_spans_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap(),
+            ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            },
+        )
+        .unwrap();
+        let outline = parsed
+            .outline(
+                Digest::of_bytes(b"unchanged byte literals"),
+                vec![],
+                &CfgSet::guest_default(),
+            )
+            .unwrap();
+        let body = outline
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == "main")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap();
+        let root = parsed.entered_body_root(body).unwrap();
+        let literals = root
+            .descendants()
+            .filter_map(ast::LetStmt::cast)
+            .take(2)
+            .map(|statement| statement.initializer().unwrap())
+            .collect::<Vec<_>>();
+        for expr in literals {
+            let ast::Expr::Literal(literal) = expr else {
+                panic!("original byte literal changed")
+            };
+            let range = literal.syntax().text_range();
+            let span = BodySpan {
+                body_key: body.key(),
+                relative_start: u32::from(range.start()) - body.range.start,
+                relative_end: u32::from(range.end()) - body.range.start,
+            };
+            let value = decode(&literal, &span).unwrap();
+            assert_eq!(value.bytes(), [97, 240, 9]);
+            assert_eq!(
+                &ORIGINAL[u32::from(range.start()) as usize..u32::from(range.end()) as usize],
+                value.0.spelling
+            );
+            value.require(&value.0.spelling, &span).unwrap();
+            let mut wrong = span.clone();
+            wrong.relative_end -= 1;
+            assert!(value.require(&value.0.spelling, &wrong).is_err());
+            assert!(value.require("br\"different\"", &span).is_err());
+        }
+    }
+}
+#[test]
+fn raw_and_escaped_original_spellings_use_the_pinned_decoder_without_utf8_reinterpretation() {
+    for (spelling, expected) in [
+        (r##"br"a\n""##, vec![97, 92, 110]),
+        (r####"br###"a"##b"###"####, vec![97, 34, 35, 35, 98]),
+        ("b\"a\\\n                 b\"", vec![97, 98]),
+        (r#"b"\0\xFF""#, vec![0, 255]),
+    ] {
+        // First three spellings occur unchanged in the original. The last is an
+        // LRR decoder edge control, not an additional imported language fixture.
+        if expected != [0, 255] {
+            assert!(ORIGINAL.contains(spelling));
+        }
+        let text = format!("fn main(){{let bytes={spelling};}}");
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+            ProfileIdentity::current(),
+        )
+        .unwrap();
+        let outline = parsed
+            .outline(
+                Digest::of_bytes(b"byte decode control"),
+                vec![],
+                &CfgSet::guest_default(),
+            )
+            .unwrap();
+        let body = outline.items[0].body.as_ref().unwrap();
+        let literal = parsed
+            .entered_body_root(body)
+            .unwrap()
+            .descendants()
+            .find_map(ast::Literal::cast)
+            .unwrap();
+        let range = literal.syntax().text_range();
+        let span = BodySpan {
+            body_key: body.key(),
+            relative_start: u32::from(range.start()) - body.range.start,
+            relative_end: u32::from(range.end()) - body.range.start,
+        };
+        assert_eq!(decode(&literal, &span).unwrap().bytes(), expected);
+    }
+}
