+//! Drain the reached literal's private owner before reporting a terminal fault.
+use super::*;
+impl RunMachine {
+    pub(super) fn fail_byte_literal(&mut self, error: Diagnostic) -> RunPoll {
+        if let Err(error) = self.frame.abort_byte_literal_op(&mut self.store, error) {
+            self.terminal = true;
+            return RunPoll::Fault(error);
+        }
+        loop {
+            match self.frame.drain_byte_literal_op(&mut self.store) {
+                Ok(false) => continue,
+                Ok(true) => {
+                    self.terminal = true;
+                    return RunPoll::Fault(call_fault("byte rollback lost its retained failure"));
+                }
+                Err(error) => {
+                    self.terminal = true;
+                    return RunPoll::Fault(error);
+                }
+            }
+        }
+    }
+}
