+#[test]
+fn opaque_or_guard_retries_matching_alternatives_without_replaying_scrutinee() {
+    // LRR exact-once and cold-frontier controls supplement stock components.
+    for edition in [2015, 2018, 2021, 2024] {
+        for (text, calls) in [
+            (
+                "fn value()->i32{1}fn guard()->bool{false}fn main(){assert_eq!(2,match value(){1|1 if guard()=>0,_=>2});}",
+                3,
+            ),
+            (
+                "const LATER:i32=2;fn value()->i32{1}fn guard()->bool{true}fn main(){assert_eq!(2,match value(){1|LATER if guard()=>2,_=>0});}",
+                2,
+            ),
+            (
+                "fn value()->i32{1}fn guard()->bool{loop{}}fn main(){assert_eq!(2,match value(){0|2 if guard()=>0,_=>2});}",
+                1,
+            ),
+        ] {
+            let (db, machine, outcome) = run(text, edition);
+            let report = match outcome {
+                RunPoll::Completed(report) => report,
+                RunPoll::Fault(error) => panic!("or guard fault: {error}"),
+                RunPoll::NeedInput(input) => panic!("or guard needs input: {input:?}"),
+                RunPoll::Panicked(report) => panic!("or guard panicked: {report:?}"),
+            };
+            assert!(matches!(report.value, ValueSummary::Unit));
+            assert_eq!(report.opcode_counters.started_by_opcode[19], calls);
+            assert_eq!(report.opcode_counters.started_by_opcode[26], 1);
+            assert_eq!(report.opcode_counters.started_by_opcode[25], 0);
+            assert_eq!(
+                report.opcode_counters.operations_started,
+                report.opcode_counters.operations_completed
+            );
+            assert_eq!(machine.action_snapshot().published, calls);
+            assert_eq!(machine.action_snapshot().consumed, calls);
+            assert_eq!(machine.action_snapshot().pending, None);
+            assert!(
+                db.trace
+                    .events
+                    .iter()
+                    .all(|event| !matches!(&event.key, QueryKey::Constant(_)))
+            );
+        }
+    }
+}
