+/// Flatten only source alternative/group structure, preserving written order.
+/// Unsupported leaves remain data so a preceding successful alternative keeps
+/// them cold. This grants no binding/type/namespace or executable authority.
+pub(super) fn scalar_pattern_alternatives(
+    pattern: ast::Pat,
+    work: &mut usize,
+) -> Result<Vec<ast::Pat>, Diagnostic> {
+    let limit = || {
+        Diagnostic::new(
+            "LRR-E-METADATA-LIMIT",
+            "scalar alternative source budget".into(),
+        )
+    };
+    let mut pending = Vec::new();
+    let mut output = Vec::new();
+    pending
+        .try_reserve(1)
+        .map_err(|_| crate::runtime::arena::resource())?;
+    pending.push((pattern, 0usize));
+    while let Some((pattern, depth)) = pending.pop() {
+        source_work(work)?;
+        if depth >= 256 {
+            return Err(limit());
+        }
+        let attributed = pattern
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()));
+        let mut children = Vec::new();
+        match &pattern {
+            ast::Pat::OrPat(or) if !attributed => {
+                for child in or.pats() {
+                    source_work(work)?;
+                    if children.len() >= 4096 {
+                        return Err(limit());
+                    }
+                    children
+                        .try_reserve(1)
+                        .map_err(|_| crate::runtime::arena::resource())?;
+                    children.push(child);
+                }
+                if children.is_empty() {
+                    return Err(limit());
+                }
+            }
+            ast::Pat::ParenPat(group) if !attributed => {
+                let Some(inner) = group.pat() else {
+                    return Err(limit());
+                };
+                children
+                    .try_reserve(1)
+                    .map_err(|_| crate::runtime::arena::resource())?;
+                children.push(inner);
+            }
+            _ => {
+                if output.len() >= 4096 {
+                    return Err(limit());
+                }
+                output
+                    .try_reserve(1)
+                    .map_err(|_| crate::runtime::arena::resource())?;
+                output.push(pattern);
+                continue;
+            }
+        }
+        pending
+            .len()
+            .checked_add(children.len())
+            .filter(|n| *n <= 4096)
+            .ok_or_else(limit)?;
+        pending
+            .try_reserve(children.len())
+            .map_err(|_| crate::runtime::arena::resource())?;
+        pending.extend(children.into_iter().rev().map(|child| (child, depth + 1)));
+    }
+    Ok(output)
 }
 
