+#[test]
+fn unchanged_overlapping_or_match_functions_execute_all_original_assertions_all_editions() {
+    const TEXT: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/match/overeager-sub-match-pruning-13027.rs"
+    );
+    // Four complete unchanged function components; main still requires its
+    // other functions, statics and structural patterns. Never a fixture pass.
+    for edition in [2015, 2018, 2021, 2024] {
+        for entry in [
+            "multi_pats_shadow_lit",
+            "multi_pats_shadow_range",
+            "lit_shadow_multi_pats",
+            "range_shadow_multi_pats",
+        ] {
+            let (_, machine, outcome) = run_entry(
+                TEXT,
+                edition,
+                100_000,
+                entry,
+                "tests/ui/match/overeager-sub-match-pruning-13027.rs",
+            );
+            let report = match outcome {
+                RunPoll::Completed(report) => report,
+                RunPoll::Fault(error) => panic!("{edition}/{entry}: {error}"),
+                RunPoll::NeedInput(input) => panic!("{edition}/{entry}: {input:?}"),
+                RunPoll::Panicked(report) => panic!("{edition}/{entry}: {report:?}"),
+            };
+            assert!(matches!(report.value, ValueSummary::Unit));
+            assert_eq!(report.opcode_counters.started_by_opcode[26], 1);
+            assert_eq!(report.opcode_counters.started_by_opcode[19], 0);
+            assert_eq!(report.opcode_counters.started_by_opcode[25], 0);
+            assert_eq!(
+                report.opcode_counters.operations_started,
+                report.opcode_counters.operations_completed
+            );
+            assert_eq!(machine.terminal_facts().unwrap().cleanup_ran, Some(true));
+            assert_eq!(machine.action_snapshot().pending, None);
+        }
+    }
+}
