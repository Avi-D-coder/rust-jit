+
+impl GuestStore {
+    /// Read-only test evidence: each returned object has its actual committed,
+    /// immutable literal root, valid cached leases and exact primitive bytes.
+    pub(crate) fn static_literal_objects_for_test(
+        &self,
+    ) -> Result<Vec<(u64, Vec<u8>)>, Diagnostic> {
+        let mut result = Vec::new();
+        for (key, id) in &self.static_literal_index {
+            let record = self.static_literals.get(*id)?;
+            if &record.key != key {
+                return Err(ownership());
+            }
+            let root = record.root.ok_or_else(ownership)?;
+            self.require_static_root(*id, root)?;
+            let (object, storage) = self.place_object(root)?;
+            let mut bytes = Vec::new();
+            for field in &storage.fields {
+                let value = self.read_scalar(*field)?;
+                value.validate_scalar()?;
+                if value.type_id != 9 || value.payload > u64::from(u8::MAX) {
+                    return Err(ownership());
+                }
+                bytes.push(u8::try_from(value.payload).map_err(|_| ownership())?);
+            }
+            let mut leases = 0usize;
+            for reference in [
+                record.array_reference,
+                record.slice_reference,
+                record.string_reference,
+            ]
+            .into_iter()
+            .flatten()
+            {
+                let reference = self.references.get(reference)?;
+                if reference.root.cell != root {
+                    return Err(ownership());
+                }
+                self.validate_reference_record(reference)?;
+                leases += 1;
+            }
+            if leases == 0 {
+                return Err(ownership());
+            }
+            result.push((object.bits(), bytes));
+        }
+        result.sort_unstable_by_key(|(object, _)| *object);
+        if result.windows(2).any(|pair| pair[0].0 == pair[1].0) {
+            return Err(ownership());
+        }
+        Ok(result)
+    }
+}
