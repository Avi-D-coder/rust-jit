+//! Preregistered original source components; no whole program/diagnostic pass.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::key::OutlineKey,
+    source::{
+        box_type_headers::{BoxPointeeSyntax, BoxTypeRole, capture_box_type_header},
+        changes::SourceSelection,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParsedFile,
+};
+const MOVES: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/tests/ui/moves/moves-sru-moved-field.rs");
+const GENERIC: &str = include_str!(
+    "../../fixtures/upstream/rustc-checkout/tests/ui/type-alias/where-clause-on-generic-type-alias.rs"
+);
+fn parsed(text: &str, edition: u16) -> (ParsedFile, SourceSelection, CfgSet) {
+    let cfg = CfgSet::guest_default();
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    let source = SourceSelection {
+        path: SourcePath::new("propagation.rs").unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(b"disclosed source-only fixture consumer"),
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    (parsed, source, cfg)
+}
+fn definition(
+    parsed: &ParsedFile,
+    source: &SourceSelection,
+    cfg: &CfgSet,
+    name: &str,
+) -> lrr::source::manifest::DefKey {
+    parsed
+        .outline(source.outline.crate_key, vec![], cfg)
+        .unwrap()
+        .items
+        .into_iter()
+        .find(|row| row.def_key.declared_name == name)
+        .unwrap()
+        .def_key
+}
+#[test]
+fn original_box_alias_keeps_declaring_header_and_owning_edition() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (parsed, source, cfg) = parsed(MOVES, edition);
+        let def = definition(&parsed, &source, &cfg, "Noncopyable");
+        let site = capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::AliasTarget)
+            .unwrap();
+        assert_eq!(site.definition(), &def);
+        assert!(matches!(site.pointee(),BoxPointeeSyntax::Name(name) if name=="isize"));
+        assert_eq!(site.source().outline.parse.profile.edition, edition);
+    }
+}
+#[test]
+fn original_box_fields_retain_distinct_dense_schema_ordinals_and_alias_reference() {
+    let (parsed, source, cfg) = parsed(MOVES, 2024);
+    let def = definition(&parsed, &source, &cfg, "Foo");
+    let moved =
+        capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::Field(1)).unwrap();
+    let aliased =
+        capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::Field(2)).unwrap();
+    assert!(matches!(moved.pointee(),BoxPointeeSyntax::Name(name) if name=="isize"));
+    assert_eq!(aliased.box_name(), Some("Noncopyable"));
+    assert_ne!(moved.fingerprint(), aliased.fingerprint());
+}
+#[test]
+fn original_generic_alias_preserves_owner_environment_requirement() {
+    let (parsed, source, cfg) = parsed(GENERIC, 2024);
+    let def = definition(&parsed, &source, &cfg, "Foo");
+    let site =
+        capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::AliasTarget).unwrap();
+    assert!(site.needs_owner_environment());
+    assert!(matches!(site.pointee(),BoxPointeeSyntax::Name(name) if name=="T"));
+}
+#[test]
+fn outside_original_named_return_and_alias_chain_keep_exact_source_type_tokens() {
+    let text = "type Inner=Box<u8>;type Outer=Inner;fn make()->Outer {loop{}}";
+    let (parsed, source, cfg) = parsed(text, 2024);
+    for (name, role, written) in [
+        ("Inner", BoxTypeRole::AliasTarget, "Box<u8>"),
+        ("Outer", BoxTypeRole::AliasTarget, "Inner"),
+        ("make", BoxTypeRole::Result, "Outer"),
+    ] {
+        let def = definition(&parsed, &source, &cfg, name);
+        let site = capture_box_type_header(&parsed, &source, &cfg, &def, role).unwrap();
+        assert_eq!(
+            &text[site.type_range().start as usize..site.type_range().end as usize],
+            written
+        );
+        assert!(!site.type_tokens().is_empty());
+    }
+}
+#[test]
+fn disabled_field_is_omitted_only_from_dense_enabled_field_schema() {
+    let text = "struct Holder{#[cfg(any())] cold:bool,value:Box<u8>,later:i32}";
+    let (parsed, source, cfg) = parsed(text, 2024);
+    let def = definition(&parsed, &source, &cfg, "Holder");
+    let site =
+        capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::Field(0)).unwrap();
+    assert_eq!(
+        &text[site.type_range().start as usize..site.type_range().end as usize],
+        "Box<u8>"
+    );
+    assert_eq!(site.field_name(), Some("value"));
+}
+#[test]
+fn source_alias_cycle_capture_does_not_claim_a_resolved_box_type() {
+    let text = "type A=B;type B=A;fn make()->A{loop{}}";
+    let (parsed, source, cfg) = parsed(text, 2024);
+    for name in ["A", "B"] {
+        let def = definition(&parsed, &source, &cfg, name);
+        let site = capture_box_type_header(&parsed, &source, &cfg, &def, BoxTypeRole::AliasTarget)
+            .unwrap();
+        assert!(matches!(site.pointee(), BoxPointeeSyntax::Unsupported));
+    }
+}
