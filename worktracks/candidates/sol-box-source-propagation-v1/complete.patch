+//! M018 bounded same-module Box alias/field/return source propagation.
+//! These views are not layouts, selected trait witnesses or guest values.
+use super::{BoxPointeeReadiness, CurrentBoxPointee, current_query, source_name};
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{DependencyStamp, InputKey, InputValue},
+        key::QueryKey,
+        memo::Database,
+        poll::QueryPoll,
+        provider::SyntaxProvider,
+        seals::SealKey,
+        value::QueryValue,
+    },
+    frontend::{
+        box_source_admission::compiler_contract::CurrentBoxLibraryContract,
+        compile_input_catalog::CompileInputCatalog, names::NameLookup, types::NominalSchema,
+    },
+    source::{
+        box_type_headers::{BoxPointeeSyntax, BoxTypeHeaderSite, BoxTypeRole},
+        changes::PreparedSourceView,
+        manifest::ItemKind,
+    },
+    syntax::box_source_headers::BoxHeaderRole as Role,
+    traits::term::{GenericArg, TyTerm},
+};
+use std::sync::Arc;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-BOX-SOURCE-VIEW", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "Box source propagation metadata limit".into(),
+    )
+}
+/// Full current origin/pointee/alias/schema records are retained. A view identity
+/// or printed type name cannot reconstruct this privately prepared source packet.
+pub(crate) struct CurrentBoxSourceView {
+    origin: Arc<BoxTypeHeaderSite>,
+    aliases: Vec<Arc<BoxTypeHeaderSite>>,
+    pointee: CurrentBoxPointee,
+    symbolic: TyTerm,
+    schema: Option<Box<NominalSchema>>,
+    dependencies: Vec<DependencyStamp>,
+    query_revision: u64,
+    source_revision: u64,
+    bytes: usize,
+}
+pub(crate) enum BoxViewPreparation {
+    Symbolic(Box<CurrentBoxSourceView>),
+    PointeeRequired(BoxPointeeReadiness),
+    ArrayLengthRequired(Box<BoxViewArrayContinuation>),
+    OwningContextRequired,
+    ForeignSourceRequired,
+    AliasOrBoxTypeRequired,
+}
+pub(crate) enum BoxRuntimeViewRequirement<'a> {
+    /// Exact source-selected Box layout + parameterized nominal frame views are
+    /// required. Descriptor availability alone never completes this requirement.
+    ParameterizedSourceTableAndLayout {
+        source: &'a TyTerm,
+        origin: &'a BoxTypeHeaderSite,
+    },
+    SelectedFieldLayout {
+        owner: Digest,
+        schema: Digest,
+        field: u32,
+        source: &'a TyTerm,
+    },
+    NamedReturnContract {
+        definition: Digest,
+        source: &'a TyTerm,
+    },
+}
+impl CurrentBoxSourceView {
+    pub(crate) fn prepare_current(
+        db: &mut Database,
+        source: &PreparedSourceView,
+        compiler: &CompileInputCatalog,
+        library: &CurrentBoxLibraryContract<'_>,
+        origin: Arc<BoxTypeHeaderSite>,
+        type_seal: &SealKey,
+        byte_limit: usize,
+    ) -> QueryPoll<BoxViewPreparation> {
+        let start = || -> Result<(), Diagnostic> {
+            source.require_original_hygiene()?;
+            library.revalidate(db, source, compiler)?;
+            if origin.source() != source.selection() || byte_limit > 32 << 20 {
+                return Err(fault("Box source view owning source/limit differs"));
+            }
+            Ok(())
+        };
+        if let Err(error) = start() {
+            return QueryPoll::Ready(Err(error));
+        }
+        let mut bytes = match std::mem::size_of::<Self>()
+            .checked_add(origin.metadata_bytes())
+            .filter(|n| *n <= byte_limit)
+        {
+            Some(n) => n,
+            None => return QueryPoll::Ready(Err(limit())),
+        };
+        let mut dependencies = Vec::new();
+        let mut aliases: Vec<Arc<BoxTypeHeaderSite>> = Vec::new();
+        let mut current = origin.clone();
+        let mut schema = None;
+        if let BoxTypeRole::Field(field) = origin.role() {
+            let key = QueryKey::TypeSchema(origin.definition().fingerprint());
+            let outcome = match db.fetch(&SyntaxProvider, key.clone()) {
+                QueryPoll::Ready(Ok(value)) => value,
+                QueryPoll::Ready(Err(error)) => return QueryPoll::Ready(Err(error)),
+                QueryPoll::NeedInput(input) => return QueryPoll::NeedInput(input),
+            };
+            if let Err(error) = current_query(db, &key, &outcome) {
+                return QueryPoll::Ready(Err(error));
+            }
+            let QueryValue::TypeSchema(actual) = outcome.value.as_ref() else {
+                return QueryPoll::Ready(Err(fault(
+                    "Box field source schema query variant differs",
+                )));
+            };
+            if actual.definition != origin.definition().fingerprint()
+                || actual.header != *origin.header()
+                || actual.scope != origin.context().scope
+                || actual.variants.len() != 1
+            {
+                return QueryPoll::Ready(Err(fault(
+                    "Box field current source/schema identity differs",
+                )));
+            }
+            if !actual.generics.is_empty() {
+                return QueryPoll::Ready(Ok(BoxViewPreparation::OwningContextRequired));
+            }
+            let Some(selected) = actual.variants[0].fields.get(field as usize) else {
+                return QueryPoll::Ready(Err(fault(
+                    "Box enabled field ordinal missing from current schema",
+                )));
+            };
+            if selected.ty != origin.type_tokens()
+                || selected.name.as_deref() != origin.field_name()
+            {
+                return QueryPoll::Ready(Err(fault(
+                    "Box selected field name/type/cfg differs from source schema",
+                )));
+            }
+            bytes = match bytes
+                .checked_add(actual.estimated_bytes())
+                .filter(|n| *n <= byte_limit)
+            {
+                Some(n) => n,
+                None => return QueryPoll::Ready(Err(limit())),
+            };
+            if let Err(error) = retain_stamp(
+                &mut dependencies,
+                &mut bytes,
+                byte_limit,
+                DependencyStamp::Query {
+                    key,
+                    fingerprint: outcome.fingerprint,
+                },
+            ) {
+                return QueryPoll::Ready(Err(error));
+            }
+            schema = Some(actual.clone());
+        }
+        loop {
+            if current.needs_owner_environment() || current.context().scope.owner.is_some() {
+                return QueryPoll::Ready(Ok(BoxViewPreparation::OwningContextRequired));
+            }
+            if let Err(error) = capture_site_inputs(
+                db,
+                source,
+                &current,
+                &mut dependencies,
+                &mut bytes,
+                byte_limit,
+            ) {
+                return QueryPoll::Ready(Err(error));
+            }
+            // Only bare original aliases are followed. Unsupported compound/qualified
+            // targets remain requirements; no textual parser or nominal guess is used.
+            if !matches!(current.pointee(), BoxPointeeSyntax::Unsupported)
+                || current.type_tokens().len() != 1
+            {
+                let result = match CurrentBoxPointee::capture_header_current(
+                    db,
+                    source,
+                    compiler,
+                    library,
+                    current.clone(),
+                    type_seal,
+                    byte_limit,
+                ) {
+                    QueryPoll::Ready(Ok(value)) => value,
+                    QueryPoll::Ready(Err(error)) => return QueryPoll::Ready(Err(error)),
+                    QueryPoll::NeedInput(input) => return QueryPoll::NeedInput(input),
+                };
+                let pointee = match result {
+                    BoxPointeeReadiness::Closed(pointee) => pointee,
+                    BoxPointeeReadiness::ArrayLengthRequired(demand) => {
+                        return QueryPoll::Ready(Ok(BoxViewPreparation::ArrayLengthRequired(
+                            Box::new(BoxViewArrayContinuation {
+                                origin,
+                                aliases,
+                                schema,
+                                dependencies,
+                                bytes,
+                                demand: *demand,
+                                query_revision: db.revision(),
+                                source_revision: db.source_revision(),
+                                metadata_limit: byte_limit,
+                            }),
+                        )));
+                    }
+                    other => {
+                        return QueryPoll::Ready(Ok(BoxViewPreparation::PointeeRequired(other)));
+                    }
+                };
+                let finish = || -> Result<Self, Diagnostic> {
+                    pointee.revalidate(db, source, compiler, library)?;
+                    let symbolic = TyTerm::Nominal(
+                        library.header(Role::OwnedBox)?.definition().fingerprint(),
+                        vec![
+                            GenericArg::Type(pointee.term().clone()),
+                            GenericArg::Type(TyTerm::Nominal(
+                                library.header(Role::Global)?.definition().fingerprint(),
+                                vec![],
+                            )),
+                        ],
+                    );
+                    let bytes = bytes
+                        .checked_add(pointee.metadata_bytes())
+                        .and_then(|n| n.checked_add(symbolic.measure()?.1))
+                        .filter(|n| *n <= byte_limit)
+                        .ok_or_else(limit)?;
+                    Ok(Self {
+                        origin,
+                        aliases,
+                        pointee: *pointee,
+                        symbolic,
+                        schema,
+                        dependencies,
+                        query_revision: db.revision(),
+                        source_revision: db.source_revision(),
+                        bytes,
+                    })
+                };
+                return QueryPoll::Ready(
+                    finish().map(|view| BoxViewPreparation::Symbolic(Box::new(view))),
+                );
+            }
+            let Some(name) = current.box_name() else {
+                return QueryPoll::Ready(Ok(BoxViewPreparation::AliasOrBoxTypeRequired));
+            };
+            bytes = match bytes
+                .checked_add(std::mem::size_of::<DependencyStamp>())
+                .filter(|n| *n <= byte_limit && dependencies.len() < 4000)
+            {
+                Some(n) => n,
+                None => return QueryPoll::Ready(Err(limit())),
+            };
+            if dependencies.try_reserve_exact(1).is_err() {
+                return QueryPoll::Ready(Err(limit()));
+            }
+            let found = match source_name(
+                db,
+                source,
+                library,
+                &current,
+                type_seal,
+                name,
+                &mut dependencies,
+                &mut bytes,
+                byte_limit,
+            ) {
+                QueryPoll::Ready(Ok(value)) => value,
+                QueryPoll::Ready(Err(error)) => return QueryPoll::Ready(Err(error)),
+                QueryPoll::NeedInput(input) => return QueryPoll::NeedInput(input),
+            };
+            let NameLookup::Defined(selected) = found else {
+                return QueryPoll::Ready(Ok(BoxViewPreparation::AliasOrBoxTypeRequired));
+            };
+            let Some(item) = source.outline().items.iter().find(|item| {
+                item.def_key.fingerprint() == selected.identity
+                    && item.def_key.crate_key == selected.defining_unit
+                    && item.header.profile.edition == selected.definition_edition
+            }) else {
+                return QueryPoll::Ready(Ok(BoxViewPreparation::ForeignSourceRequired));
+            };
+            if item.def_key.item_kind != ItemKind::TypeAlias {
+                return QueryPoll::Ready(Ok(BoxViewPreparation::AliasOrBoxTypeRequired));
+            }
+            if aliases
+                .iter()
+                .any(|alias| alias.definition() == &item.def_key)
+                || (origin.definition() == &item.def_key
+                    && origin.role() == BoxTypeRole::AliasTarget)
+            {
+                return QueryPoll::Ready(Err(Diagnostic::new(
+                    "LRR-E-TYPE-ALIAS-CYCLE",
+                    format!(
+                        "reached Box source alias cycle at {} after {} steps",
+                        item.def_key.fingerprint(),
+                        aliases.len()
+                    ),
+                )));
+            }
+            if aliases.len() >= 256 {
+                return QueryPoll::Ready(Err(limit()));
+            }
+            let key = QueryKey::TypeAlias(selected.identity);
+            let outcome = match db.fetch(&SyntaxProvider, key.clone()) {
+                QueryPoll::Ready(Ok(value)) => value,
+                QueryPoll::Ready(Err(error)) => return QueryPoll::Ready(Err(error)),
+                QueryPoll::NeedInput(input) => return QueryPoll::NeedInput(input),
+            };
+            if let Err(error) = current_query(db, &key, &outcome) {
+                return QueryPoll::Ready(Err(error));
+            }
+            let QueryValue::TypeAlias(recipe) = outcome.value.as_ref() else {
+                return QueryPoll::Ready(Err(fault("Box alias query variant differs")));
+            };
+            if recipe.definition != selected.identity
+                || recipe.header != item.header
+                || recipe.scope != item.scope
+            {
+                return QueryPoll::Ready(Err(fault(
+                    "Box alias actual source/header/query differs",
+                )));
+            }
+            if !recipe.generics.is_empty() || recipe.scope.owner.is_some() {
+                return QueryPoll::Ready(Ok(BoxViewPreparation::OwningContextRequired));
+            }
+            let site = match source.managed_box_type_header(&item.def_key, BoxTypeRole::AliasTarget)
+            {
+                Ok(site) => site,
+                Err(error) => return QueryPoll::Ready(Err(error)),
+            };
+            if site.type_tokens() != recipe.target {
+                return QueryPoll::Ready(Err(fault(
+                    "Box alias target differs from captured current source",
+                )));
+            }
+            bytes = match bytes
+                .checked_add(site.metadata_bytes())
+                .and_then(|n| n.checked_add(std::mem::size_of::<Arc<BoxTypeHeaderSite>>()))
+                .filter(|n| *n <= byte_limit)
+            {
+                Some(n) => n,
+                None => return QueryPoll::Ready(Err(limit())),
+            };
+            if let Err(error) = retain_stamp(
+                &mut dependencies,
+                &mut bytes,
+                byte_limit,
+                DependencyStamp::Query {
+                    key,
+                    fingerprint: outcome.fingerprint,
+                },
+            ) {
+                return QueryPoll::Ready(Err(error));
+            }
+            if aliases.try_reserve_exact(1).is_err() {
+                return QueryPoll::Ready(Err(limit()));
+            }
+            aliases.push(site.clone());
+            current = site;
+        }
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+        compiler: &CompileInputCatalog,
+        library: &CurrentBoxLibraryContract<'_>,
+    ) -> Result<(), Diagnostic> {
+        self.pointee.revalidate(db, source, compiler, library)?;
+        if self.origin.source() != source.selection()
+            || self.query_revision != db.revision()
+            || self.source_revision != db.source_revision()
+        {
+            return Err(fault(
+                "Box source view publication/owner changed; recapture required",
+            ));
+        }
+        for stamp in &self.dependencies {
+            let current = match stamp {
+                DependencyStamp::Input { key, fingerprint } => db
+                    .published_input(key)
+                    .is_some_and(|(_, actual)| actual == *fingerprint),
+                DependencyStamp::Query { key, fingerprint } => db.memo(key).is_some_and(|memo| {
+                    memo.verified_revision == db.revision() && memo.fingerprint == *fingerprint
+                }),
+            };
+            if !current {
+                return Err(fault("Box alias/field/return source dependency changed"));
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn pointee(&self) -> &CurrentBoxPointee {
+        &self.pointee
+    }
+    pub(crate) fn symbolic(&self) -> &TyTerm {
+        &self.symbolic
+    }
+    pub(crate) fn origin(&self) -> &BoxTypeHeaderSite {
+        &self.origin
+    }
+    pub(crate) fn alias_origins(&self) -> &[Arc<BoxTypeHeaderSite>] {
+        &self.aliases
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/current-propagated-box-source-view");
+        e.record(self.origin.as_ref());
+        e.sequence(&self.aliases, |e, alias| e.record(alias.as_ref()));
+        e.digest(self.pointee.identity());
+        e.record(&self.symbolic);
+        e.option(&self.schema, |e, schema| e.record(schema.as_ref()));
+        e.sequence(&self.dependencies, |e, stamp| e.record(stamp));
+        e.u64(self.query_revision);
+        e.u64(self.source_revision);
+        e.finish()
+    }
+    pub(crate) fn runtime_requirement(&self) -> Result<BoxRuntimeViewRequirement<'_>, Diagnostic> {
+        Ok(match self.origin.role() {
+            BoxTypeRole::Field(field) => BoxRuntimeViewRequirement::SelectedFieldLayout {
+                owner: self.origin.definition().fingerprint(),
+                schema: self
+                    .schema
+                    .as_ref()
+                    .ok_or_else(|| fault("Box field view lacks actual retained schema"))?
+                    .fingerprint(),
+                field,
+                source: &self.symbolic,
+            },
+            BoxTypeRole::Result => BoxRuntimeViewRequirement::NamedReturnContract {
+                definition: self.origin.definition().fingerprint(),
+                source: &self.symbolic,
+            },
+            _ => BoxRuntimeViewRequirement::ParameterizedSourceTableAndLayout {
+                source: &self.symbolic,
+                origin: &self.origin,
+            },
+        })
+    }
+}
+fn retain_stamp(
+    deps: &mut Vec<DependencyStamp>,
+    bytes: &mut usize,
+    byte_limit: usize,
+    stamp: DependencyStamp,
+) -> Result<(), Diagnostic> {
+    let next = bytes
+        .checked_add(std::mem::size_of::<DependencyStamp>())
+        .and_then(|n| n.checked_add(stamp.heap_bytes()))
+        .filter(|n| *n <= byte_limit && deps.len() < 4000)
+        .ok_or_else(limit)?;
+    deps.try_reserve_exact(1).map_err(|_| limit())?;
+    deps.push(stamp);
+    *bytes = next;
+    Ok(())
+}
+fn capture_site_inputs(
+    db: &Database,
+    source: &PreparedSourceView,
+    site: &BoxTypeHeaderSite,
+    deps: &mut Vec<DependencyStamp>,
+    bytes: &mut usize,
+    byte_limit: usize,
+) -> Result<(), Diagnostic> {
+    let item = source
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key == *site.definition())
+        .ok_or_else(|| fault("Box view current source site absent"))?;
+    if item.header != *site.header()
+        || item.scope != site.context().scope
+        || item.declaration_span != site.context().range
+        || item.body.as_ref() != site.body()
+    {
+        return Err(fault("Box alias/field/return source context differs"));
+    }
+    for key in [
+        InputKey::CapturedSource(source.selection().location_identity()),
+        InputKey::DefinitionSource(site.definition().fingerprint()),
+        InputKey::DefinitionHeader(site.definition().fingerprint()),
+        InputKey::DeclarationContext(site.definition().fingerprint()),
+    ] {
+        let (value, fingerprint) = db
+            .published_input(&key)
+            .ok_or_else(|| fault("Box view actual source publication absent"))?;
+        let matches = match value {
+            InputValue::CapturedSource(value) => value == source.selection(),
+            InputValue::DefinitionSource(value) => value == &source.selection().outline.parse,
+            InputValue::DefinitionHeader(value) => value == site.header(),
+            InputValue::DeclarationContext(value) => value == site.context(),
+            _ => false,
+        };
+        if !matches {
+            return Err(fault("Box view source publication variant/context differs"));
+        }
+        retain_stamp(
+            deps,
+            bytes,
+            byte_limit,
+            DependencyStamp::Input { key, fingerprint },
+        )?;
+    }
+    Ok(())
+}
+
+/// Immutable source-only suspension state, no guest operand/owner/resources.
+/// The driver supplies current opaque library/source proof again after resume.
+pub(crate) struct BoxViewArrayContinuation {
+    origin: Arc<BoxTypeHeaderSite>,
+    aliases: Vec<Arc<BoxTypeHeaderSite>>,
+    schema: Option<Box<NominalSchema>>,
+    dependencies: Vec<DependencyStamp>,
+    bytes: usize,
+    demand: super::CurrentBoxArrayLengthDemand,
+    query_revision: u64,
+    source_revision: u64,
+    metadata_limit: usize,
+}
+impl BoxViewArrayContinuation {
+    pub(crate) fn fetch_current(
+        self,
+        db: &mut Database,
+        source: &PreparedSourceView,
+        compiler: &CompileInputCatalog,
+        library: &CurrentBoxLibraryContract<'_>,
+        limits: crate::frontend::constants::ConstLimits,
+        query_byte_limit: usize,
+    ) -> QueryPoll<CurrentBoxSourceView> {
+        if self.query_revision != db.revision()
+            || self.source_revision != db.source_revision()
+            || self.origin.source() != source.selection()
+        {
+            return QueryPoll::Ready(Err(fault(
+                "Box alias array continuation changed publication; recapture required",
+            )));
+        }
+        if let Err(error) = library.revalidate(db, source, compiler) {
+            return QueryPoll::Ready(Err(error));
+        }
+        for stamp in &self.dependencies {
+            let current = match stamp {
+                DependencyStamp::Input { key, fingerprint } => db
+                    .published_input(key)
+                    .is_some_and(|(_, actual)| actual == *fingerprint),
+                DependencyStamp::Query { key, fingerprint } => db.memo(key).is_some_and(|memo| {
+                    memo.verified_revision == db.revision() && memo.fingerprint == *fingerprint
+                }),
+            };
+            if !current {
+                return QueryPoll::Ready(Err(fault(
+                    "Box alias array continuation source dependency changed",
+                )));
+            }
+        }
+        let pointee =
+            match self
+                .demand
+                .fetch_current(db, source, compiler, library, limits, query_byte_limit)
+            {
+                QueryPoll::Ready(Ok(value)) => value,
+                QueryPoll::Ready(Err(error)) => return QueryPoll::Ready(Err(error)),
+                QueryPoll::NeedInput(input) => return QueryPoll::NeedInput(input),
+            };
+        let finish = || -> Result<CurrentBoxSourceView, Diagnostic> {
+            pointee.revalidate(db, source, compiler, library)?;
+            let symbolic = TyTerm::Nominal(
+                library.header(Role::OwnedBox)?.definition().fingerprint(),
+                vec![
+                    GenericArg::Type(pointee.term().clone()),
+                    GenericArg::Type(TyTerm::Nominal(
+                        library.header(Role::Global)?.definition().fingerprint(),
+                        vec![],
+                    )),
+                ],
+            );
+            let bytes = self
+                .bytes
+                .checked_add(pointee.metadata_bytes())
+                .and_then(|n| n.checked_add(symbolic.measure()?.1))
+                .filter(|n| *n <= self.metadata_limit)
+                .ok_or_else(limit)?;
+            Ok(CurrentBoxSourceView {
+                origin: self.origin,
+                aliases: self.aliases,
+                pointee,
+                symbolic,
+                schema: self.schema,
+                dependencies: self.dependencies,
+                query_revision: db.revision(),
+                source_revision: db.source_revision(),
+                bytes,
+            })
+        };
+        QueryPoll::Ready(finish())
+    }
+}
