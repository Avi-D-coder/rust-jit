+#[test]
+fn unchanged_crlf_as_bytes_operand_requires_current_source_and_publishes_once_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(BYTE_VIEW_CRLF, edition, 100_000);
+        let contexts = macros.contexts().unwrap();
+        let (id, source, destination) = reach_string_method(&mut db, &mut run, &contexts, 46);
+        let receiver = run.frame.cell(source).unwrap();
+        let value = run.store.admit_move(receiver).unwrap();
+        let source_view = run.frame.source_view(source).unwrap().unwrap();
+        let TyTerm::Ref(region, false, target) = source_view else {
+            panic!("original shared str receiver")
+        };
+        assert_eq!(*target, TyTerm::Str);
+        let expected = TyTerm::Ref(
+            region,
+            false,
+            Box::new(TyTerm::Slice(Box::new(TyTerm::Primitive(
+                PrimitiveType::U8,
+            )))),
+        );
+        assert_eq!(run.frame.counters().started_by_opcode[26], 3); // preceding real assertions
+        let before = effects(&run);
+        run.revalidate_primitive_method(&mut db, &contexts, id)
+            .unwrap();
+        assert_eq!(effects(&run), before);
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+        assert_eq!(run.frame.source_view(destination).unwrap(), Some(expected));
+        run.store
+            .require_static_byte_value(run.frame.cell(destination).unwrap(), None)
+            .unwrap();
+        assert_eq!(run.store.admit_move(receiver).unwrap(), value);
+        assert_eq!(run.frame.counters().started_by_opcode[46], 1);
+        assert_eq!(run.frame.counters().operations_started, before.0 + 1);
+        assert_eq!(
+            run.frame.counters().operations_started,
+            run.frame.counters().operations_completed
+        );
+        db.finish_run().unwrap();
+    }
+    // Original evaluated member operand only; later include_str/contains are not exercised.
+}
+#[test]
+fn original_as_bytes_member_and_vm_refuse_mutable_receiver_or_wrong_result_source_before_effects() {
+    let (mut db, mut run, macros, _) = tests::start_source(BYTE_VIEW_CRLF, 2024, 100_000);
+    let contexts = macros.contexts().unwrap();
+    let (id, source, _) = reach_string_method(&mut db, &mut run, &contexts, 46);
+    let used = run.frame.fuel_snapshot().used;
+    run.frame
+        .set_source_view(
+            source,
+            Some(TyTerm::Ref(RegionTerm::Static, true, Box::new(TyTerm::Str))),
+        )
+        .unwrap();
+    let before = effects(&run);
+    assert!(
+        run.revalidate_primitive_method(&mut db, &contexts, id)
+            .is_err()
+    );
+    assert_eq!(
+        step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap()
+        )
+        .unwrap_err()
+        .code,
+        "LRR-E-INTERNAL-IR"
+    );
+    assert_eq!(effects(&run), before);
+    db.finish_run().unwrap();
+    // A separate original run avoids reusing a faulted VM frame.
+    let (mut db, mut run, macros, _) = tests::start_source(BYTE_VIEW_CRLF, 2024, 100_000);
+    let contexts = macros.contexts().unwrap();
+    let (id, _, destination) = reach_string_method(&mut db, &mut run, &contexts, 46);
+    run.frame
+        .set_source_view(
+            destination,
+            Some(TyTerm::Ref(
+                RegionTerm::Static,
+                false,
+                Box::new(TyTerm::Str),
+            )),
+        )
+        .unwrap();
+    let before = effects(&run);
+    assert_eq!(
+        step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap()
+        )
+        .unwrap_err()
+        .code,
+        "LRR-E-TYPE-CONTEXT"
+    );
+    assert_eq!(effects(&run), before);
+    db.finish_run().unwrap();
+    // Poison only the source region; equal physical layout/backing cannot
+    // make an old method receipt authorize a different source borrow.
+    let (mut db, mut run, macros, _) = tests::start_source(BYTE_VIEW_CRLF, 2024, 100_000);
+    let contexts = macros.contexts().unwrap();
+    let (id, source, _) = reach_string_method(&mut db, &mut run, &contexts, 46);
+    run.frame
+        .set_source_view(
+            source,
+            Some(TyTerm::Ref(
+                RegionTerm::Param(crate::traits::term::ParamKey {
+                    definition: run.frame.body.body().definition,
+                    ordinal: 0,
+                }),
+                false,
+                Box::new(TyTerm::Str),
+            )),
+        )
+        .unwrap();
+    let before = effects(&run);
+    assert!(
+        run.revalidate_primitive_method(&mut db, &contexts, id)
+            .is_err()
+    );
+    assert_eq!(effects(&run), before);
+    db.finish_run().unwrap();
+    let (mut db, mut run, macros, _) = tests::start_source(BYTE_VIEW_CRLF, 2024, used);
+    let contexts = macros.contexts().unwrap();
+    let (id, _, _) = reach_string_method(&mut db, &mut run, &contexts, 46);
+    assert_eq!(run.frame.fuel_snapshot().used, used);
+    let before = effects(&run);
+    assert_eq!(
+        step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap()
+        )
+        .unwrap_err()
+        .code,
+        "LRR-E-RUNTIME-RESOURCE"
+    );
+    assert_eq!(
+        run.frame.fuel_snapshot().stop,
+        Some(crate::vm::fuel::FuelStop::Exhausted)
+    );
+    assert_eq!(effects(&run), before);
+    assert_eq!(run.frame.counters().started_by_opcode[46], 0);
+    db.finish_run().unwrap();
+}
