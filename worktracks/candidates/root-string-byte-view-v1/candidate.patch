+fn string_byte_view(
+    frame: &Frame,
+    store: &GuestStore,
+    source: crate::ir::pc::SlotId,
+    destination: crate::ir::pc::SlotId,
+) -> Result<
+    (
+        crate::runtime::cell::byte_literals::PreparedStaticStringBytes,
+        crate::traits::term::TyTerm,
+    ),
+    Diagnostic,
+> {
+    use crate::traits::term::TyTerm;
+    frame.require_store(store)?;
+    if source == destination {
+        return Err(invalid("str byte view cannot overwrite its receiver"));
+    }
+    let Some(TyTerm::Ref(region, false, target)) = frame.source_view_ref(source)? else {
+        return Err(invalid("str byte view requires its shared source receiver"));
+    };
+    if target.as_ref() != &TyTerm::Str {
+        return Err(invalid("str byte view requires str source identity"));
+    }
+    // A static physical backing cannot strengthen a source borrow lifetime.
+    let result = TyTerm::Ref(
+        region.clone(),
+        false,
+        Box::new(TyTerm::Slice(Box::new(TyTerm::Primitive(
+            PrimitiveType::U8,
+        )))),
+    );
+    if frame
+        .source_view_ref(destination)?
+        .is_some_and(|prior| prior != &result)
+    {
+        return Err(Diagnostic::new(
+            "LRR-E-TYPE-CONTEXT",
+            "str byte view result conflicts with retained source context".into(),
+        ));
+    }
+    frame.preflight_source_view(destination, Some(&result))?;
+    let plan = store.prepare_static_string_bytes(
+        frame.cell(source)?,
+        frame.literal_destination_needs_cell(destination)?,
+    )?;
+    frame.preflight_write_type(destination, plan.reference_type(), store)?;
+    Ok((plan, result))
+}
