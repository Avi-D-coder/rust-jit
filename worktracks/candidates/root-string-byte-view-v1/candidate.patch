+//! A shared byte-slice view of a genuine immutable UTF-8 string root.
+//! No content copy, new root, UTF-8 inference, or source lifetime authority.
+use super::*;
+
+pub(crate) struct PreparedStaticStringBytes {
+    session: StoreSession,
+    epoch: u32,
+    source: CellStamp,
+    source_value: ValueRepr,
+    root: CellStamp,
+    literal: StaticLiteralId,
+    existing: Option<RefId>,
+    array_type: TypeId,
+    target_type: TypeId,
+    reference_type: TypeId,
+    needs_cell: bool,
+}
+impl PreparedStaticStringBytes {
+    pub(crate) fn reference_type(&self) -> TypeId {
+        self.reference_type
+    }
+}
+impl GuestStore {
+    pub(crate) fn prepare_static_string_bytes(
+        &self,
+        source: CellId,
+        needs_cell: bool,
+    ) -> Result<PreparedStaticStringBytes, Diagnostic> {
+        self.require_static_string_value(source)?;
+        let reference = self.references.get(self.reference_from_cell(source)?)?;
+        let literal = reference.static_slice.ok_or_else(lease_fault)?;
+        let root_type = self.place_type(reference.root.cell)?;
+        let TypeKey::Array { element, len } = self.types.descriptor(root_type)?.key.as_ref() else {
+            return Err(lease_fault());
+        };
+        if *element != TypeId(9) {
+            return Err(lease_fault());
+        }
+        let types = self
+            .types
+            .preview_byte_literal_types(*len, ByteLiteralTarget::Slice)?;
+        if types.array != root_type {
+            return Err(lease_fault());
+        }
+        let plan = PreparedStaticStringBytes {
+            session: self.pattern_binding_session,
+            epoch: self.budget.epoch(),
+            source: self.place_stamp(source)?,
+            source_value: self.admit_move(source)?,
+            root: reference.root,
+            literal,
+            existing: self.static_literals.get(literal)?.slice_reference,
+            array_type: types.array,
+            target_type: types.target,
+            reference_type: types.reference,
+            needs_cell,
+        };
+        drop(types);
+        self.preflight_static_string_bytes(&plan)?;
+        Ok(plan)
+    }
+    fn preflight_static_string_bytes(
+        &self,
+        plan: &PreparedStaticStringBytes,
+    ) -> Result<(ByteHintTypes, TypeId, TypeId), Diagnostic> {
+        if plan.session != self.pattern_binding_session
+            || plan.epoch != self.budget.epoch()
+            || self.place_stamp(plan.source.cell)? != plan.source
+            || self.admit_move(plan.source.cell)? != plan.source_value
+        {
+            return Err(stale());
+        }
+        self.require_static_string_value(plan.source.cell)?;
+        let source = self
+            .references
+            .get(self.reference_from_cell(plan.source.cell)?)?;
+        if source.root != plan.root
+            || source.static_slice != Some(plan.literal)
+            || self.static_literals.get(plan.literal)?.slice_reference != plan.existing
+        {
+            return Err(stale());
+        }
+        self.require_static_root(plan.literal, plan.root.cell)?;
+        let root_type = self.place_type(plan.root.cell)?;
+        let TypeKey::Array { element, len } = self.types.descriptor(root_type)?.key.as_ref() else {
+            return Err(lease_fault());
+        };
+        if *element != TypeId(9) || root_type != plan.array_type {
+            return Err(lease_fault());
+        }
+        // Rebuild a current descriptor batch. If another descriptor publication
+        // shifted predicted IDs, reject before reservations or view publication.
+        let types = self
+            .types
+            .preview_byte_literal_types(*len, ByteLiteralTarget::Slice)?;
+        if (types.array, types.target, types.reference)
+            != (plan.array_type, plan.target_type, plan.reference_type)
+        {
+            return Err(stale());
+        }
+        if let Some(id) = plan.existing {
+            let reference = self.references.get(id)?;
+            self.validate_reference_record(reference)?;
+            if reference.root != plan.root
+                || reference.final_cell != plan.root
+                || reference.target != types.target
+                || reference.access != Access::Shared
+                || reference.static_slice != Some(plan.literal)
+                || !reference.enclosing.is_empty()
+            {
+                return Err(lease_fault());
+            }
+        }
+        let hints = self.types.preview_byte_hint_types(None)?;
+        let lease = usize::from(plan.existing.is_none());
+        let cells = usize::from(plan.needs_cell);
+        let handles = u32::try_from(
+            lease
+                .checked_add(cells)
+                .and_then(|n| n.checked_add(1))
+                .ok_or_else(resource)?,
+        )
+        .map_err(|_| resource())?;
