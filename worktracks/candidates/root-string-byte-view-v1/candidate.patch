+#[test]
+fn unchanged_string_operands_as_bytes_share_one_root_and_cached_slice_lease_all_editions() {
+    use crate::{
+        core::profile::ProfileIdentity, source::snapshot::SourceBlob, syntax::parse::ParsedFile,
+    };
+    use ra_ap_syntax::{AstNode, AstToken, ast};
+    const ORIGINAL: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/array-slice-vec/estr-slice.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap(),
+            ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            },
+        )
+        .unwrap();
+        assert!(parsed.errors.is_empty());
+        let values: Vec<_> = parsed
+            .parsed
+            .tree()
+            .syntax()
+            .descendants()
+            .filter_map(ast::LetStmt::cast)
+            .filter_map(|binding| {
+                let ast::Expr::Literal(literal) = binding.initializer()? else {
+                    return None;
+                };
+                Some(
+                    ast::String::cast(literal.token())?
+                        .value()
+                        .unwrap()
+                        .into_owned(),
+                )
+            })
+            .collect();
+        assert_eq!(values.len(), 8);
+        let mut store = store();
+        for (i, text) in values.iter().enumerate() {
+            let source = operand(
+                &mut store,
+                format!("original-{i}").as_bytes(),
+                text.as_bytes(),
+                ByteLiteralTarget::Str,
+            );
+            let value = store.admit_move(source).unwrap();
+            let root = store
+                .references
+                .get(store.reference_from_cell(source).unwrap())
+                .unwrap()
+                .root;
+            let (object, storage) = store.place_object(root.cell).unwrap();
+            let fields = storage.fields.clone();
+            let before = (
+                store.budget.handles(),
+                store.budget.bytes(),
+                store.type_metadata_bytes(),
+            );
+            let plan = store.prepare_static_string_bytes(source, false).unwrap();
+            let reference_type = plan.reference_type();
+            assert_eq!(
+                before,
+                (
+                    store.budget.handles(),
+                    store.budget.bytes(),
+                    store.type_metadata_bytes()
+                )
+            );
+            let ticket = store.instantiate_static_string_bytes(plan).unwrap();
+            let bytes = store.peek_ticket(ticket).unwrap();
+            assert_eq!(bytes.type_id, reference_type.0);
+            let reference = RefId::from_bits(bytes.payload);
+            let actual = store.references.get(reference).unwrap();
+            assert_eq!(actual.root, root);
+            assert_eq!(actual.final_cell, root);
+            assert_eq!(actual.access, Access::Shared);
+            assert!(
+                matches!(store.types.descriptor(actual.target).unwrap().key.as_ref(),TypeKey::Slice{element} if *element==TypeId(9))
+            );
+            store.discard(ticket).unwrap();
+            let next = store.prepare_static_string_bytes(source, false).unwrap();
+            let handles = store.budget.handles();
+            let ticket = store.instantiate_static_string_bytes(next).unwrap();
+            assert_eq!(store.peek_ticket(ticket).unwrap().payload, reference.bits());
+            assert_eq!(store.budget.handles(), handles + 1); // only the new transfer ticket
+            store.discard(ticket).unwrap();
+            assert_eq!(store.admit_move(source).unwrap(), value);
+            let (after_object, after_storage) = store.place_object(root.cell).unwrap();
+            assert_eq!(after_object, object);
+            assert_eq!(after_storage.fields, fields);
+        }
+    }
