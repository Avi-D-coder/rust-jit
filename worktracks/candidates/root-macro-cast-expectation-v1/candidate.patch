+//! Actual stock cast execution; prefix controls are not whole-fixture passes.
+use super::*;
+const CASTS: &str =
+    include_str!("../../../../fixtures/upstream/rustc-checkout/tests/ui/cast/cast.rs");
+const U8_CHAR: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/cast/u8-to-char-cast-9918.rs"
+);
+#[test]
+fn unchanged_cast_main_executes_seven_assertions_before_its_raw_pointer_frontier_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(CASTS, edition, 10_000);
+        let contexts = macros.contexts().unwrap();
+        let RunPoll::Fault(error) = run.poll_with_runtime_macros(&mut db, &contexts) else {
+            panic!("unchanged cast main raw-pointer frontier was not reached");
+        };
+        assert_eq!(error.code, "LRR-E-UNSUPPORTED");
+        assert_eq!(
+            error.message,
+            "cast target requires symbolic type resolution"
+        );
+        let pc = run.frame.pc();
+        let span = run.frame.body.span(NodeId(pc.node)).unwrap();
+        let body = run.sources[0]
+            .outline()
+            .items
+            .iter()
+            .filter_map(|item| item.body.as_ref())
+            .find(|body| body.key() == pc.body)
+            .unwrap();
+        assert_eq!(
+            &CASTS[(body.range.start + span.relative_start) as usize
+                ..(body.range.start + span.relative_end) as usize],
+            "x as *const _"
+        );
+        assert_eq!(run.frame.counters().started_by_opcode[26], 7);
+        assert_eq!(run.frame.counters().started_by_opcode[12], 13);
+        assert_eq!(
+            run.frame.counters().operations_started,
+            run.frame.counters().operations_completed
+        );
+        db.finish_run().unwrap();
+    }
+    // Actual unchanged prefix only. Pointer inference/library effects remain required.
+}
+#[test]
+fn unchanged_u8_character_cast_entire_main_completes_once_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(U8_CHAR, edition, 10_000);
+        let contexts = macros.contexts().unwrap();
+        let report = match run.poll_with_runtime_macros(&mut db, &contexts) {
+            RunPoll::Completed(report) => report,
+            RunPoll::Fault(error) => panic!("unchanged u8 char main/{edition}: {error}"),
+            RunPoll::NeedInput(input) => panic!("unchanged u8 char main/{edition}: {input:?}"),
+            RunPoll::Panicked(report) => panic!("unchanged u8 char main/{edition}: {report:?}"),
+        };
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(report.opcode_counters.started_by_opcode[26], 1);
+        assert_eq!(report.opcode_counters.started_by_opcode[12], 1);
+        assert_eq!(
+            report.opcode_counters.operations_started,
+            report.opcode_counters.operations_completed
+        );
+        db.finish_run().unwrap();
+    }
+}
