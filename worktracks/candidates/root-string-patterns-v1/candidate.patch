+fn original_string_pattern_literal_requires_own_match_slot_and_entry_before_effects() {
+    const ORIGINAL: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/match/match-borrowed-str.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap(),
+            ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            },
+        )
+        .unwrap();
+        let outline = parsed
+            .outline(Digest([247; 32]), vec![], &CfgSet::guest_default())
+            .unwrap();
+        let body = outline
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == "compare")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap();
+        let index = parsed.index_body(body, Default::default()).unwrap();
+        let node = index
+            .nodes()
+            .iter()
+            .find(|node| node.string_pattern_phase)
+            .unwrap();
+        let key = index.pc(node.id, Phase::Entry).unwrap();
+        let recipe = parsed.initial_thunk(body, &index, &key).unwrap();
+        let [
+            Op::Literal {
+                literal,
+                destination,
+                ..
+            },
+        ] = recipe.recipe().operations.as_ref()
+        else {
+            panic!("original pattern literal must have its own dispatch")
+        };
+        let (mut frame, mut store) = frame(&index, &recipe);
+        let before = (
+            store.budget().handles(),
+            store.budget().bytes(),
+            store.type_metadata_bytes(),
+            frame.fuel_snapshot(),
+            frame.counters().operations_started,
+        );
+        prepare(&frame, &store, literal, *destination, None).unwrap();
+        assert!(prepare(&frame, &store, literal, SlotId(u32::MAX), None).is_err());
+        let mut wrong = literal.clone();
+        wrong.source.relative_end += 1;
+        assert!(prepare(&frame, &store, &wrong, *destination, None).is_err());
+        assert_eq!(
+            (
+                store.budget().handles(),
+                store.budget().bytes(),
+                store.type_metadata_bytes(),
+                frame.fuel_snapshot(),
+                frame.counters().operations_started
