+// Only result expressions join this numeric island. Scrutinees, patterns and
+// guards are independent constraints and must never supply a result default.
+// This is a soft expectation: suffixes, names, calls, attributes or mixed result
+// families leave the normal reached constraint path intact, without diagnostics.
+fn result_island(expression: &ast::Expr) -> Result<Option<PrimitiveType>, Diagnostic> {
+    let mut pending = Vec::new();
+    pending
+        .try_reserve_exact(1)
+        .map_err(|_| crate::runtime::arena::resource())?;
+    pending.push(expression.clone());
+    let mut visited = 0usize;
+    let mut family = None;
+    while let Some(expression) = pending.pop() {
+        source_work(&mut visited)?;
+        if expression
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()))
+        {
+            return Ok(None);
+        }
+        match expression {
+            ast::Expr::ParenExpr(group) => {
+                let Some(inner) = group.expr() else {
+                    return Ok(None);
+                };
+                pending
+                    .try_reserve(1)
+                    .map_err(|_| crate::runtime::arena::resource())?;
+                pending.push(inner);
+            }
+            ast::Expr::MatchExpr(matched) => {
+                let Some(list) = matched.match_arm_list() else {
+                    return Ok(None);
+                };
+                let mut count = 0usize;
+                for arm in list.arms() {
+                    source_work(&mut visited)?;
+                    count = count.checked_add(1).filter(|n| *n <= 4096).ok_or_else(|| {
+                        Diagnostic::new("LRR-E-METADATA-LIMIT", "numeric result arm limit".into())
+                    })?;
+                    if arm
+                        .syntax()
+                        .children()
+                        .any(|node| ast::Attr::can_cast(node.kind()))
+                    {
+                        return Ok(None);
+                    }
+                    let Some(result) = arm.expr() else {
+                        return Ok(None);
+                    };
+                    if pending.len() >= 4096 {
+                        return Err(Diagnostic::new(
+                            "LRR-E-METADATA-LIMIT",
+                            "numeric result work limit".into(),
+                        ));
+                    }
+                    pending
+                        .try_reserve(1)
+                        .map_err(|_| crate::runtime::arena::resource())?;
+                    pending.push(result);
+                }
+                if count == 0 {
+                    return Ok(None);
+                }
+            }
+            _ => {
+                let Some(next) = literal_only_with_work(&expression, &mut visited)? else {
+                    return Ok(None);
+                };
+                if family.is_some_and(|old| old != next) {
+                    return Ok(None);
+                }
+                family = Some(next);
+            }
+        }
+    }
+    Ok(family)
+}
+
+// A literal scrutinee is an independent inference island only when every
+// source pattern is unconstrained numeric syntax (or wildcard). A suffixed or
+// named bound must retain its ordinary source constraint instead of defaulting.
+pub(super) fn match_scrutinee(
+    expression: &ast::MatchExpr,
+) -> Result<Option<PrimitiveType>, Diagnostic> {
+    use ra_ap_syntax::ast::RangeItem;
+    let Some(scrutinee) = expression.expr() else {
+        return Ok(None);
+    };
+    let mut visited = 0usize;
+    let Some(family) = literal_only_with_work(&scrutinee, &mut visited)? else {
+        return Ok(None);
+    };
+    let Some(list) = expression.match_arm_list() else {
+        return Ok(None);
+    };
+    for arm in list.arms() {
+        source_work(&mut visited)?;
+        if arm
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()))
+        {
+            return Ok(None);
+        }
+        let Some(pattern) = arm.pat() else {
+            return Ok(None);
+        };
+        if pattern
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()))
+        {
+            return Ok(None);
+        }
+        let endpoints = match pattern {
+            ast::Pat::WildcardPat(_) => continue,
+            ast::Pat::LiteralPat(literal) => [Some(ast::Pat::LiteralPat(literal)), None],
+            ast::Pat::RangePat(range) => [range.start(), range.end()],
+            _ => return Ok(None),
+        };
+        for endpoint in endpoints.into_iter().flatten() {
+            source_work(&mut visited)?;
+            let ast::Pat::LiteralPat(endpoint) = endpoint else {
+                return Ok(None);
+            };
+            let Some(literal) = endpoint.literal() else {
+                return Ok(None);
+            };
+            let compatible = match literal.token().kind() {
+                SyntaxKind::INT_NUMBER => {
+                    family == PrimitiveType::I32
+                        && ast::IntNumber::cast(literal.token())
+                            .is_some_and(|number| number.suffix().is_none())
+                }
+                SyntaxKind::FLOAT_NUMBER => {
+                    family == PrimitiveType::F64
+                        && ast::FloatNumber::cast(literal.token())
+                            .is_some_and(|number| number.suffix().is_none())
+                }
+                _ => false,
+            };
+            if !compatible {
+                return Ok(None);
+            }
+        }
+    }
+    Ok(Some(family))
+}
