+// Run an original function without rewriting its source or calling it a main /
+// full-fixture pass. Its fourth assertion still requires static storage support.
+#[test]
+fn unchanged_overlapping_match_function_runs_three_assertions_before_static_frontier_all_editions()
+{
+    const TEXT: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/match/overeager-sub-match-pruning-13027.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let (_, machine, outcome) = run_entry(
+            TEXT,
+            edition,
+            100_000,
+            "lit_shadow_range",
+            "tests/ui/match/overeager-sub-match-pruning-13027.rs",
+        );
+        let RunPoll::Fault(error) = outcome else {
+            panic!("unchanged static frontier was skipped");
+        };
+        assert_eq!(error.code, "LRR-E-UNSUPPORTED");
+        assert_eq!(
+            error.message,
+            "assertion constant path requires current source query preparation"
+        );
+        let counters = machine.opcode_counters().unwrap();
+        assert_eq!(counters.started_by_opcode[26], 3);
+        assert_eq!(counters.started_by_opcode[25], 0);
+        assert_eq!(counters.started_by_opcode[19], 1);
+        assert_eq!(machine.action_snapshot().published, 1);
+        assert_eq!(machine.action_snapshot().consumed, 1);
+        assert_eq!(machine.action_snapshot().pending, None);
+        let span = machine.diagnostic_current_span().unwrap();
+        // The exact error remains attached to the original fourth assertion.
+        let origin = machine
+            .diagnostic_source_origin(&span, 4096)
+            .unwrap()
+            .unwrap();
+        assert!(
+            TEXT[origin.range.start as usize..origin.range.end as usize].contains("match CONST")
+        );
+    }
+}
