+#[test]
+fn local_import_qualified_generic_and_unproven_pattern_context_stays_closed() {
+    for (source, name) in [
+        ("const N:usize=42;fn f(x:u32){let N=1;let _=[0;N];}", "f"),
+        (
+            "mod provider{pub const N:usize=42;}use provider::N;fn f(x:u32)->[u8;N]{loop{}}",
