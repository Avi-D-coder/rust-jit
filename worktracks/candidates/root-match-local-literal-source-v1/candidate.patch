+//! Complete unchanged upstream runtime contract, separate from LRR source controls.
+use super::*;
+const ORIGINAL: &str =
+    include_str!("../../../../fixtures/upstream/rustc-checkout/tests/ui/match/issue-26251.rs");
+#[test]
+fn unchanged_guarded_char_local_entire_main_takes_second_arm_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(ORIGINAL, edition, 10_000);
+        let contexts = macros.contexts().unwrap();
+        let report = match run.poll_with_runtime_macros(&mut db, &contexts) {
+            RunPoll::Completed(report) => report,
+            RunPoll::Fault(error) => panic!("original char local main/{edition}: {error}"),
+            RunPoll::NeedInput(input) => panic!("original char local main/{edition}: {input:?}"),
+            RunPoll::Panicked(report) => panic!("original char local main/{edition}: {report:?}"),
+        };
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(report.opcode_counters.started_by_opcode[26], 1);
+        assert_eq!(report.opcode_counters.started_by_opcode[10], 4);
+        assert_eq!(report.opcode_counters.started_by_opcode[25], 0);
+        assert_eq!(
+            report.opcode_counters.operations_started,
+            report.opcode_counters.operations_completed
+        );
+        assert!(run.frame.active_scopes().is_empty());
+        let inventory = run.store.owner_inventory_for_test();
+        assert!(
+            inventory.objects.is_empty()
+                && inventory.guards.is_empty()
+                && inventory.tickets.is_empty()
+        );
+        db.finish_run().unwrap();
+    }
+}
