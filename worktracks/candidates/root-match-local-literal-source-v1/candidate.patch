+//! Intrinsic source kind of an already declared local initializer; no values,
+//! descriptors, query work or inference from later pattern expectations.
+use super::*;
+pub(super) fn intrinsic_initializer(
+    expression: &ast::Expr,
+    work: &mut usize,
+) -> Result<Option<PrimitiveType>, Diagnostic> {
+    let mut selected = expression.clone();
+    for _ in 0..256 {
+        charge(work)?;
+        if selected
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()))
+        {
+            return Ok(None);
+        }
+        match selected {
+            ast::Expr::ParenExpr(group) => {
+                let Some(inner) = group.expr() else {
+                    return Ok(None);
+                };
+                selected = inner;
+            }
+            ast::Expr::Literal(literal) => {
+                return Ok(match literal.token().kind() {
+                    SyntaxKind::TRUE_KW | SyntaxKind::FALSE_KW => Some(PrimitiveType::Bool),
+                    SyntaxKind::CHAR => Some(PrimitiveType::Char),
+                    SyntaxKind::BYTE => Some(PrimitiveType::U8),
+                    SyntaxKind::INT_NUMBER => ast::IntNumber::cast(literal.token())
+                        .and_then(|number| number.suffix().and_then(primitive))
+                        .or_else(|| ranges::floating_context(&literal, None)),
+                    SyntaxKind::FLOAT_NUMBER => {
+                        ast::FloatNumber::cast(literal.token()).and_then(|number| {
+                            number.suffix().and_then(|suffix| match suffix {
+                                "f32" => Some(PrimitiveType::F32),
+                                "f64" => Some(PrimitiveType::F64),
+                                _ => None,
+                            })
+                        })
+                    }
+                    _ => None,
+                });
+            }
+            _ => return Ok(None),
+        }
+    }
+    Err(limit())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn intrinsic_local_source_does_not_default_unresolved_numbers_or_follow_effects() {
+        for (text, expected) in [
+            ("'a'", Some(PrimitiveType::Char)),
+            ("((b'a'))", Some(PrimitiveType::U8)),
+            ("true", Some(PrimitiveType::Bool)),
+            ("1u16", Some(PrimitiveType::U16)),
+            ("1f32", Some(PrimitiveType::F32)),
+            ("1.0f64", Some(PrimitiveType::F64)),
+            ("1", None),
+            ("1.0", None),
+            ("call()", None),
+            ("named", None),
+            ("1+2", None),
+            ("1 as u8", None),
+            ("{ 'a' }", None),
+        ] {
+            let parsed = ast::Expr::parse(text, ra_ap_syntax::Edition::Edition2024);
+            assert!(parsed.errors().is_empty());
+            let mut work = 0;
+            assert_eq!(
+                intrinsic_initializer(&parsed.tree(), &mut work).unwrap(),
+                expected,
+                "{text}"
+            );
+            assert!(work > 0 && work <= 256);
+        }
+        let parsed = ast::Expr::parse("'a'", ra_ap_syntax::Edition::Edition2024);
+        assert!(intrinsic_initializer(&parsed.tree(), &mut 100_000).is_err());
+    }
+}
