+//! Transfer of already-retained legacy terms, not SourceViewPlan namespace admission.
+use super::*;
+use crate::traits::term::TyTerm;
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub(crate) enum RetainedSource {
+    Parameter(u32),
+    Local(NodeId),
+    Slot(SlotId),
+}
+/// No Clone or public constructor: one checked write consumes one attachment.
+/// This proves only storage transfer of the frame's existing term. It cannot
+/// admit a frontend SourceViewPlan or recover an absent identity from TypeId.
+pub(crate) struct RetainedSourceTransfer {
+    frame: FrameId,
+    pc: PcKey,
+    context: Option<crate::core::digest::Digest>,
+    endpoint: RetainedSource,
+    source_cell: CellId,
+    source_epoch: u32,
+    source_value: ValueRepr,
+    source: Option<TyTerm>,
+    destination: SlotId,
+    previous_cell: Option<CellId>,
+    previous_epoch: Option<u32>,
+    previous_source: Option<TyTerm>,
+    previous_hint: Option<TypeId>,
+    previous_strict: bool,
+    expected_value: ValueRepr,
+    expected_descriptor: Option<TypeId>,
+}
+fn source_fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-SOURCE-TYPE-CONTEXT", message.into())
+}
+// The admitted legacy trees are closed and at most two boxes deep. Measure
+// them without TyTerm::heap_bytes's temporary traversal Vec during preflight.
+fn closed_source_heap(source: &TyTerm) -> Option<usize> {
+    let node = std::mem::size_of::<TyTerm>();
+    match source {
+        TyTerm::Primitive(_) | TyTerm::Param(_) => Some(0),
+        TyTerm::Nominal(_, args) if args.is_empty() => args
+            .capacity()
+            .checked_mul(std::mem::size_of::<crate::traits::term::GenericArg>()),
+        TyTerm::Array(element, crate::traits::term::ConstTerm::Value(_))
+            if matches!(element.as_ref(), TyTerm::Primitive(_)) =>
+        {
+            Some(node)
+        }
+        TyTerm::Ref(_, _, target) => node.checked_add(closed_source_heap(target)?),
+        _ => None,
+    }
+}
+impl Frame {
+    fn retained_source_parts(
+        &self,
+        endpoint: RetainedSource,
+    ) -> Result<(CellId, Option<&TyTerm>, u32), Diagnostic> {
+        let (cell, source, physical) = match endpoint {
+            RetainedSource::Parameter(ordinal) => {
+                let physical = self
+                    .body
+                    .slot_count()
+                    .checked_add(
+                        u32::try_from(self.body.nodes().len())
+                            .map_err(|_| invalid("source parameter slot overflow"))?,
+                    )
+                    .and_then(|base| base.checked_add(ordinal))
+                    .ok_or_else(|| invalid("source parameter slot overflow"))?;
+                (
+                    self.parameter(ordinal)?,
+                    self.parameter_sources.get(ordinal as usize),
+                    physical,
+                )
+            }
+            RetainedSource::Local(binding) => (
+                self.binding(binding)?,
+                self.binding_sources
+                    .get(binding.0 as usize)
+                    .ok_or_else(|| invalid("source binding absent"))?
+                    .as_ref(),
+                self.body
+                    .slot_count()
+                    .checked_add(binding.0)
+                    .ok_or_else(|| invalid("source binding slot overflow"))?,
+            ),
+            RetainedSource::Slot(slot) => (self.cell(slot)?, self.source_view_ref(slot)?, slot.0),
+        };
+        Ok((cell, source, physical))
+    }
+    fn require_retained_source_descriptor(
+        &self,
+        source: Option<&TyTerm>,
+        actual: Option<TypeId>,
+        store: &GuestStore,
+    ) -> Result<(), Diagnostic> {
+        let Some(source) = source else {
+            return Ok(());
+        };
+        if !Self::supported_source(source) {
+            return Err(source_fault(
+                "retained source requires general SourceView table admission",
+            ));
+        }
+        if let TyTerm::Param(key) = source {
+            if key.definition != self.body.body().definition || key.ordinal >= 100_000 {
+                return Err(source_fault(
+                    "retained rigid source belongs to another definition",
+                ));
+            }
+            if let Some(context) = &self.context {
+                if context.definition().definition != key.definition
+                    || !context.definition().generics.iter().any(|parameter| {
+                        parameter.ordinal == key.ordinal
+                            && parameter.kind == crate::syntax::signatures::GenericKind::Type
+                    })
+                {
+                    return Err(source_fault(
+                        "retained rigid source differs from its owning environment",
+                    ));
+                }
+                if let Some(expected) = context.runtime_binding(*key)
+                    && Some(expected) != actual
+                {
+                    return Err(source_fault(
+                        "retained rigid source/runtime substitution differs",
+                    ));
+                }
+            }
+            return Ok(());
+        }
+        let actual = actual.ok_or_else(|| {
+            source_fault("retained declared source lacks a concrete storage descriptor")
+        })?;
+        match source {
+            TyTerm::Ref(_, mutable, target) => {
+                let crate::runtime::shape::TypeKey::Ref {
+                    mutable: found,
+                    target: descriptor,
+                } = store.type_descriptor(actual)?.key.as_ref()
+                else {
+                    return Err(source_fault(
+                        "retained reference source differs from descriptor",
+                    ));
+                };
+                if mutable != found {
+                    return Err(source_fault("retained reference source access differs"));
+                }
+                Self::require_borrow_source_target(Some(target), *descriptor, store)
+            }
+            _ => Self::require_borrow_source_target(Some(source), actual, store),
+        }
+    }
+    fn require_transfer_destination_source(
+        &self,
+        destination: SlotId,
+        incoming: Option<&TyTerm>,
+    ) -> Result<(), Diagnostic> {
+        let slot = self.slot(destination)?;
+        // Forwarded call/return context is checked at its reached boundary;
+        // an empty root result must retain the actual source until Return.
+        if !slot.strict_hint || Some(destination) == self.body.nodes()[0].value {
+            return Ok(());
+        }
+        let Some(expected) = slot.source.as_ref() else {
+            return Ok(());
+        };
+        if !Self::supported_source(expected) {
+            return Err(source_fault(
+                "strict source contract requires general table admission",
+            ));
+        }
+        if incoming.is_none() {
+            return if matches!(
+                expected,
+                TyTerm::Param(_) | TyTerm::Nominal(..) | TyTerm::Ref(..)
+            ) {
+                Err(source_fault(
+                    "strict source transfer cannot invent missing binding identity",
+                ))
+            } else {
+                Ok(())
+            };
+        }
+        // A written reference can shorten a region without changing its
+        // pointee/member identity; runtime lease/access checks remain separate.
+        fn same_identity(left: &TyTerm, right: &TyTerm) -> bool {
+            match (left, right) {
+                (TyTerm::Ref(_, left_mutable, left), TyTerm::Ref(_, right_mutable, right)) => {
+                    left_mutable == right_mutable && same_identity(left, right)
+                }
+                _ => left == right,
+            }
+        }
+        if !incoming.is_some_and(|incoming| same_identity(expected, incoming)) {
+            return Err(Diagnostic::new(
+                if matches!(
+                    (expected, incoming),
+                    (TyTerm::Param(_), Some(TyTerm::Param(_)))
+                ) {
+                    "LRR-E-GENERIC-BINDING"
+                } else {
+                    "LRR-E-SOURCE-TYPE-CONTEXT"
+                },
+                "strict source transfer preserves a distinct declared identity".into(),
+            ));
+        }
+        Ok(())
+    }
+    fn retained_source_expected_value(
+        &self,
+        endpoint: RetainedSource,
+        destination: SlotId,
+        store: &GuestStore,
+    ) -> Result<ValueRepr, Diagnostic> {
+        let (cell, _, _) = self.retained_source_parts(endpoint)?;
+        let value = store.admit_move(cell)?;
+        if matches!(endpoint, RetainedSource::Local(_))
+            && matches!(value.kind, 11 | 12)
+            && let Some(hint) = store.effective_type(value)?.or(self.hint(destination)?)
+        {
+            return store.preview_scalar(cell, Some(hint));
+        }
+        Ok(value)
+    }
+    pub(crate) fn preflight_retained_binding_source(
+        &self,
+        source: SlotId,
+        store: &GuestStore,
+    ) -> Result<(), Diagnostic> {
+        let (cell, term, physical) = self.retained_source_parts(RetainedSource::Slot(source))?;
+        if store.owner(cell)?
+            != (CellOwner::FrameSlot {
+                frame: self.anchor,
+                slot: physical,
+            })
+        {
+            return Err(source_fault("binding source cell has another owner"));
+        }
+        let actual = store.effective_type(store.admit_move(cell)?)?;
+        self.require_retained_source_descriptor(term, actual, store)?;
+        let closed_heap = std::mem::size_of::<TyTerm>()
+            .checked_mul(2)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        if term.is_some_and(|term| closed_source_heap(term).is_none_or(|bytes| bytes > closed_heap))
+        {
+            return Err(crate::runtime::arena::resource());
+        }
+        Ok(())
+    }
+    /// Called by existing opcode preflight before fuel, owning ticket or write.
+    pub(crate) fn preflight_retained_source_transfer(
+        &self,
+        endpoint: RetainedSource,
+        destination: SlotId,
+        store: &GuestStore,
+    ) -> Result<(), Diagnostic> {
+        let (cell, source, physical) = self.retained_source_parts(endpoint)?;
+        if store.owner(cell)?
+            != (CellOwner::FrameSlot {
+                frame: self.anchor,
+                slot: physical,
+            })
+        {
+            return Err(source_fault("retained source cell has another owner"));
+        }
+        if self
+            .cell(destination)
+            .is_ok_and(|destination| destination == cell)
+        {
+            return Err(source_fault(
+                "source transfer destination aliases its source cell",
+            ));
+        }
+        let value = self.retained_source_expected_value(endpoint, destination, store)?;
+        self.require_retained_source_descriptor(source, store.effective_type(value)?, store)?;
+        self.require_transfer_destination_source(destination, source)?;
+        self.preflight_source_view(destination, source)?;
+        let closed_heap = std::mem::size_of::<TyTerm>()
+            .checked_mul(2)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        for term in [source, self.source_view_ref(destination)?]
+            .into_iter()
+            .flatten()
+        {
+            if !Self::supported_source(term) {
+                return Err(source_fault(
+                    "retained destination source requires general table admission",
+                ));
+            }
+            if closed_source_heap(term).is_none_or(|bytes| bytes > closed_heap) {
+                return Err(crate::runtime::arena::resource());
+            }
+        }
+        self.preflight_write_value(destination, value, store)?;
+        Self::metadata_bytes(&self.body, self.parameter_metadata_count())
+            .and_then(|bytes| bytes.checked_add(self.constructor_mapping_bytes))
+            .and_then(|bytes| bytes.checked_add(self.projection_bytes))
+            .and_then(|bytes| bytes.checked_add(self.source_field_bytes()?))
+            .filter(|bytes| *bytes <= 32 * 1024 * 1024)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        Ok(())
+    }
+    /// Metadata reservation in Frame::metadata_bytes covers this bounded owner
+    /// and both cloned closed source trees before either is retained.
+    pub(crate) fn prepare_retained_source_transfer(
+        &self,
+        endpoint: RetainedSource,
+        destination: SlotId,
+        store: &GuestStore,
+    ) -> Result<RetainedSourceTransfer, Diagnostic> {
+        self.preflight_retained_source_transfer(endpoint, destination, store)?;
+        let (source_cell, source, _) = self.retained_source_parts(endpoint)?;
+        let slot = self.slot(destination)?;
+        let value = self.retained_source_expected_value(endpoint, destination, store)?;
+        Ok(RetainedSourceTransfer {
+            frame: self.anchor,
+            pc: self.pc.clone(),
+            context: self.context.as_ref().map(|context| context.signature_key()),
+            endpoint,
+            source_cell,
+            source_epoch: store.location_epoch(source_cell)?,
+            source_value: store.admit_move(source_cell)?,
+            source: source.cloned(),
+            destination,
+            previous_cell: slot.cell,
+            previous_epoch: slot
+                .cell
+                .map(|cell| store.location_epoch(cell))
+                .transpose()?,
+            previous_source: slot.source.clone(),
+            previous_hint: slot.hint,
+            previous_strict: slot.strict_hint,
+            expected_value: value,
+            expected_descriptor: store.effective_type(value)?,
+        })
+    }
+    pub(crate) fn require_retained_source_transfer(
+        &self,
+        proof: &RetainedSourceTransfer,
+        store: &GuestStore,
+    ) -> Result<(), Diagnostic> {
+        if proof.frame != self.anchor
+            || proof.pc != self.pc
+            || proof.context != self.context.as_ref().map(|context| context.signature_key())
+        {
+            return Err(source_fault(
+                "retained source transfer frame, PC or context changed",
+            ));
+        }
+        let (cell, source, _) = self.retained_source_parts(proof.endpoint)?;
+        let slot = self.slot(proof.destination)?;
+        if cell != proof.source_cell
+            || store.location_epoch(cell)? != proof.source_epoch
+            || store.admit_move(cell)? != proof.source_value
+            || source != proof.source.as_ref()
+            || slot.cell != proof.previous_cell
+            || slot.source != proof.previous_source
+            || slot.hint != proof.previous_hint
+            || slot.strict_hint != proof.previous_strict
+            || slot
+                .cell
+                .map(|cell| store.location_epoch(cell))
+                .transpose()?
+                != proof.previous_epoch
+        {
+            return Err(source_fault(
+                "retained source transfer storage or metadata changed",
+            ));
+        }
+        self.preflight_retained_source_transfer(proof.endpoint, proof.destination, store)
+    }
+    /// The value write already consumed its ticket. This consumes the private
+    /// witness only after exact frame/PC/descriptor/value/storage validation.
+    pub(crate) fn attach_retained_source_after_write(
+        &mut self,
+        proof: RetainedSourceTransfer,
+        store: &GuestStore,
+    ) -> Result<(), Diagnostic> {
+        if proof.frame != self.anchor
+            || proof.pc != self.pc
+            || proof.context != self.context.as_ref().map(|context| context.signature_key())
+        {
+            return Err(source_fault(
+                "retained source attachment frame, PC or context changed",
+            ));
+        }
+        let slot = self.slot(proof.destination)?;
+        let cell = self.cell(proof.destination)?;
+        if !self.active_scopes.contains(&slot.scope)
+            || slot.source.is_some()
+            || store.owner(cell)?
+                != (CellOwner::FrameSlot {
+                    frame: self.anchor,
+                    slot: proof.destination.0,
+                })
+            || proof.previous_cell.is_some_and(|previous| previous != cell)
+            || store.location_epoch(cell)? != proof.previous_epoch.unwrap_or(1)
+        {
+            return Err(source_fault(
+                "retained source attachment destination owner changed",
+            ));
+        }
+        let actual = store.admit_move(cell)?;
+        if actual != proof.expected_value
+            || store.effective_type(actual)? != proof.expected_descriptor
+        {
+            return Err(source_fault(
+                "retained source attachment actual value or descriptor differs",
+            ));
+        }
+        self.preflight_source_view(proof.destination, proof.source.as_ref())?;
+        self.slots[proof.destination.0 as usize].source = proof.source;
+        Ok(())
+    }
+    pub(crate) fn preflight_rigid_return_source(&self, value: SlotId) -> Result<(), Diagnostic> {
+        let Some(context) = &self.context else {
+            return Ok(());
+        };
+        if let (Some(TyTerm::Param(expected)), Some(TyTerm::Param(actual))) = (
+            context.definition().result_symbolic.as_ref(),
+            self.source_view_ref(value)?,
+        ) && expected != actual
+        {
+            return Err(Diagnostic::new(
+                "LRR-E-GENERIC-BINDING",
+                "reached return preserves a distinct rigid source parameter".into(),
+            ));
+        }
+        Ok(())
+    }
+}
