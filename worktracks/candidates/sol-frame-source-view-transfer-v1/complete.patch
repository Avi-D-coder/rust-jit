+//! Original lowered recipe/storage controls; no whole-main or SourceViewId claim.
+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    frontend::call_contracts::PreparedCallContracts,
+    ir::{
+        op::{Op, PrimitiveType},
+        pc::Phase,
+        recipe::VerifiedRecipe,
+    },
+    source::snapshot::{CfgSet, SourceBlob},
+    syntax::{
+        outline::{BodyHandle, DeclarationContext},
+        parse::ParsedFile,
+    },
+    traits::term::{ParamKey, TyTerm},
+    vm::{
+        context::GenericEnv,
+        step::{StepOutcome, step},
+    },
+};
+const COPY: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/traits/copy-trait-implicit-copy.rs"
+);
+const INFER: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/generics/generic-fn-infer.rs"
+);
+struct Context {
+    parsed: ParsedFile,
+    handle: BodyHandle,
+    frame: Frame,
+    store: GuestStore,
+    recipe: VerifiedRecipe,
+    destination: SlotId,
+}
+fn context(
+    original: &str,
+    function: &str,
+    expression_at: usize,
+    edition: u16,
+    fuel: u64,
+) -> Context {
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(original.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    let outline = parsed
+        .outline(
+            Digest::of_bytes(b"LRR original frame source transfer"),
+            vec![],
+            &CfgSet::guest_default(),
+        )
+        .unwrap();
+    let item = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == function)
+        .unwrap();
+    let handle = item.body.as_ref().unwrap().clone();
+    let signature = parsed
+        .function_signature(
+            handle.def_key,
+            &item.header,
+            &DeclarationContext {
+                scope: item.scope.clone(),
+                range: item.declaration_span,
+            },
+            Some(&handle),
+        )
+        .unwrap();
+    let index = parsed.index_body(&handle, Default::default()).unwrap();
+    let at = u32::try_from(expression_at).unwrap() - handle.range.start;
+    let node = index
+        .nodes()
+        .iter()
+        .find(|node| node.range.start == at && node.range.end == at + 1)
+        .unwrap();
+    let pc = index.pc(node.id, Phase::Entry).unwrap();
+    let recipe = parsed.initial_thunk(&handle, &index, &pc).unwrap();
+    let destination = recipe
+        .recipe()
+        .operations
+        .iter()
+        .find_map(|op| match op {
+            Op::ReadParameter { destination, .. } => Some(*destination),
+            _ => None,
+        })
+        .unwrap();
+    let mut store = GuestStore::new(1, 64, 1024 * 1024).unwrap();
+    let mut frame = Frame::new(index, pc, &mut store).unwrap();
+    frame.set_fuel_limit(fuel).unwrap();
+    let parameter_source = signature.parameters[0].symbolic.clone().unwrap();
+    assert!(matches!(parameter_source, TyTerm::Param(_)));
+    let type_keys: Vec<_> = signature
+        .generics
+        .iter()
+        .filter(|parameter| parameter.kind == crate::syntax::signatures::GenericKind::Type)
+        .map(|parameter| ParamKey {
+            definition: signature.definition,
+            ordinal: parameter.ordinal,
+        })
+        .collect();
+    let contracts = PreparedCallContracts {
+        definition: signature.definition,
+        source_parameters: vec![parameter_source.clone()],
+        parameter_descriptors: vec![TypeId(6)],
+        source_substitution: type_keys
+            .iter()
+            .map(|key| (*key, TyTerm::Primitive(PrimitiveType::I32)))
+            .collect(),
+        runtime_substitution: type_keys.iter().map(|key| (*key, TypeId(6))).collect(),
+        source_result: signature.result_symbolic.clone(),
+        result_descriptor: Some(
+            if matches!(
+                signature.result_symbolic.as_ref(),
+                Some(TyTerm::Primitive(PrimitiveType::Unit))
+            ) {
+                TypeId(1)
+            } else {
+                TypeId(6)
+            },
+        ),
+        normalized_deferred_return: None,
+    };
+    frame
+        .install_context(GenericEnv::capture(&signature, &contracts).unwrap())
+        .unwrap();
+    frame
+        .install_parameter_sources(vec![parameter_source])
+        .unwrap();
+    let argument = store
+        .new_cell(
+            StorageContract::Exact(TypeId(6)),
+            false,
+            CellOwner::FrameSlot {
+                frame: frame.anchor,
+                slot: 100000,
+            },
+        )
+        .unwrap();
+    let ticket = store
+        .ticket(ValueRepr::signed(TypeId(6), 63).unwrap())
+        .unwrap();
+    store.initialize(argument, ticket).unwrap();
+    let packet =
+        super::super::call::ArgumentPacket::seal(&mut store, &[argument], &[TypeId(6)]).unwrap();
+    frame
+        .initialize_parameters(&packet, &[(TypeId(6), false)], &mut store)
+        .unwrap();
+    let node = &frame.body.nodes()[frame.pc.node as usize];
+    let mut scope = match recipe.recipe().operations.first() {
+        Some(Op::ScopeEnter { scope }) => frame.body.scopes()[scope.0 as usize].parent,
+        _ => Some(node.scope),
+    };
+    let mut ancestors = vec![];
+    while let Some(id) = scope {
+        ancestors.push(id);
+        scope = frame.body.scopes()[id.0 as usize].parent;
+    }
+    for id in ancestors.into_iter().rev() {
+        frame.enter(id).unwrap();
+    }
+    Context {
+        parsed,
+        handle,
+        frame,
+        store,
+        recipe,
+        destination,
+    }
+}
+fn copy(edition: u16, fuel: u64) -> Context {
+    let needle = "let _a = v;";
+    context(
+        COPY,
+        "can_copy_copy",
+        COPY.find(needle).unwrap() + needle.find("v;").unwrap(),
+        edition,
+        fuel,
+    )
+}
+fn identity(edition: u16) -> Context {
+    let needle = "return x;";
+    context(
+        INFER,
+        "id",
+        INFER.find(needle).unwrap() + needle.find("x;").unwrap(),
+        edition,
+        1000,
+    )
+}
