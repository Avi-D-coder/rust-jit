diff --git a/crates/lrr/src/source/changes/crate_policy_tests.rs b/crates/lrr/src/source/changes/crate_policy_tests.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/source/changes/crate_policy_tests.rs
@@ -0,0 +1,286 @@
+//! Structural owning-policy components; no body/diagnostic/full-fixture claims.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity, db::key::OutlineKey, source::snapshot::CfgSet,
+    syntax::parse::ParseKey,
+};
+const NO_STD: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/macros/no-std-macros.rs"
+);
+const NO_IMPLICIT: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/hygiene/no_implicit_prelude.rs"
+);
+const NO_IMPLICIT_18: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/hygiene/no_implicit_prelude-2018.rs"
+);
+const CFG: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/macros/macro-comma-behavior-rpass.rs"
+);
+fn original(text: &str, edition: u16, cfg: CfgSet, module: Vec<String>) -> PreparedSourceView {
+    let blob = SourceBlob::new(text.as_bytes().to_vec()).unwrap();
+    let path = SourcePath::new("policy.rs").unwrap();
+    let unit = Digest([101; 32]);
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: module.clone(),
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: module,
+            profile,
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selection).unwrap() else {
+        panic!()
+    };
+    view
+}
+#[test]
+fn unchanged_no_std_original_keeps_actual_crate_root_all_owning_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let view = original(NO_STD, edition, CfgSet::guest_default(), vec![]);
+        let proof =
+            PreparedCratePreludePolicy::capture_current(&view, 1, 32 * 1024 * 1024).unwrap();
+        assert!(!proof.policy().standard);
+        assert_eq!(proof.root.selection(), view.selection());
+        assert_eq!(
+            proof.root.selection().outline.parse.profile.edition,
+            edition
+        );
+        proof.revalidate_current(&view, 1).unwrap();
+        assert!(!view.macro_prelude_policy().unwrap().standard);
+    }
+}
+#[test]
+fn unchanged_original_module_local_disabling_keeps_exact_source_scope() {
+    for (text, edition) in [(NO_IMPLICIT, 2015), (NO_IMPLICIT_18, 2018)] {
+        let view = original(text, edition, CfgSet::guest_default(), vec![]);
+        let proof =
+            PreparedCratePreludePolicy::capture_current(&view, 1, 32 * 1024 * 1024).unwrap();
+        assert!(proof.policy().standard);
+        assert_eq!(proof.policy().disabled, vec![vec!["bar".to_owned()]]);
+        proof.revalidate_current(&view, 1).unwrap();
+    }
+}
+#[test]
+fn unchanged_cfg_revision_source_selects_core_without_rewriting_original() {
+    for edition in [2015, 2018, 2021, 2024] {
+        for core in [false, true] {
+            let mut cfg = CfgSet::guest_default();
+            cfg.atoms.insert(if core { "core" } else { "std" }.into());
+            let view = original(CFG, edition, cfg, vec![]);
+            let proof =
