+#[test]
+fn genuine_generated_declaration_local_disable_does_not_change_root_standard_policy() {
+    let source = r##"macro_rules! emit{()=>{#[no_implicit_prelude]#[path="issue-56411-aux.rs"]mod issue_56411_aux;}}emit!();fn main(){}"##;
+    let (_, _, ps, cat, syntax) = adopted_module_source(source, "generated-disable.rs", "emit");
