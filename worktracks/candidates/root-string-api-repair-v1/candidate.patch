+    fn string_operation_observation_still_requires_dispatch_outcome_and_cleanup() {
+        // Capture-state control only. No guest execution or fixture acceptance
+        // is inferred from this private observer's synthetic observations.
+        for operation in [
+            Op::StrByteLen {
+                source: SlotId(0),
+                destination: SlotId(1),
+            },
+            Op::StrAsBytes {
+                source: SlotId(0),
+                destination: SlotId(1),
+            },
+        ] {
+            let mut capture = RunCapture::default();
+            capture
+                .observe_recipe(&[operation], &RecipeExit::Next(pc()))
+                .unwrap();
+            assert_eq!(capture.facts.classified_operation_candidates, 1);
+            assert_eq!(capture.facts.effect_recipe_dispatch_attempts, 0);
+            assert_eq!(capture.facts.unsupported_operation_candidates, 0);
+            assert_eq!(capture.facts.vm_outcomes, 0);
+            assert!(!capture.facts.complete());
+            let retained = TerminalFacts {
+                outcome: TerminalExecution::Completed { unit: true },
+                cleanup_ran: Some(true),
+            };
+            let mut missing_outcome = RunCapture {
+                facts: capture.facts.clone(),
+            };
+            missing_outcome
+                .observe_poll(&completed(), Some(&retained))
+                .unwrap();
+            assert!(!missing_outcome.facts.complete());
+            capture.after_vm_dispatch(&StepOutcome::Next(pc())).unwrap();
+            let mut missing_cleanup = RunCapture {
+                facts: capture.facts.clone(),
+            };
+            let incomplete = TerminalFacts {
+                outcome: TerminalExecution::Completed { unit: true },
+                cleanup_ran: Some(false),
+            };
+            missing_cleanup
+                .observe_poll(&completed(), Some(&incomplete))
+                .unwrap();
+            assert!(!missing_cleanup.facts.complete());
+            capture.observe_poll(&completed(), Some(&retained)).unwrap();
+            assert!(capture.facts.complete());
+        }
+    }
