+    for edition in [2015, 2018, 2021, 2024] {
+        for (original, count) in [(UNICODE, 3), (NULS, 4), (CRLF, 3)] {
+            let cases = recipes(original, edition);
+            assert_eq!(cases.len(), count);
+            for (index, recipe) in cases {
+                let [
+                    Op::Literal {
+                        literal,
+                        destination,
+                        ..
+                    },
+                ] = recipe.recipe().operations.as_ref()
+                else {
+                    panic!("ordinary original literal");
+                };
+                let Some(DecodedLiteral::String(payload)) = &literal.decoded else {
+                    panic!("original UTF8 certificate");
+                };
+                assert!(payload.text().len() <= 256);
+                let (mut frame, mut store) = frame(&index, &recipe);
+                assert!(matches!(
+                    super::super::step(&mut frame, &mut store, &recipe).unwrap(),
+                    StepOutcome::Next(_)
+                ));
+                assert_eq!(frame.source_view(*destination).unwrap(), Some(source()));
+                let ty = store
+                    .find_type(&TypeKey::Ref {
+                        mutable: false,
+                        target: TypeId(16),
+                    })
+                    .unwrap();
+                let cell = frame.cell(*destination).unwrap();
+                let CellState::Live(value) = store.state(cell).unwrap() else {
+                    panic!("initialized UTF8 reference");
+                };
+                assert_eq!(value.type_id, ty.0);
+                let reference = store.reference_from_cell(cell).unwrap();
+                let returned = store.reference_ticket(reference).unwrap();
+                assert_eq!(store.peek_ticket(returned).unwrap(), value);
+                store.discard(returned).unwrap();
+                assert_eq!(frame.counters().started_by_opcode[0], 1);
+                assert_eq!(frame.counters().operations_completed, 1);
+            }
+        }
+    }
+}
+#[test]
+fn string_literal_admission_rejects_changed_source_slot_kind_and_descriptor_before_effects() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (index, recipe) = recipes(UNICODE, edition).remove(0);
+        let [
+            Op::Literal {
+                literal,
+                destination,
+                ..
+            },
+        ] = recipe.recipe().operations.as_ref()
+        else {
+            panic!("ordinary literal");
+        };
+        let (mut frame, store) = frame(&index, &recipe);
+        let before = (
+            store.budget().handles(),
+            store.budget().bytes(),
+            store.type_metadata_bytes(),
+            frame.fuel_snapshot(),
+            frame.counters().operations_started,
+        );
+        assert!(prepare(&frame, &store, literal, SlotId(u32::MAX), None).is_err());
+        assert!(prepare(&frame, &store, literal, *destination, Some(TypeId(9))).is_err());
+        let mut wrong = literal.clone();
+        wrong.spelling.push(' ');
+        assert!(prepare(&frame, &store, &wrong, *destination, None).is_err());
+        wrong = literal.clone();
+        wrong.source.relative_end += 1;
+        assert!(prepare(&frame, &store, &wrong, *destination, None).is_err());
+        wrong = literal.clone();
+        wrong.kind = LiteralKind::ByteString;
+        assert!(prepare(&frame, &store, &wrong, *destination, None).is_err());
+        frame
+            .set_source_view(*destination, Some(TyTerm::Primitive(PrimitiveType::U8)))
+            .unwrap();
+        assert!(prepare(&frame, &store, literal, *destination, None).is_err());
+        assert_eq!(
+            before,
+            (
+                store.budget().handles(),
+                store.budget().bytes(),
+                store.type_metadata_bytes(),
+                frame.fuel_snapshot(),
+                frame.counters().operations_started
+            )
+        );
+        assert!(frame.cell(*destination).is_err());
+    }
+}
+#[test]
+fn symbolic_str_identity_is_distinct_from_byte_slice_and_uses_append_only_tag() {
+    let mut expected = StableEncoder::new(TyTerm::DOMAIN);
+    expected.u32(15);
+    assert_eq!(TyTerm::Str.fingerprint(), expected.finish());
+    assert_ne!(
+        TyTerm::Str,
+        TyTerm::Slice(Box::new(TyTerm::Primitive(PrimitiveType::U8)))
