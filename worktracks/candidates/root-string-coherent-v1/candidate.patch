+            let recipe = verified.recipe();
+            let Some(index) = recipe.operations.iter().position(|op| matches!(op, Op::Literal { literal, .. } if literal.kind == LiteralKind::String)) else { continue; };
+            let make = || RecipeDraft {
+                key: recipe.key.clone(),
+                origin: recipe.origin.clone(),
+                operations: recipe.operations.to_vec(),
+                exits: vec![recipe.exit.clone()],
+                dependencies: recipe.dependencies.to_vec(),
+            };
+            let expected = [
+                "string\nliteral",
+                "literal with escaped newline",
+                "string\nliteral",
+            ][count];
+            let Op::Literal { literal, .. } = &recipe.operations[index] else {
+                unreachable!()
+            };
+            let Some(DecodedLiteral::String(decoded)) = &literal.decoded else {
+                panic!("original string has no data")
+            };
+            assert_eq!(decoded.text(), expected);
+            assert_eq!(
+                verify(make(), &body).unwrap().recipe().fingerprint(),
+                recipe.fingerprint()
+            );
+            let mut missing = make();
+            let Op::Literal { literal, .. } = &mut missing.operations[index] else {
