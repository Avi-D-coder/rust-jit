+impl StaticLiteralPayload {
+    fn from_literal(literal: &crate::ir::op::LiteralRecipe) -> Result<Self, Diagnostic> {
+        match (literal.kind, &literal.decoded) {
+            (LiteralKind::ByteString, Some(DecodedLiteral::ByteString(value))) => {
+                Ok(Self::Bytes(value.clone()))
+            }
+            (LiteralKind::String, Some(DecodedLiteral::String(value))) => {
