+    fn bytes(&self) -> &[u8] {
+        match self {
+            Self::Bytes(value) => value.bytes(),
+            Self::Utf8(value) => value.text().as_bytes(),
+        }
+    }
+    fn allocated_bytes(&self) -> Option<usize> {
+        match self {
+            Self::Bytes(value) => value.allocated_bytes(),
+            Self::Utf8(value) => value.allocated_bytes(),
+        }
+    }
+    fn permits(&self, target: crate::runtime::shape::ByteLiteralTarget) -> bool {
+        use crate::runtime::shape::ByteLiteralTarget;
+        matches!(
+            (self, target),
+            (
+                Self::Bytes(_),
+                ByteLiteralTarget::Array | ByteLiteralTarget::Slice
+            ) | (Self::Utf8(_), ByteLiteralTarget::Str)
+        )
+    }
+    fn same_decoded_payload(&self, other: &Self) -> bool {
+        match (self, other) {
+            (Self::Bytes(a), Self::Bytes(b)) => a.same_decoded_payload(b),
+            (Self::Utf8(a), Self::Utf8(b)) => a.same_decoded_payload(b),
+            _ => false,
+        }
