+//! Actual ordinary literal execution from unchanged upstream sources.
+//! Initializer selection is component evidence, not whole-main execution.
+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    ir::{pc::Phase, recipe::VerifiedRecipe},
+    runtime::{cell::CellState, shape::TypeKey},
+    source::snapshot::{CfgSet, SourceBlob},
+    syntax::{body_index::BodyIndex, parse::ParsedFile},
+};
+use ra_ap_syntax::{AstNode, SyntaxKind, ast};
+const UNICODE: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/unicode-escape-sequences.rs"
+);
+const NULS: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/str/nul-char-equivalence.rs"
+);
+const CRLF: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/lexer-crlf-line-endings-string-literal-doc-comment.rs"
+);
+fn recipes(original: &str, edition: u16) -> Vec<(BodyIndex, VerifiedRecipe)> {
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(original.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    let outline = parsed
+        .outline(
+            Digest::of_bytes(b"original UTF8 VM initializer"),
+            vec![],
+            &CfgSet::guest_default(),
+        )
+        .unwrap();
+    let body = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let index = parsed.index_body(body, Default::default()).unwrap();
+    parsed
+        .entered_body_root(body)
+        .unwrap()
+        .descendants()
+        .filter_map(ast::LetStmt::cast)
+        .filter_map(|statement| statement.initializer())
+        .filter_map(|expr| match expr {
+            ast::Expr::Literal(literal) if literal.token().kind() == SyntaxKind::STRING => {
+                Some(literal)
+            }
+            _ => None,
+        })
+        .map(|literal| {
+            let range = literal.syntax().text_range();
+            let node = index
+                .nodes()
+                .iter()
+                .find(|node| {
+                    node.role == NodeRole::Expression(ExpressionKind::Literal)
+                        && node.range.start + body.range.start == u32::from(range.start())
+                        && node.range.end + body.range.start == u32::from(range.end())
+                })
+                .unwrap();
+            let pc = index.pc(node.id, Phase::Entry).unwrap();
+            let recipe = parsed.initial_thunk(body, &index, &pc).unwrap();
+            (index.clone(), recipe)
+        })
+        .collect()
+}
+fn frame(index: &BodyIndex, recipe: &VerifiedRecipe) -> (Frame, GuestStore) {
+    let mut store = GuestStore::new(1, 10_000, 16 << 20).unwrap();
+    let mut frame = Frame::new(index.clone(), recipe.recipe().key.clone(), &mut store).unwrap();
+    let mut next = Some(index.nodes()[recipe.recipe().key.node as usize].scope);
+    let mut ancestors = Vec::new();
+    while let Some(scope) = next {
+        ancestors.push(scope);
+        next = index.scopes()[scope.0 as usize].parent;
+    }
+    for scope in ancestors.into_iter().rev() {
+        frame.enter(scope).unwrap();
+    }
+    frame.set_fuel_limit(1000).unwrap();
+    (frame, store)
+}
