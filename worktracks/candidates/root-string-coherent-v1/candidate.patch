+    assert_eq!(TyTerm::Str.heap_bytes(), Some(0));
+    let mut unifier = crate::traits::unify::Unifier::new(Digest::of_bytes(b"UTF8 type identity"));
+    unifier.unify(&source(), &source()).unwrap();
+    assert!(
+        unifier
+            .unify(
+                &TyTerm::Str,
+                &TyTerm::Slice(Box::new(TyTerm::Primitive(PrimitiveType::U8)))
+            )
+            .is_err()
+    );
+}
