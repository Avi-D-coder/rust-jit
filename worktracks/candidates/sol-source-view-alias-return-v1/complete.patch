+// This narrow planner is intentionally not a VM SourceViewId table. Runtime
+// attachment, guest value admission and portable slot mappings remain M018.
+#[path = "../syntax/source_view_propagation.rs"]
+mod syntax_plans;
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{InputKey, InputValue},
+        memo::Database,
+        poll::QueryPoll,
+    },
+    frontend::{
+        call_contracts::primitive_runtime_id,
+        callables::{CallResolver, CallSelection},
+        names::{NameLookup, NameNamespaces},
+        signature_names::{SignatureName, SignatureNames},
+        source_locals::{OrdinaryNameSite, SourceLocalIndex},
+    },
+    ir::pc::PcKey,
+    runtime::shape::TypeId,
+    source::{changes::PreparedSourceView, manifest::Namespace},
+    syntax::{body_index::BodyIndex, parse::ParsedFile, signatures::GenericKind},
+    traits::term::{ParamKey, TyTerm},
+    vm::context::GenericEnv,
+};
+use std::{collections::BTreeMap, sync::Arc};
+pub(crate) use syntax_plans::{
+    BindingReadPlan, DefinitionSourcePlan, LocalAliasPlan, NamedCallPlan,
+};
+const SOURCE_VIEW_BUDGET: usize = 32 * 1024 * 1024;
+fn source_fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-SOURCE-TYPE-CONTEXT", message.into())
+}
+fn metadata_fault() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "source view propagation metadata exceeds limit".into(),
+    )
+}
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) enum SourcePropagation {
+    DeclaredBinding {
+        binding: Digest,
+        site: PcKey,
+    },
+    LocalAlias {
+        source: Digest,
+        destination: Digest,
+        pattern: u32,
+        site: PcKey,
+    },
+    NamedReturn {
+        callee: Digest,
+        signature: Digest,
+        declared: TyTerm,
+        site: PcKey,
+    },
+}
+/// Immutable symbolic propagation plan, never an admitted VM SourceViewId.
+/// Runtime installation must bind a matched current sealed namespace proof,
+/// actual guest descriptor/value, and checked slot/binding ownership separately.
+#[derive(Debug, Clone)]
+pub(crate) struct SourceViewPlan {
+    definition: Arc<DefinitionSourcePlan>,
+    term: TyTerm,
+    binding: Option<Digest>,
+    provenance: Box<[SourcePropagation]>,
+    dependencies: Box<[(InputKey, Digest)]>,
+    source_revision: u64,
+    query_revision: u64,
+    bytes: usize,
+}
+/// The independent descriptor is retained alongside, never substituted for the
+/// source term. VM integration must still check the actual guest value/store.
+#[derive(Debug, Clone)]
+pub(crate) struct SourceViewPairPlan {
+    source: SourceViewPlan,
+    runtime: TypeId,
+}
+impl SourceViewPlan {
+    pub(crate) fn term(&self) -> &TyTerm {
+        &self.term
+    }
+    pub(crate) fn definition(&self) -> &DefinitionSourcePlan {
+        &self.definition
+    }
+    pub(crate) fn provenance(&self) -> &[SourcePropagation] {
+        &self.provenance
+    }
+    pub(crate) fn binding(&self) -> Option<Digest> {
+        self.binding
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/source-view-binding-return-plan");
+        e.record(&self.definition.source);
+        e.record(&self.definition.body.key());
+        e.record(&self.definition.signature);
+        e.record(&self.definition.context.scope);
+        e.u32(self.definition.context.range.start);
+        e.u32(self.definition.context.range.end);
+        e.record(&self.term);
+        e.option(&self.binding, |e, b| e.digest(*b));
+        e.sequence(&self.provenance, |e, p| match p {
+            SourcePropagation::DeclaredBinding { binding, site } => {
+                e.u32(0);
+                e.digest(*binding);
+                e.record(site);
+            }
+            SourcePropagation::LocalAlias {
+                source,
+                destination,
+                pattern,
+                site,
+            } => {
+                e.u32(1);
+                e.digest(*source);
+                e.digest(*destination);
+                e.u32(*pattern);
+                e.record(site);
+            }
+            SourcePropagation::NamedReturn {
+                callee,
+                signature,
+                declared,
+                site,
+            } => {
+                e.u32(2);
+                e.digest(*callee);
+                e.digest(*signature);
+                e.record(declared);
+                e.record(site);
+            }
+        });
+        e.u64(self.source_revision);
+        e.u64(self.query_revision);
+        e.sequence(&self.dependencies, |e, (key, value)| {
+            e.record(key);
+            e.digest(*value);
+        });
+        e.finish()
+    }
+    /// Pure currentness: no query/provider/guest execution, including cold bodies.
+    pub(crate) fn require_current(&self, db: &Database) -> Result<(), Diagnostic> {
+        if db.source_revision() != self.source_revision || db.revision() != self.query_revision {
+            return Err(source_fault(
+                "source view owning source or derived epoch changed",
+            ));
+        }
+        for (key, fingerprint) in &self.dependencies {
+            if db
+                .input(key)
+                .is_none_or(|input| input.fingerprint() != *fingerprint)
+            {
+                return Err(source_fault("source view owning input changed"));
+            }
+        }
+        Ok(())
+    }
+}
+impl SourceViewPairPlan {
+    pub(crate) fn source(&self) -> &SourceViewPlan {
+        &self.source
+    }
+    pub(crate) fn runtime(&self) -> TypeId {
+        self.runtime
+    }
+    pub(crate) fn require_source(
+        &self,
+        expected: &TyTerm,
+        descriptor: TypeId,
+    ) -> Result<(), Diagnostic> {
+        if &self.source.term != expected || self.runtime != descriptor {
+            return Err(source_fault(
+                "source view or independent runtime contract differs",
+            ));
+        }
+        Ok(())
+    }
+}
+fn require_definition(
+    db: &Database,
+    source: &PreparedSourceView,
+    definition: &DefinitionSourcePlan,
+) -> Result<Vec<(InputKey, Digest)>, Diagnostic> {
+    let id = definition.signature.definition;
+    let item = source
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.fingerprint() == id)
+        .ok_or_else(|| source_fault("source view definition absent from owning source"))?;
+    if source.selection().outline.parse != definition.source
+        || item.scope != definition.context.scope
+        || item.declaration_span != definition.context.range
+        || item.header != definition.signature.header
+        || item.body.as_ref() != Some(&definition.body)
+        || definition.context.scope.owner.is_some()
+    {
+        return Err(source_fault(
+            "source view exact declaration context differs",
+        ));
+    }
+    let mut dependencies = Vec::new();
+    for (key, expected) in [
+        (
+            InputKey::DefinitionSource(id),
+            InputValue::DefinitionSource(definition.source.clone()),
+        ),
+        (
+            InputKey::DefinitionHeader(id),
+            InputValue::DefinitionHeader(definition.signature.header.clone()),
+        ),
+        (
+            InputKey::DeclarationContext(id),
+            InputValue::DeclarationContext(definition.context.clone()),
+        ),
+        (
+            InputKey::DefinitionBody(id),
+            InputValue::DefinitionBody(definition.body.clone()),
+        ),
+        (
+            InputKey::CapturedSource(source.selection().location_identity()),
+            InputValue::CapturedSource(source.selection().clone()),
+        ),
+    ] {
+        let actual = db
+            .input(&key)
+            .ok_or_else(|| source_fault("source view owning publication absent"))?;
+        if actual.fingerprint() != expected.fingerprint() {
+            return Err(source_fault("source view owning publication differs"));
+        }
+        dependencies.push((key, actual.fingerprint()));
+    }
+    for key in [
+        InputKey::CrateCfg(definition.context.scope.crate_key),
+        InputKey::ExpansionEpoch,
+    ] {
+        if let Some(input) = db.input(&key) {
+            if matches!((&key,input.as_ref()),(InputKey::CrateCfg(_),InputValue::CrateCfg(cfg)) if cfg.fingerprint()!=source.selection().outline.cfg)
+            {
+                return Err(source_fault("source view owning cfg changed"));
+            }
+            dependencies.push((key, input.fingerprint()));
+        }
+    }
+    Ok(dependencies)
+}
+fn selected_binding(
+    locals: &SourceLocalIndex<'_>,
+    graph: &NameNamespaces,
+    source: &PreparedSourceView,
+    owner: &DefinitionSourcePlan,
+    read: &BindingReadPlan,
+) -> Result<Digest, Diagnostic> {
+    if read.definition != owner.signature.definition || read.site.body != owner.body.key() {
+        return Err(source_fault(
+            "source binding read belongs to another definition",
+        ));
+    }
+    match locals.lookup_ordinary(
+        OrdinaryNameSite {
+            source: source.selection(),
+            body: &owner.body.key(),
+            at: u64::from(read.range.start),
+            name: &read.name,
+            context: locals.context(),
+            namespace: Namespace::Value,
+        },
+        graph,
+        None,
+    )? {
+        NameLookup::LocalBinding(binding) => Ok(binding),
+        _ => Err(source_fault(
+            "source binding identity is missing, unresolved or ambiguous",
+        )),
+    }
+}
+fn merge_dependencies(
+    target: &mut Vec<(InputKey, Digest)>,
+    incoming: &[(InputKey, Digest)],
+) -> Result<(), Diagnostic> {
+    for (key, fingerprint) in incoming {
+        if let Some((_, old)) = target.iter().find(|(old, _)| old == key) {
+            if old != fingerprint {
+                return Err(source_fault(
+                    "source propagation dependency contracts disagree",
+                ));
+            }
+        } else {
+            if target.len() >= 32 {
+                return Err(metadata_fault());
+            }
+            target.try_reserve(1).map_err(|_| metadata_fault())?;
+            target.push((key.clone(), *fingerprint));
+        }
+    }
+    Ok(())
+}
+fn scalar_signature_term(
+    names: &SignatureNames<'_>,
+    symbolic: Option<&TyTerm>,
+    written: &[crate::syntax::ast_adapter::TokenRecipe],
+) -> Result<TyTerm, Diagnostic> {
+    if let Some(term) = symbolic {
+        return match term {
+            TyTerm::Param(_) | TyTerm::Primitive(_) => Ok(term.clone()),
+            _ => Err(source_fault(
+                "named source contract requires further M017 composite substitution",
+            )),
+        };
+    }
+    if written.len() != 1 {
+        return Err(source_fault(
+            "named source contract requires a declared simple term",
+        ));
+    }
+    match names.unqualified(&written[0].text, None)? {
+        SignatureName::Primitive(primitive) => Ok(TyTerm::Primitive(primitive)),
+        SignatureName::Parameter(parameter) => Ok(TyTerm::Param(parameter)),
+        _ => Err(source_fault(
+            "named source contract requires owning alias or nominal resolution",
+        )),
+    }
+}
+#[allow(clippy::too_many_arguments)]
+fn checked_pair(
+    db: &Database,
+    owner: Arc<DefinitionSourcePlan>,
+    term: &TyTerm,
+    binding: Option<Digest>,
+    steps: &[SourcePropagation],
+    next: SourcePropagation,
+    dependencies: Vec<(InputKey, Digest)>,
+    runtime: TypeId,
+    limit: usize,
+) -> Result<SourceViewPairPlan, Diagnostic> {
+    if steps.len() >= 256 || dependencies.len() > 32 {
+        return Err(metadata_fault());
+    }
+    if runtime.0 == 0 || crate::frontend::call_contracts::contains_transaction_term(term) {
+        return Err(source_fault(
+            "source view has unknown descriptor, unresolved term or propagation frontier",
+        ));
+    }
+    term.validate_opaque_shape()?;
+    let count = steps.len().checked_add(1).ok_or_else(metadata_fault)?;
+    let mut bytes = std::mem::size_of::<SourceViewPairPlan>()
+        .checked_add(owner.metadata_bytes())
+        .and_then(|n| n.checked_add(term.heap_bytes()?))
+        .and_then(|n| n.checked_add(count.checked_mul(std::mem::size_of::<SourcePropagation>())?))
+        .and_then(|n| {
+            n.checked_add(
+                dependencies
+                    .capacity()
+                    .checked_mul(std::mem::size_of::<(InputKey, Digest)>())?,
+            )
+        })
+        .ok_or_else(metadata_fault)?;
+    for step in steps.iter().chain(std::iter::once(&next)) {
+        if let SourcePropagation::NamedReturn { declared, .. } = step {
+            bytes = bytes
+                .checked_add(declared.heap_bytes().ok_or_else(metadata_fault)?)
+                .ok_or_else(metadata_fault)?;
+        }
+    }
+    if bytes > limit.min(SOURCE_VIEW_BUDGET) {
+        return Err(metadata_fault());
+    }
+    let mut provenance = Vec::new();
+    provenance
+        .try_reserve_exact(count)
+        .map_err(|_| metadata_fault())?;
+    provenance.extend_from_slice(steps);
+    provenance.push(next);
+    Ok(SourceViewPairPlan {
+        source: SourceViewPlan {
+            definition: owner,
+            term: term.clone(),
+            binding,
+            provenance: provenance.into_boxed_slice(),
+            dependencies: dependencies.into_boxed_slice(),
+            source_revision: db.source_revision(),
+            query_revision: db.revision(),
+            bytes,
+        },
+        runtime,
+    })
+}
+/// A written binding starts a source record only after hygienic identity and
+/// primitive/type-parameter namespace admission. Descriptor-only seeds refuse.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn declared_binding_view(
+    db: &Database,
+    parsed: &ParsedFile,
+    index: &BodyIndex,
+    source: &PreparedSourceView,
+    graph: &NameNamespaces,
+    locals: &SourceLocalIndex<'_>,
+    owner: Arc<DefinitionSourcePlan>,
+    read: &BindingReadPlan,
+    environment: Option<&GenericEnv>,
+    runtime: TypeId,
+    limit: usize,
+) -> Result<SourceViewPairPlan, Diagnostic> {
+    let dependencies = require_definition(db, source, &owner)?;
+    let selected = selected_binding(locals, graph, source, &owner, read)?;
+    let declaration = parsed.source_view_declared_binding_plan(&owner, index, read, selected)?;
+    // lower_type deliberately leaves named primitives deferred. Only exact
+    // Type-namespace absence can admit a builtin at this written local site.
+    let term = match declaration.term.as_ref() {
+        Some(term) => term.clone(),
+        None => {
+            let names = SignatureNames::new(graph, source, &owner.signature)?;
+            match names.unqualified(declaration.written.trim(), None)? {
+                SignatureName::Primitive(primitive) => TyTerm::Primitive(primitive),
+                _ => {
+                    return Err(source_fault(
+                        "binding source written name needs owning alias resolution",
+                    ));
+                }
+            }
+        }
+    };
+    match &term {
+        TyTerm::Param(key) => {
+            if key.definition != owner.signature.definition
+                || !owner.signature.generics.iter().any(|generic| {
+                    generic.ordinal == key.ordinal
+                        && generic.kind == GenericKind::Type
+                        && Some(generic.name.as_str())
+                            == crate::syntax::ast_adapter::semantic_name(declaration.written.trim())
+                                .as_deref()
+                })
+            {
+                return Err(source_fault(
+                    "source parameter does not belong to its defining type namespace",
+                ));
+            }
+            if declaration.form == crate::syntax::local_bindings::BindingForm::Let {
+                let found = locals.lookup_ordinary(
+                    OrdinaryNameSite {
+                        source: source.selection(),
+                        body: &owner.body.key(),
+                        at: u64::from(declaration.type_at),
+                        name: declaration.written.trim(),
+                        context: locals.context(),
+                        namespace: Namespace::Type,
+                    },
+                    graph,
+                    None,
+                )?;
+                if found != NameLookup::Absent {
+                    return Err(source_fault(
+                        "local written parameter requires exact owning type namespace",
+                    ));
+                }
+            }
+            let environment = environment.ok_or_else(|| {
+                source_fault("rigid source binding requires owning runtime substitution")
+            })?;
+            if environment.signature_key() != owner.signature.fingerprint()
+                || environment.runtime_binding(*key) != Some(runtime)
+            {
+                return Err(source_fault(
+                    "rigid source runtime binding differs from owning environment",
+                ));
+            }
+            // Keep Param(key). Never apply the concrete runtime substitution here.
+        }
+        TyTerm::Primitive(primitive) => {
+            if *primitive == crate::ir::op::PrimitiveType::Unit {
+                if declaration.written.trim() != "()"
+                    || primitive_runtime_id(*primitive)? != runtime
+                {
+                    return Err(source_fault(
+                        "declared unit source/runtime contract differs",
+                    ));
+                }
+            } else {
+                let name = declaration.written.trim();
+                let selected = locals.lookup_ordinary(
+                    OrdinaryNameSite {
+                        source: source.selection(),
+                        body: &owner.body.key(),
+                        at: u64::from(declaration.type_at),
+                        name,
+                        context: locals.context(),
+                        namespace: Namespace::Type,
+                    },
+                    graph,
+                    None,
+                )?;
+                if selected != NameLookup::Absent || primitive_runtime_id(*primitive)? != runtime {
+                    return Err(source_fault(
+                        "written primitive requires exact type namespace and descriptor",
+                    ));
+                }
+            }
+        }
+        _ => {
+            return Err(source_fault(
+                "declared binding source needs further symbolic owning resolution",
+            ));
+        }
+    }
+    checked_pair(
+        db,
+        owner,
+        &term,
+        Some(declaration.binding),
+        &[],
+        SourcePropagation::DeclaredBinding {
+            binding: declaration.binding,
+            site: declaration.read.site,
+        },
+        dependencies,
+        runtime,
+        limit,
+    )
+}
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn local_alias_view(
+    db: &Database,
+    source: &PreparedSourceView,
+    graph: &NameNamespaces,
+    locals: &SourceLocalIndex<'_>,
+    owner: Arc<DefinitionSourcePlan>,
+    plan: &LocalAliasPlan,
+    value: &SourceViewPairPlan,
+    limit: usize,
+) -> Result<SourceViewPairPlan, Diagnostic> {
+    value.source.require_current(db)?;
+    let mut dependencies = require_definition(db, source, &owner)?;
+    merge_dependencies(&mut dependencies, &value.source.dependencies)?;
+    if plan.definition != owner.signature.definition
+        || plan.site.body != owner.body.key()
+        || value.source.definition.body.key() != owner.body.key()
+        || value.source.definition.signature.fingerprint() != owner.signature.fingerprint()
+    {
+        return Err(source_fault(
+            "alias source belongs to another definition context",
+        ));
+    }
+    let selected = selected_binding(locals, graph, source, &owner, &plan.source)?;
+    if value.source.binding != Some(selected) {
+        return Err(source_fault(
+            "alias read does not select the supplied source binding",
+        ));
+    }
+    let destination = locals.lookup_ordinary(
+        OrdinaryNameSite {
+            source: source.selection(),
+            body: &owner.body.key(),
+            at: plan.destination_at,
+            name: &plan.destination_name,
+            context: locals.context(),
+            namespace: Namespace::Value,
+        },
+        graph,
+        None,
+    )?;
+    if destination != NameLookup::LocalBinding(plan.destination) {
+        return Err(source_fault(
+            "alias destination lacks exact owning binding admission",
+        ));
+    }
+    checked_pair(
+        db,
+        owner,
+        &value.source.term,
+        Some(plan.destination),
+        &value.source.provenance,
+        SourcePropagation::LocalAlias {
+            source: selected,
+            destination: plan.destination,
+            pattern: plan.pattern.0,
+            site: plan.site.clone(),
+        },
+        dependencies,
+        value.runtime,
+        limit,
+    )
+}
+/// The selected declared result is instantiated from source arguments. This
+/// first lane supports only direct type parameters/primitives and module calls;
+/// general M017 binder/const/region/lexical admission stays an explicit frontier.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn named_function_return_view(
+    db: &mut Database,
+    source: &PreparedSourceView,
+    sources: &[&PreparedSourceView],
+    graph: &NameNamespaces,
+    locals: &SourceLocalIndex<'_>,
+    owner: Arc<DefinitionSourcePlan>,
+    plan: &NamedCallPlan,
+    arguments: &[&SourceViewPairPlan],
+    runtime: TypeId,
+    limit: usize,
+) -> QueryPoll<SourceViewPairPlan> {
+    let result = (|| -> Result<QueryPoll<SourceViewPairPlan>, Diagnostic> {
+        let mut dependencies = require_definition(db, source, &owner)?;
+        if plan.definition != owner.signature.definition
+            || plan.site.body != owner.body.key()
+            || plan.path.contains("::")
+            || arguments.len() != plan.arguments.len()
+        {
+            return Err(source_fault(
+                "named return needs exact reached module-call argument context",
+            ));
+        }
+        let selected = locals.lookup_ordinary(
+            OrdinaryNameSite {
+                source: source.selection(),
+                body: &owner.body.key(),
+                at: u64::from(plan.at),
+                name: &plan.path,
+                context: locals.context(),
+                namespace: Namespace::Value,
+            },
+            graph,
+            None,
+        )?;
+        let NameLookup::Defined(selected) = selected else {
+            return Err(source_fault(
+                "named return callee identity is not an admitted definition",
+            ));
+        };
+        let resolver = CallResolver::new(graph, sources)?;
+        let callee = match resolver.source_function(db, owner.signature.definition, &plan.path) {
+            QueryPoll::Ready(Ok(CallSelection::Source(callee))) => callee,
+            QueryPoll::Ready(Ok(_)) => {
+                return Err(source_fault(
+                    "named return callable needs further source admission",
+                ));
+            }
+            QueryPoll::Ready(Err(error)) => return Err(error),
+            QueryPoll::NeedInput(input) => return Ok(QueryPoll::NeedInput(input)),
+        };
+        if callee.identity() != selected.identity
+            || callee.signature().parameters.len() != arguments.len()
+            || callee
+                .signature()
+                .generics
+                .iter()
+                .any(|generic| generic.kind != GenericKind::Type)
+        {
+            return Err(source_fault(
+                "named return selected signature or namespace differs",
+            ));
+        }
+        callee.revalidate(db)?;
+        let signature = callee.signature();
+        if callee.body().is_none()
+            || signature
+                .parameters
+                .iter()
+                .any(|parameter| parameter.receiver || parameter.variadic)
+            || signature
+                .header
+                .tokens
+                .iter()
+                .any(|token| matches!(token.text.as_str(), "async" | "gen" | "unsafe" | "extern"))
+        {
+            return Err(source_fault(
+                "named return needs an ordinary safe Rust source signature",
+            ));
+        }
+        let names = SignatureNames::from_database(db, graph, signature)?;
+        let mut bindings: BTreeMap<ParamKey, &SourceViewPairPlan> = BTreeMap::new();
+        for ((read, actual), parameter) in plan
+            .arguments
+            .iter()
+            .zip(arguments)
+            .zip(&signature.parameters)
+        {
+            actual.source.require_current(db)?;
+            if actual.source.definition.body.key() != owner.body.key()
+                || actual.source.binding
+                    != Some(selected_binding(locals, graph, source, &owner, read)?)
+            {
+                return Err(source_fault(
+                    "named return argument lacks exact caller binding provenance",
+                ));
+            }
+            let parameter_term =
+                scalar_signature_term(&names, parameter.symbolic.as_ref(), &parameter.ty)?;
+            match &parameter_term {
+                TyTerm::Param(key)
+                    if key.definition == signature.definition
+                        && signature.generics.iter().any(|generic| {
+                            generic.ordinal == key.ordinal && generic.kind == GenericKind::Type
+                        }) =>
+                {
+                    if let Some(previous) = bindings.get(key) {
+                        if previous.source.term() != actual.source.term()
+                            || previous.runtime != actual.runtime
+                        {
+                            return Err(source_fault(
+                                "named return arguments have distinct source bindings",
+                            ));
+                        }
+                    } else {
+                        bindings.insert(*key, actual);
+                    }
+                }
+                TyTerm::Primitive(primitive)
+                    if actual.source.term() == &TyTerm::Primitive(*primitive)
+                        && primitive_runtime_id(*primitive)? == actual.runtime => {}
+                _ => {
+                    return Err(source_fault(
+                        "named return parameter requires further symbolic call contract",
+                    ));
+                }
+            }
+        }
+        let declared = scalar_signature_term(
+            &names,
+            signature.result_symbolic.as_ref(),
+            &signature.result,
+        )?;
+        let (term, descriptor, steps) = match &declared {
+            TyTerm::Param(key) => {
+                let result = bindings
+                    .get(key)
+                    .copied()
+                    .ok_or_else(|| source_fault("named return source parameter remains unbound"))?;
+                merge_dependencies(&mut dependencies, &result.source.dependencies)?;
+                (
+                    result.source.term(),
+                    result.runtime,
+                    result.source.provenance(),
+                )
+            }
+            TyTerm::Primitive(primitive) => (&declared, primitive_runtime_id(*primitive)?, &[][..]),
+            _ => {
+                return Err(source_fault(
+                    "named return result requires further M017 substitution",
+                ));
+            }
+        };
+        if descriptor != runtime {
+            return Err(source_fault("named return independent descriptor differs"));
+        }
+        for key in [
+            InputKey::DefinitionSource(callee.identity()),
+            InputKey::DefinitionHeader(callee.identity()),
+            InputKey::DeclarationContext(callee.identity()),
+            InputKey::DefinitionBody(callee.identity()),
+        ] {
+            let input = db
+                .input(&key)
+                .ok_or_else(|| source_fault("named return owning callee input absent"))?;
+            dependencies.push((key, input.fingerprint()));
+        }
+        let next = SourcePropagation::NamedReturn {
+            callee: callee.identity(),
+            signature: signature.fingerprint(),
+            declared: declared.clone(),
+            site: plan.site.clone(),
+        };
+        checked_pair(
+            db,
+            owner,
+            term,
+            None,
+            steps,
+            next,
+            dependencies,
+            runtime,
+            limit,
+        )
+        .map(|view| QueryPoll::Ready(Ok(view)))
+    })();
+    match result {
+        Ok(result) => result,
+        Err(error) => QueryPoll::Ready(Err(error)),
+    }
+}
