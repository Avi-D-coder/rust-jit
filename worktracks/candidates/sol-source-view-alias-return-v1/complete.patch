+//! Immutable facts for reached binding/read/call sites, never a runtime view.
+use crate::{
+    core::{diagnostic::Diagnostic, digest::Digest},
+    ir::pc::{NodeId, PcKey, Phase},
+    syntax::{
+        ast_adapter::range,
+        body_index::BodyIndex,
+        local_bindings::BindingForm,
+        outline::{BodyHandle, DeclarationContext, HeaderRecipe},
+        parse::{ParseKey, ParsedFile},
+        signatures::{FunctionSignature, lower_type},
+        spans::SourceRange,
+    },
+    traits::term::TyTerm,
+};
+use ra_ap_syntax::{
+    AstNode, SyntaxNode, TextRange,
+    ast::{self, HasArgList, HasAttrs, HasGenericArgs},
+};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-SOURCE-TYPE-CONTEXT", message.into())
+}
+#[derive(Debug, Clone)]
+pub(crate) struct DefinitionSourcePlan {
+    pub(super) source: ParseKey,
+    pub(super) body: BodyHandle,
+    pub(super) context: DeclarationContext,
+    pub(super) signature: FunctionSignature,
+    pub(super) bytes: usize,
+}
+#[derive(Debug, Clone)]
+pub(crate) struct BindingReadPlan {
+    pub(super) definition: Digest,
+    pub(super) site: PcKey,
+    pub(super) name: String,
+    pub(super) range: SourceRange,
+}
+#[derive(Debug, Clone)]
+pub(crate) struct DeclaredBindingPlan {
+    pub(super) read: BindingReadPlan,
+    pub(super) binding: Digest,
+    pub(super) form: BindingForm,
+    pub(super) term: Option<TyTerm>,
+    pub(super) written: String,
+    pub(super) type_at: u32,
+}
+#[derive(Debug, Clone)]
+pub(crate) struct LocalAliasPlan {
+    pub(super) definition: Digest,
+    pub(super) site: PcKey,
+    pub(super) source: BindingReadPlan,
+    pub(super) destination: Digest,
+    pub(super) destination_name: String,
+    pub(super) destination_at: u64,
+    pub(super) pattern: NodeId,
+}
+#[derive(Debug, Clone)]
+pub(crate) struct NamedCallPlan {
+    pub(super) definition: Digest,
+    pub(super) site: PcKey,
+    pub(super) path: String,
+    pub(super) at: u32,
+    pub(super) arguments: Vec<BindingReadPlan>,
+}
+impl DefinitionSourcePlan {
+    pub(crate) fn signature(&self) -> &FunctionSignature {
+        &self.signature
+    }
+    pub(crate) fn body(&self) -> &BodyHandle {
+        &self.body
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+}
+fn exact_node(
+    parsed: &ParsedFile,
+    owner: &DefinitionSourcePlan,
+    index: &BodyIndex,
+    site: &PcKey,
+) -> Result<SyntaxNode, Diagnostic> {
+    if parsed.key() != owner.source
+        || index.body() != &owner.body.key()
+        || site.body != owner.body.key()
+        || index.pc(NodeId(site.node), Phase::from_code(site.phase))? != *site
+    {
+        return Err(fault(
+            "source propagation site differs from its owning body",
+        ));
+    }
+    let node = index
+        .nodes()
+        .get(site.node as usize)
+        .ok_or_else(|| fault("source propagation node absent"))?;
+    let start = owner
+        .body
+        .range
+        .start
+        .checked_add(node.range.start)
+        .ok_or_else(|| fault("source propagation range overflow"))?;
+    let end = owner
+        .body
+        .range
+        .start
+        .checked_add(node.range.end)
+        .ok_or_else(|| fault("source propagation range overflow"))?;
+    let root = parsed.entered_body_root(&owner.body)?;
+    root.covering_element(TextRange::new(start.into(), end.into()))
+        .ancestors()
+        .find(|syntax| {
+            u32::from(syntax.text_range().start()) == start
+                && u32::from(syntax.text_range().end()) == end
+        })
+        .ok_or_else(|| fault("source propagation exact syntax absent"))
+}
+fn expression_key(
+    owner: &DefinitionSourcePlan,
+    index: &BodyIndex,
+    syntax: &SyntaxNode,
+) -> Result<PcKey, Diagnostic> {
+    let span = range(syntax.text_range());
+    let start = span
+        .start
+        .checked_sub(owner.body.range.start)
+        .ok_or_else(|| fault("source read before owner body"))?;
+    let end = span
+        .end
+        .checked_sub(owner.body.range.start)
+        .ok_or_else(|| fault("source read before owner body"))?;
+    let node = index
+        .nodes()
+        .iter()
+        .find(|node| {
+            node.range.start == start
+                && node.range.end == end
+                && matches!(
+                    node.role,
+                    crate::syntax::body_index::NodeRole::Expression(_)
+                )
+        })
+        .ok_or_else(|| fault("source read has no exact entered node"))?;
+    index.pc(node.id, Phase::Entry)
+}
+fn read_plan(
+    owner: &DefinitionSourcePlan,
+    index: &BodyIndex,
+    path: ast::PathExpr,
+) -> Result<BindingReadPlan, Diagnostic> {
+    let syntax = path
+        .path()
+        .ok_or_else(|| fault("source binding path absent"))?;
+    let segment = syntax
+        .segment()
+        .ok_or_else(|| fault("source binding segment absent"))?;
+    if syntax.qualifier().is_some()
+        || segment.coloncolon_token().is_some()
+        || segment.generic_arg_list().is_some()
+    {
+        return Err(fault(
+            "source binding requires one relative nongeneric name",
+        ));
+    }
+    let name = segment
+        .name_ref()
+        .ok_or_else(|| fault("source binding name absent"))?
+        .text()
+        .to_string();
+    if name.len() > 4096 {
+        return Err(fault("source binding name exceeds budget"));
+    }
+    Ok(BindingReadPlan {
+        definition: owner.signature.definition,
+        site: expression_key(owner, index, path.syntax())?,
+        name,
+        range: range(path.syntax().text_range()),
+    })
+}
+impl ParsedFile {
+    pub(crate) fn source_view_definition_plan(
+        &self,
+        body: &BodyHandle,
+        header: &HeaderRecipe,
+        context: &DeclarationContext,
+    ) -> Result<DefinitionSourcePlan, Diagnostic> {
+        if self.generated_origin.is_some() || context.scope.owner.is_some() {
+            return Err(fault(
+                "source view needs an original owning definition context",
+            ));
+        }
+        let signature = self.function_signature(body.def_key, header, context, Some(body))?;
+        self.entered_body_root(body)?;
+        let bytes = std::mem::size_of::<DefinitionSourcePlan>()
+            .checked_add(signature.estimated_bytes())
+            .and_then(|n| n.checked_add(context.scope.heap_bytes()))
+            .and_then(|n| n.checked_add(self.profile.semantics.len().checked_mul(2)?))
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(|| fault("source definition metadata budget"))?;
+        Ok(DefinitionSourcePlan {
+            source: self.key(),
+            body: body.clone(),
+            context: context.clone(),
+            signature,
+            bytes,
+        })
+    }
+    pub(crate) fn source_view_read_plan(
+        &self,
+        owner: &DefinitionSourcePlan,
+        index: &BodyIndex,
+        site: &PcKey,
+    ) -> Result<BindingReadPlan, Diagnostic> {
+        if site.phase != Phase::Entry.code()? {
+            return Err(fault("source read is not an entered phase"));
+        }
+        let syntax = exact_node(self, owner, index, site)?;
+        let path = ast::PathExpr::cast(syntax)
+            .ok_or_else(|| fault("source view requires a direct binding read"))?;
+        read_plan(owner, index, path)
+    }
+    /// The frontend supplies only a binding selected by the existing hygienic index.
+    pub(crate) fn source_view_declared_binding_plan(
+        &self,
+        owner: &DefinitionSourcePlan,
+        index: &BodyIndex,
+        read: &BindingReadPlan,
+        selected: Digest,
+    ) -> Result<DeclaredBindingPlan, Diagnostic> {
+        self.source_view_read_plan(owner, index, &read.site)?;
+        let facts = self.entered_macro_facts(&owner.body, index.cfg(), &owner.context.scope)?;
+        let row = facts
+            .bindings
+            .iter()
+            .find(|binding| binding.identity == selected)
+            .ok_or_else(|| fault("source binding is absent from owning captured facts"))?;
+        let selected_range =
+            TextRange::new(row.pattern_range.start.into(), row.pattern_range.end.into());
+        let tree = self.parsed.tree();
+        let pattern = tree
+            .syntax()
+            .covering_element(selected_range)
+            .ancestors()
+            .find_map(|node| {
+                let pattern = ast::IdentPat::cast(node)?;
+                (range(pattern.syntax().text_range()) == row.pattern_range).then_some(pattern)
+            })
+            .ok_or_else(|| fault("declared source needs one exact identifier pattern"))?;
+        if pattern.ref_token().is_some()
+            || pattern.at_token().is_some()
+            || row.name != crate::syntax::ast_adapter::semantic_name(&read.name).unwrap_or_default()
+        {
+            return Err(fault("declared source binding shape or identity differs"));
+        }
+        let ty = match row.form {
+            BindingForm::Parameter => pattern
+                .syntax()
+                .parent()
+                .and_then(ast::Param::cast)
+                .and_then(|param| param.ty()),
+            BindingForm::Let => pattern
+                .syntax()
+                .parent()
+                .and_then(ast::LetStmt::cast)
+                .and_then(|statement| statement.ty()),
+            _ => None,
+        }
+        .ok_or_else(|| {
+            fault("binding source requires its reached written type or prior source view")
+        })?;
+        match &ty {
+            ast::Type::PathType(path) => {
+                let path = path
+                    .path()
+                    .ok_or_else(|| fault("written source path absent"))?;
+                let segment = path
+                    .segment()
+                    .ok_or_else(|| fault("written source segment absent"))?;
+                if path.qualifier().is_some()
+                    || segment.coloncolon_token().is_some()
+                    || segment.generic_arg_list().is_some()
+                {
+                    return Err(fault(
+                        "written binding source needs a simple owning type name",
+                    ));
+                }
+            }
+            ast::Type::TupleType(tuple) if tuple.fields().next().is_none() => {}
+            _ => {
+                return Err(fault(
+                    "written binding source requires further M017 composite integration",
+                ));
+            }
+        }
+        let term = lower_type(
+            &ty,
+            owner.signature.definition,
+            &owner.signature.generics,
+            0,
+        )?;
+        let written = ty.syntax().text().to_string();
+        if written.len() > 4096 {
+            return Err(fault("binding written type exceeds budget"));
+        }
+        Ok(DeclaredBindingPlan {
+            read: read.clone(),
+            binding: selected,
+            form: row.form,
+            term,
+            written,
+            type_at: u32::from(ty.syntax().text_range().start()),
+        })
+    }
+    pub(crate) fn source_view_alias_plan(
+        &self,
+        owner: &DefinitionSourcePlan,
+        index: &BodyIndex,
+        site: &PcKey,
+    ) -> Result<LocalAliasPlan, Diagnostic> {
+        if site.phase != Phase::Commit.code()? {
+            return Err(fault("alias propagation needs reached let commit"));
+        }
+        let syntax = exact_node(self, owner, index, site)?;
+        let statement = ast::LetStmt::cast(syntax)
+            .ok_or_else(|| fault("alias propagation is not a let statement"))?;
+        if statement.attrs().next().is_some()
+            || statement.ty().is_some()
+            || statement.let_else().is_some()
+        {
+            return Err(fault(
+                "alias propagation excludes attributed, written or let-else contracts",
+            ));
+        }
+        let Some(ast::Pat::IdentPat(pattern)) = statement.pat() else {
+            return Err(fault("alias propagation needs one owning identifier"));
+        };
+        if pattern.ref_token().is_some() || pattern.at_token().is_some() {
+            return Err(fault("alias propagation needs owning identity transfer"));
+        }
+        let Some(ast::Expr::PathExpr(path)) = statement.initializer() else {
+            return Err(fault("alias propagation requires a direct source binding"));
+        };
+        let facts = self.entered_macro_facts(&owner.body, index.cfg(), &owner.context.scope)?;
+        let row = facts
+            .bindings
+            .iter()
+            .find(|binding| {
+                binding.form == BindingForm::Let
+                    && binding.pattern_range == range(pattern.syntax().text_range())
+            })
+            .ok_or_else(|| fault("alias destination lacks exact source binding"))?;
+        let start = row
+            .pattern_range
+            .start
+            .checked_sub(owner.body.range.start)
+            .ok_or_else(|| fault("alias pattern outside owner"))?;
+        let end = row
+            .pattern_range
+            .end
+            .checked_sub(owner.body.range.start)
+            .ok_or_else(|| fault("alias pattern outside owner"))?;
+        let node = index
+            .pattern_locations()
+            .find(|node| node.range.start == start && node.range.end == end)
+            .ok_or_else(|| fault("alias pattern lacks exact entered location"))?;
+        Ok(LocalAliasPlan {
+            definition: owner.signature.definition,
+            site: site.clone(),
+            source: read_plan(owner, index, path)?,
+            destination: row.identity,
+            destination_name: row.raw_name.clone(),
+            destination_at: row.visible_from,
+            pattern: node.id,
+        })
+    }
+    pub(crate) fn source_view_named_call_plan(
+        &self,
+        owner: &DefinitionSourcePlan,
+        index: &BodyIndex,
+        site: &PcKey,
+    ) -> Result<NamedCallPlan, Diagnostic> {
+        if site.phase != Phase::Entry.code()? {
+            return Err(fault("named source return requires reached call entry"));
+        }
+        let call = ast::CallExpr::cast(exact_node(self, owner, index, site)?)
+            .ok_or_else(|| fault("named source result is not a call"))?;
+        let Some(ast::Expr::PathExpr(path)) = call.expr() else {
+            return Err(fault("named source result needs a direct function path"));
+        };
+        if path.syntax().descendants().count() > 256
+            || path
+                .syntax()
+                .descendants()
+                .any(|node| ast::GenericArgList::can_cast(node.kind()))
+        {
+            return Err(fault(
+                "named source return explicit arguments require matched M017 call proof",
+            ));
+        }
+        let at = u32::from(path.syntax().text_range().start());
+        let path = path.syntax().text().to_string();
+        if path.len() > 4096 {
+            return Err(fault("named source return path budget"));
+        }
+        let list = call
+            .arg_list()
+            .ok_or_else(|| fault("named source call arguments absent"))?;
+        let mut arguments = Vec::new();
+        for expression in list.args() {
+            if arguments.len() >= 256 {
+                return Err(fault("named source argument count budget"));
+            }
+            let ast::Expr::PathExpr(path) = expression else {
+                return Err(fault("named source arguments need existing binding views"));
+            };
+            arguments
+                .try_reserve(1)
+                .map_err(|_| fault("named source argument metadata allocation"))?;
+            arguments.push(read_plan(owner, index, path)?);
+        }
+        Ok(NamedCallPlan {
+            definition: owner.signature.definition,
+            site: site.clone(),
+            path,
+            at,
+            arguments,
+        })
+    }
+}
