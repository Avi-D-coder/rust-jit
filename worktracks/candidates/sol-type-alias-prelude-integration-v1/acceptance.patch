+//! Source/expansion/adoption components only; originals are not full fixture passes.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    db::{
+        dependency::{InputKey, InputValue},
+        key::{OutlineKey, QueryKey},
+        memo::Database,
+        poll::InputRequest,
+    },
+    expand::{generated_items::GeneratedItems, source_declarative::SourceDeclarativeDemand},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelectionOutcome, SourceUnitInput},
+        dependencies::SourceDependency,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParseKey,
+};
+use std::{collections::BTreeMap, path::Path};
+const MODERN: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/hygiene/dollar-crate-modern.rs"
+);
+const INTERCRATE: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/hygiene/auxiliary/intercrate.rs"
+);
+const UNUSED: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/consts/const-fn-const-eval.rs"
+);
+const MODULE: &str =
+    include_str!("../../../../../fixtures/upstream/rustc-checkout/tests/ui/modules/issue-56411.rs");
+fn unit(text: &str, path: &str, key: Digest, edition: u16) -> SourceUnitInput {
+    SourceUnitInput {
+        path: SourcePath::new(path).unwrap(),
+        crate_key: key,
+        module_path: vec![],
+        profile: ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+        cfg: CfgSet::guest_default(),
+        blob: SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+    }
+}
+fn prepare(
+    units: Vec<SourceUnitInput>,
+    edges: Vec<SourceDependency>,
+) -> (Database, Vec<PreparedSourceView>, Vec<SourceDeclarative>) {
+    let selections: Vec<_> = units
+        .iter()
+        .map(|u| SourceSelection {
+            path: u.path.clone(),
+            outline: OutlineKey {
+                parse: ParseKey {
+                    content: u.blob.content(),
+                    profile: u.profile.clone(),
+                },
+                crate_key: u.crate_key,
+                module_path: u.module_path.clone(),
+                cfg: u.cfg.fingerprint(),
+            },
+        })
+        .collect();
+    let inputs =
+        PreparedSourceInputs::refresh_with_dependencies(None, units, Default::default(), edges)
+            .unwrap();
+    let views: Vec<_> = selections
+        .iter()
+        .map(|s| {
+            let SourceSelectionOutcome::Selected(v) = inputs.select(s).unwrap() else {
+                panic!()
+            };
+            v
+        })
+        .collect();
+    let mut db = Database::default();
+    inputs.publish(&mut db).unwrap();
+    db.begin_expansion_epoch(1).unwrap();
+    let mut providers: Vec<_> = views
+        .iter()
+        .map(|v| SourceDeclarative::new(v.share()).unwrap())
+        .collect();
+    let supplied = Arc::new(
+        CompileInputCatalog::standalone(&views[0].selection().outline.parse.profile).unwrap(),
+    );
+    let facets = super::super::compiler_profiles::PreparedSourceCompilerFacets::prepare(
+        &providers,
+        supplied,
+        64 * 1024 * 1024,
+    )
+    .unwrap();
+    facets.install(&mut providers).unwrap();
+    (db, views, providers)
+}
+fn expansion(
+    view: &PreparedSourceView,
+    providers: &[SourceDeclarative],
+    index: usize,
+    tail: &str,
+) -> GeneratedItems {
+    let call = view
+        .outline()
+        .item_invocations
+        .iter()
+        .find(|c| {
+            view.macro_call_at(c.range)
+                .unwrap()
+                .segments()
+                .last()
+                .is_some_and(
+                    |s| matches!(s,crate::syntax::imports::ImportSegment::Name(n) if n==tail),
+                )
+        })
+        .unwrap();
+    let routes =
+        super::super::SourceDiscovery::completed_macro_routes(providers, &BTreeMap::new()).unwrap();
+    let graph = super::super::SourceDiscovery::compiler_import_graph(&routes, providers).unwrap();
+    let SourceDeclarativeDemand::Ready(request) = providers[index]
+        .demand_for_discovery(
+            call.item_input,
+            Digest([80; 32]),
+            crate::expand::source_declarative::engine_version(),
+            &graph,
+            providers,
+        )
+        .unwrap()
+    else {
+        panic!("genuine original request must be selected")
+    };
+    GeneratedItems::admit(request.key(), Arc::new(request.expand().unwrap()), 1).unwrap()
+}
+fn catalog(view: &PreparedSourceView, items: &GeneratedItems) -> GeneratedMacroCatalog {
+    GeneratedMacroCatalog::new(
+        items,
+        view.outline().root_scope.clone(),
+        Key(items.record().key().parent_context.0),
+        view.captured_macro_cfg().unwrap(),
+        items.epoch(),
+    )
+    .unwrap()
+}
+fn nested(
+    caller: u16,
+    definition: u16,
+) -> (
+    Vec<PreparedSourceView>,
+    Vec<SourceDeclarative>,
+    GeneratedItems,
+    GeneratedMacroCatalog,
+) {
+    let root = Digest([81; 32]);
+    let aux = Digest([82; 32]);
+    let (_, views, ps) = prepare(
+        vec![
+            unit(MODERN, "modern.rs", root, caller),
+            unit(INTERCRATE, "intercrate.rs", aux, definition),
+        ],
+        vec![SourceDependency {
+            consumer: root,
+            alias: "intercrate".into(),
+            provider: aux,
+        }],
+    );
+    let items = expansion(&views[0], &ps, 0, "define_uses_dollar_crate_modern_nested");
+    let cat = catalog(&views[0], &items);
+    (views, ps, items, cat)
+}
+#[test]
+fn unchanged_cross_edition_generated_macro2_keeps_owner_facet_and_token_editions_distinct() {
+    for (caller, definition) in [(2015, 2024), (2018, 2021), (2021, 2018), (2024, 2015)] {
+        let (views, ps, items, cat) = nested(caller, definition);
+        let proof =
+            PreparedGeneratedCompilerFacet::capture_current(&ps[0], &cat, 1, 64 * 1024 * 1024)
+                .unwrap();
+        proof.revalidate_current(&ps[0], &cat, 1).unwrap();
+        assert_eq!(proof.selection.outline.parse.profile.edition, caller);
+        assert_eq!(proof.record.key().call_edition, caller);
+        assert_eq!(proof.record.key().definition_edition, definition);
+        assert_eq!(
+            proof.compiler.runtime_prelude_unit(false),
+            crate::facade::unit(&views[0].outline().profile, "core")
+        );
+        assert!(items.tokens().contexts().iter().any(|c| c.defining_unit.0
+            == views[1].selection().outline.crate_key.0
+            && c.edition
+                == match definition {
+                    2015 => crate::syntax::token_wire::Edition::E2015,
+                    2018 => crate::syntax::token_wire::Edition::E2018,
+                    2021 => crate::syntax::token_wire::Edition::E2021,
+                    2024 => crate::syntax::token_wire::Edition::E2024,
+                    _ => panic!(),
+                }));
+        assert_eq!(proof.record.output(), items.record().output());
+        assert!(proof.child.is_none()); // No physical source publication or runtime grant.
+    }
+}
+#[test]
+fn current_parent_copy_epoch_missing_catalogue_and_foreign_facet_refuse() {
+    let (_, mut ps, _, cat) = nested(2024, 2015);
+    let proof =
+        PreparedGeneratedCompilerFacet::capture_current(&ps[0], &cat, 1, 64 * 1024 * 1024).unwrap();
+    assert!(proof.revalidate_current(&ps[1], &cat, 1).is_err());
+    assert!(proof.revalidate_current(&ps[0], &cat, 2).is_err());
+    let (_, copy, _, _) = nested(2024, 2015);
+    assert!(proof.revalidate_current(&copy[0], &cat, 1).is_err());
+    ps[0].compiler = None;
+    assert_eq!(
+        PreparedGeneratedCompilerFacet::capture_current(&ps[0], &cat, 1, 64 * 1024 * 1024)
+            .err()
+            .unwrap()
+            .code,
+        "LRR-E-COMPILE-INPUT"
+    );
+    ps[0].compiler = ps[1].compiler.clone();
+    assert!(
+        PreparedGeneratedCompilerFacet::capture_current(&ps[0], &cat, 1, 64 * 1024 * 1024).is_err()
+    );
+    assert!(proof.revalidate_current(&ps[0], &cat, 1).is_err());
+}
+#[test]
+fn another_real_original_expansion_cannot_replay_the_retained_record() {
+    let (views, ps, _, cat) = nested(2024, 2015);
+    let proof =
+        PreparedGeneratedCompilerFacet::capture_current(&ps[0], &cat, 1, 64 * 1024 * 1024).unwrap();
+    let different = expansion(&views[0], &ps, 0, "define_uses_dollar_crate_legacy_nested");
+    let different = catalog(&views[0], &different);
+    assert!(proof.revalidate_current(&ps[0], &different, 1).is_err());
+}
+#[test]
+fn transfer_budget_refuses_before_retaining_or_changing_the_owner() {
+    let (_, ps, _, cat) = nested(2024, 2015);
+    let before = ps[0]
+        .compiler
+        .as_ref()
+        .unwrap()
