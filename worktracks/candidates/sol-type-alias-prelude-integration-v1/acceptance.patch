+            .unwrap()
+            .code,
+        "LRR-E-METADATA-LIMIT"
+    );
+    assert_eq!(
+        ps[0]
+            .compiler
+            .as_ref()
+            .unwrap()
+            .owning_profile_identity()
+            .unwrap(),
+        before
+    );
+}
+type AdoptedFixture = (
+    Database,
+    Vec<PreparedSourceView>,
+    Vec<SourceDeclarative>,
+    GeneratedMacroCatalog,
+    Arc<ModuleSyntaxInput>,
+);
+fn adopted_module() -> AdoptedFixture {
+    adopted_module_source(MODULE, "issue-56411.rs", "import")
+}
+fn adopted_module_source(source: &str, source_path: &str, tail: &str) -> AdoptedFixture {
+    use crate::{
+        service::{
+            expansion::{DemandContext, ExpansionCoordinator, PhaseIdentity},
+            source_capture::SourceCapture,
+        },
+        source::{
+            include_paths::{IncludeAuthorities, IncludeLocation, IncludeRoot, IncludeRootKind},
+            module_capture::AdoptedModuleCapture,
+            module_view::CapturedModuleSourceView,
+        },
+    };
+    // The default caller uses unchanged upstream module source; policy negatives
+    // supply an independent LRR snapshot. The first owner remains distinct.
+    let root = Digest([83; 32]);
+    let other = Digest([84; 32]);
+    let (mut db, views, ps) = prepare(
+        vec![
+            unit(UNUSED, "unused.rs", other, 2015),
+            unit(source, source_path, root, 2024),
+        ],
+        vec![],
+    );
+    let items = expansion(&views[1], &ps, 1, tail);
+    let cat = catalog(&views[1], &items);
+    let demand = cat.unresolved_module_sources().next().unwrap().clone();
+    assert_eq!(
+        demand.header().expansion,
+        items.record().key().fingerprint()
+    );
+    let base = items
+        .tokens()
+        .spans()
+        .iter()
+        .find(|s| s.key() == demand.site())
+        .unwrap()
+        .clone();
+    let root_path = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../fixtures/upstream/rustc-checkout/tests/ui/modules")
+        .canonicalize()
+        .unwrap();
+    let roots = IncludeAuthorities::new(
+        root,
+        Digest([85; 32]),
+        [IncludeRoot {
+            identity: Digest([86; 32]),
+            path: root_path,
+            kind: IncludeRootKind::Source,
+        }],
+    )
+    .unwrap();
+    let capture = SourceCapture::open(
+        IncludeAuthorities::new(
+            root,
+            Digest([85; 32]),
+            [roots.root(Digest([86; 32])).unwrap().clone()],
+        )
+        .unwrap(),
+        BTreeMap::new(),
+    )
+    .unwrap();
+    let from = IncludeLocation {
+        unit: root,
+        root: Digest([86; 32]),
+        path: views[1].selection().path.clone(),
+        origin: base.origin,
+    };
+    let request = roots
+        .module_request(
+            &from,
+            Path::new(""),
+            demand.request().clone(),
+            demand.producer(),
+            demand.site(),
+        )
+        .unwrap();
+    let record = capture.capture_module(&request).unwrap();
+    let input = InputRequest::CaptureModule {
+        request: Box::new(request),
+        compile_environment: items.record().key().consumer_compile_env,
+    };
+    let context = DemandContext {
+        request: Digest([87; 32]),
+        session: Digest([88; 32]),
+        unit: root,
+        revision: db.source_revision(),
+        epoch: 1,
+        source_generation: Digest([85; 32]),
+        native_generation: None,
+        compile_environment: items.record().key().consumer_compile_env,
+    };
+    let mut coordinator = ExpansionCoordinator::new(context.clone());
+    let body = views[1]
+        .outline()
+        .items
+        .iter()
+        .find(|i| i.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let token = coordinator
+        .issue(
+            QueryKey::Outline(views[1].selection().outline.clone()),
+            PhaseIdentity {
+                frame: Digest([89; 32]),
+                body: body.key(),
+                index: 0,
+            },
+            input.clone(),
+        )
+        .unwrap();
+    coordinator.start(&context, &token).unwrap();
+    coordinator
+        .accept_module(&context, &token, &record)
+        .unwrap();
+    coordinator
+        .adopt_module(&context, &token, &mut db, record)
+        .unwrap();
+    let actual = db
+        .input(&InputKey::ModuleRecord(input.fingerprint()))
+        .unwrap();
+    assert!(matches!(actual.as_ref(), InputValue::ModuleRecord { .. }));
+    let lease = Arc::new(AdoptedModuleCapture::new(actual).unwrap());
+    let origin = Arc::new(
+        CapturedModuleSourceView::new(lease, items, demand, views[1].share(), base).unwrap(),
+    );
+    let syntax = Arc::new(ModuleSyntaxInput::prepare(origin).unwrap());
+    (db, views, ps, cat, syntax)
+}
+#[test]
+fn unchanged_generated_module_adopted_source_uses_actual_second_owner_once() {
