+const NESTED: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/modules/mod_dir_recursive.rs"
+);
+fn ordinary_child(parent: &PreparedSourceView) -> PreparedSourceView {
+    use crate::{
+        db::{dependency::InputKey, key::QueryKey, memo::Database, poll::InputRequest},
+        frontend::source_module_declarations::SourceModuleDeclaration,
+        service::{
+            expansion::{DemandContext, ExpansionCoordinator, PhaseIdentity},
+            source_capture::SourceCapture,
+        },
+        source::{
+            include_paths::{IncludeAuthorities, IncludeRoot, IncludeRootKind},
+            module_capture::AdoptedModuleCapture,
+            ordinary_module::{OrdinaryModuleSourceView, OrdinaryModuleSyntaxInput},
+        },
+    };
+    use std::{collections::BTreeMap, path::Path, sync::Arc};
+    let declaration = SourceModuleDeclaration::from_captured(parent)
+        .unwrap()
+        .into_iter()
+        .next()
+        .unwrap();
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../fixtures/upstream/rustc-checkout/tests/ui/modules")
+        .canonicalize()
+        .unwrap();
+    let unit = parent.selection().outline.crate_key;
+    let authorities = IncludeAuthorities::new(
+        unit,
+        Digest([103; 32]),
+        [IncludeRoot {
+            identity: Digest([104; 32]),
+            path: root,
+            kind: IncludeRootKind::Source,
+        }],
+    )
+    .unwrap();
+    let capture = SourceCapture::open(
+        IncludeAuthorities::new(
+            unit,
+            Digest([103; 32]),
+            [authorities.root(Digest([104; 32])).unwrap().clone()],
+        )
+        .unwrap(),
+        BTreeMap::new(),
+    )
+    .unwrap();
+    let directory = Path::new(parent.selection().path.as_str())
+        .parent()
+        .unwrap_or(Path::new(""));
+    let environment = crate::expand::builtins::FrozenCompileEnvironment::new(
+        unit,
+        &crate::project::tool_manifest::CompileEnv {
+            unit,
+            host: "aarch64-apple-darwin".into(),
+            target: "aarch64-apple-darwin".into(),
+            cfg: parent.captured_macro_cfg().unwrap().clone(),
+            cargo: BTreeMap::new(),
+            rustc_env: BTreeMap::new(),
+            declared: BTreeMap::new(),
+            out_dir: None,
+        },
+    )
+    .unwrap()
+    .fingerprint();
+    let input = declaration
+        .capture_request(&authorities, directory, environment)
+        .unwrap();
+    let InputRequest::CaptureModule { request, .. } = &input else {
+        panic!()
+    };
+    let captured = capture.capture_module(request).unwrap();
+    let mut db = Database::default();
+    db.begin_expansion_epoch(1).unwrap();
+    let context = DemandContext {
+        request: Digest([106; 32]),
+        session: Digest([107; 32]),
+        unit,
+        revision: db.source_revision(),
+        epoch: 1,
+        source_generation: Digest([103; 32]),
+        native_generation: None,
+        compile_environment: environment,
+    };
+    let body = parent
+        .outline()
+        .items
+        .iter()
+        .find_map(|i| i.body.as_ref())
+        .map(|b| b.key())
+        .unwrap_or(crate::source::manifest::BodyKey {
+            definition: declaration.definition().fingerprint(),
+            exact_body_bytes: parent.selection().outline.parse.content,
+        });
+    let mut coordinator = ExpansionCoordinator::new(context.clone());
+    let token = coordinator
+        .issue(
+            QueryKey::Outline(parent.selection().outline.clone()),
+            PhaseIdentity {
+                frame: Digest([108; 32]),
+                body,
+                index: 0,
+            },
+            input.clone(),
+        )
+        .unwrap();
+    coordinator.start(&context, &token).unwrap();
+    coordinator
+        .accept_module(&context, &token, &captured)
+        .unwrap();
+    coordinator
+        .adopt_module(&context, &token, &mut db, captured)
+        .unwrap();
+    let adopted = Arc::new(
+        AdoptedModuleCapture::new(
+            db.input(&InputKey::ModuleRecord(input.fingerprint()))
+                .unwrap(),
+        )
+        .unwrap(),
+    );
+    let origin = Arc::new(OrdinaryModuleSourceView::new(&declaration, &input, adopted).unwrap());
+    OrdinaryModuleSyntaxInput::prepare(origin)
+        .unwrap()
+        .prepared_source()
+        .share()
+}
