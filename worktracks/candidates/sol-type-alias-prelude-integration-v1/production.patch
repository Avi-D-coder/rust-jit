+//! Retained owning-crate policy, separate from namespace/macro authority.
+use super::*;
+use crate::{
+    core::digest::{Digest, StableEncode, StableEncoder},
+    syntax::{macro_prelude::MacroPreludePolicy, parse::ParsedFile},
+};
+struct Row {
+    source: PreparedSourceView,
+    selection: SourceSelection,
+    origin: Digest,
+}
+pub(crate) struct PreparedCratePreludePolicy {
+    endpoint: PreparedSourceView,
+    root: PreparedSourceView,
+    rows: Vec<Row>,
+    standard: bool,
+    disabled: Vec<Vec<String>>,
+    retained_epoch: Option<u64>,
+    current_epoch: Option<u64>,
+    bytes: usize,
+}
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-CATALOG-INCOMPLETE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new("LRR-E-METADATA-LIMIT", "owning crate policy budget".into())
+}
+fn charge(bytes: &mut usize, n: usize, maximum: usize) -> Result<(), Diagnostic> {
+    *bytes = bytes
+        .checked_add(n)
+        .filter(|n| *n <= maximum)
+        .ok_or_else(limit)?;
+    Ok(())
+}
+fn mapped_disabled(
+    out: &mut Vec<Vec<String>>,
+    policy: &MacroPreludePolicy,
+    base: &[String],
+    target: &[String],
+    bytes: &mut usize,
+    maximum: usize,
+) -> Result<(), Diagnostic> {
+    for relative in &policy.disabled {
+        let count = base
+            .len()
+            .checked_add(relative.len())
+            .filter(|n| *n <= 256)
+            .ok_or_else(limit)?;
+        let path = base.iter().chain(relative).collect::<Vec<_>>();
+        let inherited = path.len() <= target.len() && path.iter().zip(target).all(|(a, b)| *a == b);
+        let below = target.len() <= path.len() && path.iter().zip(target).all(|(a, b)| *a == b);
+        if !inherited && !below {
+            continue;
+        }
+        if out.len() >= 100_000 {
+            return Err(limit());
+        }
+        let suffix = if inherited {
+            &path[count..]
+        } else {
+            &path[target.len()..]
+        };
+        let n = suffix
+            .iter()
+            .try_fold(128usize, |n, s| {
+                n.checked_add(s.capacity())
+                    .and_then(|n| n.checked_add(std::mem::size_of::<String>()))
+            })
+            .ok_or_else(limit)?;
+        charge(bytes, n, maximum)?;
+        out.try_reserve(1).map_err(|_| limit())?;
+        out.push(suffix.iter().map(|s| (*s).clone()).collect());
+    }
+    Ok(())
+}
+impl PreparedCratePreludePolicy {
+    pub(crate) fn capture_retained(
+        view: &PreparedSourceView,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        if byte_limit > 32 * 1024 * 1024 {
+            return Err(limit());
+        }
+        let mut bytes = std::mem::size_of::<Self>()
+            .checked_add(256)
+            .and_then(|n| n.checked_add(256 * std::mem::size_of::<&String>()))
+            .and_then(|n| n.checked_add(256 * std::mem::size_of::<(&PreparedSourceView, Digest)>()))
+            .filter(|n| *n <= byte_limit)
+            .ok_or_else(limit)?;
+        let target = &view.selection().outline.module_path;
+        let unit = view.selection().outline.crate_key;
+        let profile = &view.selection().outline.parse.profile;
+        let cfg = view.selection().outline.cfg;
+        let mut cursor = view;
+        let mut borrowed = Vec::<(&PreparedSourceView, Digest)>::new();
+        let mut disabled = Vec::new();
+        let mut retained_epoch = None;
+        loop {
+            if borrowed.len() >= 256
+                || borrowed.iter().any(|(old, _)| {
+                    old.same_publication(cursor) && old.selection() == cursor.selection()
+                })
+            {
+                return Err(fault("owning crate lineage absent/cyclic or over budget"));
+            }
+            cursor.require_declaration_syntax()?;
+            if cursor.selection().outline.crate_key != unit
+                || &cursor.selection().outline.parse.profile != profile
+                || cursor.selection().outline.cfg != cfg
+                || !target.starts_with(&cursor.selection().outline.module_path)
+            {
+                return Err(fault(
+                    "owning crate lineage unit/profile/cfg/module differs",
+                ));
+            }
+            let row_bytes = cursor
+                .selection()
+                .metadata_bytes()?
+                .checked_mul(3)
+                .and_then(|n| n.checked_add(std::mem::size_of::<Row>() + 128))
+                .ok_or_else(limit)?;
+            charge(&mut bytes, row_bytes, byte_limit)?;
+            borrowed.try_reserve(1).map_err(|_| limit())?;
+            let local = cursor.local_macro_prelude_policy()?;
+            mapped_disabled(
+                &mut disabled,
+                &local,
+                &cursor.selection().outline.module_path,
+                target,
+                &mut bytes,
+                byte_limit,
+            )?;
+            let mut e = StableEncoder::new("lrr/v1/crate-policy-lineage-row");
+            e.digest(cursor.selection().location_identity());
+            e.record(&cursor.selection().outline.parse);
+            e.digest(cfg);
+            match (
+                &cursor.state._module_origin,
+                &cursor.state._ordinary_module_origin,
+            ) {
+                (Some(origin), None) => {
+                    let demand = origin.declaration();
+                    let items = origin.parent();
+                    let parent = origin.caller();
+                    if items.epoch() == 0
+                        || retained_epoch.is_some_and(|epoch| epoch != items.epoch())
+                        || items
+                            .record()
+                            .key()
+                            .procedural_epoch
+                            .is_some_and(|epoch| epoch != items.epoch())
+                    {
+                        return Err(fault("owning crate generated lineage epoch differs"));
+                    }
+                    retained_epoch = Some(items.epoch());
+                    items.record().key().validate()?;
+                    if demand.scope() != &cursor.outline().root_scope
+                        || demand.header() != origin.parent_header()
+                        || demand.producer() != origin.producer()
+                        || !items.items().iter().any(|h| &h.key == demand.header())
+                    {
+                        return Err(fault(
+                            "owning crate generated declaration/header lineage differs",
+                        ));
+                    }
+                    let suffix = &demand.request().module_path;
+                    let base = demand
+                        .scope()
+                        .module_path
+                        .strip_suffix(suffix.as_slice())
+                        .filter(|base| {
+                            !suffix.is_empty()
+                                && base.starts_with(&parent.selection().outline.module_path)
+                        })
+                        .ok_or_else(|| {
+                            fault("owning crate generated module scope/request differs")
+                        })?;
+                    let selected = origin.capture().record().selected()?;
+                    if selected.location().unit != unit
+                        || selected.location().path != cursor.selection().path
+                        || selected.blob().content() != cursor.selection().outline.parse.content
+                    {
+                        return Err(fault("owning crate generated capture/source differs"));
+                    }
+                    let parsed = ParsedFile::from_generated_items(items)?;
+                    let generated = parsed.macro_prelude_policy(parent.captured_macro_cfg()?)?;
+                    if !generated.standard || generated.disabled.iter().any(Vec::is_empty) {
+                        return Err(fault(
+                            "generated crate-level policy requires an owning declaration contract",
+                        ));
+                    }
+                    mapped_disabled(
+                        &mut disabled,
+                        &generated,
+                        base,
+                        target,
+                        &mut bytes,
+                        byte_limit,
+                    )?;
+                    e.u8(1);
+                    e.record(items.record().key());
+                    e.digest(items.record().output());
+                    e.u64(items.epoch());
+                    e.record(demand.header());
+                    e.digest(demand.producer());
+                    e.bytes(&demand.site().0);
+                    e.digest(origin.capture().record().identity());
+                    borrowed.push((cursor, e.finish()));
+                    cursor = parent;
+                }
+                (None, Some(origin)) => {
+                    let declaration = origin.declaration();
+                    let parent = declaration.source();
+                    let selected = origin.capture().record().selected()?;
+                    if declaration.scope() != &cursor.outline().root_scope
+                        || selected.location().unit != unit
+                        || selected.location().path != cursor.selection().path
+                        || selected.blob().content() != cursor.selection().outline.parse.content
+                    {
+                        return Err(fault(
+                            "owning crate ordinary declaration/capture lineage differs",
+                        ));
+                    }
+                    e.u8(2);
+                    e.record(declaration);
+                    e.digest(origin.capture().record().identity());
+                    e.digest(origin.compile_environment());
+                    borrowed.push((cursor, e.finish()));
+                    cursor = parent;
+                }
+                (None, None) => {
+                    if !cursor.selection().outline.module_path.is_empty() {
+                        return Err(fault("owning crate root requires retained module origin"));
+                    }
+                    let file = cursor
+                        .state
+                        .files
+                        .get(&cursor.location)
+                        .ok_or_else(|| fault("owning crate original source absent"))?;
+                    if file.parsed.generated_origin.is_some() {
+                        return Err(fault("owning crate original root has generated origin"));
+                    }
+                    let graph = cursor.source_dependencies()?;
+                    if graph.root_for(unit) != Some(cursor.selection()) {
+                        return Err(fault(
+                            "owning crate root not selected by actual source dependency graph",
+                        ));
+                    }
+                    e.u8(0);
+                    e.digest(graph.fingerprint());
+                    borrowed.push((cursor, e.finish()));
+                    break;
+                }
+                _ => {
+                    return Err(fault(
+                        "owning crate source has conflicting retained origins",
+                    ));
+                }
+            }
+        }
+        charge(
+            &mut bytes,
+            view.selection()
+                .metadata_bytes()?
+                .checked_mul(2)
+                .ok_or_else(limit)?,
+            byte_limit,
+        )?;
+        charge(
+            &mut bytes,
+            cursor
+                .selection()
+                .metadata_bytes()?
+                .checked_mul(2)
+                .ok_or_else(limit)?,
+            byte_limit,
+        )?;
+        let standard = cursor.local_macro_prelude_policy()?.standard;
+        disabled.sort();
+        disabled.dedup();
+        let mut rows = Vec::new();
+        rows.try_reserve_exact(borrowed.len())
+            .map_err(|_| limit())?;
+        for (source, origin) in borrowed {
+            rows.push(Row {
+                source: source.share(),
+                selection: source.selection().clone(),
+                origin,
+            })
+        }
+        Ok(Self {
+            endpoint: view.share(),
+            root: cursor.share(),
+            rows,
+            standard,
+            disabled,
+            retained_epoch,
+            current_epoch: None,
+            bytes,
+        })
+    }
+    pub(crate) fn capture_current(
+        view: &PreparedSourceView,
+        epoch: u64,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        if epoch == 0 {
+            return Err(fault("owning crate policy current epoch absent"));
+        }
+        let mut prepared = Self::capture_retained(view, byte_limit)?;
+        if prepared.retained_epoch.is_some_and(|e| e != epoch) {
+            return Err(fault("owning crate policy current generated epoch differs"));
+        }
+        prepared.current_epoch = Some(epoch);
+        Ok(prepared)
+    }
+    pub(crate) fn revalidate_current(
+        &self,
+        view: &PreparedSourceView,
+        epoch: u64,
+    ) -> Result<(), Diagnostic> {
+        let current = Self::capture_current(view, epoch, self.bytes)?;
+        if self.current_epoch != Some(epoch)
+            || !self.endpoint.same_publication(view)
+            || self.endpoint.selection() != view.selection()
+            || !self.root.same_publication(&current.root)
+            || self.root.selection() != current.root.selection()
+            || self.rows.len() != current.rows.len()
+            || !self.rows.iter().zip(&current.rows).all(|(a, b)| {
+                a.source.same_publication(&b.source)
+                    && a.selection == b.selection
+                    && a.origin == b.origin
+            })
+            || self.identity() != current.identity()
+        {
+            return Err(fault("owning crate policy source/current lineage changed"));
+        }
+        Ok(())
+    }
+    /// Actual captured lineage evidence, never a caller-supplied completeness list.
+    pub(crate) fn source_selections(&self) -> impl Iterator<Item = &SourceSelection> {
+        self.rows.iter().map(|row| &row.selection)
+    }
+    pub(crate) fn owning_root_selection(&self) -> &SourceSelection {
+        self.root.selection()
+    }
+    pub(crate) fn policy(&self) -> MacroPreludePolicy {
+        MacroPreludePolicy {
+            standard: self.standard,
+            disabled: self.disabled.clone(),
+        }
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/owning-crate-prelude-policy");
+        e.bool(self.standard);
+        e.sequence(&self.disabled, |e, path| {
+            e.sequence(path, |e, name| e.string(name))
+        });
+        e.option(&self.current_epoch, |e, n| e.u64(*n));
+        e.u64(self.rows.len() as u64);
+        for row in &self.rows {
+            e.digest(row.origin)
+        }
+        e.finish()
+    }
+}
