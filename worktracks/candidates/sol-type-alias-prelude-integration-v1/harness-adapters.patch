+// Explicit current Type preparation for positive source-alias contracts; no thunk/body entry.
+fn prepare_current_type_source(db: &mut Database, view: &PreparedSourceView) {
+    use lrr::{
+        expand::{
+            source_declarative,
+            source_discovery::{SourceDiscovery, SourceDiscoveryStep},
+        },
+        frontend::compile_input_catalog::CompileInputCatalog,
+        source::manifest::Namespace,
+    };
+    db.begin_expansion_epoch(1).unwrap();
+    let mut discovery = SourceDiscovery::new(
+        vec![view.share()],
+        view.outline().root_scope.clone(),
+        Namespace::Type,
+        Digest::of_bytes(b"explicit alias test Type universe"),
+        1,
+    )
+    .unwrap()
+    .with_declarative_compiler(
+        Digest::of_bytes(b"explicit alias compiler input"),
+        source_declarative::engine_version(),
+        std::sync::Arc::new(
+            CompileInputCatalog::standalone(&view.selection().outline.parse.profile).unwrap(),
+        ),
+    )
+    .unwrap();
+    loop {
+        match discovery.poll().unwrap() {
+            SourceDiscoveryStep::Sealed(_) => break,
+            SourceDiscoveryStep::NeedExpansion { request } => discovery
+                .admit_expansion(std::sync::Arc::new(request.expand().unwrap()))
+                .unwrap(),
+            SourceDiscoveryStep::NeedGeneratedExpansion { request } => discovery
+                .admit_expansion(std::sync::Arc::new(request.expand().unwrap()))
+                .unwrap(),
+            SourceDiscoveryStep::Incomplete { diagnostic, .. } => panic!(
+                "actual Type preparation prerequisite: {} {}",
+                diagnostic.code, diagnostic.message
+            ),
+            _ => panic!("actual Type preparation incomplete"),
+        }
+    }
+    discovery.publish(db).unwrap();
+}
