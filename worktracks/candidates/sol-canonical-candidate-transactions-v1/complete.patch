+    syntax::{outline::ScopeKey, parse::ParsedFile},
+    traits::{
+        canonical::{CanonicalContextModel, CanonicalGoalModel, CanonicalLimits, GoalModel},
+        header::{HeaderCaptureLimits, HeaderKind},
+        term::{
+            Binder, BoundKind, ConstTerm, GenericArg, InferVarKey, ParamEnv, ParamKey,
+            ProjectionKey, RegionTerm, TraitRef, TyTerm,
+        },
+        unify::candidate::{CandidateFactoryModel, CandidateReadiness, ConstraintAttempt},
+    },
+};
+use std::collections::BTreeMap;
+fn headers(text: &str, unit: u8) -> lrr::traits::header::CapturedSourceHeaders {
+    let mut p = ProfileIdentity::current();
+    p.edition = 2015;
+    let parsed =
+        ParsedFile::parse_declarations(&SourceBlob::new(text.as_bytes().to_vec()).unwrap(), p)
+            .unwrap();
+    parsed
+        .capture_trait_headers(
+            SourcePath::new("fixture.rs").unwrap(),
+            ScopeKey {
+                crate_key: Digest([unit; 32]),
+                module_path: vec![],
+                owner: None,
+            },
+            &CfgSet::guest_default(),
+            HeaderCaptureLimits::default(),
+        )
+        .unwrap()
+}
+fn context(tx: u8) -> CanonicalContextModel {
+    CanonicalContextModel {
+        transaction: Digest([tx; 32]),
+        profile: ProfileIdentity::current(),
+        unit: Digest([81; 32]),
+        world: Digest([82; 32]),
+        catalog: Digest([83; 32]),
+        cfg: Digest([84; 32]),
+        source_namespace: Digest([85; 32]),
+        epoch: 1,
+        source_revision: 1,
+        query_revision: 1,
+        max_universe: 2,
+        excluded_dictionary_slots: vec![],
+    }
+}
+fn encode(
+    context: &CanonicalContextModel,
+    goal: GoalModel,
+    env: &ParamEnv,
+    vars: BTreeMap<InferVarKey, u32>,
+) -> CanonicalGoalModel {
+    CanonicalGoalModel::capture(
+        context,
+        &Binder {
+            variables: vec![],
+            value: goal,
+        },
+        env,
+        &vars,
+        CanonicalLimits::default(),
+    )
+    .unwrap()
+}
