+            TyTerm::Primitive(lrr::ir::op::PrimitiveType::Unit),
+        )
+    };
+    assert_ne!(
+        encode(&cx, projection(1), &env, BTreeMap::new()).fingerprint(),
+        encode(&cx, projection(2), &env, BTreeMap::new()).fingerprint()
