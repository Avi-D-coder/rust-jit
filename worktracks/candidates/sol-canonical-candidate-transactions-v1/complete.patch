+    let v = c
+        .instantiate_type_model(&TyTerm::Param(header.generics()[0].key))
+        .unwrap();
+    assert!(matches!(
+        c.attempt_constraints(&[(v, TyTerm::Primitive(lrr::ir::op::PrimitiveType::Unit))]),
+        ConstraintAttempt::Overflow(_)
+    ));
+    assert_eq!(c.binding_count(), 0);
+    let mut f = CandidateFactoryModel::new(Digest([92; 32]), CanonicalLimits::default()).unwrap();
+    let mut c = f.start(header).unwrap();
+    let v = c
+        .instantiate_type_model(&TyTerm::Param(header.generics()[0].key))
+        .unwrap();
+    let universe = c.fresh_universe().unwrap();
+    assert!(matches!(
+        c.attempt_constraints(&[(
+            v,
+            TyTerm::Placeholder(PlaceholderKey {
+                transaction: c.transaction(),
+                universe,
+                index: 0
+            })
+        )]),
+        ConstraintAttempt::Conflict(_)
+    ));
+    assert_eq!(c.binding_count(), 0);
+}
+#[test]
+fn m020_potential_candidates_preserve_ambiguity_without_chosen_witness() {
+    use lrr::traits::unify::candidate::{
+        CandidateDispositionModel as D, CandidateSetModel, combine_candidate_models,
+    };
+    let a = Digest([93; 32]);
+    let b = Digest([94; 32]);
+    assert!(
+        matches!(combine_candidate_models(vec![(b,D::Unresolved),(a,D::StructuralMatchPending)]).unwrap(),CandidateSetModel::Ambiguous(keys) if keys==vec![a,b])
+    );
+    assert!(matches!(
+        combine_candidate_models(vec![(a, D::StructuralConflict)]).unwrap(),
+        CandidateSetModel::NoStructuralMatch(_)
+    ));
+    assert!(
+        combine_candidate_models(vec![(a, D::StructuralMatchPending), (a, D::Unresolved)]).is_err()
+    );
+}
