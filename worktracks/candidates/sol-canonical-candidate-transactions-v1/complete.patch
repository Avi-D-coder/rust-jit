new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/traits/candidate_transactions.rs
@@ -0,0 +1,552 @@
+//! Candidate-local type transactions. Structural matching is not trait fulfillment.
+use super::Unifier;
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    traits::{
+        canonical::{CanonicalError, CanonicalLimits},
+        header::{HeaderPredicate, SourceTraitHeader},
+        subst::Substitution,
+        term::*,
+    },
+};
+const SCRATCH_BYTES: usize = 32 * 1024 * 1024;
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CandidateReadiness {
+    SourceGoalAndPredicatesRequired,
+    GenericNamespaceRequired,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum UnificationRequirement {
+    ProjectionNormalization,
+    FunctionBinderMatching,
+    DynOrOpaqueSchema,
+    BoundUniverseMatching,
+    ConstEquality,
+    RegionEquality,
+    CandidateGenericNamespace,
+    SourceGoal,
+}
+#[derive(Debug)]
+pub enum ConstraintAttempt {
+    MatchedPending,
+    Conflict(Diagnostic),
+    Unresolved(Vec<UnificationRequirement>),
+    Overflow(CanonicalError),
+    Invalid(Diagnostic),
+}
+fn invalid(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-CANDIDATE-TRANSACTION", message.into())
+}
+/// Explicit component-model demand. A live demand/source-goal producer must
+/// supply the ordered authority later; this token cannot grant execution.
+pub struct CandidateFactoryModel {
+    demand: Digest,
+    next: u64,
+    limits: CanonicalLimits,
+}
+impl CandidateFactoryModel {
+    pub fn new(demand: Digest, limits: CanonicalLimits) -> Result<Self, CanonicalError> {
+        Ok(Self {
+            demand,
+            next: 0,
+            limits: limits.validate()?,
+        })
+    }
+    pub fn start(
+        &mut self,
+        header: &SourceTraitHeader,
+    ) -> Result<CandidateTransaction, CanonicalError> {
+        if !matches!(
+            header.kind(),
+            crate::traits::header::HeaderKind::Impl { .. }
+        ) {
+            return Err(CanonicalError::Invalid(
+                "candidate template must be an actual captured impl header",
+            ));
+        }
+        if header.generics().len() > self.limits.variables {
+            return Err(CanonicalError::Overflow(
+                crate::traits::canonical::CanonicalLimit::Variables,
+            ));
+        }
+        let estimate = header
+            .candidate_snapshot_bytes()
+            .map_err(CanonicalError::SourceTerm)?
+            .checked_add(header.generics().len().checked_mul(512).ok_or(
+                CanonicalError::Overflow(crate::traits::canonical::CanonicalLimit::Bytes),
+            )?)
+            .filter(|n| *n <= SCRATCH_BYTES)
+            .ok_or(CanonicalError::Overflow(
+                crate::traits::canonical::CanonicalLimit::Bytes,
+            ))?;
+        let serial = self
+            .next
+            .checked_add(1)
+            .ok_or(CanonicalError::Invalid("candidate serial overflow"))?;
+        let mut e = StableEncoder::new("lrr/v5/candidate-local-transaction/v1");
+        e.digest(self.demand);
+        e.digest(header.exact_identity());
+        e.u64(serial);
+        let transaction = e.finish();
+        let mut unifier = Unifier::new(transaction);
+        let mut substitution = Substitution::default();
+        let mut unsupported = Vec::new();
+        let mut variables = Vec::new();
+        variables
+            .try_reserve_exact(header.generics().len())
+            .map_err(|_| {
+                CanonicalError::Overflow(crate::traits::canonical::CanonicalLimit::Bytes)
+            })?;
+        for p in header.generics() {
+            if p.kind != BoundKind::Type {
+                unsupported.try_reserve_exact(1).map_err(|_| {
+                    CanonicalError::Overflow(crate::traits::canonical::CanonicalLimit::Bytes)
+                })?;
+                unsupported.push((p.kind, p.key));
+                continue;
+            }
+            let key = InferVarKey {
+                transaction,
+                ordinal: u32::try_from(variables.len()).map_err(|_| {
+                    CanonicalError::Overflow(crate::traits::canonical::CanonicalLimit::Variables)
+                })?,
+            };
+            unifier
+                .register_variable(key, 0)
+                .map_err(CanonicalError::SourceTerm)?;
+            substitution
+                .insert(p.key, GenericArg::Type(TyTerm::Infer(key)))
+                .map_err(CanonicalError::SourceTerm)?;
+            variables.push((p.key, key));
+        }
+        let pending = header.predicates().to_vec();
+        self.next = serial;
+        Ok(CandidateTransaction {
+            header: header.exact_identity(),
+            transaction,
+            unifier,
+            substitution,
+            variables,
+            unsupported,
+            pending,
+            source_reservation: estimate,
+            limits: self.limits,
+        })
+    }
+}
+pub struct CandidateTransaction {
+    header: Digest,
+    transaction: Digest,
+    unifier: Unifier,
+    substitution: Substitution,
+    variables: Vec<(ParamKey, InferVarKey)>,
+    unsupported: Vec<(BoundKind, ParamKey)>,
+    pending: Vec<HeaderPredicate>,
+    source_reservation: usize,
+    limits: CanonicalLimits,
+}
+impl CandidateTransaction {
+    pub fn transaction(&self) -> Digest {
+        self.transaction
+    }
+    pub fn source_header(&self) -> Digest {
+        self.header
+    }
+    pub fn pending_predicate_count(&self) -> usize {
+        self.pending.len()
+    }
+    pub fn pending_predicates(&self) -> &[HeaderPredicate] {
+        &self.pending
+    }
+    pub fn binding_count(&self) -> usize {
+        self.unifier.bindings.len()
+    }
+    pub fn readiness(&self) -> CandidateReadiness {
+        if self.unsupported.is_empty() {
+            CandidateReadiness::SourceGoalAndPredicatesRequired
+        } else {
+            CandidateReadiness::GenericNamespaceRequired
+        }
+    }
+    pub fn parameter_variable(&self, key: ParamKey) -> Option<InferVarKey> {
+        self.variables.iter().find(|p| p.0 == key).map(|p| p.1)
+    }
+    pub fn binding(&self, key: InferVarKey) -> Option<&TyTerm> {
+        self.unifier.binding(key)
+    }
+    pub fn fresh_universe(&mut self) -> Result<u32, Diagnostic> {
+        self.unifier.fresh_universe()
+    }
+    /// Candidate template parameters only. Applying this to a caller's symbolic
+    /// view is not allowed by the eventual source-goal adapter. All other Params
+    /// stay rigid; no runtime descriptor substitution is consulted.
+    pub fn instantiate_type_model(&self, template: &TyTerm) -> Result<TyTerm, Diagnostic> {
+        self.substitution.apply(template)
+    }
+    pub fn attempt_constraints(&mut self, pairs: &[(TyTerm, TyTerm)]) -> ConstraintAttempt {
+        let mut requirements = std::collections::BTreeSet::new();
+        let mut admission_work = 0usize;
+        let mut input_bytes = 0usize;
+        for (a, b) in pairs {
+            for t in [a, b] {
+                let Some((nodes, bytes)) = t.measure() else {
+                    return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                        crate::traits::canonical::CanonicalLimit::Bytes,
+                    ));
+                };
+                admission_work = match admission_work.checked_add(nodes) {
+                    Some(n) if n <= self.limits.work => n,
+                    _ => {
+                        return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                            crate::traits::canonical::CanonicalLimit::Work,
+                        ));
+                    }
+                };
+                input_bytes = match input_bytes
+                    .checked_add(bytes)
+                    .and_then(|n| n.checked_add(std::mem::size_of::<TyTerm>()))
+                {
+                    Some(n) if n <= SCRATCH_BYTES => n,
+                    _ => {
+                        return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                            crate::traits::canonical::CanonicalLimit::Bytes,
+                        ));
+                    }
+                };
+                if let Err(error) = t.validate_opaque_shape() {
+                    return ConstraintAttempt::Invalid(error);
+                }
+                if let Err(error) =
+                    requirements_for(t, self.transaction, &mut requirements, 0, self.limits.depth)
+                {
+                    return ConstraintAttempt::Invalid(error);
+                }
+            }
+            if definitely_different_outer(a, b) {
+                return ConstraintAttempt::Conflict(invalid(
+                    "definite outer source constructor mismatch",
+                ));
+            }
+            collect_pair_requirements(a, b, &mut requirements, 0, self.limits.depth);
+        }
+        if !requirements.is_empty() {
+            return ConstraintAttempt::Unresolved(requirements.into_iter().collect());
+        }
+        if !self.unsupported.is_empty() {
+            return ConstraintAttempt::Unresolved(vec![
+                UnificationRequirement::CandidateGenericNamespace,
+            ]);
+        }
+        let Some(old_bytes) = unifier_bytes(&self.unifier) else {
+            return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                crate::traits::canonical::CanonicalLimit::Bytes,
+            ));
+        };
+        // Existing Unifier stages its maps/work queues. Reserve the parent snapshot,
+        // outer candidate stage and inner pair stage, plus bounded input work storage.
+        if old_bytes
+            .checked_mul(3)
+            .and_then(|n| n.checked_add(input_bytes.checked_mul(4)?))
+            .and_then(|n| n.checked_add(self.source_reservation))
+            .is_none_or(|n| n > SCRATCH_BYTES)
+        {
+            return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                crate::traits::canonical::CanonicalLimit::Bytes,
+            ));
+        }
+        let mut staged = self.unifier.clone();
+        let mut used = admission_work;
+        for (left, right) in pairs {
+            let Some(remaining) = self.limits.work.checked_sub(used) else {
+                return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                    crate::traits::canonical::CanonicalLimit::Work,
+                ));
+            };
+            match staged.unify_with_work_limit(left, right, remaining) {
+                Ok(steps) => {
+                    used = match used.checked_add(steps) {
+                        Some(n) if n <= self.limits.work => n,
+                        _ => {
+                            return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                                crate::traits::canonical::CanonicalLimit::Work,
+                            ));
+                        }
+                    };
+                }
+                Err(error) if error.code == "LRR-E-METADATA-LIMIT" => {
+                    return ConstraintAttempt::Overflow(CanonicalError::SourceTerm(error));
+                }
+                Err(error) => return ConstraintAttempt::Conflict(error),
+            }
+        }
+        if unifier_bytes(&staged)
+            .and_then(|n| n.checked_add(self.source_reservation))
+            .is_none_or(|n| n > SCRATCH_BYTES)
+        {
+            return ConstraintAttempt::Overflow(CanonicalError::Overflow(
+                crate::traits::canonical::CanonicalLimit::Bytes,
+            ));
+        }
+        self.unifier = staged;
+        // Structural constraints committed locally; neither header predicates nor
+        // reached source/goal/catalog/trait obligations were discharged.
+        ConstraintAttempt::MatchedPending
+    }
+}
+fn unifier_bytes(u: &Unifier) -> Option<usize> {
+    let mut bytes = std::mem::size_of::<Unifier>()
+        .checked_add(u.variable_universes.len().checked_mul(128)?)?
+        .checked_add(
+            u.bindings
+                .len()
+                .checked_mul(128 + std::mem::size_of::<TyTerm>())?,
+        )?;
+    for t in u.bindings.values() {
+        bytes = bytes.checked_add(t.heap_bytes()?)?;
+    }
+    Some(bytes)
+}
+fn requirements_for(
+    t: &TyTerm,
+    transaction: Digest,
+    required: &mut std::collections::BTreeSet<UnificationRequirement>,
+    depth: usize,
+    limit: usize,
+) -> Result<(), Diagnostic> {
+    if depth >= limit {
+        return Err(invalid("candidate shape depth limit"));
+    }
+    match t {
+        TyTerm::Infer(v) if v.transaction != transaction => {
+            return Err(invalid("foreign candidate inference transaction"));
+        }
+        TyTerm::Placeholder(p) if p.transaction != transaction => {
+            return Err(invalid("foreign candidate universal placeholder"));
+        }
+        TyTerm::Projection(p) => {
+            required.insert(UnificationRequirement::ProjectionNormalization);
+            requirements_for(
+                &p.trait_ref.self_ty,
+                transaction,
+                required,
+                depth + 1,
+                limit,
+            )?;
+            for a in p.arguments() {
+                match a {
+                    GenericArg::Type(t) => {
+                        requirements_for(t, transaction, required, depth + 1, limit)?
+                    }
+                    GenericArg::Const(c) => const_requirement(c, transaction, required)?,
+                    GenericArg::Region(r) => region_requirement(r, transaction, required)?,
+                }
+            }
+        }
+        TyTerm::Function(f) => {
+            required.insert(UnificationRequirement::FunctionBinderMatching);
+            for t in &f.value.parameters {
+                requirements_for(t, transaction, required, depth + 1, limit)?;
+            }
+            requirements_for(&f.value.result, transaction, required, depth + 1, limit)?;
+        }
+        TyTerm::Dyn(_) => {
+            required.insert(UnificationRequirement::DynOrOpaqueSchema);
+        }
+        TyTerm::Opaque(_, args) => {
+            required.insert(UnificationRequirement::DynOrOpaqueSchema);
+            for a in args {
+                match a {
+                    GenericArg::Type(t) => {
+                        requirements_for(t, transaction, required, depth + 1, limit)?
+                    }
+                    GenericArg::Const(c) => const_requirement(c, transaction, required)?,
+                    GenericArg::Region(r) => region_requirement(r, transaction, required)?,
+                }
+            }
+        }
+        TyTerm::Bound { .. } => {
+            required.insert(UnificationRequirement::BoundUniverseMatching);
+        }
+        TyTerm::Tuple(v) => {
+            for t in v {
+                requirements_for(t, transaction, required, depth + 1, limit)?;
+            }
+        }
+        TyTerm::Nominal(_, args) => {
+            for a in args {
+                match a {
+                    GenericArg::Type(t) => {
+                        requirements_for(t, transaction, required, depth + 1, limit)?
+                    }
+                    GenericArg::Const(c) => const_requirement(c, transaction, required)?,
+                    GenericArg::Region(r) => region_requirement(r, transaction, required)?,
+                }
+            }
+        }
+        TyTerm::Array(t, c) => {
+            requirements_for(t, transaction, required, depth + 1, limit)?;
+            const_requirement(c, transaction, required)?;
+        }
+        TyTerm::Ref(r, _, t) => {
+            requirements_for(t, transaction, required, depth + 1, limit)?;
+            region_requirement(r, transaction, required)?;
+        }
+        TyTerm::Slice(t) => requirements_for(t, transaction, required, depth + 1, limit)?,
+        _ => {}
+    }
+    Ok(())
+}
+fn const_requirement(
+    c: &ConstTerm,
+    transaction: Digest,
+    r: &mut std::collections::BTreeSet<UnificationRequirement>,
+) -> Result<(), Diagnostic> {
+    match c {
+        ConstTerm::Placeholder(p) if p.transaction != transaction => {
+            return Err(invalid("foreign const placeholder"));
+        }
+        ConstTerm::Bound { .. } => {
+            r.insert(UnificationRequirement::BoundUniverseMatching);
+        }
+        _ => {}
+    }
+    Ok(())
+}
+fn region_requirement(
+    c: &RegionTerm,
+    transaction: Digest,
+    r: &mut std::collections::BTreeSet<UnificationRequirement>,
+) -> Result<(), Diagnostic> {
+    match c {
+        RegionTerm::Placeholder(p) if p.transaction != transaction => {
+            return Err(invalid("foreign region placeholder"));
+        }
+        RegionTerm::Bound { .. } => {
+            r.insert(UnificationRequirement::BoundUniverseMatching);
+        }
+        _ => {}
+    }
+    Ok(())
+}
+fn collect_pair_requirements(
+    a: &TyTerm,
+    b: &TyTerm,
+    r: &mut std::collections::BTreeSet<UnificationRequirement>,
+    depth: usize,
+    limit: usize,
+) {
+    if depth >= limit {
+        return;
+    }
+    match (a, b) {
+        (TyTerm::Array(x, c), TyTerm::Array(y, d)) => {
+            if c != d && (!matches!(c, ConstTerm::Value(_)) || !matches!(d, ConstTerm::Value(_))) {
+                r.insert(UnificationRequirement::ConstEquality);
+            }
+            collect_pair_requirements(x, y, r, depth + 1, limit);
+        }
+        (TyTerm::Ref(c, _, x), TyTerm::Ref(d, _, y)) => {
+            if c != d
+                && (matches!(c, RegionTerm::Param(_) | RegionTerm::Local { .. })
+                    || matches!(d, RegionTerm::Param(_) | RegionTerm::Local { .. }))
+            {
+                r.insert(UnificationRequirement::RegionEquality);
+            }
+            collect_pair_requirements(x, y, r, depth + 1, limit);
+        }
+        (TyTerm::Tuple(x), TyTerm::Tuple(y)) => {
+            for (x, y) in x.iter().zip(y) {
+                collect_pair_requirements(x, y, r, depth + 1, limit);
+            }
+        }
+        (TyTerm::Slice(x), TyTerm::Slice(y)) => {
+            collect_pair_requirements(x, y, r, depth + 1, limit)
+        }
+        (TyTerm::Nominal(_, x), TyTerm::Nominal(_, y)) => {
+            for (x, y) in x.iter().zip(y) {
+                match (x, y) {
+                    (GenericArg::Type(x), GenericArg::Type(y)) => {
+                        collect_pair_requirements(x, y, r, depth + 1, limit)
+                    }
+                    (GenericArg::Const(x), GenericArg::Const(y))
+                        if x != y
+                            && (!matches!(x, ConstTerm::Value(_))
+                                || !matches!(y, ConstTerm::Value(_))) =>
+                    {
+                        r.insert(UnificationRequirement::ConstEquality);
+                    }
+                    (GenericArg::Region(x), GenericArg::Region(y)) if x != y => {
+                        r.insert(UnificationRequirement::RegionEquality);
+                    }
+                    _ => {}
+                }
+            }
+        }
+        _ => {}
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CandidateDispositionModel {
+    StructuralMatchPending,
+    Unresolved,
+    StructuralConflict,
+}
+#[derive(Debug)]
+pub enum CandidateSetModel {
+    NoStructuralMatch(Vec<Digest>),
+    Unresolved(Vec<Digest>),
+    Ambiguous(Vec<Digest>),
+}
+/// Potential-candidate aggregation only. Never Unique/NoSolution or a witness;
+/// conditions, source goal readiness and tables remain unfulfilled.
+pub fn combine_candidate_models(
+    mut reports: Vec<(Digest, CandidateDispositionModel)>,
+) -> Result<CandidateSetModel, Diagnostic> {
+    if reports.len() > 50_000 {
+        return Err(invalid("candidate model count limit"));
+    }
+    reports.sort_by_key(|r| r.0);
+    if reports.windows(2).any(|p| p[0].0 == p[1].0) {
+        return Err(invalid(
+            "duplicate candidate identity is not a second witness",
+        ));
+    }
+    let mut possible = Vec::new();
+    possible
+        .try_reserve_exact(reports.len())
+        .map_err(|_| invalid("candidate metadata allocation"))?;
+    let mut rejected = Vec::new();
+    rejected
+        .try_reserve_exact(reports.len())
+        .map_err(|_| invalid("candidate metadata allocation"))?;
+    for (key, state) in reports {
+        if state == CandidateDispositionModel::StructuralConflict {
+            rejected.push(key);
+        } else {
+            possible.push(key);
+        }
+    }
+    Ok(if possible.len() > 1 {
+        CandidateSetModel::Ambiguous(possible)
+    } else if possible.is_empty() {
+        CandidateSetModel::NoStructuralMatch(rejected)
+    } else {
+        CandidateSetModel::Unresolved(possible)
+    })
+}
+
+fn definitely_different_outer(a: &TyTerm, b: &TyTerm) -> bool {
+    match (a, b) {
+        (TyTerm::Primitive(a), TyTerm::Primitive(b)) => a != b,
+        (TyTerm::Param(a), TyTerm::Param(b)) => a != b,
+        (TyTerm::Nominal(a, _), TyTerm::Nominal(b, _)) => a != b,
+        (TyTerm::Tuple(a), TyTerm::Tuple(b)) => a.len() != b.len(),
+        (TyTerm::Array(_, ConstTerm::Value(a)), TyTerm::Array(_, ConstTerm::Value(b))) => a != b,
+        (TyTerm::Ref(_, a, _), TyTerm::Ref(_, b, _)) => a != b,
+        _ => false,
+    }
+}
diff --git a/crates/lrr/src/traits/canonical.rs b/crates/lrr/src/traits/canonical.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/traits/canonical.rs
@@ -0,0 +1,708 @@
+//! Bounded canonical data, not a source goal certificate or executable witness.
+use super::term::*;
+use crate::core::{
+    diagnostic::Diagnostic,
+    digest::{Digest, StableEncode, StableEncoder},
+    profile::ProfileIdentity,
+};
+use std::collections::{BTreeMap, BTreeSet};
+#[derive(Clone, Debug)]
+pub enum GoalModel {
+    Implemented(TraitRef),
+    Normalize(ProjectionKey, TyTerm),
+    ConstEqual(ConstTerm, ConstTerm),
+    TypeEqual(TyTerm, TyTerm),
+    Outlives(RegionTerm, RegionTerm),
+    TypeOutlives(TyTerm, RegionTerm),
+    DynCompatible(DynSchemaKey),
+}
+/// Explicit metadata fixture context. This is neither an M018 source view nor
+/// live/world permission. The actual admitted producer remains a prerequisite.
+#[derive(Clone, Debug)]
+pub struct CanonicalContextModel {
+    pub transaction: Digest,
+    pub profile: ProfileIdentity,
+    pub unit: Digest,
+    pub world: Digest,
+    pub catalog: Digest,
+    pub cfg: Digest,
+    pub source_namespace: Digest,
+    pub epoch: u64,
+    pub source_revision: u64,
+    pub query_revision: u64,
+    pub max_universe: u32,
+    pub excluded_dictionary_slots: Vec<Digest>,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct CanonicalLimits {
+    pub bytes: usize,
+    pub work: usize,
+    pub depth: usize,
+    pub variables: usize,
+}
+impl Default for CanonicalLimits {
+    fn default() -> Self {
+        Self {
+            bytes: 1024 * 1024,
+            work: 1_000_000,
+            depth: 256,
+            variables: 50_000,
+        }
+    }
+}
+impl CanonicalLimits {
+    pub(crate) fn validate(self) -> Result<Self, CanonicalError> {
+        let hard = Self::default();
+        if self.bytes > hard.bytes
+            || self.work > hard.work
+            || self.depth > hard.depth
+            || self.variables > hard.variables
+        {
+            return Err(CanonicalError::Invalid(
+                "canonical limit exceeds fixed ceiling",
+            ));
+        }
+        Ok(self)
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CanonicalLimit {
+    Bytes,
+    Work,
+    Depth,
+    Variables,
+}
+#[derive(Debug)]
+pub enum CanonicalError {
+    Overflow(CanonicalLimit),
+    Invalid(&'static str),
+    SourceTerm(Diagnostic),
+}
+impl std::fmt::Display for CanonicalError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Overflow(l) => write!(f, "canonical metadata overflow: {l:?}"),
+            Self::Invalid(s) => f.write_str(s),
+            Self::SourceTerm(d) => f.write_str(&d.message),
+        }
+    }
+}
+impl std::error::Error for CanonicalError {}
+/// Back-mapping is demand-local data only; original inference spelling/nonce
+/// is omitted from the canonical identity but remains available for a later
+/// ordered answer-instantiation producer.
+#[derive(Clone, Debug)]
+pub struct CanonicalVariableModel {
+    pub original: InferVarKey,
+    pub universe: u32,
+}
+#[derive(Debug)]
+pub struct CanonicalGoalModel {
+    bytes: Vec<u8>,
+    variables: Vec<CanonicalVariableModel>,
+    identity: Digest,
+    metadata_bytes: usize,
+}
+impl CanonicalGoalModel {
+    pub fn capture(
+        context: &CanonicalContextModel,
+        goal: &Binder<GoalModel>,
+        env: &ParamEnv,
+        universes: &BTreeMap<InferVarKey, u32>,
+        limits: CanonicalLimits,
+    ) -> Result<Self, CanonicalError> {
+        let limits = limits.validate()?;
+        context
+            .profile
+            .validate_source()
+            .map_err(CanonicalError::SourceTerm)?;
+        if context.epoch == 0
+            || context.max_universe > 256
+            || context.excluded_dictionary_slots.len() > limits.variables
+            || universes.len() > limits.variables
+        {
+            return Err(CanonicalError::Invalid(
+                "canonical context epoch/universe/count invalid",
+            ));
+        }
+        if universes
+            .iter()
+            .any(|(key, u)| key.transaction != context.transaction || *u > context.max_universe)
+        {
+            return Err(CanonicalError::Invalid(
+                "foreign or invisible inference universe",
+            ));
+        }
+        let auxiliary = env
+            .parameters()
+            .len()
+            .checked_mul(128)
+            .and_then(|n| {
+                n.checked_add(
+                    env.predicates()
+                        .len()
+                        .checked_mul(std::mem::size_of::<&Binder<TraitRef>>())?,
+                )
+            })
+            .and_then(|n| {
+                n.checked_add(
+                    context
+                        .excluded_dictionary_slots
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<Digest>())?,
+                )
+            })
+            .and_then(|n| n.checked_add(256usize.checked_mul(std::mem::size_of::<&[BoundKind]>())?))
+            .filter(|n| *n <= limits.bytes)
+            .ok_or(CanonicalError::Overflow(CanonicalLimit::Bytes))?;
+        let declared = env.parameters().iter().copied().collect::<BTreeSet<_>>();
+        let mut writer = Writer {
+            bytes: Vec::new(),
+            limits,
+            steps: 0,
+            context,
+            universes,
+            inference: BTreeMap::new(),
+            variables: Vec::new(),
+            placeholders: BTreeMap::new(),
+            scopes: Vec::new(),
+            declared,
+            auxiliary_bytes: 0,
+        };
+        writer.account(auxiliary)?;
+        writer.u32(1)?;
+        writer.string(crate::core::profile::GUEST_TARGET)?;
+        writer.u16(context.profile.edition)?;
+        writer.string(&context.profile.semantics)?;
+        for digest in [
+            context.unit,
+            context.world,
+            context.catalog,
+            context.cfg,
+            context.source_namespace,
+        ] {
+            writer.digest(digest)?;
+        }
+        writer.u64(context.epoch)?;
+        writer.u64(context.source_revision)?;
+        writer.u64(context.query_revision)?;
+        writer.u32(context.max_universe)?;
+        let mut exclusions = context.excluded_dictionary_slots.clone();
+        exclusions.sort_unstable();
+        if exclusions.windows(2).any(|p| p[0] == p[1]) {
+            return Err(CanonicalError::Invalid(
+                "duplicate in-progress dictionary exclusion",
+            ));
+        }
+        writer.count(exclusions.len())?;
+        for e in exclusions {
+            writer.digest(e)?;
+        }
+        writer.push(&goal.variables)?;
+        writer.goal(&goal.value, 0)?;
+        writer.scopes.pop();
+        writer.digest(env.definition())?;
+        let mut parameters = env.parameters().iter().collect::<Vec<_>>();
+        parameters.sort_unstable();
+        writer.count(parameters.len())?;
+        for (kind, key) in parameters {
+            writer.u8(kind.tag() as u8)?;
+            writer.param(*key, *kind)?;
+        }
+        // Definition assumptions cannot contain Infer/transaction placeholders (the
+        // existing ParamEnv constructor enforces this). Sort source facts before
+        // canonical traversal, independently of demand-variable allocation order.
+        let mut facts = env.predicates().iter().collect::<Vec<_>>();
+        facts.sort_by_key(|p| p.fingerprint());
+        writer.count(facts.len())?;
+        for p in facts {
+            writer.push(&p.variables)?;
+            writer.trait_ref(&p.value, 0)?;
+            writer.scopes.pop();
+        }
+        writer.count(writer.variables.len())?;
+        for ordinal in 0..writer.variables.len() {
+            writer.u8(BoundKind::Type.tag() as u8)?;
+            writer.u32(writer.variables[ordinal].universe)?;
+        }
+        let metadata_bytes = writer
+            .bytes
+            .capacity()
+            .checked_add(
+                writer
+                    .variables
+                    .capacity()
+                    .checked_mul(std::mem::size_of::<CanonicalVariableModel>())
+                    .ok_or(CanonicalError::Overflow(CanonicalLimit::Bytes))?,
+            )
+            .and_then(|n| n.checked_add(std::mem::size_of::<Self>()))
+            .filter(|n| *n <= limits.bytes)
+            .ok_or(CanonicalError::Overflow(CanonicalLimit::Bytes))?;
+        let mut e = StableEncoder::new("lrr/v5/canonical-goal-model/v1");
+        e.bytes(&writer.bytes);
+        let identity = e.finish();
+        Ok(Self {
+            bytes: writer.bytes,
+            variables: writer.variables,
+            identity,
+            metadata_bytes,
+        })
+    }
+    pub fn encoded(&self) -> &[u8] {
+        &self.bytes
+    }
+    pub fn variables(&self) -> &[CanonicalVariableModel] {
+        &self.variables
+    }
+    pub fn metadata_bytes(&self) -> usize {
+        self.metadata_bytes
+    }
+}
+impl StableEncode for CanonicalGoalModel {
+    const DOMAIN: &'static str = "lrr/v5/canonical-goal-model/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.bytes(&self.bytes);
+    }
+    fn fingerprint(&self) -> Digest {
+        self.identity
+    }
+}
+struct Writer<'a> {
+    bytes: Vec<u8>,
+    limits: CanonicalLimits,
+    steps: usize,
+    context: &'a CanonicalContextModel,
+    universes: &'a BTreeMap<InferVarKey, u32>,
+    inference: BTreeMap<InferVarKey, u32>,
+    variables: Vec<CanonicalVariableModel>,
+    placeholders: BTreeMap<(BoundKind, PlaceholderKey), u32>,
+    scopes: Vec<&'a [BoundKind]>,
+    declared: BTreeSet<(BoundKind, ParamKey)>,
+    auxiliary_bytes: usize,
+}
+impl<'a> Writer<'a> {
+    fn step(&mut self, depth: usize) -> Result<(), CanonicalError> {
+        self.steps = self
+            .steps
+            .checked_add(1)
+            .filter(|n| *n <= self.limits.work)
+            .ok_or(CanonicalError::Overflow(CanonicalLimit::Work))?;
+        if depth >= self.limits.depth {
+            return Err(CanonicalError::Overflow(CanonicalLimit::Depth));
+        }
+        Ok(())
+    }
+    fn account(&mut self, bytes: usize) -> Result<(), CanonicalError> {
+        self.auxiliary_bytes = self
+            .auxiliary_bytes
+            .checked_add(bytes)
+            .filter(|n| *n <= self.limits.bytes)
+            .ok_or(CanonicalError::Overflow(CanonicalLimit::Bytes))?;
+        Ok(())
+    }
+    fn append(&mut self, v: &[u8]) -> Result<(), CanonicalError> {
+        self.bytes
+            .len()
+            .checked_add(v.len())
+            .and_then(|n| n.checked_add(self.auxiliary_bytes))
+            .filter(|n| *n <= self.limits.bytes)
+            .ok_or(CanonicalError::Overflow(CanonicalLimit::Bytes))?;
+        self.bytes
+            .try_reserve_exact(v.len())
+            .map_err(|_| CanonicalError::Overflow(CanonicalLimit::Bytes))?;
+        self.bytes.extend_from_slice(v);
+        Ok(())
+    }
+    fn u8(&mut self, n: u8) -> Result<(), CanonicalError> {
+        self.append(&[n])
+    }
+    fn u16(&mut self, n: u16) -> Result<(), CanonicalError> {
+        self.append(&n.to_le_bytes())
+    }
+    fn u32(&mut self, n: u32) -> Result<(), CanonicalError> {
+        self.append(&n.to_le_bytes())
+    }
+    fn u64(&mut self, n: u64) -> Result<(), CanonicalError> {
+        self.append(&n.to_le_bytes())
+    }
+    fn count(&mut self, n: usize) -> Result<(), CanonicalError> {
+        self.u64(u64::try_from(n).map_err(|_| CanonicalError::Overflow(CanonicalLimit::Bytes))?)
+    }
+    fn string(&mut self, s: &str) -> Result<(), CanonicalError> {
+        self.count(s.len())?;
+        self.append(s.as_bytes())
+    }
+    fn digest(&mut self, d: Digest) -> Result<(), CanonicalError> {
+        self.append(&d.0)
+    }
+    fn push(&mut self, variables: &'a [BoundKind]) -> Result<(), CanonicalError> {
+        if self.scopes.len() >= self.limits.depth || variables.len() > self.limits.variables {
+            return Err(CanonicalError::Overflow(CanonicalLimit::Depth));
+        }
+        self.count(variables.len())?;
+        for k in variables {
+            self.u8(k.tag() as u8)?;
+        }
+        self.scopes
+            .try_reserve_exact(1)
+            .map_err(|_| CanonicalError::Overflow(CanonicalLimit::Bytes))?;
+        self.scopes.push(variables);
+        Ok(())
+    }
+    fn bound(&mut self, kind: BoundKind, depth: u32, index: u32) -> Result<(), CanonicalError> {
+        let scope = self
+            .scopes
+            .len()
+            .checked_sub(
+                usize::try_from(depth)
+                    .map_err(|_| CanonicalError::Invalid("binder depth overflow"))?
+                    .checked_add(1)
+                    .ok_or(CanonicalError::Invalid("binder depth overflow"))?,
+            )
+            .and_then(|d| self.scopes.get(d))
+            .ok_or(CanonicalError::Invalid(
+                "bound variable escapes goal binder",
+            ))?;
+        if scope.get(index as usize) != Some(&kind) {
+            return Err(CanonicalError::Invalid(
+                "bound variable namespace/ordinal differs",
+            ));
+        }
+        self.u32(depth)?;
+        self.u32(index)
+    }
+    fn param(&mut self, p: ParamKey, kind: BoundKind) -> Result<(), CanonicalError> {
+        if !self.declared.contains(&(kind, p)) {
+            return Err(CanonicalError::Invalid(
+                "rigid source parameter is outside owning environment",
+            ));
+        }
+        self.digest(p.definition)?;
+        self.u32(p.ordinal)
+    }
+    fn placeholder(&mut self, p: PlaceholderKey, kind: BoundKind) -> Result<(), CanonicalError> {
+        if p.transaction != self.context.transaction
+            || p.universe == 0
+            || p.universe > self.context.max_universe
+        {
+            return Err(CanonicalError::Invalid(
+                "foreign/invisible universal placeholder",
+            ));
+        }
+        let ordinal = if let Some(n) = self.placeholders.get(&(kind, p)) {
+            *n
+        } else {
+            if self.placeholders.len() >= self.limits.variables {
+                return Err(CanonicalError::Overflow(CanonicalLimit::Variables));
+            }
+            self.account(128)?;
+            let n = u32::try_from(self.placeholders.len())
+                .map_err(|_| CanonicalError::Overflow(CanonicalLimit::Variables))?;
+            self.placeholders.insert((kind, p), n);
+            n
+        };
+        self.u8(kind.tag() as u8)?;
+        self.u32(p.universe)?;
+        self.u32(ordinal)
+    }
+    fn region(&mut self, r: &RegionTerm) -> Result<(), CanonicalError> {
+        self.step(0)?;
+        match r {
+            RegionTerm::Placeholder(p) => {
+                self.u8(0)?;
+                self.placeholder(*p, BoundKind::Region)
+            }
+            RegionTerm::Static => self.u8(1),
+            RegionTerm::Param(p) => {
+                self.u8(2)?;
+                self.param(*p, BoundKind::Region)
+            }
+            RegionTerm::Bound { depth, index } => {
+                self.u8(3)?;
+                self.bound(BoundKind::Region, *depth, *index)
+            }
+            RegionTerm::Local {
+                definition,
+                start,
+                end,
+            } => {
+                if start > end {
+                    return Err(CanonicalError::Invalid("local region source range invalid"));
+                }
+                self.u8(4)?;
+                self.digest(*definition)?;
+                self.u32(*start)?;
+                self.u32(*end)
+            }
+        }
+    }
+    fn constant(&mut self, c: &ConstTerm) -> Result<(), CanonicalError> {
+        self.step(0)?;
+        match c {
+            ConstTerm::Placeholder(p) => {
+                self.u8(0)?;
+                self.placeholder(*p, BoundKind::Const)
+            }
+            ConstTerm::Bound { depth, index } => {
+                self.u8(1)?;
+                self.bound(BoundKind::Const, *depth, *index)
+            }
+            ConstTerm::Value(v) => {
+                self.u8(2)?;
+                self.u64(*v)
+            }
+            ConstTerm::Param(p) => {
+                self.u8(3)?;
+                self.param(*p, BoundKind::Const)
+            }
+        }
+    }
+    fn args(&mut self, args: &'a [GenericArg], depth: usize) -> Result<(), CanonicalError> {
+        self.count(args.len())?;
+        for a in args {
+            self.step(depth)?;
+            match a {
+                GenericArg::Type(t) => {
+                    self.u8(0)?;
+                    self.ty(t, depth + 1)?;
+                }
+                GenericArg::Const(c) => {
+                    self.u8(1)?;
+                    self.constant(c)?;
+                }
+                GenericArg::Region(r) => {
+                    self.u8(2)?;
+                    self.region(r)?;
+                }
+            }
+        }
+        Ok(())
+    }
+    fn trait_ref(&mut self, t: &'a TraitRef, depth: usize) -> Result<(), CanonicalError> {
+        self.digest(t.trait_key)?;
+        self.ty(&t.self_ty, depth + 1)?;
+        self.args(&t.args, depth + 1)
+    }
+    fn projection(&mut self, p: &'a ProjectionKey, depth: usize) -> Result<(), CanonicalError> {
+        self.trait_ref(&p.trait_ref, depth + 1)?;
+        self.digest(p.item)?;
+        self.args(&p.item_args, depth + 1)
+    }
+    fn ty(&mut self, t: &'a TyTerm, depth: usize) -> Result<(), CanonicalError> {
+        self.step(depth)?;
+        match t {
+            TyTerm::Dyn(d) => {
+                self.u8(0)?;
+                self.digest(d.0)
+            }
+            TyTerm::Opaque(k, args) => {
+                k.validate_arguments(args)
+                    .map_err(CanonicalError::SourceTerm)?;
+                self.u8(1)?;
+                self.digest(k.definition())?;
+                self.u32(k.return_position())?;
+                self.count(k.captures().len())?;
+                for (kind, p) in k.captures() {
+                    self.u8(kind.tag() as u8)?;
+                    self.digest(p.definition)?;
+                    self.u32(p.ordinal)?;
+                }
+                self.args(args, depth + 1)
+            }
+            TyTerm::Projection(p) => {
+                self.u8(2)?;
+                self.projection(p, depth + 1)
+            }
+            TyTerm::Placeholder(p) => {
+                self.u8(3)?;
+                self.placeholder(*p, BoundKind::Type)
+            }
+            TyTerm::Bound { depth, index } => {
+                self.u8(4)?;
+                self.bound(BoundKind::Type, *depth, *index)
+            }
+            TyTerm::Function(f) => {
+                self.u8(5)?;
+                self.push(&f.variables)?;
+                self.count(f.value.parameters.len())?;
+                for p in &f.value.parameters {
+                    self.ty(p, depth + 1)?;
+                }
+                self.ty(&f.value.result, depth + 1)?;
+                self.scopes.pop();
+                Ok(())
+            }
+            TyTerm::Primitive(p) => {
+                self.u8(6)?;
+                self.u32(p.tag())
+            }
+            TyTerm::Nominal(d, args) => {
+                self.u8(7)?;
+                self.digest(*d)?;
+                self.args(args, depth + 1)
+            }
+            TyTerm::Tuple(v) => {
+                self.u8(8)?;
+                self.count(v.len())?;
+                for t in v {
+                    self.ty(t, depth + 1)?;
+                }
+                Ok(())
+            }
+            TyTerm::Array(t, c) => {
+                self.u8(9)?;
+                self.ty(t, depth + 1)?;
+                self.constant(c)
+            }
+            TyTerm::Slice(t) => {
+                self.u8(10)?;
+                self.ty(t, depth + 1)
+            }
+            TyTerm::Ref(r, m, t) => {
+                self.u8(11)?;
+                self.region(r)?;
+                self.u8(u8::from(*m))?;
+                self.ty(t, depth + 1)
+            }
+            TyTerm::Param(p) => {
+                self.u8(12)?;
+                self.param(*p, BoundKind::Type)
+            }
+            TyTerm::Infer(v) => {
+                if v.transaction != self.context.transaction {
+                    return Err(CanonicalError::Invalid("foreign inference transaction"));
+                }
+                let universe = *self.universes.get(v).ok_or(CanonicalError::Invalid(
+                    "inference variable lacks owning universe",
+                ))?;
+                let ordinal = if let Some(n) = self.inference.get(v) {
+                    *n
+                } else {
+                    if self.variables.len() >= self.limits.variables {
+                        return Err(CanonicalError::Overflow(CanonicalLimit::Variables));
+                    }
+                    self.account(160)?;
+                    let n = u32::try_from(self.variables.len())
+                        .map_err(|_| CanonicalError::Overflow(CanonicalLimit::Variables))?;
+                    self.variables
+                        .try_reserve_exact(1)
+                        .map_err(|_| CanonicalError::Overflow(CanonicalLimit::Bytes))?;
+                    self.variables.push(CanonicalVariableModel {
+                        original: *v,
+                        universe,
+                    });
+                    self.inference.insert(*v, n);
+                    n
+                };
+                self.u8(13)?;
+                self.u32(ordinal)?;
+                self.u32(universe)
+            }
+            TyTerm::Never => self.u8(14),
+        }
+    }
+    fn goal(&mut self, g: &'a GoalModel, depth: usize) -> Result<(), CanonicalError> {
+        self.step(depth)?;
+        match g {
+            GoalModel::Implemented(t) => {
+                self.u8(0)?;
+                self.trait_ref(t, depth + 1)
+            }
+            GoalModel::Normalize(p, t) => {
+                self.u8(1)?;
+                self.projection(p, depth + 1)?;
+                self.ty(t, depth + 1)
+            }
+            GoalModel::ConstEqual(a, b) => {
+                self.u8(2)?;
+                self.constant(a)?;
+                self.constant(b)
+            }
+            GoalModel::TypeEqual(a, b) => {
+                self.u8(3)?;
+                self.ty(a, depth + 1)?;
+                self.ty(b, depth + 1)
+            }
+            GoalModel::Outlives(a, b) => {
+                self.u8(4)?;
+                self.region(a)?;
+                self.region(b)
+            }
+            GoalModel::TypeOutlives(t, r) => {
+                self.u8(5)?;
+                self.ty(t, depth + 1)?;
+                self.region(r)
+            }
+            GoalModel::DynCompatible(d) => {
+                self.u8(6)?;
+                self.digest(d.0)
+            }
+        }
+    }
+}
+
+/// Agreement data from the actual M019 adapter, not a CanonicalGoalKey or M018
+/// completion. Its producer is the narrowly proposed read-only index bridge.
+pub(super) struct CatalogHeaderRequirement {
+    pub catalog: crate::db::seals::SealKey,
+    pub catalog_identity: Digest,
+    pub header: Digest,
+    pub definition: Digest,
+    pub profile: ProfileIdentity,
+    pub cfg: Digest,
+    pub source_revision: u64,
+    pub query_revision: u64,
+}
+impl StableEncode for CatalogHeaderRequirement {
+    const DOMAIN: &'static str = "lrr/v5/canonical-header-prerequisite/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.catalog);
+        e.digest(self.catalog_identity);
+        e.digest(self.header);
+        e.digest(self.definition);
+        e.record(&self.profile);
+        e.digest(self.cfg);
+        e.u64(self.source_revision);
+        e.u64(self.query_revision);
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum GoalAdmissionPrerequisite {
+    M018SourceView,
+    M019ResolvedPredicates,
+    NormalizationGoalProducer,
+}
+pub struct CurrentGoalPrerequisite {
+    stamp: CatalogHeaderRequirement,
+}
+impl CurrentGoalPrerequisite {
+    pub fn capture_header_current(
+        db: &crate::db::memo::Database,
+        index: &super::index::CurrentImplCandidateIndex,
+        header: Digest,
+    ) -> Result<Self, Diagnostic> {
+        let stamp = index.canonical_header_requirement_current(db, header)?;
+        Ok(Self { stamp })
+    }
+    pub fn revalidate(
+        &self,
+        db: &crate::db::memo::Database,
+        index: &super::index::CurrentImplCandidateIndex,
+    ) -> Result<(), Diagnostic> {
+        let current = index.canonical_header_requirement_current(db, self.stamp.header)?;
+        if current.fingerprint() != self.stamp.fingerprint() {
+            return Err(Diagnostic::new(
+                "LRR-E-TRAIT-GOAL-CONTEXT",
+                "canonical source/catalog prerequisite changed".into(),
+            ));
+        }
+        Ok(())
+    }
+    pub fn requirements(&self) -> &[GoalAdmissionPrerequisite] {
+        &[
+            GoalAdmissionPrerequisite::M018SourceView,
+            GoalAdmissionPrerequisite::M019ResolvedPredicates,
+            GoalAdmissionPrerequisite::NormalizationGoalProducer,
+        ]
+    }
+}
