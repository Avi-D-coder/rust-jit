+    // Primitive terms are disclosed closed-language model adapters; the source
+    // Type namespace join is pending and no Rust member is selected by them.
+    let env = ParamEnv::new(Digest([70; 32]), vec![], vec![]).unwrap();
+    let cx = context(1);
+    let goal = |arg| {
+        GoalModel::Implemented(TraitRef {
