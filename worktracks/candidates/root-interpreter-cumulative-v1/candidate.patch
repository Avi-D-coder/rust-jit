+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn key() -> crate::core::digest::Digest {
+        crate::core::digest::Digest::of_bytes(b"LRR physical-only byte chunk site")
+    }
+    fn live<T>(store: &GuestStore, arena: &GuestArena<T>) -> usize {
+        (1..=store.budget.handles())
+            .filter(|index| {
+                arena
+                    .get(Handle::<T>::from_bits(
+                        (u64::from(store.budget.epoch()) << 32) | u64::from(*index),
+                    ))
+                    .is_ok()
+            })
+            .count()
+    }
+    fn drain(
+        store: &mut GuestStore,
+        a: &mut StaticByteChunkActivation,
+        fuel: &mut RunFuel,
+    ) -> Result<usize, Diagnostic> {
+        let mut dispatches = 0;
+        loop {
+            match store.advance_static_byte_chunks(a, fuel) {
+                StaticByteChunkPoll::Dispatch { steps, bytes, .. } => {
+                    assert!(steps > 0 && steps <= 256);
+                    assert!(bytes <= 64 << 10);
+                    dispatches += 1;
+                }
+                StaticByteChunkPoll::Ready => return Ok(dispatches),
+                StaticByteChunkPoll::Failed(error) => return Err(error),
+            }
+        }
+    }
+    #[test]
+    fn flat_400000_byte_physical_cursor_seals_only_when_complete_and_reuses_root_with_fresh_ticket()
+    {
+        // Size/payload of unchanged slowparse-bstring.rs; this is physical data
+        // coverage only, not execution of the original source or a source proof.
+        let bytes = vec![b'x'; 400_000];
+        let mut store = GuestStore::new(1, 500_000, 256 << 20).unwrap();
+        let plan = store
+            .prepare_static_bytes(key(), &bytes, ByteLiteralTarget::Array, None, false)
+            .unwrap();
+        let ty = plan.reference_type();
+        let mut a = store.prepare_static_byte_chunks(plan).unwrap();
+        assert_eq!(live(&store, &store.cells), 0);
+        assert_eq!(live(&store, &store.objects), 0);
+        assert!(store.static_literal_index.is_empty());
+        assert!(a.metadata_bytes() < 32 << 20);
+        assert_eq!(a.len(), bytes.len());
+        let mut fuel = RunFuel::new(800_001).unwrap();
+        assert!(drain(&mut store, &mut a, &mut fuel).unwrap() > 1);
+        assert_eq!(fuel.snapshot().used, 400_000);
+        assert_eq!(a.fields_charged(), 400_000);
+        assert!(store.static_literal_index.is_empty());
+        assert_eq!(live(&store, &store.references), 0);
+        assert_eq!(live(&store, &store.tickets), 0);
+        let first = store.commit_static_byte_chunks(&mut a).unwrap();
+        assert!(a.finished());
+        assert!(store.commit_static_byte_chunks(&mut a).is_err());
+        let value = store.peek_ticket(first).unwrap();
+        assert_eq!(value.type_id, ty.0);
+        let reference = store
+            .references
+            .get(RefId::from_bits(value.payload))
+            .unwrap();
+        store.validate_reference_record(reference).unwrap();
+        let root = reference.root.cell;
+        assert!(!store.cells.get(root).unwrap().writable);
+        let (_, fields) = store.place_object(root).unwrap();
+        assert_eq!(fields.fields.len(), 400_000);
+        for index in [0, 255, 256, 399_999] {
+            let field = fields.fields[index];
+            assert!(!store.cells.get(field).unwrap().writable);
+            assert_eq!(store.read_scalar(field).unwrap().payload, u64::from(b'x'));
+        }
+        let plan = store
+            .prepare_static_bytes(key(), &bytes, ByteLiteralTarget::Array, Some(ty), false)
+            .unwrap();
+        let mut cached = store.prepare_static_byte_chunks(plan).unwrap();
+        assert!(drain(&mut store, &mut cached, &mut fuel).unwrap() > 1);
+        assert_eq!(cached.fields_charged(), 400_000);
+        let second = store.commit_static_byte_chunks(&mut cached).unwrap();
+        assert_ne!(first, second);
+        assert_eq!(store.peek_ticket(second).unwrap(), value);
+        assert_eq!(live(&store, &store.static_literals), 1);
+        assert_eq!(live(&store, &store.objects), 1);
+        assert_eq!(live(&store, &store.references), 1);
+        store.discard(first).unwrap();
+        store.discard(second).unwrap();
+        store.reset(2).unwrap();
+        assert_eq!(live(&store, &store.cells), 0);
+        assert!(store.static_literal_index.is_empty());
+    }
