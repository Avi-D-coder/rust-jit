+//! Closed core PartialEq declarations for shared U8 arrays/slices and UTF-8 str.
+//! Source terms select members; runtime descriptors only check that selection.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncoder},
+        profile::ProfileIdentity,
+    },
+    ir::op::PrimitiveType,
+    traits::term::{ConstTerm, TyTerm},
+};
+use std::sync::Arc;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TYPE-CONTEXT", message.into())
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ByteShape {
+    Array(u32),
+    Slice,
+    Utf8,
+}
+impl ByteShape {
+    pub(crate) fn length(self) -> Option<u32> {
+        match self {
+            Self::Array(n) => Some(n),
+            Self::Slice | Self::Utf8 => None,
+        }
+    }
+}
+fn shape(source: &TyTerm) -> Option<ByteShape> {
+    let TyTerm::Ref(_, false, pointee) = source else {
+        return None;
+    };
+    match pointee.as_ref() {
+        TyTerm::Str => Some(ByteShape::Utf8),
+        TyTerm::Array(element, ConstTerm::Value(n))
+            if **element == TyTerm::Primitive(PrimitiveType::U8) =>
+        {
+            u32::try_from(*n).ok().map(ByteShape::Array)
+        }
+        TyTerm::Slice(element) if **element == TyTerm::Primitive(PrimitiveType::U8) => {
+            Some(ByteShape::Slice)
+        }
+        _ => None,
+    }
+}
+pub(crate) fn is_byte_reference(source: Option<&TyTerm>) -> bool {
+    source.and_then(shape).is_some()
+}
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+enum ComparisonFamily {
+    PartialEq,
+    StrPartialOrd,
+}
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct ByteEqualityMember {
+    family: ComparisonFamily,
+    profile: Arc<ProfileIdentity>,
+    identity: Digest,
+    left: TyTerm,
+    right: TyTerm,
+    left_shape: ByteShape,
+    right_shape: ByteShape,
+}
+impl ByteEqualityMember {
+    pub(crate) fn require_operator(
+        &self,
+        operator: crate::ir::op::NumericBinary,
+    ) -> Result<(), Diagnostic> {
+        use crate::ir::op::NumericBinary::*;
+        if matches!(
+            (self.family, operator),
+            (ComparisonFamily::PartialEq, Eq | Ne)
+                | (ComparisonFamily::StrPartialOrd, Lt | Le | Gt | Ge)
+        ) {
+            Ok(())
+        } else {
+            Err(fault("comparison trait member/operator differs"))
+        }
+    }
+    pub(crate) fn require(
+        &self,
+        profile: &ProfileIdentity,
+        left: &TyTerm,
+        right: &TyTerm,
+    ) -> Result<(), Diagnostic> {
+        if profile != self.profile.as_ref() || left != &self.left || right != &self.right {
+            return Err(fault("byte PartialEq source operands/profile changed"));
+        }
+        Ok(())
+    }
+    pub(crate) fn shapes(&self) -> (ByteShape, ByteShape) {
+        (self.left_shape, self.right_shape)
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>()
+            .checked_add(std::mem::size_of::<ProfileIdentity>())?
+            .checked_add(2 * std::mem::size_of::<usize>())?
+            .checked_add(self.profile.semantics.capacity())?
+            .checked_add(self.left.heap_bytes()?)?
+            .checked_add(self.right.heap_bytes()?)
+    }
+}
+#[derive(Debug, Clone)]
+pub(crate) struct ByteEqualityFacet {
+    profile: Arc<ProfileIdentity>,
+    identity: Digest,
+}
+impl ByteEqualityFacet {
+    pub(crate) fn for_profile(profile: &ProfileIdentity) -> Result<Self, Diagnostic> {
+        profile.validate_source()?;
+        let mut e = StableEncoder::new("lrr/v3/core-immutable-literal-comparison-facet");
+        e.record(profile);
+        e.digest(super::unit(profile, "core"));
+        // Shared-reference forwarding, primitive U8 equality and the four
+        // pinned array/slice implementation families, including equal-N arrays,
+        // plus core/src/str/traits.rs PartialEq for str over UTF-8 bytes.
+        for contract in [
+            "PartialEq::eq",
+            "&A:&B forwarding",
+            "u8:eq",
+            "[u8;N]:[u8;N]",
+            "[u8;N]:[u8]",
+            "[u8]:[u8;N]",
+            "[u8]:[u8]",
+            "str:str via core::str::traits PartialEq byte equality",
+            "str:str via core::str::traits PartialOrd byte lexicographic order",
+        ] {
+            e.string(contract);
+        }
+        Ok(Self {
+            profile: Arc::new(profile.clone()),
+            identity: e.finish(),
+        })
+    }
+    pub(crate) fn profile(&self) -> &ProfileIdentity {
+        &self.profile
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(std::mem::size_of::<ProfileIdentity>())
+            .and_then(|n| n.checked_add(2 * std::mem::size_of::<usize>()))
+            .and_then(|n| n.checked_add(self.profile.semantics.capacity()))
+            .ok_or_else(|| fault("byte PartialEq facet metadata overflow"))
+    }
+    pub(crate) fn select_string_ordering(
+        &self,
+        profile: &ProfileIdentity,
+        left: &TyTerm,
+        right: &TyTerm,
+    ) -> Result<ByteEqualityMember, Diagnostic> {
+        let mut member = self.select(profile, left, right)?;
+        if member.shapes() != (ByteShape::Utf8, ByteShape::Utf8) {
+            return Err(fault(
+                "this PartialOrd member requires two shared str source operands",
+            ));
+        }
+        member.family = ComparisonFamily::StrPartialOrd;
+        let mut e = StableEncoder::new("lrr/v1/core-str-partial-ord-instance");
+        e.digest(self.identity);
+        e.record(left);
+        e.record(right);
+        member.identity = e.finish();
+        Ok(member)
+    }
+    pub(crate) fn select(
+        &self,
+        profile: &ProfileIdentity,
+        left: &TyTerm,
+        right: &TyTerm,
+    ) -> Result<ByteEqualityMember, Diagnostic> {
+        if profile != self.profile.as_ref() {
+            return Err(fault("byte PartialEq compiler profile differs"));
+        }
+        let l = shape(left).ok_or_else(|| {
+            fault("literal PartialEq left source requires shared str or U8 array/slice")
+        })?;
+        let r = shape(right).ok_or_else(|| {
+            fault("literal PartialEq right source requires shared str or U8 array/slice")
+        })?;
+        // Shared physical bytes never create a cross-family PartialEq impl.
+        if (l == ByteShape::Utf8) != (r == ByteShape::Utf8) {
+            return Err(fault("str PartialEq requires two str source operands"));
+        }
+        if matches!((l, r), (ByteShape::Array(a), ByteShape::Array(b)) if a != b) {
+            return Err(fault("array PartialEq requires equal source const lengths"));
+        }
+        let mut e = StableEncoder::new("lrr/v2/core-immutable-literal-partial-eq-instance");
+        e.digest(self.identity);
+        e.record(left);
+        e.record(right);
+        Ok(ByteEqualityMember {
+            family: ComparisonFamily::PartialEq,
+            profile: self.profile.clone(),
+            identity: e.finish(),
+            left: left.clone(),
+            right: right.clone(),
+            left_shape: l,
+            right_shape: r,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        frontend::{
+            compile_input_catalog::CompileInputCatalog, runtime_macro_catalog::RuntimeMacroCatalog,
+        },
+        traits::term::{ParamKey, RegionTerm},
+    };
+    fn reference(shape: ByteShape) -> TyTerm {
+        let element = Box::new(TyTerm::Primitive(PrimitiveType::U8));
+        TyTerm::Ref(
+            RegionTerm::Static,
+            false,
+            Box::new(match shape {
+                ByteShape::Array(n) => TyTerm::Array(element, ConstTerm::Value(n.into())),
+                ByteShape::Slice => TyTerm::Slice(element),
+                ByteShape::Utf8 => TyTerm::Str,
+            }),
+        )
+    }
+    #[test]
+    fn source_str_partial_ord_member_cannot_be_substituted_for_eq_or_byte_storage() {
+        use crate::ir::op::NumericBinary;
+        for edition in [2015, 2018, 2021, 2024] {
+            let profile = ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            };
+            let actual = CompileInputCatalog::standalone(&profile)
+                .unwrap()
+                .runtime_catalog()
+                .unwrap()
+                .unwrap();
+            let macro_only = RuntimeMacroCatalog::standard(&profile).unwrap();
+            let text = reference(ByteShape::Utf8);
+            let eq = actual.byte_equality_member(&profile, &text, &text).unwrap();
+            for operator in [
+                NumericBinary::Lt,
+                NumericBinary::Le,
+                NumericBinary::Gt,
+                NumericBinary::Ge,
+            ] {
+                let ord = actual
+                    .byte_comparison_member(&profile, operator, &text, &text)
+                    .unwrap();
+                ord.require(&profile, &text, &text).unwrap();
+                ord.require_operator(operator).unwrap();
+                assert_ne!(ord.identity, eq.identity);
+                assert!(eq.require_operator(operator).is_err());
+                assert!(ord.require_operator(NumericBinary::Eq).is_err());
+                assert!(ord.require_operator(NumericBinary::Ne).is_err());
+                assert!(
+                    macro_only
+                        .byte_comparison_member(&profile, operator, &text, &text)
+                        .is_err()
+                );
+                for byte in [reference(ByteShape::Slice), reference(ByteShape::Array(4))] {
+                    assert!(
+                        actual
+                            .byte_comparison_member(&profile, operator, &byte, &byte)
+                            .is_err()
+                    );
+                    assert!(
+                        actual
+                            .byte_comparison_member(&profile, operator, &text, &byte)
+                            .is_err()
+                    );
+                    assert!(
+                        actual
+                            .byte_comparison_member(&profile, operator, &byte, &text)
+                            .is_err()
+                    );
+                }
+                let mutable = TyTerm::Ref(RegionTerm::Static, true, Box::new(TyTerm::Str));
+                assert!(
+                    actual
+                        .byte_comparison_member(&profile, operator, &mutable, &text)
+                        .is_err()
+                );
+                let other = ProfileIdentity {
+                    edition: if edition == 2024 { 2021 } else { 2024 },
+                    ..ProfileIdentity::current()
+                };
+                assert!(
+                    actual
+                        .byte_comparison_member(&other, operator, &text, &text)
+                        .is_err()
+                );
+            }
+            assert!(
+                actual
+                    .byte_comparison_member(&profile, NumericBinary::Add, &text, &text)
+                    .is_err()
+            );
+            eq.require_operator(NumericBinary::Eq).unwrap();
+            eq.require_operator(NumericBinary::Ne).unwrap();
+        }
+    }
+    #[test]
+    fn core_byte_equality_selects_source_impl_and_requires_actual_compiler_inventory() {
+        for edition in [2015, 2018, 2021, 2024] {
+            let profile = ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            };
+            let actual = CompileInputCatalog::standalone(&profile)
+                .unwrap()
+                .runtime_catalog()
+                .unwrap()
+                .unwrap();
+            let macro_only = RuntimeMacroCatalog::standard(&profile).unwrap();
+            for l in [
+                ByteShape::Array(0),
+                ByteShape::Array(600),
+                ByteShape::Slice,
+                ByteShape::Utf8,
+            ] {
+                for r in [
+                    ByteShape::Array(0),
+                    ByteShape::Array(600),
+                    ByteShape::Slice,
+                    ByteShape::Utf8,
+                ] {
+                    let left = reference(l);
+                    let right = reference(r);
+                    assert!(
+                        macro_only
+                            .byte_equality_member(&profile, &left, &right)
+                            .is_err()
+                    );
+                    let result = actual.byte_equality_member(&profile, &left, &right);
+                    if matches!((l,r), (ByteShape::Array(a),ByteShape::Array(b)) if a!=b)
+                        || (l == ByteShape::Utf8) != (r == ByteShape::Utf8)
+                    {
+                        assert!(result.is_err());
+                    } else {
+                        let selected = result.unwrap();
+                        selected.require(&profile, &left, &right).unwrap();
+                        assert_eq!(selected.shapes(), (l, r));
+                        assert!(selected.allocated_bytes().unwrap() < 4096);
+                    }
+                }
+            }
+            let array = reference(ByteShape::Array(600));
+            let rigid = TyTerm::Param(ParamKey {
+                definition: Digest([90; 32]),
+                ordinal: 0,
+            });
+            assert!(
+                actual
+                    .byte_equality_member(&profile, &rigid, &array)
+                    .is_err()
+            );
+            assert!(
+                actual
+                    .byte_equality_member(&profile, &array, &rigid)
+                    .is_err()
+            );
+            let mutable = TyTerm::Ref(
+                RegionTerm::Static,
+                true,
+                Box::new(TyTerm::Slice(Box::new(TyTerm::Primitive(
+                    PrimitiveType::U8,
+                )))),
+            );
+            assert!(
+                actual
+                    .byte_equality_member(&profile, &mutable, &array)
+                    .is_err()
+            );
+            let foreign = ProfileIdentity {
+                edition: if edition == 2015 { 2024 } else { 2015 },
+                ..profile.clone()
+            };
+            assert!(
+                actual
+                    .byte_equality_member(&foreign, &array, &array)
+                    .is_err()
+            );
+        }
+    }
+}
