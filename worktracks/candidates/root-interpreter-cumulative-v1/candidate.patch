+fn byte_context_is_opaque_owner_bound_and_rejects_real_type_shadowing_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (parsed, body, index, declarations) = entered(ORIGINAL, edition);
+        let (mut db, source, _source_lease) =
+            crate::frontend::byte_string_context::tests::world(ORIGINAL, edition);
+        let first = index
+            .pc(
+                id_for(&index, &body, declarations[0].syntax()).unwrap(),
+                Phase::Entry,
+            )
+            .unwrap();
+        let second = index
+            .pc(
+                id_for(&index, &body, declarations[1].syntax()).unwrap(),
+                Phase::Entry,
+            )
+            .unwrap();
+        let recipe = admitted_thunk(&mut db, &source, &parsed, &body, &index, &first).unwrap();
+        let HintRecipe::StaticByteReference(context) = recipe
+            .recipe()
+            .operations
+            .iter()
+            .find_map(|op| match op {
+                Op::SetHint { hint, .. } => Some(hint),
+                _ => None,
+            })
+            .unwrap()
+        else {
+            panic!("genuine static context absent")
+        };
+        let op = recipe
+            .recipe()
+            .operations
+            .iter()
+            .find(|op| matches!(op, Op::SetHint { .. }))
+            .unwrap();
+        assert!(context.require(&index, &second, op).is_err());
+        for text in [
+            "type u8=bool;fn main(){let bar:&'static [u8]=b\"a\";}",
+            "fn main(){type u8=bool;let bar:&'static [u8;1]=b\"a\";}",
+        ] {
+            let (parsed, body, index, declarations) = entered(text, edition);
+            let entry = index
