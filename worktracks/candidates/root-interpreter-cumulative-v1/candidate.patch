+#[test]
+fn original_length_receiver_source_and_fuel_refusals_precede_result_publication() {
+    const NULS: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/str/nul-char-equivalence.rs"
+    );
+    let (mut db, mut run, macros, _) = tests::start_source(NULS, 2024, 10_000);
+    let contexts = macros.contexts().unwrap();
+    let (id, source, _) = reach_string_method(&mut db, &mut run, &contexts, 45);
+    let used = run.frame.fuel_snapshot().used;
+    run.frame
+        .set_source_view(
+            source,
+            Some(TyTerm::Ref(RegionTerm::Static, true, Box::new(TyTerm::Str))),
+        )
+        .unwrap();
+    let before = effects(&run);
+    assert!(
+        run.revalidate_primitive_method(&mut db, &contexts, id)
+            .is_err()
+    );
+    assert!(
+        step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap()
+        )
+        .is_err()
+    );
+    assert_eq!(effects(&run), before);
+    db.finish_run().unwrap();
+
+    let (mut db, mut run, macros, _) = tests::start_source(NULS, 2024, used);
+    let contexts = macros.contexts().unwrap();
+    let (id, _, _) = reach_string_method(&mut db, &mut run, &contexts, 45);
+    assert_eq!(run.frame.fuel_snapshot().used, used);
+    let before = effects(&run);
+    assert_eq!(
+        step::step(
+            &mut run.frame,
+            &mut run.store,
+            run.installed.get(id).unwrap()
+        )
+        .unwrap_err()
+        .code,
+        "LRR-E-RUNTIME-RESOURCE"
+    );
+    assert_eq!(
+        run.frame.fuel_snapshot().stop,
+        Some(crate::vm::fuel::FuelStop::Exhausted)
+    );
+    assert_eq!(effects(&run), before);
+    assert_eq!(run.frame.counters().started_by_opcode[45], 0);
+    db.finish_run().unwrap();
+}
+#[test]
+fn unchanged_unicode_macro_string_operand_requires_current_source_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(ORIGINAL, edition, 1000);
+        let contexts = macros.contexts().unwrap();
+        let (id, literal, _destination) = reached(&mut db, &mut run, &contexts);
+        let Some(DecodedLiteral::String(payload)) = &literal.decoded else {
+            panic!("unchanged original UTF8 operand");
+        };
+        assert_eq!(payload.text(), "☃");
+        let before = effects(&run);
+        assert!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .is_err()
+        );
+        assert_eq!(effects(&run), before);
+        assert_eq!(run.frame.status(), crate::vm::frame::FrameStatus::Faulted);
+        db.finish_run().unwrap();
+        // A rejected VM step is terminal. Source-admission refusal and success
+        // below use another genuine execution of the unchanged source prefix.
+        let (mut db, mut run, macros, _) = tests::start_source(ORIGINAL, edition, 1000);
+        let contexts = macros.contexts().unwrap();
+        let (id, literal, destination) = reached(&mut db, &mut run, &contexts);
+        let before = effects(&run);
+        assert!(run.prepare_macro_byte_literal(&mut db, &[], id).is_err());
+        assert_eq!(effects(&run), before);
+        run.prepare_macro_byte_literal(&mut db, &contexts, id)
+            .unwrap();
+        assert_eq!(effects(&run), before);
+        run.frame
+            .require_macro_byte_literal(&literal, destination)
+            .unwrap();
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+        assert_eq!(
+            run.frame.source_view(destination).unwrap(),
+            Some(TyTerm::Ref(
+                RegionTerm::Static,
+                false,
+                Box::new(TyTerm::Str)
+            ))
+        );
+        let reference_type = run
+            .store
+            .find_type(&TypeKey::Ref {
+                mutable: false,
+                target: crate::runtime::shape::TypeId(16),
+            })
+            .unwrap();
+        let cell = run.frame.cell(destination).unwrap();
+        let reference = run.store.reference_from_cell(cell).unwrap();
+        let ticket = run.store.reference_ticket(reference).unwrap();
+        assert_eq!(
+            run.store.peek_ticket(ticket).unwrap().type_id,
+            reference_type.0
+        );
+        run.store.discard(ticket).unwrap();
+        assert_eq!(run.frame.counters().operations_started, before.0 + 1);
+        db.finish_run().unwrap();
+    }
+}
