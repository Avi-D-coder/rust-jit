+//! Whole unchanged original module-qualified range main. Auxiliary/native
+//! compilation is absent; current source/type prerequisites must fail normally.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::{
+        key::{OutlineKey, QueryKey},
+        memo::Database,
+        poll::QueryPoll,
+        provider::SyntaxProvider,
+        value::QueryValue,
+    },
+    engine::{
+        run::{RunMachine, RunPoll, ValueSummary},
+        standalone_macros::CompletedStandaloneRuntimeMacros,
+    },
+    expand::{
+        source_declarative,
+        source_discovery::{SourceDiscovery, SourceDiscoveryStep},
+    },
+    frontend::compile_input_catalog::CompileInputCatalog,
+    ir::{op::SOURCE_CONSTANT_OPCODE, pc::Phase},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput},
+        manifest::Namespace,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{
+        body_index::{ExpressionKind, NodeRole},
+        parse::ParseKey,
+    },
+};
+use std::sync::Arc;
+
+struct OriginalCase {
+    source: &'static str,
+    path: &'static str,
+    comparisons: u64,
+    phases: &'static [(bool, bool)],
+    cold_panics: usize,
+}
+
+#[test]
+fn unchanged_module_qualified_range_main_default_edition_2015() {
+    // Pinned compiletest default with no explicit harness override. An actual
+    // complete configured compiletest matrix is not supplied by this adapter.
+    run_original(
+        2015,
+        &OriginalCase {
+            source: include_str!(
+                "../../fixtures/upstream/rustc-checkout/tests/ui/parser/issues/issue-21475.rs"
+            ),
+            path: "tests/ui/parser/issues/issue-21475.rs",
+            comparisons: 6,
+            // 42 >=4 / <=14(false); >=0 / <=14(false); >=4 / <=59(true).
+            phases: &[(true, false), (true, false), (true, true)],
+            cold_panics: 0,
+        },
+    );
+}
+
+fn run_original(edition: u16, case: &OriginalCase) {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let owner = Digest::of_bytes(case.path.as_bytes());
+    let path = SourcePath::new(case.path).unwrap();
+    let cfg = CfgSet::guest_default();
+    let blob = SourceBlob::new(case.source.as_bytes().to_vec()).unwrap();
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: owner,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: owner,
+            module_path: vec![],
+            profile: profile.clone(),
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selection).unwrap() else {
+        panic!("edition {edition}: unchanged original source selection unavailable");
+    };
+    let body_for = |name: &str| {
+        view.outline()
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == name)
+            .unwrap_or_else(|| panic!("edition {edition}: original header {name} missing"))
+            .body
+            .as_ref()
+            .unwrap()
+            .key()
+    };
+    let main = body_for("main");
+    // Retain both actual module constants; do not replace the original's
+    // unsuffixed scrutinee or resolve endpoint source from its printed name.
+    let constants: Vec<_> = ["START", "END"]
+        .into_iter()
+        .map(|name| {
+            let item = view
+                .outline()
+                .items
+                .iter()
+                .find(|item| item.def_key.declared_name == name && item.scope.module_path == ["m"])
+                .expect("unchanged module constant header");
+            assert_eq!(item.scope.crate_key, owner);
+            assert_eq!(item.header.profile.edition, edition);
+            item.def_key.fingerprint()
+        })
+        .collect();
+
+    let mut db = Database::default();
+    db.trace.detailed = true;
+    inputs.publish(&mut db).unwrap();
+    // Publish the actual epoch before beginning a run; no active-run input or
+    // source replacement is used to make discovery appear complete.
+    db.begin_expansion_epoch(1).unwrap();
+    let mut discovery = SourceDiscovery::new(
+        vec![view.share()],
+        view.outline().root_scope.clone(),
+        Namespace::Value,
+        Digest::of_bytes(b"LRR unchanged stock scalar-range discovery world"),
+        1,
+    )
+    .unwrap()
+    .with_declarative_compiler(
+        Digest::of_bytes(b"LRR unchanged stock scalar-range declarative environment"),
+        source_declarative::engine_version(),
+        Arc::new(CompileInputCatalog::standalone(&profile).unwrap()),
+    )
+    .unwrap();
+    // Prepare the original through the real owning compiler/macro producer.
+    // No synthetic inert proof, completed gate, or procedural authority is used.
+    loop {
+        match discovery.poll().unwrap_or_else(|error| {
+            panic!("edition {edition}: unchanged original discovery fault: {error}")
+        }) {
+            SourceDiscoveryStep::Sealed(_) => break,
+            SourceDiscoveryStep::NeedExpansion { request } => {
+                let expansion = request.expand().unwrap_or_else(|error| {
+                    panic!("edition {edition}: original declarative expansion: {error}")
+                });
+                discovery.admit_expansion(Arc::new(expansion)).unwrap();
+            }
+            SourceDiscoveryStep::NeedGeneratedExpansion { request } => {
+                let expansion = request.expand().unwrap_or_else(|error| {
+                    panic!("edition {edition}: generated declarative expansion: {error}")
+                });
+                discovery.admit_expansion(Arc::new(expansion)).unwrap();
+            }
+            SourceDiscoveryStep::Incomplete {
+                diagnostic,
+                blocked,
+            } => panic!(
+                "edition {edition}: original discovery incomplete: {diagnostic}; blocked {blocked:?}"
+            ),
+            _ => panic!(
+                "edition {edition}: original discovery requires additional attribute/derive/procedural preparation"
+            ),
+        }
+    }
+    // Reached named bounds require both value and type lookup in their actual
+    // owning scope. Root and nested seals are distinct prerequisites. Prepare
+    // each namespace through discovery with the same source/cfg/profile/epoch;
+    // no initializer or body execution can supply a missing namespace receipt.
+    discovery.publish(&mut db).unwrap();
+    let mut owning_seals = Vec::new();
+    for scope in view
+        .outline()
+        .scopes
+        .keys()
+        .filter(|scope| scope.owner.is_none())
+    {
