+        counts[usize::from(SOURCE_CONSTANT_OPCODE)],
+        4,
+        "each reached named endpoint must instantiate an actual fresh constant use"
+    );
+    for definition in constants {
+        assert!(
+            db.trace.events.iter().any(|event| matches!(
+                &event.key, QueryKey::Constant(key) if key.definition() == definition
+            )),
+            "original selected module constant was never queried"
+        );
+    }
+    for (opcode, name) in [
+        (19, "CallSeal"),
+        (22, "CallPrepare"),
+        (23, "CallAdvance"),
+        (25, "Panic"),
+        (26, "Assert"),
+    ] {
+        assert_eq!(counts[opcode], 0, "edition {edition}: unexpected {name}");
+    }
+    assert_eq!(report.opcode_counters.backedges_completed, 0);
+    assert!(report.opcode_counters.operations_completed > case.comparisons);
