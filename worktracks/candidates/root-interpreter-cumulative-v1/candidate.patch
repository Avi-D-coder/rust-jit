+//! Owned stock string facts for storage/VM witnesses. Test-only parser boundary.
+use super::{
+    body_index::{BodyIndex, ExpressionKind, NodeRole},
+    parse::ParsedFile,
+};
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    ir::{pc::Phase, recipe::VerifiedRecipe},
+    source::snapshot::{CfgSet, SourceBlob},
+};
+use ra_ap_syntax::{AstNode, SyntaxKind, ast};
+fn parsed(source: &str, edition: u16) -> ParsedFile {
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(source.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    assert!(parsed.errors.is_empty());
+    parsed
+}
+pub(crate) fn all_string_tokens(source: &str, edition: u16) -> Vec<String> {
+    parsed(source, edition)
+        .parsed
+        .tree()
+        .syntax()
+        .descendants_with_tokens()
+        .filter_map(|child| child.into_token())
+        .filter(|token| token.kind() == SyntaxKind::STRING)
+        .map(|token| super::ast_adapter::string_value(token.text(), edition).unwrap())
+        .collect()
+}
+pub(crate) fn let_string_values(source: &str, edition: u16) -> Vec<String> {
+    parsed(source, edition)
+        .parsed
+        .tree()
+        .syntax()
+        .descendants()
+        .filter_map(ast::LetStmt::cast)
+        .filter_map(|binding| {
+            let ast::Expr::Literal(literal) = binding.initializer()? else {
+                return None;
+            };
+            let token = literal.token();
+            if token.kind() != SyntaxKind::STRING {
+                return None;
+            }
+            Some(super::ast_adapter::string_value(token.text(), edition).unwrap())
+        })
+        .collect()
+}
+pub(crate) fn main_string_initializer_recipes(
+    original: &str,
+    edition: u16,
+) -> Vec<(BodyIndex, VerifiedRecipe)> {
+    let parsed = parsed(original, edition);
+    let outline = parsed
+        .outline(
+            Digest::of_bytes(b"original UTF8 VM initializer"),
+            vec![],
+            &CfgSet::guest_default(),
+        )
+        .unwrap();
+    let body = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let index = parsed.index_body(body, Default::default()).unwrap();
+    parsed
+        .entered_body_root(body)
+        .unwrap()
+        .descendants()
+        .filter_map(ast::LetStmt::cast)
+        .filter_map(|statement| statement.initializer())
+        .filter_map(|expr| match expr {
+            ast::Expr::Literal(literal) if literal.token().kind() == SyntaxKind::STRING => {
+                Some(literal)
+            }
+            _ => None,
+        })
+        .map(|literal| {
+            let range = literal.syntax().text_range();
+            let node = index
+                .nodes()
+                .iter()
+                .find(|node| {
+                    node.role == NodeRole::Expression(ExpressionKind::Literal)
+                        && node.range.start + body.range.start == u32::from(range.start())
+                        && node.range.end + body.range.start == u32::from(range.end())
+                })
+                .unwrap();
+            let pc = index.pc(node.id, Phase::Entry).unwrap();
+            let recipe = parsed.initial_thunk(body, &index, &pc).unwrap();
+            (index.clone(), recipe)
+        })
+        .collect()
+}
+
+/// Exact source expression for an explicitly labeled LRR component adapter.
+/// This supplies syntax text, never a runtime result or a fixture-pass receipt.
+pub(crate) fn empty_method_expression(source: &str, constant_name: Option<&str>) -> String {
+    use ra_ap_syntax::ast::{HasGenericArgs, HasName};
+    let parsed = parsed(source, 2024);
+    let tree = parsed.parsed.tree();
+    let call = if let Some(name) = constant_name {
+        let constant = tree
+            .syntax()
+            .descendants()
+            .filter_map(ast::Const::cast)
+            .find(|constant| constant.name().is_some_and(|actual| actual.text() == name))
+            .unwrap();
+        let ast::Expr::MethodCallExpr(call) = constant.body().unwrap() else {
+            panic!("original empty initializer is a method call")
+        };
+        call
+    } else {
+        // Macro token trees are intentionally opaque to ordinary AST traversal.
+        // Parse each exact operand as syntax, then bind the selected expression
+        // back to its unchanged original byte range. No expected result is used.
+        for tokens in tree
+            .syntax()
+            .descendants()
+            .filter_map(ast::MacroCall::cast)
+            .filter_map(|call| call.token_tree())
+        {
+            let text = tokens.syntax().text().to_string();
+            let Some(inside) = text.get(1..text.len().saturating_sub(1)) else {
+                continue;
+            };
+            let operand = ast::Expr::parse(inside, ra_ap_syntax::Edition::Edition2024);
+            if !operand.errors().is_empty() {
+                continue;
+            }
+            let expression = operand.tree();
+            let Some(call) = expression
+                .syntax()
+                .descendants()
+                .filter_map(ast::MethodCallExpr::cast)
+                .find(|call| {
+                    call.name_ref()
+                        .is_some_and(|name| name.text() == "is_empty")
+                })
+            else {
+                continue;
+            };
+            assert!(call.generic_arg_list().is_none());
+            let range = call.syntax().text_range();
+            let base = usize::from(tokens.syntax().text_range().start()) + 1;
+            let original =
+                &source[base + usize::from(range.start())..base + usize::from(range.end())];
+            assert_eq!(original, call.syntax().text().to_string());
+            return original.to_string();
+        }
+        panic!("original is_empty operand absent")
+    };
+    assert!(
+        call.name_ref()
+            .is_some_and(|name| name.text() == "is_empty")
+    );
+    assert!(call.generic_arg_list().is_none());
+    let expression = call.syntax().text().to_string();
+    let range = call.syntax().text_range();
+    assert_eq!(
+        &source[u32::from(range.start()) as usize..u32::from(range.end()) as usize],
+        expression
+    );
+    expression
+}
