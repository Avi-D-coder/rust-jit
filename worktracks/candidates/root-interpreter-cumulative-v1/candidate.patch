+//! Compiler-owned str members. Receiver/source and physical lease authority are independent.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncoder},
+        profile::ProfileIdentity,
+    },
+    ir::op::PrimitiveType,
+};
+use std::sync::Arc;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-STRING-METHOD", message.into())
+}
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub(crate) enum StringMethodKind {
+    ByteLen,
+    AsBytes,
+    IsEmpty,
+    Contains,
+}
+impl StringMethodKind {
+    fn name(self) -> &'static str {
+        match self {
+            Self::ByteLen => "len",
+            Self::AsBytes => "as_bytes",
+            Self::IsEmpty => "is_empty",
+            Self::Contains => "contains",
+        }
+    }
+    fn tag(self) -> u8 {
+        match self {
+            Self::ByteLen => 0,
+            Self::AsBytes => 1,
+            Self::IsEmpty => 2,
+            Self::Contains => 3,
+        }
+    }
+}
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct StringMethod {
+    profile: Arc<ProfileIdentity>,
+    core: Digest,
+    kind: StringMethodKind,
+    signature: Digest,
+    body: Digest,
+    identity: Digest,
+}
+impl StringMethod {
+    pub(crate) fn kind(&self) -> StringMethodKind {
+        self.kind
+    }
+    pub(crate) fn require_profile(&self, profile: &ProfileIdentity) -> Result<(), Diagnostic> {
+        profile.validate_source()?;
+        if self.profile.as_ref() != profile || self.core != super::unit(profile, "core") {
+            return Err(fault("str method owning profile/core differs"));
+        }
+        Ok(())
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>()
+            .checked_add(std::mem::size_of::<ProfileIdentity>())?
+            .checked_add(2 * std::mem::size_of::<usize>())?
+            .checked_add(self.profile.semantics.capacity())
+    }
+}
+#[derive(Debug, Clone)]
+pub(crate) struct StringMethods {
+    profile: Arc<ProfileIdentity>,
+    len: StringMethod,
+    as_bytes: StringMethod,
+    is_empty: StringMethod,
+    contains: StringMethod,
+    identity: Digest,
+}
+fn member(profile: &Arc<ProfileIdentity>, core: Digest, kind: StringMethodKind) -> StringMethod {
+    let mut signature = StableEncoder::new("lrr/v2/str-method-signature");
+    signature.digest(core);
+    signature.record(profile.as_ref());
+    signature.string("str");
+    signature.string(kind.name());
+    signature.u8(0);
+    signature.u32(u32::from(kind == StringMethodKind::Contains)); // exact closed explicit arguments
+    if kind == StringMethodKind::Contains {
+        signature.string("core::str::pattern::Pattern for &str");
+        signature.string("shared str argument; independent source region");
+    }
+    signature.u8(kind.tag());
+    match kind {
+        StringMethodKind::ByteLen => signature.u32(PrimitiveType::Usize.tag()),
+        StringMethodKind::IsEmpty | StringMethodKind::Contains => {
+            signature.u32(PrimitiveType::Bool.tag())
+        }
+        StringMethodKind::AsBytes => {
+            signature.bool(false);
+            signature.string("receiver-borrow");
+            signature.string("[u8]");
+        }
+    }
+    signature.bool(kind != StringMethodKind::Contains); // contains is not const
+    let signature = signature.finish();
+    let mut body = StableEncoder::new("lrr/v2/str-method-body");
+    body.digest(signature);
+    body.u8(kind.tag());
+    let body = body.finish();
+    let mut identity = StableEncoder::new("lrr/v2/str-method-member");
+    identity.digest(core);
+    identity.record(profile.as_ref());
+    identity.digest(signature);
+    identity.digest(body);
+    StringMethod {
+        profile: profile.clone(),
+        core,
+        kind,
+        signature,
+        body,
+        identity: identity.finish(),
+    }
+}
+impl StringMethods {
+    pub(crate) fn for_profile(profile: &ProfileIdentity) -> Result<Self, Diagnostic> {
+        profile.validate_source()?;
+        let profile = Arc::new(profile.clone());
+        let core = super::unit(&profile, "core");
+        let len = member(&profile, core, StringMethodKind::ByteLen);
+        let as_bytes = member(&profile, core, StringMethodKind::AsBytes);
+        let is_empty = member(&profile, core, StringMethodKind::IsEmpty);
+        let contains = member(&profile, core, StringMethodKind::Contains);
+        let mut facet = StableEncoder::new("lrr/v4/str-method-facet");
+        facet.record(profile.as_ref());
+        facet.digest(core);
+        facet.digest(len.identity);
+        facet.digest(as_bytes.identity);
+        facet.digest(is_empty.identity);
+        facet.digest(contains.identity);
+        Ok(Self {
+            profile,
+            len,
+            as_bytes,
+            is_empty,
+            contains,
+            identity: facet.finish(),
+        })
+    }
+    pub(crate) fn profile(&self) -> &ProfileIdentity {
+        &self.profile
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(crate) fn lookup(&self, name: &str) -> Option<&StringMethod> {
+        match name {
+            "len" => Some(&self.len),
+            "as_bytes" => Some(&self.as_bytes),
+            "is_empty" => Some(&self.is_empty),
+            "contains" => Some(&self.contains),
+            _ => None,
+        }
+    }
+    pub(crate) fn require_member(&self, member: &StringMethod) -> Result<(), Diagnostic> {
+        member.require_profile(&self.profile)?;
+        if self.lookup(member.kind.name()) != Some(member) {
+            return Err(fault("str method signature/body/member identity differs"));
+        }
+        Ok(())
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(
+                self.len
+                    .allocated_bytes()
+                    .ok_or_else(|| fault("str method metadata overflow"))?,
+            )
+            .and_then(|n| n.checked_add(self.as_bytes.allocated_bytes()?))
+            .and_then(|n| n.checked_add(self.is_empty.allocated_bytes()?))
+            .and_then(|n| n.checked_add(self.contains.allocated_bytes()?))
+            .ok_or_else(|| fault("str method facet metadata overflow"))
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn string_member_refuses_changed_signature_body_core_and_profile() {
+        let facet = StringMethods::for_profile(&ProfileIdentity::current()).unwrap();
+        for actual in [
+            facet.lookup("len").unwrap(),
+            facet.lookup("as_bytes").unwrap(),
+            facet.lookup("is_empty").unwrap(),
+            facet.lookup("contains").unwrap(),
+        ] {
+            for kind in 0..5 {
+                let mut wrong = actual.clone();
+                match kind {
+                    0 => wrong.signature = Digest([231; 32]),
+                    1 => wrong.body = Digest([232; 32]),
+                    2 => wrong.core = Digest([233; 32]),
+                    3 => {
+                        wrong.profile = Arc::new(ProfileIdentity {
+                            edition: 2015,
+                            ..ProfileIdentity::current()
+                        })
+                    }
+                    _ => {
+                        wrong.kind = match actual.kind {
+                            StringMethodKind::ByteLen => StringMethodKind::AsBytes,
+                            StringMethodKind::AsBytes
+                            | StringMethodKind::IsEmpty
+                            | StringMethodKind::Contains => StringMethodKind::ByteLen,
+                        }
+                    }
+                };
+                assert!(facet.require_member(&wrong).is_err());
+            }
+            facet.require_member(actual).unwrap();
+        }
+        assert_ne!(
+            facet.lookup("len").unwrap(),
+            facet.lookup("as_bytes").unwrap()
+        );
+        assert!(facet.lookup("chars").is_none());
+    }
+}
