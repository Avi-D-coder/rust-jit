+            if started_bindings == 1 {
+                let (binding, len) = binding.expect("executed original binding");
+                binding_count += 1;
+                store
+                    .require_static_byte_value(frame.binding_cell_for_test(binding).unwrap(), len)
+                    .unwrap();
