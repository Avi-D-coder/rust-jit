+pub(super) fn start_source(
+    source: &str,
+    edition: u16,
+    fuel: u64,
+) -> (
+    Database,
+    RunMachine,
+    CompletedStandaloneRuntimeMacros,
+    PreparedSourceInputs,
+) {
+    start_source_named(
+        source,
+        "crlf-in-byte-string-literal.rs",
+        None,
+        edition,
+        fuel,
+    )
+}
+pub(super) fn start_source_named(
+    source: &str,
+    filename: &str,
+    source_directory: Option<&std::path::Path>,
+    edition: u16,
+    fuel: u64,
+) -> (
+    Database,
+    RunMachine,
+    CompletedStandaloneRuntimeMacros,
+    PreparedSourceInputs,
+) {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let cfg = CfgSet::guest_default();
+    let blob = SourceBlob::new(source.as_bytes().to_vec()).unwrap();
+    let path = SourcePath::new(filename).unwrap();
+    let unit = Digest::of_bytes(b"original-byte-macro-dispatch");
+    let environment = crate::expand::builtins::FrozenCompileEnvironment::new(
+        unit,
+        &crate::project::tool_manifest::CompileEnv {
+            unit,
+            host: "aarch64-apple-darwin".into(),
+            target: "aarch64-apple-darwin".into(),
+            cfg: cfg.clone(),
+            cargo: Default::default(),
+            rustc_env: Default::default(),
+            declared: Default::default(),
+            out_dir: None,
+        },
+    )
+    .unwrap();
+    let selected = SourceSelection {
+        path: path.clone(),
+        outline: crate::db::key::OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile,
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap()
+    .with_compile_environment(std::sync::Arc::new(environment.clone()))
+    .unwrap();
+    let mut db = Database::default();
+    db.trace.detailed = true;
+    inputs.publish(&mut db).unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selected).unwrap() else {
+        panic!("source absent")
+    };
+    let body = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap()
+        .key();
+    db.begin_expansion_epoch(1).unwrap();
+    let d = discovery(
+        &view,
+        Digest::of_bytes(b"first-sealed-dispatch"),
+        &mut db,
+        &environment,
+        source_directory,
+    );
+    let macros = CompletedStandaloneRuntimeMacros::from_discovery(&view, &d).unwrap();
+    db.begin_run().unwrap();
+    let run = RunMachine::start_with_discovery(&mut db, body, fuel, d)
+        .into_ready()
+        .unwrap()
+        .unwrap();
+    (db, run, macros, inputs)
+}
