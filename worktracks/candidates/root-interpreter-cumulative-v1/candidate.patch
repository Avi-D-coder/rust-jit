+//! Exact original RangePat endpoint sites. Syntax facts only, never name/type authority.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    ir::{
+        op::NumericBinary,
+        pc::{NodeId, PcKey, Phase, SlotId},
+    },
+    source::changes::{PreparedSourceView, SourceSelection},
+    syntax::{
+        ast_adapter::range,
+        body_index::{BodyIndex, ExpressionKind, NodeRole},
+        outline::BodyHandle,
+        parse::ParsedFile,
+        spans::{BodySpan, SourceRange},
+    },
+};
+use ra_ap_syntax::{
+    AstNode, SyntaxNode,
+    ast::{self, HasName, RangeItem, RangeOp},
+};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-CONST-RANGE-SOURCE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "range constant source site limit".into(),
+    )
+}
+fn relative(handle: &BodyHandle, node: &SyntaxNode) -> Result<SourceRange, Diagnostic> {
+    let r = range(node.text_range());
+    Ok(SourceRange {
+        start: r.start.checked_sub(handle.range.start).ok_or_else(limit)?,
+        end: r.end.checked_sub(handle.range.start).ok_or_else(limit)?,
+    })
+}
+fn exact(
+    index: &BodyIndex,
+    handle: &BodyHandle,
+    node: &SyntaxNode,
+    role: NodeRole,
+) -> Result<NodeId, Diagnostic> {
+    let r = relative(handle, node)?;
+    let mut rows = index
+        .nodes()
+        .iter()
+        .filter(|n| n.role == role && n.range == r);
+    let result = rows
+        .next()
+        .ok_or_else(|| fault("range constant structural owner absent"))?
+        .id;
+    if rows.next().is_some() {
+        return Err(fault("range constant structural owner ambiguous"));
+    }
+    Ok(result)
+}
+fn owning_body(node: &SyntaxNode, handle: &BodyHandle) -> bool {
+    node.ancestors()
+        .find_map(ast::Fn::cast)
+        .and_then(|f| f.body())
+        .is_some_and(|b| range(b.syntax().text_range()) == handle.range)
+}
+fn named_endpoint(pattern: &ast::Pat) -> bool {
+    match pattern {
+        ast::Pat::PathPat(path) => path.path().is_some(),
+        ast::Pat::IdentPat(path) => {
+            path.name().is_some()
+                && path.ref_token().is_none()
+                && path.mut_token().is_none()
+                && path.at_token().is_none()
+                && path.pat().is_none()
+        }
+        _ => false,
+    }
+}
+/// Path-pattern extension for the existing exact constant selector. No stand-alone
+/// identifier/variant pattern becomes a constant by spelling or module absence.
+pub(super) fn endpoint_pattern(
+    parsed: &ParsedFile,
+    handle: &BodyHandle,
+    selected: SourceRange,
+) -> Result<Option<ast::Pat>, Diagnostic> {
+    let root = parsed.entered_body_root(handle)?;
+    for (work, node) in root.descendants().enumerate() {
+        if work >= 100_000 {
+            return Err(limit());
+        }
+        let Some(path) = ast::Pat::cast(node) else {
+            continue;
+        };
+        if !named_endpoint(&path) {
+            continue;
+        }
+        if range(path.syntax().text_range()) != selected {
+            continue;
+        }
+        if !owning_body(path.syntax(), handle) {
+            return Err(fault("range path belongs to another function body"));
+        }
+        let Some(parent) = path.syntax().parent().and_then(ast::RangePat::cast) else {
+            return Ok(None);
+        };
+        if ![parent.start(), parent.end()]
+            .into_iter()
+            .flatten()
+            .any(|p| p.syntax() == path.syntax())
+        {
+            return Err(fault("range path is not an actual endpoint"));
+        }
+        return Ok(Some(path));
+    }
+    Ok(None)
+}
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct ScalarRangeConstantSite {
+    source: SourceSelection,
+    handle: BodyHandle,
+    index: Digest,
+    pc: PcKey,
+    span: BodySpan,
+    absolute: SourceRange,
+    owner: NodeId,
+    scrutinee: SlotId,
+    expected: SlotId,
+    test: SlotId,
+    upper: bool,
+    lower_present: bool,
+    upper_present: bool,
+    inclusive: bool,
+}
+impl ScalarRangeConstantSite {
+    pub(crate) fn require(&self, body: &BodyIndex, pc: &PcKey) -> Result<(), Diagnostic> {
+        if &self.pc != pc
+            || pc.body != self.handle.key()
+            || body.body() != &pc.body
+            || body.fingerprint() != self.index
+            || body.profile() != &self.source.outline.parse.profile
+            || body.cfg().fingerprint() != self.source.outline.cfg
+        {
+            return Err(fault("range constant current body/profile/site differs"));
+        }
+        let pattern = body
+            .nodes()
+            .get(pc.node as usize)
+            .ok_or_else(|| fault("range constant node absent"))?;
+        let owner = body
+            .nodes()
+            .get(self.owner.0 as usize)
+            .ok_or_else(|| fault("range constant match owner absent"))?;
+        if pattern.role != NodeRole::Pattern
+            || !pattern.scalar_range_phase
+            || owner.role != NodeRole::Expression(ExpressionKind::Match)
+            || owner.runtime_temporaries != [Some(self.expected), Some(self.test)]
+            || owner
+                .operands
+                .first()
+                .and_then(|n| body.nodes().get(n.0 as usize))
+                .and_then(|n| n.value)
+                != Some(self.scrutinee)
+            || self.span.body_key != pc.body
+            || self.span.relative_start >= self.span.relative_end
+            || self.span.relative_start < pattern.range.start
+            || self.span.relative_end > pattern.range.end
+            || self
+                .handle
+                .range
+                .start
+                .checked_add(self.span.relative_start)
+                != Some(self.absolute.start)
+            || self.handle.range.start.checked_add(self.span.relative_end)
+                != Some(self.absolute.end)
+            || (self.upper
+                && (!self.upper_present
+                    || pc.phase
+                        != if self.lower_present {
+                            Phase::Operand(0).code()?
+                        } else {
+                            Phase::Entry.code()?
+                        }))
+            || (!self.upper && (!self.lower_present || pc.phase != Phase::Entry.code()?))
+        {
+            return Err(fault("range constant phase/endpoint/match slots differ"));
+        }
+        let mut ancestor = pattern.parent;
+        let mut found = false;
+        for _ in 0..256 {
+            let Some(id) = ancestor else { break };
+            if id == self.owner {
+                found = true;
+                break;
+            }
+            ancestor = body
+                .nodes()
+                .get(id.0 as usize)
+                .ok_or_else(|| fault("range constant ancestor absent"))?
+                .parent;
+        }
+        if !found {
+            return Err(fault("range constant owning match ancestry differs"));
+        }
+        body.pc(NodeId(pc.node), Phase::from_code(pc.phase))?;
+        Ok(())
+    }
+    pub(crate) fn require_source(&self, source: &PreparedSourceView) -> Result<(), Diagnostic> {
+        source.require_original_hygiene()?;
+        source.require_declaration_syntax()?;
+        if source.selection() != &self.source
+            || !source
+                .outline()
+                .items
+                .iter()
+                .any(|i| i.body.as_ref() == Some(&self.handle))
+        {
+            return Err(fault("range constant owning source publication differs"));
+        }
+        Ok(())
+    }
+    pub(crate) fn key(&self) -> &PcKey {
+        &self.pc
+    }
+    pub(crate) fn endpoint_range(&self) -> SourceRange {
+        self.absolute
+    }
+    pub(crate) fn span(&self) -> &BodySpan {
+        &self.span
+    }
+    pub(crate) fn expected(&self) -> SlotId {
+        self.expected
+    }
+    pub(crate) fn test(&self) -> SlotId {
+        self.test
+    }
+    pub(crate) fn scrutinee(&self) -> SlotId {
+        self.scrutinee
+    }
+    pub(crate) fn discard_prior(&self) -> bool {
+        self.upper && self.lower_present
+    }
+    pub(crate) fn comparison(&self) -> NumericBinary {
+        if !self.upper {
+            NumericBinary::Ge
+        } else if self.inclusive {
+            NumericBinary::Le
+        } else {
+            NumericBinary::Lt
+        }
+    }
+    pub(crate) fn yes(&self, body: &BodyIndex) -> Result<PcKey, Diagnostic> {
+        body.pc(
+            NodeId(self.pc.node),
+            if !self.upper && self.upper_present {
+                Phase::Operand(0)
+            } else {
+                Phase::Commit
+            },
+        )
+    }
+    pub(crate) fn no(&self, body: &BodyIndex) -> Result<PcKey, Diagnostic> {
+        body.pc(NodeId(self.pc.node), Phase::Exit)
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.source.metadata_bytes()?)
+            .and_then(|n| n.checked_add(self.source.outline.parse.profile.semantics.capacity()))
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(limit)
+    }
+}
+impl StableEncode for ScalarRangeConstantSite {
+    const DOMAIN: &'static str = "lrr/v1/scalar-range-constant-site";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.source.location_identity());
+        e.record(&self.source.outline.parse);
+        e.digest(self.source.outline.cfg);
+        e.record(&self.handle);
+        e.digest(self.index);
+        e.record(&self.pc);
+        e.u32(self.absolute.start);
+        e.u32(self.absolute.end);
+        e.u32(self.span.relative_start);
+        e.u32(self.span.relative_end);
+        e.u32(self.owner.0);
+        e.u32(self.scrutinee.0);
+        e.u32(self.expected.0);
+        e.u32(self.test.0);
+        e.bool(self.upper);
+        e.bool(self.lower_present);
+        e.bool(self.upper_present);
+        e.bool(self.inclusive);
+    }
+}
+impl ParsedFile {
+    pub(crate) fn scalar_range_constant_site(
+        &self,
+        source: &PreparedSourceView,
+        handle: &BodyHandle,
+        index: &BodyIndex,
+        pc: &PcKey,
+    ) -> Result<Option<ScalarRangeConstantSite>, Diagnostic> {
+        if !matches!(Phase::from_code(pc.phase), Phase::Entry | Phase::Operand(0)) {
+            return Ok(None);
+        }
+        let Some(node) = index.nodes().get(pc.node as usize) else {
+            return Err(fault("range constant PC node absent"));
+        };
+        if node.role != NodeRole::Pattern || !node.scalar_range_phase {
+            return Ok(None);
+        }
+        source.require_original_hygiene()?;
+        source.require_declaration_syntax()?;
+        if self.key() != source.selection().outline.parse
+            || index.body() != &handle.key()
+            || pc.body != handle.key()
+            || index.profile() != &self.profile
+            || index.cfg().fingerprint() != source.selection().outline.cfg
+        {
+            return Err(fault("range constant parser/source/index differs"));
+        }
+        source
+            .selection()
+            .metadata_bytes()?
+            .checked_add(std::mem::size_of::<ScalarRangeConstantSite>())
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(limit)?;
+        let root = self.entered_body_root(handle)?;
+        let mut selected = None;
+        for (work, syntax) in root.descendants().enumerate() {
+            if work >= 100_000 {
+                return Err(limit());
+            }
+            let Some(pattern) = ast::RangePat::cast(syntax) else {
+                continue;
+            };
+            if relative(handle, pattern.syntax())? == node.range {
+                if selected.is_some() {
+                    return Err(fault("range constant AST site ambiguous"));
+                }
+                selected = Some(pattern);
+            }
+        }
+        let pattern = selected.ok_or_else(|| fault("range constant actual RangePat absent"))?;
+        if !owning_body(pattern.syntax(), handle) {
+            return Err(fault("range constant belongs to another original body"));
+        }
+        if pattern
+            .syntax()
+            .children()
+            .any(|n| ast::Attr::can_cast(n.kind()))
+        {
+            return Err(fault(
+                "range constant attributes require source preparation",
+            ));
+        }
+        let inclusive = match pattern.op_kind() {
+            Some(RangeOp::Inclusive) => true,
+            Some(RangeOp::Exclusive) => false,
+            None => return Err(fault("range constant operator absent")),
+        };
+        let lower = pattern.start();
+        let upper = pattern.end();
+        if (lower.is_none() && upper.is_none()) || (inclusive && upper.is_none()) {
+            return Err(fault("range constant required endpoint absent"));
+        }
+        let is_upper = lower.is_none() || pc.phase == Phase::Operand(0).code()?;
+        if pc.phase == Phase::Operand(0).code()? && (lower.is_none() || upper.is_none()) {
+            return Err(fault("range constant unexpected upper continuation"));
+        }
+        let endpoint = if is_upper {
+            upper.as_ref()
+        } else {
+            lower.as_ref()
+        }
+        .ok_or_else(|| fault("range constant endpoint absent"))?;
+        if !named_endpoint(endpoint) {
+            return Ok(None);
+        }
+        let absolute = range(endpoint.syntax().text_range());
+        if endpoint_pattern(self, handle, absolute)?.is_none() {
+            return Err(fault("range constant endpoint path differs"));
+        }
+        let owner = pattern
+            .syntax()
+            .ancestors()
+            .find_map(ast::MatchExpr::cast)
+            .ok_or_else(|| fault("range constant match AST owner absent"))?;
+        let owner_id = exact(
+            index,
+            handle,
+            owner.syntax(),
+            NodeRole::Expression(ExpressionKind::Match),
+        )?;
+        let expression = owner
+            .expr()
+            .ok_or_else(|| fault("range constant match scrutinee absent"))?;
+        let expression_range = relative(handle, expression.syntax())?;
+        let match_node = &index.nodes()[owner_id.0 as usize];
+        let source_node = match_node
+            .operands
+            .first()
+            .and_then(|n| index.nodes().get(n.0 as usize))
+            .filter(|n| n.range == expression_range)
+            .ok_or_else(|| fault("range constant exact scrutinee operand differs"))?;
+        let [Some(expected), Some(test)] = match_node.runtime_temporaries else {
+            return Err(fault("range constant match temporary pair absent"));
+        };
+        let site = ScalarRangeConstantSite {
+            source: source.selection().clone(),
+            handle: handle.clone(),
+            index: index.fingerprint(),
+            pc: pc.clone(),
+            span: BodySpan {
+                body_key: pc.body.clone(),
+                relative_start: absolute
+                    .start
+                    .checked_sub(handle.range.start)
+                    .ok_or_else(limit)?,
+                relative_end: absolute
+                    .end
+                    .checked_sub(handle.range.start)
+                    .ok_or_else(limit)?,
+            },
+            absolute,
+            owner: owner_id,
+            scrutinee: source_node
+                .value
+                .ok_or_else(|| fault("range constant scrutinee value absent"))?,
+            expected,
+            test,
+            upper: is_upper,
+            lower_present: lower.is_some(),
+            upper_present: upper.is_some(),
+            inclusive,
+        };
+        site.require_source(source)?;
+        site.require(index, pc)?;
+        site.metadata_bytes()?;
+        Ok(Some(site))
+    }
+}
