+#[test]
+fn unchanged_nul_length_operand_reads_four_bytes_once_as_usize_all_editions() {
+    const NULS: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/str/nul-char-equivalence.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(NULS, edition, 10_000);
+        let contexts = macros.contexts().unwrap();
+        let (id, source, destination) = reach_string_method(&mut db, &mut run, &contexts, 45);
+        let receiver = run.frame.cell(source).unwrap();
+        assert_eq!(run.store.static_string_byte_len(receiver).unwrap(), 4);
+        let value = run.store.admit_move(receiver).unwrap();
+        let before = effects(&run);
+        run.revalidate_primitive_method(&mut db, &contexts, id)
+            .unwrap();
+        assert_eq!(effects(&run), before);
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+        let ty = crate::runtime::shape::PrimitiveIdentity::from_recipe(PrimitiveType::Usize)
+            .unwrap()
+            .id();
+        assert_eq!(
+            run.store
+                .preview_scalar(run.frame.cell(destination).unwrap(), Some(ty))
+                .unwrap(),
+            crate::runtime::value::ValueRepr::unsigned(ty, 4).unwrap()
+        );
+        assert_eq!(
+            run.frame.source_view(destination).unwrap(),
+            Some(TyTerm::Primitive(PrimitiveType::Usize))
+        );
+        assert_eq!(run.store.admit_move(receiver).unwrap(), value);
+        assert_eq!(run.frame.counters().started_by_opcode[45], 1);
+        assert_eq!(run.frame.counters().operations_started, before.0 + 1);
+        assert_eq!(
+            run.frame.counters().operations_completed,
+            run.frame.counters().operations_started
+        );
+        db.finish_run().unwrap();
+    }
+    // Actual original method/initializer component, not the chars-loop/full main.
+}
