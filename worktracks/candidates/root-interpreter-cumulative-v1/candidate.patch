+//! Original-source admission controls, distinct from the full-main runtime witness.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    engine::standalone_macros::CompletedStandaloneRuntimeMacros,
+    expand::source_discovery::{SourceDiscovery, SourceDiscoveryStep},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput},
+        manifest::Namespace,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    traits::term::{ConstTerm, RegionTerm, TyTerm},
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/crlf-in-byte-string-literal.rs"
+);
+fn discovery(
+    view: &PreparedSourceView,
+    graph: Digest,
+    db: &mut Database,
+    environment: &crate::expand::builtins::FrozenCompileEnvironment,
+    source_directory: Option<&std::path::Path>,
+) -> SourceDiscovery {
+    let mut d = SourceDiscovery::new(
+        vec![view.share()],
+        view.outline().root_scope.clone(),
+        Namespace::Type,
+        graph,
+        1,
+    )
+    .unwrap()
+    .with_declarative(
+        environment.fingerprint(),
+        crate::expand::source_declarative::engine_version(),
+    )
+    .unwrap()
+    .with_compiler(std::sync::Arc::new(
+        crate::frontend::compile_input_catalog::CompileInputCatalog::standalone(
+            &view.selection().outline.parse.profile,
+        )
+        .unwrap(),
+    ))
+    .unwrap();
+    // Compile-input requests are prepared explicitly, before beginning a guest
+    // run. Only the named fixture directory grants a source-read capability.
+    use crate::{
+        db::poll::InputRequest,
+        service::{
+            eager_compile_inputs::EagerCompileInputPoll,
+            expansion::{DemandContext, ExpansionCoordinator, PhaseIdentity, Reply},
+            source_capture::SourceCapture,
+        },
+        source::include_paths::{IncludeAuthorities, IncludeRoot, IncludeRootKind},
+    };
+    let generation = Digest::of_bytes(b"original-string-fixture-source-generation");
+    let root_id = Digest::of_bytes(b"original-string-fixture-source-root");
+    let roots = source_directory.map(|path| IncludeRoot {
+        identity: root_id,
+        path: std::fs::canonicalize(path).unwrap(),
+        kind: IncludeRootKind::Source,
+    });
+    let authorities =
+        IncludeAuthorities::new(environment.unit(), generation, roots.clone()).unwrap();
+    let capture = source_directory.map(|_| {
+        SourceCapture::open(
+            IncludeAuthorities::new(environment.unit(), generation, roots).unwrap(),
+            Default::default(),
+        )
+        .unwrap()
+    });
+    let context = DemandContext {
+        request: graph,
+        session: view.selection().outline.parse.content,
+        unit: environment.unit(),
+        revision: db.source_revision(),
+        epoch: 1,
+        source_generation: generation,
+        native_generation: None,
+        compile_environment: environment.fingerprint(),
+    };
+    let mut coordinator = ExpansionCoordinator::new(context.clone());
+    let query = crate::db::key::QueryKey::Outline(view.selection().outline.clone());
+    let body = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .and_then(|item| item.body.as_ref())
+        .unwrap()
+        .key();
+    for index in 0..32 {
+        match d.poll().unwrap() {
+            SourceDiscoveryStep::Sealed(_) => return d,
+            SourceDiscoveryStep::NeedExpansion { request } if request.is_compiler() => {}
+            SourceDiscoveryStep::Incomplete {
+                diagnostic,
+                blocked,
+            } => {
+                panic!("original source discovery incomplete: {diagnostic}; blocked {blocked:?}")
+            }
+            other => panic!(
+                "original source discovery requires unsupported explicit work: {:?}",
+                std::mem::discriminant(&other)
+            ),
+        }
+        let phase = PhaseIdentity {
+            frame: graph,
+            body: body.clone(),
+            index,
+        };
+        match d.poll_compiler(db, environment, &authorities).unwrap() {
+            EagerCompileInputPoll::NeedInput(input @ InputRequest::CaptureInclude { .. }) => {
+                let InputRequest::CaptureInclude { request, .. } = &input else {
+                    unreachable!()
+                };
+                let captured = capture
+                    .as_ref()
+                    .expect("include requires an explicitly named fixture directory")
+                    .capture(request)
+                    .unwrap();
+                let token = coordinator.issue(query.clone(), phase, input).unwrap();
+                coordinator.start(&context, &token).unwrap();
+                coordinator
+                    .accept_include(&context, &token, &captured)
+                    .unwrap();
+                coordinator
+                    .adopt_include(&context, &token, db, captured)
+                    .unwrap();
+            }
+            EagerCompileInputPoll::Produced(record) => {
+                let input = InputRequest::Expand(Box::new(crate::db::poll::ExpansionRequest {
+                    key: record.key().clone(),
+                }));
+                let token = coordinator.issue(query.clone(), phase, input).unwrap();
+                coordinator.start(&context, &token).unwrap();
+                coordinator
+                    .accept(&context, &token, Reply::success(&token, record.output()))
+                    .unwrap();
+                coordinator.adopt(&context, &token, db, record).unwrap();
+            }
+            EagerCompileInputPoll::Complete(record) => {
+                d.admit_compiler_expansion(
+                    db,
+                    environment,
+                    &authorities,
+                    std::sync::Arc::new(record),
+                )
+                .unwrap();
+            }
+            _ => panic!("fixture compile input requires unsupported explicit preparation"),
+        }
+    }
+    panic!("original fixture discovery exceeded bounded preparation");
+}
