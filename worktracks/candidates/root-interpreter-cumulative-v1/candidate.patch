+//! Flat, unpublished immutable-byte progress. No source or type authority.
+use super::*;
+use crate::vm::fuel::RunFuel;
+const MAX_STEPS: usize = 256;
+const MAX_BYTES: usize = 64 << 10;
+const MAX_METADATA: usize = 32 << 20;
+const STEP_BYTES: usize = std::mem::size_of::<Cell>() * 2
+    + std::mem::size_of::<ObjectRecord>()
+    + std::mem::size_of::<ReferenceRecord>()
+    + std::mem::size_of::<TransferTicket>()
+    + 128;
+/// No Clone, serialization or raw-owner constructor. Drop is not cancellation:
+/// the reached driver must abort/drain this exact cursor before terminal return.
+pub(crate) struct StaticByteChunkActivation {
+    plan: PreparedStaticBytes,
+    fields: Vec<CellId>,
+    initialized: Option<InitializedFields>,
+    allocation: Option<StaticLiteralId>,
+    object: Option<ObjectId>,
+    root: Option<CellId>,
+    reference: Option<RefId>,
+    ticket: Option<TicketId>,
+    next: usize,
+    charged: u64,
+    ready: bool,
+    failure: Option<Diagnostic>,
+    finished: bool,
+    metadata: usize,
+    heap: usize,
+}
+pub(crate) enum StaticByteChunkPoll {
+    Dispatch {
+        steps: u16,
+        bytes: u32,
+        cleaning: bool,
+    },
+    Ready,
+    Failed(Diagnostic),
+}
+impl StaticByteChunkActivation {
+    pub(crate) fn reference_type(&self) -> TypeId {
+        self.plan.reference_type()
+    }
+    pub(crate) fn target(&self) -> ByteLiteralTarget {
+        self.plan.target()
+    }
+    pub(crate) fn len(&self) -> usize {
+        self.plan.len()
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.metadata
+    }
+    pub(crate) fn fields_charged(&self) -> u64 {
+        self.charged
+    }
+    pub(crate) fn cleaning(&self) -> bool {
+        self.failure.is_some()
+    }
+    pub(crate) fn finished(&self) -> bool {
+        self.finished
+    }
+}
+fn index_bytes() -> Result<usize, Diagnostic> {
+    128usize
+        .checked_add(std::mem::size_of::<(
+            crate::core::digest::Digest,
+            StaticLiteralId,
+        )>())
+        .ok_or_else(resource)
+}
+impl GuestStore {
+    /// Reserve-only: no guest owner is installed until advance. The caller has
+    /// already performed immutable plan admission and the original opcode charge.
+    pub(crate) fn prepare_static_byte_chunks(
+        &mut self,
+        plan: PreparedStaticBytes,
+    ) -> Result<StaticByteChunkActivation, Diagnostic> {
+        self.preflight_static_byte_reservation(&plan)?;
+        if plan.bytes.len() > MAX_STATIC_BYTES || STEP_BYTES > MAX_BYTES {
+            return Err(resource());
+        }
+        let fresh = usize::from(plan.existing.is_none());
+        let count = if fresh == 1 { plan.len() } else { 0 };
+        let mut fields = Vec::new();
+        fields.try_reserve_exact(count).map_err(|_| resource())?;
+        let initialized = InitializedFields::complete_static_bytes(count)?;
+        let heap = fields
+            .capacity()
+            .checked_mul(std::mem::size_of::<CellId>())
+            .and_then(|n| n.checked_add(initialized.owned_bytes()?))
+            .ok_or_else(resource)?;
+        let metadata = std::mem::size_of::<StaticByteChunkActivation>()
+            .checked_add(heap)
+            .and_then(|n| n.checked_add(plan.bytes.capacity()))
+            .and_then(|n| n.checked_add(plan.types.scratch_bytes().ok()?))
+            .filter(|n| *n <= MAX_METADATA)
+            .ok_or_else(resource)?;
+        let (handles, predicted) = self.static_byte_charge(&plan)?;
+        // Replace estimated field-vector/bitmap with actual fallible capacities.
+        let estimated = count
+            .checked_mul(std::mem::size_of::<CellId>())
+            .and_then(|n| n.checked_add(InitializedFields::estimated_bytes(count)?))
+            .ok_or_else(resource)?;
+        self.budget.check(
+            handles,
+            predicted
+                .checked_add(heap.saturating_sub(estimated))
+                .and_then(|n| n.checked_add(std::mem::size_of::<StaticByteChunkActivation>()))
+                .ok_or_else(resource)?,
+        )?;
+        self.types.commit_byte_literal_types(&plan.types)?;
+        let lease = usize::from(
+            plan.existing
+                .is_none_or(|(_, _, reference)| reference.is_none()),
+        );
+        self.cells.reserve(
+            count
+                .checked_add(fresh)
+                .and_then(|n| n.checked_add(usize::from(plan.needs_cell)))
+                .ok_or_else(resource)?,
+            &mut self.budget,
+        )?;
+        self.objects.reserve(fresh, &mut self.budget)?;
+        self.static_literals.reserve(fresh, &mut self.budget)?;
+        self.references.reserve(lease, &mut self.budget)?;
+        self.tickets.reserve(1, &mut self.budget)?;
+        self.budget.check(
+            handles,
+            metadata
+                .checked_add(if fresh == 1 { index_bytes()? } else { 0 })
+                .ok_or_else(resource)?,
+        )?;
+        Ok(StaticByteChunkActivation {
+            plan,
+            fields,
+            initialized: Some(initialized),
+            allocation: None,
+            object: None,
+            root: None,
+            reference: None,
+            ticket: None,
+            next: 0,
+            charged: 0,
+            ready: false,
+            failure: None,
+            finished: false,
+            metadata,
+            heap,
+        })
+    }
+    fn require_static_byte_cursor(&self, a: &StaticByteChunkActivation) -> Result<(), Diagnostic> {
+        if a.plan.session != self.pattern_binding_session
+            || a.plan.epoch != self.budget.epoch()
+            || a.finished
+        {
+            return Err(stale());
+        }
+        Ok(())
+    }
+    fn require_static_byte_membership(
+        &self,
+        a: &StaticByteChunkActivation,
+    ) -> Result<(), Diagnostic> {
+        if self.static_literal_member(a.plan.key, a.plan.view)? != a.plan.existing {
+            return Err(stale());
+        }
+        Ok(())
+    }
+    /// Retain the first reached error and drain only privately constructed owners.
+    pub(crate) fn abort_static_byte_chunks(
+        &mut self,
+        a: &mut StaticByteChunkActivation,
+        error: Diagnostic,
+    ) -> Result<(), Diagnostic> {
+        self.require_static_byte_cursor(a)?;
+        if a.failure.is_none() {
+            a.failure = Some(
+                if error
+                    .heap_bytes()
+                    .and_then(|n| n.checked_add(a.metadata))
+                    .is_some_and(|n| n <= MAX_METADATA)
+                {
+                    error
+                } else {
+                    resource()
+                },
+            );
+        }
+        Ok(())
+    }
+    fn advance_static_byte_field(
+        &mut self,
+        a: &mut StaticByteChunkActivation,
+        fuel: &mut RunFuel,
+    ) -> Result<(), Diagnostic> {
+        if let Some((_, root, _)) = a.plan.existing {
+            if self.place_type(root)? != a.plan.types.array {
+                return Err(ownership());
+            }
+            let (object, storage) = self.place_object(root)?;
+            if storage.fields.len() != a.len() {
+                return Err(ownership());
+            }
+            let field = *storage.fields.get(a.next).ok_or_else(ownership)?;
+            let cell = self.cells.get(field)?;
+            if cell.writable
+                || cell.owner
+                    != (CellOwner::Field {
+                        object,
+                        index: u32::try_from(a.next).map_err(|_| resource())?,
+                    })
+            {
+                return Err(ownership());
+            }
+            fuel.charge()?;
+            a.charged = a.charged.checked_add(1).ok_or_else(resource)?;
+            if self.read_scalar(field)?
+                != ValueRepr::unsigned(TypeId(9), u64::from(a.plan.bytes[a.next]))?
+            {
+                return Err(ownership());
+            }
+        } else {
+            let object = a.object.ok_or_else(ownership)?;
+            fuel.charge()?;
+            a.charged = a.charged.checked_add(1).ok_or_else(resource)?;
+            let field = self
+                .cells
+                .allocate(
+                    Cell {
+                        state: CellState::Live(ValueRepr::unsigned(
+                            TypeId(9),
+                            u64::from(a.plan.bytes[a.next]),
+                        )?),
+                        declared: StorageContract::Exact(TypeId(9)),
+                        writable: false,
+                        location_epoch: 1,
+                        owner: CellOwner::Field {
+                            object,
+                            index: u32::try_from(a.next).map_err(|_| resource())?,
+                        },
+                        retired: false,
+                        numeric_record: None,
+                    },
+                    0,
+                    &mut self.budget,
+                )?
+                .into();
+            a.fields.push(field);
+        }
+        a.next = a.next.checked_add(1).ok_or_else(resource)?;
+        Ok(())
+    }
+    fn static_byte_build_step(
+        &mut self,
+        a: &mut StaticByteChunkActivation,
+        fuel: &mut RunFuel,
+    ) -> Result<(), Diagnostic> {
+        if a.plan.existing.is_none() {
+            if a.allocation.is_none() {
+                a.allocation = Some(
+                    self.static_literals
+                        .allocate(
+                            StaticLiteralRecord {
+                                key: a.plan.key,
+                                root: None,
+                                array_reference: None,
+                                slice_reference: None,
+                                string_reference: None,
+                            },
+                            index_bytes()?,
+                            &mut self.budget,
+                        )?
+                        .into(),
+                );
+                return Ok(());
+            }
+            if a.object.is_none() {
+                a.object = Some(
+                    self.objects
+                        .allocate(
+                            ObjectRecord {
+                                type_id: a.plan.types.array,
+                                storage: ObjectStorage::Constructing,
+                                owner: None,
+                            },
+                            a.heap,
+                            &mut self.budget,
+                        )?
+                        .into(),
+                );
+                return Ok(());
+            }
+            if a.root.is_none() {
+                a.root = Some(
+                    self.cells
+                        .allocate(
+                            Cell {
+                                state: CellState::Uninit,
+                                declared: StorageContract::Exact(a.plan.types.array),
+                                writable: false,
+                                location_epoch: 1,
+                                owner: CellOwner::StaticLiteral(
+                                    a.allocation.ok_or_else(ownership)?,
+                                ),
+                                retired: false,
+                                numeric_record: None,
+                            },
+                            0,
+                            &mut self.budget,
+                        )?
+                        .into(),
+                );
+                return Ok(());
+            }
+        }
+        if a.next < a.len() {
+            self.advance_static_byte_field(a, fuel)?;
+        } else {
+            a.ready = true;
+        }
+        Ok(())
+    }
+    fn static_byte_cleanup_step(
+        &mut self,
+        a: &mut StaticByteChunkActivation,
+    ) -> Result<bool, Diagnostic> {
+        // No cached root/reference belongs to this transaction. Only the explicit
+        // newly allocated handles below may be removed without normal guest Drop.
+        if let Some(ticket) = a.ticket {
+            self.tickets.take(ticket, &mut self.budget)?;
+            a.ticket = None;
+        } else if let Some(reference) = a.reference {
+            self.references.take(reference, &mut self.budget)?;
+            a.reference = None;
+        } else if let Some(field) = a.fields.last().copied() {
+            self.cells.take(field, &mut self.budget)?;
+            a.fields.pop();
+        } else if let Some(root) = a.root {
+            self.cells.take(root, &mut self.budget)?;
+            a.root = None;
+        } else if let Some(object) = a.object {
+            self.objects.take(object, &mut self.budget)?;
+            a.object = None;
+        } else if let Some(allocation) = a.allocation {
+            self.static_literals.take(allocation, &mut self.budget)?;
+            a.allocation = None;
+        } else {
+            return Ok(true);
+        }
+        Ok(false)
+    }
+    /// Every normal/cleanup transition counts toward the dispatch work bound.
+    /// A cancelled/depleted fuel object can drain only this unpublished cursor.
+    pub(crate) fn advance_static_byte_chunks(
+        &mut self,
+        a: &mut StaticByteChunkActivation,
+        fuel: &mut RunFuel,
+    ) -> StaticByteChunkPoll {
+        if let Err(error) = self.require_static_byte_cursor(a) {
+            return StaticByteChunkPoll::Failed(error);
+        }
+        if a.failure.is_none()
+            && let Err(error) = self.require_static_byte_membership(a)
+            && let Err(error) = self.abort_static_byte_chunks(a, error)
+        {
+            return StaticByteChunkPoll::Failed(error);
+        }
+        let mut steps = 0usize;
+        let mut bytes = 0usize;
+        while steps < MAX_STEPS
+            && bytes
+                .checked_add(STEP_BYTES)
+                .is_some_and(|n| n <= MAX_BYTES)
+        {
+            if a.failure.is_some() {
+                match self.static_byte_cleanup_step(a) {
+                    Ok(true) => {
+                        a.finished = true;
+                        return StaticByteChunkPoll::Failed(
+                            a.failure.take().unwrap_or_else(ownership),
+                        );
+                    }
+                    Ok(false) => {}
+                    Err(error) => return StaticByteChunkPoll::Failed(error),
+                }
+            } else {
+                let result = fuel.poll().and_then(|()| {
+                    if a.ready {
+                        return Ok(());
+                    }
+                    self.static_byte_build_step(a, fuel)
+                });
+                if let Err(error) = result {
+                    if let Err(error) = self.abort_static_byte_chunks(a, error) {
+                        return StaticByteChunkPoll::Failed(error);
+                    }
+                } else if a.ready {
+                    return StaticByteChunkPoll::Ready;
+                }
+            }
+            steps += 1;
+            bytes += STEP_BYTES;
+        }
+        StaticByteChunkPoll::Dispatch {
+            steps: steps as u16,
+            bytes: bytes as u32,
+            cleaning: a.cleaning(),
+        }
+    }
+    /// Source/currentness/fuel must be revalidated by the owning frame immediately
+    /// before this physical seal. All fallible reservations precede publication.
+    pub(crate) fn commit_static_byte_chunks(
+        &mut self,
+        a: &mut StaticByteChunkActivation,
+    ) -> Result<TicketId, Diagnostic> {
+        self.require_static_byte_cursor(a)?;
+        self.require_static_byte_membership(a)?;
+        if !a.ready
+            || a.failure.is_some()
+            || a.reference.is_some()
+            || a.ticket.is_some()
+            || a.next != a.len()
+            || a.charged != a.len() as u64
+        {
+            return Err(ownership());
+        }
+        let (allocation, root, previous) = if let Some(existing) = a.plan.existing {
+            existing
+        } else {
+            let allocation = a.allocation.ok_or_else(ownership)?;
+            let object = a.object.ok_or_else(ownership)?;
+            let root = a.root.ok_or_else(ownership)?;
+            let cell = self.cells.get(root)?;
+            if cell.retired
+                || cell.writable
+                || !matches!(cell.state, CellState::Uninit)
+                || cell.owner != CellOwner::StaticLiteral(allocation)
+                || a.fields.len() != a.len()
+                || !a
+                    .initialized
+                    .as_ref()
+                    .is_some_and(InitializedFields::complete_value)
+                || !matches!(
+                    self.objects.get(object)?.storage,
+                    ObjectStorage::Constructing
+                )
+                || self.objects.get(object)?.owner.is_some()
+                || self.static_literals.get(allocation)?.root.is_some()
+            {
+                return Err(ownership());
+            }
+            (allocation, root, None)
+        };
+        let lease = usize::from(previous.is_none());
+        // The owning frame already allocated the destination from preparation's
+        // complete reservation before construction began. Only the remaining
+        // private lease/ticket are allocated at this seal; counting a second
+        // destination spuriously refuses an exactly admitted handle budget.
+        let handles =
+            u32::try_from(lease.checked_add(1).ok_or_else(resource)?).map_err(|_| resource())?;
+        let bytes = self
+            .references
+            .reservation_bytes(lease)?
+            .checked_add(self.tickets.reservation_bytes(1)?)
+            .ok_or_else(resource)?;
+        self.budget.check(handles, bytes)?;
+        self.references.reserve(lease, &mut self.budget)?;
+        self.tickets.reserve(1, &mut self.budget)?;
+        let reference = if let Some(reference) = previous {
+            reference
+        } else {
+            let stamp = CellStamp {
+                cell: root,
+                epoch: self.cells.get(root)?.location_epoch,
+            };
+            let reference = self
+                .references
+                .allocate(
+                    ReferenceRecord {
+                        access: Access::Shared,
+                        owner: None,
+                        target: a.plan.types.target,
+                        root: stamp,
+                        enclosing: Vec::new(),
+                        final_cell: stamp,
+                        static_slice: if a.plan.view != ByteLiteralTarget::Array {
+                            Some(allocation)
+                        } else {
+                            None
+                        },
+                    },
+                    0,
+                    &mut self.budget,
+                )?
+                .into();
+            a.reference = Some(reference);
+            reference
+        };
+        let ticket = self
+            .tickets
+            .allocate(
+                TransferTicket {
+                    value: ValueRepr {
+                        kind: 9,
+                        type_id: a.plan.types.reference.0,
+                        payload: reference.bits(),
+                    },
+                },
+                0,
+                &mut self.budget,
+            )?
+            .into();
+        a.ticket = Some(ticket);
+        // No fallible operation follows these prevalidated same-store lookups.
+        // Incomplete Object/Uninit root/private record were never ordinary values.
+        if a.plan.existing.is_none() {
+            let object = a.object.expect("prevalidated private byte object");
+            let record = self
+                .objects
+                .get_mut(object)
+                .expect("prevalidated private byte object");
+            record.storage = ObjectStorage::Aggregate(AggregateStorage {
+                fields: std::mem::take(&mut a.fields),
+                initialized: a.initialized.take().expect("prevalidated byte bitmap"),
+                next_cleanup: 0,
+                pending_cleanup: None,
+                variant: None,
+            });
+            record.owner = Some(ValueOwner::Cell(root));
+            self.cells
+                .get_mut(root)
+                .expect("prevalidated private byte root")
+                .state = CellState::Live(ValueRepr {
+                kind: 8,
+                type_id: a.plan.types.array.0,
+                payload: object.bits(),
+            });
+            self.static_literals
+                .get_mut(allocation)
+                .expect("prevalidated private byte membership")
+                .root = Some(root);
+            self.static_literal_index.insert(a.plan.key, allocation);
+        }
+        if previous.is_none() {
+            let record = self
+                .static_literals
+                .get_mut(allocation)
+                .expect("prevalidated byte membership");
+            match a.plan.view {
+                ByteLiteralTarget::Array => record.array_reference = Some(reference),
+                ByteLiteralTarget::Slice => record.slice_reference = Some(reference),
+                ByteLiteralTarget::Str => record.string_reference = Some(reference),
+            }
+        }
+        a.reference = None;
+        a.ticket = None;
+        a.finished = true;
+        Ok(ticket)
+    }
+}
