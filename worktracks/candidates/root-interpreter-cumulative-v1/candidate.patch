+            let before_literals = frame.counters().started_by_opcode[0];
+            let before_bindings = frame.counters().started_by_opcode[7];
+            assert!(matches!(
+                step(&mut frame, &mut store, &recipe).unwrap_or_else(|error| {
+                    panic!(
+                        "edition {edition}, PC {:?}, operations {:?}: {error}",
+                        frame.pc(),
+                        recipe.recipe().operations
+                    )
+                }),
+                StepOutcome::Next(_) | StepOutcome::Dispatch
+            ));
+            let started_literals = frame.counters().started_by_opcode[0] - before_literals;
+            let started_bindings = frame.counters().started_by_opcode[7] - before_bindings;
+            assert!(started_literals <= 1 && started_bindings <= 1);
+            // Dispatch may resume cleanup later in this same recipe. Presence
+            // of a BindLocal operation is not another executed binding.
+            if started_literals == 1 {
+                let (literal, destination) = literal.expect("executed original literal");
+                literal_count += 1;
