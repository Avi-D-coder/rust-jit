+//! Actual ordinary literal execution from unchanged upstream sources.
+//! Initializer selection is component evidence, not whole-main execution.
+use super::*;
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    ir::{pc::Phase, recipe::VerifiedRecipe},
+    runtime::{cell::CellState, shape::TypeKey},
+    source::snapshot::{CfgSet, SourceBlob},
+    syntax::{body_index::BodyIndex, parse::ParsedFile},
+};
+const UNICODE: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/unicode-escape-sequences.rs"
+);
+const NULS: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/str/nul-char-equivalence.rs"
+);
+const CRLF: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/lexer-crlf-line-endings-string-literal-doc-comment.rs"
+);
+
+#[test]
+fn original_string_pattern_literal_requires_own_match_slot_and_entry_before_effects() {
+    const ORIGINAL: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/match/match-borrowed-str.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap(),
+            ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            },
+        )
+        .unwrap();
+        let outline = parsed
+            .outline(Digest([247; 32]), vec![], &CfgSet::guest_default())
+            .unwrap();
+        let body = outline
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == "compare")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap();
+        let index = parsed.index_body(body, Default::default()).unwrap();
+        let node = index
+            .nodes()
+            .iter()
+            .find(|node| node.string_pattern_phase)
+            .unwrap();
+        let key = index.pc(node.id, Phase::Entry).unwrap();
+        let recipe = parsed.initial_thunk(body, &index, &key).unwrap();
+        let [
+            Op::Literal {
+                literal,
+                destination,
+                ..
+            },
+        ] = recipe.recipe().operations.as_ref()
+        else {
+            panic!("original pattern literal must have its own dispatch")
+        };
+        let (mut frame, mut store) = frame(&index, &recipe);
+        let before = (
+            store.budget().handles(),
+            store.budget().bytes(),
+            store.type_metadata_bytes(),
+            frame.fuel_snapshot(),
+            frame.counters().operations_started,
+        );
+        prepare(&frame, &store, literal, *destination, None).unwrap();
+        assert!(prepare(&frame, &store, literal, SlotId(u32::MAX), None).is_err());
+        let mut wrong = literal.clone();
+        wrong.source.relative_end += 1;
+        assert!(prepare(&frame, &store, &wrong, *destination, None).is_err());
+        assert_eq!(
+            (
+                store.budget().handles(),
+                store.budget().bytes(),
+                store.type_metadata_bytes(),
+                frame.fuel_snapshot(),
+                frame.counters().operations_started
+            ),
+            before
+        );
+        assert!(matches!(
+            super::super::step(&mut frame, &mut store, &recipe).unwrap(),
+            StepOutcome::Next(_)
+        ));
+        assert_eq!(*frame.pc(), index.pc(node.id, Phase::Operand(0)).unwrap());
+        let before = (
+            store.budget().handles(),
+            store.budget().bytes(),
+            store.type_metadata_bytes(),
+            frame.fuel_snapshot(),
+            frame.counters().operations_started,
+        );
+        assert!(prepare(&frame, &store, literal, *destination, None).is_err());
+        assert_eq!(
+            (
+                store.budget().handles(),
+                store.budget().bytes(),
+                store.type_metadata_bytes(),
+                frame.fuel_snapshot(),
+                frame.counters().operations_started
+            ),
+            before
+        );
+    }
+}
+
+fn recipes(original: &str, edition: u16) -> Vec<(BodyIndex, VerifiedRecipe)> {
+    crate::syntax::string_fixture_facts::main_string_initializer_recipes(original, edition)
+}
+fn frame(index: &BodyIndex, recipe: &VerifiedRecipe) -> (Frame, GuestStore) {
+    let mut store = GuestStore::new(1, 10_000, 16 << 20).unwrap();
+    let mut frame = Frame::new(index.clone(), recipe.recipe().key.clone(), &mut store).unwrap();
+    let mut next = Some(index.nodes()[recipe.recipe().key.node as usize].scope);
+    let mut ancestors = Vec::new();
+    while let Some(scope) = next {
+        ancestors.push(scope);
+        next = index.scopes()[scope.0 as usize].parent;
+    }
+    for scope in ancestors.into_iter().rev() {
+        frame.enter(scope).unwrap();
+    }
+    frame.set_fuel_limit(1000).unwrap();
+    (frame, store)
+}
