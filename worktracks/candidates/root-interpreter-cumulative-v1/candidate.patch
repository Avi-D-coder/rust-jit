+/// Retain the source-selected member kind with the reached receiver witness.
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) enum PrimitiveMethodAdmission {
+    Float(PrimitiveFloatAdmission),
+    String {
+        written: RuntimePrimitiveMethod,
+        receiver: TyTerm,
+        argument: Option<TyTerm>,
+        member: crate::facade::string_methods::StringMethod,
+    },
+}
+impl PrimitiveMethodAdmission {
+    pub(crate) fn select(
+        written: RuntimePrimitiveMethod,
+        source: &PreparedSourceView,
+        catalog: &RuntimeMacroCatalog,
+        frame: &Frame,
+        store: &GuestStore,
+    ) -> Result<Self, Diagnostic> {
+        if written.kind() == RuntimePrimitiveMethodKind::IsNan {
+            return PrimitiveFloatAdmission::select(written, source, catalog, frame, store)
+                .map(Self::Float);
+        }
+        written.require(&source.selection().outline.parse, frame.pc())?;
+        if frame.body.body() != &written.span().body_key
+            || !matches!(frame.source_view_ref(written.receiver())?,
+                Some(TyTerm::Ref(_, false, target)) if target.as_ref() == &TyTerm::Str)
+        {
+            return Err(fault(
+                "str method requires its actual shared str source receiver",
+            ));
+        }
+        let receiver = frame
+            .source_view_ref(written.receiver())?
+            .ok_or_else(|| fault("string receiver source absent"))?
+            .clone();
+        store.require_static_string_value(frame.cell(written.receiver())?)?;
+        let argument = if let Some(slot) = written.argument() {
+            if written.kind() != RuntimePrimitiveMethodKind::StrContains
+                || !matches!(frame.source_view_ref(slot)?,
+                    Some(TyTerm::Ref(_, false, target)) if target.as_ref() == &TyTerm::Str)
+            {
+                return Err(fault("str Pattern requires the actual shared str argument"));
+            }
+            store.require_static_string_value(frame.cell(slot)?)?;
+            Some(
+                frame
+                    .source_view_ref(slot)?
+                    .ok_or_else(|| fault("str Pattern source absent"))?
+                    .clone(),
+            )
+        } else {
+            if written.kind() == RuntimePrimitiveMethodKind::StrContains {
+                return Err(fault("str contains Pattern argument is absent"));
+            }
+            None
+        };
+        let (member, expected_kind) = match written.kind() {
+            RuntimePrimitiveMethodKind::StrByteLen => {
+                let member = catalog
+                    .string_len_method()
+                    .ok_or_else(|| fault("str::len compiler member is unavailable"))?;
+                catalog.require_string_len_method(member)?;
+                (
+                    member,
+                    crate::facade::string_methods::StringMethodKind::ByteLen,
+                )
+            }
+            RuntimePrimitiveMethodKind::StrContains => {
+                let member = catalog
+                    .string_method("contains")
+                    .ok_or_else(|| fault("str::contains compiler member is unavailable"))?;
+                catalog.require_string_method(member)?;
+                (
+                    member,
+                    crate::facade::string_methods::StringMethodKind::Contains,
+                )
+            }
+            RuntimePrimitiveMethodKind::StrIsEmpty => {
+                let member = catalog
+                    .string_method("is_empty")
+                    .ok_or_else(|| fault("str::is_empty compiler member is unavailable"))?;
+                catalog.require_string_method(member)?;
+                (
+                    member,
+                    crate::facade::string_methods::StringMethodKind::IsEmpty,
+                )
+            }
+            RuntimePrimitiveMethodKind::StrAsBytes => {
+                let member = catalog
+                    .string_method("as_bytes")
+                    .ok_or_else(|| fault("str::as_bytes compiler member is unavailable"))?;
+                catalog.require_string_method(member)?;
+                (
+                    member,
+                    crate::facade::string_methods::StringMethodKind::AsBytes,
+                )
+            }
+            RuntimePrimitiveMethodKind::IsNan => {
+                return Err(fault("float method entered string member selection"));
+            }
+        };
+        member.require_profile(&source.selection().outline.parse.profile)?;
+        if member.kind() != expected_kind {
+            return Err(fault("str method source/member kind differs"));
+        }
+        Ok(Self::String {
+            written,
+            receiver,
+            argument,
+            member: member.clone(),
+        })
+    }
+    pub(crate) fn operation(
+        &self,
+        written: &RuntimePrimitiveMethod,
+        source: &PreparedSourceView,
+        key: &PcKey,
+    ) -> Result<Op, Diagnostic> {
+        match self {
+            Self::Float(admission) => admission.operation(written, source, key),
+            Self::String {
+                written: selected,
+                receiver: _,
+                argument: _,
+                member,
+            } => {
+                written.require(&source.selection().outline.parse, key)?;
+                if written != selected {
+                    return Err(fault("str method admission source phase differs"));
+                }
+                member.require_profile(&source.selection().outline.parse.profile)?;
+                match (written.kind(), member.kind()) {
+                    (
+                        RuntimePrimitiveMethodKind::StrByteLen,
+                        crate::facade::string_methods::StringMethodKind::ByteLen,
+                    ) => Ok(Op::StrByteLen {
+                        source: written.receiver(),
+                        destination: written.destination(),
+                    }),
+                    (
+                        RuntimePrimitiveMethodKind::StrContains,
+                        crate::facade::string_methods::StringMethodKind::Contains,
+                    ) => Ok(Op::StrContains {
+                        source: written.receiver(),
+                        pattern: written
+                            .argument()
+                            .ok_or_else(|| fault("str Pattern slot absent"))?,
+                        destination: written.destination(),
+                    }),
+                    (
+                        RuntimePrimitiveMethodKind::StrIsEmpty,
+                        crate::facade::string_methods::StringMethodKind::IsEmpty,
+                    ) => Ok(Op::StrIsEmpty {
+                        source: written.receiver(),
+                        destination: written.destination(),
+                    }),
+                    (
+                        RuntimePrimitiveMethodKind::StrAsBytes,
+                        crate::facade::string_methods::StringMethodKind::AsBytes,
+                    ) => Ok(Op::StrAsBytes {
+                        source: written.receiver(),
+                        destination: written.destination(),
+                    }),
+                    _ => Err(fault("str method source/member kind differs")),
+                }
+            }
+        }
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>().checked_add(match self {
+            Self::Float(admission) => admission.allocated_bytes()?,
+            Self::String {
+                written,
+                receiver,
+                argument,
+                member,
+            } => written
+                .allocated_bytes()?
+                .checked_add(receiver.heap_bytes()?)?
+                .checked_add(argument.as_ref().map_or(Some(0), TyTerm::heap_bytes)?)?
+                .checked_add(member.allocated_bytes()?)?,
+        })
+    }
+}
