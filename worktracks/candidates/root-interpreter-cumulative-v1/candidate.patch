+fn original_negative_local_fallback_wire_requires_exact_source_read_phase_and_destination() {
+    use crate::core::digest::StableEncode;
+    const ORIGINAL: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/numbers-arithmetic/integer-literal-suffix-inference.rs"
+    );
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity::current(),
+    )
+    .unwrap();
+    let outline = parsed
+        .outline(Digest([42; 32]), vec![], &CfgSet::guest_default())
+        .unwrap();
+    let handle = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let body = parsed.index_body(handle, Default::default()).unwrap();
+    let start = u32::try_from(ORIGINAL.find("id_i8(j)").unwrap() + "id_i8(".len()).unwrap()
+        - handle.range.start;
+    let node = body
+        .nodes()
+        .iter()
+        .find(|node| {
+            node.range.start == start
+                && node.range.end == start + 1
+                && node.role
+                    == NodeRole::Expression(crate::syntax::body_index::ExpressionKind::Path)
+        })
+        .unwrap();
+    let key = body.pc(node.id, Phase::Entry).unwrap();
+    let verified = parsed.initial_thunk(handle, &body, &key).unwrap();
+    let recipe = verified.recipe();
+    let (child, proof) = recipe
+        .operations
+        .iter()
+        .find_map(|op| match op {
+            Op::SetHint {
+                child,
+                hint: HintRecipe::LocalIntegerFallback(proof),
+            } => Some((*child, proof)),
+            _ => None,
+        })
+        .unwrap();
+    proof.require(&body, &key, child).unwrap();
+    let mut expected = StableEncoder::new("lrr/v7/definition-numeric-hint-test");
+    expected.u32(10);
+    expected.record(proof.as_ref());
+    assert_eq!(
+        hint_digest(HintRecipe::LocalIntegerFallback(proof.clone())),
+        expected.finish()
+    );
+    assert_ne!(
+        hint_digest(HintRecipe::LocalIntegerFallback(proof.clone())),
+        hint_digest(HintRecipe::Primitive(PrimitiveType::I32))
+    );
+    let original = RecipeDraft {
+        key: recipe.key.clone(),
+        origin: recipe.origin.clone(),
+        operations: recipe.operations.to_vec(),
+        exits: vec![recipe.exit.clone()],
+        dependencies: recipe.dependencies.to_vec(),
+    };
+    verify(original.clone(), &body).unwrap();
+    let mut wrong = original.clone();
+    wrong.key.phase = Phase::Exit.code().unwrap();
+    assert!(verify(wrong, &body).is_err());
+    let other = body
+        .nodes()
+        .iter()
+        .filter_map(|node| node.value)
+        .find(|slot| *slot != child)
+        .unwrap();
+    let mut wrong = original.clone();
+    for op in &mut wrong.operations {
+        if let Op::SetHint {
+            child,
+            hint: HintRecipe::LocalIntegerFallback(_),
+        } = op
+        {
+            *child = other;
+        }
+    }
+    assert!(verify(wrong, &body).is_err());
+    let mut wrong = original;
+    wrong.operations = vec![Op::BindLocal {
+        binding: proof.binding(),
+        source: child,
+        hint: HintRecipe::LocalIntegerFallback(proof.clone()),
+        writable: false,
+    }];
+    assert!(verify(wrong, &body).is_err());
+    let mut old = StableEncoder::new("lrr/v16/lrir-recipe");
+    recipe.encode_fields(&mut old);
+    assert_ne!(recipe.fingerprint(), old.finish());
+}
