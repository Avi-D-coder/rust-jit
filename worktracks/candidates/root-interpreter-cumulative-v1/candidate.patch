+//! Actual unchanged upstream assertion operand and LRR source-authority controls.
+//! Operand/method components and refusal controls are not whole-fixture passes.
+use super::*;
+use crate::{
+    ir::op::PrimitiveType,
+    runtime::shape::TypeKey,
+    traits::term::{RegionTerm, TyTerm},
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/unicode-escape-sequences.rs"
+);
+fn reached(
+    db: &mut Database,
+    run: &mut RunMachine,
+    contexts: &[crate::engine::runtime_macros::RuntimeMacroContext<'_>],
+) -> (crate::engine::install::RecipeId, LiteralRecipe, SlotId) {
+    tests::reach_literal_kind(db, run, contexts, LiteralKind::String, true)
+}
+fn effects(run: &RunMachine) -> (u64, u32, usize, usize, u64) {
+    (
+        run.frame.counters().operations_started,
+        run.store.budget().handles(),
+        run.store.budget().bytes(),
+        run.store.type_metadata_bytes(),
+        run.frame.fuel_snapshot().used,
+    )
+}
+
+fn reach_string_method(
+    db: &mut Database,
+    run: &mut RunMachine,
+    contexts: &[crate::engine::runtime_macros::RuntimeMacroContext<'_>],
+    opcode: u8,
+) -> (crate::engine::install::RecipeId, SlotId, SlotId) {
+    for _ in 0..256 {
+        let key = run.frame.pc().clone();
+        let macro_node = run.frame.body.nodes()[key.node as usize].role
+            == NodeRole::Expression(ExpressionKind::Macro);
+        let generated = if macro_node && !run.installed.contains_pc(&key) {
+            run.declarative_runtime
+                .prepare(db, &run.sources, &run.frame.body, &key)
+                .into_ready()
+                .unwrap()
+                .unwrap()
+        } else {
+            None
+        };
+        let prepared = if macro_node && generated.is_none() {
+            contexts.iter().find_map(|context| {
+                context
+                    .resolve_at(
+                        &run.frame.body,
+                        &key,
+                        run.runtime_no_item_proofs.values(),
+                        Some((&run.frame, &run.store)),
+                    )
+                    .unwrap()
+            })
+        } else {
+            None
+        };
+        let id = if let Some(plan) = generated {
+            let id = run
+                .installed
+                .install_prepared(db, key, plan.recipe())
+                .unwrap();
+            run.declarative_runtime.retain(plan).unwrap();
+            id
+        } else if let Some(prepared) = prepared {
+            if let Some(proof) = prepared.no_item {
+                run.retain_no_item_proof(proof).unwrap();
+            }
+            if let Some(method) = prepared.primitive_method {
+                run.retain_primitive_method(&key, method, prepared.recipe.recipe().fingerprint())
+                    .unwrap();
+            }
+            assert!(prepared.call.is_none());
+            run.installed
+                .install_prepared(db, key, &prepared.recipe)
+                .unwrap()
+        } else {
+            run.installed
+                .resolve(db, key)
+                .into_ready()
+                .unwrap()
+                .unwrap()
+        };
+        if let Some((source, destination)) = run
+            .installed
+            .get(id)
+            .unwrap()
+            .recipe()
+            .operations
+            .iter()
+            .find_map(|op| match op {
+                Op::StrContains {
+                    source,
+                    destination,
+                    ..
+                } if opcode == 48 => Some((*source, *destination)),
+                Op::StrByteLen {
+                    source,
+                    destination,
+                }
+                | Op::StrAsBytes {
+                    source,
+                    destination,
+                }
+                | Op::StrIsEmpty {
+                    source,
+                    destination,
+                } if op.opcode_tag() == opcode => Some((*source, *destination)),
+                _ => None,
+            })
+        {
+            return (id, source, destination);
+        }
+        run.prepare_macro_byte_literal(db, contexts, id).unwrap();
+        run.prepare_macro_byte_comparison(db, contexts, id).unwrap();
+        run.revalidate_primitive_method(db, contexts, id).unwrap();
+        let mut finished = false;
+        for _ in 0..65_536 {
+            match step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap(),
+            )
+            .unwrap()
+            {
+                StepOutcome::Dispatch => {}
+                StepOutcome::Next(_) => {
+                    finished = true;
+                    break;
+                }
+                other => panic!("original string prefix did not continue: {other:?}"),
+            }
+        }
+        assert!(
+            finished,
+            "original string prefix exceeded bounded dispatches"
+        );
+    }
+    panic!("original requested string member operation was not reached");
+}
