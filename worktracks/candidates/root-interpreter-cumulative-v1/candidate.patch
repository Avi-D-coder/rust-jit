+#[test]
+fn original_first_static_byte_hint_metadata_refusal_keeps_store_and_fuel() {
+    let mut one = TypeRegistry::default();
+    one.intern(TypeKey::Slice { element: TypeId(9) }).unwrap();
+    let limit = one.metadata_bytes();
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, source, _source_lease) = world(ORIGINAL, edition);
+        let handle = source
+            .outline()
+            .items
+            .iter()
+            .find(|i| i.def_key.declared_name == "main")
+            .unwrap()
+            .body
+            .clone()
+            .unwrap();
+        let parsed = db
+            .prepared_parse(&source.selection().outline.parse)
+            .unwrap();
+        let index = parsed
+            .index_body_with_cfg(
+                &handle,
+                source.captured_macro_cfg().unwrap(),
+                Default::default(),
+            )
+            .unwrap();
+        let key = index
+            .nodes()
+            .iter()
+            .find_map(|node| {
+                let pc = index.pc(node.id, Phase::Entry).unwrap();
+                parsed
+                    .byte_string_context_site(&handle, &index, &pc)
+                    .unwrap()
+                    .map(|_| pc)
+            })
+            .unwrap();
+        let context =
+            CurrentByteStringContext::capture_current(&mut db, &source, &index, &key, 64 << 20)
+                .unwrap();
+        context.require_current(&db).unwrap();
+        let recipe = parsed
+            .initial_thunk_with_byte_context(&handle, &index, &key, &context)
+            .unwrap();
+        recipe.revalidate_namespace(&db).unwrap();
+        let [
+            Op::ScopeEnter { scope },
+            Op::SetHint {
+                hint: HintRecipe::StaticByteReference(_),
+                ..
+            },
+        ] = recipe.recipe().operations.as_ref()
+        else {
+            panic!(
+                "edition {edition}, PC {key:?}, operations {:?}",
+                recipe.recipe().operations
+            );
+        };
+        assert_eq!(
+            Some(*scope),
+            index.nodes()[key.node as usize].statement_scope
+        );
+        for fuel in [0, 100] {
+            let mut store = GuestStore::new(1, 1000, 1 << 20).unwrap();
+            store.types = TypeRegistry::with_metadata_limit(limit);
+            let mut frame = Frame::new(index.clone(), key.clone(), &mut store).unwrap();
+            let mut ancestors = vec![];
+            let mut ancestor = index.scopes()[scope.0 as usize].parent;
+            while let Some(id) = ancestor {
+                ancestors.push(id);
+                ancestor = index.scopes()[id.0 as usize].parent;
+            }
+            for id in ancestors.into_iter().rev() {
+                frame.enter(id).unwrap();
+            }
+            frame.set_fuel_limit(fuel).unwrap();
+            let before = (
+                store.budget.handles(),
+                store.budget.bytes(),
+                store.owner_inventory_for_test(),
+                store.type_metadata_bytes(),
+            );
+            let error = step(&mut frame, &mut store, &recipe).err().unwrap();
+            // Preflight is per operation. An earlier ScopeEnter is real work;
+            // neither a later metadata refusal nor an empty fuel supply charges
+            // or publishes any part of the SetHint operation.
+            let prefix_completed = u64::from(fuel != 0);
+            assert_eq!(
+                error.code,
+                if fuel == 0 {
+                    "LRR-E-RUNTIME-RESOURCE"
+                } else {
+                    "LRR-E-METADATA-LIMIT"
+                }
+            );
+            assert_eq!(
+                before,
+                (
+                    store.budget.handles(),
+                    store.budget.bytes(),
+                    store.owner_inventory_for_test(),
+                    store.type_metadata_bytes()
+                )
+            );
+            assert_eq!(frame.fuel_snapshot().used, prefix_completed);
+            assert_eq!(frame.counters().operations_started, prefix_completed);
+            assert_eq!(frame.counters().operations_completed, prefix_completed);
+            assert_eq!(frame.counters().started_by_opcode[4], prefix_completed);
+            assert_eq!(frame.active_scopes().contains(scope), fuel != 0);
+            assert!(store.static_literal_index.is_empty());
+        }
+    }
+}
