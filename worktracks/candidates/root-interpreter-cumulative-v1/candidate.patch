+        );
+    }
+    // No hidden helper is substituted for the sole original main.
+    assert!(
+        db.trace.events.iter().all(|event| match &event.key {
+            QueryKey::Thunk(key) => key.body == main,
+            _ => true,
+        }),
+        "edition {edition}: a non-original executable body was entered"
+    );
