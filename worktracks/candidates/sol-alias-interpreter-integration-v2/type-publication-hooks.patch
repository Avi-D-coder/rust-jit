+//! Readonly completed declaration-owner facts, not a caller-supplied owner map.
+use super::*;
+pub(crate) struct TypePreludeRecordOwners<'a> {
+    discovery: &'a SourceDiscovery,
+}
+pub(crate) struct TypePreludeRecordOwner<'a> {
+    source: &'a PreparedSourceView,
+    scope: &'a ScopeKey,
+}
+impl<'a> TypePreludeRecordOwner<'a> {
+    pub(crate) fn source(&self) -> &'a PreparedSourceView {
+        self.source
+    }
+    pub(crate) fn scope(&self) -> &'a ScopeKey {
+        self.scope
+    }
+}
+impl<'a> TypePreludeRecordOwners<'a> {
+    pub(crate) fn owner(
+        &self,
+        record: &crate::expand::record::ExpansionRecord,
+    ) -> Result<Option<TypePreludeRecordOwner<'a>>, Diagnostic> {
+        let id = record.key().fingerprint();
+        let Some(current) = self.discovery.records.get(&id) else {
+            return Ok(None);
+        };
+        if !current.same_record(record) {
+            return Err(fault("Type prelude retained declaration record differs"));
+        }
+        let Some((ordinal, scope)) = self.discovery.generated_owners.get(&id) else {
+            return Ok(None);
+        };
+        let source = self
+            .discovery
+            .sources
+            .get(*ordinal)
+            .ok_or_else(|| fault("Type prelude retained source ordinal absent"))?;
+        if scope.crate_key != source.selection().outline.crate_key
+            || !scope
+                .module_path
+                .starts_with(&source.selection().outline.module_path)
+            || scope.owner.is_some()
+        {
+            return Err(fault("Type prelude actual declaration owner/scope differs"));
+        }
+        Ok(Some(TypePreludeRecordOwner { source, scope }))
+    }
+}
+impl SourceDiscovery {
+    pub(super) fn type_prelude_record_owners(
+        &self,
+    ) -> Result<TypePreludeRecordOwners<'_>, Diagnostic> {
+        let seal = self.seal.as_ref().ok_or_else(|| {
+            fault("Type prelude owner capture requires completed source discovery")
+        })?;
+        if self.namespace != Namespace::Type
+            || seal.key() != self.key
+            || !matches!(
+                &self.key.domain,
+                SealDomain::Scope {
+                    namespace: Namespace::Type,
+                    ..
+                }
+            )
+        {
+            return Err(fault(
+                "Type prelude owner capture requested outside actual Type scope",
+            ));
+        }
+        Ok(TypePreludeRecordOwners { discovery: self })
+    }
+}
