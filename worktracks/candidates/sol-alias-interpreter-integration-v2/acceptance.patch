+//! Live original-source Type/prelude receipt controls. Generated constant models remain prototypes.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    db::key::OutlineKey,
+    expand::source_discovery::{SourceDiscovery, SourceDiscoveryStep},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput},
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParseKey,
+};
+fn current(text: &str, edition: u16) -> (Database, SourceDeclarative, ScopeKey, SealKey) {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let blob = SourceBlob::new(text.as_bytes().to_vec()).unwrap();
+    let cfg = CfgSet::guest_default();
+    let path = SourcePath::new("live-type-prelude.rs").unwrap();
+    let unit = Digest([149; 32]);
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile,
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selection).unwrap() else {
+        panic!()
+    };
+    let mut db = Database::default();
+    inputs.publish(&mut db).unwrap();
+    db.begin_expansion_epoch(1).unwrap();
+    let mut owner = SourceDeclarative::new(view.share()).unwrap();
+    owner.compiler = Some(Arc::new(
+        crate::frontend::compile_input_catalog::CompileInputCatalog::standalone(owner.profile())
+            .unwrap(),
+    ));
+    let scope = view.outline().root_scope.clone();
+    let mut discovery = SourceDiscovery::new(
+        vec![view],
+        scope.clone(),
+        Namespace::Type,
+        Digest::of_bytes(b"live Type prelude world"),
+        1,
+    )
+    .unwrap()
+    .with_declarative_compiler(
+        Digest::of_bytes(b"live Type prelude environment"),
+        crate::expand::source_declarative::engine_version(),
+        owner.compiler.clone().unwrap(),
+    )
+    .unwrap();
+    assert!(matches!(
+        discovery.poll().unwrap(),
+        SourceDiscoveryStep::Sealed(_)
+    ));
+    discovery.publish(&mut db).unwrap();
+    let key = SealKey {
+        domain: SealDomain::Scope {
+            id: scope.fingerprint(),
+            namespace: Namespace::Type,
+        },
+        unit_graph: Digest::of_bytes(b"live Type prelude world"),
+        epoch: 1,
+    };
+    (db, owner, scope, key)
+}
