+                        )
+                        .filter(|n| *n <= maximum)
+                        .ok_or_else(|| fault("prelude containing metadata limit"))?;
+                    let attrs = if let Some(module) = ast::Module::cast(node.clone()) {
+                        Some(module.attrs().filter_map(|a| a.meta()).collect())
+                    } else if let Some(function) = ast::Fn::cast(node.clone()) {
+                        Some(function.attrs().filter_map(|a| a.meta()).collect())
+                    } else if let Some(value) = ast::Const::cast(node.clone()) {
+                        Some(value.attrs().filter_map(|a| a.meta()).collect())
