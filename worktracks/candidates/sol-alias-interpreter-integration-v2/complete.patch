+                    n.checked_add(std::mem::size_of_val(part)).and_then(|n| {
+                        n.checked_add(match part {
+                            crate::syntax::imports::ImportSegment::Name(name) => name.capacity(),
+                            _ => 0,
+                        })
+                    })
+                })
+                .ok_or_else(|| fault("prelude path metadata overflow"))?;
+            bytes = bytes
+                .checked_add(extra)
+                .filter(|n| *n <= maximum)
+                .ok_or_else(|| fault("prelude directive metadata limit"))?;
+            out.try_reserve(1)
+                .map_err(|_| fault("prelude directive allocation"))?;
+            out.push(TypePreludeDirective {
+                source: leaf.clone(),
+                meta,
+                definition,
+                header: item.header.fingerprint(),
+            });
+        }
+        Ok(TypePreludeSites::Captured(out))
+    }
