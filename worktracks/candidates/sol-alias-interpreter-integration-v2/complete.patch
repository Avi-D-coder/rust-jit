+//! Qualified original paths replay actual retained namespaces; missing exports are not primitives.
+use super::*;
+use crate::{frontend::names::NameNamespaces, syntax::imports::ImportSegment};
+use std::{collections::BTreeSet, sync::Arc};
+
+pub(super) struct WrittenPath {
+    pub(super) segments: Vec<ImportSegment>,
+    pub(super) absolute: bool,
+}
+impl WrittenPath {
+    pub(super) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        self.segments.iter().try_fold(
+            std::mem::size_of::<Self>()
+                .checked_add(
+                    self.segments
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<ImportSegment>())
+                        .ok_or_else(limit)?,
+                )
+                .ok_or_else(limit)?,
+            |n, segment| {
+                n.checked_add(match segment {
+                    ImportSegment::Name(name) => name.capacity(),
+                    _ => 0,
+                })
+                .ok_or_else(limit)
+            },
+        )
+    }
+}
+/// Structural original AST classification only. It grants no selected type identity.
+pub(super) fn written_path(
+    parsed: &ParsedFile,
+    header: &crate::syntax::outline::HeaderRecipe,
+    context: &DeclarationContext,
+    max: usize,
+) -> Result<Option<WrittenPath>, Diagnostic> {
+    if header.profile != parsed.profile || max > MAX_BYTES {
+        return Err(fault("qualified alias original profile/budget differs"));
+    }
+    let transient = header
+        .estimated_bytes()
+        .checked_mul(4)
+        .filter(|n| *n <= max)
+        .ok_or_else(limit)?;
+    let alias = parsed
+        .parsed
+        .tree()
+        .syntax()
+        .descendants()
+        .filter_map(ast::TypeAlias::cast)
+        .find(|a| {
+            crate::syntax::ast_adapter::range(a.syntax().text_range()) == context.range
+                && crate::syntax::ast_adapter::tokens(a.syntax(), None) == header.tokens
+        })
+        .ok_or_else(|| fault("qualified alias exact original AST header absent"))?;
+    let Some(ast::Type::PathType(ty)) = alias.ty() else {
+        return Ok(None);
+    };
+    let Some(mut path) = ty.path() else {
+        return Ok(None);
+    };
+    let mut segments = Vec::new();
+    let mut bytes = transient
+        .checked_add(std::mem::size_of::<WrittenPath>())
+        .ok_or_else(limit)?;
+    let absolute;
+    loop {
+        if segments.len() >= MAX_STEPS {
+            return Err(limit());
+        }
+        let Some(segment) = path.segment() else {
+            return Ok(None);
+        };
+        if segment.generic_arg_list().is_some() {
+            return Ok(None);
+        }
+        let Some(kind) = segment.kind() else {
+            return Ok(None);
+        };
+        charge(
+            &mut bytes,
+            std::mem::size_of::<ImportSegment>()
+                .checked_add(
+                    usize::try_from(u32::from(segment.syntax().text_range().len()))
+                        .map_err(|_| limit())?,
+                )
+                .ok_or_else(limit)?,
+            max,
+        )?;
+        let owned = match kind {
+            ast::PathSegmentKind::Name(name) => {
+                let text = name.text().to_string();
+                crate::expand::scopes::MacroName::parse(&text, header.profile.edition)?;
+                ImportSegment::Name(text)
+            }
+            ast::PathSegmentKind::CrateKw => ImportSegment::Crate,
+            ast::PathSegmentKind::SelfKw => ImportSegment::SelfModule,
+            ast::PathSegmentKind::SuperKw => ImportSegment::Super,
+            _ => return Ok(None),
+        };
+        segments
+            .try_reserve_exact(1)
+            .map_err(|_| crate::runtime::arena::resource())?;
+        segments.push(owned);
+        if let Some(parent) = path.qualifier() {
+            path = parent
+        } else {
+            absolute = segment.coloncolon_token().is_some();
+            break;
+        }
+    }
+    segments.reverse();
+    Ok((absolute || segments.len() > 1).then_some(WrittenPath { segments, absolute }))
+}
+
+/// No caller graph, completeness flag, catalogue default or selected member enters here.
+/// The graph and routes are replayed from actual admitted original sources.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn lookup(
+    db: &Database,
+    owner: &SourceDeclarative,
+    scope: &ScopeKey,
+    key: &SealKey,
+    path: &WrittenPath,
+    owners: &[&SourceDeclarative],
+    capture: &mut Capture,
+) -> Result<Option<NameLookup>, Diagnostic> {
+    let Some(input) = capture.scope(db, owner, scope, key)? else {
+        return Ok(None);
+    };
+    if !input.records.is_empty()
+        || !input.procedural_catalogs.is_empty()
+        || !input.helper_declarations.is_empty()
+        || !input.argument_summaries.is_empty()
+        || !input.argument_indexes.is_empty()
+        || !input.argument_fragments.is_empty()
+        || !input.source_replacements.is_empty()
+        || !input.declaration_fragments.is_empty()
+    {
+        // Original replay cannot certify completed generated/native/replacement routes.
+        return Ok(None);
+    }
+    let mut sources: Vec<&crate::source::changes::PreparedSourceView> = Vec::new();
+    let mut seen = BTreeSet::new();
+    charge(
+        &mut capture.bytes,
+        owners
+            .len()
+            .checked_add(1)
+            .and_then(|n| {
+                n.checked_mul(
+                    std::mem::size_of::<&crate::source::changes::PreparedSourceView>() + 128,
+                )
+            })
+            .ok_or_else(limit)?,
+        capture.max,
+    )?;
+    for provider in std::iter::once(owner).chain(owners.iter().copied()) {
+        let view = provider.module_source();
+        view.require_original_hygiene()?;
+        view.require_declaration_syntax()?;
+        if let Some(old) = sources
+            .iter()
+            .copied()
+            .find(|old| old.selection().location_identity() == view.selection().location_identity())
+        {
+            if !old.same_publication(view) {
+                return Err(fault(
+                    "qualified alias original source publication ambiguous",
+                ));
+            }
+            continue;
+        }
+        if !input.sources.contains(view.selection()) {
+            return Err(fault(
+                "qualified alias owner absent from actual Type universe",
+            ));
+        }
+        if !seen.insert(view.selection().location_identity()) {
+            return Err(fault("qualified alias source location repeats"));
+        }
+        for (k, v) in view.prepared_inputs() {
+            if db
+                .published_input(k)
+                .is_none_or(|(_, a)| a != v.fingerprint())
+            {
+                return Err(fault("qualified alias original prepared facts changed"));
+            }
+            capture.stamp(db, k.clone())?;
+        }
+        charge(
+            &mut capture.bytes,
+            view.outline()
+                .estimated_bytes()
+                .checked_mul(16)
+                .and_then(|n| n.checked_add(view.prepared_metadata_bytes().ok()?.checked_mul(2)?))
+                .and_then(|n| {
+                    n.checked_add(
+                        view.captured_macro_blob()
+                            .ok()?
+                            .bytes()
+                            .len()
+                            .checked_mul(128)?,
+                    )
+                })
+                .and_then(|n| {
+                    n.checked_add(
+                        view.source_dependencies()
+                            .ok()?
+                            .metadata_bytes()
+                            .ok()?
+                            .checked_mul(2)?,
+                    )
+                })
+                .ok_or_else(limit)?,
+            capture.max,
+        )?;
+        sources
+            .try_reserve_exact(1)
+            .map_err(|_| crate::runtime::arena::resource())?;
+        sources.push(view);
+    }
+    if input.sources.len() != sources.len()
+        || input
+            .sources
+            .iter()
+            .any(|s| !sources.iter().any(|v| v.selection() == s))
+    {
+        return Err(fault(
+            "qualified alias complete Type source set is not retained",
+        ));
+    }
+    charge(
+        &mut capture.bytes,
+        sources
+            .len()
+            .checked_mul(std::mem::size_of::<SourceDeclarative>())
+            .ok_or_else(limit)?,
+        capture.max,
+    )?;
+    let mut providers = Vec::new();
+    providers
+        .try_reserve_exact(sources.len())
+        .map_err(|_| crate::runtime::arena::resource())?;
+    for view in &sources {
+        let mut provider = SourceDeclarative::new(view.share())?;
+        let catalogs = std::iter::once(owner)
+            .chain(owners.iter().copied())
+            .filter(|p| {
+                p.module_source().same_publication(view)
+                    && p.module_source().selection() == view.selection()
+            })
+            .filter_map(|p| p.compiler.as_ref());
+        for catalog in catalogs {
+            // Receipt replay constructs a bounded canonical catalogue internally.
+            charge(&mut capture.bytes, 64 * 1024, capture.max)?;
+            input.validate_compiler_primitive_receipts()?;
+            let Some(receipt) = input.compiler_primitive_receipt(view.selection())? else {
+                return Ok(None);
+            };
+            if !receipt.matches(view.selection(), catalog)? {
+                return Err(fault("qualified alias current compiler receipt differs"));
+            }
+            charge(
+                &mut capture.bytes,
+                catalog
+                    .owning_profile_metadata_bytes()?
+                    .checked_mul(2)
+                    .ok_or_else(limit)?,
+                capture.max,
+            )?;
+            provider.compiler = Some(Arc::clone(catalog));
+        }
+        providers.push(provider);
+    }
+    SourceDeclarative::configure_captured_modules(&mut providers)?;
+    let outlines = sources.iter().map(|v| v.outline()).collect::<Vec<_>>();
+    let mut graph = NameNamespaces::from_outlines(&outlines)?;
+    for provider in &providers {
+        if let Some(catalog) = &provider.compiler {
+            catalog.install_ordinary_module_facets(&mut graph)?;
+            graph.install_compiler_injection(catalog, provider.module_source())?;
+        }
+        for route in provider.routes_in(&providers)? {
+            charge(&mut capture.bytes, route.metadata_bytes()?, capture.max)?;
+            for (unit, names) in &route.modules {
+                if names.is_empty() {
+                    graph.declare_module(
+                        *unit,
+                        &[],
+                        route.edition,
+                        crate::syntax::visibility::VisibilityScope::Public,
+                    )?;
+                }
+            }
+            if let Some((consumer, _)) = route.modules.iter().find(|(_, names)| names.is_empty()) {
+                for (alias, unit) in &route.dependencies {
+                    graph.compiler_dependency(*consumer, alias.clone(), *unit)?;
+                }
+            }
+            for disabled in &route.implicit_disabled {
+                graph.disable_compiler_prelude(disabled.clone())?;
+            }
+            for row in &route.extern_aliases {
+                graph.extern_alias(row, route.edition)?;
+            }
+        }
+    }
+    let _ = graph.resolve_imports()?;
+    let replay = graph.certified_scope(scope, Namespace::Type, owner.profile().edition)?;
+    if replay.fingerprint()
+        != input
+            .scope
+            .as_ref()
+            .ok_or_else(|| fault("qualified alias Type scope absent"))?
+            .fingerprint()
+    {
+        return Err(fault(
+            "qualified alias original namespace replay differs from current Type seal",
+        ));
+    }
+    Ok(Some(graph.lookup_source_path(
+        Namespace::Type,
+        &path.segments,
+        path.absolute,
+        scope,
+        owner.profile().edition,
+    )?))
+}
