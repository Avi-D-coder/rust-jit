+//! Opaque Type-prelude source preparation and readonly current absence.
+//! Selection never evaluates a type/constant/body or performs discovery/provider work.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{InputKey, InputValue},
+        key::BucketKey,
+        memo::Database,
+        seals::{DiscoveryInput, SealDomain, SealKey},
+    },
+    expand::{
+        generated_items::GeneratedItems,
+        identity::{GrammarSlot, MacroIdentity},
+        nested_inert::NestedInertProof,
+        record::ExpansionRecord,
+        source_declarative::SourceDeclarative,
+    },
+    frontend::{
+        macro_names::ModuleLookup,
+        names::{NameLookup, NameNamespaces},
+    },
+    source::{
+        changes::{SourceSelection, crate_policy::PreparedCratePreludePolicy},
+        manifest::Namespace,
+    },
+    syntax::{
+        outline::{ProducerKind, ScopeKey, TextualEventKind},
+        parse::ParsedFile,
+        spans::SourceRange,
+        type_prelude_sites::{TypePreludeDirective, TypePreludeSites},
+        visibility::VisibilityScope,
+    },
+};
+use std::{collections::BTreeMap, sync::Arc};
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+const MAX_ROWS: usize = 100_000;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TYPE-PRELUDE-SOURCE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new("LRR-E-METADATA-LIMIT", "Type prelude source budget".into())
+}
+fn charge(bytes: &mut usize, n: usize, maximum: usize) -> Result<(), Diagnostic> {
+    *bytes = bytes
+        .checked_add(n)
+        .filter(|n| *n <= maximum)
+        .ok_or_else(limit)?;
+    Ok(())
+}
+#[derive(Debug, Clone)]
+pub(crate) enum TypePreludePrerequisite {
+    RetainedSource(Digest),
+    DeclarationProducer(Digest),
+    LocalDirective(SourceRange),
+    NonGlobDirective(SourceRange),
+    GeneratedDirective(Digest),
+    GeneratedLineage(Digest),
+    ReplacementOrForeignWorld,
+    MultipleDirectives,
+    AttributeFacet(Digest),
+    Module(ModuleLookup),
+    CompilerFacet,
+    TargetTypeNamespace(ScopeKey),
+    Member(NameLookup),
+    DefaultExportSpelling,
+}
+impl PartialEq for TypePreludePrerequisite {
+    fn eq(&self, other: &Self) -> bool {
+        let mut a = StableEncoder::new("lrr/v1/type-prelude-prerequisite");
+        let mut b = StableEncoder::new("lrr/v1/type-prelude-prerequisite");
+        encode_need(self, &mut a);
+        encode_need(other, &mut b);
+        a.finish() == b.finish()
+    }
+}
+impl Eq for TypePreludePrerequisite {}
+#[derive(Debug, Clone)]
+enum PreparedMode {
+    Disabled,
+    Default {
+        standard: bool,
+        facet: Digest,
+    },
+    Custom {
+        directive: TypePreludeDirective,
+        module: ScopeKey,
+        source: SourceSelection,
+        attribute: Digest,
+        visibility: VisibilityScope,
+    },
+    Need(TypePreludePrerequisite),
+}
+/// Only actual completed source preparation can mint this; published scope
+/// membership/current source stamps supply currentness, not these fields alone.
+#[derive(Debug, Clone)]
+pub(crate) struct TypePreludeReceipt {
+    source: SourceSelection,
+    scope: ScopeKey,
+    policy: Digest,
+    catalog: Option<Digest>,
+    sources: Vec<SourceSelection>,
+    records: Vec<Digest>,
+    mode: PreparedMode,
+    bytes: usize,
+}
+fn original_provider<'a>(
+    selection: &SourceSelection,
+    providers: &'a [SourceDeclarative],
+) -> Result<Option<&'a SourceDeclarative>, Diagnostic> {
+    let mut selected: Option<&SourceDeclarative> = None;
+    for provider in providers {
+        if provider.module_source().selection() == selection {
+            if let Some(old) = selected {
+                if !old
+                    .module_source()
+                    .same_publication(provider.module_source())
+                {
+                    return Err(fault("Type prelude actual source publication ambiguous"));
+                }
+            }
+            selected = Some(provider);
+        }
+    }
+    Ok(selected)
+}
+#[allow(clippy::too_many_arguments)]
+fn prepare_one(
+    owner: &SourceDeclarative,
+    providers: &[SourceDeclarative],
+    published_sources: &[SourceSelection],
+    graph: &NameNamespaces,
+    scope: &ScopeKey,
+    records: &[Arc<ExpansionRecord>],
+    owners: &crate::expand::source_discovery::type_prelude::TypePreludeRecordOwners<'_>,
+    inert: &BTreeMap<Digest, NestedInertProof>,
+    epoch: u64,
+    maximum: usize,
+) -> Result<TypePreludeReceipt, Diagnostic> {
+    let source = owner.module_source();
+    let mut bytes = std::mem::size_of::<TypePreludeReceipt>();
+    charge(
+        &mut bytes,
+        source
+            .selection()
+            .metadata_bytes()?
+            .checked_add(scope.heap_bytes())
+            .ok_or_else(limit)?,
+        maximum,
+    )?;
+    let policy = PreparedCratePreludePolicy::capture_current(
+        source,
+        epoch,
+        maximum
+            .checked_sub(bytes)
+            .ok_or_else(limit)?
+            .checked_div(2)
+            .ok_or_else(limit)?,
+    )?;
+    charge(
+        &mut bytes,
+        policy.metadata_bytes().checked_mul(2).ok_or_else(limit)?,
+        maximum,
+    )?;
+    for ancestor in policy.source_selections() {
+        if !published_sources.contains(ancestor) {
+            return Err(fault(
+                "Type prelude owning policy ancestor absent from actual publication",
+            ));
+        }
+    }
+    let actual = policy.policy();
+    let suffix = scope
+        .module_path
+        .strip_prefix(source.selection().outline.module_path.as_slice())
+        .ok_or_else(|| fault("Type prelude policy scope differs"))?;
+    let mut out = TypePreludeReceipt {
+        source: source.selection().clone(),
+        scope: scope.clone(),
+        policy: policy.identity(),
+        catalog: None,
+        sources: Vec::new(),
+        records: Vec::new(),
+        mode: PreparedMode::Need(TypePreludePrerequisite::CompilerFacet),
+        bytes,
+    };
+    if actual
+        .disabled
+        .iter()
+        .any(|prefix| suffix.starts_with(prefix))
+    {
+        out.mode = PreparedMode::Disabled;
+        return Ok(out);
+    }
+    let Some(compiler) = &owner.compiler else {
+        return Ok(out);
+    };
+    charge(
+        &mut out.bytes,
+        compiler
+            .owning_profile_metadata_bytes()?
+            .checked_mul(2)
+            .ok_or_else(limit)?,
+        maximum,
+    )?;
+    let Some(facet) = compiler.type_prelude_facet(&source.outline().profile)? else {
+        return Ok(out);
+    };
+    out.catalog = Some(compiler.owning_profile_identity()?);
+    // The actual publication source set determines membership. Providers are
+    // retained evidence and cannot assert that a source or producer is absent.
+    let owning_count = published_sources
+        .iter()
+        .filter(|selected| selected.outline.crate_key == scope.crate_key)
+        .count();
+    if owning_count > MAX_ROWS || records.len() > MAX_ROWS || inert.len() > MAX_ROWS {
+        return Err(limit());
+    }
+    charge(
+        &mut out.bytes,
+        owning_count
+            .checked_mul(std::mem::size_of::<SourceSelection>())
+            .ok_or_else(limit)?,
+        maximum,
+    )?;
+    out.sources
+        .try_reserve_exact(owning_count)
+        .map_err(|_| limit())?;
+    let mut chosen: Option<(TypePreludeDirective, SourceSelection, Digest)> = None;
+    for selected in published_sources
+        .iter()
+        .filter(|selected| selected.outline.crate_key == scope.crate_key)
+    {
+        let Some(provider) = original_provider(selected, providers)? else {
+            out.mode = PreparedMode::Need(TypePreludePrerequisite::RetainedSource(
+                selected.location_identity(),
+            ));
+            return Ok(out);
+        };
+        let view = provider.module_source();
+        view.require_original_hygiene()?;
+        if selected.outline.parse.profile != source.outline().profile
+            || selected.outline.cfg != source.selection().outline.cfg
+        {
+            return Err(fault(
+                "owning crate Type prelude source profile/cfg differs",
+            ));
+        }
+        charge(&mut out.bytes, selected.metadata_bytes()?, maximum)?;
+        out.sources.push(selected.clone());
+        // Missing external module source is a declaration prerequisite, even
+        // when it does not occur in the requested primitive's module.
+        for event in &view.outline().textual_events {
+            if let TextualEventKind::Producer {
+                identity,
+                kind: ProducerKind::ModuleSource,
+            } = &event.kind
+            {
+                if !published_sources.iter().any(|s| {
+                    s.outline.crate_key == scope.crate_key
+                        && s.outline.module_path == event.scope.module_path
+                }) {
+                    out.mode =
+                        PreparedMode::Need(TypePreludePrerequisite::DeclarationProducer(*identity));
+                    return Ok(out);
+                }
+            }
+        }
+        for call in &view.outline().item_invocations {
+            if !records
+                .iter()
+                .any(|record| record.key().invocation == call.item_input)
+            {
+                out.mode = PreparedMode::Need(TypePreludePrerequisite::DeclarationProducer(
+                    call.item_input,
+                ));
+                return Ok(out);
+            }
+        }
+        let transient = view
+            .captured_macro_blob()?
+            .bytes()
+            .len()
+            .checked_mul(128)
+            .and_then(|n| n.checked_add(view.outline().estimated_bytes()))
+            .ok_or_else(limit)?;
+        if transient > maximum.checked_sub(out.bytes).ok_or_else(limit)? {
+            return Err(limit());
+        };
+        let parsed =
+            ParsedFile::parse(view.captured_macro_blob()?, view.outline().profile.clone())?;
+        // Source is already captured; pure owned parsing is bounded structural
+        // replay, never a live toolchain/library or guest preparation fallback.
+        let directives = match parsed.type_prelude_sites(
+            view.outline(),
+            view.captured_macro_cfg()?,
+            maximum.checked_sub(out.bytes).ok_or_else(limit)?,
+        )? {
+            TypePreludeSites::Captured(sites) => sites,
+            TypePreludeSites::NeedLocal(range) => {
+                out.mode = PreparedMode::Need(TypePreludePrerequisite::LocalDirective(range));
+                return Ok(out);
+            }
+            TypePreludeSites::NeedNonGlob(range) => {
+                out.mode = PreparedMode::Need(TypePreludePrerequisite::NonGlobDirective(range));
+                return Ok(out);
+            }
+        };
+        for directive in directives {
+            charge(&mut out.bytes, directive.metadata_bytes()?, maximum)?;
+            let proof = inert.values().find(|proof| {
+                proof.attribute_facet().is_some()
+                    && proof.scan().parse() == &selected.outline.parse
+                    && proof.scan().path() == &selected.path
+                    && proof.scan().cfg() == selected.outline.cfg
+                    && proof.name().is_ok_and(|name| name == "prelude_import")
+                    && proof.scan().producers().iter().any(|row| {
+                        row.identity == proof.producer() && row.range == directive.meta()
+                    })
+            });
+            let Some(proof) = proof else {
+                out.mode = PreparedMode::Need(TypePreludePrerequisite::AttributeFacet(
+                    directive.identity(),
+                ));
+                return Ok(out);
+            };
+            proof.revalidate(view.captured_macro_blob()?, view.captured_macro_cfg()?)?;
+            if chosen.is_some() {
+                out.mode = PreparedMode::Need(TypePreludePrerequisite::MultipleDirectives);
+                return Ok(out);
+            };
+            charge(&mut out.bytes, selected.metadata_bytes()?, maximum)?;
+            chosen = Some((directive, selected.clone(), proof.fingerprint()));
+        }
+    }
+    // Inspect only actual retained declaration outputs. Generated custom/local
+    // routes lacking semantic hygiene producers stay precise prerequisites.
+    for record in records {
+        if record.token_count() == 0 {
+            continue;
+        };
+        let Some(caller) = owners.owner(record)? else {
+            out.mode = PreparedMode::Need(TypePreludePrerequisite::GeneratedLineage(
+                record.key().fingerprint(),
+            ));
+            return Ok(out);
+        };
+        if caller.source().selection().outline.crate_key != scope.crate_key {
+            continue;
+        };
+        if record.key().grammar != GrammarSlot::Items
+            || matches!(
+                &record.key().macro_identity,
+                MacroIdentity::Procedural { .. }
+            )
+        {
+            out.mode = PreparedMode::Need(TypePreludePrerequisite::GeneratedLineage(
+                record.key().fingerprint(),
+            ));
+            return Ok(out);
+        };
+        let cost = record
+            .estimated_bytes()?
+            .checked_mul(128)
+            .filter(|n| *n <= maximum.checked_sub(out.bytes).unwrap_or(0))
+            .ok_or_else(limit)?;
+        let items = GeneratedItems::admit(record.key(), record.clone(), epoch)?;
+        let parsed = ParsedFile::from_generated_items(&items)?;
+        let generated = parsed.outline(
+            caller.scope().crate_key,
+            caller.scope().module_path.clone(),
+            caller.source().captured_macro_cfg()?,
+        )?;
+        match parsed.type_prelude_sites(&generated, caller.source().captured_macro_cfg()?, cost)? {
+            TypePreludeSites::Captured(sites) if sites.is_empty() => {}
+            _ => {
+                out.mode = PreparedMode::Need(TypePreludePrerequisite::GeneratedDirective(
+                    record.key().fingerprint(),
+                ));
+                return Ok(out);
+            }
+        }
+        // Completed SourceDiscovery supplies the actual retained nested records
+        // and its private owner join. Reconstructed outline call IDs are not
+        // interchangeable with generated-catalogue invocation identities.
+        charge(&mut out.bytes, std::mem::size_of::<Digest>(), maximum)?;
+        out.records.try_reserve(1).map_err(|_| limit())?;
+        out.records.push(record.descriptor().fingerprint());
+    }
+    out.mode = if let Some((directive, selected, attribute)) = chosen {
+        if 256usize.checked_mul(65_536).ok_or_else(limit)?
+            > maximum.checked_sub(out.bytes).ok_or_else(limit)?
+        {
+            return Err(limit());
+        };
+        match graph
+            .lookup_import_module(directive.import(), selected.outline.parse.profile.edition)?
+        {
+            ModuleLookup::Defined {
+                unit,
+                components,
+                visibility,
+            } => {
+                let path_bytes = components
+                    .iter()
+                    .try_fold(0usize, |n, c| {
+                        n.checked_add(c.as_str().len())
+                            .and_then(|n| n.checked_add(std::mem::size_of::<String>()))
+                    })
+                    .ok_or_else(limit)?;
+                charge(&mut out.bytes, path_bytes, maximum)?;
+                let module = ScopeKey {
+                    crate_key: unit,
+                    module_path: components.iter().map(|c| c.as_str().to_owned()).collect(),
+                    owner: None,
+                };
+                charge(&mut out.bytes, module.heap_bytes(), maximum)?;
+                PreparedMode::Custom {
+                    directive,
+                    module,
+                    source: selected,
+                    attribute,
+                    visibility,
+                }
+            }
+            other => PreparedMode::Need(TypePreludePrerequisite::Module(other)),
+        }
+    } else {
+        PreparedMode::Default {
+            standard: actual.standard,
+            facet: facet.identity(),
+        }
+    };
+    Ok(out)
+}
+/// Called only by actual completed Type SourceDiscovery publication.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn prepare_type_prelude_receipts(
+    providers: &[SourceDeclarative],
+    sources: &[SourceSelection],
+    graph: &NameNamespaces,
+    scope: &ScopeKey,
+    records: &[Arc<ExpansionRecord>],
+    owners: &crate::expand::source_discovery::type_prelude::TypePreludeRecordOwners<'_>,
+    inert: &BTreeMap<Digest, NestedInertProof>,
+    epoch: u64,
+    maximum: usize,
+) -> Result<Vec<TypePreludeReceipt>, Diagnostic> {
+    if providers.len() > MAX_ROWS
+        || sources.len() > MAX_ROWS
+        || scope.owner.is_some()
+        || maximum > MAX_BYTES
+        || epoch == 0
+    {
+        return Err(limit());
+    }
+    let mut bytes = providers
+        .len()
+        .checked_mul(std::mem::size_of::<TypePreludeReceipt>())
+        .filter(|n| *n <= maximum)
+        .ok_or_else(limit)?;
+    let mut out = Vec::new();
+    out.try_reserve_exact(providers.len())
+        .map_err(|_| limit())?;
+    for owner in providers.iter().filter(|p| {
+        p.module_source().selection().outline.crate_key == scope.crate_key
+            && scope
+                .module_path
+                .starts_with(&p.module_source().selection().outline.module_path)
+    }) {
+        let receipt = prepare_one(
+            owner,
+            providers,
+            sources,
+            graph,
+            scope,
+            records,
+            owners,
+            inert,
+            epoch,
+            maximum.checked_sub(bytes).ok_or_else(limit)?,
+        )?;
+        charge(&mut bytes, receipt.metadata_bytes(), maximum)?;
+        out.push(receipt);
+    }
+    out.sort_by_key(|r| r.source.location_identity());
+    if out
+        .windows(2)
+        .any(|r| r[0].source.location_identity() == r[1].source.location_identity())
+    {
+        return Err(fault("Type prelude receipt source duplicated"));
+    }
+    Ok(out)
+}
+impl TypePreludeReceipt {
+    pub(crate) fn source(&self) -> &SourceSelection {
+        &self.source
+    }
+    pub(crate) fn scope(&self) -> &ScopeKey {
+        &self.scope
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.fingerprint()
+    }
+}
+impl StableEncode for TypePreludeReceipt {
+    const DOMAIN: &'static str = "lrr/v1/prepared-source-type-prelude-receipt";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.string(self.source.path.as_str());
+        e.record(&self.source.outline);
+        e.record(&self.scope);
+        e.digest(self.policy);
+        e.option(&self.catalog, |e, id| e.digest(*id));
+        e.sequence(&self.sources, |e, s| {
+            e.string(s.path.as_str());
+            e.record(&s.outline)
+        });
+        e.sequence(&self.records, |e, id| e.digest(*id));
+        match &self.mode {
+            PreparedMode::Disabled => e.u8(0),
+            PreparedMode::Default { standard, facet } => {
+                e.u8(1);
+                e.bool(*standard);
+                e.digest(*facet)
+            }
+            PreparedMode::Custom {
+                directive,
+                module,
+                source,
+                attribute,
+                visibility,
+            } => {
+                e.u8(2);
+                e.record(directive);
+                e.record(module);
+                e.string(source.path.as_str());
+                e.record(&source.outline);
+                e.digest(*attribute);
+                e.record(visibility)
+            }
+            PreparedMode::Need(need) => {
+                e.u8(3);
+                encode_need(need, e)
+            }
+        }
+    }
+}
+fn encode_need(need: &TypePreludePrerequisite, e: &mut StableEncoder) {
+    match need {
+        TypePreludePrerequisite::RetainedSource(id) => {
+            e.u8(0);
+            e.digest(*id)
+        }
+        TypePreludePrerequisite::DeclarationProducer(id) => {
+            e.u8(1);
+            e.digest(*id)
+        }
+        TypePreludePrerequisite::LocalDirective(r) => {
+            e.u8(2);
+            e.u32(r.start);
+            e.u32(r.end)
+        }
+        TypePreludePrerequisite::NonGlobDirective(r) => {
+            e.u8(3);
+            e.u32(r.start);
+            e.u32(r.end)
+        }
+        TypePreludePrerequisite::GeneratedDirective(id) => {
+            e.u8(4);
+            e.digest(*id)
+        }
+        TypePreludePrerequisite::GeneratedLineage(id) => {
+            e.u8(5);
+            e.digest(*id)
+        }
+        TypePreludePrerequisite::ReplacementOrForeignWorld => e.u8(6),
+        TypePreludePrerequisite::MultipleDirectives => e.u8(7),
+        TypePreludePrerequisite::AttributeFacet(id) => {
+            e.u8(8);
+            e.digest(*id)
+        }
+        TypePreludePrerequisite::Module(found) => {
+            e.u8(9);
+            match found {
+                ModuleLookup::Defined {
+                    unit,
+                    components,
+                    visibility,
+                } => {
+                    e.u8(0);
+                    e.digest(*unit);
+                    e.sequence(components, |e, n| e.string(n.as_str()));
+                    e.record(visibility)
+                }
+                ModuleLookup::Absent => e.u8(1),
+                ModuleLookup::Ambiguous(paths) => {
+                    e.u8(2);
+                    e.sequence(paths, |e, (unit, path)| {
+                        e.digest(*unit);
+                        e.sequence(path, |e, n| e.string(n.as_str()))
+                    })
+                }
+                ModuleLookup::Inaccessible { unit, components } => {
+                    e.u8(3);
+                    e.digest(*unit);
+                    e.sequence(components, |e, n| e.string(n.as_str()))
+                }
+            }
+        }
+        TypePreludePrerequisite::CompilerFacet => e.u8(10),
+        TypePreludePrerequisite::TargetTypeNamespace(scope) => {
+            e.u8(11);
+            e.record(scope)
+        }
+        TypePreludePrerequisite::Member(name) => {
+            e.u8(12);
+            e.record(name)
+        }
+        TypePreludePrerequisite::DefaultExportSpelling => e.u8(13),
+    }
+}
+
+pub(crate) enum TypePreludeAbsenceOutcome {
+    Absent(CurrentTypePreludeAbsence),
+    Need(TypePreludePrerequisite),
+}
+/// Private exact name/scope/current-world absence. No type or descriptor is minted.
+pub(crate) struct CurrentTypePreludeAbsence {
+    receipt: Digest,
+    name: Digest,
+    stamps: BTreeMap<InputKey, Digest>,
+    revision: u64,
+    bytes: usize,
+}
+fn stamp(
+    db: &Database,
+    key: &InputKey,
+    out: &mut BTreeMap<InputKey, Digest>,
+    bytes: &mut usize,
+    maximum: usize,
+) -> Result<(), Diagnostic> {
+    let (_, value) = db
+        .published_input(key)
+        .ok_or_else(|| fault("Type prelude current input absent"))?;
+    if let Some(old) = out.get(key) {
+        return if *old == value {
+            Ok(())
+        } else {
+            Err(fault("Type prelude current input changed"))
+        };
+    };
+    if out.len() >= MAX_ROWS {
+        return Err(limit());
+    };
+    charge(
+        bytes,
+        std::mem::size_of::<(InputKey, Digest)>()
+            .checked_add(128)
+            .and_then(|n| n.checked_add(key.heap_bytes()))
+            .ok_or_else(limit)?,
+        maximum,
+    )?;
+    out.insert(key.clone(), value);
+    Ok(())
+}
+fn current_scope<'a>(
+    db: &'a Database,
+    key: &SealKey,
+    scope: &ScopeKey,
+    source_graph: Digest,
+    stamps: &mut BTreeMap<InputKey, Digest>,
+    bytes: &mut usize,
+    maximum: usize,
+) -> Result<Option<&'a DiscoveryInput>, Diagnostic> {
+    let Some((InputValue::DiscoverySeal(input), _)) =
+        db.published_input(&InputKey::DiscoverySeal(key.clone()))
+    else {
+        return Ok(None);
+    };
+    let certified = input
+        .scope
+        .as_ref()
+        .ok_or_else(|| fault("Type prelude selected certified scope absent"))?;
+    if input.seal.key() != *key
+        || certified.scope != *scope
+        || certified.namespace != Namespace::Type
+        || input.seal.unresolved_frontiers() != 0
+        || input.source_dependencies != source_graph
+        || !matches!(db.published_input(&InputKey::ExpansionEpoch),Some((InputValue::ExpansionEpoch(epoch),_))if *epoch==key.epoch)
+        || !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(graph),_))if graph.fingerprint()==input.source_dependencies)
+    {
+        return Err(fault(
+            "Type prelude actual Type world/epoch/source graph differs",
+        ));
+    }
+    input.validate_type_prelude_receipts()?;
+    if input.compiler_inputs.len() > MAX_ROWS || input.records.len() > MAX_ROWS {
+        return Err(limit());
+    };
+    for (key, expected) in &input.compiler_inputs {
+        if db
+            .published_input(key)
+            .is_none_or(|(_, value)| value != *expected)
+        {
+            return Err(fault("Type prelude compiler publication changed"));
+        }
+        stamp(db, key, stamps, bytes, maximum)?
+    }
+    for descriptor in &input.records {
+        let key = InputKey::ExpansionRecord(descriptor.key.fingerprint());
+        if !matches!(db.published_input(&key),Some((InputValue::ExpansionRecord(record),_))if record.descriptor().fingerprint()==descriptor.fingerprint())
+        {
+            return Err(fault("Type prelude actual expansion record changed"));
+        }
+        stamp(db, &key, stamps, bytes, maximum)?
+    }
+    stamp(
+        db,
+        &InputKey::DiscoverySeal(key.clone()),
+        stamps,
+        bytes,
+        maximum,
+    )?;
+    stamp(db, &InputKey::SourceDependencies, stamps, bytes, maximum)?;
+    stamp(db, &InputKey::ExpansionEpoch, stamps, bytes, maximum)?;
+    Ok(Some(input))
+}
+impl CurrentTypePreludeAbsence {
+    pub(crate) fn capture_current(
+        db: &Database,
+        owner: &SourceDeclarative,
+        scope: &ScopeKey,
+        key: &SealKey,
+        name: &str,
+        maximum: usize,
+    ) -> Result<TypePreludeAbsenceOutcome, Diagnostic> {
+        db.require_coordinator()?;
+        if maximum > MAX_BYTES || name.len() > 64 * 1024 || scope.owner.is_some() {
+            return Err(limit());
+        };
+        let source = owner.module_source();
+        source.require_original_hygiene()?;
+        let mut bytes = std::mem::size_of::<Self>();
+        let mut stamps = BTreeMap::new();
+        let graph = match db.published_input(&InputKey::SourceDependencies) {
+            Some((InputValue::SourceDependencies(graph), _)) => graph.fingerprint(),
+            _ => return Err(fault("Type prelude actual source graph absent")),
+        };
+        let Some(input) = current_scope(db, key, scope, graph, &mut stamps, &mut bytes, maximum)?
+        else {
+            return Ok(TypePreludeAbsenceOutcome::Need(
+                TypePreludePrerequisite::TargetTypeNamespace(scope.clone()),
+            ));
+        };
+        charge(
+            &mut bytes,
+            scope
+                .heap_bytes()
+                .checked_add(name.len())
+                .ok_or_else(limit)?,
+            maximum,
+        )?;
+        let own = input
+            .scope
+            .as_ref()
+            .ok_or_else(|| fault("Type prelude own scope absent"))?
+            .lookup(&BucketKey {
+                scope: scope.clone(),
+                namespace: Namespace::Type,
+                name: name.into(),
+            })?;
+        if own != NameLookup::Absent {
+            return Ok(TypePreludeAbsenceOutcome::Need(
+                TypePreludePrerequisite::Member(own),
+            ));
+        };
+        let Some(receipt) = input.type_prelude_receipt(source.selection(), scope)? else {
+            return Ok(TypePreludeAbsenceOutcome::Need(
+                TypePreludePrerequisite::CompilerFacet,
+            ));
+        };
+        charge(&mut bytes, receipt.metadata_bytes(), maximum)?;
+        if !input.sources.contains(source.selection())
+            || input
+                .scope
+                .as_ref()
+                .is_none_or(|s| s.edition != source.outline().profile.edition)
+        {
+            return Err(fault("Type prelude owning source/profile differs"));
+        };
+        if !input.source_replacements.is_empty() || !input.procedural_catalogs.is_empty() {
+            return Ok(TypePreludeAbsenceOutcome::Need(
+                TypePreludePrerequisite::ReplacementOrForeignWorld,
+            ));
+        };
+        for selected in std::iter::once(&receipt.source).chain(&receipt.sources) {
+            if !matches!(db.published_input(&InputKey::CapturedSource(selected.location_identity())),Some((InputValue::CapturedSource(current),_))if current==selected)
+                || !matches!(db.published_input(&InputKey::SourceBlob(selected.outline.parse.content)),Some((InputValue::SourceBlob(blob),_))if blob.content()==selected.outline.parse.content)
+                || !matches!(db.published_input(&InputKey::CrateCfg(selected.outline.crate_key)),Some((InputValue::CrateCfg(cfg),_))if cfg.fingerprint()==selected.outline.cfg)
+            {
+                return Err(fault("Type prelude retained source/header/cfg changed"));
+            };
+            for key in [
+                InputKey::CapturedSource(selected.location_identity()),
+                InputKey::SourceBlob(selected.outline.parse.content),
+                InputKey::CrateCfg(selected.outline.crate_key),
+            ] {
+                stamp(db, &key, &mut stamps, &mut bytes, maximum)?
+            }
+        }
+        let policy = PreparedCratePreludePolicy::capture_current(
+            source,
+            key.epoch,
+            maximum
+                .checked_sub(bytes)
+                .ok_or_else(limit)?
+                .checked_div(2)
+                .ok_or_else(limit)?,
+        )?;
+        if !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(graph),_))if graph.root_for(scope.crate_key)==Some(policy.owning_root_selection()))
+        {
+            return Err(fault("Type prelude actual owning root selection differs"));
+        }
+        if policy.identity() != receipt.policy {
+            return Err(fault("Type prelude owning policy receipt differs"));
+        };
+        for selected in policy.source_selections() {
+            if !matches!(db.published_input(&InputKey::CapturedSource(selected.location_identity())),Some((InputValue::CapturedSource(actual),_))if actual==selected)
+            {
+                return Err(fault("Type prelude policy ancestor publication differs"));
+            };
+            stamp(
+                db,
+                &InputKey::CapturedSource(selected.location_identity()),
+                &mut stamps,
+                &mut bytes,
+                maximum,
+            )?;
+        }
+        charge(
+            &mut bytes,
+            policy.metadata_bytes().checked_mul(2).ok_or_else(limit)?,
+            maximum,
+        )?;
+        match &receipt.mode {
+            PreparedMode::Need(need) => return Ok(TypePreludeAbsenceOutcome::Need(need.clone())),
+            PreparedMode::Disabled => {}
+            PreparedMode::Default { standard, facet } => {
+                let Some(compiler) = &owner.compiler else {
+                    return Ok(TypePreludeAbsenceOutcome::Need(
+                        TypePreludePrerequisite::CompilerFacet,
+                    ));
+                };
+                charge(
+                    &mut bytes,
+                    compiler
+                        .owning_profile_metadata_bytes()?
+                        .checked_mul(2)
+                        .ok_or_else(limit)?,
+                    maximum,
+                )?;
+                let Some(actual) = compiler.type_prelude_facet(&source.outline().profile)? else {
+                    return Ok(TypePreludeAbsenceOutcome::Need(
+                        TypePreludePrerequisite::CompilerFacet,
+                    ));
+                };
+                if actual.identity() != *facet
+                    || Some(compiler.owning_profile_identity()?) != receipt.catalog
+                {
+                    return Err(fault(
+                        "Type prelude actual published compiler facet differs",
+                    ));
+                };
+                if actual.contains_export_spelling(*standard, name) {
+                    return Ok(TypePreludeAbsenceOutcome::Need(
+                        TypePreludePrerequisite::DefaultExportSpelling,
+                    ));
+                }
+            }
+            PreparedMode::Custom {
+                directive,
+                module,
+                source: selected,
+                ..
+            } => {
+                if !matches!(db.published_input(&InputKey::DefinitionHeader(directive.definition())),Some((InputValue::DefinitionHeader(header),_))if header.fingerprint()==directive.header())
+                    || !matches!(db.published_input(&InputKey::DefinitionSource(directive.definition())),Some((InputValue::DefinitionSource(parse),_))if parse==&selected.outline.parse)
+                {
+                    return Err(fault("Type prelude custom actual header/source changed"));
+                };
+                if !matches!(db.published_input(&InputKey::DeclarationContext(directive.definition())),Some((InputValue::DeclarationContext(context),_))if context.scope==directive.import().scope)
+                {
+                    return Err(fault("Type prelude custom declaration context differs"));
+                }
+                stamp(
+                    db,
+                    &InputKey::DeclarationContext(directive.definition()),
+                    &mut stamps,
+                    &mut bytes,
+                    maximum,
+                )?;
+                stamp(
+                    db,
+                    &InputKey::DefinitionHeader(directive.definition()),
+                    &mut stamps,
+                    &mut bytes,
+                    maximum,
+                )?;
+                stamp(
+                    db,
+                    &InputKey::DefinitionSource(directive.definition()),
+                    &mut stamps,
+                    &mut bytes,
+                    maximum,
+                )?;
+                let target_key = SealKey {
+                    domain: SealDomain::Scope {
+                        id: module.fingerprint(),
+                        namespace: Namespace::Type,
+                    },
+                    unit_graph: key.unit_graph,
+                    epoch: key.epoch,
+                };
+                let Some(target) = current_scope(
+                    db,
+                    &target_key,
+                    module,
+                    graph,
+                    &mut stamps,
+                    &mut bytes,
+                    maximum,
+                )?
+                else {
+                    return Ok(TypePreludeAbsenceOutcome::Need(
+                        TypePreludePrerequisite::TargetTypeNamespace(module.clone()),
+                    ));
+                };
+                let Some((InputValue::SourceDependencies(dependencies), _)) =
+                    db.published_input(&InputKey::SourceDependencies)
+                else {
+                    return Err(fault("custom Type prelude source graph disappeared"));
+                };
+                let Some(target_root) = dependencies.root_for(module.crate_key) else {
+                    return Ok(TypePreludeAbsenceOutcome::Need(
+                        TypePreludePrerequisite::RetainedSource(module.crate_key),
+                    ));
+                };
+                if !target.sources.contains(target_root)
+                    || target.scope.as_ref().is_none_or(|scope| {
+                        scope.edition != target_root.outline.parse.profile.edition
+                    })
+                    || !matches!(db.published_input(&InputKey::CapturedSource(target_root.location_identity())),Some((InputValue::CapturedSource(actual),_))if actual==target_root)
+                    || !matches!(db.published_input(&InputKey::CrateCfg(module.crate_key)),Some((InputValue::CrateCfg(cfg),_))if cfg.fingerprint()==target_root.outline.cfg)
+                {
+                    return Err(fault(
+                        "custom Type prelude actual target owning source/profile/cfg differs",
+                    ));
+                }
+                for key in [
+                    InputKey::CapturedSource(target_root.location_identity()),
+                    InputKey::SourceBlob(target_root.outline.parse.content),
+                    InputKey::CrateCfg(module.crate_key),
+                ] {
+                    stamp(db, &key, &mut stamps, &mut bytes, maximum)?;
+                }
+                charge(
+                    &mut bytes,
+                    module
+                        .heap_bytes()
+                        .checked_add(name.len())
+                        .ok_or_else(limit)?,
+                    maximum,
+                )?;
+                let found = target
+                    .scope
+                    .as_ref()
+                    .ok_or_else(|| fault("custom Type prelude target scope absent"))?
+                    .lookup(&BucketKey {
+                        scope: module.clone(),
+                        namespace: Namespace::Type,
+                        name: name.into(),
+                    })?;
+                if found != NameLookup::Absent {
+                    return Ok(TypePreludeAbsenceOutcome::Need(
+                        TypePreludePrerequisite::Member(found),
+                    ));
+                };
+            }
+        }
+        let mut encoded = StableEncoder::new("lrr/v1/type-prelude-absence-name");
+        encoded.string(name);
+        Ok(TypePreludeAbsenceOutcome::Absent(Self {
+            receipt: receipt.identity(),
+            name: encoded.finish(),
+            stamps,
+            revision: db.revision(),
+            bytes,
+        }))
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn dependencies(&self) -> &BTreeMap<InputKey, Digest> {
+        &self.stamps
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/current-type-prelude-absence");
+        e.digest(self.receipt);
+        e.digest(self.name);
+        e.u64(u64::try_from(self.stamps.len()).expect("bounded Type prelude input count"));
+        for (key, value) in &self.stamps {
+            e.record(key);
+            e.digest(*value)
+        }
+        e.finish()
+    }
+    pub(crate) fn revalidate_inputs(&self, db: &Database) -> Result<(), Diagnostic> {
+        db.require_coordinator()?;
+        if self.revision != db.revision() {
+            return Err(fault("Type prelude publication barrier changed"));
+        }
+        for (key, value) in &self.stamps {
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != *value)
+            {
+                return Err(fault("Type prelude current input differs"));
+            }
+        }
+        Ok(())
+    }
+    #[cfg(test)]
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        owner: &SourceDeclarative,
+        scope: &ScopeKey,
+        key: &SealKey,
+        name: &str,
+        maximum: usize,
+    ) -> Result<(), Diagnostic> {
+        if self.revision != db.revision() {
+            return Err(fault("Type prelude publication barrier changed"));
+        };
+        for (key, value) in &self.stamps {
+            if db
+                .published_input(key)
+                .is_none_or(|(_, current)| current != *value)
+            {
+                return Err(fault("Type prelude current input differs"));
+            }
+        }
+        match Self::capture_current(
+            db,
+            owner,
+            scope,
+            key,
+            name,
+            maximum.checked_sub(self.bytes).ok_or_else(limit)?,
+        )? {
+            TypePreludeAbsenceOutcome::Absent(current) if self.identity() == current.identity() => {
+                Ok(())
+            }
+            _ => Err(fault("Type prelude source/policy/selection differs")),
+        }
+    }
+}
