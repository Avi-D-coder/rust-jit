+//! Pinned rustc_resolve::resolve_crate_root mark selection (ae0fe lib.rs:2351).
+//! Uses actual adapter-normalized ancestry; no mark/source/context is erased.
+use super::*;
+pub(crate) struct DollarCrateOrigin {
+    normalized: Key,
+    mark: Key,
+    expansion: Key,
+    unit: Key,
+}
+impl DollarCrateOrigin {
+    pub(crate) fn normalized_context(&self) -> Key {
+        self.normalized
+    }
+    pub(crate) fn mark(&self) -> Key {
+        self.mark
+    }
+    pub(crate) fn expansion(&self) -> Key {
+        self.expansion
+    }
+    pub(crate) fn unit(&self) -> Key {
+        self.unit
+    }
+}
+pub(super) fn select(facts: &HygieneFacts, key: Key) -> Result<Key, Diagnostic> {
+    Ok(select_origin(facts, key)?.unit())
+}
+fn finish(
+    facts: &HygieneFacts,
+    normalized: Key,
+    selected: Option<Key>,
+) -> Result<DollarCrateOrigin, Diagnostic> {
+    let mark =
+        selected.ok_or_else(|| error("dollar-crate token lacks definition-site authority"))?;
+    let record = facts.context(mark)?;
+    let expansion = record
+        .expansion
+        .ok_or_else(|| error("dollar-crate selected mark expansion absent"))?;
+    Ok(DollarCrateOrigin {
+        normalized,
+        mark,
+        expansion,
+        unit: record.defining_unit,
+    })
+}
+pub(super) fn select_origin(
+    facts: &HygieneFacts,
+    key: Key,
+) -> Result<DollarCrateOrigin, Diagnostic> {
+    let normalized = facts.local(key)?;
+    let mut cursor = normalized; // pinned normalize_to_macro_rules row
+    let mut selected = None;
+    let mut opaque_suffix = true;
+    for _ in 0..=256 {
+        let record = facts.context(cursor)?;
+        if record.expansion.is_none() {
+            return finish(facts, normalized, selected);
+        }
+        match record.transparency {
+            Transparency::Opaque if opaque_suffix => selected = Some(cursor),
+            Transparency::SemiTransparent => {
+                opaque_suffix = false;
+                selected = Some(cursor);
+            }
+            Transparency::Opaque => {
+                return finish(facts, normalized, selected);
+            }
+            Transparency::Transparent => {
+                return Err(error(
+                    "dollar-crate normalized ancestry contains a transparent mark",
+                ));
+            }
+        }
+        cursor = record
+            .parent
+            .ok_or_else(|| error("dollar-crate mark parent is missing"))?;
+    }
+    Err(error("dollar-crate definition ancestry depth exceeded"))
+}
