+            || !self.endpoint.same_publication(view)
+            || self.endpoint.selection() != view.selection()
+            || !self.root.same_publication(&current.root)
+            || self.root.selection() != current.root.selection()
+            || self.rows.len() != current.rows.len()
+            || !self.rows.iter().zip(&current.rows).all(|(a, b)| {
+                a.source.same_publication(&b.source)
+                    && a.selection == b.selection
+                    && a.origin == b.origin
+            })
