+fn input(text: &str, path: &str, unit: Digest, edition: u16) -> SourceUnitInput {
+    SourceUnitInput {
+        path: SourcePath::new(path).unwrap(),
+        crate_key: unit,
+        module_path: vec![],
+        profile: ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+        cfg: CfgSet::guest_default(),
