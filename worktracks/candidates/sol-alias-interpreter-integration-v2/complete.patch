+    }
+    pub(crate) fn capture_current(
+        view: &PreparedSourceView,
+        epoch: u64,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        if epoch == 0 {
+            return Err(fault("owning crate policy current epoch absent"));
+        }
+        let mut prepared = Self::capture_retained(view, byte_limit)?;
+        if prepared.retained_epoch.is_some_and(|e| e != epoch) {
+            return Err(fault("owning crate policy current generated epoch differs"));
+        }
+        prepared.current_epoch = Some(epoch);
+        Ok(prepared)
+    }
+    pub(crate) fn revalidate_current(
+        &self,
+        view: &PreparedSourceView,
+        epoch: u64,
+    ) -> Result<(), Diagnostic> {
+        let current = Self::capture_current(view, epoch, self.bytes)?;
