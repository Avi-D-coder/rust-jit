+// Type discovery consumes the same actual already-expanded records. It does not
+// execute a producer while normalizing a reached alias or entering guest code.
+fn publish_type(v: &PreparedSourceView, value: &SourceDiscovery, db: &mut lrr::db::memo::Database) {
+    db.begin_expansion_epoch(1).unwrap();
+    let records = value
+        .sealed_expansions()
+        .unwrap()
+        .cloned()
+        .collect::<Vec<_>>();
+    let mut types = discover(v, lrr::source::manifest::Namespace::Type);
+    loop {
+        match types.poll().unwrap() {
+            SourceDiscoveryStep::Sealed(_) => break,
+            SourceDiscoveryStep::NeedExpansion { request } => {
+                let record = records
+                    .iter()
+                    .find(|r| r.key() == request.key())
+                    .expect("actual matching source expansion");
+                types
+                    .admit_expansion(std::sync::Arc::clone(record))
+                    .unwrap();
+            }
+            SourceDiscoveryStep::NeedGeneratedExpansion { request } => {
+                let record = records
+                    .iter()
+                    .find(|r| r.key() == request.key())
+                    .expect("actual matching generated expansion");
+                types
+                    .admit_expansion(std::sync::Arc::clone(record))
+                    .unwrap();
+            }
+            SourceDiscoveryStep::Incomplete { diagnostic, .. } => panic!(
+                "Type preparation prerequisite: {} {}",
+                diagnostic.code, diagnostic.message
+            ),
+            _ => panic!("Type preparation needs an unadmitted producer"),
+        }
+    }
+    types.publish(db).unwrap();
