+                e.u8(1);
+                e.sequence(parts, |e, p| {
+                    match &p.kind {
+                        GeneratedTypeSegmentKind::Name(n) => {
+                            e.u8(0);
+                            e.string(n)
+                        }
+                        GeneratedTypeSegmentKind::Keyword(k) => {
+                            e.u8(1);
+                            e.u8(match k {
+                                TypeKeyword::Crate => 0,
+                                TypeKeyword::SelfModule => 1,
+                                TypeKeyword::SuperModule => 2,
+                                TypeKeyword::DollarCrate => 3,
+                            })
+                        }
+                    };
+                    e.u32(p.range.start);
+                    e.u32(p.range.end);
+                    e.digest(Digest(p.span.key().0));
+                });
+            }
+        }
+        e.finish()
+    }
+}
