+//! Syntactic prelude-import sites only. Semantic Attribute/module selection is separate.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    source::{manifest::ItemKind, snapshot::CfgSet},
+    syntax::{
+        imports::{ImportKind, SourceImport},
+        outline::Outline,
+        parse::ParsedFile,
+        spans::SourceRange,
+    },
+};
+use ra_ap_syntax::{
+    AstNode,
+    ast::{self, HasAttrs},
+};
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TYPE-PRELUDE-SOURCE", message.into())
+}
+#[derive(Debug, Clone)]
+pub(crate) struct TypePreludeDirective {
+    source: SourceImport,
+    meta: SourceRange,
+    definition: Digest,
+    header: Digest,
+}
+impl TypePreludeDirective {
+    pub(crate) fn import(&self) -> &SourceImport {
+        &self.source
+    }
+    pub(crate) fn meta(&self) -> SourceRange {
+        self.meta
+    }
+    pub(crate) fn definition(&self) -> Digest {
+        self.definition
+    }
+    pub(crate) fn header(&self) -> Digest {
+        self.header
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.fingerprint()
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        self.source.path.iter().try_fold(
+            std::mem::size_of::<Self>()
+                .checked_add(self.source.scope.heap_bytes())
+                .and_then(|n| n.checked_add(128))
+                .ok_or_else(|| fault("prelude directive metadata overflow"))?,
+            |n, part| {
+                n.checked_add(std::mem::size_of_val(part))
+                    .and_then(|n| {
+                        n.checked_add(match part {
+                            crate::syntax::imports::ImportSegment::Name(name) => name.capacity(),
+                            _ => 0,
