+//! Retained owning-crate policy, separate from namespace/macro authority.
+use super::*;
+use crate::{
+    core::digest::{Digest, StableEncode, StableEncoder},
+    syntax::{macro_prelude::MacroPreludePolicy, parse::ParsedFile},
+};
+struct Row {
+    source: PreparedSourceView,
+    selection: SourceSelection,
+    origin: Digest,
+}
+pub(crate) struct PreparedCratePreludePolicy {
+    endpoint: PreparedSourceView,
+    root: PreparedSourceView,
+    rows: Vec<Row>,
+    standard: bool,
+    disabled: Vec<Vec<String>>,
+    retained_epoch: Option<u64>,
+    current_epoch: Option<u64>,
+    bytes: usize,
+}
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-CATALOG-INCOMPLETE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new("LRR-E-METADATA-LIMIT", "owning crate policy budget".into())
+}
+fn charge(bytes: &mut usize, n: usize, maximum: usize) -> Result<(), Diagnostic> {
+    *bytes = bytes
+        .checked_add(n)
+        .filter(|n| *n <= maximum)
+        .ok_or_else(limit)?;
+    Ok(())
+}
+fn mapped_disabled(
+    out: &mut Vec<Vec<String>>,
+    policy: &MacroPreludePolicy,
+    base: &[String],
+    target: &[String],
+    bytes: &mut usize,
+    maximum: usize,
+) -> Result<(), Diagnostic> {
+    for relative in &policy.disabled {
+        let count = base
+            .len()
+            .checked_add(relative.len())
+            .filter(|n| *n <= 256)
+            .ok_or_else(limit)?;
+        let path = base.iter().chain(relative).collect::<Vec<_>>();
+        let inherited = path.len() <= target.len() && path.iter().zip(target).all(|(a, b)| *a == b);
+        let below = target.len() <= path.len() && path.iter().zip(target).all(|(a, b)| *a == b);
+        if !inherited && !below {
+            continue;
+        }
+        if out.len() >= 100_000 {
+            return Err(limit());
+        }
+        let suffix = if inherited {
+            &path[count..]
+        } else {
+            &path[target.len()..]
+        };
+        let n = suffix
+            .iter()
+            .try_fold(128usize, |n, s| {
+                n.checked_add(s.capacity())
+                    .and_then(|n| n.checked_add(std::mem::size_of::<String>()))
+            })
+            .ok_or_else(limit)?;
+        charge(bytes, n, maximum)?;
+        out.try_reserve(1).map_err(|_| limit())?;
+        out.push(suffix.iter().map(|s| (*s).clone()).collect());
+    }
+    Ok(())
+}
+impl PreparedCratePreludePolicy {
+    pub(crate) fn capture_retained(
+        view: &PreparedSourceView,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        if byte_limit > 32 * 1024 * 1024 {
+            return Err(limit());
+        }
+        let mut bytes = std::mem::size_of::<Self>()
+            .checked_add(256)
+            .and_then(|n| n.checked_add(256 * std::mem::size_of::<&String>()))
+            .and_then(|n| n.checked_add(256 * std::mem::size_of::<(&PreparedSourceView, Digest)>()))
+            .filter(|n| *n <= byte_limit)
+            .ok_or_else(limit)?;
+        let target = &view.selection().outline.module_path;
+        let unit = view.selection().outline.crate_key;
+        let profile = &view.selection().outline.parse.profile;
+        let cfg = view.selection().outline.cfg;
+        let mut cursor = view;
+        let mut borrowed = Vec::<(&PreparedSourceView, Digest)>::new();
+        let mut disabled = Vec::new();
+        let mut retained_epoch = None;
+        loop {
+            if borrowed.len() >= 256
+                || borrowed.iter().any(|(old, _)| {
+                    old.same_publication(cursor) && old.selection() == cursor.selection()
+                })
+            {
+                return Err(fault("owning crate lineage absent/cyclic or over budget"));
+            }
+            cursor.require_declaration_syntax()?;
+            if cursor.selection().outline.crate_key != unit
+                || &cursor.selection().outline.parse.profile != profile
+                || cursor.selection().outline.cfg != cfg
+                || !target.starts_with(&cursor.selection().outline.module_path)
+            {
+                return Err(fault(
+                    "owning crate lineage unit/profile/cfg/module differs",
+                ));
+            }
+            let row_bytes = cursor
+                .selection()
