+//! Exact generated declaration owner to compiler-facet transfer; no effects.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    expand::{record::ExpansionRecord, source_declarative::SourceDeclarative},
+    frontend::{
+        compile_input_catalog::CompileInputCatalog, generated_macros::GeneratedMacroCatalog,
+    },
+    source::{
+        changes::crate_policy::PreparedCratePreludePolicy,
+        changes::{PreparedSourceView, SourceSelection},
+        module_syntax::ModuleSyntaxInput,
+    },
+    syntax::{outline::ScopeKey, token_wire::Key},
+};
+use std::sync::Arc;
+pub(super) struct PreparedGeneratedCompilerFacet {
+    caller: PreparedSourceView,
+    selection: SourceSelection,
+    scope: ScopeKey,
+    caller_root: Key,
+    record: Arc<ExpansionRecord>,
+    epoch: u64,
+    compiler: Arc<CompileInputCatalog>,
+    compiler_identity: Digest,
+    child: Option<(PreparedSourceView, SourceSelection, Digest)>,
+    bytes: usize,
+    policy: PreparedCratePreludePolicy,
+    child_policy: Option<PreparedCratePreludePolicy>,
+}
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-COMPILE-INPUT", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "generated compiler facet transfer budget".into(),
+    )
+}
+impl PreparedGeneratedCompilerFacet {
+    pub(super) fn capture_current(
+        parent: &SourceDeclarative,
+        generated: &GeneratedMacroCatalog,
+        epoch: u64,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        let (items, scope, root) = generated.captured_owner();
+        let source = parent.module_source();
+        let selection = source.selection();
+        if epoch == 0
+            || items.epoch() != epoch
+            || items
+                .record()
+                .key()
+                .procedural_epoch
+                .is_some_and(|e| e != epoch)
+        {
+            return Err(fault("generated compiler facet current epoch differs"));
+        }
+        items.record().key().validate()?;
+        source.require_declaration_syntax()?;
+        if scope.owner.is_some()
+            || scope.crate_key != selection.outline.crate_key
+            || !scope
+                .module_path
+                .starts_with(&selection.outline.module_path)
+            || generated.owning_cfg() != source.captured_macro_cfg()?
+            || root.parent.is_some()
+            || root.defining_unit.0 != scope.crate_key.0
+            || parent.macro_index().hygiene_facts().context(root.key())? != root
+        {
+            return Err(fault(
+                "generated compiler facet exact caller scope/profile/hygiene differs",
+            ));
+        }
+        let compiler = parent
+            .compiler
+            .as_ref()
+            .ok_or_else(|| fault("generated compiler facet matched parent catalogue absent"))?;
+        let compiler_identity = compiler.owning_profile_identity()?;
+        if compiler.has_standard_facets()
+            && compiler
+                .canonical_standalone_member(&selection.outline.parse.profile)?
+                .is_none()
+        {
+            return Err(fault(
+                "generated compiler facet lacks matched owning-profile membership",
+            ));
+        }
+        let bytes = std::mem::size_of::<Self>()
+            .checked_add(256)
+            .and_then(|n| n.checked_add(selection.metadata_bytes().ok()?))
+            .and_then(|n| n.checked_add(scope.heap_bytes()))
+            .and_then(|n| n.checked_add(compiler.owning_profile_metadata_bytes().ok()?))
+            .filter(|n| byte_limit <= 64 * 1024 * 1024 && *n <= byte_limit)
+            .ok_or_else(limit)?;
+        let residual = byte_limit
+            .checked_sub(bytes)
+            .ok_or_else(limit)?
+            .min(32 * 1024 * 1024);
+        let policy = PreparedCratePreludePolicy::capture_current(source, epoch, residual)?;
+        let bytes = bytes
+            .checked_add(policy.metadata_bytes())
+            .filter(|n| *n <= byte_limit)
+            .ok_or_else(limit)?;
+        Ok(Self {
+            policy,
+            child_policy: None,
+            caller: source.share(),
+            selection: selection.clone(),
+            scope: scope.clone(),
+            caller_root: root.key(),
+            record: items.record_input(),
+            epoch,
+            compiler: compiler.clone(),
+            compiler_identity,
+            child: None,
+            bytes,
+        })
+    }
+    pub(super) fn capture_module_current(
+        syntax: &ModuleSyntaxInput,
+        parent: &SourceDeclarative,
+        generated: &GeneratedMacroCatalog,
+        epoch: u64,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        let mut proof = Self::capture_current(parent, generated, epoch, byte_limit)?;
+        proof.check_module_origin(syntax, generated)?;
+        let child = syntax.prepared_source();
+        let bytes = proof
+            .bytes
+            .checked_add(std::mem::size_of::<(
+                PreparedSourceView,
+                SourceSelection,
+                Digest,
+            )>())
+            .and_then(|n| n.checked_add(child.selection().metadata_bytes().ok()?))
+            .and_then(|n| n.checked_add(128))
+            .filter(|n| *n <= byte_limit)
+            .ok_or_else(limit)?;
+        let residual = byte_limit
+            .checked_sub(bytes)
+            .ok_or_else(limit)?
+            .min(32 * 1024 * 1024);
+        let policy = PreparedCratePreludePolicy::capture_current(child, epoch, residual)?;
+        let bytes = bytes
+            .checked_add(policy.metadata_bytes())
+            .filter(|n| *n <= byte_limit)
+            .ok_or_else(limit)?;
+        proof.child_policy = Some(policy);
+        proof.child = Some((child.share(), child.selection().clone(), syntax.identity()));
+        proof.bytes = bytes;
+        Ok(proof)
+    }
+    fn check_module_origin(
+        &self,
+        syntax: &ModuleSyntaxInput,
+        generated: &GeneratedMacroCatalog,
+    ) -> Result<(), Diagnostic> {
+        let origin = syntax.origin();
+        let child = syntax.prepared_source();
+        if !origin.caller().same_publication(&self.caller)
+            || origin.caller().selection() != &self.selection
+            || !origin.parent().record().same_record(&self.record)
+            || origin.parent().epoch() != self.epoch
+            || origin.parent_header().expansion != self.record.key().fingerprint()
+            || child.selection().outline.crate_key != self.selection.outline.crate_key
+            || child.selection().outline.parse.profile != self.selection.outline.parse.profile
+            || child.selection().outline.cfg != self.selection.outline.cfg
+            || !child
+                .selection()
+                .outline
+                .module_path
+                .starts_with(&self.scope.module_path)
+            || !generated.unresolved_module_sources().any(|d| {
+                d.producer() == origin.producer()
+                    && d.header() == origin.parent_header()
+                    && d.scope() == &child.outline().root_scope
+            })
+        {
+            return Err(fault(
+                "generated compiler facet module origin/member/source differs",
+            ));
+        }
+        // Absent file attributes cannot manufacture crate-wide no_std policy.
+        if self.caller.macro_prelude_policy()?.standard != child.macro_prelude_policy()?.standard {
+            return Err(fault(
+                "generated compiler facet requires retained crate-wide prelude policy",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn revalidate_current(
+        &self,
+        parent: &SourceDeclarative,
+        generated: &GeneratedMacroCatalog,
+        epoch: u64,
+    ) -> Result<(), Diagnostic> {
+        self.policy
+            .revalidate_current(parent.module_source(), epoch)?;
+        let (items, scope, root) = generated.captured_owner();
+        if epoch != self.epoch
+            || items.epoch() != self.epoch
+            || !parent.module_source().same_publication(&self.caller)
+            || parent.module_source().selection() != &self.selection
+            || scope != &self.scope
+            || generated.owning_cfg() != parent.module_source().captured_macro_cfg()?
+            || root.key() != self.caller_root
+            || !items.record().same_record(&self.record)
+            || parent.macro_index().hygiene_facts().context(root.key())? != root
+            || parent
+                .compiler
+                .as_ref()
+                .map(|c| c.owning_profile_identity())
+                .transpose()?
+                != Some(self.compiler_identity)
+        {
+            return Err(fault(
+                "generated compiler facet current owner/record/epoch/catalogue differs",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn install_module(
+        &self,
+        syntax: &ModuleSyntaxInput,
+        target: &mut SourceDeclarative,
+        parent: &SourceDeclarative,
+        generated: &GeneratedMacroCatalog,
+        epoch: u64,
+    ) -> Result<(), Diagnostic> {
+        self.revalidate_current(parent, generated, epoch)?;
+        self.check_module_origin(syntax, generated)?;
+        self.check_child(syntax, target)?;
+        self.child_policy
+            .as_ref()
+            .ok_or_else(|| fault("generated child owning policy absent"))?
+            .revalidate_current(syntax.prepared_source(), epoch)?;
+        if target.compiler.is_some() {
+            return Err(fault("generated compiler facet target already installed"));
+        }
+        target.compiler = Some(self.compiler.clone());
+        Ok(())
+    }
+    fn check_child(
+        &self,
+        syntax: &ModuleSyntaxInput,
+        target: &SourceDeclarative,
+    ) -> Result<(), Diagnostic> {
+        let (child, selection, identity) = self
+            .child
+            .as_ref()
+            .ok_or_else(|| fault("generated compiler facet has no admitted child"))?;
+        if syntax.identity() != *identity
+            || !syntax.prepared_source().same_publication(child)
+            || syntax.prepared_source().selection() != selection
+            || !target.module_source().same_publication(child)
+            || target.module_source().selection() != selection
+        {
+            return Err(fault(
+                "generated compiler facet target publication/projection differs",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn revalidate_module(
+        &self,
+        syntax: &ModuleSyntaxInput,
+        target: &SourceDeclarative,
+        parent: &SourceDeclarative,
+        generated: &GeneratedMacroCatalog,
+        epoch: u64,
+    ) -> Result<(), Diagnostic> {
+        self.revalidate_current(parent, generated, epoch)?;
+        self.check_module_origin(syntax, generated)?;
+        self.check_child(syntax, target)?;
+        self.child_policy
+            .as_ref()
+            .ok_or_else(|| fault("generated child owning policy absent"))?
+            .revalidate_current(syntax.prepared_source(), epoch)?;
+        if target
+            .compiler
+            .as_ref()
+            .map(|c| c.owning_profile_identity())
+            .transpose()?
+            != Some(self.compiler_identity)
+        {
+            return Err(fault(
+                "generated compiler facet attached target catalogue differs",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(super) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v2/generated-source-compiler-facet");
+        e.digest(self.selection.location_identity());
+        e.record(&self.selection.outline.parse);
+        e.digest(self.selection.outline.cfg);
+        e.record(self.record.key());
+        e.digest(self.record.output());
+        e.record(&self.scope);
+        e.bytes(&self.caller_root.0);
+        e.u64(self.epoch);
+        e.digest(self.compiler_identity);
+        e.digest(self.policy.identity());
+        e.bool(self.child_policy.is_some());
+        if let Some(policy) = &self.child_policy {
+            e.digest(policy.identity());
+        }
+        e.bool(self.child.is_some());
+        if let Some((_, selection, projection)) = &self.child {
+            e.digest(selection.location_identity());
+            e.record(&selection.outline.parse);
+            e.digest(selection.outline.cfg);
+            e.digest(*projection);
+        }
+        e.finish()
+    }
+}
