+    }
+    /// Actual captured lineage evidence, never a caller-supplied completeness list.
+    pub(crate) fn source_selections(&self) -> impl Iterator<Item = &SourceSelection> {
+        self.rows.iter().map(|row| &row.selection)
+    }
+    pub(crate) fn owning_root_selection(&self) -> &SourceSelection {
+        self.root.selection()
+    }
+    pub(crate) fn policy(&self) -> MacroPreludePolicy {
+        MacroPreludePolicy {
+            standard: self.standard,
+            disabled: self.disabled.clone(),
+        }
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/owning-crate-prelude-policy");
+        e.bool(self.standard);
+        e.sequence(&self.disabled, |e, path| {
+            e.sequence(path, |e, name| e.string(name))
+        });
+        e.option(&self.current_epoch, |e, n| e.u64(*n));
+        e.u64(self.rows.len() as u64);
+        for row in &self.rows {
+            e.digest(row.origin)
+        }
+        e.finish()
+    }
+}
