+//! Section17 explicit compiler-owned default Type-prelude declaration closure.
+//! Conservative exported spellings only; present names require actual members.
+//! No sysroot/native source read, parsing or binding equivalence is implied.
+use super::*;
+use crate::core::profile::ProfileIdentity;
+#[derive(Debug, Clone)]
+pub(crate) struct CompilerTypePreludeFacet {
+    profile: ProfileIdentity,
+}
+impl CompilerTypePreludeFacet {
+    pub(super) fn for_profile(profile: &ProfileIdentity) -> Result<Self, Diagnostic> {
+        profile.validate_source()?;
+        Ok(Self {
+            profile: profile.clone(),
+        })
+    }
+    pub(super) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.profile.semantics.capacity())
+            .and_then(|n| n.checked_add(128))
+            .ok_or_else(|| fault("Type prelude facet metadata overflow"))
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.fingerprint()
+    }
+    pub(crate) fn contains_export_spelling(&self, standard: bool, name: &str) -> bool {
+        let base = if standard { STD_V1 } else { CORE_V1 };
+        base.binary_search(&name).is_ok()
+            || (matches!(self.profile.edition, 2021 | 2024)
+                && matches!(name, "FromIterator" | "TryFrom" | "TryInto"))
+            || (self.profile.edition == 2024 && matches!(name, "Future" | "IntoFuture"))
+    }
+}
+impl StableEncode for CompilerTypePreludeFacet {
+    const DOMAIN: &'static str = "lrr/v1/compiler-default-type-prelude-facet";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.profile);
+        e.string("ae0fe511b15ab760d7e963b13389d1bc2ab42b18");
+        e.string("synthetic-facade/type-prelude/conservative-spellings/generation1");
+        e.string("library/core/src/prelude/mod.rs");
+        e.string("3db82d282c4ac980659183842d446e13d28b0bab609f3dc37e2036d9fefceb4c");
+        e.string("library/core/src/prelude/v1.rs");
+        e.string("b57d120c6762622bd33114f46267dab8ba6c88be38f1433adb62d4ba36cd3a68");
+        e.string("library/std/src/prelude/mod.rs");
+        e.string("04e3eabaab3ff44016155b2949e7b6751547f9c480be51fb8a448ac8c9b2e105");
+        e.string("library/std/src/prelude/v1.rs");
+        e.string("393900118db4000a0bd90f7c8f50fcb55475939586f24285ecca70925d6a6a2c");
+        e.sequence(CORE_V1, |e, n| e.string(n));
+        e.sequence(STD_V1, |e, n| e.string(n));
+        e.u16(self.profile.edition);
+    }
+}
+impl CompileInputCatalog {
+    pub(crate) fn type_prelude_facet(
+        &self,
+        profile: &ProfileIdentity,
+    ) -> Result<Option<&CompilerTypePreludeFacet>, Diagnostic> {
+        let Some(facet) = &self.type_prelude else {
+            return Ok(None);
+        };
+        if &facet.profile != profile || self.canonical_standalone_member(profile)?.is_none() {
+            return Err(fault(
+                "actual Type prelude facet owning compiler profile differs",
+            ));
+        }
+        Ok(Some(facet))
