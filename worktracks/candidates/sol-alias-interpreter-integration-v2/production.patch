+//! Explicit reached alias-header query join. Input suspension never performs preparation.
+use crate::{
+    core::{diagnostic::Diagnostic, digest::Digest},
+    db::{
+        key::QueryKey, memo::Database, poll::QueryPoll, provider::SyntaxProvider, value::QueryValue,
+    },
+    frontend::source_type_alias_normalization::CurrentSourcePrimitiveAlias,
+};
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+fn fault() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-SOURCE-ALIAS",
+        "source alias query/header join differs".into(),
+    )
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "source alias query join budget".into(),
+    )
+}
+pub(crate) struct QueriedSourcePrimitiveAlias {
+    source: CurrentSourcePrimitiveAlias,
+    queries: Vec<(QueryKey, Digest)>,
+    bytes: usize,
+}
+impl QueriedSourcePrimitiveAlias {
+    pub(crate) fn capture_current(
+        db: &mut Database,
+        source: CurrentSourcePrimitiveAlias,
+        max: usize,
+    ) -> QueryPoll<Self> {
+        if let Err(e) = source.revalidate_inputs(db) {
+            return QueryPoll::Ready(Err(e));
+        };
+        let count = source.alias_members().count();
+        let Some(bytes) = count
+            .checked_mul(std::mem::size_of::<(QueryKey, Digest)>())
+            .and_then(|n| n.checked_add(source.metadata_bytes().checked_mul(2)?))
+            .and_then(|n| n.checked_add(std::mem::size_of::<Self>()))
+            .filter(|n| max <= MAX_BYTES && *n <= max)
+        else {
+            return QueryPoll::Ready(Err(limit()));
+        };
+        let mut queries = Vec::new();
+        if queries.try_reserve_exact(count).is_err() {
+            return QueryPoll::Ready(Err(crate::runtime::arena::resource()));
+        };
+        for member in source.alias_members() {
+            let key = QueryKey::TypeAlias(member);
+            let outcome = match db.fetch(&SyntaxProvider, key.clone()) {
+                QueryPoll::Ready(Ok(v)) => v,
+                QueryPoll::Ready(Err(e)) => return QueryPoll::Ready(Err(e)),
+                QueryPoll::NeedInput(i) => return QueryPoll::NeedInput(i),
+            };
+            let QueryValue::TypeAlias(recipe) = outcome.value.as_ref() else {
+                return QueryPoll::Ready(Err(fault()));
+            };
+            if !source.matches_query_recipe(recipe) {
+                return QueryPoll::Ready(Err(fault()));
+            };
+            queries.push((key, outcome.fingerprint));
+        }
+        if let Err(e) = source.revalidate_inputs(db) {
+            return QueryPoll::Ready(Err(e));
+        };
+        QueryPoll::Ready(Ok(Self {
+            source,
+            queries,
+            bytes,
+        }))
+    }
+    pub(crate) fn source(&self) -> &CurrentSourcePrimitiveAlias {
+        &self.source
+    }
+    pub(crate) fn query_dependencies(&self) -> &[(QueryKey, Digest)] {
+        &self.queries
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    #[cfg(test)]
+    pub(crate) fn revalidate_current(&self, db: &mut Database) -> QueryPoll<()> {
+        if let Err(e) = self.source.revalidate_inputs(db) {
+            return QueryPoll::Ready(Err(e));
+        };
+        for (key, expected) in &self.queries {
+            let out = match db.fetch(&SyntaxProvider, key.clone()) {
+                QueryPoll::Ready(Ok(v)) => v,
+                QueryPoll::Ready(Err(e)) => return QueryPoll::Ready(Err(e)),
+                QueryPoll::NeedInput(i) => return QueryPoll::NeedInput(i),
+            };
+            if out.fingerprint != *expected {
+                return QueryPoll::Ready(Err(fault()));
+            };
+            let QueryValue::TypeAlias(recipe) = out.value.as_ref() else {
+                return QueryPoll::Ready(Err(fault()));
+            };
+            if !self.source.matches_query_recipe(recipe) {
+                return QueryPoll::Ready(Err(fault()));
+            };
+        }
+        match self.source.revalidate_inputs(db) {
+            Ok(()) => QueryPoll::Ready(Ok(())),
+            Err(e) => QueryPoll::Ready(Err(e)),
+        }
+    }
+}
