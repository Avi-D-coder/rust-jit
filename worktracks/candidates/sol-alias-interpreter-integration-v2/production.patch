+//! Syntactic prelude-import sites only. Semantic Attribute/module selection is separate.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    source::{manifest::ItemKind, snapshot::CfgSet},
+    syntax::{
+        imports::{ImportKind, SourceImport},
+        outline::Outline,
+        parse::ParsedFile,
+        spans::SourceRange,
+    },
+};
+use ra_ap_syntax::{
+    AstNode,
+    ast::{self, HasAttrs},
+};
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TYPE-PRELUDE-SOURCE", message.into())
+}
+#[derive(Debug, Clone)]
+pub(crate) struct TypePreludeDirective {
+    source: SourceImport,
+    meta: SourceRange,
+    definition: Digest,
+    header: Digest,
+}
+impl TypePreludeDirective {
+    pub(crate) fn import(&self) -> &SourceImport {
+        &self.source
+    }
+    pub(crate) fn meta(&self) -> SourceRange {
+        self.meta
+    }
+    pub(crate) fn definition(&self) -> Digest {
+        self.definition
+    }
+    pub(crate) fn header(&self) -> Digest {
+        self.header
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.fingerprint()
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        self.source.path.iter().try_fold(
+            std::mem::size_of::<Self>()
+                .checked_add(self.source.scope.heap_bytes())
+                .and_then(|n| n.checked_add(128))
+                .ok_or_else(|| fault("prelude directive metadata overflow"))?,
+            |n, part| {
+                n.checked_add(std::mem::size_of_val(part))
+                    .and_then(|n| {
+                        n.checked_add(match part {
+                            crate::syntax::imports::ImportSegment::Name(name) => name.capacity(),
+                            _ => 0,
+                        })
+                    })
+                    .ok_or_else(|| fault("prelude directive metadata overflow"))
+            },
+        )
+    }
+}
+impl StableEncode for TypePreludeDirective {
+    const DOMAIN: &'static str = "lrr/v1/type-prelude-written-directive";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.source);
+        e.u32(self.meta.start);
+        e.u32(self.meta.end);
+        e.digest(self.definition);
+        e.digest(self.header)
+    }
+}
+pub(crate) enum TypePreludeSites {
+    Captured(Vec<TypePreludeDirective>),
+    NeedLocal(SourceRange),
+    NeedNonGlob(SourceRange),
+}
+impl ParsedFile {
+    /// Uses existing parsed declaration syntax and the exact cfg-owned outline.
+    /// This prepares no guest body/IR and evaluates no argument or attribute.
+    pub(crate) fn type_prelude_sites(
+        &self,
+        outline: &Outline,
+        cfg: &CfgSet,
+        maximum: usize,
+    ) -> Result<TypePreludeSites, Diagnostic> {
+        if self.key().content != outline.content
+            || self.key().profile != outline.profile
+            || cfg.fingerprint() != outline.cfg
+            || maximum > MAX_BYTES
+        {
+            return Err(fault("prelude directive parse/outline/cfg differs"));
+        }
+        let mut out = Vec::new();
+        let mut bytes = 0usize;
+        let mut visited = 0usize;
+        for import in self
+            .parsed
+            .tree()
+            .syntax()
+            .descendants()
+            .filter_map(ast::Use::cast)
+        {
+            visited = visited
+                .checked_add(1)
+                .filter(|n| *n <= 100_000)
+                .ok_or_else(|| fault("prelude directive count limit"))?;
+            let attribute_count = import.attrs().count();
+            bytes = bytes
+                .checked_add(
+                    attribute_count
+                        .checked_mul(
+                            std::mem::size_of::<ast::Meta>()
+                                .checked_add(128)
+                                .ok_or_else(|| fault("prelude attribute size overflow"))?,
+                        )
+                        .ok_or_else(|| fault("prelude attribute count overflow"))?,
+                )
+                .filter(|n| *n <= maximum)
+                .ok_or_else(|| fault("prelude attribute metadata limit"))?;
+            let mut metas = Vec::new();
+            metas
+                .try_reserve_exact(attribute_count)
+                .map_err(|_| fault("prelude attribute allocation"))?;
+            for attr in import.attrs() {
+                if let Some(meta) = attr.meta() {
+                    if metas.len() >= 100_000 {
+                        return Err(fault("prelude attribute count limit"));
+                    }
+                    metas
+                        .try_reserve(1)
+                        .map_err(|_| fault("prelude attribute allocation"))?;
+                    metas.push(meta)
+                }
+            }
+            let (enabled, metas) = crate::syntax::attributes::effective_metas(metas, cfg)?;
+            if !enabled {
+                continue;
+            };
+            let mut selected = None;
+            for meta in &metas {
+                if meta
+                    .simple_name()
+                    .is_some_and(|name| name.as_str().trim_start_matches("r#") == "prelude_import")
+                {
+                    if selected.replace(meta).is_some() {
+                        return Err(fault(
+                            "prelude import has multiple semantic marker candidates",
+                        ));
+                    }
+                }
+            }
+            let Some(selected) = selected else { continue };
+            let item_range = crate::syntax::ast_adapter::range(import.syntax().text_range());
+            let Some(item) = outline.items.iter().find(|row| {
+                row.def_key.item_kind == ItemKind::Import && row.declaration_span == item_range
+            }) else {
+                // A cfg-excluded containing item cannot produce a live prelude.
+                let mut excluded = false;
+                let mut depth = 0usize;
+                for node in import.syntax().ancestors().skip(1) {
+                    depth = depth
+                        .checked_add(1)
+                        .filter(|n| *n <= 256)
+                        .ok_or_else(|| fault("prelude containing declaration depth"))?;
+                    bytes = bytes
+                        .checked_add(
+                            node.children()
+                                .count()
+                                .checked_mul(256)
+                                .ok_or_else(|| fault("prelude containing metadata overflow"))?,
+                        )
+                        .filter(|n| *n <= maximum)
+                        .ok_or_else(|| fault("prelude containing metadata limit"))?;
+                    let attrs = if let Some(module) = ast::Module::cast(node.clone()) {
+                        Some(module.attrs().filter_map(|a| a.meta()).collect())
+                    } else if let Some(function) = ast::Fn::cast(node.clone()) {
+                        Some(function.attrs().filter_map(|a| a.meta()).collect())
+                    } else if let Some(value) = ast::Const::cast(node.clone()) {
+                        Some(value.attrs().filter_map(|a| a.meta()).collect())
+                    } else if let Some(value) = ast::Static::cast(node) {
+                        Some(value.attrs().filter_map(|a| a.meta()).collect())
+                    } else {
+                        None
+                    };
+                    if let Some(attrs) = attrs {
+                        if !crate::syntax::attributes::effective_metas(attrs, cfg)?.0 {
+                            excluded = true;
+                            break;
+                        }
+                    }
+                }
+                if excluded {
+                    continue;
+                };
+                return Ok(TypePreludeSites::NeedLocal(item_range));
+            };
+            let definition = item.def_key.fingerprint();
+            let mut leaves = outline
+                .imports
+                .iter()
+                .filter(|row| row.identity == definition);
+            let Some(leaf) = leaves.next() else {
+                return Err(fault("prelude directive exact import leaf absent"));
+            };
+            if leaves.next().is_some() || leaf.kind != ImportKind::Glob {
+                return Ok(TypePreludeSites::NeedNonGlob(item_range));
+            };
+            let meta = crate::syntax::ast_adapter::range(selected.syntax().text_range());
+            let charge = std::mem::size_of::<TypePreludeDirective>()
+                .checked_add(leaf.scope.heap_bytes())
+                .and_then(|n| n.checked_add(128))
+                .and_then(|n| n.checked_add(item.header.estimated_bytes()))
+                .ok_or_else(|| fault("prelude directive metadata overflow"))?;
+            bytes = bytes
+                .checked_add(charge)
+                .filter(|n| *n <= maximum)
+                .ok_or_else(|| fault("prelude directive metadata limit"))?;
+            // The exact source-owned import is copied only after bounded metadata reservation.
+            let extra = leaf
+                .path
+                .iter()
+                .try_fold(0usize, |n, part| {
+                    n.checked_add(std::mem::size_of_val(part)).and_then(|n| {
+                        n.checked_add(match part {
+                            crate::syntax::imports::ImportSegment::Name(name) => name.capacity(),
+                            _ => 0,
+                        })
+                    })
+                })
+                .ok_or_else(|| fault("prelude path metadata overflow"))?;
+            bytes = bytes
+                .checked_add(extra)
+                .filter(|n| *n <= maximum)
+                .ok_or_else(|| fault("prelude directive metadata limit"))?;
+            out.try_reserve(1)
+                .map_err(|_| fault("prelude directive allocation"))?;
+            out.push(TypePreludeDirective {
+                source: leaf.clone(),
+                meta,
+                definition,
+                header: item.header.fingerprint(),
+            });
+        }
+        Ok(TypePreludeSites::Captured(out))
+    }
+}
