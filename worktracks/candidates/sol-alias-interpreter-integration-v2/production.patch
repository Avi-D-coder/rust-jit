+            GeneratedTypeSyntax::Unit => e.u8(0),
+            GeneratedTypeSyntax::GenericOrProjection => e.u8(2),
+            GeneratedTypeSyntax::Unsupported => e.u8(3),
+            GeneratedTypeSyntax::AbsolutePath => e.u8(4),
