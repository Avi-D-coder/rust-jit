+//! Closed language Type facet. Neither a standard-library export nor a macro facet.
+//! Pin: rustc_resolve::{lib builtin_type_decls, ident Scope::BuiltinTypes},
+//! rustc_hir::PrimTy::ALL at ae0fe511b15ab760d7e963b13389d1bc2ab42b18.
+use super::*;
+use crate::{core::profile::ProfileIdentity, ir::op::PrimitiveType};
+#[derive(Debug, Clone)]
+pub(crate) struct CompilerPrimitiveFacet {
+    profile: ProfileIdentity,
+}
+impl CompilerPrimitiveFacet {
+    // Only the real standalone compiler catalogue constructor may mint this.
+    pub(super) fn for_profile(profile: &ProfileIdentity) -> Result<Self, Diagnostic> {
+        profile.validate_source()?;
+        Ok(Self {
+            profile: profile.clone(),
+        })
+    }
+    pub(super) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.profile.semantics.capacity())
+            .and_then(|n| n.checked_add(128))
+            .ok_or_else(|| fault("primitive facet metadata overflow"))
+    }
+    pub(crate) fn select(&self, name: &str) -> Option<PrimitiveType> {
+        // A private positive compiler declaration inventory, invoked only after
+        // a current source/prelude precedence proof. Unknown/unstable/unsized
+        // entries never receive a scalar identity. Unit is structural syntax.
+        Some(match name {
+            "bool" => PrimitiveType::Bool,
+            "char" => PrimitiveType::Char,
+            "i8" => PrimitiveType::I8,
+            "i16" => PrimitiveType::I16,
+            "i32" => PrimitiveType::I32,
+            "i64" => PrimitiveType::I64,
+            "i128" => PrimitiveType::I128,
+            "isize" => PrimitiveType::Isize,
+            "u8" => PrimitiveType::U8,
+            "u16" => PrimitiveType::U16,
+            "u32" => PrimitiveType::U32,
+            "u64" => PrimitiveType::U64,
+            "u128" => PrimitiveType::U128,
+            "usize" => PrimitiveType::Usize,
+            "f32" => PrimitiveType::F32,
+            "f64" => PrimitiveType::F64,
+            _ => return None,
+        })
+    }
+    pub(crate) fn member_identity(&self, primitive: PrimitiveType) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/compiler-language-primitive-member");
+        e.record(self);
+        e.u32(primitive.tag());
+        e.finish()
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.fingerprint()
+    }
+}
+impl StableEncode for CompilerPrimitiveFacet {
+    const DOMAIN: &'static str = "lrr/v1/compiler-language-primitive-facet";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.profile);
+        e.string("ae0fe511b15ab760d7e963b13389d1bc2ab42b18");
+        e.string("rustc_resolve/BuiltinTypes/PrimTy/v1");
+        // Explicit scalar inventory; no copied toolchain IDs or std membership.
+        for name in [
+            "bool", "char", "i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64",
+            "u128", "usize", "f32", "f64",
+        ] {
+            e.string(name);
+            e.u32(self.select(name).expect("closed primitive inventory").tag());
+        }
+    }
+}
+impl CompileInputCatalog {
+    pub(crate) fn primitive_facet(
+        &self,
+        profile: &ProfileIdentity,
+    ) -> Result<Option<&CompilerPrimitiveFacet>, Diagnostic> {
+        let Some(facet) = &self.primitive else {
+            return Ok(None);
+        };
+        if &facet.profile != profile || self.canonical_standalone_member(profile)?.is_none() {
+            return Err(fault(
+                "language primitive facet owning compiler profile/catalogue differs",
+            ));
+        }
+        Ok(Some(facet))
+    }
+}
+
+/// Sealed source preparation receipt. Only actual owning provider capture mints
+/// it; publishing inside a completed Type DiscoveryInput supplies currentness.
+#[derive(Debug, Clone)]
+pub(crate) struct CompilerPrimitiveReceipt {
+    source: crate::source::changes::SourceSelection,
+    facet: Digest,
+    catalog: Digest,
+    bytes: usize,
+}
+impl CompilerPrimitiveReceipt {
+    fn capture(
+        provider: &crate::expand::source_declarative::SourceDeclarative,
+        maximum: usize,
+    ) -> Result<Option<Self>, Diagnostic> {
+        let source = provider.module_source();
+        source.require_declaration_syntax()?;
+        let Some(catalog) = &provider.compiler else {
+            return Ok(None);
+        };
+        let profile = &source.selection().outline.parse.profile;
+        let Some(facet) = catalog.primitive_facet(profile)? else {
+            return Ok(None);
+        };
+        let bytes = std::mem::size_of::<Self>()
+            .checked_add(source.selection().metadata_bytes()?)
+            .and_then(|n| n.checked_add(128))
+            .filter(|n| *n <= maximum)
+            .ok_or_else(|| fault("primitive receipt metadata budget"))?;
+        Ok(Some(Self {
+            source: source.selection().clone(),
+            facet: facet.identity(),
+            catalog: catalog.owning_profile_identity()?,
+            bytes,
+        }))
+    }
+    pub(crate) fn matches(
+        &self,
+        source: &crate::source::changes::SourceSelection,
+        catalog: &CompileInputCatalog,
+    ) -> Result<bool, Diagnostic> {
+        let Some(facet) = catalog.primitive_facet(&source.outline.parse.profile)? else {
+            return Ok(false);
+        };
+        Ok(&self.source == source
+            && self.facet == facet.identity()
+            && self.catalog == catalog.owning_profile_identity()?)
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn source(&self) -> &crate::source::changes::SourceSelection {
+        &self.source
+    }
+}
+impl StableEncode for CompilerPrimitiveReceipt {
+    const DOMAIN: &'static str = "lrr/v1/source-compiler-language-primitive-receipt";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.string(self.source.path.as_str());
+        e.record(&self.source.outline);
+        e.digest(self.facet);
+        e.digest(self.catalog)
+    }
+}
+pub(crate) fn prepare_primitive_receipts(
+    providers: &[crate::expand::source_declarative::SourceDeclarative],
+    maximum: usize,
+) -> Result<Vec<CompilerPrimitiveReceipt>, Diagnostic> {
+    if providers.len() > 100_000 || maximum > 64 * 1024 * 1024 {
+        return Err(fault("primitive receipt source count/byte budget"));
+    };
+    let mut bytes = providers
+        .len()
+        .checked_mul(std::mem::size_of::<CompilerPrimitiveReceipt>())
+        .filter(|n| *n <= maximum)
+        .ok_or_else(|| fault("primitive receipt allocation budget"))?;
+    let mut out = Vec::new();
+    out.try_reserve_exact(providers.len())
+        .map_err(|_| fault("primitive receipt allocation"))?;
+    for provider in providers {
+        // Canonical validation reconstructs a closed bounded catalogue; reserve
+        // its transient peak before invoking the private receipt constructor.
+        if let Some(catalog) = &provider.compiler {
+            let transient = catalog
+                .owning_profile_metadata_bytes()?
+                .checked_mul(2)
+                .ok_or_else(|| fault("primitive receipt compiler metadata overflow"))?;
+            let available = maximum
+                .checked_sub(bytes)
+                .filter(|n| *n >= transient)
+                .ok_or_else(|| fault("primitive receipt compiler metadata budget"))?;
+            if let Some(receipt) = CompilerPrimitiveReceipt::capture(
+                provider,
+                available
+                    .checked_sub(transient)
+                    .ok_or_else(|| fault("primitive receipt residual budget"))?,
+            )? {
+                bytes = bytes
+                    .checked_add(receipt.metadata_bytes())
+                    .filter(|n| *n <= maximum)
+                    .ok_or_else(|| fault("primitive receipt retained budget"))?;
+                out.push(receipt);
+            }
+        }
+    }
+    out.sort_by_key(|row| row.source.location_identity());
+    for pair in out.windows(2) {
+        if pair[0].source.location_identity() == pair[1].source.location_identity() {
+            return Err(fault("primitive receipt owning source duplicated"));
+        }
+    }
+    Ok(out)
+}
