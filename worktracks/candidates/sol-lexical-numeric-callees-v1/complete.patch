+        cfg: &crate::source::snapshot::CfgSet,
+    ) -> Result<bool, Diagnostic> {
+        let Some(p) = path.path() else {
+            return Ok(false);
+        };
+        if p.qualifier().is_some() {
+            return Ok(false);
+        }
+        let Some(name) = p.segment().and_then(|part| part.name_ref()) else {
