+            .range
+            .start
+            .checked_add(node.range.start)
+            .ok_or_else(|| error("lexical dispatch source start overflow"))?;
+        let end = body
+            .range
+            .start
+            .checked_add(node.range.end)
+            .ok_or_else(|| error("lexical dispatch source end overflow"))?;
