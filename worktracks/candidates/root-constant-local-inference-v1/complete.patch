+                    .count(),
+                5
+            );
+            assert!(source.named_constant("").is_err());
+            assert!(source.named_constant("_").is_err());
+            for marker in ["while x < 4", "if x == 4"] {
+                let at = source
+                    .declarations()
+                    .iter()
+                    .find(|d| {
