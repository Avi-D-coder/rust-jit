+    #[test]
+    fn source_scope_shadow_and_return_context_cannot_alias_other_numeric_bindings() {
+        let value = result("const A:u8={let x=7; {let x=false; x;} x};").unwrap();
+        assert_eq!(
+            value.value().scalar().unwrap(),
