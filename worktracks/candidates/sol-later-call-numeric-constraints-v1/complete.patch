+//! Direct later-call source constraint controls; no runtime pass receipt.
+use super::*;
+use crate::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::{
+        key::{OutlineKey, QueryKey},
+        memo::Database,
+        provider::SyntaxProvider,
+        value::QueryValue,
+    },
+    ir::{op::Op, pc::Phase},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput},
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParseKey,
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/numbers-arithmetic/integer-literal-suffix-inference.rs"
+);
+fn declaration(
+    text: &str,
+    edition: u16,
+    marker: &str,
+) -> Result<(Database, crate::ir::recipe::VerifiedRecipe), Diagnostic> {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let cfg = CfgSet::guest_default();
+    let path = SourcePath::new("later-call-constraints.rs")?;
+    let blob = SourceBlob::new(text.as_bytes().to_vec())?;
+    let unit = Digest::of_bytes(b"LRR exact later call numeric constraints");
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile,
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )?;
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selection)? else {
+        panic!()
+    };
+    let mut db = Database::default();
+    db.trace.detailed = true;
+    inputs.publish(&mut db)?;
+    let handle = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let at = u32::try_from(text.find(marker).unwrap()).unwrap() - handle.range.start;
+    let indexed = db
+        .fetch(&SyntaxProvider, QueryKey::BodyStructure(handle.key()))
+        .into_ready()
+        .unwrap()?;
+    let QueryValue::BodyStructure(index) = indexed.value.as_ref() else {
+        panic!()
+    };
+    let node = index
+        .nodes()
+        .iter()
+        .find(|node| {
+            node.role == crate::syntax::body_index::NodeRole::Statement && node.range.start == at
+        })
+        .unwrap();
+    let fetched = db
+        .fetch(
+            &SyntaxProvider,
+            QueryKey::Thunk(index.pc(node.id, Phase::Entry)?),
+        )
+        .into_ready()
+        .unwrap()?;
+    let QueryValue::Thunk(recipe) = fetched.value.as_ref() else {
+        panic!()
+    };
+    Ok((db, recipe.as_ref().clone()))
+}
+fn hint(text: &str, edition: u16, marker: &str) -> Result<PrimitiveType, Diagnostic> {
+    let (_, recipe) = declaration(text, edition, marker)?;
+    recipe
+        .recipe()
+        .operations
+        .iter()
+        .find_map(|op| match op {
+            Op::SetHint {
+                hint: HintRecipe::Primitive(primitive),
+                ..
+            } => Some(*primitive),
+            _ => None,
+        })
+        .ok_or_else(|| frontier("prepared numeric hint absent"))
+}
+#[test]
+fn unchanged_official_negative_bindings_take_exact_later_parameter_type_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        for (marker, expected) in [
+            ("let j = -128;", PrimitiveType::I8),
+            ("let j = -32_768;", PrimitiveType::I16),
+            ("let j = -2_147_483_648;", PrimitiveType::I32),
+            ("let j = -9_223_372_036_854_775_808;", PrimitiveType::I64),
+        ] {
+            assert_eq!(hint(ORIGINAL, edition, marker).unwrap(), expected);
+        }
+    }
+}
