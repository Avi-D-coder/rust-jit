+        "fn sink(_:i8){}fn main(){let value=3+4;sink(value);let later:i16=value;}",
+        "fn sink(_:i8){}fn main(){let value=3+4;let alias=value;sink(value);}",
+        "fn sink(_:i8)->i8{0}fn main(){let value=3+4;let alias=sink(value);}",
+    ] {
+        assert_eq!(
+            hint(source, 2024, "let value=").unwrap_err().code,
+            "LRR-E-UNSUPPORTED"
+        );
+    }
+}
+#[test]
