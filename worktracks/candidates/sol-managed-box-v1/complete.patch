+//! Closed managed heap ownership. Source/member admission belongs to the driver;
+//! these private kernels check physical agreement and never select Box by name.
+use super::*;
+use crate::runtime::shape::FacadeType;
+
+pub struct ManagedBoxRecord {
+    ty: TypeId,
+    pointee: TypeId,
+    heap: Option<CellId>,
+    owner: Option<ValueOwner>,
+    state: BoxState,
+}
+#[derive(Clone, Copy, Eq, PartialEq)]
+enum BoxState {
+    Reserved,
+    Live,
+    Draining { child: TicketId, value: ValueRepr },
+}
+#[derive(Debug, Clone, Copy, Eq, PartialEq, Ord, PartialOrd)]
+pub struct ManagedBoxId(Handle<ManagedBoxRecord>);
+impl ManagedBoxId {
+    fn from_bits(bits: u64) -> Self {
+        Self(Handle::from_bits(bits))
+    }
+    pub(crate) fn bits(self) -> u64 {
+        self.0.bits()
+    }
+}
+impl From<ManagedBoxId> for Handle<ManagedBoxRecord> {
+    fn from(id: ManagedBoxId) -> Self {
+        id.0
+    }
+}
+fn pending_pointee() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-UNSUPPORTED",
+        "managed Box requires closed primitive or primitive-array pointee; general Drop, allocator, dyn and trait/source joins remain pending".into(),
+    )
+}
+impl GuestStore {
+    pub(crate) fn managed_box_pointee_type(&self, ty: TypeId) -> Result<TypeId, Diagnostic> {
+        let TypeKey::Facade {
+            family: FacadeType::Box,
+            args,
+        } = self.types.descriptor(ty)?.key.as_ref()
+        else {
+            return Err(invalid());
+        };
+        let [pointee] = args.as_ref() else {
+            return Err(invalid());
+        };
+        self.managed_box_closed_layout(*pointee)?;
+        Ok(*pointee)
+    }
+    fn managed_box_closed_layout(&self, pointee: TypeId) -> Result<(), Diagnostic> {
+        let descriptor = self.types.descriptor(pointee)?;
+        match descriptor.key.as_ref() {
+            TypeKey::Primitive(_) if descriptor.shape == ShapeCategory::Scalar => Ok(()),
+            TypeKey::Array { element, len }
+                if usize::try_from(*len)
+                    .is_ok_and(|n| n <= super::super::object::MAX_CONSTRUCTION_FIELDS)
+                    && self.types.descriptor(*element)?.shape == ShapeCategory::Scalar
+                    && matches!(
+                        self.types.descriptor(*element)?.key.as_ref(),
+                        TypeKey::Primitive(_)
+                    ) =>
+            {
+                Ok(())
+            }
+            _ => Err(pending_pointee()),
+        }
+    }
+    pub(super) fn validate_managed_box_value(&self, value: ValueRepr) -> Result<(), Diagnostic> {
+        let record = self
+            .managed_boxes
+            .get(ManagedBoxId::from_bits(value.payload))?;
+        if value.kind != 15
+            || record.ty.0 != value.type_id
+            || self.managed_box_pointee_type(record.ty)? != record.pointee
+            || record.state == BoxState::Reserved
+            || record.heap.is_none()
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+    pub(super) fn managed_box_owner(
+        &self,
+        value: ValueRepr,
+        owner: ValueOwner,
+    ) -> Result<(), Diagnostic> {
+        self.validate_managed_box_value(value)?;
+        if self
+            .managed_boxes
+            .get(ManagedBoxId::from_bits(value.payload))?
+            .owner
+            != Some(owner)
+        {
+            return Err(ownership());
+        }
+        Ok(())
+    }
+    pub(super) fn set_managed_box_owner(
+        &mut self,
+        value: ValueRepr,
+        owner: ValueOwner,
+    ) -> Result<(), Diagnostic> {
+        self.managed_boxes
+            .get_mut(ManagedBoxId::from_bits(value.payload))?
+            .owner = Some(owner);
+        Ok(())
+    }
+    pub(super) fn managed_box_initialized(&self, value: ValueRepr) -> Result<bool, Diagnostic> {
+        self.validate_managed_box_value(value)?;
+        let record = self
+            .managed_boxes
+            .get(ManagedBoxId::from_bits(value.payload))?;
+        Ok(record.state == BoxState::Live
+            && self.cell_is_initialized(record.heap.ok_or_else(ownership)?)?)
+    }
+    /// Heap ownership is independent of the source/destination Box value cell.
+    /// Every lease lookup replays the actual current transfer owner and run arena.
+    pub(super) fn validate_managed_box_heap(
+        &self,
+        id: ManagedBoxId,
+        heap: CellId,
+        live: bool,
+    ) -> Result<(), Diagnostic> {
+        let record = self.managed_boxes.get(id)?;
+        if record.heap != Some(heap)
+            || self.cells.get(heap)?.owner != (CellOwner::ManagedBox { allocation: id })
+            || self.cells.get(heap)?.declared != StorageContract::Exact(record.pointee)
+            || record.state == BoxState::Reserved
+            || (live && record.state != BoxState::Live)
+        {
+            return Err(lease_fault());
+        }
+        if !live {
+            return Ok(());
+        }
+        let value = ValueRepr {
+            kind: 15,
+            type_id: record.ty.0,
+            payload: id.bits(),
+        };
+        match record.owner.ok_or_else(lease_fault)? {
+            ValueOwner::Cell(mut cell) => {
+                if self.admit_live_value(cell)? != value {
+                    return Err(lease_fault());
+                }
+                for _ in 0..self.budget.max_handles() {
+                    match self.initialization_parent(cell)? {
+                        Some((_, _, Some(parent))) => {
+                            self.admit_live_value(parent)?;
+                            cell = parent;
+                        }
+                        Some((_, _, None)) | None => return Ok(()),
+                    }
+                }
+                Err(resource())
+            }
+            ValueOwner::Ticket(ticket) if self.peek_ticket(ticket)? == value => Ok(()),
+            ValueOwner::Construction { guard, field }
+                if self.constructions.get(guard)?.state == ConstructionState::Building
+                    && self.constructions.get(guard)?.pending_cleanup.is_none()
+                    && self.constructions.get(guard)?.fields.get(field as usize)
+                        == Some(&Some(value)) =>
+            {
+                Ok(())
+            }
+            _ => Err(lease_fault()),
+        }
+    }
+    pub(crate) fn preflight_managed_box(
+        &self,
+        ty: TypeId,
+        incoming: TicketId,
+    ) -> Result<(), Diagnostic> {
+        let pointee = self.managed_box_pointee_type(ty)?;
+        let value = self.peek_ticket(incoming)?;
+        self.object_owner(value, ValueOwner::Ticket(incoming))?;
+        self.require_initialized_value(value)?;
+        if TypeId(value.type_id) != pointee || !matches!(value.kind, 1..=8) {
+            return Err(ownership());
+        }
+        let bytes = self
+            .managed_boxes
+            .reservation_bytes(1)?
+            .checked_add(self.cells.reservation_bytes(1)?)
+            .and_then(|n| n.checked_add(self.tickets.reservation_bytes(1).ok()?))
+            .ok_or_else(resource)?;
+        self.budget.check(3, bytes)
+    }
+    /// One fixed transaction, never a recursive copy or pointee evaluation.
+    /// Exact pointee ticket ownership transfers once into a fresh stable cell.
+    pub(crate) fn construct_managed_box(
+        &mut self,
+        ty: TypeId,
+        incoming: TicketId,
+    ) -> Result<TicketId, Diagnostic> {
+        self.preflight_managed_box(ty, incoming)?;
+        self.managed_boxes.reserve(1, &mut self.budget)?;
+        self.cells.reserve(1, &mut self.budget)?;
+        self.tickets.reserve(1, &mut self.budget)?;
+        self.preflight_managed_box(ty, incoming)?;
+        let pointee = self.managed_box_pointee_type(ty)?;
+        let value = self.peek_ticket(incoming)?;
+        let id = ManagedBoxId(self.managed_boxes.allocate(
+            ManagedBoxRecord {
+                ty,
+                pointee,
+                heap: None,
+                owner: None,
+                state: BoxState::Reserved,
+            },
+            0,
+            &mut self.budget,
+        )?);
+        let heap = CellId::from(self.cells.allocate(
+            Cell {
+                state: CellState::Uninit,
+                declared: StorageContract::Exact(pointee),
+                writable: true,
+                location_epoch: 1,
+                owner: CellOwner::ManagedBox { allocation: id },
+                retired: false,
+                numeric_record: None,
+            },
+            0,
+            &mut self.budget,
+        )?);
+        let result = TicketId::from(self.tickets.allocate(
+            TransferTicket {
+                value: ValueRepr {
+                    kind: 15,
+                    type_id: ty.0,
+                    payload: id.bits(),
+                },
+            },
+            0,
+            &mut self.budget,
+        )?);
+        self.tickets.take(incoming, &mut self.budget)?;
+        self.set_owner(value, ValueOwner::Cell(heap))?;
+        self.cells.get_mut(heap)?.state = CellState::Live(value);
+        let record = self.managed_boxes.get_mut(id)?;
+        record.heap = Some(heap);
+        record.owner = Some(ValueOwner::Ticket(result));
+        record.state = BoxState::Live;
+        Ok(result)
+    }
+    fn managed_box_receiver(
+        &self,
+        receiver: &Place,
+        access: Access,
+    ) -> Result<(ManagedBoxId, CellId), PlaceFailure> {
+        let place = self.resolve_place(receiver)?;
+        if access == Access::Mutable && !place.writable {
+            return Err(access_fault().into());
+        }
+        let value = self.admit_move(place.target.cell)?;
+        if value.kind != 15 {
+            return Err(invalid().into());
+        }
+        let id = ManagedBoxId::from_bits(value.payload);
+        let heap = self.managed_boxes.get(id)?.heap.ok_or_else(ownership)?;
+        self.validate_managed_box_heap(id, heap, true)?;
+        self.place_stamp(heap)?;
+        Ok((id, heap))
+    }
+    pub(crate) fn preflight_managed_box_borrow(
+        &self,
+        receiver: &Place,
+        access: Access,
+    ) -> Result<TypeId, PlaceFailure> {
+        let (id, heap) = self.managed_box_receiver(receiver, access)?;
+        let place = Place::cell(heap);
+        self.admit_place_borrow(&place, access)?;
+        Ok(self.managed_boxes.get(id)?.pointee)
+    }
+    pub(crate) fn reserve_managed_box_borrow(
+        &mut self,
+        receiver: &Place,
+        access: Access,
+    ) -> Result<(), PlaceFailure> {
+        let (_, heap) = self.managed_box_receiver(receiver, access)?;
+        self.reserve_place_borrow_result(&Place::cell(heap), false)
+    }
+    pub(crate) fn borrow_managed_box(
+        &mut self,
+        receiver: &Place,
+        access: Access,
+    ) -> Result<TicketId, PlaceFailure> {
+        let (_, heap) = self.managed_box_receiver(receiver, access)?;
+        self.borrow_ticket(&Place::cell(heap), access)
+    }
+    pub(crate) fn preflight_managed_box_cleanup(
+        &self,
+        parent: TicketId,
+    ) -> Result<(ManagedBoxId, CellId), Diagnostic> {
+        let value = self.peek_ticket(parent)?;
+        self.managed_box_owner(value, ValueOwner::Ticket(parent))?;
+        let id = ManagedBoxId::from_bits(value.payload);
+        let record = self.managed_boxes.get(id)?;
+        if record.state != BoxState::Live {
+            return Err(ownership());
+        }
+        let heap = record.heap.ok_or_else(ownership)?;
+        self.validate_managed_box_heap(id, heap, true)?;
+        self.admit_cleanup_cell(heap)?;
+        self.prepare_initialization_change(heap, false)?;
+        self.budget.check(1, self.tickets.reservation_bytes(1)?)?;
+        Ok((id, heap))
+    }
+    pub(crate) fn begin_managed_box_cleanup(
+        &mut self,
+        parent: TicketId,
+    ) -> Result<(CellId, TicketId), Diagnostic> {
+        let (id, heap) = self.preflight_managed_box_cleanup(parent)?;
+        let child = self.begin_drop(heap)?;
+        let value = self.peek_ticket(child)?;
+        self.managed_boxes.get_mut(id)?.state = BoxState::Draining { child, value };
+        Ok((heap, child))
+    }
+    pub(crate) fn preflight_finish_managed_box_cleanup(
+        &self,
+        parent: TicketId,
+        heap: CellId,
+        child: TicketId,
+    ) -> Result<(), Diagnostic> {
+        let value = self.peek_ticket(parent)?;
+        self.managed_box_owner(value, ValueOwner::Ticket(parent))?;
+        let id = ManagedBoxId::from_bits(value.payload);
+        let record = self.managed_boxes.get(id)?;
+        let BoxState::Draining {
+            child: expected,
+            value: old,
+        } = record.state
+        else {
+            return Err(ownership());
+        };
+        if expected != child
+            || record.heap != Some(heap)
+            || self.state(heap)? != CellState::Dropping
+        {
+            return Err(ownership());
+        }
+        match self.tickets.get(child) {
+            Err(error) if error.code == "LRR-E-STALE-HANDLE" => {}
+            _ => return Err(ownership()),
+        }
+        if old.kind == 8 {
+            match self.objects.get(ObjectId::from_bits(old.payload)) {
+                Err(error) if error.code == "LRR-E-STALE-HANDLE" => {}
+                _ => return Err(ownership()),
+            }
+        }
+        self.validate_managed_box_heap(id, heap, false)
+    }
+    pub(crate) fn finish_managed_box_cleanup(
+        &mut self,
+        parent: TicketId,
+        heap: CellId,
+        child: TicketId,
+    ) -> Result<(), Diagnostic> {
+        self.preflight_finish_managed_box_cleanup(parent, heap, child)?;
+        let value = self.peek_ticket(parent)?;
+        let id = ManagedBoxId::from_bits(value.payload);
+        self.retire_cell(heap)?;
+        self.tickets.take(parent, &mut self.budget)?;
+        self.managed_boxes.take(id, &mut self.budget)?;
+        Ok(())
+    }
+}
+
