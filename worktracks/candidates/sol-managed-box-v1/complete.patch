+fn numbers(source: &str, function: &str) -> Vec<i64> {
+    let parse = ast::SourceFile::parse(source, Edition::Edition2024);
+    assert!(parse.errors().is_empty());
+    let function = parse
+        .tree()
+        .syntax()
+        .descendants()
+        .filter_map(ast::Fn::cast)
+        .find(|f| f.name().is_some_and(|name| name.text() == function))
+        .unwrap();
+    function
+        .body()
+        .unwrap()
+        .syntax()
+        .descendants()
+        .filter_map(ast::Literal::cast)
+        .filter_map(|literal| literal.syntax().text().to_string().parse().ok())
+        .collect()
+}
+fn ty(store: &mut GuestStore, pointee: TypeId) -> TypeId {
+    store
+        .intern_type(TypeKey::Facade {
+            family: FacadeType::Box,
+            args: Box::new([pointee]),
+        })
+        .unwrap()
+}
+fn cell(store: &mut GuestStore, ticket: TicketId, writable: bool) -> CellId {
+    let ty = TypeId(store.peek_ticket(ticket).unwrap().type_id);
+    let frame = store.new_frame_anchor().unwrap();
+    let cell = store
+        .new_cell(
+            StorageContract::Exact(ty),
+            writable,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    store.initialize(cell, ticket).unwrap();
+    cell
+}
+fn scalar(store: &mut GuestStore, value: i64, writable: bool) -> CellId {
+    scalar_with_type(store, value, TypeId(6), writable)
+}
+fn scalar_with_type(store: &mut GuestStore, value: i64, pointee: TypeId, writable: bool) -> CellId {
+    let box_ty = ty(store, pointee);
+    let ticket = store
+        .ticket(ValueRepr::signed(pointee, value).unwrap())
+        .unwrap();
+    let boxed = store.construct_managed_box(box_ty, ticket).unwrap();
+    cell(store, boxed, writable)
+}
+fn reference(store: &mut GuestStore, root: CellId, access: Access) -> RefId {
+    let ticket = store
+        .borrow_managed_box(&Place::cell(root), access)
+        .unwrap();
+    RefId::from_bits(store.peek_ticket(ticket).unwrap().payload)
+}
+fn drain(store: &mut GuestStore, parent: TicketId) {
+    let mut fuel = RunFuel::new(100_000).unwrap();
+    let mut cleanup =
+        ManagedBoxCleanup::begin_closed_box_cleanup_physical(store, &mut fuel, parent, 4096)
+            .unwrap();
+    loop {
+        match cleanup.advance(store, &mut fuel).unwrap() {
+            ManagedBoxCleanupProgress::Advanced { .. } => {}
+            ManagedBoxCleanupProgress::Complete => break,
+            ManagedBoxCleanupProgress::Failed(error) => panic!("{}", error.code),
+        }
+    }
+}
+fn array(store: &mut GuestStore, count: u32, value: i64) -> (CellId, Vec<CellId>) {
+    let pointee = store
+        .intern_type(TypeKey::Array {
+            element: TypeId(4),
+            len: count,
+        })
+        .unwrap();
+    let guard = store
+        .begin_construction(&vec![TypeId(4); count as usize])
+        .unwrap();
+    for ordinal in 0..count {
+        let ticket = store
+            .ticket(ValueRepr::signed(TypeId(4), value).unwrap())
+            .unwrap();
+        store.construction_push(guard, ordinal, ticket).unwrap();
+    }
+    let ticket = store.commit_construction(guard, pointee).unwrap();
+    let fields = (0..count)
+        .map(|i| store.aggregate_field(ticket, i).unwrap())
+        .collect();
+    let box_ty = ty(store, pointee);
+    let boxed = store.construct_managed_box(box_ty, ticket).unwrap();
+    (cell(store, boxed, true), fields)
+}
