+#[path = "managed_box_storage_tests.rs"]
+mod tests;
+
+impl GuestStore {
+    /// Completion acknowledgement is stricter than losing one transfer ticket.
+    pub(super) fn require_managed_box_retired(&self, value: ValueRepr) -> Result<(), Diagnostic> {
+        match self
+            .managed_boxes
+            .get(ManagedBoxId::from_bits(value.payload))
+        {
+            Err(error) if error.code == "LRR-E-STALE-HANDLE" => Ok(()),
+            _ => Err(ownership()),
+        }
+    }
+}
+
+impl GuestStore {
+    /// Closed pointees are Copy. A source read must copy rather than destructively
+    /// extracting their location. General moving deref/drop-field propagation
+    /// requires the later source/ownership slice, not a stale enclosing summary.
+    pub(super) fn refuse_closed_box_pointee_move(
+        &self,
+        mut cell: CellId,
+    ) -> Result<(), Diagnostic> {
+        for _ in 0..self.budget.max_handles() {
+            if matches!(self.cells.get(cell)?.owner, CellOwner::ManagedBox { .. }) {
+                return Err(Diagnostic::new("LRR-E-UNSUPPORTED", "closed Box pointee reads require Copy; destructive pointee extraction is not admitted".into()));
+            }
+            match self.cells.get(cell)?.owner {
+                CellOwner::Field { object, index } => {
+                    let record = self.objects.get(object)?;
+                    let ObjectStorage::Aggregate(storage) = &record.storage else {
+                        return Ok(());
+                    };
+                    if storage.fields.get(index as usize) != Some(&cell) {
+                        return Err(ownership());
+                    }
+                    match record.owner {
+                        Some(ValueOwner::Cell(parent)) => cell = parent,
+                        _ => return Ok(()),
+                    }
+                }
+                // Buffer/value roots do not acquire a Box admission premise.
+                // Their existing extraction guards retain their own diagnostics.
+                CellOwner::FrameSlot { .. } | CellOwner::Transfer(_) | CellOwner::Buffer { .. } => {
+                    return Ok(());
+                }
+                CellOwner::ManagedBox { .. } => unreachable!("Box heap was refused above"),
+            }
+        }
+        Err(resource())
+    }
+}
