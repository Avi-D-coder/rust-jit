+//! Supplemental physical controls: there is no source-selected Box dispatch yet.
+use super::*;
+use crate::runtime::{
+    cell::{CellOwner, CellState, StorageContract},
+    shape::{FacadeType, TypeKey},
+    value::ValueRepr,
+};
+use ra_ap_syntax::{
+    Edition,
+    ast::{self, AstNode},
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/box/box-fixed-array-coerce-unsized-match.rs"
+);
+fn box_type(store: &mut GuestStore, element: TypeId) -> TypeId {
+    store
+        .intern_type(TypeKey::Facade {
+            family: FacadeType::Box,
+            args: Box::new([element]),
+        })
+        .unwrap()
+}
+fn written_repeat() -> (i64, u32) {
+    let parse = ast::SourceFile::parse(ORIGINAL, Edition::Edition2024);
+    assert!(parse.errors().is_empty());
+    let function = parse
+        .tree()
+        .syntax()
+        .descendants()
+        .filter_map(ast::Fn::cast)
+        .find(|f| f.name().is_some_and(|name| name.text() == "box_2"))
+        .unwrap();
+    let values: Vec<i64> = function
+        .body()
+        .unwrap()
+        .syntax()
+        .descendants()
+        .filter_map(ast::Literal::cast)
+        .filter_map(|literal| literal.syntax().text().to_string().parse().ok())
+        .collect();
+    (values[0], u32::try_from(values[1]).unwrap())
+}
+fn array_box(store: &mut GuestStore) -> (TicketId, Vec<CellId>, CellId) {
+    let (value, count) = written_repeat();
+    let element = TypeId(4);
+    let array_ty = store
+        .intern_type(TypeKey::Array {
+            element,
+            len: count,
+        })
+        .unwrap();
+    let guard = store
+        .begin_construction(&vec![element; count as usize])
+        .unwrap();
+    for i in 0..count {
+        let ticket = store
+            .ticket(ValueRepr::signed(element, value).unwrap())
+            .unwrap();
+        store.construction_push(guard, i, ticket).unwrap();
+    }
+    let array = store.commit_construction(guard, array_ty).unwrap();
+    let fields = (0..count)
+        .map(|i| store.aggregate_field(array, i).unwrap())
+        .collect();
+    let ty = box_type(store, array_ty);
+    let parent = store.construct_managed_box(ty, array).unwrap();
+    let frame = store.new_frame_anchor().unwrap();
+    let cell = store
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    store.initialize(cell, parent).unwrap();
+    let parent = store.begin_drop(cell).unwrap();
+    (parent, fields, cell)
+}
+#[test]
+fn managed_box_constructor_fuel_quota_and_cancel_refusals_preserve_exact_incoming_owner() {
+    for case in 0..3 {
+        let mut store = GuestStore::new(1, if case == 1 { 3 } else { 100 }, 1_000_000).unwrap();
+        let ty = box_type(&mut store, TypeId(6));
+        let incoming = store
+            .ticket(ValueRepr::signed(TypeId(6), 7).unwrap())
+            .unwrap();
+        let value = store.peek_ticket(incoming).unwrap();
+        let handles = store.budget().handles();
+        let mut fuel = RunFuel::new(if case == 0 { 0 } else { 100 }).unwrap();
+        if case == 2 {
+            fuel.cancellation().cancel();
+        }
+        assert_eq!(
+            construct_closed_box_physical(&mut store, &mut fuel, ty, incoming)
+                .unwrap_err()
+                .code,
+            "LRR-E-RUNTIME-RESOURCE"
+        );
+        assert_eq!(store.peek_ticket(incoming).unwrap(), value);
+        assert_eq!(store.budget().handles(), handles);
+        assert_eq!(fuel.snapshot().used, 0);
+    }
+}
+#[test]
+fn managed_box_original_array_cleanup_is_bounded_one_field_and_exact_once_charged() {
+    let mut store = GuestStore::new(1, 10000, 1_000_000).unwrap();
+    let (parent, fields, _) = array_box(&mut store);
+    let count = fields.len();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut cleanup =
+        ManagedBoxCleanup::begin_closed_box_cleanup_physical(&mut store, &mut fuel, parent, 4096)
+            .unwrap();
+    assert_eq!(fuel.snapshot().used, 1);
+    for i in 0..count {
+        assert!(matches!(
+            cleanup.advance(&mut store, &mut fuel).unwrap(),
+            ManagedBoxCleanupProgress::Advanced { stopping: false }
+        ));
+        assert_eq!(cleanup.fields_processed() as usize, i + 1);
+        assert_eq!(fuel.snapshot().used as usize, i + 2);
+        assert_eq!(store.state(fields[i]).unwrap(), CellState::Dropped);
+        assert!(store.peek_ticket(parent).is_ok());
+        assert!(cleanup.cleanup_pending());
+    }
+    assert!(matches!(
+        cleanup.advance(&mut store, &mut fuel).unwrap(),
+        ManagedBoxCleanupProgress::Advanced { stopping: false }
+    ));
+    assert!(matches!(
+        cleanup.advance(&mut store, &mut fuel).unwrap(),
+        ManagedBoxCleanupProgress::Complete
+    ));
+    assert!(!cleanup.cleanup_pending());
+    assert_eq!(fuel.snapshot().used as usize, count + 1);
+    assert_eq!(
+        store.peek_ticket(parent).unwrap_err().code,
+        "LRR-E-STALE-HANDLE"
+    );
+}
+#[test]
+fn managed_box_cancelled_array_cleanup_retains_failure_and_drains_before_terminal() {
+    let mut store = GuestStore::new(1, 10000, 1_000_000).unwrap();
+    let (parent, fields, _) = array_box(&mut store);
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut cleanup =
+        ManagedBoxCleanup::begin_closed_box_cleanup_physical(&mut store, &mut fuel, parent, 4096)
+            .unwrap();
+    assert!(matches!(
+        cleanup.advance(&mut store, &mut fuel).unwrap(),
+        ManagedBoxCleanupProgress::Advanced { stopping: false }
+    ));
+    let used = fuel.snapshot().used;
+    fuel.cancellation().cancel();
+    for expected in 2..=fields.len() {
+        assert!(matches!(
+            cleanup.advance(&mut store, &mut fuel).unwrap(),
+            ManagedBoxCleanupProgress::Advanced { stopping: true }
+        ));
+        assert_eq!(cleanup.fields_processed() as usize, expected);
+        assert!(cleanup.cleanup_pending());
+        assert_eq!(fuel.snapshot().used, used);
+    }
+    assert!(matches!(
+        cleanup.advance(&mut store, &mut fuel).unwrap(),
+        ManagedBoxCleanupProgress::Advanced { stopping: true }
+    ));
+    let ManagedBoxCleanupProgress::Failed(error) = cleanup.advance(&mut store, &mut fuel).unwrap()
+    else {
+        panic!("interrupted cleanup cannot succeed")
+    };
+    assert_eq!(error.code, "LRR-E-RUNTIME-RESOURCE");
+    assert!(!cleanup.cleanup_pending());
+    assert_eq!(fuel.snapshot().used, used);
+    assert!(
+        fields
+            .into_iter()
+            .all(|cell| store.state(cell).unwrap() == CellState::Dropped)
+    );
+    assert_eq!(
+        store.peek_ticket(parent).unwrap_err().code,
+        "LRR-E-STALE-HANDLE"
+    );
+}
+#[test]
+fn managed_box_cleanup_metadata_refusal_preserves_heap_lease_and_parent_ticket() {
+    let mut store = GuestStore::new(1, 1000, 1_000_000).unwrap();
+    let ty = box_type(&mut store, TypeId(6));
+    let incoming = store
+        .ticket(ValueRepr::signed(TypeId(6), 7).unwrap())
+        .unwrap();
+    let parent = store.construct_managed_box(ty, incoming).unwrap();
+    let frame = store.new_frame_anchor().unwrap();
+    let cell = store
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    store.initialize(cell, parent).unwrap();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let reference =
+        borrow_closed_box_physical(&mut store, &mut fuel, &Place::cell(cell), Access::Shared)
+            .unwrap();
+    let reference =
+        crate::runtime::cell::RefId::from_bits(store.peek_ticket(reference).unwrap().payload);
+    let parent = store.begin_drop(cell).unwrap();
+    let used = fuel.snapshot().used;
+    assert!(
+        ManagedBoxCleanup::begin_closed_box_cleanup_physical(
+            &mut store,
+            &mut fuel,
+            parent,
+            ManagedBoxCleanup::metadata_bytes() - 1
+        )
+        .is_err()
+    );
+    assert_eq!(fuel.snapshot().used, used);
+    assert!(store.peek_ticket(parent).is_ok());
+    assert_eq!(store.read_reference(reference).unwrap().payload, 7);
+}
+
+#[test]
+fn managed_box_stop_before_cleanup_entry_does_not_reset_fuel_or_claim_success() {
+    let mut store = GuestStore::new(1, 10000, 1_000_000).unwrap();
+    let (parent, fields, _) = array_box(&mut store);
+    let mut fuel = RunFuel::new(0).unwrap();
+    let mut cleanup =
+        ManagedBoxCleanup::begin_closed_box_cleanup_physical(&mut store, &mut fuel, parent, 4096)
+            .unwrap();
+    for _ in 0..=fields.len() {
+        assert!(matches!(
+            cleanup.advance(&mut store, &mut fuel).unwrap(),
+            ManagedBoxCleanupProgress::Advanced { stopping: true }
+        ));
+        assert!(cleanup.cleanup_pending());
+        assert_eq!(fuel.snapshot().used, 0);
+    }
+    assert!(matches!(
+        cleanup.advance(&mut store, &mut fuel).unwrap(),
+        ManagedBoxCleanupProgress::Failed(_)
+    ));
+    assert!(!cleanup.cleanup_pending());
+    assert_eq!(fuel.snapshot().used, 0);
+    assert_eq!(
+        store.peek_ticket(parent).unwrap_err().code,
+        "LRR-E-STALE-HANDLE"
+    );
+}
