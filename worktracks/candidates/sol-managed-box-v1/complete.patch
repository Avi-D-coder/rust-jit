--- /dev/null
+++ b/crates/lrr/src/vm/managed_box.rs
@@ -0,0 +1,165 @@
+//! Private physical Box joins. These methods do not admit source syntax or select
+//! any library member. The driver must first replay the real selected-source
+//! Box/member/pointee proof described in ROOT-HOOKS.md; no such producer exists
+//! in this packet. No method is a public protocol or name/descriptor dispatcher.
+use crate::{
+    core::diagnostic::Diagnostic,
+    runtime::{
+        cell::{AggregateCleanupTransfer, CellId, CleanupFieldAdmission, GuestStore, TicketId},
+        place::{Place, PlaceFailure},
+        reference::Access,
+        shape::TypeId,
+    },
+    vm::fuel::RunFuel,
+};
+
+pub(crate) fn construct_closed_box_physical(
+    store: &mut GuestStore,
+    fuel: &mut RunFuel,
+    ty: TypeId,
+    incoming: TicketId,
+) -> Result<TicketId, Diagnostic> {
+    store.preflight_managed_box(ty, incoming)?;
+    fuel.charge()?;
+    store.construct_managed_box(ty, incoming)
+}
+pub(crate) fn borrow_closed_box_physical(
+    store: &mut GuestStore,
+    fuel: &mut RunFuel,
+    receiver: &Place,
+    access: Access,
+) -> Result<TicketId, PlaceFailure> {
+    store.preflight_managed_box_borrow(receiver, access)?;
+    fuel.charge()?;
+    store.reserve_managed_box_borrow(receiver, access)?;
+    store.borrow_managed_box(receiver, access)
+}
+fn mismatch() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-OWNERSHIP",
+        "managed Box cleanup activation differs".into(),
+    )
+}
+/// One owned Box/pointee continuation. No source/DB/arena borrow survives return.
+/// Source-specific general Drop is excluded by the initial closed pointee proof.
+pub(crate) struct ManagedBoxCleanup {
+    epoch: u32,
+    parent: TicketId,
+    heap: CellId,
+    child: TicketId,
+    array: bool,
+    child_retired: bool,
+    stopped: Option<Diagnostic>,
+    done: bool,
+    fields: u32,
+}
+pub(crate) enum ManagedBoxCleanupProgress {
+    Advanced { stopping: bool },
+    Complete,
+    Failed(Diagnostic),
+}
+impl ManagedBoxCleanup {
+    pub(crate) fn metadata_bytes() -> usize {
+        std::mem::size_of::<Self>()
+    }
+    pub(crate) fn begin_closed_box_cleanup_physical(
+        store: &mut GuestStore,
+        fuel: &mut RunFuel,
+        parent: TicketId,
+        metadata_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        let (_, heap) = store.preflight_managed_box_cleanup(parent)?;
+        let value = store.admit_move(heap)?;
+        if Self::metadata_bytes() > metadata_limit {
+            return Err(crate::runtime::arena::resource());
+        }
+        // Only a closed scalar or primitive array was physically admitted.
+        let array = value.kind == 8;
+        // A genuine stop is retained as a failure. The already owned closed
+        // pointee may drain without running guest callbacks or resetting fuel.
+        let stopped = fuel.poll().and_then(|_| fuel.charge()).err();
+        let (heap, child) = store.begin_managed_box_cleanup(parent)?;
+        Ok(Self {
+            epoch: store.budget().epoch(),
+            parent,
+            heap,
+            child,
+            array,
+            child_retired: false,
+            stopped,
+            done: false,
+            fields: 0,
+        })
+    }
+    pub(crate) fn fields_processed(&self) -> u32 {
+        self.fields
+    }
+    pub(crate) fn cleanup_pending(&self) -> bool {
+        !self.done
+    }
+    /// At most one array field per dispatch. A real stop retains its diagnostic
+    /// while closed cleanup drains private obligations without new guest fuel.
+    /// No interrupted cleanup is projected to a successful completion.
+    pub(crate) fn advance(
+        &mut self,
+        store: &mut GuestStore,
+        fuel: &mut RunFuel,
+    ) -> Result<ManagedBoxCleanupProgress, Diagnostic> {
+        if self.done || store.budget().epoch() != self.epoch {
+            return Err(mismatch());
+        }
+        if self.stopped.is_none()
+            && let Err(error) = fuel.poll()
+        {
+            self.stopped = Some(error);
+        }
+        if !self.child_retired {
+            if self.array {
+                let admission = store.cleanup_next_field(self.child)?;
+                if matches!(
+                    admission,
+                    CleanupFieldAdmission::Live | CleanupFieldAdmission::Skip
+                ) {
+                    if self.stopped.is_none()
+                        && let Err(error) = fuel.charge()
+                    {
+                        self.stopped = Some(error);
+                    }
+                    let fields = self
+                        .fields
+                        .checked_add(1)
+                        .ok_or_else(crate::runtime::arena::resource)?;
+                    match store.aggregate_cleanup_transfer(self.child)? {
+                        AggregateCleanupTransfer::Field { cell, ticket } => {
+                            // Closed primitive elements cannot run callbacks or
+                            // suspend. A transferred field is still acknowledged
+                            // by its exact ticket and location before advancing.
+                            store.discard(ticket)?;
+                            store.finish_aggregate_cleanup_field(self.child, cell, ticket)?;
+                        }
+                        AggregateCleanupTransfer::Skipped => {}
+                        AggregateCleanupTransfer::Complete => return Err(mismatch()),
+                    }
+                    self.fields = fields;
+                    return Ok(ManagedBoxCleanupProgress::Advanced {
+                        stopping: self.stopped.is_some(),
+                    });
+                }
+            }
+            store.discard(self.child)?;
+            self.child_retired = true;
+            return Ok(ManagedBoxCleanupProgress::Advanced {
+                stopping: self.stopped.is_some(),
+            });
+        }
+        store.finish_managed_box_cleanup(self.parent, self.heap, self.child)?;
+        self.done = true;
+        Ok(match self.stopped.take() {
+            Some(error) => ManagedBoxCleanupProgress::Failed(error),
+            None => ManagedBoxCleanupProgress::Complete,
+        })
+    }
+}
