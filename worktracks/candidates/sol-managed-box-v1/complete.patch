+#[test]
+fn managed_box_unit_array_cleanup_charges_every_zero_size_field() {
+    let count = written_repeat().1;
+    let mut store = GuestStore::new(1, 10000, 1_000_000).unwrap();
+    let array_ty = store
+        .intern_type(TypeKey::Array {
+            element: TypeId(1),
+            len: count,
+        })
+        .unwrap();
+    let guard = store
+        .begin_construction(&vec![TypeId(1); count as usize])
+        .unwrap();
+    for i in 0..count {
+        let unit = store.ticket(ValueRepr::unit()).unwrap();
+        store.construction_push(guard, i, unit).unwrap();
+    }
+    let array = store.commit_construction(guard, array_ty).unwrap();
+    let ty = box_type(&mut store, array_ty);
+    let parent = store.construct_managed_box(ty, array).unwrap();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut cleanup =
+        ManagedBoxCleanup::begin_closed_box_cleanup_physical(&mut store, &mut fuel, parent, 4096)
+            .unwrap();
+    while cleanup.cleanup_pending() {
+        match cleanup.advance(&mut store, &mut fuel).unwrap() {
+            ManagedBoxCleanupProgress::Advanced { stopping: false }
+            | ManagedBoxCleanupProgress::Complete => {}
+            _ => panic!("unit field cleanup differs"),
+        }
+    }
+    assert_eq!(cleanup.fields_processed(), count);
+    assert_eq!(fuel.snapshot().used, u64::from(count) + 1);
+}
