@@ -0,0 +1,66 @@
+//! Real pinned generated declaration groups. Component facts, never scope authority.
+use super::{DefinitionCapture, DefinitionDialect};
+use crate::{AdapterError, span_store::SpanStore};
+use syntax::{
+    AstNode,
+    ast::{self, HasName},
+};
+fn error(message: &str) -> AdapterError {
+    AdapterError {
+        code: "LRR-E-MACRO-OUTPUT",
+        message: message.into(),
+    }
+}
+pub(crate) fn capture_definition(
+    node: &syntax::SyntaxNode,
+    map: &span::SpanMap,
+    store: &SpanStore,
+) -> Result<Option<DefinitionCapture>, AdapterError> {
+    let (dialect, keyword, name, args, body) = if let Some(m) = ast::MacroRules::cast(node.clone())
+    {
+        (
+            DefinitionDialect::Rules,
+            m.macro_rules_token(),
+            m.name(),
+            None,
+            m.token_tree(),
+        )
+    } else if let Some(m) = ast::MacroDef::cast(node.clone()) {
+        (
+            DefinitionDialect::Macro2,
+            m.macro_token(),
+            m.name(),
+            m.args(),
+            m.body(),
+        )
+    } else {
+        return Ok(None);
+    };
+    let keyword = keyword.ok_or_else(|| error("generated definition keyword absent"))?;
+    let name = name.ok_or_else(|| error("generated definition name absent"))?;
+    let body = body.ok_or_else(|| error("generated definition body absent"))?;
+    let source = map.span_at(keyword.text_range().start());
+    let body = super::group(body.syntax(), map, source, store)?;
+    let arguments = args
+        .map(|args| super::group(args.syntax(), map, source, store))
+        .transpose()?;
+    body.allocated_bytes()?
+        .checked_add(
+            arguments
+                .as_ref()
+                .map(|a| a.allocated_bytes())
+                .transpose()?
+                .unwrap_or(0),
+        )
+        .filter(|n| *n <= 32 * 1024 * 1024)
+        .ok_or_else(|| error("generated definition groups exceed metadata limit"))?;
+    Ok(Some(DefinitionCapture {
+        dialect,
+        arguments,
+        start: u32::from(node.text_range().start()),
+        end: u32::from(node.text_range().end()),
+        name_span: store.key(map.span_at(name.syntax().text_range().start()))?,
+        body,
+        edition: source.ctx.edition(store.database()).number() as u16,
+    }))
+}
