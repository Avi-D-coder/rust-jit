diff --git a/crates/lrr/src/expand/generated_definition_capture.rs b/crates/lrr/src/expand/generated_definition_capture.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/expand/generated_definition_capture.rs
@@ -0,0 +1,62 @@
+//! Privately retained matched item capture; data cannot publish a namespace.
+use super::*;
+#[derive(Debug, Clone)]
+pub(super) struct GeneratedDefinitionCapture {
+    pub(super) edition: u16,
+    pub(super) body: TokenForest,
+    pub(super) arguments: Option<TokenForest>,
+    pub(super) dialect: lrr_expand_adapter::declaration_output::DefinitionDialect,
+}
+impl GeneratedDefinitionCapture {
+    pub(super) fn admit(
+        header: &GeneratedHeader,
+        dialect: lrr_expand_adapter::declaration_output::DefinitionDialect,
+        edition: u16,
+        body: TokenForest,
+        arguments: Option<TokenForest>,
+    ) -> Result<Self, Diagnostic> {
+        use lrr_expand_adapter::declaration_output::DefinitionDialect;
+        let expected = match header.kind {
+            GeneratedHeaderKind::MacroRules => DefinitionDialect::Rules,
+            GeneratedHeaderKind::Macro2 => DefinitionDialect::Macro2,
+            _ => {
+                return Err(fault(
+                    "LRR-E-EXPANSION-INPUT",
+                    "generated definition capture is not a macro header",
+                ));
+            }
+        };
+        if dialect != expected
+            || !matches!(edition, 2015 | 2018 | 2021 | 2024)
+            || (dialect == DefinitionDialect::Rules && arguments.is_some())
+        {
+            return Err(fault(
+                "LRR-E-EXPANSION-INPUT",
+                "generated definition dialect/edition differs",
+            ));
+        }
+        let bytes = body
+            .encoded_len()
+            .map_err(|e| fault(e.code, &e.message))?
+            .checked_add(
+                arguments
+                    .as_ref()
+                    .map(TokenForest::encoded_len)
+                    .transpose()
+                    .map_err(|e| fault(e.code, &e.message))?
+                    .unwrap_or(0),
+            );
+        bytes.filter(|n| *n <= 32 * 1024 * 1024).ok_or_else(|| {
+            fault(
+                "LRR-E-METADATA-LIMIT",
+                "generated definition groups exceed metadata ceiling",
+            )
+        })?;
+        Ok(Self {
+            edition,
+            body,
+            arguments,
+            dialect,
+        })
+    }
+}
