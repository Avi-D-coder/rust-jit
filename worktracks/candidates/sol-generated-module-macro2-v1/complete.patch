+        let refusal = declarations
+            .macro2_definition(local.identity)
+            .err()
+            .unwrap();
+        assert_eq!(refusal.code, "LRR-E-MACRO2-SOURCE");
+        assert!(
+            declarations
+                .scan()
+                .macro_definitions()
+                .iter()
+                .any(|h| h.name == "from_prelude")
+        );
+        assert!(
+            declarations
+                .scan()
+                .macro_definitions()
+                .iter()
+                .all(|h| h.name != "m")
+        );
+    }
