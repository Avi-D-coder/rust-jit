+            SourceUnitInput,
+        },
+        dependencies::SourceDependency,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{
+        declaration_scan::{DeclarationScanLimits, DeclarationScopeKind},
+        parse::{ParseKey, ParsedFile},
+        token_wire::{Key, TokenTree},
+    },
+};
+const MODERN: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/hygiene/dollar-crate-modern.rs"
+);
+const INTERCRATE: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/hygiene/auxiliary/intercrate.rs"
+);
+const SHADOW: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/macros/macro-shadowing-relaxed.rs"
+);
+const MACRO_AUX: &str = include_str!(
+    "../../../../../fixtures/upstream/rustc-checkout/tests/ui/macros/auxiliary/macro-in-other-crate.rs"
+);
+fn unit(text: &str, path: &str, key: Digest, edition: u16) -> SourceUnitInput {
+    SourceUnitInput {
+        path: SourcePath::new(path).unwrap(),
+        crate_key: key,
+        module_path: vec![],
+        profile: ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+        cfg: CfgSet::guest_default(),
+        blob: SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+    }
+}
+fn prepare(
+    units: Vec<SourceUnitInput>,
+    edges: Vec<SourceDependency>,
+) -> (Vec<PreparedSourceView>, Vec<SourceDeclarative>) {
+    let selections = units
+        .iter()
+        .map(|u| SourceSelection {
+            path: u.path.clone(),
+            outline: OutlineKey {
+                parse: ParseKey {
+                    content: u.blob.content(),
+                    profile: u.profile.clone(),
+                },
+                crate_key: u.crate_key,
+                module_path: u.module_path.clone(),
+                cfg: u.cfg.fingerprint(),
+            },
+        })
+        .collect::<Vec<_>>();
+    let inputs =
+        PreparedSourceInputs::refresh_with_dependencies(None, units, Default::default(), edges)
+            .unwrap();
+    let views = selections
+        .iter()
+        .map(|s| {
+            let SourceSelectionOutcome::Selected(v) = inputs.select(s).unwrap() else {
+                panic!("actual source absent")
+            };
+            v
+        })
+        .collect::<Vec<_>>();
+    let providers = views
+        .iter()
+        .map(|v| SourceDeclarative::new(v.share()).unwrap())
+        .collect();
+    (views, providers)
+}
+fn graph(providers: &[SourceDeclarative]) -> crate::frontend::macro_names::MacroNamespaces {
+    let routes = providers
+        .iter()
+        .flat_map(|p| p.routes_in(providers).unwrap())
+        .collect::<Vec<_>>();
+    // This real builder already resolves aliases; MacroNamespaces is not NameNamespaces.
+    SourceMacroRoutes::discovery_graph(&routes).unwrap()
+}
+fn request(
+    view: &PreparedSourceView,
+    providers: &[SourceDeclarative],
+    tail: &str,
+) -> SourceDeclarativeRequest {
+    let call = view
+        .outline()
+        .item_invocations
+        .iter()
+        .find(|c| {
+            view.macro_call_at(c.range)
+                .unwrap()
+                .segments()
+                .last()
+                .is_some_and(
+                    |s| matches!(s,crate::syntax::imports::ImportSegment::Name(n) if n==tail),
+                )
+        })
+        .unwrap();
+    let SourceDeclarativeDemand::Ready(request) = providers[0]
+        .demand_for_discovery(
+            call.item_input,
+            Digest::of_bytes(b"generated source macro2 exact preparation component"),
+            crate::expand::source_declarative::engine_version(),
+            &graph(providers),
+            providers,
+        )
+        .unwrap()
+    else {
+        panic!("actual original macro request not selected")
+    };
+    *request
+}
+fn nested(
+    caller: u16,
+    definition: u16,
+) -> (
+    Vec<PreparedSourceView>,
+    Vec<SourceDeclarative>,
+    SourceDeclarativeRequest,
+    GeneratedItems,
+) {
+    let root = Digest([131; 32]);
+    let aux = Digest([132; 32]);
+    let (views, providers) = prepare(
+        vec![
+            unit(MODERN, "modern.rs", root, caller),
+            unit(INTERCRATE, "intercrate.rs", aux, definition),
+        ],
+        vec![SourceDependency {
+            consumer: root,
+            alias: "intercrate".into(),
+            provider: aux,
+        }],
+    );
+    let request = request(
+        &views[0],
+        &providers,
+        "define_uses_dollar_crate_modern_nested",
+    );
+    let output = request.expand().unwrap();
+    let items = GeneratedItems::admit(request.key(), Arc::new(output), 1).unwrap();
+    (views, providers, request, items)
+}
+fn token_span<'a>(
+    forest: &'a TokenForest,
+    name: &str,
+) -> &'a crate::syntax::token_wire::SpanRecord {
+    let mut stack = forest.roots().iter().collect::<Vec<_>>();
+    while let Some(t) = stack.pop() {
+        let key = match t {
+            TokenTree::Group { children, .. } => {
+                stack.extend(children);
+                continue;
+            }
+            TokenTree::Ident { text, span, .. } if text == name => *span,
+            _ => continue,
+        };
+        return forest.spans().iter().find(|s| s.key() == key).unwrap();
+    }
+    panic!("actual token absent: {name}")
+}
+fn catalog(view: &PreparedSourceView, items: &GeneratedItems) -> GeneratedMacroCatalog {
+    GeneratedMacroCatalog::new(
+        items,
+        view.outline().root_scope.clone(),
+        Key(items.record().key().parent_context.0),
+        &CfgSet::guest_default(),
+        items.epoch(),
+    )
+    .unwrap()
+}
