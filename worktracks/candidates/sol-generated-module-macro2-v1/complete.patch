+            &CfgSet::guest_default(),
+            DeclarationScanLimits::default(),
+            &site,
+        )
+        .unwrap();
+        let fields = declarations.scan().macro2_definitions();
+        assert_eq!(fields.len(), 2);
+        let module = fields
+            .iter()
+            .find(|h| h.scope_kind == DeclarationScopeKind::Module)
+            .unwrap();
+        let local = fields
+            .iter()
+            .find(|h| h.scope_kind == DeclarationScopeKind::Block)
+            .unwrap();
+        assert_ne!(module.identity, local.identity);
+        assert_eq!(
