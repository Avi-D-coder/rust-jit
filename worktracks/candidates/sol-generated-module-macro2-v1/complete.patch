+#[test]
+fn unchanged_nested_macro2_real_second_expansion_preserves_dollar_crate_all_owning_editions() {
+    for (caller, owner) in [(2015, 2024), (2018, 2021), (2021, 2018), (2024, 2015)] {
+        let (views, mut providers, parent, items) = nested(caller, owner);
+        let cat = catalog(&views[0], &items);
+        let members = cat.module_macro2_definitions().unwrap();
+        assert_eq!(members.len(), 1);
+        let definition = (*members[0]).clone();
+        assert_eq!(
+            definition.defining_unit,
+            views[0].selection().outline.crate_key
+        );
+        assert_eq!(definition.definition_edition, owner);
+        assert!(cat.root_bindings().unwrap().is_empty());
+        assert_eq!(
+            items.macro_dialect(definition.identity).unwrap(),
+            lrr_expand_adapter::declaration_output::DefinitionDialect::Macro2
+        );
+        providers[0]
+            .complete_generated_bindings(parent.key().invocation, Arc::new(cat))
+            .unwrap();
+        let second = request(&views[0], &providers, "uses_dollar_crate_modern_nested");
+        assert_eq!(
+            second.key().macro_identity,
+            crate::expand::identity::MacroIdentity::Declaration {
+                definition: definition.identity
+            }
+        );
+        assert_eq!(second.key().definition_edition, owner);
+        assert_eq!(second.key().call_edition, caller);
+        let record = second.expand().unwrap();
+        let output = GeneratedItems::admit(second.key(), Arc::new(record), 1).unwrap();
+        let dollar = token_span(output.tokens(), "$crate");
+        assert_eq!(
+            dollar.source.unit,
+            Key(views[1].selection().outline.crate_key.0)
+        );
+        let current = output
+            .hygiene_facts()
+            .context(dollar.context)
+            .unwrap()
+            .clone();
+        assert_eq!(
+            current.defining_unit,
+            Key(views[0].selection().outline.crate_key.0)
+        );
+        assert!(current.parent.is_some());
+        // Real ancestry chooses the older opaque def-site; no mark was skipped.
+        assert_eq!(
+            output.hygiene_facts().dollar_crate(dollar.context).unwrap(),
+            Key(views[1].selection().outline.crate_key.0)
+        );
+    }
+}
