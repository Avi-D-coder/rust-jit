+    let definition = (*cat.module_macro2_definitions().unwrap()[0]).clone();
+    let capture = items.macro_bodies.get(&definition.identity).unwrap();
+    providers[0]
+        .complete_generated_bindings(parent.key().invocation, Arc::new(cat))
+        .unwrap();
+    let second = request(&views[0], &providers, "uses_dollar_crate_modern_nested");
+    let body = lrr_expand_adapter::token_wire::TokenForest::decode(&capture.body.encode().unwrap())
+        .unwrap();
+    let args = capture.arguments.as_ref().map(|a| {
+        lrr_expand_adapter::token_wire::TokenForest::decode(&a.encode().unwrap()).unwrap()
+    });
+    let parser = lrr_expand_adapter::declarative::DeclarativeMacro::new_macro2(args, body).unwrap();
+    let call = views[0]
+        .outline()
+        .item_invocations
+        .iter()
+        .find(|c| c.item_input == second.key().invocation)
+        .unwrap();
+    let input = crate::expand::source_declarative::group(
+        &providers[0].owned_forest().unwrap(),
+        views[0].macro_token_group(call.range, false).unwrap(),
+    )
+    .unwrap();
+    let [lrr_expand_adapter::token_wire::TokenTree::Group { open, .. }] = input.roots() else {
+        panic!("actual input group absent")
+    };
+    let site = lrr_expand_adapter::declarative::DeclarativeSite {
+        expansion: lrr_expand_adapter::token_wire::Key(second.key().fingerprint().0),
+        defining_unit: lrr_expand_adapter::token_wire::Key(definition.defining_unit.0),
+        definition_edition: lrr_expand_adapter::token_wire::Edition::E2018,
+    };
+    let (result, stats) = parser
+        .expand_hygienic_with_limits(&input, *open, site, 100, 32768)
+        .unwrap();
+    let bytes = result.unwrap().tokens.encoded_len().unwrap();
+    assert_eq!(stats.admitted_bytes, bytes);
+    let (result, stats) = parser
+        .expand_hygienic_with_limits(&input, *open, site, 100, bytes - 1)
+        .unwrap();
+    assert_eq!(
+        result.err().unwrap().kind,
+        lrr_expand_adapter::declarative::FailureKind::Limit
+    );
+    assert_eq!(stats.materializations, 0);
+    assert_eq!(
+        parser
+            .expand_hygienic_with_limits(&input, *open, site, 100, bytes)
+            .unwrap()
+            .1
+            .materializations,
+        1
+    );
+}
