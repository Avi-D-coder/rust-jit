+++ b/crates/lrr/src/expand/generated_declaration_scan.rs
@@ -0,0 +1,28 @@
+//! Exact new-dialect rows matched to actual pinned output. No namespace installation.
+use super::*;
+pub(super) fn admit(
+    scan: &DeclarationScan,
+    rows: &mut BTreeMap<(u32, u32), declaration_output::DefinitionCapture>,
+) -> Result<BTreeMap<Digest, declaration_output::DefinitionCapture>, Diagnostic> {
+    let mut definitions = BTreeMap::new();
+    for header in scan.macro2_definitions() {
+        let capture = rows
+            .remove(&(header.range.start, header.range.end))
+            .ok_or_else(|| {
+                fault(
+                    "LRR-E-MACRO-OUTPUT",
+                    "active generated macro2 capture absent",
+                )
+            })?;
+        if capture.dialect != declaration_output::DefinitionDialect::Macro2
+            || capture.arguments.is_some() != header.arguments.is_some()
+        {
+            return Err(fault(
+                "LRR-E-MACRO-OUTPUT",
+                "generated macro2 dialect or matcher presence differs",
+            ));
+        }
+        definitions.insert(header.identity, capture);
+    }
+    Ok(definitions)
+}
