+//! Exact generated item arena admission. Pure syntax data, never namespace completeness.
+use super::*;
+pub(super) struct GeneratedModuleSyntax {
+    origin: Digest,
+}
+impl GeneratedModuleSyntax {
+    pub(super) fn matches(&self, parsed: &ParsedFile) -> bool {
+        parsed.generated_origin == Some(self.origin)
+    }
+}
+impl ParsedFile {
+    pub(crate) fn outline_generated_module(
+        &self,
+        items: &crate::expand::generated_items::GeneratedItems,
+        owner: &ScopeKey,
+        cfg: &CfgSet,
+        epoch: u64,
+    ) -> Result<Outline, Diagnostic> {
+        use crate::expand::identity::GrammarSlot;
+        let refusal = || {
+            fault(
+                "LRR-E-EXPANSION-INPUT",
+                "generated module syntax source/owner/producer differs",
+            )
+        };
+        if epoch == 0 || items.epoch() != epoch {
+            return Err(fault(
+                "LRR-E-EXPANSION-EPOCH",
+                "generated module syntax epoch differs",
+            ));
+        }
+        if !items.items().iter().any(|header| {
+            header.kind == crate::expand::generated_items::GeneratedHeaderKind::Macro2
+        }) {
+            // Keep the existing Rules/non-macro module parser path unchanged.
+            return self.outline(owner.crate_key, owner.module_path.clone(), cfg);
+        }
+        let descriptor = items.record().descriptor();
+        let origin = descriptor.fingerprint();
+        let mut input = StableEncoder::new("lrr/v2/generated-syntax-input");
+        input.record(&descriptor);
+        let expected_profile = crate::core::profile::ProfileIdentity {
+            edition: items.record().key().call_edition,
+            ..crate::core::profile::ProfileIdentity::current()
+        };
+        if self.content != input.finish()
+            || self.profile != expected_profile
+            || self.edition != items.record().key().call_edition
+            || self.generated_origin != Some(origin)
+            || owner.owner.is_some()
+            || items.record().key().grammar != GrammarSlot::Items
+        {
+            return Err(refusal());
+        }
+        let mut cursor = crate::syntax::token_wire::Key(items.record().key().parent_context.0);
+        for _ in 0..=256 {
+            let record = items
+                .tokens()
+                .contexts()
+                .iter()
+                .find(|c| c.key() == cursor)
+                .ok_or_else(refusal)?;
+            if let Some(parent) = record.parent {
+                cursor = parent;
+                continue;
+            }
+            if record.defining_unit.0 != owner.crate_key.0 || record.expansion.is_some() {
+                return Err(refusal());
+            }
+            let proof = GeneratedModuleSyntax { origin };
+            return self.outline_with_generated_macro2(
+                owner.crate_key,
+                owner.module_path.clone(),
+                cfg,
+                Some(&proof),
+            );
+        }
+        Err(refusal())
+    }
+}
