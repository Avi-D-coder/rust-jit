@@ -0,0 +1,109 @@
+//! Exact macro2 AST header data. Never a textual binding or selected namespace proof.
+use super::*;
+#[derive(Clone, Debug)]
+pub struct ScannedMacro2Definition {
+    pub identity: Digest,
+    pub name: String,
+    pub name_range: SourceRange,
+    pub name_edition: u16,
+    pub range: SourceRange,
+    pub arguments: Option<SourceRange>,
+    pub body: SourceRange,
+    pub scope: ScopeKey,
+    pub lexical_scope: MacroScope,
+    pub scope_kind: DeclarationScopeKind,
+    pub visibility: super::super::visibility::VisibilityScope,
+}
+impl StableEncode for ScannedMacro2Definition {
+    const DOMAIN: &'static str = "lrr/v1/scanned-macro2-definition";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.identity);
+        e.string(&self.name);
+        e.u16(self.name_edition);
+        position(e, self.name_range);
+        position(e, self.range);
+        e.option(&self.arguments, |e, r| position(e, *r));
+        position(e, self.body);
+        e.record(&self.scope);
+        e.record(&self.lexical_scope);
+        e.record(&self.scope_kind);
+        e.record(&self.visibility);
+    }
+}
+pub(super) fn capture(
+    parsed: &ParsedFile,
+    m: &ast::MacroDef,
+    lexical_scope: MacroScope,
+    scope_kind: DeclarationScopeKind,
+    scan: &DeclarationScan,
+    budget: &mut Budget,
+) -> Result<ScannedMacro2Definition, Diagnostic> {
+    let name = m.name().ok_or_else(|| {
+        Diagnostic::new("LRR-E-SOURCE-PARSE", "macro2 definition has no name".into())
+    })?;
+    let name_range = range(name.syntax().text_range());
+    let name_edition = parsed.token_edition(name_range)?;
+    let name = name.text().to_string();
+    super::super::ast_adapter::macro_name(&name, name_edition)
+        .ok_or_else(|| Diagnostic::new("LRR-E-SOURCE-NAME", "macro2 source name invalid".into()))?;
+    let selected = range(m.syntax().text_range());
+    let args = m.args().map(|a| range(a.syntax().text_range()));
+    let body = range(
+        m.body()
+            .ok_or_else(|| Diagnostic::new("LRR-E-SOURCE-PARSE", "macro2 body absent".into()))?
+            .syntax()
+            .text_range(),
+    );
+    if !selected.contains(body) || args.is_some_and(|a| !selected.contains(a) || a.end > body.start)
+    {
+        return Err(limit());
+    }
+    let (mut scope, _) = lexical_context(m.syntax(), &scan.scope, budget)?;
+    if scope_kind == DeclarationScopeKind::Module
+        && !m.syntax().ancestors().any(|a| {
+            ast::Fn::can_cast(a.kind())
+                || ast::BlockExpr::can_cast(a.kind())
+                || ast::ClosureExpr::can_cast(a.kind())
+                || ast::AssocItemList::can_cast(a.kind())
+        })
+    {
+        scope.owner = None;
+    }
+    let visibility = super::super::visibility::VisibilityScope::for_declaration(
+        &super::super::outline::visibility(m.syntax()),
+        &scope,
+        name_edition,
+    )?;
+    let visibility_bytes = match &visibility {
+        super::super::visibility::VisibilityScope::Public => Some(0),
+        super::super::visibility::VisibilityScope::Within { module_path, .. } => module_path
+            .capacity()
+            .checked_mul(std::mem::size_of::<String>())
+            .and_then(|n| {
+                module_path
+                    .iter()
+                    .try_fold(n, |n, s| n.checked_add(s.capacity()))
+            }),
+    }
+    .ok_or_else(limit)?;
+    let bytes = std::mem::size_of::<ScannedMacro2Definition>()
+        .checked_add(name.capacity())
+        .and_then(|n| n.checked_add(scope.heap_bytes()))
+        .and_then(|n| n.checked_add(visibility_bytes))
+        .and_then(|n| n.checked_add(128))
+        .ok_or_else(limit)?;
+    budget.charge(bytes)?;
+    Ok(ScannedMacro2Definition {
+        identity: source_identity(scan, selected, 6),
+        name,
+        name_range,
+        name_edition,
+        range: selected,
+        arguments: args,
+        body,
+        scope,
+        lexical_scope,
+        scope_kind,
+        visibility,
+    })
+}
