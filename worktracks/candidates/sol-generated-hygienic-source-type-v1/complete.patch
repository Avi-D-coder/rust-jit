+//! Real source/expansion/header components only; no evaluator, layout or main execution.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    db::key::OutlineKey,
+    expand::{
+        generated_items::GeneratedItems,
+        source_declarative::SourceDeclarativeDemand,
