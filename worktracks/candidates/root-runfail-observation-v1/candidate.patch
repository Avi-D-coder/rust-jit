+PANIC_DESCRIPTIONS = {
+    "overflow": "arithmetic overflow", "division_by_zero": "division by zero",
+    "invalid_shift": "invalid shift", "explicit": "explicit panic",
+    "assertion": "assertion failed", "index_out_of_bounds": "index out of bounds",
+}
+
+
+def observed_panic_message(terminal, facts):
+    panic = terminal["panic"]
+    if not isinstance(panic, dict) or panic.get("kind") not in PANIC_DESCRIPTIONS:
+        raise ValueError("unknown guest panic kind")
+    message = panic["message"]
+    if message is None:
+        message = PANIC_DESCRIPTIONS[panic["kind"]]
+    if not isinstance(message, str) or len(message.encode("utf-8")) > 65_536:
+        raise ValueError("guest panic message type/size")
+    if facts["terminal"] != {"kind": "guest_panic", "message": message}:
+        raise ValueError("retained panic message differs from actual terminal")
+    pc = panic["pc"]
+    if not isinstance(pc, dict) or not isinstance(pc.get("body"), dict):
+        raise ValueError("guest panic source PC absent")
+    if not all(isinstance(pc["body"].get(key), str)
