+               for key in ("definition", "exact_body_bytes")):
+        raise ValueError("guest panic source body identity")
+    if not all(type(pc.get(key)) is int and 0 <= pc[key] <= limit
+               for key, limit in (("node", 2**32 - 1), ("phase", 2**16 - 1))):
+        raise ValueError("guest panic node/phase identity")
+    return message
