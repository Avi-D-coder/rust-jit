--- a/crates/lrr/src/frontend/index_source_selection.rs
+++ b/crates/lrr/src/frontend/index_source_selection.rs
@@ -0,0 +1,957 @@
+//! Bounded source-facade Index selection. Unknown live candidates stay unresolved.
+//! No parser, guest value/tag, native generation, provider callback or public witness constructor.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{DependencyStamp, InputKey, InputValue},
+        memo::Database,
+        seals::{SealDomain, SealKey},
+    },
+    frontend::names::{NameLookup, NameNamespaces},
+    ir::op::PrimitiveType,
+    source::{
+        changes::{PreparedSourceView, SourceSelection},
+        manifest::{DefKey, Namespace},
+        value_library_selection::PreparedValueLibrarySelection,
+    },
+    syntax::{
+        outline::ScopeKey,
+        standard_index_headers::{IndexHeaderRole, IndexSourceFact, IndexSourceHeaders},
+    },
+    traits::term::{GenericArg, TraitRef, TyTerm},
+};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    sync::Arc,
+};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-INDEX-SELECTION", message.into())
+}
+/// Data outcome is separate from a private-minted selected intrinsic member.
+#[derive(Debug)]
+pub enum IndexSelection {
+    Selected(Box<SelectedIndexIntrinsic>),
+    NeedGoalEngine { candidates: Vec<Digest> },
+    NeedSourceType,
+    NoSolution,
+}
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub enum IndexReceiverKind {
+    Vec,
+    SliceReference,
+}
+/// Pure source proof; it never embeds worker TypeIds, cells, epochs or addresses.
+#[derive(Debug, Clone)]
+pub struct SelectedIndexIntrinsic {
+    library: Digest,
+    publication: Digest,
+    consumer: SourceSelection,
+    source_revision: u64,
+    seal: SealKey,
+    seal_input: Digest,
+    catalog: Digest,
+    receiver: TyTerm,
+    kind: IndexReceiverKind,
+    element: PrimitiveType,
+    mutable: bool,
+    trait_goal: TraitRef,
+    implementation: Digest,
+    member: DefKey,
+    delegation: Vec<Digest>,
+    dependencies: Vec<DependencyStamp>,
+}
+impl SelectedIndexIntrinsic {
+    pub fn receiver(&self) -> &TyTerm {
+        &self.receiver
+    }
+    pub fn receiver_kind(&self) -> IndexReceiverKind {
+        self.kind
+    }
+    pub fn element(&self) -> PrimitiveType {
+        self.element
+    }
+    pub fn mutable(&self) -> bool {
+        self.mutable
+    }
+    pub fn member(&self) -> &DefKey {
+        &self.member
+    }
+    pub fn implementation(&self) -> Digest {
+        self.implementation
+    }
+    pub fn goal(&self) -> &TraitRef {
+        &self.trait_goal
+    }
+    pub fn delegation(&self) -> &[Digest] {
+        &self.delegation
+    }
+    pub fn dependencies(&self) -> &[DependencyStamp] {
+        &self.dependencies
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+        graph: &NameNamespaces,
+        headers: &[Arc<IndexSourceHeaders>],
+    ) -> Result<(), Diagnostic> {
+        let current = CurrentIndexLibrary::capture_current(db, source, graph, headers, &self.seal)?;
+        let IndexSelection::Selected(fresh) = current.select(
+            &self.receiver,
+            &TyTerm::Primitive(PrimitiveType::Usize),
+            self.mutable,
+        )?
+        else {
+            return Err(fault(
+                "selected Index source candidate/context became unresolved",
+            ));
+        };
+        if fresh.fingerprint() != self.fingerprint() {
+            return Err(fault("selected Index source/library/world/input is stale"));
+        }
+        Ok(())
+    }
+    pub fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        let mut bytes = std::mem::size_of::<Self>()
+            .checked_add(self.consumer.metadata_bytes()?)
+            .and_then(|n| n.checked_add(self.receiver.heap_bytes()?))
+            .and_then(|n| n.checked_add(self.delegation.capacity().checked_mul(32)?))
+            .and_then(|n| {
+                n.checked_add(
+                    self.dependencies
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<DependencyStamp>())?,
+                )
+            })
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(|| fault("selected Index witness metadata bound"))?;
+        bytes = bytes
+            .checked_add(
+                self.trait_goal
+                    .self_ty
+                    .heap_bytes()
+                    .ok_or_else(|| fault("Index goal metadata overflow"))?,
+            )
+            .ok_or_else(|| fault("Index goal metadata overflow"))?;
+        for definition in [&self.member] {
+            bytes = bytes
+                .checked_add(definition.declared_name.capacity())
+                .and_then(|n| {
+                    n.checked_add(
+                        definition
+                            .module_path
+                            .capacity()
+                            .checked_mul(std::mem::size_of::<String>())?,
+                    )
+                })
+                .ok_or_else(|| fault("Index definition metadata overflow"))?;
+            for segment in &definition.module_path {
+                bytes = bytes
+                    .checked_add(segment.capacity())
+                    .ok_or_else(|| fault("Index definition metadata overflow"))?;
+            }
+        }
+        for dependency in &self.dependencies {
+            bytes = bytes
+                .checked_add(dependency.heap_bytes())
+                .ok_or_else(|| fault("Index dependency metadata overflow"))?;
+        }
+        bytes = bytes
+            .checked_add(
+                self.trait_goal
+                    .args
+                    .capacity()
+                    .checked_mul(std::mem::size_of::<GenericArg>())
+                    .ok_or_else(|| fault("Index argument metadata overflow"))?,
+            )
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(|| fault("Index witness metadata bound"))?;
+        Ok(bytes)
+    }
+}
+/// Ephemeral admission retains immutable current database and namespace borrows.
+/// The VM can consume this token once; it cannot mint one from descriptor tags.
+pub(crate) struct AdmittedIndexIntrinsic<'a> {
+    selected: &'a SelectedIndexIntrinsic,
+    _db: &'a Database,
+    _source: &'a PreparedSourceView,
+    _graph: &'a NameNamespaces,
+    _headers: &'a [Arc<IndexSourceHeaders>],
+    _operand: &'a crate::syntax::macro_index_source::MacroIndexOperand,
+}
+impl<'a> AdmittedIndexIntrinsic<'a> {
+    pub(crate) fn selected(&self) -> &SelectedIndexIntrinsic {
+        self.selected
+    }
+}
+impl SelectedIndexIntrinsic {
+    pub(crate) fn admit_current<'a>(
+        &'a self,
+        db: &'a Database,
+        source: &'a PreparedSourceView,
+        graph: &'a NameNamespaces,
+        headers: &'a [Arc<IndexSourceHeaders>],
+        operand: &'a crate::syntax::macro_index_source::MacroIndexOperand,
+    ) -> Result<AdmittedIndexIntrinsic<'a>, Diagnostic> {
+        self.revalidate(db, source, graph, headers)?;
+        if operand.source() != &source.selection().outline.parse
+            || operand.cfg() != source.selection().outline.cfg
+            || self.mutable
+        {
+            return Err(fault(
+                "assertion Index operand source/cfg/shared-use context differs",
+            ));
+        }
+        let index = source.index_body(
+            source.selection(),
+            operand.body(),
+            crate::syntax::body_index::BodyIndexLimits::default(),
+        )?;
+        if index.pc(operand.node(), crate::ir::pc::Phase::Entry)? != *operand.macro_entry()
+            || index
+                .nodes()
+                .get(operand.node().0 as usize)
+                .is_none_or(|node| {
+                    node.role
+                        != crate::syntax::body_index::NodeRole::Expression(
+                            crate::syntax::body_index::ExpressionKind::Macro,
+                        )
+                })
+        {
+            return Err(fault(
+                "Index operand is not the actual current Macro source PC",
+            ));
+        }
+        Ok(AdmittedIndexIntrinsic {
+            selected: self,
+            _db: db,
+            _source: source,
+            _graph: graph,
+            _headers: headers,
+            _operand: operand,
+        })
+    }
+}
+/// Read-only admission over opaque preparation, actual declared sources and the
+/// complete published impl catalog. An observed source file alone is insufficient.
+pub(crate) struct CurrentIndexLibrary {
+    selection: Arc<PreparedValueLibrarySelection>,
+    publication: Digest,
+    consumer: SourceSelection,
+    source_revision: u64,
+    seal: SealKey,
+    seal_input: Digest,
+    facts: BTreeMap<IndexHeaderRole, IndexSourceFact>,
+    catalog: Digest,
+    unknown: Vec<Digest>,
+    active: BTreeSet<Digest>,
+    dependencies: Vec<DependencyStamp>,
+}
+impl CurrentIndexLibrary {
+    pub(crate) fn capture_current(
+        db: &Database,
+        source: &PreparedSourceView,
+        graph: &NameNamespaces,
+        headers: &[Arc<IndexSourceHeaders>],
+        seal: &SealKey,
+    ) -> Result<Self, Diagnostic> {
+        if headers.len() > 16 {
+            return Err(fault("Index library source count bound"));
+        }
+        seal.validate()?;
+        let selection_key = InputKey::ValueLibrarySelection(source.selection().outline.crate_key);
+        let (InputValue::ValueLibrarySelection(selection), publication) = db
+            .published_input(&selection_key)
+            .ok_or_else(|| fault("actual selected source-library input absent"))?
+        else {
+            return Err(fault("selected source-library variant differs"));
+        };
+        selection.validate_current(db, source)?;
+        let (InputValue::DiscoverySeal(input), seal_input) = db
+            .published_input(&InputKey::DiscoverySeal(seal.clone()))
+            .ok_or_else(|| fault("current ImplCatalogSeal absent"))?
+        else {
+            return Err(fault("ImplCatalog input variant differs"));
+        };
+        if !matches!(seal.domain, SealDomain::ImplCatalog { .. })
+            || input.seal.key() != *seal
+            || input.scope.is_some()
+            || input.seal.unresolved_frontiers() != 0
+            || !input.declaration_inventory.pending_producers().is_empty()
+        {
+            return Err(fault(
+                "Index selection requires a complete actual impl catalog",
+            ));
+        }
+        if !matches!(db.published_input(&InputKey::ExpansionEpoch),Some((InputValue::ExpansionEpoch(epoch),_))if *epoch==seal.epoch)
+            || !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(deps),_))if deps.fingerprint()==input.source_dependencies)
+        {
+            return Err(fault("Index source epoch/dependency world differs"));
+        }
+        let mut dependencies = vec![
+            DependencyStamp::Input {
+                key: selection_key,
+                fingerprint: publication,
+            },
+            DependencyStamp::Input {
+                key: InputKey::DiscoverySeal(seal.clone()),
+                fingerprint: seal_input,
+            },
+        ];
+        for (key, expected) in &input.compiler_inputs {
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != *expected)
+            {
+                return Err(fault("Index sealed source/compiler input changed"));
+            }
+            dependencies
+                .try_reserve(1)
+                .map_err(|_| fault("Index dependency allocation"))?;
+            dependencies.push(DependencyStamp::Input {
+                key: key.clone(),
+                fingerprint: *expected,
+            });
+        }
+        for key in [InputKey::ExpansionEpoch, InputKey::SourceDependencies] {
+            let (_, fingerprint) = db
+                .published_input(&key)
+                .ok_or_else(|| fault("current Index world input absent"))?;
+            dependencies.push(DependencyStamp::Input { key, fingerprint });
+        }
+        let core = selection.provider(false).outline.crate_key;
+        let alloc = selection.allocation_provider().map(|s| s.outline.crate_key);
+        let mut facts = BTreeMap::new();
+        let mut metadata = 0usize;
+        for file in headers {
+            metadata = metadata
+                .checked_add(file.metadata_bytes())
+                .filter(|n| *n <= 32 * 1024 * 1024)
+                .ok_or_else(|| fault("Index catalog metadata bound"))?;
+            let selected = file.source();
+            if selection.observed_source(&selected.path) != Some(selected.outline.parse.content) {
+                return Err(fault(
+                    "Index file absent from actual selected library observations",
+                ));
+            }
+            graph.require_source(selected, file.outline())?;
+            if !input.sources.contains(selected)
+                || !matches!(db.published_input(&InputKey::CapturedSource(selected.location_identity())),Some((InputValue::CapturedSource(current),_))if current==selected)
+                || !matches!(db.published_input(&InputKey::CrateCfg(selected.outline.crate_key)),Some((InputValue::CrateCfg(cfg),_))if cfg.fingerprint()==selected.outline.cfg)
+            {
+                return Err(fault(
+                    "Index owning module/source/cfg not current and sealed",
+                ));
+            }
+            for fact in file.facts() {
+                let (unit, module): (_, &[&str]) = match fact.role() {
+                    IndexHeaderRole::IndexTrait | IndexHeaderRole::IndexMutTrait => {
+                        (core, &["ops", "index"])
+                    }
+                    IndexHeaderRole::SliceIndexTrait
+                    | IndexHeaderRole::SliceIndexImpl
+                    | IndexHeaderRole::SliceIndexMutImpl
+                    | IndexHeaderRole::UsizeSliceIndexImpl => (core, &["slice", "index"]),
+                    IndexHeaderRole::VecType
+                    | IndexHeaderRole::VecIndexImpl
+                    | IndexHeaderRole::VecIndexMutImpl
+                    | IndexHeaderRole::VecDerefImpl
+                    | IndexHeaderRole::VecDerefMutImpl => (
+                        alloc.ok_or_else(|| fault("actual alloc provider root is absent"))?,
+                        &["vec"],
+                    ),
+                    IndexHeaderRole::DerefTrait | IndexHeaderRole::DerefMutTrait => {
+                        (core, &["ops", "deref"])
+                    }
+                    IndexHeaderRole::AllocatorTrait => (core, &["alloc"]),
+                    IndexHeaderRole::SizedTrait | IndexHeaderRole::CopyTrait => (core, &["marker"]),
+                    IndexHeaderRole::GlobalType | IndexHeaderRole::GlobalAllocatorImpl => (
+                        alloc.ok_or_else(|| fault("actual alloc provider root is absent"))?,
+                        &["alloc"],
+                    ),
+                };
+                if fact.definition().crate_key != unit
+                    || fact
+                        .definition()
+                        .module_path
+                        .iter()
+                        .map(String::as_str)
+                        .ne(module.iter().copied())
+                    || fact.source().outline.parse.profile.edition != 2024
+                    || fact.source().outline.parse.profile.semantics
+                        != source.selection().outline.parse.profile.semantics
+                {
+                    return Err(fault(
+                        "Index declaration defining source/unit/edition/profile differs",
+                    ));
+                }
+                let key = InputKey::DefinitionHeader(fact.definition().fingerprint());
+                let (InputValue::DefinitionHeader(header), stamp) = db
+                    .published_input(&key)
+                    .ok_or_else(|| fault("Index declaration header not captured/published"))?
+                else {
+                    return Err(fault("Index declaration header variant differs"));
+                };
+                if header != fact.header() {
+                    return Err(fault("Index exact published declaration header differs"));
+                }
+                dependencies.push(DependencyStamp::Input {
+                    key,
+                    fingerprint: stamp,
+                });
+                for (definition, header, range) in
+                    std::iter::once((fact.definition(), fact.header(), fact.range()))
+                        .chain(
+                            fact.members()
+                                .iter()
+                                .map(|m| (m.definition(), m.header(), m.range())),
+                        )
+                        .chain(
+                            fact.associated_types()
+                                .iter()
+                                .map(|a| (a.definition(), a.header(), a.range())),
+                        )
+                {
+                    let identity = definition.fingerprint();
+                    for key in [
+                        InputKey::DefinitionSource(identity),
+                        InputKey::DeclarationContext(identity),
+                        InputKey::DefinitionHeader(identity),
+                    ] {
+                        let (value, fingerprint) = db.published_input(&key).ok_or_else(|| {
+                            fault("Index declaration/member source context absent")
+                        })?;
+                        let valid = match value {
+                            InputValue::DefinitionSource(parse) => parse == &selected.outline.parse,
+                            InputValue::DeclarationContext(context) => {
+                                context.range == range
+                                    && context.scope.crate_key == definition.crate_key
+                                    && context.scope.module_path == definition.module_path
+                            }
+                            InputValue::DefinitionHeader(current) => current == header,
+                            _ => false,
+                        };
+                        if !valid {
+                            return Err(fault(
+                                "exact Index declaration/member published source context differs",
+                            ));
+                        }
+                        dependencies
+                            .try_reserve(1)
+                            .map_err(|_| fault("Index member dependency allocation"))?;
+                        dependencies.push(DependencyStamp::Input { key, fingerprint });
+                    }
+                }
+                if facts.insert(fact.role(), fact.clone()).is_some() {
+                    return Err(fault("Index source role duplicate"));
+                }
+            }
+        }
+        let mut encoded = StableEncoder::new("lrr/v1/current-source-index-catalog");
+        for fact in facts.values() {
+            encoded.record(fact)
+        }
+        let catalog = encoded.finish();
+        let known = facts
+            .values()
+            .filter_map(IndexSourceFact::impl_source)
+            .collect::<BTreeSet<_>>();
+        let mut unknown = Vec::new();
+        let mut active = BTreeSet::new();
+        if input.declaration_inventory.headers().len() > 100_000 {
+            return Err(fault("Index catalog candidate count bound"));
+        }
+        for header in input.declaration_inventory.headers() {
+            active.insert(header.identity);
+            if !known.contains(&header.identity) {
+                unknown
+                    .try_reserve(1)
+                    .map_err(|_| fault("Index candidate allocation"))?;
+                unknown.push(header.identity)
+            }
+        }
+        // No spelling-based exclusion of a foreign, conditional or blanket candidate.
+        unknown.sort();
+        unknown.dedup();
+        metadata = metadata
+            .checked_add(
+                unknown
+                    .capacity()
+                    .checked_mul(32)
+                    .ok_or_else(|| fault("Index unknown capacity overflow"))?,
+            )
+            .and_then(|n| n.checked_add(active.len().checked_mul(96)?))
+            .and_then(|n| {
+                n.checked_add(
+                    dependencies
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<DependencyStamp>())?,
+                )
+            })
+            .ok_or_else(|| fault("Index admission metadata overflow"))?;
+        for dependency in &dependencies {
+            metadata = metadata
+                .checked_add(dependency.heap_bytes())
+                .ok_or_else(|| fault("Index dependency metadata overflow"))?;
+        }
+        if metadata > 32 * 1024 * 1024 {
+            return Err(fault("Index admission metadata bound"));
+        }
+        let current = Self {
+            selection: selection.clone(),
+            publication,
+            consumer: source.selection().clone(),
+            source_revision: db.source_revision(),
+            seal: seal.clone(),
+            seal_input,
+            catalog,
+            facts,
+            unknown,
+            active,
+            dependencies,
+        };
+        current.require_source_symbols(graph)?;
+        current.require_member_contracts()?;
+        Ok(current)
+    }
+    fn fact(&self, role: IndexHeaderRole) -> Result<&IndexSourceFact, Diagnostic> {
+        self.facts
+            .get(&role)
+            .ok_or_else(|| fault("required source Index declaration/impl absent"))
+    }
+    fn namespace_symbol(
+        graph: &NameNamespaces,
+        from: &IndexSourceFact,
+        name: &str,
+        wanted: &IndexSourceFact,
+    ) -> Result<(), Diagnostic> {
+        let scope = ScopeKey {
+            crate_key: from.definition().crate_key,
+            module_path: from.definition().module_path.clone(),
+            owner: None,
+        };
+        if !matches!(graph.lookup_unqualified(Namespace::Type,name,&scope,2024,None)?,NameLookup::Defined(found)if found.identity==wanted.definition().fingerprint()&&found.defining_unit==wanted.definition().crate_key&&found.definition_edition==2024)
+        {
+            return Err(fault(
+                "Index source header symbol is unresolved/shadowed/foreign",
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn require_source_symbols(&self, graph: &NameNamespaces) -> Result<(), Diagnostic> {
+        let index = self.fact(IndexHeaderRole::IndexTrait)?;
+        let index_mut = self.fact(IndexHeaderRole::IndexMutTrait)?;
+        let slice = self.fact(IndexHeaderRole::SliceIndexTrait)?;
+        let vector = self.fact(IndexHeaderRole::VecType)?;
+        let global = self.fact(IndexHeaderRole::GlobalType)?;
+        let allocator = self.fact(IndexHeaderRole::AllocatorTrait)?;
+        for (role, name, wanted) in [
+            (IndexHeaderRole::VecIndexImpl, "Index", index),
+            (IndexHeaderRole::VecIndexMutImpl, "IndexMut", index_mut),
+            (IndexHeaderRole::VecIndexImpl, "SliceIndex", slice),
+            (IndexHeaderRole::VecIndexImpl, "Vec", vector),
+            (IndexHeaderRole::VecIndexImpl, "Global", global),
+            (IndexHeaderRole::VecIndexImpl, "Allocator", allocator),
+            (IndexHeaderRole::IndexMutTrait, "Index", index),
+            (
+                IndexHeaderRole::DerefMutTrait,
+                "Deref",
+                self.fact(IndexHeaderRole::DerefTrait)?,
+            ),
+            (IndexHeaderRole::GlobalAllocatorImpl, "Allocator", allocator),
+            (IndexHeaderRole::UsizeSliceIndexImpl, "SliceIndex", slice),
+            (IndexHeaderRole::SliceIndexImpl, "SliceIndex", slice),
+        ] {
+            Self::namespace_symbol(graph, self.fact(role)?, name, wanted)?
+        }
+        for (role, path, wanted) in [
+            (IndexHeaderRole::SliceIndexImpl, ["ops", "Index"], index),
+            (
+                IndexHeaderRole::SliceIndexMutImpl,
+                ["ops", "IndexMut"],
+                index_mut,
+            ),
+            (
+                IndexHeaderRole::VecDerefImpl,
+                ["ops", "Deref"],
+                self.fact(IndexHeaderRole::DerefTrait)?,
+            ),
+            (
+                IndexHeaderRole::VecDerefMutImpl,
+                ["ops", "DerefMut"],
+                self.fact(IndexHeaderRole::DerefMutTrait)?,
+            ),
+        ] {
+            let from = self.fact(role)?;
+            let scope = ScopeKey {
+                crate_key: from.definition().crate_key,
+                module_path: from.definition().module_path.clone(),
+                owner: None,
+            };
+            let segments = path.map(|s| crate::syntax::imports::ImportSegment::Name(s.into()));
+            if !matches!(graph.lookup_source_path(Namespace::Type, &segments, false, &scope, 2024)?, NameLookup::Defined(found) if found.identity==wanted.definition().fingerprint() && found.defining_unit==wanted.definition().crate_key && found.definition_edition==2024)
+            {
+                return Err(fault("qualified Index/Deref source symbol differs"));
+            }
+        }
+        Ok(())
+    }
+    fn require_member_contracts(&self) -> Result<(), Diagnostic> {
+        let sized = self.fact(IndexHeaderRole::SizedTrait)?;
+        let lang = sized
+            .header()
+            .attributes
+            .iter()
+            .filter(|a| a.name == "lang")
+            .collect::<Vec<_>>();
+        if lang.len() != 1
+            || lang[0]
+                .tokens
+                .iter()
+                .map(|t| t.text.as_str())
+                .ne(["lang", "=", "\"sized\""])
+        {
+            return Err(fault("primitive Sized source intrinsic identity absent"));
+        }
+        for (role, contract) in [
+            (IndexHeaderRole::IndexTrait, "<Idx:?Sized>||"),
+            (
+                IndexHeaderRole::IndexMutTrait,
+                "<Idx:?Sized>|[const]Index<Idx>|",
+            ),
+            (IndexHeaderRole::SliceIndexTrait, "<T:?Sized>||"),
+            (IndexHeaderRole::DerefTrait, "|PointeeSized|"),
+            (
+                IndexHeaderRole::DerefMutTrait,
+                "|[const]Deref+PointeeSized|",
+            ),
+            (IndexHeaderRole::AllocatorTrait, "||"),
+            (IndexHeaderRole::SizedTrait, "|MetaSized|"),
+            (IndexHeaderRole::CopyTrait, "|Clone|"),
+            (
+                IndexHeaderRole::VecIndexImpl,
+                "<T,I:[const]SliceIndex<[T]>,A:Allocator>",
+            ),
+            (
+                IndexHeaderRole::VecIndexMutImpl,
+                "<T,I:[const]SliceIndex<[T]>,A:Allocator>",
+            ),
+            (
+                IndexHeaderRole::SliceIndexImpl,
+                "<T,I>whereI:[const]SliceIndex<[T]>,",
+            ),
+            (
+                IndexHeaderRole::SliceIndexMutImpl,
+                "<T,I>whereI:[const]SliceIndex<[T]>,",
+            ),
+            (IndexHeaderRole::UsizeSliceIndexImpl, "<T>"),
+            (IndexHeaderRole::VecDerefImpl, "<T,A:Allocator>"),
+            (IndexHeaderRole::VecDerefMutImpl, "<T,A:Allocator>"),
+            (IndexHeaderRole::GlobalAllocatorImpl, ""),
+        ] {
+            if self.fact(role)?.parameter_contract() != Some(contract) {
+                return Err(fault(
+                    "Index delegated source generic/predicate contract differs",
+                ));
+            }
+        }
+        for (role, name, signature) in [
+            (
+                IndexHeaderRole::IndexTrait,
+                "index",
+                "fnindex(&self,index:Idx)->&Self::Output",
+            ),
+            (
+                IndexHeaderRole::IndexMutTrait,
+                "index_mut",
+                "fnindex_mut(&mutself,index:Idx)->&mutSelf::Output",
+            ),
+            (
+                IndexHeaderRole::VecIndexImpl,
+                "index",
+                "fnindex(&self,index:I)->&Self::Output",
+            ),
+            (
+                IndexHeaderRole::VecIndexMutImpl,
+                "index_mut",
+                "fnindex_mut(&mutself,index:I)->&mutSelf::Output",
+            ),
+            (
+                IndexHeaderRole::SliceIndexImpl,
+                "index",
+                "fnindex(&self,index:I)->&I::Output",
+            ),
+            (
+                IndexHeaderRole::SliceIndexMutImpl,
+                "index_mut",
+                "fnindex_mut(&mutself,index:I)->&mutI::Output",
+            ),
+            (
+                IndexHeaderRole::UsizeSliceIndexImpl,
+                "index",
+                "fnindex(self,slice:&[T])->&T",
+            ),
+            (
+                IndexHeaderRole::UsizeSliceIndexImpl,
+                "index_mut",
+                "fnindex_mut(self,slice:&mut[T])->&mutT",
+            ),
+            (
+                IndexHeaderRole::VecDerefImpl,
+                "deref",
+                "fnderef(&self)->&[T]",
+            ),
+            (
+                IndexHeaderRole::VecDerefMutImpl,
+                "deref_mut",
+                "fnderef_mut(&mutself)->&mut[T]",
+            ),
+        ] {
+            if self.fact(role)?.member(name)?.signature() != signature {
+                return Err(fault("source Index result/receiver signature differs"));
+            }
+        }
+        for (role, name, expected) in [
+            (IndexHeaderRole::VecIndexImpl, "Output", "I::Output"),
+            (IndexHeaderRole::SliceIndexImpl, "Output", "I::Output"),
+            (IndexHeaderRole::UsizeSliceIndexImpl, "Output", "T"),
+            (IndexHeaderRole::VecDerefImpl, "Target", "[T]"),
+        ] {
+            let fact = self.fact(role)?;
+            let mut types = fact
+                .associated_types()
+                .iter()
+                .filter(|t| t.definition().declared_name == name);
+            if types.next().and_then(|t| t.written_type()) != Some(expected)
+                || types.next().is_some()
+            {
+                return Err(fault("Index source associated result differs"));
+            }
+        }
+        for (role, name, body) in [
+            (IndexHeaderRole::VecDerefImpl, "deref", "{self.as_slice()}"),
+            (
+                IndexHeaderRole::VecDerefMutImpl,
+                "deref_mut",
+                "{self.as_mut_slice()}",
+            ),
+        ] {
+            if self.fact(role)?.member(name)?.body_tokens() != Some(body) {
+                return Err(fault("Vec source slice delegation differs"));
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn select(
+        &self,
+        receiver: &TyTerm,
+        index: &TyTerm,
+        mutable: bool,
+    ) -> Result<IndexSelection, Diagnostic> {
+        if !self.unknown.is_empty() {
+            return Ok(IndexSelection::NeedGoalEngine {
+                candidates: self.unknown.clone(),
+            });
+        }
+        let vector = self.fact(IndexHeaderRole::VecType)?;
+        let global = self.fact(IndexHeaderRole::GlobalType)?;
+        let mut receiver_target = receiver;
+        let mut receiver_mutable = None;
+        if let TyTerm::Ref(_, writable, target) = receiver {
+            receiver_target = target;
+            receiver_mutable = Some(*writable)
+        }
+        if mutable && receiver_mutable == Some(false) {
+            return Ok(IndexSelection::NoSolution);
+        }
+        let (kind, element, role) = match receiver_target {
+            TyTerm::Nominal(identity, args) if *identity == vector.definition().fingerprint() => {
+                if args.len() != 2 {
+                    return Ok(IndexSelection::NeedSourceType);
+                }
+                let (
+                    GenericArg::Type(TyTerm::Primitive(element)),
+                    GenericArg::Type(TyTerm::Nominal(allocator, allocator_args)),
+                ) = (&args[0], &args[1])
+                else {
+                    return Ok(IndexSelection::NeedSourceType);
+                };
+                if *allocator != global.definition().fingerprint() || !allocator_args.is_empty() {
+                    return Ok(IndexSelection::NeedSourceType);
+                }
+                (
+                    IndexReceiverKind::Vec,
+                    *element,
+                    if mutable {
+                        IndexHeaderRole::VecIndexMutImpl
+                    } else {
+                        IndexHeaderRole::VecIndexImpl
+                    },
+                )
+            }
+            TyTerm::Slice(element) if receiver_mutable.is_some() => {
+                let TyTerm::Primitive(element) = element.as_ref() else {
+                    return Ok(IndexSelection::NeedSourceType);
+                };
+                (
+                    IndexReceiverKind::SliceReference,
+                    *element,
+                    if mutable {
+                        IndexHeaderRole::SliceIndexMutImpl
+                    } else {
+                        IndexHeaderRole::SliceIndexImpl
+                    },
+                )
+            }
+            _ => return Ok(IndexSelection::NeedSourceType),
+        };
+        if *index != TyTerm::Primitive(PrimitiveType::Usize) {
+            return Ok(IndexSelection::NoSolution);
+        }
+        let implementation = self.fact(role)?;
+        let implementation_id = implementation
+            .impl_source()
+            .ok_or_else(|| fault("Index actual source impl identity absent"))?;
+        let method = implementation.member(if mutable { "index_mut" } else { "index" })?;
+        let expected = match (kind, mutable) {
+            (IndexReceiverKind::Vec, false) => "{Index::index(&**self,index)}",
+            (IndexReceiverKind::Vec, true) => "{IndexMut::index_mut(&mut**self,index)}",
+            (IndexReceiverKind::SliceReference, false) => "{index.index(self)}",
+            (IndexReceiverKind::SliceReference, true) => "{index.index_mut(self)}",
+        };
+        if method.body_tokens() != Some(expected) {
+            return Err(fault(
+                "selected standard Index body is not the captured intrinsic template",
+            ));
+        }
+        let leaf = self.fact(IndexHeaderRole::UsizeSliceIndexImpl)?;
+        let leaf_method = leaf.member(if mutable { "index_mut" } else { "index" })?;
+        let expected_leaf = if mutable {
+            "{&mut(*slice)[self]}"
+        } else {
+            "{&(*slice)[self]}"
+        };
+        if leaf_method.body_tokens() != Some(expected_leaf) {
+            return Err(fault(
+                "usize SliceIndex body differs from intrinsic bounds/lease template",
+            ));
+        }
+        if leaf
+            .associated_types()
+            .iter()
+            .find(|t| t.definition().declared_name == "Output")
+            .and_then(|t| t.written_type())
+            != Some("T")
+        {
+            return Err(fault(
+                "usize SliceIndex output is not its exact element parameter",
+            ));
+        }
+        let mut delegation = vec![
+            leaf.impl_source()
+                .ok_or_else(|| fault("usize source impl absent"))?,
+            leaf_method.definition().fingerprint(),
+        ];
+        if kind == IndexReceiverKind::Vec {
+            let slice = self.fact(if mutable {
+                IndexHeaderRole::SliceIndexMutImpl
+            } else {
+                IndexHeaderRole::SliceIndexImpl
+            })?;
+            delegation.push(
+                slice
+                    .impl_source()
+                    .ok_or_else(|| fault("slice Index impl absent"))?,
+            );
+            delegation.push(
+                slice
+                    .member(if mutable { "index_mut" } else { "index" })?
+                    .definition()
+                    .fingerprint(),
+            );
+            let deref = self.fact(if mutable {
+                IndexHeaderRole::VecDerefMutImpl
+            } else {
+                IndexHeaderRole::VecDerefImpl
+            })?;
+            delegation.push(
+                deref
+                    .impl_source()
+                    .ok_or_else(|| fault("Vec Deref impl absent"))?,
+            );
+            delegation.push(
+                self.fact(IndexHeaderRole::GlobalAllocatorImpl)?
+                    .impl_source()
+                    .ok_or_else(|| fault("Global allocator impl absent"))?,
+            );
+        }
+        if std::iter::once(&implementation_id)
+            .chain(
+                delegation
+                    .iter()
+                    .filter(|id| self.facts.values().any(|f| f.impl_source() == Some(**id))),
+            )
+            .any(|id| !self.active.contains(id))
+        {
+            return Err(fault(
+                "selected/delegated Index impl is not in current complete catalog",
+            ));
+        }
+        let trait_fact = self.fact(if mutable {
+            IndexHeaderRole::IndexMutTrait
+        } else {
+            IndexHeaderRole::IndexTrait
+        })?;
+        let proof = SelectedIndexIntrinsic {
+            library: self.selection.fingerprint(),
+            publication: self.publication,
+            consumer: self.consumer.clone(),
+            source_revision: self.source_revision,
+            seal: self.seal.clone(),
+            seal_input: self.seal_input,
+            catalog: self.catalog,
+            receiver: receiver.clone(),
+            kind,
+            element,
+            mutable,
+            trait_goal: TraitRef {
+                trait_key: trait_fact.definition().fingerprint(),
+                self_ty: receiver_target.clone(),
+                args: vec![GenericArg::Type(TyTerm::Primitive(PrimitiveType::Usize))],
+            },
+            implementation: implementation_id,
+            member: method.definition().clone(),
+            delegation,
+            dependencies: self.dependencies.clone(),
+        };
+        proof.metadata_bytes()?;
+        Ok(IndexSelection::Selected(Box::new(proof)))
+    }
+}
+impl StableEncode for SelectedIndexIntrinsic {
+    const DOMAIN: &'static str = "lrr/v1/selected-source-index-intrinsic";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.library);
+        e.digest(self.publication);
+        e.record(&self.consumer);
+        e.u64(self.source_revision);
+        e.record(&self.seal);
+        e.digest(self.seal_input);
+        e.digest(self.catalog);
+        e.record(&self.receiver);
+        e.u32(match self.kind {
+            IndexReceiverKind::Vec => 0,
+            IndexReceiverKind::SliceReference => 1,
+        });
+        e.u32(self.element.tag());
+        e.bool(self.mutable);
+        e.record(&self.trait_goal);
+        e.digest(self.implementation);
+        e.record(&self.member);
+        e.sequence(&self.delegation, |e, d| e.digest(*d));
+        e.sequence(&self.dependencies, |e, d| e.record(d));
+    }
+}
