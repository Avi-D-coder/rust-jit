+#[test]
+fn index_contract_original_assert_operand_preserves_macro_pc_and_source_origin_all_editions() {
+    use lrr::{
+        facade::macros::RuntimeMacroKind,
+        frontend::{
+            macro_names::PathLookup,
+            runtime_macro_catalog::RuntimeMacroCatalog,
+            runtime_macro_plan::{RuntimeMacroPreparation, prepare_runtime_macro},
+        },
+        ir::pc::Phase,
+        syntax::{macro_index_source::capture_macro_index_operand, spans::SourceRange},
+    };
+    let text =
+        include_str!("../../fixtures/upstream/rustc-checkout/tests/ui/binding/expr-match-panic.rs");
+    for edition in [2015, 2018, 2021, 2024] {
+        let mut profile = ProfileIdentity::current();
+        profile.edition = edition;
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+            profile.clone(),
+        )
+        .unwrap();
+        let cfg = CfgSet::guest_default();
+        let outline = parsed.outline(Digest([191; 32]), vec![], &cfg).unwrap();
+        let handle = outline
+            .items
+            .iter()
+            .find(|i| i.def_key.declared_name == "test_box")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap();
+        let index = parsed.index_body(handle, Default::default()).unwrap();
+        let start = text.find("assert_eq!(r[0], 10)").unwrap() as u32;
+        let call = parsed
+            .macro_call_at(SourceRange {
+                start,
+                end: start + 20,
+            })
+            .unwrap();
+        let catalog = RuntimeMacroCatalog::standard(&profile).unwrap();
+        let definition = catalog
+            .definitions()
+            .find(|d| catalog.select(d).unwrap() == Some(RuntimeMacroKind::AssertEq))
+            .unwrap()
+            .clone();
+        let RuntimeMacroPreparation::Intrinsic(plan) =
+            prepare_runtime_macro(&parsed, call, PathLookup::Defined(definition), &catalog)
+                .unwrap()
+        else {
+            panic!("intrinsic")
+        };
+        let site = capture_macro_index_operand(&parsed, &plan, handle, &index, 0).unwrap();
+        assert_eq!(site.receiver_name(), "r");
+        assert_eq!(
+            site.origin().relative_start + handle.range.start,
+            start + 11
+        );
+        assert_eq!(site.origin().relative_end + handle.range.start, start + 15);
+        assert_eq!(site.index_literal().spelling, "0");
+        assert_eq!(site.macro_entry().phase, Phase::Entry.code().unwrap());
+        assert_eq!(
+            index.nodes()[site.node().0 as usize].role,
+            lrr::syntax::body_index::NodeRole::Expression(
+                lrr::syntax::body_index::ExpressionKind::Macro
+            )
+        );
+        assert!(capture_macro_index_operand(&parsed, &plan, handle, &index, 1).is_err());
+    }
+    // Original token capture/phase provenance, not selected Index or body execution.
+}
