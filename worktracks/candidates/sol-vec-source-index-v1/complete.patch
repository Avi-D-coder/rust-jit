+//! Pure source capture, never a selected trait/member certificate.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    source::{
+        changes::SourceSelection,
+        manifest::{DefKey, ItemKind},
+        snapshot::CfgSet,
+    },
+    syntax::{
+        ast_adapter::range,
+        declaration_scan::DeclarationScanLimits,
+        outline::{HeaderRecipe, Outline, ScopeKey},
+        parse::ParsedFile,
+        spans::SourceRange,
+    },
+};
+use ra_ap_syntax::{
+    AstNode, SyntaxNode,
+    ast::{self, HasGenericParams, HasName, HasTypeBounds},
+};
+#[derive(Debug, Clone, Copy, Eq, PartialEq, Ord, PartialOrd)]
+pub enum IndexHeaderRole {
+    IndexTrait,
+    IndexMutTrait,
+    SliceIndexTrait,
+    VecType,
+    GlobalType,
+    VecIndexImpl,
+    VecIndexMutImpl,
+    SliceIndexImpl,
+    SliceIndexMutImpl,
+    UsizeSliceIndexImpl,
+    GlobalAllocatorImpl,
+    VecDerefImpl,
+    VecDerefMutImpl,
+    DerefTrait,
+    DerefMutTrait,
+    AllocatorTrait,
+    SizedTrait,
+    CopyTrait,
+}
+impl IndexHeaderRole {
+    pub fn tag(self) -> u32 {
+        match self {
+            Self::IndexTrait => 0,
+            Self::IndexMutTrait => 1,
+            Self::SliceIndexTrait => 2,
+            Self::VecType => 3,
+            Self::GlobalType => 4,
+            Self::VecIndexImpl => 5,
+            Self::VecIndexMutImpl => 6,
+            Self::SliceIndexImpl => 7,
+            Self::SliceIndexMutImpl => 8,
+            Self::UsizeSliceIndexImpl => 9,
+            Self::GlobalAllocatorImpl => 10,
+            Self::VecDerefImpl => 11,
+            Self::VecDerefMutImpl => 12,
+            Self::DerefTrait => 13,
+            Self::DerefMutTrait => 14,
+            Self::AllocatorTrait => 15,
+            Self::SizedTrait => 16,
+            Self::CopyTrait => 17,
+        }
+    }
+}
+#[derive(Debug, Clone)]
+pub struct IndexSourceMember {
+    definition: DefKey,
+    header: HeaderRecipe,
+    range: SourceRange,
+    body: Option<Digest>,
+    body_tokens: Option<String>,
+    signature: String,
+}
+impl IndexSourceMember {
+    pub fn signature(&self) -> &str {
+        &self.signature
+    }
+    pub fn definition(&self) -> &DefKey {
+        &self.definition
