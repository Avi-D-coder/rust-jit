+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::key::OutlineKey,
+    source::{
+        changes::SourceSelection,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{
+        parse::ParsedFile,
+        standard_index_headers::{IndexHeaderRole, capture_index_headers},
+    },
+};
+fn capture(
+    text: &str,
+    module: &[&str],
+    path: &str,
+) -> lrr::syntax::standard_index_headers::IndexSourceHeaders {
+    let mut profile = ProfileIdentity::current();
+    profile.edition = 2024;
+    let parsed =
+        ParsedFile::parse(&SourceBlob::new(text.as_bytes().to_vec()).unwrap(), profile).unwrap();
+    let cfg = CfgSet::guest_default();
+    let selection = SourceSelection {
+        path: SourcePath::new(path).unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(module[0].as_bytes()),
+            module_path: module[1..].iter().map(|s| s.to_string()).collect(),
+            cfg: cfg.fingerprint(),
+        },
+    };
+    capture_index_headers(&parsed, &selection, &cfg).unwrap()
+}
+#[test]
+fn index_contract_original_headers_keep_actual_decl_member_and_impl_sources() {
+    let ops = capture(
+        include_str!("../../fixtures/upstream/rustc-checkout/library/core/src/ops/index.rs"),
+        &["core", "ops", "index"],
+        "core/src/ops/index.rs",
+    );
+    assert_eq!(
+        ops.fact(IndexHeaderRole::IndexTrait)
+            .unwrap()
+            .definition()
+            .declared_name,
+        "Index"
+    );
+    assert_eq!(
+        ops.fact(IndexHeaderRole::IndexMutTrait)
+            .unwrap()
+            .definition()
+            .declared_name,
+        "IndexMut"
+    );
+    let slice = capture(
+        include_str!("../../fixtures/upstream/rustc-checkout/library/core/src/slice/index.rs"),
+        &["core", "slice", "index"],
+        "core/src/slice/index.rs",
+    );
+    for role in [
+        IndexHeaderRole::SliceIndexTrait,
+        IndexHeaderRole::SliceIndexImpl,
+        IndexHeaderRole::SliceIndexMutImpl,
+        IndexHeaderRole::UsizeSliceIndexImpl,
+    ] {
+        assert!(slice.fact(role).is_some());
+    }
+    let vector = capture(
+        include_str!("../../fixtures/upstream/rustc-checkout/library/alloc/src/vec/mod.rs"),
+        &["alloc", "vec"],
+        "alloc/src/vec/mod.rs",
+    );
+    for role in [
+        IndexHeaderRole::VecType,
+        IndexHeaderRole::VecIndexImpl,
+        IndexHeaderRole::VecIndexMutImpl,
+        IndexHeaderRole::VecDerefImpl,
+        IndexHeaderRole::VecDerefMutImpl,
+    ] {
+        let fact = vector.fact(role).unwrap();
+        assert_eq!(fact.source().outline.parse.profile.edition, 2024);
+        assert!(fact.range().end > fact.range().start);
+    }
+    let global = capture(
+        include_str!("../../fixtures/upstream/rustc-checkout/library/alloc/src/alloc.rs"),
+        &["alloc", "alloc"],
+        "alloc/src/alloc.rs",
+    );
+    assert!(global.fact(IndexHeaderRole::GlobalType).is_some());
+    assert!(global.fact(IndexHeaderRole::GlobalAllocatorImpl).is_some());
+    // Data capture only: this does not admit ae0fe source as the installed library.
+}
