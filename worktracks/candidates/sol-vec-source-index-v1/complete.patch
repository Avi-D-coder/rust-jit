+#[test]
+fn index_contract_captured_generic_signature_output_and_body_changes_identity() {
+    let original =
+        include_str!("../../fixtures/upstream/rustc-checkout/library/alloc/src/vec/mod.rs");
+    let baseline = capture(original, &["alloc", "vec"], "alloc/src/vec/mod.rs");
+    let fact = baseline.fact(IndexHeaderRole::VecIndexImpl).unwrap();
+    assert_eq!(
+        fact.parameter_contract(),
+        Some("<T,I:[const]SliceIndex<[T]>,A:Allocator>")
+    );
+    assert_eq!(
+        fact.member("index").unwrap().signature(),
+        "fnindex(&self,index:I)->&Self::Output"
+    );
+    assert_eq!(
+        fact.member("index").unwrap().body_tokens(),
+        Some("{Index::index(&**self,index)}")
+    );
+    assert_eq!(
+        fact.associated_types()
+            .iter()
+            .find(|t| t.definition().declared_name == "Output")
+            .unwrap()
+            .written_type(),
+        Some("I::Output")
+    );
+    for changed in [
+        original.replacen(
+            "fn index(&self, index: I) -> &Self::Output",
+            "fn index(&self, index: I) -> &T",
+            1,
+        ),
+        original.replacen(
+            "Index::index(&**self, index)",
+            "Index::index(&**self, 0)",
+            1,
+        ),
+        original.replacen(
+            "I: [const] SliceIndex<[T]>, A: Allocator> Index<I>",
+            "I: SliceIndex<[T]>, A: Allocator> Index<I>",
+            1,
+        ),
+    ] {
+        assert_ne!(changed, original, "negative must alter actual source");
+        let changed = capture(&changed, &["alloc", "vec"], "alloc/src/vec/mod.rs");
+        assert_ne!(
+            changed
+                .fact(IndexHeaderRole::VecIndexImpl)
+                .unwrap()
+                .fingerprint(),
+            fact.fingerprint()
+        );
+    }
+    // Mutation adapters outside upstream; these are capture identities, not selected authority passes.
+}
+#[test]
+fn index_contract_foreign_cfg_parse_attachment_refuses_before_source_capture() {
+    let text = include_str!("../../fixtures/upstream/rustc-checkout/library/core/src/ops/index.rs");
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity::current(),
+    )
+    .unwrap();
+    let cfg = CfgSet::guest_default();
+    let mut selection = SourceSelection {
+        path: SourcePath::new("core/src/ops/index.rs").unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(b"core"),
+            module_path: vec!["ops".into(), "index".into()],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    selection.outline.cfg = Digest::of_bytes(b"foreign-cfg");
+    assert_eq!(
+        capture_index_headers(&parsed, &selection, &cfg)
+            .unwrap_err()
+            .code,
+        "LRR-E-INDEX-SOURCE"
+    );
+}
