+//! Original assertion operand indexing, retaining its Macro PC rather than inventing an IndexExpr PC.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    expand::scopes::MacroDefinition,
+    facade::macros::RuntimeMacroKind,
+    frontend::runtime_macro_plan::RuntimeIntrinsicPlan,
+    ir::{
+        op::LiteralRecipe,
+        pc::{NodeId, PcKey},
+    },
+    source::manifest::BodyKey,
+    syntax::{
+        ast_adapter::range,
+        body_index::{BodyIndex, ExpressionKind, NodeRole},
+        outline::BodyHandle,
+        parse::{ParseKey, ParsedFile},
+        spans::{BodySpan, SourceRange},
+        thunks::literal_recipe,
+    },
+};
+use ra_ap_syntax::{AstNode, Edition, TextRange, TextSize, ast};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-INDEX-SOURCE", message.into())
+}
+fn pending(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-UNSUPPORTED", message.into())
+}
+#[derive(Debug)]
+pub struct MacroIndexOperand {
+    source: ParseKey,
+    body: BodyKey,
+    cfg: Digest,
+    node: NodeId,
+    definition: MacroDefinition,
+    operand: u32,
+    origin: BodySpan,
+    receiver_origin: BodySpan,
+    receiver_name: String,
+    index_literal: LiteralRecipe,
+    entry: PcKey,
+}
+impl MacroIndexOperand {
+    pub fn cfg(&self) -> Digest {
+        self.cfg
+    }
+    pub fn source(&self) -> &ParseKey {
+        &self.source
+    }
+    pub fn body(&self) -> &BodyKey {
+        &self.body
+    }
+    pub fn definition(&self) -> &MacroDefinition {
+        &self.definition
+    }
+    pub fn node(&self) -> NodeId {
+        self.node
+    }
+    pub fn operand(&self) -> u32 {
+        self.operand
+    }
+    pub fn origin(&self) -> &BodySpan {
+        &self.origin
+    }
+    pub fn receiver_origin(&self) -> &BodySpan {
+        &self.receiver_origin
+    }
+    pub fn receiver_name(&self) -> &str {
+        &self.receiver_name
+    }
+    pub fn index_literal(&self) -> &LiteralRecipe {
+        &self.index_literal
+    }
+    pub fn macro_entry(&self) -> &PcKey {
+        &self.entry
+    }
+    pub fn require_source(&self, parsed: &ParsedFile, index: &BodyIndex) -> Result<(), Diagnostic> {
+        if parsed.key() != self.source
+            || index.body() != &self.body
+            || index.profile() != &self.source.profile
+            || index.cfg().fingerprint() != self.cfg
+            || index
+                .nodes()
+                .get(self.node.0 as usize)
+                .is_none_or(|n| n.role != NodeRole::Expression(ExpressionKind::Macro))
+        {
+            return Err(fault("macro index source/profile/cfg/PC differs"));
+        }
+        Ok(())
+    }
+}
+pub fn capture_macro_index_operand(
+    parsed: &ParsedFile,
+    plan: &RuntimeIntrinsicPlan,
+    handle: &BodyHandle,
+    index: &BodyIndex,
+    ordinal: u32,
+) -> Result<MacroIndexOperand, Diagnostic> {
+    if parsed.generated_origin.is_some() {
+        return Err(pending(
+            "generated macro index requires exact token-origin producer",
+        ));
+    }
+    if !matches!(
+        plan.kind(),
+        RuntimeMacroKind::AssertEq | RuntimeMacroKind::AssertNe
+    ) {
+        return Err(pending(
+            "macro index requires selected assertion operand contract",
+        ));
+    }
+    plan.arguments().require_source(&parsed.key())?;
+    if handle.key() != *index.body() || index.profile() != &parsed.profile {
+        return Err(fault("macro index body/profile differs"));
+    }
+    let node = index
+        .nodes()
+        .iter()
+        .find(|n| {
+            n.role == NodeRole::Expression(ExpressionKind::Macro)
+                && n.range.start.checked_add(handle.range.start)
+                    == Some(plan.invocation().range().start)
+                && n.range.end.checked_add(handle.range.start)
+                    == Some(plan.invocation().range().end)
+        })
+        .ok_or_else(|| fault("macro index invocation is not this exact entered Macro"))?;
+    let selected = *plan
+        .arguments()
+        .operands()
+        .get(ordinal as usize)
+        .ok_or_else(|| fault("macro index ordinal absent"))?;
+    if !handle.range.contains(selected) || !plan.invocation().range().contains(selected) {
+        return Err(fault("macro index operand escapes source"));
+    }
+    let text = parsed
+        .parsed
+        .tree()
+        .syntax()
+        .text()
+        .slice(TextRange::new(
+            TextSize::from(selected.start),
+            TextSize::from(selected.end),
+        ))
+        .to_string();
+    let prefix = "fn __lrr_index_operand(){let __value=";
+    let wrapped = format!("{prefix}{text};}}");
+    if wrapped.len() > 131072 {
+        return Err(fault("macro index source byte bound"));
+    }
+    let edition = match parsed.edition {
+        2015 => Edition::Edition2015,
+        2018 => Edition::Edition2018,
+        2021 => Edition::Edition2021,
+        2024 => Edition::Edition2024,
+        _ => return Err(fault("macro index owning edition invalid")),
+    };
+    let tree = ast::SourceFile::parse(&wrapped, edition);
+    if !tree.errors().is_empty() {
+        return Err(fault("macro index argument has parse diagnostics"));
+    }
+    let mut expression = tree
+        .tree()
+        .syntax()
+        .descendants()
+        .find_map(ast::LetStmt::cast)
+        .and_then(|s| s.initializer())
+        .ok_or_else(|| fault("macro index operand wrapper missing"))?;
+    for _ in 0..128 {
+        if let ast::Expr::ParenExpr(paren) = expression {
+            expression = paren
+                .expr()
+                .ok_or_else(|| fault("macro index group missing"))?
+        } else {
+            break;
+        }
+    }
+    let ast::Expr::IndexExpr(expression) = expression else {
+        return Err(pending("assertion operand is not bounded index syntax"));
+    };
+    if expression
+        .syntax()
+        .descendants()
+        .any(|n| ast::Attr::can_cast(n.kind()))
+    {
+        return Err(pending(
+            "macro index attributes require source producer admission",
+        ));
+    }
+    let ast::Expr::PathExpr(receiver) = expression
+        .base()
+        .ok_or_else(|| fault("macro index receiver absent"))?
+    else {
+        return Err(pending(
+            "macro index receiver requires further source continuation",
+        ));
+    };
+    let path = receiver
+        .path()
+        .ok_or_else(|| fault("macro index receiver path absent"))?;
+    if path.qualifier().is_some()
+        || path
+            .segment()
+            .is_some_and(|s| s.coloncolon_token().is_some() || s.generic_arg_list().is_some())
+    {
+        return Err(pending(
+            "macro index qualified/generic receiver requires source lookup",
+        ));
+    }
+    let receiver_name = path
+        .segment()
+        .and_then(|s| s.name_ref())
+        .map(|n| n.text().to_string())
+        .ok_or_else(|| fault("macro index receiver name absent"))?;
+    crate::expand::scopes::MacroName::parse(&receiver_name, parsed.edition)?;
+    let ast::Expr::Literal(literal) = expression
+        .index()
+        .ok_or_else(|| fault("macro index argument absent"))?
+    else {
+        return Err(pending(
+            "macro index nonliteral argument requires reached source continuation",
+        ));
+    };
+    if !matches!(literal.kind(), ast::LiteralKind::IntNumber(_)) {
+        return Err(pending("macro index argument requires integer source goal"));
+    }
+    let map = |r: SourceRange| -> Result<BodySpan, Diagnostic> {
+        let offset =
+            u32::try_from(prefix.len()).map_err(|_| fault("macro index wrapper offset"))?;
+        let start = r
+            .start
+            .checked_sub(offset)
+            .and_then(|n| n.checked_add(selected.start))
+            .and_then(|n| n.checked_sub(handle.range.start))
+            .ok_or_else(|| fault("macro index source start overflow"))?;
+        let end = r
+            .end
+            .checked_sub(offset)
+            .and_then(|n| n.checked_add(selected.start))
+            .and_then(|n| n.checked_sub(handle.range.start))
+            .ok_or_else(|| fault("macro index source end overflow"))?;
+        Ok(BodySpan {
+            body_key: index.body().clone(),
+            relative_start: start,
+            relative_end: end,
+        })
+    };
+    let origin = map(range(expression.syntax().text_range()))?;
+    let receiver_origin = map(range(receiver.syntax().text_range()))?;
+    let index_literal = literal_recipe(&literal, map(range(literal.syntax().text_range()))?)?;
+    Ok(MacroIndexOperand {
+        source: parsed.key(),
+        body: index.body().clone(),
+        cfg: index.cfg().fingerprint(),
+        node: node.id,
+        definition: plan.definition().clone(),
+        operand: ordinal,
+        origin,
+        receiver_origin,
+        receiver_name,
+        index_literal,
+        entry: index.pc(node.id, crate::ir::pc::Phase::Entry)?,
+    })
+}
+impl StableEncode for MacroIndexOperand {
+    const DOMAIN: &'static str = "lrr/v1/source-macro-index-operand";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.source);
+        e.record(&self.body);
+        e.digest(self.cfg);
+        e.u32(self.node.0);
+        e.digest(self.definition.identity);
+        e.digest(self.definition.defining_unit);
+        e.u16(self.definition.definition_edition);
+        e.u32(self.operand);
+        e.u32(self.origin.relative_start);
+        e.u32(self.origin.relative_end);
+        e.u32(self.receiver_origin.relative_start);
+        e.u32(self.receiver_origin.relative_end);
+        e.string(&self.receiver_name);
+        e.u32(self.index_literal.source.relative_start);
+        e.u32(self.index_literal.source.relative_end);
+        e.string(&self.index_literal.spelling);
+        e.record(&self.entry);
+    }
+}
