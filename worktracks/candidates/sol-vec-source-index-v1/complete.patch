+//! Mechanism join after private current source-member admission. No query/parser.
+use crate::{
+    core::diagnostic::Diagnostic,
+    frontend::index_source_selection::{AdmittedIndexIntrinsic, IndexReceiverKind},
+    runtime::{
+        cell::{GuestStore, TicketId},
+        place::{Place, PlaceFailure},
+        reference::Access,
+        shape::{FacadeType, PrimitiveIdentity, TypeKey},
+        value::ValueRepr,
+    },
+    vm::fuel::RunFuel,
+};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-INDEX-SOURCE", message.into())
+}
+/// One selected Index/IndexMut invocation. Caller evaluates base/index once,
+/// attaches the actual source PC/origin and registers returned owner for cleanup.
+/// `admission` is non-Clone and consumed; scope prevents source publication changes.
+pub(crate) fn invoke_selected_index(
+    admission: AdmittedIndexIntrinsic<'_>,
+    store: &mut GuestStore,
+    fuel: &mut RunFuel,
+    receiver: &Place,
+    index: ValueRepr,
+) -> Result<TicketId, PlaceFailure> {
+    let selected = admission.selected();
+    if selected.receiver_kind() != IndexReceiverKind::Vec {
+        return Err(Diagnostic::new(
+            "LRR-E-UNSUPPORTED",
+            "selected slice Index needs an exact Buffer slice-window lease producer".into(),
+        )
+        .into());
+    }
+    let element = PrimitiveIdentity::from_recipe(selected.element())?.id();
+    let receiver_type = store.live_place_type_id(receiver)?;
+    if !matches!(store.type_descriptor(receiver_type)?.key.as_ref(),TypeKey::Facade{family:FacadeType::Vec,args}if args.as_ref()==[element])
+    {
+        return Err(
+            fault("runtime Vec receiver descriptor differs from selected source type").into(),
+        );
+    }
+    // Equal-width u64 is not usize. Bounds precede u32 narrowing in storage helper.
+    crate::runtime::place::checked_index(index)?;
+    let result_type = store
+        .find_type(&TypeKey::Ref {
+            mutable: selected.mutable(),
+            target: element,
+        })
+        .ok_or_else(|| fault("selected source reference result descriptor was not prepared"))?;
+    let place = store.vector_index(receiver, index)?;
+    let access = if selected.mutable() {
+        Access::Mutable
+    } else {
+        Access::Shared
+    };
+    if store.admit_place_borrow(&place, access)? != element {
+        return Err(fault("selected Index projection element descriptor differs").into());
+    }
+    // Reservations can retain capacity but publish no guest lease or move owner.
+    store.reserve_place_borrow_result(&place, false)?;
+    fuel.charge()?;
+    invoke_admitted(store, &place, access, result_type)
+}
+/// Step-loop integration uses this join only after the same source/preflight
+/// checks and its ordinary one-operation fuel charge; never charge twice.
+fn invoke_admitted(
+    store: &mut GuestStore,
+    place: &Place,
+    access: Access,
+    result_type: crate::runtime::shape::TypeId,
+) -> Result<TicketId, PlaceFailure> {
+    let ticket = store.borrow_ticket(place, access)?;
+    let result = store.peek_ticket(ticket)?;
+    if result.kind != 9 || result.type_id != result_type.0 {
+        store.discard(ticket)?;
+        return Err(fault("selected Index returned wrong managed reference descriptor").into());
+    }
+    Ok(ticket)
+}
