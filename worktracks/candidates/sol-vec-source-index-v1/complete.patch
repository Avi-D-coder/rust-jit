+    pub fn header(&self) -> &HeaderRecipe {
+        &self.header
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+    pub fn body(&self) -> Option<Digest> {
+        self.body
+    }
+    pub fn body_tokens(&self) -> Option<&str> {
+        self.body_tokens.as_deref()
+    }
+}
+#[derive(Debug, Clone)]
+pub struct IndexSourceAssociatedType {
+    definition: DefKey,
+    header: HeaderRecipe,
+    range: SourceRange,
+    written_type: Option<String>,
+}
+impl IndexSourceAssociatedType {
+    pub fn written_type(&self) -> Option<&str> {
+        self.written_type.as_deref()
+    }
+    pub fn definition(&self) -> &DefKey {
+        &self.definition
+    }
+    pub fn header(&self) -> &HeaderRecipe {
+        &self.header
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+}
+#[derive(Debug, Clone)]
+pub struct IndexSourceFact {
+    role: IndexHeaderRole,
+    source: SourceSelection,
+    definition: DefKey,
+    header: HeaderRecipe,
+    range: SourceRange,
+    impl_source: Option<Digest>,
+    impl_header: Option<Digest>,
+    parameter_contract: Option<String>,
+    members: Vec<IndexSourceMember>,
+    associated_types: Vec<IndexSourceAssociatedType>,
+}
+impl IndexSourceFact {
+    pub fn parameter_contract(&self) -> Option<&str> {
+        self.parameter_contract.as_deref()
+    }
+    pub fn role(&self) -> IndexHeaderRole {
+        self.role
+    }
+    pub fn source(&self) -> &SourceSelection {
+        &self.source
+    }
+    pub fn definition(&self) -> &DefKey {
+        &self.definition
+    }
+    pub fn header(&self) -> &HeaderRecipe {
+        &self.header
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+    pub fn impl_source(&self) -> Option<Digest> {
+        self.impl_source
+    }
+    pub fn impl_header(&self) -> Option<Digest> {
+        self.impl_header
+    }
+    pub fn associated_types(&self) -> &[IndexSourceAssociatedType] {
+        &self.associated_types
+    }
+    pub fn members(&self) -> &[IndexSourceMember] {
+        &self.members
+    }
+    pub fn member(&self, name: &str) -> Result<&IndexSourceMember, Diagnostic> {
+        let mut rows = self
+            .members
+            .iter()
+            .filter(|m| m.definition.declared_name == name);
+        let result = rows
+            .next()
+            .ok_or_else(|| fault("selected source member absent"))?;
+        if rows.next().is_some() {
+            return Err(fault("source member duplicated"));
+        }
+        Ok(result)
+    }
+    fn bytes(&self) -> Option<usize> {
+        let mut bytes = std::mem::size_of::<Self>()
+            .checked_add(self.source.metadata_bytes().ok()?)?
+            .checked_add(self.header.estimated_bytes())?
+            .checked_add(
+                self.members
+                    .capacity()
+                    .checked_mul(std::mem::size_of::<IndexSourceMember>())?,
+            )?;
+        bytes = bytes.checked_add(
+            self.associated_types
+                .capacity()
+                .checked_mul(std::mem::size_of::<IndexSourceAssociatedType>())?,
+        )?;
+        for a in &self.associated_types {
+            bytes = bytes
+                .checked_add(a.header.estimated_bytes())?
+                .checked_add(a.written_type.as_ref().map_or(0, String::capacity))?;
+        }
+        for m in &self.members {
+            bytes = bytes
+                .checked_add(m.header.estimated_bytes())?
+                .checked_add(m.body_tokens.as_ref().map_or(0, String::capacity))?
+                .checked_add(m.signature.capacity())?;
+        }
+        bytes = bytes.checked_add(self.parameter_contract.as_ref().map_or(0, String::capacity))?;
+        Some(bytes)
+    }
+}
+#[derive(Debug)]
+pub struct IndexSourceHeaders {
+    source: SourceSelection,
+    facts: Vec<IndexSourceFact>,
+    metadata: usize,
+    outline: std::sync::Arc<Outline>,
+}
+impl IndexSourceHeaders {
+    pub fn outline(&self) -> &Outline {
+        &self.outline
+    }
+    pub fn source(&self) -> &SourceSelection {
+        &self.source
+    }
+    pub fn facts(&self) -> &[IndexSourceFact] {
+        &self.facts
+    }
+    pub fn fact(&self, role: IndexHeaderRole) -> Option<&IndexSourceFact> {
+        self.facts.iter().find(|f| f.role == role)
+    }
+    pub fn metadata_bytes(&self) -> usize {
+        self.metadata
+    }
+}
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-INDEX-SOURCE", message.into())
+}
+fn compact(node: &SyntaxNode) -> Result<String, Diagnostic> {
+    let mut text = String::new();
+    for token in node
+        .descendants_with_tokens()
+        .filter_map(|e| e.into_token())
+        .filter(|t| !t.kind().is_trivia())
+    {
+        let n = text
+            .len()
+            .checked_add(token.text().len())
+            .filter(|n| *n <= 65536)
+            .ok_or_else(|| fault("Index source token limit"))?;
+        text.try_reserve(n - text.len())
+            .map_err(|_| fault("Index source token allocation"))?;
+        text.push_str(token.text());
+    }
+    Ok(text)
+}
+fn role(node: &SyntaxNode) -> Result<Option<IndexHeaderRole>, Diagnostic> {
+    if let Some(t) = ast::Trait::cast(node.clone()) {
+        return Ok(match t.name().map(|n| n.text().to_string()).as_deref() {
+            Some("Index") => Some(IndexHeaderRole::IndexTrait),
+            Some("IndexMut") => Some(IndexHeaderRole::IndexMutTrait),
+            Some("SliceIndex") => Some(IndexHeaderRole::SliceIndexTrait),
+            Some("Deref") => Some(IndexHeaderRole::DerefTrait),
+            Some("DerefMut") => Some(IndexHeaderRole::DerefMutTrait),
+            Some("Allocator") => Some(IndexHeaderRole::AllocatorTrait),
+            Some("Sized") => Some(IndexHeaderRole::SizedTrait),
+            Some("Copy") => Some(IndexHeaderRole::CopyTrait),
+            _ => None,
+        });
+    }
+    if let Some(t) = ast::Struct::cast(node.clone()) {
+        return Ok(match t.name().map(|n| n.text().to_string()).as_deref() {
+            Some("Vec") => Some(IndexHeaderRole::VecType),
+            Some("Global") => Some(IndexHeaderRole::GlobalType),
+            _ => None,
+        });
+    }
+    let Some(item) = ast::Impl::cast(node.clone()) else {
+        return Ok(None);
+    };
+    let Some(trait_ty) = item.trait_() else {
+        return Ok(None);
+    };
+    let Some(self_ty) = item.self_ty() else {
+        return Err(fault("Index source impl lacks self type"));
+    };
+    let trait_ty = compact(trait_ty.syntax())?;
+    let self_ty = compact(self_ty.syntax())?;
+    Ok(match (trait_ty.as_str(), self_ty.as_str()) {
+        ("Index<I>", "Vec<T,A>") => Some(IndexHeaderRole::VecIndexImpl),
+        ("IndexMut<I>", "Vec<T,A>") => Some(IndexHeaderRole::VecIndexMutImpl),
+        ("ops::Index<I>", "[T]") => Some(IndexHeaderRole::SliceIndexImpl),
+        ("ops::IndexMut<I>", "[T]") => Some(IndexHeaderRole::SliceIndexMutImpl),
+        ("SliceIndex<[T]>", "usize") => Some(IndexHeaderRole::UsizeSliceIndexImpl),
+        ("Allocator", "Global") => Some(IndexHeaderRole::GlobalAllocatorImpl),
+        ("ops::Deref", "Vec<T,A>") => Some(IndexHeaderRole::VecDerefImpl),
+        ("ops::DerefMut", "Vec<T,A>") => Some(IndexHeaderRole::VecDerefMutImpl),
+        _ => None,
+    })
+}
+/// Syntactic role recognition is data only. A current selected-library authority,
+/// complete impl catalog and resolved source goal must still authorize execution.
+pub fn capture_index_headers(
+    parsed: &ParsedFile,
+    source: &SourceSelection,
+    cfg: &CfgSet,
+) -> Result<IndexSourceHeaders, Diagnostic> {
+    if parsed.generated_origin.is_some()
+        || parsed.key() != source.outline.parse
+        || cfg.fingerprint() != source.outline.cfg
+    {
+        return Err(fault("Index source attachment/profile/cfg differs"));
+    }
+    let tree = parsed.parsed.tree();
+    let count = tree.syntax().descendants().count();
+    if count > 1_000_000 {
+        return Err(fault("Index source node limit"));
+    }
+    let outline = parsed.outline(
+        source.outline.crate_key,
+        source.outline.module_path.clone(),
+        cfg,
+    )?;
+    let scope = ScopeKey {
+        crate_key: source.outline.crate_key,
+        module_path: source.outline.module_path.clone(),
+        owner: None,
+    };
+    let scan = parsed.scan_declarations(
+        source.path.clone(),
+        scope,
+        cfg,
+        DeclarationScanLimits::default(),
+    )?;
+    let mut facts: Vec<IndexSourceFact> = Vec::new();
+    let mut metadata = std::mem::size_of::<IndexSourceHeaders>();
+    for node in tree.syntax().descendants() {
+        let Some(role) = role(&node)? else { continue };
+        let selected = range(node.text_range());
+        if parsed
+            .errors
+            .iter()
+            .any(|error| selected.contains(error.range))
+        {
+            return Err(fault("Index selected declaration has parse diagnostics"));
+        }
+        if facts.iter().any(|f| f.role == role) {
+            return Err(fault("Index source role duplicate, not a selected member"));
+        }
+        let declaration = outline
+            .items
+            .iter()
+            .find(|item| item.declaration_span == selected)
+            .ok_or_else(|| fault("Index source declaration lacks exact outline identity"))?;
+        let scanned = if declaration.def_key.item_kind == ItemKind::Impl {
+            Some(
+                scan.impls()
+                    .iter()
+                    .find(|h| h.range == selected)
+                    .ok_or_else(|| fault("Index impl absent from actual source inventory"))?,
+            )
+        } else {
+            None
+        };
+        let mut members = Vec::new();
+        let mut associated_types = Vec::new();
+        for child in node
+            .children()
+            .filter(|n| ast::AssocItemList::can_cast(n.kind()))
+            .flat_map(|list| list.children())
+        {
+            if let Some(alias) = ast::TypeAlias::cast(child.clone()) {
+                if matches!(
+                    alias.name().map(|n| n.text().to_string()).as_deref(),
+                    Some("Output" | "Target")
+                ) {
+                    let span = range(child.text_range());
+                    let item = outline
+                        .items
+                        .iter()
+                        .find(|i| i.declaration_span == span)
+                        .ok_or_else(|| {
+                            fault("Index associated type lacks exact outline identity")
+                        })?;
+                    associated_types
+                        .try_reserve_exact(1)
+                        .map_err(|_| fault("Index associated type allocation"))?;
+                    associated_types.push(IndexSourceAssociatedType {
+                        definition: item.def_key.clone(),
+                        header: item.header.clone(),
+                        range: span,
+                        written_type: alias.ty().map(|t| compact(t.syntax())).transpose()?,
+                    });
+                }
+            }
+            let Some(function) = ast::Fn::cast(child.clone()) else {
+                continue;
+            };
+            let Some(name) = function.name() else {
+                return Err(fault("Index member name absent"));
+            };
+            let name = name.text().to_string();
+            if !matches!(name.as_str(), "index" | "index_mut" | "deref" | "deref_mut") {
+                continue;
+            }
+            let span = range(child.text_range());
+            let member = outline
+                .items
+                .iter()
+                .find(|item| item.declaration_span == span)
+                .ok_or_else(|| fault("Index member lacks actual outline identity"))?;
+            if function.async_token().is_some()
+                || function.unsafe_token().is_some()
+                || function.generic_param_list().is_some()
+            {
+                return Err(fault(
+                    "Index selected member qualifiers require a different source rule",
+                ));
+            }
+            let params = function
+                .param_list()
+                .ok_or_else(|| fault("Index source member parameters absent"))?;
+            let result = function
+                .ret_type()
+                .ok_or_else(|| fault("Index source member result absent"))?;
+            let signature = format!(
+                "fn{}{}{}",
+                name,
+                compact(params.syntax())?,
+                compact(result.syntax())?
+            );
+            let body = function.body();
+            let body_tokens = body.as_ref().map(|b| compact(b.syntax())).transpose()?;
+            let body = body
+                .as_ref()
+                .map(|b| Digest::of_bytes(b.syntax().text().to_string().as_bytes()));
+            members
+                .try_reserve_exact(1)
+                .map_err(|_| fault("Index member allocation"))?;
+            members.push(IndexSourceMember {
+                definition: member.def_key.clone(),
+                header: member.header.clone(),
+                range: span,
+                body,
+                body_tokens,
+                signature,
+            });
+        }
+        let mut parameter_contract = ast::Impl::cast(node.clone())
+            .map(|item| {
+                let generic = item
+                    .generic_param_list()
+                    .map(|p| compact(p.syntax()))
+                    .transpose()?
+                    .unwrap_or_default();
+                let predicate = item
+                    .where_clause()
+                    .map(|p| compact(p.syntax()))
+                    .transpose()?
+                    .unwrap_or_default();
+                Ok::<_, Diagnostic>(format!("{generic}{predicate}"))
+            })
+            .transpose()?;
+        if let Some(item) = ast::Trait::cast(node.clone()) {
+            let generic = item
+                .generic_param_list()
+                .map(|p| compact(p.syntax()))
+                .transpose()?
+                .unwrap_or_default();
+            let mut bounds = Vec::new();
+            if let Some(list) = item.type_bound_list() {
+                for bound in list.bounds() {
+                    bounds.push(compact(bound.syntax())?);
+                }
+            }
+            let predicate = item
+                .where_clause()
+                .map(|p| compact(p.syntax()))
+                .transpose()?
+                .unwrap_or_default();
+            parameter_contract = Some(format!("{generic}|{}|{predicate}", bounds.join("+")));
+        }
+        let fact = IndexSourceFact {
+            role,
+            source: source.clone(),
+            definition: declaration.def_key.clone(),
+            header: declaration.header.clone(),
+            range: selected,
+            impl_source: scanned.map(|s| s.identity),
+            impl_header: scanned.map(|s| s.header_identity),
+            parameter_contract,
+            members,
+            associated_types,
+        };
+        metadata = metadata
+            .checked_add(
+                fact.bytes()
+                    .ok_or_else(|| fault("Index source metadata overflow"))?,
+            )
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(|| fault("Index source metadata budget"))?;
+        facts
+            .try_reserve_exact(1)
+            .map_err(|_| fault("Index fact allocation"))?;
+        facts.push(fact);
+    }
+    metadata = metadata
+        .checked_add(outline.estimated_bytes())
+        .filter(|n| *n <= 32 * 1024 * 1024)
+        .ok_or_else(|| fault("Index retained outline metadata budget"))?;
+    Ok(IndexSourceHeaders {
+        source: source.clone(),
+        facts,
+        metadata,
+        outline: std::sync::Arc::new(outline),
+    })
+}
+impl StableEncode for IndexSourceFact {
+    const DOMAIN: &'static str = "lrr/v1/index-source-header";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.u32(self.role.tag());
+        e.option(&self.parameter_contract, |e, p| e.string(p));
+        e.string(self.source.path.as_str());
+        e.record(&crate::db::key::QueryKey::Outline(
+            self.source.outline.clone(),
+        ));
+        e.record(&self.definition);
+        e.record(&self.header);
+        e.u32(self.range.start);
+        e.u32(self.range.end);
+        e.option(&self.impl_source, |e, d| e.digest(*d));
+        e.option(&self.impl_header, |e, d| e.digest(*d));
+        e.sequence(&self.associated_types, |e, a| {
+            e.record(&a.definition);
+            e.record(&a.header);
+            e.u32(a.range.start);
+            e.u32(a.range.end);
+            e.option(&a.written_type, |e, t| e.string(t));
+        });
+        e.sequence(&self.members, |e, m| {
+            e.record(&m.definition);
+            e.record(&m.header);
+            e.u32(m.range.start);
+            e.u32(m.range.end);
+            e.option(&m.body, |e, d| e.digest(*d));
+            e.option(&m.body_tokens, |e, s| e.string(s));
+            e.string(&m.signature);
+        });
+    }
+}
