+//! Source-bound UTF-8 string token data; no guest storage or reference authority.
+use crate::{core::diagnostic::Diagnostic, syntax::spans::BodySpan};
+use ra_ap_syntax::{
+    AstNode, AstToken, SyntaxKind,
+    ast::{self, IsString},
+};
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct StringLiteral(std::sync::Arc<StringData>);
+#[derive(Debug, Eq, PartialEq)]
+struct StringData {
+    text: String,
+    spelling: String,
+    source: BodySpan,
+}
+impl StringLiteral {
+    pub(crate) fn text(&self) -> &str {
+        &self.0.text
+    }
+    pub(crate) fn require(&self, spelling: &str, source: &BodySpan) -> Result<(), Diagnostic> {
+        if self.0.spelling != spelling || self.0.source != *source {
+            return Err(Diagnostic::new(
+                "LRR-E-IR-VERIFY",
+                "string decoded source certificate differs".into(),
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        self.0
+            .text
+            .capacity()
+            .checked_add(self.0.spelling.capacity())
+            .and_then(|n| {
+                n.checked_add(std::mem::size_of::<StringData>() + 2 * std::mem::size_of::<usize>())
+            })
+    }
+}
+pub(super) fn decode(
+    literal: &ast::Literal,
+    source: &BodySpan,
+) -> Result<StringLiteral, Diagnostic> {
+    let invalid = || {
+        Diagnostic::new(
+            "LRR-E-UNSUPPORTED",
+            "string requires a valid pinned string token".into(),
+        )
+    };
+    let token = literal
+        .syntax()
+        .children_with_tokens()
+        .filter_map(|child| child.into_token())
+        .find(|token| token.kind() == SyntaxKind::STRING)
+        .and_then(ast::String::cast)
+        .ok_or_else(invalid)?;
+    decode_token(&token, source)
+}
+fn decode_token(token: &ast::String, source: &BodySpan) -> Result<StringLiteral, Diagnostic> {
+    let invalid = || {
+        Diagnostic::new(
+            "LRR-E-UNSUPPORTED",
+            "string requires a valid pinned string token".into(),
+        )
+    };
+    if token.syntax().text().len() > 1024 * 1024 {
+        return Err(Diagnostic::new(
+            "LRR-E-BODY-INDEX-LIMIT",
+            "string lexical payload exceeds source budget".into(),
+        ));
+    }
+    let range = token.text_range_between_quotes().ok_or_else(invalid)?;
+    let content = &token.text()[range - token.syntax().text_range().start()];
+    // rustc normalizes source CRLF before lexing. Preserve our source spelling
+    // and offsets, and normalize only the content passed to its pinned decoder.
+    let content = normalize_crlf(content)?;
+    let mut text = String::new();
+    text.try_reserve_exact(content.len())
+        .map_err(|_| crate::runtime::arena::resource())?;
+    let mut failed = false;
+    let mut emit = |_, value: Result<char, ra_ap_syntax::unescape::EscapeError>| match value {
+        Ok(value) => text.push(value),
+        Err(error) => failed |= error.is_fatal(),
+    };
+    if token.is_raw() {
+        // The pinned validator also rejects standalone CR while retaining valid Unicode.
+        ra_ap_syntax::unescape::check_raw_str(&content, &mut emit);
+    } else {
+        ra_ap_syntax::unescape::unescape_str(&content, &mut emit);
+    }
+    if failed {
+        return Err(invalid());
+    }
+    let mut spelling = String::new();
+    spelling
+        .try_reserve_exact(token.text().len())
+        .map_err(|_| crate::runtime::arena::resource())?;
+    spelling.push_str(token.text());
+    Ok(StringLiteral(std::sync::Arc::new(StringData {
+        text,
+        spelling,
+        source: source.clone(),
+    })))
+}
+fn normalize_crlf(text: &str) -> Result<std::borrow::Cow<'_, str>, Diagnostic> {
+    if !text.contains("\r\n") {
+        return Ok(std::borrow::Cow::Borrowed(text));
+    }
+    let mut normalized = String::new();
+    normalized
+        .try_reserve_exact(text.len())
+        .map_err(|_| crate::runtime::arena::resource())?;
+    for line in text.split_inclusive('\n') {
+        if let Some(prefix) = line.strip_suffix("\r\n") {
+            normalized.push_str(prefix);
+            normalized.push('\n');
+        } else {
+            normalized.push_str(line);
+        }
+    }
+    Ok(std::borrow::Cow::Owned(normalized))
+}
