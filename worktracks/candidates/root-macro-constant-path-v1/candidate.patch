+    #[test]
+    fn unchanged_constant_operand_keeps_original_span_and_rejects_foreign_binding() {
+        for edition in [2015, 2018, 2021, 2024] {
+            let (parsed, body, index, sites) =
+                super::super::control_tests::entered(ORIGINAL, edition);
+            let [(key, arguments)] = sites.as_slice() else {
+                panic!("one original assertion")
+            };
+            let plan = parsed
+                .runtime_macro_scalar_plan(&body, &index, key, arguments)
+                .unwrap();
+            let paths = plan
+                .steps()
+                .iter()
+                .filter_map(|step| match step {
+                    RuntimeScalarStep::ConstantPath(path) => Some(path.as_ref()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>();
+            let [path] = paths.as_slice() else {
+                panic!("one original constant path")
+            };
+            path.require(&parsed.key(), &index, path.key().unwrap())
+                .unwrap();
+            let span = path.span();
+            assert_eq!(
+                &ORIGINAL[(body.range.start + span.relative_start) as usize
+                    ..(body.range.start + span.relative_end) as usize],
+                "X"
+            );
+            assert_eq!(path.spelling(), "X");
+            assert!(matches!(path.exit(&index).unwrap(), RecipeExit::Next(_)));
+            let mut foreign = parsed.key();
+            foreign.profile.edition = if edition == 2024 { 2021 } else { 2024 };
+            assert!(path.require(&foreign, &index, path.key().unwrap()).is_err());
+            let mut pc = path.key().unwrap().clone();
+            pc.phase = Phase::Commit.code().unwrap();
+            assert!(path.require(&parsed.key(), &index, &pc).is_err());
+            let mut wrong = (*path).clone();
+            wrong.destination = SlotId(u32::MAX);
+            assert!(
+                wrong
+                    .require(&parsed.key(), &index, path.key().unwrap())
+                    .is_err()
+            );
+            let mut wrong = (*path).clone();
+            wrong.span.relative_start = wrong.span.relative_end;
+            assert!(
+                wrong
+                    .require(&parsed.key(), &index, path.key().unwrap())
+                    .is_err()
+            );
+            let mut wrong = (*path).clone();
+            wrong.next = Some(index.pc(NodeId(key.node), Phase::Commit).unwrap());
+            assert!(
+                wrong
+                    .require(&parsed.key(), &index, path.key().unwrap())
+                    .is_err()
+            );
+            assert!(path.metadata_bytes().unwrap() <= 32 << 20);
+        }
+    }
