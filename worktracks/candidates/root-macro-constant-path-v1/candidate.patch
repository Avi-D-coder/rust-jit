+//! Original opaque-operand path data. This is neither name nor query authority.
+use super::*;
+use crate::{
+    core::digest::{Digest, StableEncode, StableEncoder},
+    ir::{
+        pc::{NodeId, Phase},
+        recipe::RecipeExit,
+    },
+    syntax::parse::ParseKey,
+};
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct RuntimeMacroConstantPath {
+    source: ParseKey,
+    key: Option<PcKey>,
+    body_index: Option<Digest>,
+    span: BodySpan,
+    destination: SlotId,
+    spelling: String,
+    next: Option<PcKey>,
+    last: bool,
+}
+impl RuntimeMacroConstantPath {
+    pub(super) fn new(
+        source: ParseKey,
+        span: BodySpan,
+        destination: SlotId,
+        spelling: &str,
+    ) -> Result<Self, Diagnostic> {
+        crate::expand::scopes::MacroName::parse(spelling, source.profile.edition)?;
+        if spelling.len() > 4096 || span.relative_start >= span.relative_end {
+            return Err(invalid("constant operand spelling/span limit"));
+        }
+        let mut owned = String::new();
+        owned
+            .try_reserve_exact(spelling.len())
+            .map_err(|_| invalid("constant operand allocation"))?;
+        owned.push_str(spelling);
+        Ok(Self {
+            source,
+            key: None,
+            body_index: None,
+            span,
+            destination,
+            spelling: owned,
+            next: None,
+            last: false,
+        })
+    }
+    pub(super) fn bind(
+        &mut self,
+        body: &BodyIndex,
+        base: &PcKey,
+        ordinal: usize,
+        count: usize,
+    ) -> Result<(), Diagnostic> {
+        if self.key.is_some() || count == 0 || ordinal >= count {
+            return Err(invalid("constant operand phase binding differs"));
+        }
+        let phase = if ordinal == 0 {
+            Phase::Entry
+        } else {
+            Phase::Operand(
+                u16::try_from(ordinal - 1)
+                    .map_err(|_| invalid("constant operand phase overflow"))?,
+            )
+        };
+        let pc = body.pc(NodeId(base.node), phase)?;
+        self.last = ordinal.checked_add(1) == Some(count);
+        self.next = Some(body.pc(
+            NodeId(base.node),
+            if self.last {
+                Phase::Exit
+            } else {
+                Phase::Operand(
+                    u16::try_from(ordinal)
+                        .map_err(|_| invalid("constant operand successor overflow"))?,
+                )
+            },
+        )?);
+        self.body_index = Some(body.fingerprint());
+        self.key = Some(pc.clone());
+        self.require(&self.source, body, &pc)
+    }
+    pub(crate) fn require(
+        &self,
+        source: &ParseKey,
+        body: &BodyIndex,
+        pc: &PcKey,
+    ) -> Result<(), Diagnostic> {
+        let node = body
+            .nodes()
+            .get(pc.node as usize)
+            .ok_or_else(|| invalid("constant operand node absent"))?;
+        if &self.source != source
+            || body.profile() != &source.profile
+            || self.body_index != Some(body.fingerprint())
+            || self.key.as_ref() != Some(pc)
+            || body.body() != &pc.body
+            || self.span.body_key != pc.body
+            || node.role != NodeRole::Expression(ExpressionKind::Macro)
+            || self.span.relative_start < node.range.start
+            || self.span.relative_end > node.range.end
+            || self.span.relative_start >= self.span.relative_end
+            || (!node.runtime_scalar_slots.contains(&self.destination)
+                && node.runtime_temporaries[0] != Some(self.destination))
+        {
+            return Err(invalid("constant operand source/body/PC/span/slot differs"));
+        }
+        let next = self
+            .next
+            .as_ref()
+            .ok_or_else(|| invalid("constant operand successor absent"))?;
+        let phase = if self.last {
+            Phase::Exit
+        } else {
+            match Phase::from_code(pc.phase) {
+                Phase::Entry => Phase::Operand(0),
+                Phase::Operand(n) => Phase::Operand(
+                    n.checked_add(1)
+                        .ok_or_else(|| invalid("constant operand successor overflow"))?,
+                ),
+                _ => return Err(invalid("constant operand is not an evaluation phase")),
+            }
+        };
+        if *next != body.pc(node.id, phase)? {
+            return Err(invalid("constant operand retained successor differs"));
+        }
+        Ok(())
+    }
+    pub(crate) fn key(&self) -> Result<&PcKey, Diagnostic> {
+        self.key
+            .as_ref()
+            .ok_or_else(|| invalid("constant operand is unbound"))
+    }
+    pub(crate) fn source(&self) -> &ParseKey {
+        &self.source
+    }
+    pub(crate) fn span(&self) -> &BodySpan {
+        &self.span
+    }
+    pub(crate) fn destination(&self) -> SlotId {
+        self.destination
+    }
+    pub(crate) fn spelling(&self) -> &str {
+        &self.spelling
+    }
+    pub(crate) fn next(&self) -> Result<&PcKey, Diagnostic> {
+        self.next
+            .as_ref()
+            .ok_or_else(|| invalid("constant operand successor is unbound"))
+    }
+    pub(crate) fn exit(&self, body: &BodyIndex) -> Result<RecipeExit, Diagnostic> {
+        let key = self.key()?;
+        self.require(&self.source, body, key)?;
+        if self.last {
+            let node = &body.nodes()[key.node as usize];
+            let condition = node.runtime_temporaries[0]
+                .ok_or_else(|| invalid("constant predicate slot absent"))?;
+            if condition != self.destination {
+                return Err(invalid("terminal constant operand is not its predicate"));
+            }
+            Ok(RecipeExit::Branch {
+                condition,
+                yes: self.next()?.clone(),
+                no: body.pc(node.id, Phase::Commit)?,
+            })
+        } else {
+            Ok(RecipeExit::Next(self.next()?.clone()))
+        }
+    }
+    pub(crate) fn metadata_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.source.profile.semantics.capacity())?
+            .checked_add(self.spelling.capacity())
+    }
+}
+impl StableEncode for RuntimeMacroConstantPath {
+    const DOMAIN: &'static str = "lrr/v1/runtime-macro-constant-path";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.source);
+        e.option(&self.key, |e, key| e.record(key));
+        e.option(&self.body_index, |e, body| e.digest(*body));
+        e.record(&self.span.body_key);
+        e.u32(self.span.relative_start);
+        e.u32(self.span.relative_end);
+        e.u32(self.destination.0);
+        e.string(&self.spelling);
+        e.option(&self.next, |e, next| e.record(next));
+        e.bool(self.last);
+    }
+}
