+//! Whole unchanged upstream runtime witness; no native guest compilation.
+use super::*;
+use crate::{
+    db::{key::QueryKey, poll::QueryPoll},
+    engine::{
+        run::{RunMachine, RunPoll, ValueSummary},
+        standalone_macros::CompletedStandaloneRuntimeMacros,
+    },
+    ir::op::SOURCE_CONSTANT_OPCODE,
+};
+#[test]
+fn unchanged_nested_const_fn_entire_main_resolves_assertion_constant_all_editions() {
+    let path = std::path::Path::new(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../fixtures/upstream/rustc-checkout/tests/ui/consts/const-fn-nested.rs"
+    ));
+    for edition in [2015, 2018, 2021, 2024] {
+        let (prepared, view, sources, mut snapshot) =
+            super::super::capture_standalone_edition(path, false, edition).unwrap();
+        let (compiler, prepared, view, sources) =
+            super::super::compile_inputs::PreparedCompileInputs::prepare(
+                path, prepared, view, sources,
+            )
+            .unwrap();
+        let mut db = Database::default();
+        db.trace.detailed = true;
+        prepared.publish(&mut db).unwrap();
+        db.begin_expansion_epoch(1).unwrap();
+        let constant = view
+            .outline()
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == "X")
+            .unwrap()
+            .def_key
+            .fingerprint();
+        let mut discovery = SourceDiscovery::new(
+            sources,
+            view.outline().root_scope.clone(),
+            Namespace::Value,
+            view.selection().outline.crate_key,
+            1,
+        )
+        .unwrap()
+        .with_declarative_compiler(
+            compiler.environment_identity(),
+            crate::expand::source_declarative::engine_version(),
+            compiler.catalog.clone(),
+        )
+        .unwrap();
+        compiler
+            .discover_diagnostic(&mut discovery, &mut db, &mut snapshot)
+            .unwrap();
+        let macros = CompletedStandaloneRuntimeMacros::from_discovery(&view, &discovery).unwrap();
+        let contexts = macros.contexts().unwrap();
+        discovery.publish(&mut db).unwrap();
+        let callable = match discovery.entry_function(&mut db, "main") {
+            QueryPoll::Ready(Ok(crate::frontend::callables::CallSelection::Source(callable))) => {
+                callable
+            }
+            other => panic!("original main selection/{edition}: {other:?}"),
+        };
+        callable.revalidate(&mut db).unwrap();
+        let body = callable.body().unwrap().key();
+        let mut service = ReachedScopes::from_discovery(&discovery).unwrap();
+        let mut run = RunMachine::start_with_discovery(&mut db, body, 10_000, discovery)
+            .into_ready()
+            .unwrap()
+            .unwrap();
+        db.begin_run().unwrap();
+        let report =
+            match run.poll_with_runtime_macros_servicing(&mut db, &contexts, &mut |db, request| {
+                service.fulfill(request, db, &compiler, &mut snapshot)
+            }) {
+                RunPoll::Completed(report) => report,
+                RunPoll::Fault(error) => panic!("original nested constant main/{edition}: {error}"),
+                RunPoll::NeedInput(input) => {
+                    panic!("original nested constant main/{edition}: {input:?}")
+                }
+                RunPoll::Panicked(report) => {
+                    panic!("original nested constant main/{edition}: {report:?}")
+                }
+            };
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(
+            report.opcode_counters.started_by_opcode[usize::from(SOURCE_CONSTANT_OPCODE)],
+            1
+        );
+        assert_eq!(report.opcode_counters.started_by_opcode[26], 1);
+        assert_eq!(
+            report.opcode_counters.operations_started,
+            report.opcode_counters.operations_completed
+        );
+        assert!(db.trace.events.iter().any(
+            |event| matches!(&event.key, QueryKey::Constant(key) if key.definition() == constant)
+        ));
+        assert!(service.fulfilled.iter().any(|key| matches!(
+            key.domain,
+            SealDomain::Scope {
+                namespace: Namespace::Type,
+                ..
+            }
+        )));
+        assert!(matches!(
+            run.poll_with_runtime_macros(&mut db, &contexts),
+            RunPoll::Fault(_)
+        ));
+        db.finish_run().unwrap();
+    }
+}
