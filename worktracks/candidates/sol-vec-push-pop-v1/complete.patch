+#[test]
+fn vector_actual_growth_then_pop_cleanup_drops_remaining_in_order() {
+    let (mut s, c) = empty(100000);
+    for n in 1..=7 {
+        push(&mut s, c, n);
+    }
+    let t = pop(&mut s, c).unwrap();
+    s.discard(t).unwrap();
+    let parent = s.begin_drop(c).unwrap();
+    let mut actual = Vec::new();
+    loop {
+        match s.aggregate_cleanup_transfer(parent).unwrap() {
+            lrr::runtime::cell::AggregateCleanupTransfer::Field { cell, ticket } => {
+                actual.push(s.peek_ticket(ticket).unwrap());
+                s.discard(ticket).unwrap();
+                s.finish_aggregate_cleanup_field(parent, cell, ticket)
+                    .unwrap();
+            }
+            lrr::runtime::cell::AggregateCleanupTransfer::Complete => break,
+            lrr::runtime::cell::AggregateCleanupTransfer::Skipped => panic!("live scalar skipped"),
+        }
+    }
+    s.discard(parent).unwrap();
+    assert_eq!(
+        actual,
+        (1..=6)
+            .map(|n| ValueRepr::signed(TypeId(8), n).unwrap())
+            .collect::<Vec<_>>()
+    );
+}
