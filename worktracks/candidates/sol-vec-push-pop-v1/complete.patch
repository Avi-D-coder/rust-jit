@@ -0,0 +1,323 @@
+use lrr::{
+    runtime::{
+        cell::{CellId, CellOwner, GuestStore, RefId, StorageContract, TicketId},
+        place::Place,
+        reference::Access,
+        shape::{TypeId, TypeKey},
+        value::ValueRepr,
+        vector_mutation::VectorMutationResult,
+    },
+    vm::{fuel::RunFuel, vector::VectorConstruction},
+};
+fn empty(handles: u32) -> (GuestStore, CellId) {
+    empty_element(handles, TypeId(8))
+}
+fn empty_element(handles: u32, element: TypeId) -> (GuestStore, CellId) {
+    let mut s = GuestStore::new(1, handles, 16 << 20).unwrap();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut v = VectorConstruction::begin(&mut s, &mut fuel, element, 0).unwrap();
+    let t = v.finish(&mut s, &mut fuel).unwrap();
+    let ty = TypeId(s.peek_ticket(t).unwrap().type_id);
+    let frame = s.new_frame_anchor().unwrap();
+    let c = s
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    s.initialize(c, t).unwrap();
+    let slice = s.intern_type(TypeKey::Slice { element }).unwrap();
+    for target in [slice, element] {
+        for mutable in [false, true] {
+            s.intern_type(TypeKey::Ref { mutable, target }).unwrap();
+        }
+    }
+    (s, c)
+}
+fn idx(n: u64) -> ValueRepr {
+    ValueRepr::unsigned(TypeId(13), n).unwrap()
+}
+fn incoming(s: &mut GuestStore, n: i64) -> TicketId {
+    s.ticket(ValueRepr::signed(TypeId(8), n).unwrap()).unwrap()
+}
+fn push(s: &mut GuestStore, c: CellId, n: i64) {
+    let t = incoming(s, n);
+    let p = s.prepare_vector_push(&Place::cell(c), t).unwrap();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let VectorMutationResult::Pushed(unit) = s.execute_vector_mutation(p, &mut fuel).unwrap()
+    else {
+        panic!("push result")
+    };
+    assert_eq!(s.peek_ticket(unit).unwrap(), ValueRepr::unit());
+    s.discard(unit).unwrap();
+    assert!(s.peek_ticket(t).is_err());
+}
+fn pop(s: &mut GuestStore, c: CellId) -> Option<TicketId> {
+    let p = s.prepare_vector_pop(&Place::cell(c)).unwrap();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let VectorMutationResult::Popped(value) = s.execute_vector_mutation(p, &mut fuel).unwrap()
+    else {
+        panic!("pop result")
+    };
+    value
+}
+fn reference(s: &mut GuestStore, t: TicketId) -> RefId {
+    let ty = TypeId(s.peek_ticket(t).unwrap().type_id);
+    let frame = s.new_frame_anchor().unwrap();
+    let c = s
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 1 },
+        )
+        .unwrap();
+    s.initialize(c, t).unwrap();
+    s.reference_from_cell(c).unwrap()
+}
+fn window(s: &mut GuestStore, c: CellId, a: u64, b: u64) -> RefId {
+    let p = s
+        .prepare_vector_window(&Place::cell(c), idx(a), idx(b), Access::Shared)
+        .unwrap();
+    let t = s.commit_buffer_borrow(p).unwrap();
+    reference(s, t)
+}
+fn element(s: &mut GuestStore, r: RefId, i: u64) -> RefId {
+    let p = s.prepare_slice_element(r, idx(i), Access::Shared).unwrap();
+    let t = s.commit_buffer_borrow(p).unwrap();
+    reference(s, t)
+}
