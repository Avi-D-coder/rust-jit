+#[test]
+fn vector_actual_push_admission_faults_preserve_input_and_prefix() {
+    let (mut s, c) = empty(100000);
+    push(&mut s, c, 1);
+    let prefix = window(&mut s, c, 0, 1);
+    let t = incoming(&mut s, 2);
+    let p = s.prepare_vector_push(&Place::cell(c), t).unwrap();
+    s.reserve_vector_mutation(&p).unwrap();
+    let before = s.budget().handles();
+    let mut fuel = RunFuel::new(0).unwrap();
+    assert!(s.execute_vector_mutation(p, &mut fuel).is_err());
+    assert_eq!(s.budget().handles(), before);
+    assert!(s.peek_ticket(t).is_ok());
+    assert_eq!(s.buffer_slice_len(prefix).unwrap(), 1);
+    let p = s.prepare_vector_push(&Place::cell(c), t).unwrap();
+    let mut fuel = RunFuel::new(1).unwrap();
+    fuel.cancellation().cancel();
+    assert!(s.execute_vector_mutation(p, &mut fuel).is_err());
+    assert_eq!(s.vector_len(&Place::cell(c)).unwrap(), 1);
+    let shared = s.borrow_ticket(&Place::cell(c), Access::Shared).unwrap();
+    let shared = reference(&mut s, shared);
+    assert!(s.prepare_vector_push(&Place::deref(shared), t).is_err());
+    assert!(s.prepare_vector_pop(&Place::deref(shared)).is_err());
+    let wrong = s.ticket(ValueRepr::boolean(true)).unwrap();
+    assert!(s.prepare_vector_push(&Place::cell(c), wrong).is_err());
+    assert!(s.peek_ticket(wrong).is_ok());
+}
