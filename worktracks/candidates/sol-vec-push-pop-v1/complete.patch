+//! Scalar-only checked Vec transactions; selection/phase/fuel belongs to the driver.
+use super::*;
+use crate::runtime::{
+    object::{MAX_CONSTRUCTION_FIELDS, VectorBuffer},
+    vector_mutation::{PreparedVectorMutation, VectorChange, VectorMember, VectorMutationResult},
+};
+impl GuestStore {
+    fn prepare_vector_change(
+        &self,
+        base: &Place,
+        incoming: Option<TicketId>,
+    ) -> Result<PreparedVectorMutation, PlaceFailure> {
+        let resolved = self.resolve_place(base)?;
+        if !resolved.writable {
+            return Err(access_fault().into());
+        }
+        let element = match self.types.descriptor(resolved.ty)?.key.as_ref() {
+            TypeKey::Facade {
+                family: crate::runtime::shape::FacadeType::Vec,
+                args,
+            } if args.len() == 1 => args[0],
+            _ => return Err(invalid().into()),
+        };
+        if self.types.descriptor(element)?.shape != ShapeCategory::Scalar || element.0 == 16 {
+            return Err(Diagnostic::new(
+                "LRR-E-UNSUPPORTED",
+                "Vec mutation requires pending general source/layout/drop integration".into(),
+            )
+            .into());
+        }
+        let (object, storage) = self.place_object(resolved.target.cell)?;
+        let buffer = storage.buffer.ok_or_else(lease_fault)?;
+        self.validate_vector_buffer_owner(object, buffer.generation)?;
+        if !storage.initialized.complete_value() {
+            return Err(ownership().into());
+        }
+        let count = storage.fields.len();
+        let old_count = u32::try_from(count).map_err(|_| resource())?;
+        let (new_count, capacity, generation, change) = if let Some(ticket) = incoming {
+            let value = self.peek_ticket(ticket)?;
+            self.object_owner(value, ValueOwner::Ticket(ticket))?;
+            if !matches!(value.kind, 1..=7) || TypeId(value.type_id) != element {
+                return Err(Diagnostic::new(
+                    "LRR-E-VEC-ELEMENT",
+                    "evaluated Vec push element differs from bound source element".into(),
+                )
+                .into());
+            }
+            let next = old_count.checked_add(1).ok_or_else(resource)?;
+            let grow = next > buffer.capacity;
+            let capacity = if grow {
+                if buffer.capacity == 0 {
+                    4
+                } else {
+                    buffer.capacity.checked_mul(2).ok_or_else(resource)?
+                }
+            } else {
+                buffer.capacity
+            };
+            let generation = if grow {
+                buffer.generation.checked_add(1).ok_or_else(resource)?
+            } else {
+                buffer.generation
+            };
+            (
+                next,
+                capacity,
+                generation,
+                VectorChange::Push {
+                    incoming: ticket,
+                    value,
+                    grow,
+                },
+            )
+        } else {
+            (
+                old_count.saturating_sub(1),
+                buffer.capacity,
+                buffer.generation,
+                VectorChange::Pop,
+            )
+        };
+        if capacity as usize > MAX_CONSTRUCTION_FIELDS || new_count > capacity {
+            return Err(resource().into());
+        }
+        let mut members = Vec::new();
+        members.try_reserve_exact(count).map_err(|_| resource())?;
+        for (i, cell) in storage.fields.iter().copied().enumerate() {
+            if self.cells.get(cell)?.owner
+                != (CellOwner::Buffer {
+                    object,
+                    index: u32::try_from(i).map_err(|_| resource())?,
+                })
+            {
+                return Err(ownership().into());
+            }
+            let stamp = self.place_stamp(cell)?;
+            let value = self.admit_live_value(cell)?;
+            if !matches!(value.kind, 1..=7) || TypeId(value.type_id) != element {
+                return Err(ownership().into());
+            }
+            members.push(VectorMember {
+                stamp,
+                value,
+                retired_epoch: if matches!(change, VectorChange::Push { grow: true, .. })
+                    || (matches!(change, VectorChange::Pop) && i + 1 == count)
+                {
+                    stamp.epoch.checked_add(1).ok_or_else(resource)?
+                } else {
+                    stamp.epoch
+                },
+            });
+        }
+        let mut fields = Vec::new();
+        fields
+            .try_reserve_exact(capacity as usize)
+            .map_err(|_| resource())?;
+        if !matches!(change, VectorChange::Push { grow: true, .. }) {
+            fields.extend(storage.fields.iter().copied().take(new_count as usize));
+        }
+        let initialized = InitializedFields::complete(new_count as usize)?;
+        let owned = fields
+            .capacity()
+            .checked_mul(std::mem::size_of::<CellId>())
+            .and_then(|n| n.checked_add(initialized.owned_bytes()?))
+            .ok_or_else(resource)?;
+        let mut projections = Vec::new();
+        checked_chain_bytes(base.projections.len())?;
+        projections
+            .try_reserve_exact(base.projections.len())
+            .map_err(|_| resource())?;
+        projections.extend_from_slice(&base.projections);
+        checked_chain_bytes(projections.capacity())?;
+        let metadata = members
+            .capacity()
+            .checked_mul(std::mem::size_of::<VectorMember>())
+            .and_then(|n| n.checked_add(owned))
+            .and_then(|n| {
+                n.checked_add(
+                    projections
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<Projection>())?,
+                )
+            })
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(resource)?;
+        let _ = metadata;
+        let plan = PreparedVectorMutation {
+            epoch: self.budget.epoch(),
+            base: Place {
+                root: base.root,
+                projections: projections.into_boxed_slice(),
+            },
+            container: resolved.target,
+            object,
+            ty: resolved.ty,
+            element,
+            old_capacity: buffer.capacity,
+            old_generation: buffer.generation,
+            capacity,
+            generation,
+            members,
+            fields,
+            initialized,
+            owned,
+            change,
+        };
+        self.preflight_vector_mutation(&plan)?;
+        Ok(plan)
+    }
+    pub fn prepare_vector_push(
+        &self,
+        base: &Place,
+        incoming: TicketId,
+    ) -> Result<PreparedVectorMutation, PlaceFailure> {
+        self.prepare_vector_change(base, Some(incoming))
+    }
+    pub fn prepare_vector_pop(&self, base: &Place) -> Result<PreparedVectorMutation, PlaceFailure> {
+        self.prepare_vector_change(base, None)
+    }
+    fn mutation_reservations(
+        &self,
+        plan: &PreparedVectorMutation,
+    ) -> Result<(usize, usize, u32, usize), Diagnostic> {
+        let (cells, objects, tickets) = match plan.change {
+            VectorChange::Push { grow: true, .. } => (
+                plan.members.len().checked_add(1).ok_or_else(resource)?,
+                1,
+                1,
+            ),
+            VectorChange::Push { grow: false, .. } => (1, 0, 1),
+            VectorChange::Pop => (0, 0, usize::from(!plan.members.is_empty())),
+        };
+        let handles = u32::try_from(
+            cells
+                .checked_add(objects)
+                .and_then(|n| n.checked_add(tickets))
+                .ok_or_else(resource)?,
+        )
+        .map_err(|_| resource())?;
+        let payload = if objects != 0 {
+            plan.owned
+        } else {
+            plan.owned
+                .saturating_sub(self.objects.payload_bytes(plan.object)?)
+        };
+        let bytes = payload
+            .checked_add(self.cells.reservation_bytes(cells)?)
+            .and_then(|n| n.checked_add(self.objects.reservation_bytes(objects).ok()?))
+            .and_then(|n| n.checked_add(self.tickets.reservation_bytes(tickets).ok()?))
+            .ok_or_else(resource)?;
+        Ok((cells, objects, handles, bytes))
+    }
+    fn preflight_vector_mutation(&self, plan: &PreparedVectorMutation) -> Result<(), PlaceFailure> {
+        if plan.epoch != self.budget.epoch() {
+            return Err(lease_fault().into());
+        }
+        let resolved = self.resolve_place(&plan.base)?;
+        if !resolved.writable {
+            return Err(access_fault().into());
+        }
+        if resolved.target != plan.container || resolved.ty != plan.ty {
+            return Err(lease_fault().into());
+        }
+        let (object, storage) = self.place_object(resolved.target.cell)?;
+        let buffer = storage.buffer.ok_or_else(lease_fault)?;
+        self.validate_vector_buffer_owner(object, buffer.generation)?;
+        if object != plan.object
+            || buffer.capacity != plan.old_capacity
+            || buffer.generation != plan.old_generation
+            || storage.fields.len() != plan.members.len()
+            || !storage.initialized.complete_value()
+        {
+            return Err(lease_fault().into());
+        }
+        for (i, m) in plan.members.iter().enumerate() {
+            if storage.fields.get(i) != Some(&m.stamp.cell)
+                || self.place_stamp(m.stamp.cell)? != m.stamp
+                || self.admit_live_value(m.stamp.cell)? != m.value
+            {
+                return Err(lease_fault().into());
+            }
+        }
+        if let VectorChange::Push {
+            incoming, value, ..
+        } = plan.change
+        {
+            if self.peek_ticket(incoming)? != value {
+                return Err(ownership().into());
+            }
+            self.object_owner(value, ValueOwner::Ticket(incoming))?;
+        }
+        self.prepare_initialization_change(plan.container.cell, true)?;
+        let (_, _, handles, bytes) = self.mutation_reservations(plan)?;
+        self.budget.check(handles, bytes)?;
+        Ok(())
+    }
+    /// Reserves every publication capacity before consuming any existing owner.
+    pub fn reserve_vector_mutation(
+        &mut self,
+        plan: &PreparedVectorMutation,
+    ) -> Result<(), PlaceFailure> {
+        self.preflight_vector_mutation(plan)?;
+        let (cells, objects, _, _) = self.mutation_reservations(plan)?;
+        self.cells.reserve(cells, &mut self.budget)?;
+        self.objects.reserve(objects, &mut self.budget)?;
+        let tickets = match plan.change {
+            VectorChange::Push { .. } => 1,
+            VectorChange::Pop => usize::from(!plan.members.is_empty()),
+        };
+        self.tickets.reserve(tickets, &mut self.budget)?;
+        self.preflight_vector_mutation(plan)
+    }
+    /// Standalone precise helper: opcode charge then reservation and element work.
+    /// Root first establishes actual source member/receiver/type admission.
+    pub fn execute_vector_mutation(
+        &mut self,
+        plan: PreparedVectorMutation,
+        fuel: &mut crate::vm::fuel::RunFuel,
+    ) -> Result<VectorMutationResult, PlaceFailure> {
+        self.preflight_vector_mutation(&plan)?;
+        fuel.charge()?;
+        self.commit_vector_mutation_admitted(plan, fuel)
+    }
+    /// Authoritative step has charged its opcode once; helper charges each
+    /// processed scalar element before work and rolls back unpublished growth.
+    pub(crate) fn commit_vector_mutation_admitted(
+        &mut self,
+        mut plan: PreparedVectorMutation,
+        fuel: &mut crate::vm::fuel::RunFuel,
+    ) -> Result<VectorMutationResult, PlaceFailure> {
+        self.reserve_vector_mutation(&plan)?;
+        match plan.change {
+            VectorChange::Push {
+                incoming,
+                value,
+                grow: true,
+            } => {
+                let mut allocated = Vec::new();
+                allocated
+                    .try_reserve_exact(plan.members.len().checked_add(1).ok_or_else(resource)?)
+                    .map_err(|_| resource())?;
+                let object = ObjectId::from(self.objects.allocate(
+                    ObjectRecord {
+                        type_id: plan.ty,
+                        storage: ObjectStorage::Constructing,
+                        owner: None,
+                    },
+                    plan.owned,
+                    &mut self.budget,
+                )?);
+                let build = (|| -> Result<TicketId, Diagnostic> {
+                    for (index, scalar) in plan
+                        .members
+                        .iter()
+                        .map(|m| m.value)
+                        .chain(std::iter::once(value))
+                        .enumerate()
+                    {
+                        fuel.charge()?;
+                        let cell = self.new_cell(
+                            StorageContract::Exact(plan.element),
+                            true,
+                            CellOwner::Buffer {
+                                object,
+                                index: u32::try_from(index).map_err(|_| resource())?,
+                            },
+                        )?;
+                        allocated.push(cell);
+                        self.cells.get_mut(cell)?.state = CellState::Live(scalar);
+                        plan.fields.push(cell);
+                    }
+                    self.tickets
+                        .allocate(
+                            TransferTicket {
+                                value: ValueRepr::unit(),
+                            },
+                            0,
+                            &mut self.budget,
+                        )
+                        .map(TicketId::from)
+                })();
+                let unit = match build {
+                    Ok(t) => t,
+                    Err(e) => {
+                        for cell in allocated {
+                            self.cells.take(cell, &mut self.budget)?;
+                        }
+                        self.objects.take(object, &mut self.budget)?;
+                        return Err(e.into());
+                    }
+                };
+                // All fallible validation/allocation precedes this publication transaction.
+                self.tickets.take(incoming, &mut self.budget)?;
+                for m in &plan.members {
+                    let cell = self.cells.get_mut(m.stamp.cell)?;
+                    cell.state = CellState::Dropped;
+                    cell.retired = true;
+                    cell.location_epoch = m.retired_epoch;
+                }
+                self.objects.get_mut(object)?.storage = ObjectStorage::Vector(AggregateStorage {
+                    fields: plan.fields,
+                    initialized: plan.initialized,
+                    next_cleanup: 0,
+                    pending_cleanup: None,
+                    variant: None,
+                    buffer: Some(VectorBuffer {
+                        capacity: plan.capacity,
+                        generation: plan.generation,
+                        dropping: false,
+                    }),
+                });
+                self.objects.get_mut(object)?.owner = Some(ValueOwner::Cell(plan.container.cell));
+                self.cells.get_mut(plan.container.cell)?.state = CellState::Live(ValueRepr {
+                    kind: 8,
+                    type_id: plan.ty.0,
+                    payload: object.bits(),
+                });
+                self.objects.take(plan.object, &mut self.budget)?;
+                self.commit_initialization_change(plan.container.cell, true)?;
+                Ok(VectorMutationResult::Pushed(unit))
+            }
+            VectorChange::Push {
+                incoming,
+                value,
+                grow: false,
+            } => {
+                fuel.charge()?;
+                let index = u32::try_from(plan.members.len()).map_err(|_| resource())?;
+                let cell = self.new_cell(
+                    StorageContract::Exact(plan.element),
+                    true,
+                    CellOwner::Buffer {
+                        object: plan.object,
+                        index,
+                    },
+                )?;
+                let unit = match self
+                    .tickets
+                    .allocate(
+                        TransferTicket {
+                            value: ValueRepr::unit(),
+                        },
+                        0,
+                        &mut self.budget,
+                    )
+                    .map(TicketId::from)
+                {
+                    Ok(t) => t,
+                    Err(e) => {
+                        self.cells.take(cell, &mut self.budget)?;
+                        return Err(e.into());
+                    }
+                };
+                self.objects
+                    .replace_payload_bytes(plan.object, plan.owned, &mut self.budget)?;
+                self.tickets.take(incoming, &mut self.budget)?;
+                self.cells.get_mut(cell)?.state = CellState::Live(value);
+                plan.fields.push(cell);
+                let ObjectStorage::Vector(storage) =
+                    &mut self.objects.get_mut(plan.object)?.storage
+                else {
+                    return Err(invalid().into());
+                };
+                storage.fields = plan.fields;
+                storage.initialized = plan.initialized;
+                self.commit_initialization_change(plan.container.cell, true)?;
+                Ok(VectorMutationResult::Pushed(unit))
+            }
+            VectorChange::Pop => {
+                let Some(member) = plan.members.last() else {
+                    return Ok(VectorMutationResult::Popped(None));
+                };
+                fuel.charge()?;
+                let ticket = self
+                    .tickets
+                    .allocate(
+                        TransferTicket {
+                            value: member.value,
+                        },
+                        0,
+                        &mut self.budget,
+                    )
+                    .map(TicketId::from)?;
+                self.objects
+                    .replace_payload_bytes(plan.object, plan.owned, &mut self.budget)?;
+                let cell = self.cells.get_mut(member.stamp.cell)?;
+                cell.state = CellState::Dropped;
+                cell.retired = true;
+                cell.location_epoch = member.retired_epoch;
+                let ObjectStorage::Vector(storage) =
+                    &mut self.objects.get_mut(plan.object)?.storage
+                else {
+                    return Err(invalid().into());
+                };
+                storage.fields = plan.fields;
+                storage.initialized = plan.initialized;
+                self.commit_initialization_change(plan.container.cell, true)?;
+                Ok(VectorMutationResult::Popped(Some(ticket)))
+            }
+        }
+    }
+}
