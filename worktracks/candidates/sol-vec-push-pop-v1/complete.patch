+//! Private run-owned scalar Vec transaction; no source member or trait witness.
+use super::{
+    cell::{CellId, ObjectId, TicketId},
+    object::InitializedFields,
+    place::{CellStamp, Place},
+    shape::TypeId,
+    value::ValueRepr,
+};
+#[derive(Clone, Copy)]
+pub(super) struct VectorMember {
+    pub stamp: CellStamp,
+    pub value: ValueRepr,
+    pub retired_epoch: u32,
+}
+#[derive(Clone, Copy)]
+pub(super) enum VectorChange {
+    Push {
+        incoming: TicketId,
+        value: ValueRepr,
+        grow: bool,
+    },
+    Pop,
+}
+/// Opaque physical plan. Its private fields bind actual old storage and owner.
+pub struct PreparedVectorMutation {
+    pub(super) epoch: u32,
+    pub(super) base: Place,
+    pub(super) container: CellStamp,
+    pub(super) object: ObjectId,
+    pub(super) ty: TypeId,
+    pub(super) element: TypeId,
+    pub(super) old_capacity: u32,
+    pub(super) old_generation: u32,
+    pub(super) capacity: u32,
+    pub(super) generation: u32,
+    pub(super) members: Vec<VectorMember>,
+    pub(super) fields: Vec<CellId>,
+    pub(super) initialized: InitializedFields,
+    pub(super) owned: usize,
+    pub(super) change: VectorChange,
+}
+/// Physical output, not a guest Option constructor or selected library result.
+pub enum VectorMutationResult {
+    Pushed(TicketId),
+    Popped(Option<TicketId>),
+}
