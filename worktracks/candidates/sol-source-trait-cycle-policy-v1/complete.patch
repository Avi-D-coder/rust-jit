+    pub(super) fn bound_trait_current(
+        &self,
+        db: &Database,
+        origin: super::source_cycle_policy::AtomOrigin,
+    ) -> Result<Option<&'a SourceTraitHeader>, Diagnostic> {
+        use super::source_cycle_policy::AtomOrigin;
+        let (bound, outer) = match origin {
+            AtomOrigin::Predicate {
+                group,
+                bound: Some(bound),
+            } => {
+                let p = self
+                    .owner
+                    .predicates
+                    .get(usize::try_from(group).map_err(|_| limit())?)
+                    .ok_or_else(|| fault("policy group ordinal differs"))?;
+                let bounds = match &p.kind {
+                    PredicateKind::Bound { bounds, .. }
+                    | PredicateKind::RegionOutlives { bounds, .. } => bounds,
+                    PredicateKind::ImplicitSized { relaxed, .. } => relaxed,
+                    _ => return Err(fault("policy source group has no selected bound")),
+                };
+                (
+                    bounds
+                        .get(usize::try_from(bound).map_err(|_| limit())?)
+                        .ok_or_else(|| fault("policy bound ordinal differs"))?,
+                    p.binder.as_slice(),
