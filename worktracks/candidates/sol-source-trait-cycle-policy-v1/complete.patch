+                .owner
+                .generics
+                .iter()
+                .chain(outer)
+                .chain(&bound.binder)
+                .any(|p| p.kind == super::term::BoundKind::Type && p.name == name)
+        {
+            return Ok(None);
+        }
+        let Some(selected) = current_name(
+            db,
+            &self.index.seal,
+            &self.owner.context.scope,
+            self.owner.source.profile.edition,
+            name,
+        ) else {
+            return Ok(None);
+        };
+        Ok(self
+            .index
+            .model
+            .fragments
+            .iter()
+            .flat_map(|f| &f.headers)
+            .find(|h| {
