+//! Source-derived declaration/predicate policy, not trait applicability or proof.
+use super::{header::*, index::CurrentImplCandidateIndex};
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::memo::Database,
+};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DeclarationPolicy {
+    OrdinaryTrait,
+    DeclaredAutoTrait,
+    TraitAliasRequired,
+    PositiveImpl,
+    ExplicitNegativeDeclaration,
+    DefaultImplRequired,
+    InherentImpl,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AtomOrigin {
+    Predicate { group: u32, bound: Option<u32> },
+    Supertrait { bound: u32 },
+}
+impl StableEncode for AtomOrigin {
+    const DOMAIN: &'static str = "lrr/v5/source-cycle-atom-origin/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        match self {
+            Self::Predicate { group, bound } => {
+                e.u8(0);
+                e.u32(*group);
+                e.option(bound, |e, b| e.u32(*b));
+            }
+            Self::Supertrait { bound } => {
+                e.u8(1);
+                e.u32(*bound);
+            }
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AtomPolicy {
+    PositiveTraitTypeRequired,
+    OutlivesRequired,
+    RelaxedMarkerIdentityRequired,
+    ConstOrModifierRequired,
+    ImplicitSizedIdentityRequired,
+    RequiredSyntax,
+}
+fn declaration(header: &SourceTraitHeader) -> DeclarationPolicy {
+    match header.kind() {
+        HeaderKind::Trait { alias: true, .. } => DeclarationPolicy::TraitAliasRequired,
+        HeaderKind::Trait {
+            auto_trait: true, ..
+        } => DeclarationPolicy::DeclaredAutoTrait,
+        HeaderKind::Trait { .. } => DeclarationPolicy::OrdinaryTrait,
+        HeaderKind::Impl {
+            trait_type: None, ..
+        } => DeclarationPolicy::InherentImpl,
+        HeaderKind::Impl {
+            default_impl: true, ..
+        } => DeclarationPolicy::DefaultImplRequired,
+        HeaderKind::Impl { negative: true, .. } => DeclarationPolicy::ExplicitNegativeDeclaration,
+        HeaderKind::Impl { .. } => DeclarationPolicy::PositiveImpl,
+    }
+}
+fn policy(bound: &HeaderBound) -> AtomPolicy {
+    match bound.modifier {
+        BoundModifier::Relaxed => AtomPolicy::RelaxedMarkerIdentityRequired,
+        BoundModifier::RequiredConstOrOther => AtomPolicy::ConstOrModifierRequired,
+        BoundModifier::Ordinary if bound.ty.is_some() => AtomPolicy::PositiveTraitTypeRequired,
+        BoundModifier::Ordinary if bound.lifetime.is_some() => AtomPolicy::OutlivesRequired,
+        _ => AtomPolicy::RequiredSyntax,
+    }
+}
+#[derive(Clone, Debug)]
+pub struct PredicateAtomFact {
+    origin: AtomOrigin,
+    policy: AtomPolicy,
+    source_identity: Digest,
+    group_binder: Digest,
+    bound_binder: Digest,
+    binder_parameters: usize,
+}
+impl PredicateAtomFact {
+    pub fn origin(&self) -> AtomOrigin {
+        self.origin
+    }
+    pub fn policy(&self) -> AtomPolicy {
+        self.policy
+    }
+    pub fn source_identity(&self) -> Digest {
+        self.source_identity
+    }
+    pub fn binder_parameters(&self) -> usize {
+        self.binder_parameters
+    }
+}
+impl StableEncode for PredicateAtomFact {
+    const DOMAIN: &'static str = "lrr/v5/source-cycle-predicate-atom/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.record(&self.origin);
+        e.u8(match self.policy {
+            AtomPolicy::PositiveTraitTypeRequired => 0,
+            AtomPolicy::OutlivesRequired => 1,
+            AtomPolicy::RelaxedMarkerIdentityRequired => 2,
+            AtomPolicy::ConstOrModifierRequired => 3,
+            AtomPolicy::ImplicitSizedIdentityRequired => 4,
+            AtomPolicy::RequiredSyntax => 5,
+        });
+        e.digest(self.source_identity);
+        e.digest(self.group_binder);
+        e.digest(self.bound_binder);
+    }
+}
+#[derive(Clone, Debug)]
+pub struct MemberDeclarationFact {
+    definition: Digest,
+    header: Digest,
+    kind: AssociatedKind,
+}
+impl MemberDeclarationFact {
+    pub fn definition(&self) -> Digest {
+        self.definition
+    }
+    pub fn header(&self) -> Digest {
+        self.header
+    }
+    pub fn kind(&self) -> &AssociatedKind {
+        &self.kind
+    }
+}
+impl StableEncode for MemberDeclarationFact {
+    const DOMAIN: &'static str = "lrr/v5/source-cycle-member-declaration/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.definition);
+        e.digest(self.header);
+        e.u8(match self.kind {
+            AssociatedKind::Method => 0,
+            AssociatedKind::Type => 1,
+            AssociatedKind::Constant => 2,
+        });
+    }
+}
+#[derive(Clone, Copy, Debug)]
+pub struct PolicyLimits {
+    pub atoms: usize,
+    pub members: usize,
+    pub binder_parameters: usize,
+    pub metadata_bytes: usize,
+    pub current_name_reads: usize,
+}
+impl Default for PolicyLimits {
+    fn default() -> Self {
+        Self {
+            atoms: 100_000,
+            members: 100_000,
+            binder_parameters: 256,
+            metadata_bytes: 1024 * 1024,
+            current_name_reads: 64,
+        }
+    }
+}
+impl PolicyLimits {
+    fn validate(self) -> Result<Self, Diagnostic> {
+        let hard = Self::default();
+        if self.atoms > hard.atoms
+            || self.members > hard.members
+            || self.binder_parameters > hard.binder_parameters
+            || self.metadata_bytes > hard.metadata_bytes
+            || self.current_name_reads > hard.current_name_reads
+        {
+            return Err(fault("policy limits exceed fixed ceilings"));
+        }
+        Ok(self)
+    }
+}
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TRAIT-CYCLE-POLICY", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "source trait cycle policy atom/member/binder/byte/lookup limit".into(),
+    )
+}
+fn binder_identity(parameters: &[HeaderParameter]) -> Digest {
+    let mut e = StableEncoder::new("lrr/v5/source-cycle-binder/v1");
+    e.sequence(parameters, |e, p| e.record(p));
+    e.finish()
+}
+/// Retained exact source data. Public capture is useful for header controls but
+/// confers no current catalog, name-resolution or structural-rule certificate.
+pub struct RetainedHeaderCycleFacts {
+    header: Digest,
+    definition: Digest,
+    source: Digest,
+    edition: u16,
+    cfg: Digest,
+    declaration: DeclarationPolicy,
+    unsafe_declaration: bool,
+    negative_declaration: bool,
+    default_impl: bool,
+    declared_auto: bool,
+    atoms: Vec<PredicateAtomFact>,
+    members: Vec<MemberDeclarationFact>,
+    metadata_bytes: usize,
+}
+impl RetainedHeaderCycleFacts {
+    pub fn capture(header: &SourceTraitHeader, limits: PolicyLimits) -> Result<Self, Diagnostic> {
+        let limits = limits.validate()?;
+        // Reuse the actual header's checked full-capacity sizer before any
+        // atom/member clone/hash traversal or policy-vector publication.
+        let source_bytes = header.candidate_snapshot_bytes()?;
+        if source_bytes > limits.metadata_bytes {
+            return Err(limit());
+        }
+        let mut count = 0usize;
+        for p in header.predicates() {
+            let n = match &p.kind {
+                PredicateKind::Bound { bounds, .. }
+                | PredicateKind::RegionOutlives { bounds, .. } => bounds.len().max(1),
+                PredicateKind::ImplicitSized { relaxed, .. } => {
+                    relaxed.len().checked_add(1).ok_or_else(limit)?
+                }
+                PredicateKind::RequiredSyntax(_) => 1,
+            };
+            count = count
+                .checked_add(n)
+                .filter(|n| *n <= limits.atoms)
+                .ok_or_else(limit)?;
+        }
+        if let HeaderKind::Trait { supertraits, .. } = header.kind() {
+            count = count
+                .checked_add(supertraits.len())
+                .filter(|n| *n <= limits.atoms)
+                .ok_or_else(limit)?;
+        }
+        if header.associated().len() > limits.members {
+            return Err(limit());
+        }
+        let bytes = source_bytes
+            .checked_add(
+                count
+                    .checked_mul(std::mem::size_of::<PredicateAtomFact>())
+                    .ok_or_else(limit)?,
+            )
+            .and_then(|n| {
+                n.checked_add(
+                    header
+                        .associated()
+                        .len()
+                        .checked_mul(std::mem::size_of::<MemberDeclarationFact>())?,
+                )
+            })
+            .and_then(|n| n.checked_add(std::mem::size_of::<Self>()))
+            .filter(|n| *n <= limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        let mut atoms = Vec::new();
+        atoms.try_reserve_exact(count).map_err(|_| limit())?;
+        let empty = binder_identity(&[]);
+        let header_identity = header.exact_identity();
+        for (group, p) in header.predicates().iter().enumerate() {
+            let group = u32::try_from(group).map_err(|_| limit())?;
+            if p.binder.len() > limits.binder_parameters {
+                return Err(limit());
+            }
+            let group_binder = binder_identity(&p.binder);
+            let predicate_identity = p.fingerprint();
+            let mut emit = |bound: Option<(usize, &HeaderBound)>,
+                            kind: AtomPolicy|
+             -> Result<(), Diagnostic> {
+                let parameters = p
+                    .binder
+                    .len()
+                    .checked_add(bound.map_or(0, |(_, b)| b.binder.len()))
+                    .filter(|n| *n <= limits.binder_parameters)
+                    .ok_or_else(limit)?;
+                let origin = AtomOrigin::Predicate {
+                    group,
+                    bound: bound
+                        .map(|(i, _)| u32::try_from(i))
+                        .transpose()
+                        .map_err(|_| limit())?,
+                };
+                let mut e = StableEncoder::new("lrr/v5/source-cycle-atom-source/v1");
+                e.digest(header_identity);
+                e.record(&origin);
+                e.digest(predicate_identity);
+                if let Some((_, b)) = bound {
+                    e.record(b);
+                }
+                atoms.push(PredicateAtomFact {
+                    origin,
+                    policy: kind,
+                    source_identity: e.finish(),
+                    group_binder,
+                    bound_binder: bound.map_or(empty, |(_, b)| binder_identity(&b.binder)),
+                    binder_parameters: parameters,
+                });
+                Ok(())
+            };
+            match &p.kind {
+                PredicateKind::Bound { bounds, .. }
+                | PredicateKind::RegionOutlives { bounds, .. } => {
+                    if bounds.is_empty() {
+                        emit(None, AtomPolicy::RequiredSyntax)?;
+                    }
+                    for (i, b) in bounds.iter().enumerate() {
+                        emit(Some((i, b)), policy(b))?;
+                    }
+                }
+                PredicateKind::ImplicitSized { relaxed, .. } => {
+                    emit(None, AtomPolicy::ImplicitSizedIdentityRequired)?;
+                    for (i, b) in relaxed.iter().enumerate() {
+                        emit(Some((i, b)), AtomPolicy::RelaxedMarkerIdentityRequired)?;
+                    }
+                }
+                PredicateKind::RequiredSyntax(_) => emit(None, AtomPolicy::RequiredSyntax)?,
+            }
+        }
+        if let HeaderKind::Trait { supertraits, .. } = header.kind() {
+            for (bound, b) in supertraits.iter().enumerate() {
+                if b.binder.len() > limits.binder_parameters {
+                    return Err(limit());
+                }
+                let origin = AtomOrigin::Supertrait {
+                    bound: u32::try_from(bound).map_err(|_| limit())?,
+                };
+                let mut e = StableEncoder::new("lrr/v5/source-cycle-atom-source/v1");
+                e.digest(header_identity);
+                e.record(&origin);
+                e.record(b);
+                atoms.push(PredicateAtomFact {
+                    origin,
+                    policy: policy(b),
+                    source_identity: e.finish(),
+                    group_binder: empty,
+                    bound_binder: binder_identity(&b.binder),
+                    binder_parameters: b.binder.len(),
+                });
+            }
+        }
+        let mut members = Vec::new();
+        members
+            .try_reserve_exact(header.associated().len())
+            .map_err(|_| limit())?;
+        for m in header.associated() {
+            members.push(MemberDeclarationFact {
+                definition: m.definition.fingerprint(),
+                header: m.fingerprint(),
+                kind: m.kind,
+            });
+        }
+        let unsafe_declaration = match header.kind() {
+            HeaderKind::Trait { unsafe_trait, .. } => *unsafe_trait,
+            HeaderKind::Impl { unsafe_impl, .. } => *unsafe_impl,
+        };
+        let (negative_declaration, default_impl, declared_auto) = match header.kind() {
+            HeaderKind::Trait { auto_trait, .. } => (false, false, *auto_trait),
+            HeaderKind::Impl {
+                negative,
+                default_impl,
+                ..
+            } => (*negative, *default_impl, false),
+        };
+        Ok(Self {
+            header: header_identity,
+            definition: header.definition().fingerprint(),
+            source: header.source().fingerprint(),
+            edition: header.source().profile.edition,
+            cfg: header.cfg,
+            declaration: declaration(header),
+            unsafe_declaration,
+            negative_declaration,
+            default_impl,
+            declared_auto,
+            atoms,
+            members,
+            metadata_bytes: bytes,
+        })
+    }
+    pub fn declaration(&self) -> DeclarationPolicy {
+        self.declaration
+    }
+    pub fn header(&self) -> Digest {
+        self.header
+    }
+    pub fn definition(&self) -> Digest {
+        self.definition
+    }
+    pub fn owning_edition(&self) -> u16 {
+        self.edition
+    }
+    pub fn atoms(&self) -> &[PredicateAtomFact] {
+        &self.atoms
+    }
+    pub fn members(&self) -> &[MemberDeclarationFact] {
+        &self.members
+    }
+    pub fn metadata_bytes(&self) -> usize {
+        self.metadata_bytes
+    }
+    pub fn unsafe_declaration(&self) -> bool {
+        self.unsafe_declaration
+    }
+    pub fn negative_declaration(&self) -> bool {
+        self.negative_declaration
+    }
+    pub fn default_impl(&self) -> bool {
+        self.default_impl
+    }
+    pub fn declared_auto(&self) -> bool {
+        self.declared_auto
+    }
+}
+impl StableEncode for RetainedHeaderCycleFacts {
+    const DOMAIN: &'static str = "lrr/v5/retained-source-cycle-facts/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.header);
+        e.digest(self.definition);
+        e.digest(self.source);
+        e.u16(self.edition);
+        e.digest(self.cfg);
+        e.u8(match self.declaration {
+            DeclarationPolicy::OrdinaryTrait => 0,
+            DeclarationPolicy::DeclaredAutoTrait => 1,
+            DeclarationPolicy::TraitAliasRequired => 2,
+            DeclarationPolicy::PositiveImpl => 3,
+            DeclarationPolicy::ExplicitNegativeDeclaration => 4,
+            DeclarationPolicy::DefaultImplRequired => 5,
+            DeclarationPolicy::InherentImpl => 6,
+        });
+        e.bool(self.unsafe_declaration);
+        e.bool(self.negative_declaration);
+        e.bool(self.default_impl);
+        e.bool(self.declared_auto);
+        e.sequence(&self.atoms, |e, a| e.record(a));
+        e.sequence(&self.members, |e, m| e.record(m));
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum SourceCycleRequirement {
+    M018SourceView,
+    SourceGoalApplicability,
+    ResolvedPredicateArguments,
+    NormalizationGoalProducer,
+    CurrentGoalPublication,
+    TypeMemberPublication,
+    ApprovedStructuralAutoIdentity,
+    ActualFieldAndReferenceRules,
+    ApprovedNegativeCompilerFact,
+    NegativeSyntaxProfile,
+    AliasNormalization,
+    DefaultImplSemantics,
+}
+pub struct CurrentPredicateTraitFact {
+    atom: Digest,
+    trait_header: Digest,
+    trait_definition: Digest,
+    declaration: DeclarationPolicy,
+}
+impl CurrentPredicateTraitFact {
+    pub fn atom(&self) -> Digest {
+        self.atom
+    }
+    pub fn trait_definition(&self) -> Digest {
+        self.trait_definition
+    }
