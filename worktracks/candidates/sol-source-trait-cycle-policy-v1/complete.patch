+        self.declaration
+    }
+}
+impl StableEncode for CurrentPredicateTraitFact {
+    const DOMAIN: &'static str = "lrr/v5/current-source-predicate-trait-fact/v1";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.digest(self.atom);
+        e.digest(self.trait_header);
+        e.digest(self.trait_definition);
+        e.u8(match self.declaration {
+            DeclarationPolicy::OrdinaryTrait => 0,
+            DeclarationPolicy::DeclaredAutoTrait => 1,
+            DeclarationPolicy::TraitAliasRequired => 2,
+            _ => 3,
+        });
+    }
+}
+/// Private genuine currentness producer: no caller names, descriptors, SCC
+/// model or solved Boolean. It cannot construct an applicable negative fact
+/// or an approved structural-auto witness.
+pub struct CurrentSourceCyclePolicy {
+    owner: RetainedHeaderCycleFacts,
+    selected_trait: Option<RetainedHeaderCycleFacts>,
+    predicate_traits: Vec<CurrentPredicateTraitFact>,
+    requirements: Vec<SourceCycleRequirement>,
+    stamp: Digest,
+    identity: Digest,
+    limits: PolicyLimits,
+}
+impl CurrentSourceCyclePolicy {
+    pub fn capture_header_current(
+        db: &Database,
+        index: &CurrentImplCandidateIndex,
+        header: Digest,
+        limits: PolicyLimits,
+    ) -> Result<Self, Diagnostic> {
+        let limits = limits.validate()?;
+        let view = index.cycle_policy_header_current(db, header)?;
+        let owner = RetainedHeaderCycleFacts::capture(view.owner(), limits)?;
+        let mut budget = owner.metadata_bytes();
+        let selected_trait = if let Some(selected) = view.selected_impl_trait() {
+            let facts = RetainedHeaderCycleFacts::capture(selected, limits)?;
+            budget = budget
+                .checked_add(facts.metadata_bytes())
+                .filter(|n| *n <= limits.metadata_bytes)
+                .ok_or_else(limit)?;
+            Some(facts)
+        } else {
+            None
+        };
+        let mut requirements = std::collections::BTreeSet::from([
+            SourceCycleRequirement::M018SourceView,
+            SourceCycleRequirement::SourceGoalApplicability,
+            SourceCycleRequirement::ResolvedPredicateArguments,
+            SourceCycleRequirement::NormalizationGoalProducer,
+            SourceCycleRequirement::CurrentGoalPublication,
+        ]);
+        let effective_auto = selected_trait.as_ref().map_or(
+            owner.declared_auto(),
+            RetainedHeaderCycleFacts::declared_auto,
+        );
+        if effective_auto {
+            requirements.insert(SourceCycleRequirement::ApprovedStructuralAutoIdentity);
+            requirements.insert(SourceCycleRequirement::ActualFieldAndReferenceRules);
+        }
+        if owner.negative_declaration() {
+            requirements.insert(SourceCycleRequirement::NegativeSyntaxProfile);
+            requirements.insert(SourceCycleRequirement::ApprovedNegativeCompilerFact);
+        }
+        if matches!(owner.declaration(), DeclarationPolicy::TraitAliasRequired) {
+            requirements.insert(SourceCycleRequirement::AliasNormalization);
+        }
+        if owner.default_impl() {
+            requirements.insert(SourceCycleRequirement::DefaultImplSemantics);
+        }
+        if matches!(
+            owner.declaration(),
+            DeclarationPolicy::PositiveImpl
+                | DeclarationPolicy::ExplicitNegativeDeclaration
+                | DeclarationPolicy::DefaultImplRequired
+        ) && selected_trait.is_none()
+        {
+            requirements.insert(SourceCycleRequirement::TypeMemberPublication);
+        }
+        let count = owner
+            .atoms()
+            .iter()
+            .filter(|a| a.policy() == AtomPolicy::PositiveTraitTypeRequired)
+            .count();
+        if count > limits.current_name_reads {
+            return Err(limit());
+        }
+        budget = budget
+            .checked_add(
+                count
+                    .checked_mul(std::mem::size_of::<CurrentPredicateTraitFact>())
+                    .ok_or_else(limit)?,
+            )
+            .filter(|n| *n <= limits.metadata_bytes)
+            .ok_or_else(limit)?;
+        let mut predicate_traits = Vec::new();
+        predicate_traits
+            .try_reserve_exact(count)
+            .map_err(|_| limit())?;
+        let mut trait_fingerprints = std::collections::BTreeMap::new();
+        for atom in owner.atoms() {
+            if atom.policy() == AtomPolicy::PositiveTraitTypeRequired {
+                if let Some(header) = view.bound_trait_current(db, atom.origin())? {
+                    let definition = header.definition().fingerprint();
+                    let header_identity = *trait_fingerprints
+                        .entry(definition)
+                        .or_insert_with(|| header.exact_identity());
+                    predicate_traits.push(CurrentPredicateTraitFact {
+                        atom: atom.source_identity(),
+                        trait_header: header_identity,
+                        trait_definition: definition,
+                        declaration: declaration(header),
+                    });
+                } else {
+                    requirements.insert(SourceCycleRequirement::TypeMemberPublication);
+                }
+            }
+        }
+        let _metadata_reservation = budget;
+        let stamp = view.stamp();
+        let requirements = requirements.into_iter().collect::<Vec<_>>();
+        let mut e = StableEncoder::new("lrr/v5/current-source-cycle-policy/v1");
+        e.digest(stamp);
+        e.record(&owner);
+        e.option(&selected_trait, |e, t| e.record(t));
+        e.sequence(&predicate_traits, |e, t| e.record(t));
+        let identity = e.finish();
+        Ok(Self {
+            owner,
+            selected_trait,
+            predicate_traits,
+            requirements,
+            stamp,
+            identity,
+            limits,
+        })
+    }
+    pub fn revalidate(
+        &self,
+        db: &Database,
+        index: &CurrentImplCandidateIndex,
+    ) -> Result<(), Diagnostic> {
+        let fresh = Self::capture_header_current(db, index, self.owner.header(), self.limits)?;
+        if fresh.stamp != self.stamp || fresh.identity != self.identity {
+            return Err(fault(
+                "source trait declaration/member readiness changed; fresh capture required",
+            ));
+        }
+        Ok(())
+    }
+    pub fn owner(&self) -> &RetainedHeaderCycleFacts {
+        &self.owner
+    }
+    pub fn selected_trait(&self) -> Option<&RetainedHeaderCycleFacts> {
+        self.selected_trait.as_ref()
+    }
+    pub fn predicate_traits(&self) -> &[CurrentPredicateTraitFact] {
+        &self.predicate_traits
+    }
+    pub fn requirements(&self) -> &[SourceCycleRequirement] {
+        &self.requirements
+    }
+    pub fn identity(&self) -> Digest {
+        self.identity
+    }
+}
