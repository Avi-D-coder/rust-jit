+++ b/xtask/tests/source_trait_cycle_policy.rs
@@ -0,0 +1,362 @@
+//! Source-policy component controls; no fulfilled trait/SCC/runtime acceptance.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    source::snapshot::{CfgSet, SourceBlob, SourcePath},
+    syntax::{outline::ScopeKey, parse::ParsedFile},
+    traits::{
+        header::{CapturedSourceHeaders, HeaderCaptureLimits, HeaderKind, SourceTraitHeader},
+        source_cycle_policy::{
+            AtomOrigin, AtomPolicy, DeclarationPolicy, PolicyLimits, RetainedHeaderCycleFacts,
+        },
+    },
+};
+fn headers(text: &str, edition: u16) -> CapturedSourceHeaders {
+    let mut profile = ProfileIdentity::current();
+    profile.edition = edition;
+    ParsedFile::parse_declarations(&SourceBlob::new(text.as_bytes().to_vec()).unwrap(), profile)
+        .unwrap()
+        .capture_trait_headers(
+            SourcePath::new("source_policy_fixture.rs").unwrap(),
+            ScopeKey {
+                crate_key: Digest([145; 32]),
+                module_path: vec![],
+                owner: None,
+            },
+            &CfgSet::guest_default(),
+            HeaderCaptureLimits::default(),
+        )
+        .unwrap()
+}
+fn facts(h: &SourceTraitHeader) -> RetainedHeaderCycleFacts {
+    RetainedHeaderCycleFacts::capture(h, PolicyLimits::default()).unwrap()
+}
+#[test]
+fn m022_source_keyword_auto_and_negative_are_declarations_not_approved_rules() {
+    let h = headers(
+        include_str!(
+            "../../fixtures/upstream/rustc-checkout/tests/ui/auto-traits/distinct-type-tuple-by-negative-impl.rs"
+        ),
+        2015,
+    );
+    let auto = h
+        .headers()
+        .iter()
+        .find(|h| h.definition().declared_name == "NotSame")
+        .unwrap();
+    assert_eq!(
+        facts(auto).declaration(),
+        DeclarationPolicy::DeclaredAutoTrait
+    );
+    let negative = h
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { negative: true, .. }))
+        .unwrap();
+    let f = facts(negative);
+    assert_eq!(
+        f.declaration(),
+        DeclarationPolicy::ExplicitNegativeDeclaration
+    );
+    assert!(!f.atoms().is_empty());
+    assert_eq!(f.header(), negative.exact_identity());
+    // The source uses the SAME actual A parameter twice; this declaration
+    // cannot be applied to an arbitrary tuple without the missing reached goal.
+    let HeaderKind::Impl { self_type, .. } = negative.kind() else {
+        unreachable!()
+    };
+    let tuple = self_type.symbolic().unwrap();
+    let lrr::traits::term::TyTerm::Tuple(fields) = tuple else {
+        panic!("source tuple shape lost")
+    };
+    assert_eq!(fields.len(), 2);
+    assert_eq!(fields[0].fingerprint(), fields[1].fingerprint());
+}
+#[test]
+fn m022_plain_same_spelled_marker_traits_and_coinductive_attributes_stay_ordinary() {
+    let h = headers(
+        "trait Send {} trait Sync {} trait Unpin {} auto trait Other {}",
+        2015,
+    );
+    for name in ["Send", "Sync", "Unpin"] {
+        let header = h
+            .headers()
+            .iter()
+            .find(|h| h.definition().declared_name == name)
+            .unwrap();
+        assert_eq!(
+            facts(header).declaration(),
+            DeclarationPolicy::OrdinaryTrait
+        );
+    }
+    let original = headers(
+        include_str!(
+            "../../fixtures/upstream/rustc-checkout/tests/ui/traits/next-solver/cycles/inductive-cycle-discarded-coinductive-constraints.rs"
+        ),
+        2015,
+    );
+    let marked = original
+        .headers()
+        .iter()
+        .find(|h| h.definition().declared_name == "Trait")
+        .unwrap();
+    assert_eq!(
+        facts(marked).declaration(),
+        DeclarationPolicy::OrdinaryTrait
+    );
+    // rustc_attrs/nightly compiler annotation is not an LRR structural rule.
+}
+#[test]
+fn m022_contextual_auto_original_does_not_create_a_trait_policy() {
+    let original = include_str!(
+        "../../fixtures/upstream/rustc-checkout/tests/ui/auto-traits/auto-is-contextual.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let h = headers(original, edition);
+        assert!(h.headers().is_empty());
+    }
+    // Original auto! expansion/body remains unexecuted; this proves only that
+    // its spelling is not a source trait declaration in the retained AST.
+}
+#[test]
+fn m022_each_source_bound_has_distinct_group_ordinal_and_binder_identity() {
+    let h = headers(
+        "trait A {} trait B {} trait C<'a> {} impl<T:A+B> A for T where for<'a> T:C<'a> {}",
+        2015,
+    );
+    let owner = h
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+        .unwrap();
+    let f = facts(owner);
+    let positive = f
+        .atoms()
+        .iter()
+        .filter(|a| a.policy() == AtomPolicy::PositiveTraitTypeRequired)
+        .collect::<Vec<_>>();
+    assert_eq!(positive.len(), 3);
+    assert_ne!(positive[0].source_identity(), positive[1].source_identity());
+    let AtomOrigin::Predicate {
+        group: a,
+        bound: Some(0),
+    } = positive[0].origin()
+    else {
+        panic!("first source group atom missing")
+    };
+    let AtomOrigin::Predicate {
+        group: b,
+        bound: Some(1),
+    } = positive[1].origin()
+    else {
+        panic!("second source group atom missing")
+    };
+    assert_eq!(a, b);
+    assert!(positive.iter().any(|a| a.binder_parameters() == 1));
+    assert!(
+        f.atoms()
+            .iter()
+            .any(|a| a.policy() == AtomPolicy::ImplicitSizedIdentityRequired)
+    );
+    // Atom splitting preserves all facts; it does not resolve A/B/C arguments,
+    // create ParamEnv assumptions, normalize projections, or fulfill any bound.
+}
+#[test]
+fn m022_relaxed_sized_retains_identity_requirement_without_negative_fact() {
+    let h = headers("trait A {} impl<T:?Sized> A for &T {}", 2015);
+    let owner = h
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+        .unwrap();
+    let f = facts(owner);
+    assert_eq!(f.declaration(), DeclarationPolicy::PositiveImpl);
+    assert!(
+        f.atoms()
+            .iter()
+            .any(|a| a.policy() == AtomPolicy::ImplicitSizedIdentityRequired)
+    );
+    assert!(
+        f.atoms()
+            .iter()
+            .any(|a| a.policy() == AtomPolicy::RelaxedMarkerIdentityRequired)
+    );
+    assert!(
+        !f.atoms()
+            .iter()
+            .any(|a| a.policy() == AtomPolicy::PositiveTraitTypeRequired)
+    );
+    // Genuine core Sized identity is still required to remove the implicit
+    // bound. No NotSized/negative goal is asserted by a ? spelling.
+}
+#[test]
+fn m022_negative_conditions_and_unsafe_source_headers_remain_unfulfilled() {
+    let original = headers(
+        include_str!(
+            "../../fixtures/upstream/rustc-checkout/tests/ui/auto-traits/typeck-default-trait-impl-negation.rs"
+        ),
+        2015,
+    );
+    let autos = original
+        .headers()
+        .iter()
+        .filter(|h| {
+            matches!(
+                h.kind(),
+                HeaderKind::Trait {
+                    auto_trait: true,
+                    ..
+                }
+            )
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(autos.len(), 2);
+    assert!(autos.iter().any(|h| facts(h).unsafe_declaration()));
+    let negatives = original
+        .headers()
+        .iter()
+        .filter(|h| matches!(h.kind(), HeaderKind::Impl { negative: true, .. }))
+        .collect::<Vec<_>>();
+    assert_eq!(negatives.len(), 2);
+    for h in negatives {
+        assert_eq!(
+            facts(h).declaration(),
+            DeclarationPolicy::ExplicitNegativeDeclaration
+        );
+    }
+    let adapter = headers(
+        "trait Bound {} auto trait Auto {} impl<T:Bound> !Auto for T {}",
+        2015,
+    );
+    let negative = adapter
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { negative: true, .. }))
+        .unwrap();
+    let f = facts(negative);
+    assert_eq!(
+        f.atoms()
+            .iter()
+            .filter(|a| a.policy() == AtomPolicy::PositiveTraitTypeRequired)
+            .count(),
+        1
+    );
+    // Raw negative declarations remain subject to source profile/compiler-facet
+    // and actual Self/arguments/predicate applicability, never unconditional.
+}
+#[test]
+fn m022_projection_original_keeps_target_and_selected_members_cold() {
+    let h = headers(
+        include_str!(
+            "../../fixtures/upstream/rustc-checkout/tests/ui/auto-traits/auto-trait-projection-recursion.rs"
+        ),
+        2015,
+    );
+    let trait_header = h
+        .headers()
+        .iter()
+        .find(|h| h.definition().declared_name == "Y")
+        .unwrap();
+    let f = facts(trait_header);
+    assert_eq!(f.declaration(), DeclarationPolicy::OrdinaryTrait);
+    assert_eq!(f.members().len(), 1);
+    assert_eq!(
+        f.members()[0].definition(),
+        trait_header.associated()[0].definition.fingerprint()
+    );
+    assert_eq!(
+        f.members()[0].header(),
+        trait_header.associated()[0].fingerprint()
+    );
+    let implementation = h
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+        .unwrap();
+    assert_eq!(facts(implementation).members().len(), 1);
+    // Box/X/associated P/Send normalization and source library capture are
+    // prerequisites, not facts inferred from printed types or runtime tags.
+}
+#[test]
+fn m022_source_profiles_and_same_spelled_owners_preserve_distinct_identities() {
+    let mut identities = std::collections::BTreeSet::new();
+    for edition in [2015, 2018, 2021, 2024] {
+        let h = headers("auto trait Marker {}", edition);
+        let f = facts(&h.headers()[0]);
+        assert_eq!(f.owning_edition(), edition);
+        assert!(identities.insert(f.fingerprint()));
+    }
+    let a = headers("trait Marker {}", 2015);
+    let b = headers("auto trait Marker {}", 2015);
+    assert_ne!(
+        facts(&a.headers()[0]).fingerprint(),
+        facts(&b.headers()[0]).fingerprint()
+    );
+}
+#[test]
+fn m022_policy_limits_reject_before_returning_partial_source_facts() {
+    let h = headers(
+        "trait A {} trait B {} trait C {} impl<T:A+B> C for T {fn cold(){unknown!()}}",
+        2015,
+    );
+    let owner = h
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+        .unwrap();
+    for field in 0..3 {
+        let mut limits = PolicyLimits::default();
+        match field {
+            0 => limits.metadata_bytes = 0,
+            1 => limits.atoms = 0,
+            _ => limits.members = 0,
+        }
+        assert_eq!(
+            RetainedHeaderCycleFacts::capture(owner, limits)
+                .err()
+                .unwrap()
+                .code,
+            "LRR-E-METADATA-LIMIT"
+        );
+    }
+    let h = headers(
+        "trait A<'a> {} trait B {} impl<T> B for T where for<'a> T:A<'a> {}",
+        2015,
+    );
+    let owner = h
+        .headers()
+        .iter()
+        .find(|h| matches!(h.kind(), HeaderKind::Impl { .. }))
+        .unwrap();
+    let mut limits = PolicyLimits::default();
+    limits.binder_parameters = 0;
+    assert!(RetainedHeaderCycleFacts::capture(owner, limits).is_err());
+}
+#[test]
