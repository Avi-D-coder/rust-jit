+                    supertraits
+                        .get(usize::try_from(bound).map_err(|_| limit())?)
+                        .ok_or_else(|| fault("policy supertrait ordinal differs"))?,
+                    &[][..],
+                )
+            }
+            _ => return Ok(None),
+        };
+        if bound.modifier != BoundModifier::Ordinary {
+            return Ok(None);
+        }
+        let Some(name) = bound.ty.as_ref().and_then(bare_path) else {
+            return Ok(None);
+        };
+        // Real source generic/binder ribs cannot be guessed through an ambient
+        // same-spelled Type memo. Associated/type anchors remain unresolved.
