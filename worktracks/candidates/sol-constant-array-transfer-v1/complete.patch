+    assert!(frame.has_cleanup_activation());
+    assert_eq!(store.state(cell).unwrap(), old);
+    assert!(frame.advance_scope_cleanup(&mut store).is_err());
+    assert_eq!(store.state(cell).unwrap(), old);
+    assert_eq!(frame.fuel.snapshot().used, 2);
+}
