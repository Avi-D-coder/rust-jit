+//! Opaque T054 publication prerequisite. The selected source/type producer is
+//! intentionally unavailable until root integrates its complete current proof.
+//! This module performs no queries, source selection or physical guest effects.
+#[cfg(test)]
+use crate::core::digest::StableEncode;
+use crate::{
+    core::{diagnostic::Diagnostic, digest::Digest},
+    frontend::constants::{
+        ConstValue,
+        wire::{self, ConstantWireType},
+    },
+    ir::pc::{PcKey, SlotId},
+    runtime::{cell::FrameId, shape::TypeId},
+    syntax::spans::BodySpan,
+    traits::term::TyTerm,
+};
+// There is NO production variant or constructor. A digest, descriptor, caller
+// spelling or decoded payload cannot supply the missing current authority.
+enum PublicationAuthority {
+    #[cfg(test)]
+    PhysicalFixtureOnly,
+}
+pub(crate) struct AdmittedConstantUse {
+    _authority: PublicationAuthority,
+    frame: FrameId,
+    pc: PcKey,
+    destination: SlotId,
+    span: BodySpan,
+    body_index: Digest,
+    source: TyTerm,
+    ty: TypeId,
+    content: Digest,
+}
+impl AdmittedConstantUse {
+    pub(crate) fn frame(&self) -> FrameId {
+        self.frame
+    }
+    pub(crate) fn pc(&self) -> &PcKey {
+        &self.pc
+    }
+    pub(crate) fn destination(&self) -> SlotId {
+        self.destination
+    }
+    pub(crate) fn span(&self) -> &BodySpan {
+        &self.span
+    }
+    pub(crate) fn body_index(&self) -> Digest {
+        self.body_index
+    }
+    pub(crate) fn source(&self) -> &TyTerm {
+        &self.source
+    }
+    pub(crate) fn ty(&self) -> TypeId {
+        self.ty
+    }
+    pub(crate) fn admits_content(
+        &self,
+        value: &ConstValue,
+        ty: &ConstantWireType,
+    ) -> Result<bool, Diagnostic> {
+        Ok(Digest::of_bytes(&wire::encode(value, ty, 1 << 20)?) == self.content)
+    }
+}
+/// Test-only physical injection. It is NOT source/namespace/query/type authority
+/// and must never become a production constructor or full-fixture pass.
+#[cfg(test)]
+pub(crate) fn physical_fixture_use(
+    frame: &crate::vm::frame::Frame,
+    destination: SlotId,
+    source: TyTerm,
+    ty: TypeId,
+    value: &ConstValue,
+    wire: &ConstantWireType,
+) -> Result<AdmittedConstantUse, Diagnostic> {
+    let pc = frame.pc().clone();
+    Ok(AdmittedConstantUse {
+        _authority: PublicationAuthority::PhysicalFixtureOnly,
+        frame: frame.constant_frame_anchor(),
+        span: frame.body.span(crate::ir::pc::NodeId(pc.node))?,
+        pc,
+        destination,
+        body_index: frame.body.fingerprint(),
+        source,
+        ty,
+        content: Digest::of_bytes(&wire::encode(value, wire, 1 << 20)?),
+    })
+}
