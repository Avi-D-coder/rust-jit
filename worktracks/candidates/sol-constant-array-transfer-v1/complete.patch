+fn construction_fuel_refusal_leaves_only_uninit_temporary_for_ordinary_cleanup() {
+    let (mut frame, mut store, paths) = context(ADAPTER, 2024);
+    reach(&mut frame, paths[0]);
+    let ty = store
+        .intern_type(TypeKey::Array {
+            element: TypeId(9),
+            len: 1,
