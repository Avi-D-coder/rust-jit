+/// Match precisely the unsuffixed integer prefix that ordinary lowering folds
+/// into a deferred literal, including its bounded parentheses. This is syntax
+/// evidence only; it supplies neither a call identity nor a concrete parameter.
+pub(super) fn deferred_integer_initializer(expression: &ast::Expr) -> Result<bool, Diagnostic> {
+    let mut root = expression.clone();
+    let mut depth = 0usize;
+    loop {
+        if root
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()))
+        {
+            return Ok(false);
+        }
+        let ast::Expr::ParenExpr(group) = root else {
+            break;
+        };
+        depth = depth.checked_add(1).filter(|n| *n <= 256).ok_or_else(|| {
+            Diagnostic::new(
+                "LRR-E-METADATA-LIMIT",
+                "numeric initializer parenthesis limit".into(),
+            )
+        })?;
+        let Some(inner) = group.expr() else {
+            return Ok(false);
+        };
+        root = inner;
+    }
+    let ast::Expr::PrefixExpr(prefix) = root else {
+        return Ok(false);
+    };
+    if !prefix.op_token().is_some_and(|token| token.text() == "-") {
+        return Ok(false);
+    }
+    let Some(mut operand) = prefix.expr() else {
+        return Ok(false);
+    };
+    loop {
+        if operand
+            .syntax()
+            .children()
+            .any(|node| ast::Attr::can_cast(node.kind()))
+        {
+            return Ok(false);
+        }
+        let ast::Expr::ParenExpr(group) = operand else {
+            break;
+        };
+        depth = depth.checked_add(1).filter(|n| *n <= 256).ok_or_else(|| {
+            Diagnostic::new(
+                "LRR-E-METADATA-LIMIT",
+                "numeric initializer parenthesis limit".into(),
+            )
+        })?;
+        let Some(inner) = group.expr() else {
+            return Ok(false);
+        };
+        operand = inner;
+    }
+    Ok(matches!(operand, ast::Expr::Literal(literal)
+        if literal.token().kind() == SyntaxKind::INT_NUMBER
+            && ast::IntNumber::cast(literal.token()).is_some_and(|number| number.suffix().is_none())))
 }
 
