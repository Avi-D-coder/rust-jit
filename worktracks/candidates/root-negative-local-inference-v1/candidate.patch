+/// Private source admission. A binding ordinal alone cannot mint this hint.
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct LocalIntegerFallback {
+    body: crate::source::manifest::BodyKey,
+    index: crate::core::digest::Digest,
+    binding: NodeId,
+    destination: SlotId,
+    site: NodeId,
+    key: Option<PcKey>,
+}
+impl LocalIntegerFallback {
+    pub(crate) fn binding(&self) -> NodeId {
+        self.binding
+    }
+    pub(crate) fn allocated_bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+    }
+    pub(crate) fn require(
+        &self,
+        body: &BodyIndex,
+        key: &PcKey,
+        child: SlotId,
+    ) -> Result<(), Diagnostic> {
+        use crate::core::digest::StableEncode;
+        if body.body() != &self.body
+            || body.fingerprint() != self.index
+            || self.key.as_ref() != Some(key)
+            || child != self.destination
+            || key.node != self.site.0
+        {
+            return Err(error(
+                "local integer fallback source/index/phase/destination differs",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn bind(&mut self, body: &BodyIndex, key: &PcKey) -> Result<(), Diagnostic> {
+        if self.key.is_some() || key.node != self.site.0 || key.body != self.body {
+            return Err(error(
+                "local integer fallback phase already bound or differs",
+            ));
+        }
+        self.key = Some(key.clone());
+        self.require(body, key, self.destination)
+    }
+}
+impl crate::core::digest::StableEncode for LocalIntegerFallback {
+    const DOMAIN: &'static str = "lrr/v1/local-integer-fallback";
+    fn encode_fields(&self, e: &mut crate::core::digest::StableEncoder) {
+        e.record(&self.body);
+        e.digest(self.index);
+        e.u32(self.binding.0);
+        e.u32(self.destination.0);
+        e.u32(self.site.0);
+        e.option(&self.key, |e, key| e.record(key));
+    }
+}
+
+/// Exact original declaration evidence for a soft integer default at a local
+/// read. Lookup stays inside this entered body and never visits another body.
+pub(super) fn local_integer_fallback(
+    parsed: &ParsedFile,
+    index: &BodyIndex,
+    body: &BodyHandle,
+    binding: NodeId,
+    destination: SlotId,
+    key: &PcKey,
+) -> Result<Option<Box<LocalIntegerFallback>>, Diagnostic> {
+    use crate::core::digest::StableEncode;
+    if index.body() != &body.key() || index.profile() != &parsed.profile {
+        return Err(error("local fallback source/body differs"));
+    }
+    let node = index
+        .nodes()
+        .get(binding.0 as usize)
+        .filter(|node| node.role == NodeRole::Pattern)
+        .ok_or_else(|| error("local fallback binding absent"))?;
+    let start = body
+        .range
+        .start
+        .checked_add(node.range.start)
+        .ok_or_else(|| error("local fallback source start overflow"))?;
+    let end = body
+        .range
+        .start
+        .checked_add(node.range.end)
+        .ok_or_else(|| error("local fallback source end overflow"))?;
+    let root = parsed.entered_body_root(body)?;
+    let range = ra_ap_syntax::TextRange::new(start.into(), end.into());
+    if !root.text_range().contains_range(range) {
+        return Err(error("local fallback pattern outside entered body"));
+    }
+    let Some(pattern) = root
+        .covering_element(range)
+        .ancestors()
+        .filter_map(ast::IdentPat::cast)
+        .find(|pattern| pattern.syntax().text_range() == range)
+    else {
+        return Ok(None);
+    };
+    if pattern.ref_token().is_some() || pattern.at_token().is_some() {
+        return Ok(None);
+    }
+    let Some(statement) = pattern.syntax().parent().and_then(ast::LetStmt::cast) else {
+        return Ok(None);
+    };
+    if statement.ty().is_some()
+        || statement.let_else().is_some()
+        || !statement
+            .pat()
+            .is_some_and(|actual| actual.syntax() == pattern.syntax())
+    {
+        return Ok(None);
+    }
+    let Some(initializer) = statement.initializer() else {
+        return Ok(None);
+    };
+    if !super::numeric_fallback::deferred_integer_initializer(&initializer)? {
+        return Ok(None);
+    }
+    let site = index
+        .nodes()
+        .get(key.node as usize)
+        .ok_or_else(|| error("local fallback read node absent"))?;
+    let macro_read = site.role == NodeRole::Expression(ExpressionKind::Macro);
+    if key.body != body.key()
+        || (!macro_read && key.phase != Phase::Entry.code()?)
+        || if macro_read {
+            !site.runtime_scalar_slots.contains(&destination)
+        } else {
+            site.role != NodeRole::Expression(ExpressionKind::Path)
+                || site.value != Some(destination)
+        }
+    {
+        return Err(error("local fallback read/destination differs"));
+    }
+    if !macro_read {
+        let start = body
+            .range
+            .start
+            .checked_add(site.range.start)
+            .ok_or_else(|| error("local fallback read start overflow"))?;
+        let end = body
+            .range
+            .start
+            .checked_add(site.range.end)
+            .ok_or_else(|| error("local fallback read end overflow"))?;
+        let read_range = ra_ap_syntax::TextRange::new(start.into(), end.into());
+        let path = root
+            .covering_element(read_range)
+            .ancestors()
+            .filter_map(ast::PathExpr::cast)
+            .find(|path| path.syntax().text_range() == read_range)
+            .ok_or_else(|| error("local fallback exact read absent"))?;
+        if local_binding(parsed, index, body, &path)? != Some(binding) {
+            return Err(error("local fallback names another source binding"));
+        }
+    }
+    let proof = LocalIntegerFallback {
+        body: body.key(),
+        index: index.fingerprint(),
+        binding,
+        destination,
+        site: site.id,
+        key: if macro_read { None } else { Some(key.clone()) },
+    };
+    Ok(Some(Box::new(proof)))
+}
