+use lrr::{
+    runtime::{
+        cell::{CellId, CellOwner, CellState, GuestStore, RefId, StorageContract, TicketId},
+        place::{Place, PlaceFailure, PlacePanic},
+        reference::Access,
+        shape::{TypeId, TypeKey},
+        value::ValueRepr,
+    },
+    vm::{fuel::RunFuel, vector::VectorConstruction},
+};
+fn usize_value(n: u64) -> ValueRepr {
+    ValueRepr::unsigned(TypeId(13), n).unwrap()
+}
+fn setup(values: &[i64], writable: bool) -> (GuestStore, CellId) {
+    setup_limits(values, writable, 100_000)
+}
+fn setup_limits(values: &[i64], writable: bool, handles: u32) -> (GuestStore, CellId) {
+    setup_element(values, writable, handles, TypeId(6))
+}
+fn setup_element(
+    values: &[i64],
+    writable: bool,
+    handles: u32,
+    element: TypeId,
+) -> (GuestStore, CellId) {
+    let mut store = GuestStore::new(1, handles, 16 << 20).unwrap();
+    let frame = store.new_frame_anchor().unwrap();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut vector = VectorConstruction::begin(
+        &mut store,
+        &mut fuel,
+        element,
+        values.len().try_into().unwrap(),
+    )
+    .unwrap();
+    for (i, n) in values.iter().enumerate() {
+        let c = store
+            .new_cell(
+                StorageContract::Exact(element),
+                true,
+                CellOwner::FrameSlot {
+                    frame,
+                    slot: i.try_into().unwrap(),
+                },
+            )
+            .unwrap();
+        let scalar = if element == TypeId(9) {
+            ValueRepr::unsigned(element, u64::try_from(*n).unwrap()).unwrap()
+        } else {
+            ValueRepr::signed(element, *n).unwrap()
+        };
+        let t = store.ticket(scalar).unwrap();
+        store.initialize(c, t).unwrap();
+        vector.push(&mut store, &mut fuel, c).unwrap();
+    }
+    let t = vector.finish(&mut store, &mut fuel).unwrap();
+    let ty = TypeId(store.peek_ticket(t).unwrap().type_id);
+    let c = store
+        .new_cell(
+            StorageContract::Exact(ty),
+            writable,
+            CellOwner::FrameSlot { frame, slot: 100 },
+        )
+        .unwrap();
+    store.initialize(c, t).unwrap();
+    let slice = store.intern_type(TypeKey::Slice { element }).unwrap();
+    for target in [slice, element] {
+        for mutable in [false, true] {
+            store.intern_type(TypeKey::Ref { mutable, target }).unwrap();
+        }
+    }
+    (store, c)
+}
+fn commit(
+    store: &mut GuestStore,
+    plan: lrr::runtime::buffer_slice::PreparedBufferBorrow,
+) -> TicketId {
+    store.reserve_buffer_borrow(&plan).unwrap();
+    let mut fuel = RunFuel::new(1).unwrap();
+    fuel.charge().unwrap();
+    store.commit_buffer_borrow(plan).unwrap()
+}
+fn reference(store: &mut GuestStore, ticket: TicketId) -> RefId {
+    let ty = TypeId(store.peek_ticket(ticket).unwrap().type_id);
+    let frame = store.new_frame_anchor().unwrap();
+    let cell = store
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 200 },
+        )
+        .unwrap();
+    store.initialize(cell, ticket).unwrap();
+    store.reference_from_cell(cell).unwrap()
