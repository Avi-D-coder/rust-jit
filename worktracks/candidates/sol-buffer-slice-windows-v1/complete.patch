+//! Checked physical slice windows. Source member/Range admission belongs to the driver.
+use super::*;
+use crate::runtime::{
+    buffer_slice::{BufferBorrowRequest, BufferSliceWindow, PreparedBufferBorrow},
+    object::MAX_CONSTRUCTION_FIELDS,
+    place::checked_index,
+};
+fn checked_range(
+    start: ValueRepr,
+    end: ValueRepr,
+    length: u32,
+) -> Result<(u32, u32), PlaceFailure> {
+    let start = checked_index(start)?;
+    let end = checked_index(end)?;
+    if start > end || end > u64::from(length) {
+        return Err(PlaceFailure::GuestPanic(PlacePanic::IndexOutOfBounds));
+    }
+    let start = u32::try_from(start).map_err(|_| resource())?;
+    let end = u32::try_from(end).map_err(|_| resource())?;
+    Ok((start, end.checked_sub(start).ok_or_else(resource)?))
+}
+impl GuestStore {
+    pub(super) fn validate_buffer_window(
+        &self,
+        window: &BufferSliceWindow,
+        target: TypeId,
+    ) -> Result<(), Diagnostic> {
+        self.validate_vector_buffer_owner(window.object, window.generation)?;
+        if !matches!(self.types.descriptor(target)?.key.as_ref(),TypeKey::Slice{element}if *element==window.element)
+            || self.types.descriptor(window.element)?.shape != ShapeCategory::Scalar
+            || window.element.0 == 16
+            || window.members.len() != window.length as usize
+        {
+            return Err(lease_fault());
+        }
+        let object = self.objects.get(window.object)?;
+        if !matches!(self.types.descriptor(object.type_id)?.key.as_ref(),TypeKey::Facade{family:crate::runtime::shape::FacadeType::Vec,args}if args.as_ref()==[window.element])
+        {
+            return Err(lease_fault());
+        }
+        let ObjectStorage::Vector(storage) = &object.storage else {
+            return Err(lease_fault());
+        };
+        let end = window
+            .start
+            .checked_add(window.length)
+            .ok_or_else(resource)?;
+        let capacity = storage.buffer.ok_or_else(lease_fault)?.capacity;
+        // Empty windows have no removed element to invalidate; the allocation
+        // and checked one-past position remain mandatory even after shrink.
+        if end > capacity || (window.length != 0 && end as usize > storage.fields.len()) {
+            return Err(lease_fault());
+        }
+        for (offset, stamp) in window.members.iter().enumerate() {
+            let ordinal = window
+                .start
+                .checked_add(u32::try_from(offset).map_err(|_| resource())?)
+                .ok_or_else(resource)?;
+            if storage.fields.get(ordinal as usize) != Some(&stamp.cell)
+                || self.cells.get(stamp.cell)?.owner
+                    != (CellOwner::Buffer {
+                        object: window.object,
+                        index: ordinal,
+                    })
+                || self.place_stamp(stamp.cell)? != *stamp
+                || self.place_type(stamp.cell)? != window.element
+            {
+                return Err(lease_fault());
+            }
+        }
+        Ok(())
+    }
+    fn capture_window(
+        &self,
+        object: ObjectId,
+        generation: u32,
+        element: TypeId,
+        start: u32,
+        length: u32,
+    ) -> Result<BufferSliceWindow, Diagnostic> {
+        self.validate_vector_buffer_owner(object, generation)?;
+        if length as usize > MAX_CONSTRUCTION_FIELDS {
+            return Err(resource());
+        }
+        if self.types.descriptor(element)?.shape != ShapeCategory::Scalar || element.0 == 16 {
+            return Err(Diagnostic::new(
+                "LRR-E-UNSUPPORTED",
+                "Buffer window element requires pending general source/layout/drop integration"
+                    .into(),
+            ));
+        }
+        let estimated = (length as usize)
+            .checked_mul(std::mem::size_of::<CellStamp>())
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(resource)?;
+        self.budget.check(2, estimated)?;
+        let ObjectStorage::Vector(storage) = &self.objects.get(object)?.storage else {
+            return Err(lease_fault());
+        };
+        let end = start.checked_add(length).ok_or_else(resource)?;
+        if (length != 0 && end as usize > storage.fields.len())
+            || end > storage.buffer.ok_or_else(lease_fault)?.capacity
+        {
+            return Err(lease_fault());
+        }
+        let mut members = Vec::new();
+        members
+            .try_reserve_exact(length as usize)
+            .map_err(|_| resource())?;
+        for ordinal in start..end {
+            let cell = *storage
+                .fields
+                .get(ordinal as usize)
+                .ok_or_else(lease_fault)?;
+            if self.cells.get(cell)?.owner
+                != (CellOwner::Buffer {
+                    object,
+                    index: ordinal,
+                })
+                || self.place_type(cell)? != element
+            {
+                return Err(lease_fault());
+            }
+            members.push(self.place_stamp(cell)?);
+        }
+        let actual = members
+            .capacity()
+            .checked_mul(std::mem::size_of::<CellStamp>())
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(resource)?;
+        self.budget.check(2, actual)?;
+        Ok(BufferSliceWindow {
+            object,
+            generation,
+            element,
+            start,
+            length,
+            members,
+        })
+    }
+    fn prepared_buffer_borrow(
+        &self,
+        request: BufferBorrowRequest,
+        record: ReferenceRecord,
+    ) -> Result<PreparedBufferBorrow, PlaceFailure> {
+        let result = self
+            .types
+            .find(&TypeKey::Ref {
+                mutable: record.access == Access::Mutable,
+                target: record.target,
+            })
+            .ok_or_else(|| {
+                Diagnostic::new(
+                    "LRR-E-UNSUPPORTED",
+                    "source-selected slice/reference result shape was not prepared".into(),
+                )
+            })?;
+        let plan = PreparedBufferBorrow {
+            epoch: self.budget.epoch(),
+            access: record.access,
+            request,
+            record,
+            result,
+        };
+        self.preflight_buffer_borrow(&plan)?;
+        Ok(plan)
+    }
+    /// Half-open runtime bounds only; no Index/Range/SliceIndex witness is selected here.
+    pub fn prepare_vector_window(
+        &self,
+        base: &Place,
+        start: ValueRepr,
+        end: ValueRepr,
+        access: Access,
+    ) -> Result<PreparedBufferBorrow, PlaceFailure> {
+        let resolved = self.resolve_place(base)?;
+        if access == Access::Mutable && !resolved.writable {
+            return Err(access_fault().into());
+        }
+        let element = match self.types.descriptor(resolved.ty)?.key.as_ref() {
+            TypeKey::Facade {
+                family: crate::runtime::shape::FacadeType::Vec,
+                args,
+            } if args.len() == 1 => args[0],
+            _ => return Err(invalid().into()),
+        };
+        let (object, storage) = self.place_object(resolved.target.cell)?;
+        if !matches!(self.objects.get(object)?.storage, ObjectStorage::Vector(_)) {
+            return Err(invalid().into());
+        }
+        let buffer = storage.buffer.ok_or_else(lease_fault)?;
+        let (start, length) = checked_range(
+            start,
+            end,
+            u32::try_from(storage.fields.len()).map_err(|_| resource())?,
+        )?;
+        let target = self
+            .types
+            .find(&TypeKey::Slice { element })
+            .ok_or_else(|| {
+                Diagnostic::new(
+                    "LRR-E-UNSUPPORTED",
+                    "source-selected slice target shape was not prepared".into(),
+                )
+            })?;
+        let window = self.capture_window(object, buffer.generation, element, start, length)?;
+        let count = base.projections.len();
+        let mut projections = Vec::new();
+        checked_chain_bytes(count)?;
+        projections
+            .try_reserve_exact(count)
+            .map_err(|_| resource())?;
+        projections.extend_from_slice(&base.projections);
+        checked_chain_bytes(projections.capacity())?;
+        let record = ReferenceRecord {
+            access,
+            owner: None,
+            target,
+            root: resolved.target,
+            enclosing: Vec::new(),
+            final_cell: resolved.target,
+            buffer_root: None,
+            window: Some(window),
+        };
+        self.prepared_buffer_borrow(
+            BufferBorrowRequest::Vector(Place {
+                root: base.root,
+                projections: projections.into_boxed_slice(),
+            }),
+            record,
+        )
+    }
+    pub fn buffer_slice_len(&self, reference: RefId) -> Result<u32, Diagnostic> {
+        let record = self.references.get(reference)?;
+        self.validate_reference_record(record)?;
+        Ok(record.window.as_ref().ok_or_else(invalid)?.length)
+    }
+    pub fn prepare_slice_window(
+        &self,
+        reference: RefId,
+        start: ValueRepr,
+        end: ValueRepr,
+        access: Access,
+    ) -> Result<PreparedBufferBorrow, PlaceFailure> {
+        let parent = self.references.get(reference)?;
+        self.validate_reference_record(parent)?;
+        if access == Access::Mutable && parent.access != Access::Mutable {
+            return Err(access_fault().into());
+        }
+        let parent_window = parent.window.as_ref().ok_or_else(invalid)?;
+        let (start, length) = checked_range(start, end, parent_window.length)?;
+        let start = parent_window
+            .start
+            .checked_add(start)
+            .ok_or_else(resource)?;
+        let window = self.capture_window(
+            parent_window.object,
+            parent_window.generation,
+            parent_window.element,
+            start,
+            length,
+        )?;
+        let record = ReferenceRecord {
+            access,
+            owner: None,
+            target: parent.target,
+            root: parent.root,
+            enclosing: Vec::new(),
+            final_cell: parent.final_cell,
+            buffer_root: None,
+            window: Some(window),
+        };
+        self.prepared_buffer_borrow(BufferBorrowRequest::Window(reference), record)
+    }
+    /// Creates an ordinary Buffer element lease from an exact window membership;
+    /// it never aliases the unsized window's container cell as its element.
+    pub fn prepare_slice_element(
+        &self,
+        reference: RefId,
+        index: ValueRepr,
+        access: Access,
+    ) -> Result<PreparedBufferBorrow, PlaceFailure> {
+        let parent = self.references.get(reference)?;
+        self.validate_reference_record(parent)?;
+        if access == Access::Mutable && parent.access != Access::Mutable {
+            return Err(access_fault().into());
+        }
+        let window = parent.window.as_ref().ok_or_else(invalid)?;
+        let index = checked_index(index)?;
+        if index >= u64::from(window.length) {
+            return Err(PlaceFailure::GuestPanic(PlacePanic::IndexOutOfBounds));
+        }
+        let index = u32::try_from(index).map_err(|_| resource())?;
+        let ordinal = window.start.checked_add(index).ok_or_else(resource)?;
+        let target = *window.members.get(index as usize).ok_or_else(lease_fault)?;
+        if access == Access::Mutable && !self.cells.get(target.cell)?.writable {
+            return Err(access_fault().into());
+        }
+        let mut enclosing = Vec::new();
+        enclosing.try_reserve_exact(1).map_err(|_| resource())?;
+        enclosing.push(EnclosingObject {
+            parent: parent.root,
+            object: window.object,
+            field: ordinal,
+            child: target.cell,
+            variant: None,
+            buffer_epoch: Some(window.generation),
+        });
+        let record = ReferenceRecord {
+            access,
+            owner: None,
+            target: window.element,
+            root: parent.root,
+            enclosing,
+            final_cell: target,
+            buffer_root: Some(0),
+            window: None,
+        };
+        self.prepared_buffer_borrow(BufferBorrowRequest::Window(reference), record)
+    }
+    fn preflight_buffer_borrow(&self, plan: &PreparedBufferBorrow) -> Result<(), PlaceFailure> {
+        if plan.epoch != self.budget.epoch() || plan.access != plan.record.access {
+            return Err(lease_fault().into());
+        }
+        match &plan.request {
+            BufferBorrowRequest::Vector(base) => {
+                let resolved = self.resolve_place(base)?;
+                if plan.access == Access::Mutable && !resolved.writable {
+                    return Err(access_fault().into());
+                }
+                let window = plan.record.window.as_ref().ok_or_else(invalid)?;
+                let (object, _) = self.place_object(resolved.target.cell)?;
+                if object != window.object || resolved.target != plan.record.root {
+                    return Err(lease_fault().into());
+                }
+            }
+            BufferBorrowRequest::Window(id) => {
+                let parent = self.references.get(*id)?;
+                self.validate_reference_record(parent)?;
+                if plan.access == Access::Mutable && parent.access != Access::Mutable {
+                    return Err(access_fault().into());
+                }
+                if parent.window.is_none() {
+                    return Err(invalid().into());
+                }
+            }
+        }
+        self.validate_reference_record(&plan.record)?;
+        if !matches!(self.types.descriptor(plan.result)?.key.as_ref(),TypeKey::Ref{mutable,target}if *mutable==(plan.access==Access::Mutable)&&*target==plan.record.target)
+        {
+            return Err(invalid().into());
+        }
+        let bytes = plan
+            .record
+            .owned_bytes()?
+            .checked_add(self.references.reservation_bytes(1)?)
+            .and_then(|n| n.checked_add(self.tickets.reservation_bytes(1).ok()?))
+            .ok_or_else(resource)?;
+        self.budget.check(2, bytes)?;
+        Ok(())
+    }
+    /// No guest owner or reference is published. Capacities may be retained on refusal.
+    pub fn reserve_buffer_borrow(
+        &mut self,
+        plan: &PreparedBufferBorrow,
+    ) -> Result<(), PlaceFailure> {
+        self.preflight_buffer_borrow(plan)?;
+        self.references.reserve(1, &mut self.budget)?;
+        self.tickets.reserve(1, &mut self.budget)?;
+        self.preflight_buffer_borrow(plan)
+    }
+    /// Driver must charge exactly its ordinary selected operation once after
+    /// preflight/reserve and before this commit; cancellation cannot call commit.
+    pub fn commit_buffer_borrow(
+        &mut self,
+        plan: PreparedBufferBorrow,
+    ) -> Result<TicketId, PlaceFailure> {
+        self.reserve_buffer_borrow(&plan)?;
+        let bytes = plan.record.owned_bytes()?;
+        let reference = self
+            .references
+            .allocate(plan.record, bytes, &mut self.budget)?;
+        let value = ValueRepr {
+            kind: 9,
+            type_id: plan.result.0,
+            payload: reference.bits(),
+        };
+        let ticket = self
+            .tickets
+            .allocate(TransferTicket { value }, 0, &mut self.budget)
+            .map(TicketId::from)?;
+        self.set_owner(value, ValueOwner::Ticket(ticket))?;
+        Ok(ticket)
+    }
+}
+
+#[cfg(test)]
+mod window_invalidation_tests {
+    use super::*;
+    fn value(n: u64) -> ValueRepr {
+        ValueRepr::unsigned(TypeId(13), n).unwrap()
+    }
+    fn vector(element: TypeId, n: u32) -> (GuestStore, CellId) {
+        let mut store = GuestStore::new(1, 100_000, 16 << 20).unwrap();
+        let frame = store.new_frame_anchor().unwrap();
+        let (ty, guard) = store.begin_vector_construction(element, n).unwrap();
+        for i in 0..n {
+            let c = store
+                .new_cell(
+                    StorageContract::Exact(element),
+                    true,
+                    CellOwner::FrameSlot { frame, slot: i },
+                )
+                .unwrap();
+            let scalar = if element == TypeId(1) {
+                ValueRepr::unit()
+            } else {
+                ValueRepr::signed(element, i64::from(i)).unwrap()
+            };
+            let t = store.ticket(scalar).unwrap();
+            store.initialize(c, t).unwrap();
+            store.vector_move_from(guard, i, c).unwrap();
+        }
+        let t = store.commit_construction(guard, ty).unwrap();
+        let c = store
+            .new_cell(
+                StorageContract::Exact(ty),
+                true,
+                CellOwner::FrameSlot { frame, slot: 100 },
+            )
+            .unwrap();
+        store.initialize(c, t).unwrap();
+        let slice = store.intern_type(TypeKey::Slice { element }).unwrap();
+        for target in [slice, element] {
+            for mutable in [false, true] {
+                store.intern_type(TypeKey::Ref { mutable, target }).unwrap();
+            }
+        }
+        (store, c)
+    }
+    fn publish(store: &mut GuestStore, plan: PreparedBufferBorrow) -> RefId {
+        let t = store.commit_buffer_borrow(plan).unwrap();
+        RefId::from_bits(store.peek_ticket(t).unwrap().payload)
+    }
+    #[test]
+    fn buffer_window_generation_replay_refuses_old_window_and_prepared_request() {
+        let (mut s, c) = vector(TypeId(6), 2);
+        let plan = s
+            .prepare_vector_window(&Place::cell(c), value(0), value(2), Access::Shared)
+            .unwrap();
+        let r = publish(&mut s, plan);
+        let pending = s
+            .prepare_slice_window(r, value(1), value(2), Access::Shared)
+            .unwrap();
+        let record = s.references.get(r).unwrap();
+        let object = record.window.as_ref().unwrap().object;
+        let ObjectStorage::Vector(storage) = &mut s.objects.get_mut(object).unwrap().storage else {
+            panic!("actual Vec buffer")
+        };
+        storage.buffer.as_mut().unwrap().generation += 1;
+        let before = s.budget.handles();
+        assert!(s.buffer_slice_len(r).is_err());
+        assert!(s.commit_buffer_borrow(pending).is_err());
+        assert_eq!(s.budget.handles(), before);
+        // Epoch metadata transition only: allocation-growth execution is not claimed.
+    }
+    #[test]
+    fn buffer_window_replaced_member_never_resurrects_and_unaffected_prefix_survives() {
+        let (mut s, c) = vector(TypeId(6), 2);
+        let full = s
+            .prepare_vector_window(&Place::cell(c), value(0), value(2), Access::Shared)
+            .unwrap();
+        let full = publish(&mut s, full);
+        let prefix = s
+            .prepare_slice_window(full, value(0), value(1), Access::Shared)
+            .unwrap();
+        let prefix = publish(&mut s, prefix);
+        let empty = s
+            .prepare_slice_window(full, value(2), value(2), Access::Shared)
+            .unwrap();
+        let empty = publish(&mut s, empty);
+        let old = s
+            .references
+            .get(full)
+            .unwrap()
+            .window
+            .as_ref()
+            .unwrap()
+            .members[1]
+            .cell;
+        let old_value = s.begin_drop(old).unwrap();
+        s.discard(old_value).unwrap();
+        s.retire_cell(old).unwrap();
+        let fresh = s.replacement_location(old).unwrap();
+        let t = s.ticket(ValueRepr::signed(TypeId(6), 99).unwrap()).unwrap();
+        s.initialize(fresh, t).unwrap();
+        assert!(s.buffer_slice_len(full).is_err());
+        assert_eq!(s.buffer_slice_len(prefix).unwrap(), 1);
+        assert_eq!(s.buffer_slice_len(empty).unwrap(), 0);
+        // Controlled cell retirement/replacement tests lease identity, not Vec pop/push.
+    }
+    #[test]
+    fn buffer_window_empty_and_zero_sized_members_have_distinct_logical_cardinality() {
+        for n in [0, 3] {
+            let (mut s, c) = vector(TypeId(1), n);
+            let plan = s
+                .prepare_vector_window(
+                    &Place::cell(c),
+                    value(0),
+                    value(u64::from(n)),
+                    Access::Mutable,
+                )
+                .unwrap();
+            let r = publish(&mut s, plan);
+            assert_eq!(s.buffer_slice_len(r).unwrap(), n);
+            let plan = s
+                .prepare_slice_window(r, value(u64::from(n)), value(u64::from(n)), Access::Shared)
+                .unwrap();
+            let empty = publish(&mut s, plan);
+            assert_eq!(s.buffer_slice_len(empty).unwrap(), 0);
+            if n != 0 {
+                let element = s
+                    .prepare_slice_element(r, value(2), Access::Shared)
+                    .unwrap();
+                let element = publish(&mut s, element);
+                assert_eq!(s.read_reference(element).unwrap(), ValueRepr::unit());
+            }
+        }
+    }
