+//! Run-owned Buffer slice metadata; never a source trait or native-layout witness.
+use super::{
+    cell::{ObjectId, RefId},
+    place::{CellStamp, Place},
+    reference::{Access, ReferenceRecord},
+    shape::TypeId,
+};
+/// An empty window has no first-element identity; its allocation still matters.
+pub(crate) struct BufferSliceWindow {
+    pub(super) object: ObjectId,
+    pub(super) generation: u32,
+    pub(super) element: TypeId,
+    pub(super) start: u32,
+    pub(super) length: u32,
+    pub(super) members: Vec<CellStamp>,
+}
+/// Private runtime request retained across preflight; no source authority inferred.
+pub(super) enum BufferBorrowRequest {
+    Vector(Place),
+    Window(RefId),
+}
+/// Opaque, single-use physical admission. Root must first select the exact source
+/// range/member and receiver context. This contains no opcode or callable witness.
+pub struct PreparedBufferBorrow {
+    pub(super) epoch: u32,
+    pub(super) request: BufferBorrowRequest,
+    pub(super) record: ReferenceRecord,
+    pub(super) result: TypeId,
+    pub(super) access: Access,
+}
+
+pub(crate) fn window_scalar_fault() -> crate::core::diagnostic::Diagnostic {
+    crate::core::diagnostic::Diagnostic::new(
+        "LRR-E-UNSUPPORTED",
+        "unsized Buffer window requires selected slice operations; it is not a scalar cell".into(),
+    )
+}
