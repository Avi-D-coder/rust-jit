+#[test]
+fn buffer_slice_fuel_cancellation_and_stale_prepare_preserve_existing_owners() {
+    let (mut s, c) = setup(&[1], true);
+    let plan = s
+        .prepare_vector_window(
+            &Place::cell(c),
+            usize_value(0),
+            usize_value(1),
+            Access::Shared,
+        )
+        .unwrap();
+    s.reserve_buffer_borrow(&plan).unwrap();
+    let handles = s.budget().handles();
+    let mut fuel = RunFuel::new(0).unwrap();
+    assert!(fuel.charge().is_err());
+    drop(plan);
+    assert_eq!(s.budget().handles(), handles);
+    assert!(matches!(s.state(c).unwrap(), CellState::Live(_)));
+    let plan = s
+        .prepare_vector_window(
+            &Place::cell(c),
+            usize_value(0),
+            usize_value(1),
+            Access::Shared,
+        )
+        .unwrap();
+    let mut fuel = RunFuel::new(10).unwrap();
+    fuel.cancellation().cancel();
+    assert!(fuel.charge().is_err());
+    drop(plan);
+    assert_eq!(s.vector_len(&Place::cell(c)).unwrap(), 1);
+    let plan = s
+        .prepare_vector_window(
+            &Place::cell(c),
+            usize_value(0),
+            usize_value(1),
+            Access::Shared,
+        )
+        .unwrap();
+    s.begin_drop(c).unwrap();
+    let handles = s.budget().handles();
+    assert!(s.commit_buffer_borrow(plan).is_err());
+    assert_eq!(s.budget().handles(), handles);
+}
