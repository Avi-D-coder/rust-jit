+#[test]
+fn buffer_slice_window_and_element_leases_survive_container_move_then_drop() {
+    let (mut s, c) = setup(&[7, 8], true);
+    let plan = s
+        .prepare_vector_window(
+            &Place::cell(c),
+            usize_value(0),
+            usize_value(2),
+            Access::Mutable,
+        )
+        .unwrap();
+    let t = commit(&mut s, plan);
+    let r = reference(&mut s, t);
+    let plan = s
+        .prepare_slice_element(r, usize_value(1), Access::Shared)
+        .unwrap();
+    let e = commit(&mut s, plan);
+    let e = reference(&mut s, e);
+    let StorageContract::Exact(ty) = s.declared(c).unwrap() else {
+        panic!("known Vec descriptor")
+    };
+    let moved = s.move_from(c).unwrap();
+    s.retire_cell(c).unwrap();
+    let frame = s.new_frame_anchor().unwrap();
+    let dest = s
+        .new_cell(
+            StorageContract::Exact(ty),
+            false,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    s.initialize(dest, moved).unwrap();
+    assert_eq!(s.buffer_slice_len(r).unwrap(), 2);
+    assert_eq!(
+        s.read_reference(e).unwrap(),
+        ValueRepr::signed(TypeId(6), 8).unwrap()
+    );
+    let plan = s
+        .prepare_slice_element(r, usize_value(1), Access::Mutable)
+        .unwrap();
+    let mutable = commit(&mut s, plan);
+    let mutable = reference(&mut s, mutable);
+    let incoming = s.ticket(ValueRepr::signed(TypeId(6), 9).unwrap()).unwrap();
+    let old = s.replace_reference(mutable, incoming).unwrap();
+    s.discard(old).unwrap();
+    assert_eq!(
+        s.read_reference(e).unwrap(),
+        ValueRepr::signed(TypeId(6), 9).unwrap()
+    );
+    let drop = s.begin_drop(dest).unwrap();
+    assert!(s.buffer_slice_len(r).is_err());
+    assert!(s.read_reference(e).is_err());
+    assert!(s.peek_ticket(drop).is_ok());
+}
