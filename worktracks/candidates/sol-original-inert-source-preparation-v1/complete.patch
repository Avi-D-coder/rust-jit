+//! Exact original SourceFile prefix producers. No manual readiness or macro execution.
+use crate::{
+    core::{diagnostic::Diagnostic, digest::Digest},
+    frontend::builtin_attributes::BuiltinAttributeCatalog,
+    source::changes::PreparedSourceView,
+    syntax::{
+        declaration_scan::{DeclarationProducerKind, DeclarationScan, DeclarationScopeKind},
+        parse::ParsedFile,
+        spans::SourceRange,
+    },
+};
+use ra_ap_syntax::{AstNode, ast::HasAttrs};
+use std::collections::BTreeSet;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-CATALOG-INCOMPLETE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "original source-prefix attribute budget".into(),
+    )
+}
+pub(super) fn capture(
+    source: &PreparedSourceView,
+    scan: &DeclarationScan,
+    byte_limit: usize,
+) -> Result<BTreeSet<Digest>, Diagnostic> {
+    if byte_limit < 128 || byte_limit > 32 * 1024 * 1024 {
+        return Err(limit());
+    }
+    source.require_original_hygiene()?;
+    source.require_declaration_syntax()?;
+    if scan.parse() != &source.selection().outline.parse
+        || scan.path() != &source.selection().path
+        || scan.cfg() != source.selection().outline.cfg
+        || scan.scope() != &source.outline().root_scope
+    {
+        return Err(fault(
+            "original prefix source/scan/profile/cfg/owning scope differs",
+        ));
+    }
+    let root = scan
+        .lexical_scopes()
+        .first()
+        .ok_or_else(|| fault("original prefix lexical root absent"))?;
+    if root.parent.is_some() || root.kind != DeclarationScopeKind::Module {
+        return Err(fault(
+            "original prefix is not an original module source root",
+        ));
+    }
+    if !scan
+        .producers()
+        .iter()
+        .any(|row| row.kind == DeclarationProducerKind::Attribute)
+    {
+        return Ok(BTreeSet::new());
+    }
+    let parsed = ParsedFile::parse(
+        source.captured_macro_blob()?,
+        source.selection().outline.parse.profile.clone(),
+    )?;
+    let tree = parsed.parsed.tree();
+    let mut metas = Vec::new();
+    for attribute in tree.attrs() {
+        if metas.len() >= 100_000 {
+            return Err(limit());
+        }
+        metas.try_reserve_exact(1).map_err(|_| limit())?;
+        metas.push(
+            attribute
+                .meta()
+                .ok_or_else(|| fault("original root attribute meta absent"))?,
+        );
+    }
+    let (enabled, metas) =
+        crate::syntax::attributes::effective_metas(metas, source.captured_macro_cfg()?)?;
+    if !enabled {
+        return Ok(BTreeSet::new());
+    }
+    let mut result = BTreeSet::new();
+    let mut bytes = 128usize;
+    for meta in metas {
+        let range: SourceRange = crate::syntax::ast_adapter::range(meta.syntax().text_range());
+        let mut rows = scan
+            .producers()
+            .iter()
+            .filter(|row| row.kind == DeclarationProducerKind::Attribute && row.range == range);
+        let row = rows
+            .next()
+            .ok_or_else(|| fault("exact original root meta producer absent"))?;
+        if rows.next().is_some()
+            || row.lexical_scope != root.identity
+            || row.scope != *scan.scope()
+            || row.scope.owner.is_some()
+            || !row.containers.is_empty()
+        {
+            return Err(fault(
+                "original root meta producer ownership is ambiguous or differs",
+            ));
+        }
+        bytes = bytes
+            .checked_add(std::mem::size_of::<Digest>() + 128)
+            .filter(|n| *n <= byte_limit)
+            .ok_or_else(limit)?;
+        if !result.insert(row.identity) {
+            return Err(fault("original root meta producer duplicated"));
+        }
+    }
+    Ok(result)
+}
+/// A negative Attribute-facet witness must come from an actual matched compiler
+/// world. Bang-only declarations do not become Attribute facets by spelling.
+pub(super) fn matched_attribute_facet<'a>(
+    source: &PreparedSourceView,
+    provider: &'a super::super::source_declarative::SourceDeclarative,
+) -> Result<Option<&'a BuiltinAttributeCatalog>, Diagnostic> {
+    if !source.same_publication(provider.module_source())
+        || source.selection() != provider.module_source().selection()
+    {
+        return Err(fault(
+            "original inert prefix provider belongs to another source publication",
+        ));
+    }
+    let Some(compiler) = provider.compiler.as_ref() else {
+        return Ok(None);
+    };
+    let Some(attributes) = compiler.attribute_catalog() else {
+        return Ok(None);
+    };
+    if compiler.runtime_prelude_unit(false)
+        != crate::facade::unit(&source.selection().outline.parse.profile, "core")
+        || compiler.runtime_catalog()?.is_none()
+    {
+        return Err(fault(
+            "original inert prefix compiler Attribute facet/profile differs",
+        ));
+    }
+    Ok(Some(attributes))
+}
+pub(super) fn revalidate(
+    source: &PreparedSourceView,
+    provider: &super::super::source_declarative::SourceDeclarative,
+    proof: &super::super::nested_inert::NestedInertProof,
+    namespaces: &crate::frontend::macro_names::MacroNamespaces,
+) -> Result<(), Diagnostic> {
+    if !capture(source, proof.scan(), 32 * 1024 * 1024)?.contains(&proof.producer()) {
+        return Err(fault(
+            "original inert proof is not attached to this exact root meta",
+        ));
+    }
+    let attributes = matched_attribute_facet(source, provider)?.ok_or_else(|| {
+        fault("original inert prefix compiler Attribute facet absent before sealing")
+    })?;
+    let expected = proof
+        .attribute_facet()
+        .ok_or_else(|| fault("original inert prefix has no selected Attribute-facet proof"))?;
+    proof.revalidate(source.captured_macro_blob()?, source.captured_macro_cfg()?)?;
+    let lookup = crate::service::source_attribute_requests::SourceAttributeSelection::cold_lookup(
+        source,
+        proof.scan(),
+        proof.producer(),
+        namespaces,
+    )?;
+    let actual = super::super::builtin_attributes::certify_inert_binding(
+        proof.name()?,
+        &lookup,
+        provider.procedural.as_deref(),
+        Some(attributes),
+    )?
+    .ok_or_else(|| fault("original inert prefix Attribute selection remains incomplete"))?;
+    if actual != expected {
+        return Err(fault(
+            "original inert prefix Attribute facet changed before sealing",
+        ));
+    }
+    Ok(())
+}
