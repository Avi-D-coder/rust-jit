+            .prepare_constant_publication(&proof, &image, c.wire(), &store)
+            .unwrap();
+        frame
+            .begin_constant_publication_chunks(p, &mut store, |frame| frame.fuel.charge())
+            .unwrap()
+    };
+    {
+        let c = CurrentConstantConstruction::capture_current(
+            &db,
+            &view,
+            &ready,
+            success(&parent),
+            Some((&child, success(&length))),
