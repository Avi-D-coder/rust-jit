+#[rustc_const_unstable(feature = "const_convert", issue = "143773")]
+const impl<T: ?Sized> Deref for &T {
+    type Target = T;
+
+    #[rustc_diagnostic_item = "noop_method_deref"]
+    fn deref(&self) -> &T {
+        self
+    }
+}
