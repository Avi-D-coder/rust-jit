+#[rustc_diagnostic_item = "Send"]
+#[diagnostic::on_unimplemented(
+    message = "`{Self}` cannot be sent between threads safely",
+    label = "`{Self}` cannot be sent between threads safely"
+)]
+pub unsafe auto trait Send {
+    // empty.
+}
