+//! Pure unchanged-header and entered-site components; no Box guest execution.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::key::OutlineKey,
+    source::{
+        changes::SourceSelection,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{
+        box_source_headers::{
+            BoxHeaderRole as Role, capture_box_headers, capture_unit_box_call,
+            capture_unit_box_deref,
+        },
+        parse::ParsedFile,
+        spans::SourceRange,
+    },
+};
+const BOXED: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/library/alloc/src/boxed.rs");
+const DEREF: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/library/core/src/ops/deref.rs");
+const UNIT: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/tests/ui/box/empty-alloc-deref-rvalue.rs");
+fn source_parse(
+    text: &str,
+    module: &[&str],
+    edition: u16,
+    cfg: &CfgSet,
+) -> (ParsedFile, SourceSelection) {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        profile,
+    )
+    .unwrap();
+    let source = SourceSelection {
+        path: SourcePath::new(format!("{}/src/{}.rs", module[0], module[1..].join("/"))).unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(module[0].as_bytes()),
+            module_path: module[1..].iter().map(|s| s.to_string()).collect(),
+            cfg: cfg.fingerprint(),
+        },
+    };
+    (parsed, source)
+}
+fn span(text: &str, part: &str) -> SourceRange {
+    let start = u32::try_from(text.find(part).unwrap()).unwrap();
+    SourceRange {
+        start,
+        end: start + u32::try_from(part.len()).unwrap(),
+    }
+}
+#[test]
+fn boxed_original_headers_retain_real_new_and_deref_member_impl_definition_contexts() {
+    let cfg = CfgSet::guest_default();
+    let (parsed, source) = source_parse(BOXED, &["alloc", "boxed"], 2024, &cfg);
+    let rows = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    let owned = rows.header(Role::OwnedBox).unwrap();
+    assert_eq!(owned.definition().declared_name, "Box");
+    assert_eq!(owned.definition().crate_key, source.outline.crate_key);
+    let new = rows.header(Role::NewImpl).unwrap();
+    assert_eq!(new.parameters(), "<T>");
+    assert_eq!(new.member("new").unwrap().signature(), "fnnew(x:T)->Self");
+    assert!(new.impl_source().is_some());
+    assert!(new.impl_header().is_some());
+    for (role, name, signature) in [
+        (Role::DerefImpl, "deref", "fnderef(&self)->&T"),
+        (
+            Role::DerefMutImpl,
+            "deref_mut",
+            "fnderef_mut(&mutself)->&mutT",
+        ),
+    ] {
+        let row = rows.header(role).unwrap();
+        let member = row.member(name).unwrap();
+        assert_eq!(member.signature(), signature);
+        assert_eq!(
+            member.definition().enclosing_impl,
+            Some(row.header().fingerprint())
+        );
+        assert_eq!(
+            member.body().unwrap().def_key,
+            member.definition().fingerprint()
+        );
+    }
+    // Identifying these headers alone grants neither compiler nor trait permission.
+}
+#[test]
+fn core_original_deref_headers_keep_distinct_lang_item_and_member_identities() {
+    let cfg = CfgSet::guest_default();
+    let (parsed, source) = source_parse(DEREF, &["core", "ops", "deref"], 2024, &cfg);
+    let rows = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    let shared = rows.header(Role::DerefTrait).unwrap();
+    let mutable = rows.header(Role::DerefMutTrait).unwrap();
+    assert_ne!(
+        shared.definition().fingerprint(),
+        mutable.definition().fingerprint()
+    );
+    assert_ne!(
+        shared.member("deref").unwrap().definition().fingerprint(),
+        mutable
+            .member("deref_mut")
+            .unwrap()
+            .definition()
+            .fingerprint()
+    );
+}
+#[test]
+fn boxed_disabled_new_declaration_is_omitted_under_actual_captured_cfg() {
+    let mut cfg = CfgSet::guest_default();
+    cfg.atoms.insert("no_global_oom_handling".into());
+    let (parsed, source) = source_parse(BOXED, &["alloc", "boxed"], 2024, &cfg);
+    let rows = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    assert!(rows.header(Role::OwnedBox).is_some());
+    assert!(rows.header(Role::NewImpl).is_none());
+}
+#[test]
+fn boxed_header_capture_does_not_force_cold_method_body_parse_damage() {
+    let text = "#[lang=\"owned_box\"] pub struct Box<T>(T); impl<T> Box<T> {pub fn new(x:T)->Self {let cold=; panic!();}}";
+    let cfg = CfgSet::guest_default();
+    let (parsed, source) = source_parse(text, &["alloc", "boxed"], 2024, &cfg);
+    assert!(!parsed.errors.is_empty());
+    let rows = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    assert_eq!(
+        rows.header(Role::NewImpl)
+            .unwrap()
+            .member("new")
+            .unwrap()
+            .signature(),
+        "fnnew(x:T)->Self"
+    );
+}
+#[test]
+fn user_box_spelling_without_owned_lang_item_marker_has_no_owned_box_fact() {
+    let cfg = CfgSet::guest_default();
+    let (parsed, source) = source_parse(
+        "pub struct Box<T>(T); impl<T> Box<T>{pub fn new(x:T)->Self {Self(x)}}",
+        &["user", "boxed"],
+        2024,
+        &cfg,
+    );
+    let rows = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    assert!(rows.header(Role::OwnedBox).is_none());
+    assert!(rows.header(Role::NewImpl).is_some());
+    let (other, selected) = source_parse(
+        "#[lang=\"owned_box\"] pub struct Box<T>(T); impl<T> Box<T>{pub fn new(x:T)->T{x}}",
+        &["alloc", "boxed"],
+        2024,
+        &cfg,
+    );
+    let other = capture_box_headers(&other, &selected, &cfg).unwrap();
+    assert_eq!(
+        other
+            .header(Role::NewImpl)
+            .unwrap()
+            .member("new")
+            .unwrap()
+            .signature(),
+        "fnnew(x:T)->T"
+    );
+}
+#[test]
+fn original_unit_box_call_and_projection_keep_distinct_exact_pcs_in_every_edition() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let cfg = CfgSet::guest_default();
+        let (parsed, source) = source_parse(UNIT, &["consumer", "root"], edition, &cfg);
+        let outline = parsed
+            .outline(
+                source.outline.crate_key,
+                source.outline.module_path.clone(),
+                &cfg,
+            )
+            .unwrap();
+        let body = outline
+            .items
+            .iter()
+            .find(|i| i.def_key.declared_name == "main")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap();
+        let call = capture_unit_box_call(&parsed, &source, body, span(UNIT, "Box::new(())"), &cfg)
+            .unwrap();
+        let deref =
+            capture_unit_box_deref(&parsed, &source, body, span(UNIT, "*Box::new(())"), &cfg)
+                .unwrap();
+        assert_eq!(call.source(), &source);
+        assert_ne!(call.pc(), deref.pc());
+        assert_eq!(deref.call().pc(), call.pc());
+        assert!(!deref.mutable_borrow());
+        assert!(call.local_frontiers().is_empty());
+    }
+}
+#[test]
+fn unit_box_source_site_keeps_mutable_projection_and_actual_local_namespace_frontier() {
+    let cfg = CfgSet::guest_default();
+    let text = "fn main(){struct Box;let _=&mut *Box::new(());}";
+    let (parsed, source) = source_parse(text, &["consumer", "root"], 2024, &cfg);
+    let outline = parsed
+        .outline(
+            source.outline.crate_key,
+            source.outline.module_path.clone(),
+            &cfg,
+        )
+        .unwrap();
+    let body = outline
+        .items
+        .iter()
+        .find(|i| i.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let deref =
+        capture_unit_box_deref(&parsed, &source, body, span(text, "*Box::new(())"), &cfg).unwrap();
+    assert!(deref.mutable_borrow());
+    assert!(!deref.call().local_frontiers().is_empty());
+}
+#[test]
+fn box_site_rejects_foreign_profile_cfg_subranges_and_unproven_nonunit_pointee() {
+    let cfg = CfgSet::guest_default();
+    let text = "fn main(){let _=Box::new(3u8);}";
+    let (parsed, source) = source_parse(text, &["consumer", "root"], 2024, &cfg);
+    let outline = parsed
+        .outline(
+            source.outline.crate_key,
+            source.outline.module_path.clone(),
+            &cfg,
+        )
+        .unwrap();
+    let body = outline
+        .items
+        .iter()
+        .find(|i| i.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    assert!(
+        capture_unit_box_call(&parsed, &source, body, span(text, "Box::new(3u8)"), &cfg).is_err()
+    );
+    let cfg = CfgSet::guest_default();
+    let (parsed, source) = source_parse(UNIT, &["consumer", "root"], 2024, &cfg);
+    let outline = parsed
+        .outline(
+            source.outline.crate_key,
+            source.outline.module_path.clone(),
+            &cfg,
+        )
+        .unwrap();
+    let body = outline
+        .items
+        .iter()
+        .find(|i| i.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let mut wrong = source.clone();
+    wrong.outline.parse.profile.edition = 2018;
+    assert!(
+        capture_unit_box_call(&parsed, &wrong, body, span(UNIT, "Box::new(())"), &cfg).is_err()
+    );
+    let mut changed = cfg.clone();
+    changed.atoms.insert("different_source_cfg".into());
+    assert!(
+        capture_unit_box_call(&parsed, &source, body, span(UNIT, "Box::new(())"), &changed)
+            .is_err()
+    );
+    assert!(capture_unit_box_call(&parsed, &source, body, span(UNIT, "new(())"), &cfg).is_err());
+}
+
+#[test]
+fn boxed_allocator_default_is_captured_from_real_generic_syntax_instead_of_assumed() {
+    let cfg = CfgSet::guest_default();
+    let (parsed, source) = source_parse(BOXED, &["alloc", "boxed"], 2024, &cfg);
+    let original = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    assert_eq!(
+        original.header(Role::OwnedBox).unwrap().default_allocator(),
+        Some("Global")
+    );
+    let text = "#[lang=\"owned_box\"] pub struct Box<T:?Sized,A:Allocator=Other>(T,A);";
+    let (parsed, source) = source_parse(text, &["alloc", "boxed"], 2024, &cfg);
+    let changed = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    assert_eq!(
+        changed.header(Role::OwnedBox).unwrap().default_allocator(),
+        Some("Other")
+    );
+    assert_ne!(
+        changed.header(Role::OwnedBox).unwrap().fingerprint(),
+        original.header(Role::OwnedBox).unwrap().fingerprint()
+    );
+}
