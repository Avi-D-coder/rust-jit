+#[stable(feature = "rust1", since = "1.0.0")]
+impl<T: ?Sized> !DerefMut for &T {}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+#[rustc_const_unstable(feature = "const_convert", issue = "143773")]
+const impl<T: ?Sized> Deref for &mut T {
+    type Target = T;
