--- /dev/null
+++ b/crates/lrr/src/frontend/box_source_admission.rs
@@ -0,0 +1,900 @@
+//! Genuine source eligibility for managed Box. This is not runtime admission:
+//! absent compiler Box contracts/goals/preludes stay typed prerequisites.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{DependencyStamp, InputKey, InputValue},
+        key::{BucketKey, QueryKey, SealedNameKey},
+        memo::Database,
+        poll::QueryPoll,
+        provider::SyntaxProvider,
+        seals::{SealDomain, SealKey},
+    },
+    frontend::names::{NameLookup, NameNamespaces},
+    ir::op::PrimitiveType,
+    source::{
+        changes::{PreparedSourceView, SourceSelection},
+        manifest::{DefKey, Namespace},
+        value_library_selection::PreparedValueLibrarySelection,
+    },
+    syntax::box_source_headers::{BoxHeaderRole as Role, BoxSourceHeaders, UnitBoxCallSite},
+    traits::term::{GenericArg, TraitRef, TyTerm},
+};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    sync::Arc,
+};
+const MAX_BYTES: usize = 32 << 20;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-BOX-SOURCE", message.into())
+}
+fn limit() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "Box source eligibility budget".into(),
+    )
+}
+/// Privately minted from actual current selected source/header/catalog records.
+/// No public constructor, runtime TypeId, arena handle or native generation.
+pub(crate) struct CurrentBoxSourceCatalog {
+    library: Arc<PreparedValueLibrarySelection>,
+    consumer: SourceSelection,
+    query_revision: u64,
+    source_revision: u64,
+    seal: SealKey,
+    publication: Digest,
+    headers: Vec<Arc<BoxSourceHeaders>>,
+    roles: BTreeMap<Role, (usize, usize)>,
+    dependencies: Vec<DependencyStamp>,
+    unknown: Vec<Digest>,
+    bytes: usize,
+}
+/// Source-only requirement owns actual definition/member/pointee/goal identities.
+/// It is deliberately not an executable Selected/Admitted Box operation.
+#[derive(Debug, Clone, Copy)]
+pub(crate) enum RequiredBoxOperation {
+    New,
+    SharedProjection,
+    MutableProjection,
+}
+pub(crate) struct RequiredBoxCompilerFacet {
+    operation: RequiredBoxOperation,
+    source_catalog: Digest,
+    source_revision: u64,
+    query_revision: u64,
+    caller: SourceSelection,
+    body: crate::source::manifest::BodyKey,
+    pc: crate::source::manifest::PcKey,
+    range: crate::syntax::spans::SourceRange,
+    box_definition: DefKey,
+    implementation: Digest,
+    member: DefKey,
+    source_result: TyTerm,
+    pointee: TyTerm,
+    required_goals: Vec<TraitRef>,
+    unknown_candidates: Vec<Digest>,
+    dependencies: Vec<DependencyStamp>,
+}
+impl RequiredBoxCompilerFacet {
+    pub(crate) fn source_result(&self) -> &TyTerm {
+        &self.source_result
+    }
+    pub(crate) fn pointee(&self) -> &TyTerm {
+        &self.pointee
+    }
+    pub(crate) fn member(&self) -> &DefKey {
+        &self.member
+    }
+    pub(crate) fn required_goals(&self) -> &[TraitRef] {
+        &self.required_goals
+    }
+    pub(crate) fn unknown_candidates(&self) -> &[Digest] {
+        &self.unknown_candidates
+    }
+    pub(crate) fn dependencies(&self) -> &[DependencyStamp] {
+        &self.dependencies
+    }
+}
+pub(crate) enum BoxSourceRequirement {
+    CompilerFacet(Box<RequiredBoxCompilerFacet>),
+    TypePreludeRequired,
+    QualifiedTypeScopeRequired,
+    LexicalTypeScopeRequired,
+}
+impl CurrentBoxSourceCatalog {
+    pub(crate) fn capture_current(
+        db: &Database,
+        source: &PreparedSourceView,
+        graph: &NameNamespaces,
+        headers: &[Arc<BoxSourceHeaders>],
+        seal: &SealKey,
+        byte_limit: usize,
+    ) -> Result<Self, Diagnostic> {
+        source.require_original_hygiene()?;
+        source.require_declaration_syntax()?;
+        seal.validate()?;
+        if headers.len() > 10 || byte_limit > MAX_BYTES {
+            return Err(limit());
+        }
+        let selection_key = InputKey::ValueLibrarySelection(source.selection().outline.crate_key);
+        let (InputValue::ValueLibrarySelection(library),publication)=db.published_input(&selection_key).ok_or_else(||fault("actual selected live library publication is required; compiler macro/prelude/native facets are insufficient"))? else{return Err(fault("selected source-library input variant differs"))};
+        library.validate_current(db, source)?;
+        let alloc = library
+            .allocation_provider()
+            .ok_or_else(|| fault("actual std→alloc→core source selection is absent"))?
+            .outline
+            .crate_key;
+        let core = library.provider(false).outline.crate_key;
+        let (InputValue::DiscoverySeal(input), seal_stamp) = db
+            .published_input(&InputKey::DiscoverySeal(seal.clone()))
+            .ok_or_else(|| fault("actual complete Box impl catalog publication is absent"))?
+        else {
+            return Err(fault("Box impl catalog input variant differs"));
+        };
+        if !matches!(seal.domain, SealDomain::ImplCatalog { .. })
+            || input.seal.key() != *seal
+            || input.scope.is_some()
+            || input.seal.unresolved_frontiers() != 0
+            || !input.declaration_inventory.pending_producers().is_empty()
+        {
+            return Err(fault(
+                "Box source requires actual complete impl catalog certificate",
+            ));
+        }
+        if !matches!(db.published_input(&InputKey::ExpansionEpoch),Some((InputValue::ExpansionEpoch(epoch),_))if *epoch==seal.epoch)
+            || !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(deps),_))if deps.fingerprint()==input.source_dependencies)
+        {
+            return Err(fault("Box source catalog epoch/dependency world differs"));
+        }
+        let count = input
+            .compiler_inputs
+            .len()
+            .checked_add(200)
+            .filter(|n| *n <= 100_000)
+            .ok_or_else(limit)?;
+        count
+            .checked_mul(std::mem::size_of::<DependencyStamp>())
+            .and_then(|n| n.checked_add(std::mem::size_of::<Self>() + library.metadata_bytes()))
+            .filter(|n| *n <= byte_limit)
+            .ok_or_else(limit)?;
+        let mut dependencies = Vec::new();
+        dependencies.try_reserve_exact(count).map_err(|_| limit())?;
+        dependencies.push(DependencyStamp::Input {
+            key: selection_key,
+            fingerprint: publication,
+        });
+        dependencies.push(DependencyStamp::Input {
+            key: InputKey::DiscoverySeal(seal.clone()),
+            fingerprint: seal_stamp,
+        });
+        for (key, expected) in &input.compiler_inputs {
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != *expected)
+            {
+                return Err(fault("Box sealed compiler/source input changed"));
+            }
+            dependencies.push(DependencyStamp::Input {
+                key: key.clone(),
+                fingerprint: *expected,
+            });
+        }
+        for key in [InputKey::ExpansionEpoch, InputKey::SourceDependencies] {
+            let (_, fingerprint) = db
+                .published_input(&key)
+                .ok_or_else(|| fault("Box world input absent"))?;
+            dependencies.push(DependencyStamp::Input { key, fingerprint });
+        }
+        let mut roles = BTreeMap::new();
+        let mut retained = Vec::new();
+        retained
+            .try_reserve_exact(headers.len())
+            .map_err(|_| limit())?;
+        let mut bytes = std::mem::size_of::<Self>()
+            .checked_add(library.metadata_bytes())
+            .ok_or_else(limit)?;
+        for (file_index, file) in headers.iter().enumerate() {
+            bytes = bytes
+                .checked_add(file.metadata_bytes())
+                .filter(|n| *n <= byte_limit)
+                .ok_or_else(limit)?;
+            let selected = file.source();
+            if library.observed_source(&selected.path) != Some(selected.outline.parse.content)
+                || !input.sources.contains(selected)
+            {
+                return Err(fault(
+                    "Box source file is not an actually selected sealed library observation",
+                ));
+            }
+            graph.require_source(selected, file.outline())?;
+            for key in [
+                InputKey::CapturedSource(selected.location_identity()),
+                InputKey::CrateCfg(selected.outline.crate_key),
+            ] {
+                let (value, fingerprint) = db
+                    .published_input(&key)
+                    .ok_or_else(|| fault("Box owning source/cfg input absent"))?;
+                let valid = match value {
+                    InputValue::CapturedSource(current) => current == selected,
+                    InputValue::CrateCfg(cfg) => cfg.fingerprint() == selected.outline.cfg,
+                    _ => false,
+                };
+                if !valid {
+                    return Err(fault("Box source/cfg attachment differs"));
+                }
+                dependencies.push(DependencyStamp::Input { key, fingerprint });
+            }
+            for (row_index, row) in file.headers().iter().enumerate() {
+                let (unit, module): (_, &[&str]) = match row.role() {
+                    Role::OwnedBox | Role::NewImpl | Role::DerefImpl | Role::DerefMutImpl => {
+                        (alloc, &["boxed"])
+                    }
+                    Role::Global | Role::GlobalAllocatorImpl => (alloc, &["alloc"]),
+                    Role::DerefTrait | Role::DerefMutTrait => (core, &["ops", "deref"]),
+                    Role::Allocator => (core, &["alloc"]),
+                    Role::Sized => (core, &["marker"]),
+                };
+                if row.definition().crate_key != unit
+                    || row
+                        .definition()
+                        .module_path
+                        .iter()
+                        .map(String::as_str)
+                        .ne(module.iter().copied())
+                    || selected.outline.parse.profile.edition != 2024
+                    || selected.outline.parse.profile.semantics
+                        != source.selection().outline.parse.profile.semantics
+                {
+                    return Err(fault(
+                        "Box declaration defining library unit/module/edition/profile differs",
+                    ));
+                }
+                let declarations =
+                    std::iter::once((row.definition(), row.header(), row.range(), None)).chain(
+                        row.members().iter().map(|member| {
+                            (
+                                member.definition(),
+                                member.header(),
+                                member.range(),
+                                member.body(),
+                            )
+                        }),
+                    );
+                for (definition, header, range, body) in declarations {
+                    let id = definition.fingerprint();
+                    for key in [
+                        InputKey::DefinitionSource(id),
+                        InputKey::DefinitionHeader(id),
+                        InputKey::DeclarationContext(id),
+                    ] {
+                        let (value, fingerprint) = db.published_input(&key).ok_or_else(|| {
+                            fault("actual Box declaration/member publication absent")
+                        })?;
+                        let valid = match value {
+                            InputValue::DefinitionSource(parse) => parse == &selected.outline.parse,
+                            InputValue::DefinitionHeader(current) => current == header,
+                            InputValue::DeclarationContext(context) => {
+                                context.range == range
+                                    && context.scope.crate_key == definition.crate_key
+                                    && context.scope.module_path == definition.module_path
+                                    && file.outline().items.iter().any(|item| {
+                                        item.def_key == *definition
+                                            && item.scope == context.scope
+                                            && item.declaration_span == range
+                                    })
+                            }
+                            _ => false,
+                        };
+                        if !valid {
+                            return Err(fault("Box exact source/header/context differs"));
+                        }
+                        dependencies.push(DependencyStamp::Input { key, fingerprint });
+                    }
+                    if let Some(body) = body {
+                        let key = InputKey::DefinitionBody(id);
+                        let (InputValue::DefinitionBody(current), fingerprint) = db
+                            .published_input(&key)
+                            .ok_or_else(|| fault("Box member body attachment absent"))?
+                        else {
+                            return Err(fault("Box body input variant differs"));
+                        };
+                        if current != body {
+                            return Err(fault("Box body attachment differs"));
+                        }
+                        dependencies.push(DependencyStamp::Input { key, fingerprint });
+                    }
+                }
+                if let Some(implementation) = row.impl_source() {
+                    if !input
+                        .declaration_inventory
+                        .headers()
+                        .iter()
+                        .any(|candidate| {
+                            candidate.identity == implementation
+                                && Some(candidate.header_identity) == row.impl_header()
+                                && candidate.range == row.range()
+                                && candidate.scope.crate_key == row.definition().crate_key
+                                && candidate.scope.module_path == row.definition().module_path
+                        })
+                        || !input
+                            .declaration_inventory
+                            .scan_handles()
+                            .iter()
+                            .any(|scan| {
+                                scan.parse() == &selected.outline.parse
+                                    && scan.cfg() == selected.outline.cfg
+                                    && scan.path() == &selected.path
+                                    && scan
+                                        .impls()
+                                        .iter()
+                                        .any(|candidate| candidate.identity == implementation)
+                            })
+                    {
+                        return Err(fault(
+                            "Box implementation is not active in the actual sealed source inventory",
+                        ));
+                    }
+                }
+                if roles.insert(row.role(), (file_index, row_index)).is_some() {
+                    return Err(fault("Box library role ambiguous"));
+                }
+            }
+            retained.push(file.clone());
+        }
+        let known = retained
+            .iter()
+            .flat_map(|file| file.headers())
+            .filter_map(|row| row.impl_source())
+            .collect::<BTreeSet<_>>();
+        let candidates = input.declaration_inventory.headers().len();
+        candidates
+            .checked_mul(32)
+            .and_then(|n| n.checked_add(bytes))
+            .filter(|n| candidates <= 100_000 && *n <= byte_limit)
+            .ok_or_else(limit)?;
+        let mut unknown = Vec::new();
+        unknown
+            .try_reserve_exact(input.declaration_inventory.headers().len())
+            .map_err(|_| limit())?;
+        for candidate in input.declaration_inventory.headers() {
+            if !known.contains(&candidate.identity) {
+                unknown.push(candidate.identity)
+            }
+        }
+        unknown.sort_unstable();
+        unknown.dedup();
+        bytes = bytes
+            .checked_add(
+                dependencies
+                    .capacity()
+                    .checked_mul(std::mem::size_of::<DependencyStamp>())
+                    .ok_or_else(limit)?,
+            )
+            .and_then(|n| n.checked_add(unknown.capacity().checked_mul(32)?))
+            .and_then(|n| n.checked_add(roles.len().checked_mul(128)?))
+            .ok_or_else(limit)?;
+        for stamp in &dependencies {
+            bytes = bytes
+                .checked_add(stamp.heap_bytes())
+                .filter(|n| *n <= byte_limit)
+                .ok_or_else(limit)?;
+        }
+        let mut current = Self {
+            library: library.clone(),
+            consumer: source.selection().clone(),
+            query_revision: db.revision(),
+            source_revision: db.source_revision(),
+            seal: seal.clone(),
+            publication,
+            headers: retained,
+            roles,
+            dependencies,
+            unknown,
+            bytes,
+        };
+        current.require_contracts()?;
+        current.require_source_symbols(db, graph, byte_limit)?;
+        Ok(current)
+    }
+    fn header(
+        &self,
+        role: Role,
+    ) -> Result<&crate::syntax::box_source_headers::BoxSourceHeader, Diagnostic> {
+        let (file, row) = self
+            .roles
+            .get(&role)
+            .copied()
+            .ok_or_else(|| fault("required actual Box source header absent"))?;
+        self.headers
+            .get(file)
+            .and_then(|file| file.headers().get(row))
+            .ok_or_else(|| fault("Box role location differs"))
+    }
+    fn require_contracts(&self) -> Result<(), Diagnostic> {
+        if self.header(Role::OwnedBox)?.default_allocator() != Some("Global")
+            || self.header(Role::OwnedBox)?.allocator_contract() != Some("?Sized|Allocator|")
+        {
+            return Err(fault(
+                "actual Box allocator default is not the source-resolved Global contract",
+            ));
+        }
+        for (role, name, signature, parameters) in [
+            (Role::NewImpl, "new", "fnnew(x:T)->Self", "<T>"),
+            (
+                Role::DerefImpl,
+                "deref",
+                "fnderef(&self)->&T",
+                "<T:?Sized,A:Allocator>",
+            ),
+            (
+                Role::DerefMutImpl,
+                "deref_mut",
+                "fnderef_mut(&mutself)->&mutT",
+                "<T:?Sized,A:Allocator>",
+            ),
+        ] {
+            let row = self.header(role)?;
+            if row.parameters() != parameters
+                || row.member(name)?.signature() != signature
+                || row.impl_source().is_none()
+                || row.impl_header().is_none()
+            {
+                return Err(fault(
+                    "Box source method/signature/generic contract differs",
+                ));
+            }
+        }
+        for role in [
+            Role::OwnedBox,
+            Role::Global,
+            Role::Allocator,
+            Role::GlobalAllocatorImpl,
+            Role::Sized,
+            Role::DerefTrait,
+            Role::DerefMutTrait,
+        ] {
+            self.header(role)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut e = StableEncoder::new("lrr/v1/current-box-source-catalog");
+        e.digest(self.publication);
+        e.record(&self.seal);
+        for file in &self.headers {
+            e.string(file.source().path.as_str());
+            e.record(&QueryKey::Outline(file.source().outline.clone()));
+            for row in file.headers() {
+                e.record(row)
+            }
+        }
+        e.sequence(&self.dependencies, |e, stamp| e.record(stamp));
+        e.finish()
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+    ) -> Result<(), Diagnostic> {
+        if db.revision() != self.query_revision
+            || db.source_revision() != self.source_revision
+            || source.selection() != &self.consumer
+        {
+            return Err(fault(
+                "Box source proof publication/revision is stale; recapture required",
+            ));
+        }
+        self.library.validate_current(db, source)?;
+        for stamp in &self.dependencies {
+            let DependencyStamp::Input { key, fingerprint } = stamp else {
+                return Err(fault("Box catalog requires captured input dependencies"));
+            };
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != *fingerprint)
+            {
+                return Err(fault("Box source input proof is stale"));
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn require_unit_new(
+        &self,
+        db: &mut Database,
+        source: &PreparedSourceView,
+        site: &UnitBoxCallSite,
+        scope_seal: &SealKey,
+        byte_limit: usize,
+    ) -> QueryPoll<BoxSourceRequirement> {
+        let prepare = || -> Result<(), Diagnostic> {
+            self.revalidate(db, source)?;
+            if site.source() != source.selection()
+                || site.body().entry_blocked
+                || site.pc()
+                    != &source
+                        .index_body(
+                            source.selection(),
+                            site.body(),
+                            crate::syntax::body_index::BodyIndexLimits::default(),
+                        )?
+                        .pc(site.node(), crate::ir::pc::Phase::Entry)?
+            {
+                return Err(fault("Box reached Unit caller body/source/PC differs"));
+            }
+            Ok(())
+        };
+        if let Err(error) = prepare() {
+            return QueryPoll::Ready(Err(error));
+        }
+        if !site.local_frontiers().is_empty() {
+            return QueryPoll::Ready(Ok(BoxSourceRequirement::LexicalTypeScopeRequired));
+        }
+        let [crate::syntax::imports::ImportSegment::Name(name)] = site.type_path() else {
+            return QueryPoll::Ready(Ok(BoxSourceRequirement::QualifiedTypeScopeRequired));
+        };
+        if scope_seal.unit_graph != self.seal.unit_graph
+            || scope_seal.epoch != self.seal.epoch
+            || scope_seal.domain
+                != (SealDomain::Scope {
+                    id: site.scope().fingerprint(),
+                    namespace: Namespace::Type,
+                })
+        {
+            return QueryPoll::Ready(Err(fault("Box caller Type scope seal differs")));
+        }
+        let key = QueryKey::SealedName(Box::new(SealedNameKey {
+            seal: scope_seal.clone(),
+            bucket: BucketKey {
+                scope: site.scope().clone(),
+                namespace: Namespace::Type,
+                name: name.clone(),
+            },
+        }));
+        let outcome = match db.fetch(&SyntaxProvider, key.clone()) {
+            QueryPoll::Ready(Ok(outcome)) => outcome,
+            QueryPoll::Ready(Err(error)) => return QueryPoll::Ready(Err(error)),
+            QueryPoll::NeedInput(request) => return QueryPoll::NeedInput(request),
+        };
+        let crate::db::value::QueryValue::SealedName {
+            key: actual,
+            lookup: found,
+        } = outcome.value.as_ref()
+        else {
+            return QueryPoll::Ready(Err(fault("Box source name query variant differs")));
+        };
+        if actual.as_ref()
+            != match &key {
+                QueryKey::SealedName(key) => key.as_ref(),
+                _ => unreachable!(),
+            }
+            || !outcome.cacheable
+            || db.memo(&key).is_none_or(|memo| {
+                memo.verified_revision != db.revision()
+                    || memo.fingerprint != outcome.fingerprint
+                    || !Arc::ptr_eq(&memo.value, &outcome.value)
+            })
+        {
+            return QueryPoll::Ready(Err(fault(
+                "Box Type name is not its genuine current memo outcome",
+            )));
+        }
+        if *found == NameLookup::Absent {
+            return QueryPoll::Ready(Ok(BoxSourceRequirement::TypePreludeRequired));
+        }
+        let boxed = match self.header(Role::OwnedBox) {
+            Ok(row) => row,
+            Err(error) => return QueryPoll::Ready(Err(error)),
+        };
+        if !matches!(found,NameLookup::Defined(definition)if definition.namespace==Namespace::Type&&definition.identity==boxed.definition().fingerprint()&&definition.defining_unit==boxed.definition().crate_key&&definition.definition_edition==2024)
+        {
+            return QueryPoll::Ready(Err(fault(
+                "Box name is shadowed/ambiguous/foreign; spelling cannot select storage",
+            )));
+        }
+        let prepare = || -> Result<BoxSourceRequirement, Diagnostic> {
+            self.revalidate(db, source)?;
+            let new = self.header(Role::NewImpl)?;
+            let member = new.member("new")?;
+            let pointee = TyTerm::Primitive(PrimitiveType::Unit);
+            let global = TyTerm::Nominal(
+                self.header(Role::Global)?.definition().fingerprint(),
+                vec![],
+            );
+            let source_result = TyTerm::Nominal(
+                boxed.definition().fingerprint(),
+                vec![
+                    GenericArg::Type(pointee.clone()),
+                    GenericArg::Type(global.clone()),
+                ],
+            );
+            let required_goals = vec![
+                TraitRef {
+                    trait_key: self.header(Role::Sized)?.definition().fingerprint(),
+                    self_ty: pointee.clone(),
+                    args: vec![],
+                },
+                TraitRef {
+                    trait_key: self.header(Role::Allocator)?.definition().fingerprint(),
+                    self_ty: global,
+                    args: vec![],
+                },
+            ];
+            let count = self
+                .dependencies
+                .len()
+                .checked_add(1)
+                .filter(|n| *n <= 100_000)
+                .ok_or_else(limit)?;
+            // Conservative complete bound includes a second copy of all retained
+            // catalog/dependency/definition/unknown metadata plus packet-owned
+            // caller/query/term storage. Shared source bytes are never authority.
+            self.bytes
+                .checked_mul(2)
+                .and_then(|n| n.checked_add(std::mem::size_of::<RequiredBoxCompilerFacet>()))
+                .and_then(|n| n.checked_add(site.source().metadata_bytes().ok()?))
+                .and_then(|n| n.checked_add(key.heap_bytes()))
+                .and_then(|n| {
+                    n.checked_add(
+                        16 * std::mem::size_of::<TyTerm>() + 4 * std::mem::size_of::<TraitRef>(),
+                    )
+                })
+                .filter(|n| *n <= byte_limit.min(MAX_BYTES))
+                .ok_or_else(limit)?;
+            let mut dependencies = Vec::new();
+            dependencies.try_reserve_exact(count).map_err(|_| limit())?;
+            dependencies.extend(self.dependencies.iter().cloned());
+            dependencies.push(DependencyStamp::Query {
+                key,
+                fingerprint: outcome.fingerprint,
+            });
+            Ok(BoxSourceRequirement::CompilerFacet(Box::new(
+                RequiredBoxCompilerFacet {
+                    operation: RequiredBoxOperation::New,
+                    source_catalog: self.identity(),
+                    source_revision: self.source_revision,
+                    query_revision: self.query_revision,
+                    caller: self.consumer.clone(),
+                    body: site.body().key(),
+                    pc: site.pc().clone(),
+                    range: site.range(),
+                    box_definition: boxed.definition().clone(),
+                    implementation: new
+                        .impl_source()
+                        .ok_or_else(|| fault("actual Box new impl missing"))?,
+                    member: member.definition().clone(),
+                    source_result,
+                    pointee,
+                    required_goals,
+                    unknown_candidates: self.unknown.clone(),
+                    dependencies,
+                },
+            )))
+        };
+        QueryPoll::Ready(prepare())
+    }
+}
+#[cfg(test)]
+#[path = "box_source_admission_tests.rs"]
+mod tests;
+
+impl CurrentBoxSourceCatalog {
+    fn require_source_symbols(
+        &mut self,
+        db: &Database,
+        graph: &NameNamespaces,
+        byte_limit: usize,
+    ) -> Result<(), Diagnostic> {
+        for (role, name, wanted_role) in [
+            (Role::OwnedBox, "Allocator", Role::Allocator),
+            (Role::OwnedBox, "Global", Role::Global),
+            (Role::NewImpl, "Box", Role::OwnedBox),
+            (Role::DerefImpl, "Box", Role::OwnedBox),
+            (Role::DerefImpl, "Deref", Role::DerefTrait),
+            (Role::DerefImpl, "Allocator", Role::Allocator),
+            (Role::DerefMutImpl, "Box", Role::OwnedBox),
+            (Role::DerefMutImpl, "DerefMut", Role::DerefMutTrait),
+            (Role::DerefMutImpl, "Allocator", Role::Allocator),
+            (Role::DerefMutTrait, "Deref", Role::DerefTrait),
+            (Role::GlobalAllocatorImpl, "Allocator", Role::Allocator),
+            (Role::GlobalAllocatorImpl, "Global", Role::Global),
+        ] {
+            let from = self.header(role)?;
+            let wanted = self.header(wanted_role)?.definition();
+            let scope = crate::syntax::outline::ScopeKey {
+                crate_key: from.definition().crate_key,
+                module_path: from.definition().module_path.clone(),
+                owner: None,
+            };
+            let scope_key = SealKey {
+                domain: SealDomain::Scope {
+                    id: scope.fingerprint(),
+                    namespace: Namespace::Type,
+                },
+                unit_graph: self.seal.unit_graph,
+                epoch: self.seal.epoch,
+            };
+            let key = InputKey::DiscoverySeal(scope_key.clone());
+            let (InputValue::DiscoverySeal(input), stamp) =
+                db.published_input(&key).ok_or_else(|| {
+                    fault("actual defining-module Type scope certificate is required")
+                })?
+            else {
+                return Err(fault("Box header Type scope input variant differs"));
+            };
+            let certified = input
+                .scope
+                .as_ref()
+                .ok_or_else(|| fault("Box defining-module certified scope absent"))?;
+            if input.seal.key() != scope_key
+                || input.seal.unresolved_frontiers() != 0
+                || !input.declaration_inventory.pending_producers().is_empty()
+                || !input
+                    .sources
+                    .contains(self.headers[self.roles[&role].0].source())
+                || certified.scope != scope
+                || certified.namespace != Namespace::Type
+                || certified.edition != 2024
+                || !matches!(db.published_input(&InputKey::SourceDependencies), Some((InputValue::SourceDependencies(deps), _)) if deps.fingerprint() == input.source_dependencies)
+            {
+                return Err(fault(
+                    "Box defining-module namespace certificate/source/context differs",
+                ));
+            }
+            for (input_key, expected) in &input.compiler_inputs {
+                if db
+                    .published_input(input_key)
+                    .is_none_or(|(_, actual)| actual != *expected)
+                {
+                    return Err(fault("Box defining-module source/compiler input changed"));
+                }
+            }
+            let lookup = certified.lookup(&BucketKey {
+                scope: scope.clone(),
+                namespace: Namespace::Type,
+                name: name.into(),
+            })?;
+            if lookup != graph.lookup_unqualified(Namespace::Type, name, &scope, 2024, None)?
+                || !matches!(lookup,NameLookup::Defined(found)if found.identity==wanted.fingerprint()&&found.defining_unit==wanted.crate_key&&found.definition_edition==2024)
+            {
+                return Err(fault(
+                    "Box symbol is unresolved/shadowed/foreign; no guessed default allocator/trait",
+                ));
+            }
+            self.bytes = self
+                .bytes
+                .checked_add(std::mem::size_of::<DependencyStamp>() + key.heap_bytes())
+                .filter(|n| *n <= byte_limit)
+                .ok_or_else(limit)?;
+            self.dependencies
+                .try_reserve_exact(1)
+                .map_err(|_| limit())?;
+            self.dependencies.push(DependencyStamp::Input {
+                key,
+                fingerprint: stamp,
+            });
+        }
+        Ok(())
+    }
+}
+impl StableEncode for RequiredBoxCompilerFacet {
+    const DOMAIN: &'static str = "lrr/v1/required-source-box-compiler-facet";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.u32(match self.operation {
+            RequiredBoxOperation::New => 0,
+            RequiredBoxOperation::SharedProjection => 1,
+            RequiredBoxOperation::MutableProjection => 2,
+        });
+        e.digest(self.source_catalog);
+        e.u64(self.source_revision);
+        e.u64(self.query_revision);
+        e.string(self.caller.path.as_str());
+        e.record(&QueryKey::Outline(self.caller.outline.clone()));
+        e.record(&self.body);
+        e.record(&self.pc);
+        e.u32(self.range.start);
+        e.u32(self.range.end);
+        e.record(&self.box_definition);
+        e.digest(self.implementation);
+        e.record(&self.member);
+        e.record(&self.source_result);
+        e.record(&self.pointee);
+        e.sequence(&self.required_goals, |e, g| e.record(g));
+        e.sequence(&self.unknown_candidates, |e, d| e.digest(*d));
+        e.sequence(&self.dependencies, |e, d| e.record(d));
+    }
+}
+impl RequiredBoxCompilerFacet {
+    pub(crate) fn revalidate_source(
+        &self,
+        db: &Database,
+        catalog: &CurrentBoxSourceCatalog,
+        source: &PreparedSourceView,
+    ) -> Result<(), Diagnostic> {
+        catalog.revalidate(db, source)?;
+        if self.source_catalog != catalog.identity()
+            || self.query_revision != db.revision()
+            || self.source_revision != db.source_revision()
+            || &self.caller != source.selection()
+        {
+            return Err(fault("required Box source packet is stale/foreign"));
+        }
+        for stamp in &self.dependencies {
+            let current = match stamp {
+                DependencyStamp::Input { key, fingerprint } => db
+                    .published_input(key)
+                    .is_some_and(|(_, actual)| actual == *fingerprint),
+                DependencyStamp::Query { key, fingerprint } => db.memo(key).is_some_and(|memo| {
+                    memo.verified_revision == db.revision() && memo.fingerprint == *fingerprint
+                }),
+            };
+            if !current {
+                return Err(fault("required Box source/query dependency changed"));
+            }
+        }
+        Ok(())
+    }
+}
+
+impl CurrentBoxSourceCatalog {
+    /// This only captures the real source projection contract. It does not mint
+    /// a selected Deref trait witness or bypass the required compiler Box facet.
+    pub(crate) fn require_unit_projection(
+        &self,
+        db: &mut Database,
+        source: &PreparedSourceView,
+        site: &crate::syntax::box_source_headers::UnitBoxDerefSite,
+        scope_seal: &SealKey,
+        byte_limit: usize,
+    ) -> QueryPoll<BoxSourceRequirement> {
+        let mut packet =
+            match self.require_unit_new(db, source, site.call(), scope_seal, byte_limit) {
+                QueryPoll::Ready(Ok(BoxSourceRequirement::CompilerFacet(packet))) => packet,
+                other => return other,
+            };
+        let prepare = || -> Result<BoxSourceRequirement, Diagnostic> {
+            packet.revalidate_source(db, self, source)?;
+            let index = source.index_body(
+                source.selection(),
+                site.call().body(),
+                crate::syntax::body_index::BodyIndexLimits::default(),
+            )?;
+            if index.pc(site.node(), crate::ir::pc::Phase::Entry)? != *site.pc() {
+                return Err(fault("Box projection current source PC differs"));
+            }
+            let role = if site.mutable_borrow() {
+                Role::DerefMutImpl
+            } else {
+                Role::DerefImpl
+            };
+            let name = if site.mutable_borrow() {
+                "deref_mut"
+            } else {
+                "deref"
+            };
+            let row = self.header(role)?;
+            packet.operation = if site.mutable_borrow() {
+                RequiredBoxOperation::MutableProjection
+            } else {
+                RequiredBoxOperation::SharedProjection
+            };
+            packet.source_result = packet.pointee.clone();
+            packet.pc = site.pc().clone();
+            packet.range = site.range();
+            packet.implementation = row
+                .impl_source()
+                .ok_or_else(|| fault("actual Box projection implementation source absent"))?;
+            packet.member = row.member(name)?.definition().clone();
+            // Operator Box projection still needs the compiler-owned lang-item
+            // contract. Explicit member calls additionally require actual goal
+            // selection/Target normalization. No goal is declared successful.
+            Ok(BoxSourceRequirement::CompilerFacet(packet))
+        };
+        QueryPoll::Ready(prepare())
+    }
+}
