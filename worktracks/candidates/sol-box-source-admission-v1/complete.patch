+//! Source/authority refusal controls; no interpreter or native Box execution.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    db::key::OutlineKey,
+    source::{
+        changes::{PreparedSourceInputs, SourceSelectionOutcome, SourceUnitInput},
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::parse::ParseKey,
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/box/empty-alloc-deref-rvalue.rs"
+);
+fn consumer(edition: u16) -> (Database, PreparedSourceView) {
+    let path = SourcePath::new("box-consumer.rs").unwrap();
+    let unit = Digest::of_bytes(b"Box source actual consumer");
+    let cfg = CfgSet::guest_default();
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let blob = SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap();
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let prepared = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile,
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let SourceSelectionOutcome::Selected(view) = prepared.select(&selection).unwrap() else {
+        panic!("actual original source selection absent")
+    };
+    let mut db = Database::default();
+    prepared.publish(&mut db).unwrap();
+    (db, view)
+}
+fn key() -> SealKey {
+    SealKey {
+        domain: SealDomain::ImplCatalog {
+            id: Digest::of_bytes(b"requested Box impl catalog"),
+        },
+        unit_graph: Digest::of_bytes(b"requested world"),
+        epoch: 1,
+    }
+}
+#[test]
+fn box_original_source_and_closed_compiler_facets_do_not_replace_selected_live_library_record() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view) = consumer(edition);
+        let compiler = crate::frontend::compile_input_catalog::CompileInputCatalog::standalone(
+            &view.selection().outline.parse.profile,
+        )
+        .unwrap();
+        assert_ne!(
+            compiler.runtime_prelude_unit(true),
+            compiler.runtime_prelude_unit(false)
+        );
+        let graph = NameNamespaces::from_outlines(&[view.outline()]).unwrap();
+        let revision = db.revision();
+        let source_revision = db.source_revision();
+        let result =
+            CurrentBoxSourceCatalog::capture_current(&db, &view, &graph, &[], &key(), MAX_BYTES);
+        let error = match result {
+            Err(error) => error,
+            Ok(_) => panic!("source/compilation facets cannot mint Box library admission"),
+        };
+        assert_eq!(error.code, "LRR-E-BOX-SOURCE");
+        assert!(error.message.contains("actual selected live library"));
+        assert_eq!(db.revision(), revision);
+        assert_eq!(db.source_revision(), source_revision);
+    }
+}
+#[test]
+fn arbitrary_requested_catalog_and_native_generation_digests_do_not_mint_box_source_authority() {
+    let (db, view) = consumer(2024);
+    let graph = NameNamespaces::from_outlines(&[view.outline()]).unwrap();
+    let mut request = key();
+    request.unit_graph =
+        Digest::of_bytes(b"immutable native generation is not live source selection");
+    assert!(
+        CurrentBoxSourceCatalog::capture_current(&db, &view, &graph, &[], &request, MAX_BYTES)
+            .is_err()
+    );
+    request.domain = SealDomain::Scope {
+        id: view.outline().root_scope.fingerprint(),
+        namespace: Namespace::Type,
+    };
+    assert!(
+        CurrentBoxSourceCatalog::capture_current(&db, &view, &graph, &[], &request, MAX_BYTES)
+            .is_err()
+    );
+    // A SealKey is only request data; no DiscoveryInput/Seal was fabricated.
+}
