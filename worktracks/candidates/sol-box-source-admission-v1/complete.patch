+//! Exact header and reached Unit-call capture. This is data, not Box permission.
+//! Runtime method bodies are excluded from token/signature inspection.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    ir::pc::{NodeId, PcKey, Phase},
+    source::{changes::SourceSelection, manifest::DefKey, snapshot::CfgSet},
+    syntax::{
+        ast_adapter::range,
+        body_index::{BodyIndexLimits, ExpressionKind, NodeRole},
+        declaration_scan::DeclarationScanLimits,
+        imports::ImportSegment,
+        outline::{BodyHandle, HeaderRecipe, Outline, ScopeKey},
+        parse::ParsedFile,
+        spans::SourceRange,
+    },
+};
+use ra_ap_syntax::{
+    AstNode, SyntaxNode,
+    ast::{self, HasGenericArgs, HasGenericParams, HasModuleItem, HasName, HasTypeBounds},
+};
+use std::sync::Arc;
+const MAX_BYTES: usize = 32 << 20;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-BOX-SOURCE", message.into())
+}
+#[derive(Debug, Clone, Copy, Eq, PartialEq, Ord, PartialOrd)]
+pub enum BoxHeaderRole {
+    OwnedBox,
+    NewImpl,
+    DerefImpl,
+    DerefMutImpl,
+    DerefTrait,
+    DerefMutTrait,
+    Global,
+    Allocator,
+    GlobalAllocatorImpl,
+    Sized,
+}
+impl BoxHeaderRole {
+    pub fn tag(self) -> u32 {
+        match self {
+            Self::OwnedBox => 0,
+            Self::NewImpl => 1,
+            Self::DerefImpl => 2,
+            Self::DerefMutImpl => 3,
+            Self::DerefTrait => 4,
+            Self::DerefMutTrait => 5,
+            Self::Global => 6,
+            Self::Allocator => 7,
+            Self::GlobalAllocatorImpl => 8,
+            Self::Sized => 9,
+        }
+    }
+}
+#[derive(Debug, Clone)]
+pub struct BoxSourceMember {
+    definition: DefKey,
+    header: HeaderRecipe,
+    range: SourceRange,
+    signature: String,
+    body: Option<BodyHandle>,
+}
+impl BoxSourceMember {
+    pub fn definition(&self) -> &DefKey {
+        &self.definition
+    }
+    pub fn header(&self) -> &HeaderRecipe {
+        &self.header
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+    pub fn signature(&self) -> &str {
+        &self.signature
+    }
+    pub fn body(&self) -> Option<&BodyHandle> {
+        self.body.as_ref()
+    }
+}
+#[derive(Debug, Clone)]
+pub struct BoxSourceHeader {
+    role: BoxHeaderRole,
+    definition: DefKey,
+    header: HeaderRecipe,
+    range: SourceRange,
+    parameters: String,
+    default_allocator: Option<String>,
+    allocator_contract: Option<String>,
+    impl_source: Option<Digest>,
+    impl_header: Option<Digest>,
+    members: Vec<BoxSourceMember>,
+}
+impl BoxSourceHeader {
+    pub fn role(&self) -> BoxHeaderRole {
+        self.role
+    }
+    pub fn definition(&self) -> &DefKey {
+        &self.definition
+    }
+    pub fn header(&self) -> &HeaderRecipe {
+        &self.header
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+    pub fn parameters(&self) -> &str {
+        &self.parameters
+    }
+    pub fn default_allocator(&self) -> Option<&str> {
+        self.default_allocator.as_deref()
+    }
+    pub fn allocator_contract(&self) -> Option<&str> {
+        self.allocator_contract.as_deref()
+    }
+    pub fn impl_source(&self) -> Option<Digest> {
+        self.impl_source
+    }
+    pub fn impl_header(&self) -> Option<Digest> {
+        self.impl_header
+    }
+    pub fn members(&self) -> &[BoxSourceMember] {
+        &self.members
+    }
+    pub fn member(&self, name: &str) -> Result<&BoxSourceMember, Diagnostic> {
+        let mut rows = self
+            .members
+            .iter()
+            .filter(|m| m.definition.declared_name == name);
+        let row = rows
+            .next()
+            .ok_or_else(|| fault("required Box source member absent"))?;
+        if rows.next().is_some() {
+            return Err(fault("duplicate Box source member"));
+        }
+        Ok(row)
+    }
+}
+#[derive(Debug)]
+pub struct BoxSourceHeaders {
+    source: SourceSelection,
+    outline: Arc<Outline>,
+    headers: Vec<BoxSourceHeader>,
+    bytes: usize,
+}
+impl BoxSourceHeaders {
+    pub fn source(&self) -> &SourceSelection {
+        &self.source
+    }
+    pub fn outline(&self) -> &Outline {
+        &self.outline
+    }
+    pub fn headers(&self) -> &[BoxSourceHeader] {
+        &self.headers
+    }
+    pub fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub fn header(&self, role: BoxHeaderRole) -> Option<&BoxSourceHeader> {
+        self.headers.iter().find(|row| row.role == role)
+    }
+}
+fn compact(node: &SyntaxNode) -> Result<String, Diagnostic> {
+    let mut out = String::new();
+    for token in node
+        .descendants_with_tokens()
+        .filter_map(|e| e.into_token())
+        .filter(|t| !t.kind().is_trivia())
+    {
+        let next = out
+            .len()
+            .checked_add(token.text().len())
+            .filter(|n| *n <= 65536)
+            .ok_or_else(|| fault("Box header token bound"))?;
+        out.try_reserve(next - out.len())
+            .map_err(|_| fault("Box header allocation"))?;
+        out.push_str(token.text());
+    }
+    Ok(out)
+}
+fn joined(parts: &[&str]) -> Result<String, Diagnostic> {
+    let bytes = parts
+        .iter()
+        .try_fold(0usize, |total, part| total.checked_add(part.len()))
+        .filter(|n| *n <= 65536)
+        .ok_or_else(|| fault("Box joined header token bound"))?;
+    let mut text = String::new();
+    text.try_reserve_exact(bytes)
+        .map_err(|_| fault("Box joined header allocation"))?;
+    for part in parts {
+        text.push_str(part);
+    }
+    Ok(text)
+}
+fn marker(header: &HeaderRecipe, name: &str, value: &str) -> bool {
+    header
+        .attributes
+        .iter()
+        .filter(|attr| attr.name == name)
+        .any(|attr| {
+            attr.tokens
+                .iter()
+                .filter(|t| t.text == format!("\"{value}\""))
+                .count()
+                == 1
+        })
+}
+fn role(node: &SyntaxNode, header: &HeaderRecipe) -> Result<Option<BoxHeaderRole>, Diagnostic> {
+    if let Some(item) = ast::Struct::cast(node.clone()) {
+        return Ok(match item.name().map(|n| n.text().to_string()).as_deref() {
+            Some("Box") if marker(header, "lang", "owned_box") => Some(BoxHeaderRole::OwnedBox),
+            Some("Global") => Some(BoxHeaderRole::Global),
+            _ => None,
+        });
+    }
+    if let Some(item) = ast::Trait::cast(node.clone()) {
+        return Ok(match item.name().map(|n| n.text().to_string()).as_deref() {
+            Some("Deref") if marker(header, "lang", "deref") => Some(BoxHeaderRole::DerefTrait),
+            Some("DerefMut") if marker(header, "lang", "deref_mut") => {
+                Some(BoxHeaderRole::DerefMutTrait)
+            }
+            Some("Sized") if marker(header, "lang", "sized") => Some(BoxHeaderRole::Sized),
+            Some("Allocator") => Some(BoxHeaderRole::Allocator),
+            _ => None,
+        });
+    }
+    let Some(item) = ast::Impl::cast(node.clone()) else {
+        return Ok(None);
+    };
+    let self_ty = compact(
+        item.self_ty()
+            .ok_or_else(|| fault("Box impl self type absent"))?
+            .syntax(),
+    )?;
+    let trait_ty = item.trait_().map(|ty| compact(ty.syntax())).transpose()?;
+    Ok(match (trait_ty.as_deref(), self_ty.as_str()) {
+        (None, "Box<T>") => Some(BoxHeaderRole::NewImpl),
+        (Some("Deref"), "Box<T,A>") => Some(BoxHeaderRole::DerefImpl),
+        (Some("DerefMut"), "Box<T,A>") => Some(BoxHeaderRole::DerefMutImpl),
+        (Some("Allocator"), "Global") => Some(BoxHeaderRole::GlobalAllocatorImpl),
+        _ => None,
+    })
+}
+pub fn capture_box_headers(
+    parsed: &ParsedFile,
+    source: &SourceSelection,
+    cfg: &CfgSet,
+) -> Result<BoxSourceHeaders, Diagnostic> {
+    if parsed.generated_origin.is_some()
+        || parsed.key() != source.outline.parse
+        || cfg.fingerprint() != source.outline.cfg
+    {
+        return Err(fault("Box source/profile/cfg/generated attachment differs"));
+    }
+    let tree = parsed.parsed.tree();
+    if tree.syntax().descendants().take(1_000_001).count() > 1_000_000 {
+        return Err(fault("Box structural node bound"));
+    }
+    let outline = parsed.outline(
+        source.outline.crate_key,
+        source.outline.module_path.clone(),
+        cfg,
+    )?;
+    let scan = parsed.scan_declarations(
+        source.path.clone(),
+        outline.root_scope.clone(),
+        cfg,
+        DeclarationScanLimits::default(),
+    )?;
+    let mut headers = Vec::new();
+    let mut bytes = std::mem::size_of::<BoxSourceHeaders>()
+        .checked_add(outline.estimated_bytes())
+        .ok_or_else(|| fault("Box outline bound"))?;
+    // Top-level module declarations only: no inspection/classification of cold
+    // local functions, method bodies, macro output or nested library modules.
+    for item in tree.items() {
+        let node = item.syntax();
+        let selected = range(node.text_range());
+        let Some(declaration) = outline
+            .items
+            .iter()
+            .find(|d| d.declaration_span == selected)
+        else {
+            continue;
+        };
+        let Some(role) = role(node, &declaration.header)? else {
+            continue;
+        };
+        let mut members = Vec::new();
+        let associated = node.children().find_map(ast::AssocItemList::cast);
+        for function in associated
+            .as_ref()
+            .into_iter()
+            .flat_map(|list| list.syntax().children())
+            .filter_map(ast::Fn::cast)
+        {
+            let name = function
+                .name()
+                .ok_or_else(|| fault("Box member name absent"))?
+                .text()
+                .to_string();
+            if !matches!(name.as_str(), "new" | "deref" | "deref_mut") {
+                continue;
+            }
+            let span = range(function.syntax().text_range());
+            let Some(member) = outline.items.iter().find(|d| d.declaration_span == span) else {
+                continue;
+            };
+            let parameters = compact(
+                function
+                    .param_list()
+                    .ok_or_else(|| fault("Box member parameters absent"))?
+                    .syntax(),
+            )?;
+            let result = function
+                .ret_type()
+                .map(|ty| compact(ty.syntax()))
+                .transpose()?
+                .unwrap_or_default();
+            let signature = joined(&["fn", &name, &parameters, &result])?;
+            if function.async_token().is_some()
+                || function.unsafe_token().is_some()
+                || function.generic_param_list().is_some()
+            {
+                return Err(fault(
+                    "Box source member qualifiers outside closed template",
+                ));
+            }
+            // Header error ranges exclude the entire structurally retained body.
+            let header_end = member
+                .body
+                .as_ref()
+                .map_or(span.end, |body| body.range.start);
+            if parsed.errors.iter().any(|e| {
+                e.range.start < span.end && e.range.end > span.start && e.range.start < header_end
+            }) {
+                return Err(fault("Box selected method header has parse diagnostics"));
+            }
+            bytes = bytes
+                .checked_add(std::mem::size_of::<BoxSourceMember>())
+                .and_then(|n| n.checked_add(member.header.estimated_bytes()))
+                .and_then(|n| n.checked_add(signature.capacity()))
+                .ok_or_else(|| fault("Box member metadata overflow"))?;
+            members
+                .try_reserve_exact(1)
+                .map_err(|_| fault("Box member allocation"))?;
+            members.push(BoxSourceMember {
+                definition: member.def_key.clone(),
+                header: member.header.clone(),
+                range: span,
+                signature,
+                body: member.body.clone(),
+            });
+        }
+        if role == BoxHeaderRole::NewImpl
+            && !members.iter().any(|m| m.definition.declared_name == "new")
+        {
+            continue;
+        }
+        if headers.iter().any(|row: &BoxSourceHeader| row.role == role) {
+            return Err(fault("Box role duplicated; selection unresolved"));
+        }
+        let implementation = ast::Impl::cast(node.clone());
+        let parameters = if let Some(item) = &implementation {
+            let generic = item
+                .generic_param_list()
+                .map(|p| compact(p.syntax()))
+                .transpose()?
+                .unwrap_or_default();
+            let predicate = item
+                .where_clause()
+                .map(|p| compact(p.syntax()))
+                .transpose()?
+                .unwrap_or_default();
+            joined(&[&generic, &predicate])?
+        } else if let Some(item) = ast::Struct::cast(node.clone()) {
+            item.generic_param_list()
+                .map(|p| compact(p.syntax()))
+                .transpose()?
+                .unwrap_or_default()
+        } else {
+            String::new()
+        };
+        let mut allocator_contract = None;
+        let default_allocator = if role == BoxHeaderRole::OwnedBox {
+            let item = ast::Struct::cast(node.clone())
+                .ok_or_else(|| fault("owned Box is not a struct"))?;
+            let list = item
+                .generic_param_list()
+                .ok_or_else(|| fault("owned Box generic header absent"))?;
+            let mut params = list.generic_params();
+            let first = params.next();
+            let second = params.next();
+            match (first, second, params.next()) {
+                (
+                    Some(ast::GenericParam::TypeParam(t)),
+                    Some(ast::GenericParam::TypeParam(a)),
+                    None,
+                ) if t.name().is_some_and(|n| n.text() == "T")
+                    && a.name().is_some_and(|n| n.text() == "A") =>
+                {
+                    let t_bounds = t
+                        .type_bound_list()
+                        .map(|list| compact(list.syntax()))
+                        .transpose()?
+                        .unwrap_or_default();
+                    let a_bounds = a
+                        .type_bound_list()
+                        .map(|list| compact(list.syntax()))
+                        .transpose()?
+                        .unwrap_or_default();
+                    let predicate = item
+                        .where_clause()
+                        .map(|clause| compact(clause.syntax()))
+                        .transpose()?
+                        .unwrap_or_default();
+                    allocator_contract =
+                        Some(joined(&[&t_bounds, "|", &a_bounds, "|", &predicate])?);
+                    a.default_type()
+                        .map(|ty| compact(ty.syntax()))
+                        .transpose()?
+                }
+                _ => None,
+            }
+        } else {
+            None
+        };
+        let scanned = if implementation.is_some() {
+            Some(
+                scan.impls()
+                    .iter()
+                    .find(|row| row.range == selected)
+                    .ok_or_else(|| fault("Box impl missing actual declaration inventory"))?,
+            )
+        } else {
+            None
+        };
+        bytes = bytes
+            .checked_add(std::mem::size_of::<BoxSourceHeader>())
+            .and_then(|n| n.checked_add(declaration.header.estimated_bytes()))
+            .and_then(|n| n.checked_add(parameters.capacity()))
+            .and_then(|n| n.checked_add(default_allocator.as_ref().map_or(0, String::capacity)))
+            .and_then(|n| n.checked_add(allocator_contract.as_ref().map_or(0, String::capacity)))
+            .filter(|n| *n <= MAX_BYTES)
+            .ok_or_else(|| fault("Box source metadata bound"))?;
+        headers
+            .try_reserve_exact(1)
+            .map_err(|_| fault("Box header allocation"))?;
+        headers.push(BoxSourceHeader {
+            role,
+            definition: declaration.def_key.clone(),
+            header: declaration.header.clone(),
+            range: selected,
+            parameters,
+            default_allocator,
+            allocator_contract,
+            impl_source: scanned.map(|row| row.identity),
+            impl_header: scanned.map(|row| row.header_identity),
+            members,
+        });
+    }
+    Ok(BoxSourceHeaders {
+        source: source.clone(),
+        outline: Arc::new(outline),
+        headers,
+        bytes,
+    })
+}
+/// Exact reached source site and closed Unit argument. No arbitrary supplied type
+/// or descriptor becomes a source pointee. Other contexts require their producer.
+#[derive(Debug)]
+pub struct UnitBoxCallSite {
+    source: SourceSelection,
+    body: BodyHandle,
+    node: NodeId,
+    pc: PcKey,
+    range: SourceRange,
+    scope: ScopeKey,
+    type_path: Vec<ImportSegment>,
+    local_frontiers: Vec<SourceRange>,
+}
+impl UnitBoxCallSite {
+    pub fn source(&self) -> &SourceSelection {
+        &self.source
+    }
+    pub fn body(&self) -> &BodyHandle {
+        &self.body
+    }
+    pub fn node(&self) -> NodeId {
+        self.node
+    }
+    pub fn pc(&self) -> &PcKey {
+        &self.pc
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+    pub fn scope(&self) -> &ScopeKey {
+        &self.scope
+    }
+    pub fn type_path(&self) -> &[ImportSegment] {
+        &self.type_path
+    }
+    pub fn local_frontiers(&self) -> &[SourceRange] {
+        &self.local_frontiers
+    }
+}
+pub fn capture_unit_box_call(
+    parsed: &ParsedFile,
+    source: &SourceSelection,
+    body: &BodyHandle,
+    selected: SourceRange,
+    cfg: &CfgSet,
+) -> Result<UnitBoxCallSite, Diagnostic> {
+    if parsed.key() != source.outline.parse
+        || parsed.generated_origin.is_some()
+        || cfg.fingerprint() != source.outline.cfg
+    {
+        return Err(fault("Box Unit call source attachment differs"));
+    }
+    if selected.start > selected.end
+        || parsed
+            .errors
+            .iter()
+            .any(|error| error.range.start < selected.end && error.range.end > selected.start)
+    {
+        return Err(fault(
+            "Box selected call has parse diagnostics or reversed range",
+        ));
+    }
+    let root = parsed.entered_body_root(body)?;
+    let call = root
+        .descendants()
+        .filter_map(ast::CallExpr::cast)
+        .find(|node| range(node.syntax().text_range()) == selected)
+        .ok_or_else(|| fault("selected Box use is not exact entered CallExpr"))?;
+    let ast::Expr::PathExpr(function) = call
+        .expr()
+        .ok_or_else(|| fault("Box function operand absent"))?
+    else {
+        return Err(fault("Box callee requires source path"));
+    };
+    let path = function
+        .path()
+        .ok_or_else(|| fault("Box source path absent"))?;
+    let last = path
+        .segment()
+        .ok_or_else(|| fault("Box source member absent"))?;
+    if last.name_ref().is_none_or(|n| n.text() != "new")
+        || last.generic_arg_list().is_some()
+        || last.type_anchor().is_some()
+    {
+        return Err(fault("Box call is outside closed new member site"));
+    }
+    let mut cursor = path.qualifier();
+    let mut type_path = Vec::new();
+    while let Some(path) = cursor {
+        if type_path.len() >= 256 || path.coloncolon_token().is_some() {
+            return Err(fault(
+                "Box path requires absolute/qualified context producer",
+            ));
+        }
+        let segment = path
+            .segment()
+            .ok_or_else(|| fault("Box qualifier segment absent"))?;
+        if segment.generic_arg_list().is_some()
+            || segment.type_anchor().is_some()
+            || segment.parenthesized_arg_list().is_some()
+        {
+            return Err(fault(
+                "Box explicit generic context requires pointee source producer",
+            ));
+        }
+        let name = segment
+            .name_ref()
+            .ok_or_else(|| fault("Box qualifier name absent"))?
+            .text()
+            .to_string();
+        if name.len() > 65536 {
+            return Err(fault("Box path segment limit"));
+        }
+        type_path
+            .try_reserve_exact(1)
+            .map_err(|_| fault("Box path allocation"))?;
+        type_path.push(ImportSegment::Name(name));
+        cursor = path.qualifier();
+    }
+    type_path.reverse();
+    if type_path.is_empty() {
+        return Err(fault("Box type qualifier absent"));
+    }
+    let args = call
+        .arg_list()
+        .ok_or_else(|| fault("Box argument list absent"))?;
+    let mut args = args.args();
+    let Some(ast::Expr::TupleExpr(unit)) = args.next() else {
+        return Err(fault(
+            "Box pointee requires actual reached source type context",
+        ));
+    };
+    if args.next().is_some()
+        || unit.fields().next().is_some()
+        || unit
+            .syntax()
+            .children()
+            .any(|n| ast::Attr::can_cast(n.kind()))
+    {
+        return Err(fault("Box argument is not source-proven Unit"));
+    }
+    let index = parsed.index_body(body, BodyIndexLimits::default())?;
+    let node = index
+        .nodes()
+        .iter()
+        .find(|node| {
+            node.role == NodeRole::Expression(ExpressionKind::Call)
+                && index.span(node.id).is_ok_and(|span| {
+                    body.range.start.checked_add(span.relative_start) == Some(selected.start)
+                        && body.range.start.checked_add(span.relative_end) == Some(selected.end)
+                })
+        })
+        .ok_or_else(|| fault("Box site lacks exact structural Call PC"))?
+        .id;
+    let outline = parsed.outline(
+        source.outline.crate_key,
+        source.outline.module_path.clone(),
+        cfg,
+    )?;
+    let scope = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.fingerprint() == body.def_key)
+        .ok_or_else(|| fault("Box owning declaration absent"))?
+        .scope
+        .clone();
+    let mut local_frontiers = Vec::new();
+    for ancestor in call
+        .syntax()
+        .ancestors()
+        .take_while(|node| root.text_range().contains_range(node.text_range()))
+        .filter_map(ast::BlockExpr::cast)
+    {
+        if let Some(list) = ancestor.stmt_list() {
+            for statement in list.statements() {
+                if let ast::Stmt::Item(item) = statement {
+                    let node = item.syntax();
+                    local_frontiers
+                        .try_reserve_exact(1)
+                        .map_err(|_| fault("Box local namespace bound"))?;
+                    local_frontiers.push(range(node.text_range()));
+                }
+            }
+        }
+    }
+    Ok(UnitBoxCallSite {
+        source: source.clone(),
+        body: body.clone(),
+        node,
+        pc: index.pc(node, Phase::Entry)?,
+        range: selected,
+        scope,
+        type_path,
+        local_frontiers,
+    })
+}
+impl StableEncode for BoxSourceHeader {
+    const DOMAIN: &'static str = "lrr/v1/box-source-header";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.u32(self.role.tag());
+        e.record(&self.definition);
+        e.record(&self.header);
+        e.u32(self.range.start);
+        e.u32(self.range.end);
+        e.string(&self.parameters);
+        e.option(&self.default_allocator, |e, value| e.string(value));
+        e.option(&self.allocator_contract, |e, value| e.string(value));
+        e.option(&self.impl_source, |e, d| e.digest(*d));
+        e.option(&self.impl_header, |e, d| e.digest(*d));
+        e.sequence(&self.members, |e, m| {
+            e.record(&m.definition);
+            e.record(&m.header);
+            e.u32(m.range.start);
+            e.u32(m.range.end);
+            e.string(&m.signature);
+            e.option(&m.body, |e, b| e.record(&b.key()));
+        });
+    }
+}
+
+/// Source projection around the exact reached Unit Box call. General receiver
+/// bindings require the separate genuine source-view producer, never a TypeId.
+#[derive(Debug)]
+pub struct UnitBoxDerefSite {
+    call: UnitBoxCallSite,
+    node: NodeId,
+    pc: PcKey,
+    range: SourceRange,
+    mutable_borrow: bool,
+}
+impl UnitBoxDerefSite {
+    pub fn call(&self) -> &UnitBoxCallSite {
+        &self.call
+    }
+    pub fn pc(&self) -> &PcKey {
+        &self.pc
+    }
+    pub fn node(&self) -> NodeId {
+        self.node
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+    pub fn mutable_borrow(&self) -> bool {
+        self.mutable_borrow
+    }
+}
+pub fn capture_unit_box_deref(
+    parsed: &ParsedFile,
+    source: &SourceSelection,
+    body: &BodyHandle,
+    selected: SourceRange,
+    cfg: &CfgSet,
+) -> Result<UnitBoxDerefSite, Diagnostic> {
+    let root = parsed.entered_body_root(body)?;
+    let prefix = root
+        .descendants()
+        .filter_map(ast::PrefixExpr::cast)
+        .find(|node| range(node.syntax().text_range()) == selected)
+        .filter(|node| node.op_token().is_some_and(|token| token.text() == "*"))
+        .ok_or_else(|| fault("Box projection is not an exact source dereference"))?;
+    let operand = prefix
+        .expr()
+        .ok_or_else(|| fault("Box dereference operand absent"))?;
+    let call = capture_unit_box_call(
+        parsed,
+        source,
+        body,
+        range(operand.syntax().text_range()),
+        cfg,
+    )?;
+    let mutable_borrow = prefix
+        .syntax()
+        .parent()
+        .and_then(ast::RefExpr::cast)
+        .is_some_and(|reference| reference.mut_token().is_some());
+    let index = parsed.index_body(body, BodyIndexLimits::default())?;
+    let node = index
+        .nodes()
+        .iter()
+        .find(|node| {
+            matches!(node.role, NodeRole::Expression(_))
+                && index.span(node.id).is_ok_and(|span| {
+                    body.range.start.checked_add(span.relative_start) == Some(selected.start)
+                        && body.range.start.checked_add(span.relative_end) == Some(selected.end)
+                })
+        })
+        .ok_or_else(|| fault("Box projection lacks exact structural PC"))?
+        .id;
+    Ok(UnitBoxDerefSite {
+        call,
+        node,
+        pc: index.pc(node, Phase::Entry)?,
+        range: selected,
+        mutable_borrow,
+    })
+}
