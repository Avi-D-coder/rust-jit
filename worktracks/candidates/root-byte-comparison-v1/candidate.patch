+#[test]
+fn unchanged_crlf_byte_assertion_tokens_compare_through_checked_immutable_roots_all_editions() {
+    // Component evidence: the exact four original tokens and their pair order.
+    // Complete-main acceptance still needs source PartialEq admission/dispatch.
+    use crate::runtime::{
+        cell::{CellOwner, GuestStore, StorageContract, byte_comparison::StaticByteComparisonPoll},
+        shape::ByteLiteralTarget,
+    };
+    use crate::vm::fuel::RunFuel;
+    const CRLF: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/crlf-in-byte-string-literal.rs"
+    );
+    assert!(CRLF.contains("\r\n"));
+    for edition in [2015, 2018, 2021, 2024] {
+        let blob = SourceBlob::new(CRLF.as_bytes().to_vec()).unwrap();
+        let parsed = ParsedFile::parse(
+            &blob,
+            ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            },
+        )
+        .unwrap();
+        let outline = parsed
+            .outline(
+                Digest::of_bytes(b"unchanged CRLF equality"),
+                vec![],
+                &CfgSet::guest_default(),
+            )
+            .unwrap();
+        let body = outline
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == "main")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap();
+        let tokens = parsed
+            .entered_body_root(body)
+            .unwrap()
+            .descendants_with_tokens()
+            .filter_map(|item| item.into_token())
+            .filter_map(ast::ByteString::cast)
+            .collect::<Vec<_>>();
+        assert_eq!(tokens.len(), 4);
+        let mut store = GuestStore::new(1, 1000, 1 << 20).unwrap();
+        let frame = store.new_frame_anchor().unwrap();
+        let mut operands = Vec::new();
+        for (ordinal, token) in tokens.iter().enumerate() {
+            let range = token.syntax().text_range();
+            let span = BodySpan {
+                body_key: body.key(),
+                relative_start: u32::from(range.start()) - body.range.start,
+                relative_end: u32::from(range.end()) - body.range.start,
+            };
+            let spelling =
+                &CRLF[u32::from(range.start()) as usize..u32::from(range.end()) as usize];
+            assert_eq!(spelling, token.text());
+            let decoded = decode_token(token, &span).unwrap();
+            decoded.require(spelling, &span).unwrap();
+            let plan = store
+                .prepare_static_bytes(
+                    Digest::of_bytes(format!("original {ordinal}").as_bytes()),
+                    decoded.bytes(),
+                    ByteLiteralTarget::Array,
+                    None,
+                    true,
+                )
+                .unwrap();
+            let ty = plan.reference_type();
+            let ticket = store.instantiate_static_bytes(plan).unwrap();
+            let cell = store
+                .new_cell(
+                    StorageContract::Exact(ty),
+                    false,
+                    CellOwner::FrameSlot {
+                        frame,
+                        slot: ordinal as u32,
+                    },
+                )
+                .unwrap();
+            store.initialize(cell, ticket).unwrap();
+            operands.push(cell);
+        }
+        let mut fuel = RunFuel::new(10).unwrap();
+        for (pair, expected_pairs) in operands.chunks_exact(2).zip([0, 1]) {
+            let mut cursor = store
+                .prepare_static_byte_comparison(pair[0], pair[1])
+                .unwrap();
+            assert_eq!(
+                store
+                    .advance_static_byte_comparison(&mut cursor, &mut fuel)
+                    .unwrap(),
+                StaticByteComparisonPoll::Complete {
+                    equal: true,
+                    pairs: expected_pairs
+                }
+            );
+        }
+        assert_eq!(fuel.snapshot().used, 1);
+        assert_eq!(blob.bytes(), CRLF.as_bytes());
+    }
+}
