+//! Bounded read-only equality of genuine immutable byte-literal roots.
+//!
+//! This is a physical operation, not trait resolution. Its caller must retain
+//! the source PartialEq/member admission and bind the cursor to the reached
+//! operation, operands and destination. Runtime descriptors cannot supply that
+//! source authority. Ordinary mutable arrays require their own stable read view.
+use super::*;
+use crate::vm::fuel::RunFuel;
+
+const PAIRS_PER_DISPATCH: u32 = 256;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct ByteView {
+    operand: CellStamp,
+    value: ValueRepr,
+    root: CellStamp,
+    object: ObjectId,
+    allocation: StaticLiteralId,
+    len: u32,
+}
+
+/// Run-local continuation. It owns no guest value, lease or transfer ticket.
+/// Do not persist it in a query/recipe cache or clone it to replay partial work.
+pub(crate) struct StaticByteComparison {
+    session: StoreSession,
+    epoch: u32,
+    left: ByteView,
+    right: ByteView,
+    next: u32,
+    terminal: bool,
+}
+
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) enum StaticByteComparisonPoll {
+    Dispatch { pairs: u32 },
+    Complete { equal: bool, pairs: u32 },
+}
+
+impl StaticByteComparison {
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+    }
+}
+
+impl GuestStore {
+    fn static_comparison_view(&self, operand: CellId) -> Result<ByteView, Diagnostic> {
+        let stamp = self.place_stamp(operand)?;
+        let value = self.admit_move(operand)?;
+        if value.kind != 9 {
+            return Err(ownership());
+        }
+        let reference_id = self.reference_from_cell(operand)?;
+        let reference = self.references.get(reference_id)?;
+        if reference.access != Access::Shared
+            || reference.final_cell != reference.root
+            || !reference.enclosing.is_empty()
+            || !matches!(
+                self.types.descriptor(TypeId(value.type_id))?.key.as_ref(),
+                TypeKey::Ref { mutable: false, target } if *target == reference.target
+            )
+        {
+            return Err(ownership());
+        }
+        let CellOwner::StaticLiteral(allocation) = self.cells.get(reference.root.cell)?.owner
+        else {
+            return Err(ownership());
+        };
+        self.require_static_root(allocation, reference.root.cell)?;
+        let root_type = self.place_type(reference.root.cell)?;
+        let TypeKey::Array { element, len } = self.types.descriptor(root_type)?.key.as_ref() else {
+            return Err(ownership());
+        };
+        if *element != TypeId(9) {
+            return Err(ownership());
+        }
+        let len = *len;
+        match self.types.descriptor(reference.target)?.key.as_ref() {
+            TypeKey::Array {
+                element,
+                len: view_len,
+            } if *element == TypeId(9) && *view_len == len && reference.static_slice.is_none() => {}
+            TypeKey::Slice { element }
+                if *element == TypeId(9) && reference.static_slice == Some(allocation) => {}
+            _ => return Err(ownership()),
+        }
+        let (object, storage) = self.place_object(reference.root.cell)?;
+        if storage.fields.len() != len as usize || !storage.initialized.complete_value() {
+            return Err(ownership());
+        }
+        Ok(ByteView {
+            operand: stamp,
+            value,
+            root: reference.root,
+            object,
+            allocation,
+            len,
+        })
+    }
+
+    /// Captures only private immutable store membership. The caller accounts
+    /// for metadata_bytes in its retained activation budget before retaining it.
+    pub(crate) fn prepare_static_byte_comparison(
+        &self,
+        left: CellId,
+        right: CellId,
+    ) -> Result<StaticByteComparison, Diagnostic> {
+        let left = self.static_comparison_view(left)?;
+        let right = self.static_comparison_view(right)?;
+        Ok(StaticByteComparison {
+            session: self.pattern_binding_session,
+            epoch: self.budget.epoch(),
+            left,
+            right,
+            next: 0,
+            terminal: false,
+        })
+    }
+
+    fn comparison_byte(&self, view: ByteView, offset: u32) -> Result<u8, Diagnostic> {
+        let (object, storage) = self.place_object(view.root.cell)?;
+        if object != view.object || offset >= view.len {
+            return Err(lease_fault());
+        }
+        let field = *storage
+            .fields
+            .get(offset as usize)
+            .ok_or_else(lease_fault)?;
+        if self.cells.get(field)?.owner
+            != (CellOwner::Field {
+                object,
+                index: offset,
+            })
+            || self.cells.get(field)?.writable
+        {
+            return Err(lease_fault());
+        }
+        let value = self.read_scalar(field)?;
+        if value.kind != 5 || value.type_id != 9 {
+            return Err(ownership());
+        }
+        u8::try_from(value.payload).map_err(|_| ownership())
+    }
+
+    /// At most 256 pairs, one fuel charge per pair, no allocation or guest write.
+    /// A length difference needs no element reads. Even empty/equal handles are
+    /// revalidated and cancellation-polled; pointer equality is not a bypass.
+    pub(crate) fn advance_static_byte_comparison(
+        &self,
+        cursor: &mut StaticByteComparison,
+        fuel: &mut RunFuel,
+    ) -> Result<StaticByteComparisonPoll, Diagnostic> {
+        // Mark failure terminal as well as completion. A partially compared
+        // prefix may never be resumed after failed currentness/fuel validation.
+        if cursor.terminal {
+            return Err(lease_fault());
+        }
+        let outcome = self.static_byte_comparison_chunk(cursor, fuel);
+        if !matches!(outcome, Ok(StaticByteComparisonPoll::Dispatch { .. })) {
+            cursor.terminal = true;
+        }
+        outcome
+    }
+
+    fn static_byte_comparison_chunk(
+        &self,
+        cursor: &mut StaticByteComparison,
+        fuel: &mut RunFuel,
+    ) -> Result<StaticByteComparisonPoll, Diagnostic> {
+        if cursor.session != self.pattern_binding_session
+            || cursor.epoch != self.budget.epoch()
+            || self.static_comparison_view(cursor.left.operand.cell)? != cursor.left
+            || self.static_comparison_view(cursor.right.operand.cell)? != cursor.right
+            || cursor.next > cursor.left.len.min(cursor.right.len)
+        {
+            return Err(lease_fault());
+        }
+        fuel.poll()?;
+        if cursor.left.len != cursor.right.len {
+            return Ok(StaticByteComparisonPoll::Complete {
+                equal: false,
+                pairs: 0,
+            });
+        }
+        let mut pairs = 0;
+        while cursor.next < cursor.left.len && pairs < PAIRS_PER_DISPATCH {
+            // Charge before reading, including the first differing element.
+            fuel.charge()?;
+            let left = self.comparison_byte(cursor.left, cursor.next)?;
+            let right = self.comparison_byte(cursor.right, cursor.next)?;
+            cursor.next = cursor.next.checked_add(1).ok_or_else(resource)?;
+            pairs += 1;
+            if left != right {
+                return Ok(StaticByteComparisonPoll::Complete {
+                    equal: false,
+                    pairs,
+                });
+            }
+        }
+        if cursor.next == cursor.left.len {
+            Ok(StaticByteComparisonPoll::Complete { equal: true, pairs })
+        } else {
+            Ok(StaticByteComparisonPoll::Dispatch { pairs })
+        }
+    }
+}
