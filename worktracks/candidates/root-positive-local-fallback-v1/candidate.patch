+#[test]
+fn positive_local_fallback_keeps_reached_argument_and_rigid_source_contexts() {
+    // LRR-specific context precedence. The unchanged suffix-inference main
+    // separately covers every original positive/negative callee and shadow.
+    for edition in [2015, 2018, 2021, 2024] {
+        for text in [
+            "fn keep(x:u64)->u64{x}fn main(){let x=18446744073709551615;assert_eq!(18446744073709551615_u64,keep(x));}",
+            "fn main(){let x=0_u8;assert_eq!(2.0,match x+1{1=>2.0,_=>0.0});}",
+            "fn main(){let x=0;assert_eq!(2.0,match x+1{1=>2.0,_=>0.0});}",
+        ] {
+            let (_, machine, outcome) = run(text, edition);
+            let report = match outcome {
+                RunPoll::Completed(report) => report,
+                RunPoll::Fault(error) => panic!("positive local context fault: {error}"),
+                RunPoll::NeedInput(input) => {
+                    panic!("positive local context needs input: {input:?}")
+                }
+                RunPoll::Panicked(report) => panic!("positive local context panicked: {report:?}"),
+            };
+            assert!(matches!(report.value, ValueSummary::Unit));
+            assert_eq!(report.opcode_counters.started_by_opcode[26], 1);
+            assert_eq!(report.opcode_counters.started_by_opcode[25], 0);
+            assert_eq!(
+                report.opcode_counters.operations_started,
+                report.opcode_counters.operations_completed
+            );
+            assert_eq!(machine.action_snapshot().pending, None);
+        }
+    }
