+    pub(crate) fn require(&self, spelling: &str, source: &BodySpan) -> Result<(), Diagnostic> {
+        if self.0.spelling != spelling || self.0.source != *source {
+            return Err(Diagnostic::new(
+                "LRR-E-IR-VERIFY",
+                "string decoded source certificate differs".into(),
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        self.0
+            .text
+            .capacity()
+            .checked_add(self.0.spelling.capacity())
+            .and_then(|n| {
+                n.checked_add(std::mem::size_of::<StringData>() + 2 * std::mem::size_of::<usize>())
