+/// Both literal kinds use immutable bytes physically, but keep distinct source
+/// certificates. Equality of their bytes never makes their source types equal.
+#[derive(Clone)]
+enum StaticLiteralPayload {
+    Bytes(ByteStringLiteral),
+    Utf8(StringLiteral),
+}
+impl StaticLiteralPayload {
+    fn from_literal(literal: &crate::ir::op::LiteralRecipe) -> Result<Self, Diagnostic> {
+        match (literal.kind, &literal.decoded) {
+            (LiteralKind::ByteString, Some(DecodedLiteral::ByteString(value))) => {
+                Ok(Self::Bytes(value.clone()))
+            }
+            (LiteralKind::String, Some(DecodedLiteral::String(value))) => {
+                Ok(Self::Utf8(value.clone()))
+            }
+            _ => Err(invalid("immutable literal decoder certificate absent")),
+        }
+    }
+    fn bytes(&self) -> &[u8] {
+        match self {
+            Self::Bytes(value) => value.bytes(),
+            Self::Utf8(value) => value.text().as_bytes(),
+        }
+    }
+    fn allocated_bytes(&self) -> Option<usize> {
+        match self {
+            Self::Bytes(value) => value.allocated_bytes(),
+            Self::Utf8(value) => value.allocated_bytes(),
+        }
+    }
+    fn permits(&self, target: crate::runtime::shape::ByteLiteralTarget) -> bool {
+        use crate::runtime::shape::ByteLiteralTarget;
+        matches!(
+            (self, target),
+            (
+                Self::Bytes(_),
+                ByteLiteralTarget::Array | ByteLiteralTarget::Slice
+            ) | (Self::Utf8(_), ByteLiteralTarget::Str)
+        )
+    }
+    fn same_decoded_payload(&self, other: &Self) -> bool {
+        match (self, other) {
+            (Self::Bytes(a), Self::Bytes(b)) => a.same_decoded_payload(b),
+            (Self::Utf8(a), Self::Utf8(b)) => a.same_decoded_payload(b),
+            _ => false,
+        }
+    }
