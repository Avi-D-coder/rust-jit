+//! Source-call component controls using unchanged upstream headers and literal
+//! execution. Joining these two witnesses is not execution of either full main.
+use super::{
+    tests::{callable, source},
+    *,
+};
+use crate::{
+    db::{key::QueryKey, provider::SyntaxProvider, value::QueryValue},
+    ir::{
+        op::{LiteralKind, Op},
+        pc::{NodeId, Phase},
+    },
+    vm::step::{StepOutcome, step},
+};
+const BORROWED: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/match/match-borrowed-str.rs"
+);
+const NULS: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/str/nul-char-equivalence.rs"
+);
+
+/// Execute the real first initializer, including its actual preceding recipes.
+/// A source view or reference value is never manufactured for this producer.
+fn literal_argument(edition: u16) -> (Frame, GuestStore, SlotId) {
+    let mut store = GuestStore::new(1, 10_000, 4_000_000).unwrap();
+    let (frame, slot) = literal_argument_in(edition, &mut store);
+    (frame, store, slot)
+}
+fn literal_argument_in(edition: u16, store: &mut GuestStore) -> (Frame, SlotId) {
+    let (mut db, view, _) = source(NULS, edition);
+    let body = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap()
+        .key();
+    let fetched = db
+        .fetch(&SyntaxProvider, QueryKey::BodyStructure(body))
+        .into_ready()
+        .unwrap()
+        .unwrap();
+    let QueryValue::BodyStructure(index) = fetched.value.as_ref() else {
+        panic!()
+    };
+    let mut frame = Frame::new(
+        index.as_ref().clone(),
+        index.pc(NodeId(0), Phase::Entry).unwrap(),
+        store,
+    )
+    .unwrap();
+    frame.set_fuel_limit(1000).unwrap();
+    for _ in 0..128 {
+        let fetched = db
+            .fetch(&SyntaxProvider, QueryKey::Thunk(frame.pc().clone()))
+            .into_ready()
+            .unwrap()
+            .unwrap();
+        let QueryValue::Thunk(recipe) = fetched.value.as_ref() else {
+            panic!()
+        };
+        let destination = recipe.recipe().operations.iter().find_map(|op| match op {
+            Op::Literal {
+                literal,
+                destination,
+                ..
+            } if literal.kind == LiteralKind::String => Some(*destination),
+            _ => None,
+        });
+        assert!(matches!(
+            step(&mut frame, store, recipe).unwrap(),
+            StepOutcome::Next(_)
+        ));
+        if let Some(destination) = destination {
+            return (frame, destination);
+        }
+    }
+    panic!("unchanged NUL initializer did not execute");
+}
+
+fn read_original_parameter(
+    db: &mut Database,
+    callee: &SourceCallable,
+    contracts: &PreparedCallContracts,
+    cells: &[CellId],
+    store: &mut GuestStore,
+) {
+    use crate::{
+        runtime::cell::CellState,
+        syntax::body_index::{ExpressionKind, NodeRole},
+        vm::call::ArgumentPacket,
+    };
+    let body = callee.body().unwrap().key();
+    let fetched = db
+        .fetch(&SyntaxProvider, QueryKey::BodyStructure(body))
+        .into_ready()
+        .unwrap()
+        .unwrap();
+    let QueryValue::BodyStructure(index) = fetched.value.as_ref() else {
+        panic!()
+    };
+    let mut selected = None;
+    for node in index
+        .nodes()
+        .iter()
+        .filter(|node| node.role == NodeRole::Expression(ExpressionKind::Path))
+    {
+        let key = index.pc(node.id, Phase::Entry).unwrap();
+        let fetched = db
+            .fetch(&SyntaxProvider, QueryKey::Thunk(key))
+            .into_ready()
+            .unwrap()
+            .unwrap();
+        let QueryValue::Thunk(recipe) = fetched.value.as_ref() else {
+            panic!()
+        };
+        if let [
+            Op::ReadParameter {
+                ordinal: 0,
+                destination,
+            },
+        ] = recipe.recipe().operations.as_ref()
+        {
+            selected = Some((node.scope, *destination, recipe.clone()));
+            break;
+        }
+    }
+    let (scope, destination, recipe) = selected.expect("original compare parameter read absent");
+    let mut frame = Frame::new(index.as_ref().clone(), recipe.recipe().key.clone(), store).unwrap();
+    frame.set_fuel_limit(1000).unwrap();
+    frame
+        .install_parameter_sources(contracts.source_parameters.clone())
+        .unwrap();
+    let mut wrong = Frame::new(index.as_ref().clone(), recipe.recipe().key.clone(), store).unwrap();
+    wrong.set_fuel_limit(1000).unwrap();
+    wrong
+        .install_parameter_sources(vec![
+            TyTerm::Ref(
+                RegionTerm::Static,
+                false,
+                Box::new(TyTerm::Primitive(PrimitiveType::U8))
+            );
+            2
+        ])
+        .unwrap();
+    let packet = ArgumentPacket::seal(store, cells, &contracts.parameter_descriptors).unwrap();
+    assert!(
+        cells
+            .iter()
+            .all(|cell| store.state(*cell).unwrap() == CellState::Moved)
+    );
+    let parameter_contracts: Vec<_> = contracts
+        .parameter_descriptors
+        .iter()
+        .map(|ty| (*ty, false))
+        .collect();
+    let effects = (
+        store.budget().handles(),
+        store.budget().bytes(),
+        wrong.fuel_snapshot(),
+    );
+    assert_eq!(
+        wrong
+            .initialize_parameters(&packet, &parameter_contracts, store)
+            .unwrap_err()
+            .code,
+        "LRR-E-OWNERSHIP"
+    );
+    assert_eq!(
+        (
+            store.budget().handles(),
+            store.budget().bytes(),
+            wrong.fuel_snapshot()
+        ),
+        effects
+    );
+    packet
+        .check_types(store, &contracts.parameter_descriptors)
+        .unwrap();
+    frame
+        .initialize_parameters(&packet, &parameter_contracts, store)
+        .unwrap();
+    let effects = (
+        store.budget().handles(),
+        store.budget().bytes(),
+        frame.fuel_snapshot(),
+    );
+    assert!(
+        frame
+            .initialize_parameters(&packet, &parameter_contracts, store)
+            .is_err()
+    );
+    assert_eq!(
+        (
+            store.budget().handles(),
+            store.budget().bytes(),
+            frame.fuel_snapshot()
+        ),
+        effects
+    );
+    let mut scopes = vec![scope];
+    while let Some(parent) = index.scopes()[scopes.last().unwrap().0 as usize].parent {
+        scopes.push(parent);
+    }
+    for scope in scopes.into_iter().rev() {
+        frame.enter(scope).unwrap();
+    }
+    assert!(matches!(
+        step(&mut frame, store, &recipe).unwrap(),
+        StepOutcome::Next(_)
+    ));
+    assert_eq!(
+        frame.source_view(destination).unwrap(),
+        Some(contracts.source_parameters[0].clone())
+    );
+    store
+        .require_static_string_value(frame.cell(destination).unwrap())
+        .unwrap();
+    assert_eq!(frame.counters().operations_started, 1);
+    assert_eq!(frame.counters().operations_completed, 1);
+}
+
+#[test]
+fn unchanged_borrowed_str_headers_and_actual_utf8_arguments_join_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, view, graph) = source(BORROWED, edition);
+        let callee = callable(&mut db, &view, &graph, "compare");
+        let (frame, mut store, slot) = literal_argument(edition);
+        let reference = ClosedReferenceArgument::capture(&frame, slot, &store).unwrap();
+        let (other_frame, other_slot) = literal_argument_in(edition, &mut store);
+        let other_reference =
+            ClosedReferenceArgument::capture(&other_frame, other_slot, &store).unwrap();
+        assert_ne!(
+            frame.cell(slot).unwrap(),
+            other_frame.cell(other_slot).unwrap()
+        );
+        assert_eq!(
+            reference.source,
+            TyTerm::Ref(RegionTerm::Static, false, Box::new(TyTerm::Str))
+        );
+        for ordinal in 0..2 {
+            let QueryPoll::Ready(Ok(ArgumentHintPreparation::Ready(hints))) =
+                prepare_argument_hint(&mut db, &callee, &graph, &[&view], ordinal)
+            else {
+                panic!("upstream str parameter not admitted")
+            };
+            let [hint] = hints.as_slice() else { panic!() };
+            let proof = hint.closed_reference.as_ref().unwrap();
+            proof.validate_hint(hint).unwrap();
+            proof.require_current(&mut db, &callee).unwrap();
+            assert_eq!(proof.pointee(), &TyTerm::Str);
+            assert_eq!(
+                hint.source,
+                TyTerm::Ref(
+                    RegionTerm::Bound {
+                        depth: 0,
+                        index: ordinal as u32,
+                    },
+                    false,
+                    Box::new(TyTerm::Str)
+                )
+            );
+            assert_eq!(
+                proof.materialize_hint(&mut store).unwrap(),
+                TypeId(reference.value.type_id)
+            );
+        }
+        let actual = ArgumentType {
+            source: reference.source.clone(),
+            descriptor: TypeId(reference.value.type_id),
+        };
+        let actuals = [actual.clone(), actual];
+        let references = [Some(reference), Some(other_reference)];
+        let QueryPoll::Ready(Ok(ContractPreparation::Ready(mut packet))) =
+            prepare_contracts_with_references(
+                &mut db,
+                &callee,
+                &graph,
+                &[&view],
+                &[],
+                None,
+                ReferenceCallArguments {
+                    store: &store,
+                    arguments: &actuals,
+                    references: &references,
+                },
+            )
+        else {
+            panic!("actual immutable str source/cell join failed")
+        };
+        let proof = packet.closed_references.as_ref().unwrap().clone();
+        proof.validate_packet(callee.signature(), &packet).unwrap();
+        proof
+            .require_argument_cells(
+                &store,
+                &[
+                    frame.cell(slot).unwrap(),
+                    other_frame.cell(other_slot).unwrap(),
+                ],
+                &actuals,
+            )
+            .unwrap();
+        assert_eq!(packet.source_parameters, vec![actuals[0].source.clone(); 2]);
+        packet.source_parameters[0] = TyTerm::Ref(
+            RegionTerm::Static,
+            false,
+            Box::new(TyTerm::Slice(Box::new(TyTerm::Primitive(
+                PrimitiveType::U8,
+            )))),
+        );
+        assert_eq!(
+            proof
+                .validate_packet(callee.signature(), &packet)
+                .unwrap_err()
+                .code,
+            "LRR-E-CALL-CONTEXT"
+        );
+        packet.source_parameters[0] = actuals[0].source.clone();
+        let cells = [
+            frame.cell(slot).unwrap(),
+            other_frame.cell(other_slot).unwrap(),
+        ];
+        read_original_parameter(&mut db, &callee, &packet, &cells, &mut store);
+    }
+}
