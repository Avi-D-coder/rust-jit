+//! Original-token storage witnesses and LRR lease/cancellation controls.
+//! These are physical component checks, not execution of the upstream mains.
+use super::*;
+use ra_ap_syntax::{AstNode, SyntaxKind};
+const UNICODE: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/unicode-escape-sequences.rs"
+);
+const NULS: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/str/nul-char-equivalence.rs"
+);
+const CRLF: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/lexer-crlf-line-endings-string-literal-doc-comment.rs"
+);
+fn key() -> crate::core::digest::Digest {
+    crate::core::digest::Digest::of_bytes(b"physical UTF8 storage witness")
+}
+fn source_strings(source: &str, edition: u16) -> Vec<String> {
+    let ra_edition = match edition {
+        2015 => ra_ap_syntax::Edition::Edition2015,
+        2018 => ra_ap_syntax::Edition::Edition2018,
+        2021 => ra_ap_syntax::Edition::Edition2021,
+        2024 => ra_ap_syntax::Edition::Edition2024,
+        _ => unreachable!(),
+    };
+    let parsed = ra_ap_syntax::SourceFile::parse(source, ra_edition);
+    parsed
+        .tree()
+        .syntax()
+        .descendants_with_tokens()
+        .filter_map(|child| child.into_token())
+        .filter(|token| token.kind() == SyntaxKind::STRING)
+        .map(|token| crate::syntax::ast_adapter::string_value(token.text(), edition).unwrap())
+        .collect()
+}
+fn stored_bytes(store: &GuestStore, ticket: TicketId) -> Vec<u8> {
+    let value = store.peek_ticket(ticket).unwrap();
+    let reference = store
+        .references
+        .get(RefId::from_bits(value.payload))
+        .unwrap();
+    assert_eq!(reference.target, TypeId(16));
+    store.validate_reference_record(reference).unwrap();
+    let (_, storage) = store.place_object(reference.root.cell).unwrap();
+    storage
+        .fields
+        .iter()
+        .map(|cell| {
+            assert!(!store.cells.get(*cell).unwrap().writable);
+            u8::try_from(store.read_scalar(*cell).unwrap().payload).unwrap()
+        })
+        .collect()
+}
+#[test]
+fn upstream_unicode_nul_and_crlf_strings_retain_exact_utf8_in_immutable_roots_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        for (source, count) in [(UNICODE, 7), (NULS, 8), (CRLF, 9)] {
+            let values = source_strings(source, edition);
+            assert_eq!(values.len(), count);
+            for text in values {
+                let mut store = GuestStore::new(1, 1000, 1 << 20).unwrap();
+                let plan = store
+                    .prepare_static_bytes(
+                        key(),
+                        text.as_bytes(),
+                        ByteLiteralTarget::Str,
+                        None,
+                        false,
+                    )
+                    .unwrap();
+                let ty = plan.reference_type();
+                let ticket = store.instantiate_static_bytes(plan).unwrap();
+                assert_eq!(store.peek_ticket(ticket).unwrap().type_id, ty.0);
+                assert_eq!(stored_bytes(&store, ticket), text.as_bytes());
+                let reference = RefId::from_bits(store.peek_ticket(ticket).unwrap().payload);
+                let frame = store.new_frame_anchor().unwrap();
+                let cell = store
+                    .new_cell(
+                        StorageContract::Exact(ty),
+                        false,
+                        CellOwner::FrameSlot { frame, slot: 0 },
+                    )
+                    .unwrap();
+                store.initialize(cell, ticket).unwrap();
+                let returned = store.reference_ticket(reference).unwrap();
+                let dropped = store.begin_drop(cell).unwrap();
+                store.discard(dropped).unwrap();
+                store.retire_cell(cell).unwrap();
+                assert_eq!(stored_bytes(&store, returned), text.as_bytes());
+                store.reset(2).unwrap();
+                assert!(store.reference_ticket(reference).is_err());
+                assert!(store.static_literal_index.is_empty());
+            }
+        }
+    }
+}
