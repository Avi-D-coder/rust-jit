+//! Source-bound UTF-8 string token data; no guest storage or reference authority.
+use crate::{core::diagnostic::Diagnostic, syntax::spans::BodySpan};
+use ra_ap_syntax::{
+    AstNode, AstToken, SyntaxKind,
+    ast::{self, IsString},
+};
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct StringLiteral(std::sync::Arc<StringData>);
+#[derive(Debug, Eq, PartialEq)]
+struct StringData {
+    text: String,
+    spelling: String,
+    source: BodySpan,
+}
+impl StringLiteral {
+    /// Retained immutable decoder agreement, never source/member authority.
+    pub(crate) fn same_decoded_payload(&self, other: &Self) -> bool {
+        std::sync::Arc::ptr_eq(&self.0, &other.0)
+    }
+    pub(crate) fn text(&self) -> &str {
+        &self.0.text
