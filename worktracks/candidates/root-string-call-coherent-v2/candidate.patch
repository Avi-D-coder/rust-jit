+                store.budget().bytes(),
+                store.type_metadata_bytes(),
+                frame.fuel_snapshot(),
+                frame.counters().operations_started
+            )
+        );
+        assert!(frame.cell(*destination).is_err());
+    }
+}
+#[test]
+fn symbolic_str_identity_is_distinct_from_byte_slice_and_uses_append_only_tag() {
+    let mut expected = StableEncoder::new(TyTerm::DOMAIN);
+    expected.u32(15);
+    assert_eq!(TyTerm::Str.fingerprint(), expected.finish());
+    assert_ne!(
+        TyTerm::Str,
+        TyTerm::Slice(Box::new(TyTerm::Primitive(PrimitiveType::U8)))
+    );
+    assert_eq!(TyTerm::Str.heap_bytes(), Some(0));
+    let mut unifier = crate::traits::unify::Unifier::new(Digest::of_bytes(b"UTF8 type identity"));
+    unifier.unify(&source(), &source()).unwrap();
+    assert!(
+        unifier
+            .unify(
+                &TyTerm::Str,
+                &TyTerm::Slice(Box::new(TyTerm::Primitive(PrimitiveType::U8)))
+            )
+            .is_err()
+    );
+}
+#[test]
+fn unchanged_slowparse_string_main_executes_one_literal_and_completes_all_editions() {
+    use crate::{
+        db::{key::OutlineKey, memo::Database},
+        engine::run::{RunMachine, RunPoll, ValueSummary},
+        source::{
+            changes::{
+                PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput,
+            },
+            snapshot::SourcePath,
+        },
+        syntax::parse::ParseKey,
+    };
+    const ORIGINAL: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/parser/slowparse-string.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let profile = ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        };
+        let blob = SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap();
+        let path = SourcePath::new("tests/ui/parser/slowparse-string.rs").unwrap();
+        let owner = Digest::of_bytes(b"unchanged slowparse string main");
+        let cfg = CfgSet::guest_default();
+        let selection = SourceSelection {
+            path: path.clone(),
+            outline: OutlineKey {
+                parse: ParseKey {
+                    content: blob.content(),
+                    profile: profile.clone(),
+                },
+                crate_key: owner,
+                module_path: vec![],
+                cfg: cfg.fingerprint(),
+            },
+        };
+        let inputs = PreparedSourceInputs::refresh(
+            None,
+            vec![SourceUnitInput {
+                path,
+                blob,
+                profile,
+                cfg,
+                crate_key: owner,
+                module_path: vec![],
+            }],
+            Default::default(),
+        )
+        .unwrap();
+        let SourceSelectionOutcome::Selected(source) = inputs.select(&selection).unwrap() else {
+            panic!("original source");
+        };
+        let body = source
+            .outline()
+            .items
+            .iter()
+            .find(|item| item.def_key.declared_name == "main")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap()
+            .key();
+        let mut db = Database::default();
+        inputs.publish(&mut db).unwrap();
+        db.begin_run().unwrap();
+        let mut run = RunMachine::start_with_sources(&mut db, body, 2_000_000, vec![source])
+            .into_ready()
+            .unwrap()
+            .unwrap();
+        let RunPoll::Completed(report) = run.poll(&mut db) else {
+            panic!("unchanged long string main must complete in edition {edition}");
+        };
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(report.opcode_counters.started_by_opcode[0], 1);
+        assert_eq!(report.opcode_counters.started_by_opcode[7], 0);
+        assert_eq!(
+            report.opcode_counters.operations_started,
+            report.opcode_counters.operations_completed
+        );
+        db.finish_run().unwrap();
+    }
+}
