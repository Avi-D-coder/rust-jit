+#[test]
+fn unchanged_unicode_underscore_main_completes_string_and_char_assertions_all_editions() {
+    const ORIGINAL: &str = include_str!(
+        "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/underscores-in-unicode-escapes.rs"
+    );
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = tests::start_source(ORIGINAL, edition, 1000);
+        let contexts = macros.contexts().unwrap();
+        let report = match run.poll_with_runtime_macros(&mut db, &contexts) {
+            RunPoll::Completed(report) => report,
+            RunPoll::Fault(error) => panic!("edition {edition}: {error}"),
+            RunPoll::NeedInput(input) => panic!("edition {edition}: {input:?}"),
+            RunPoll::Panicked(report) => panic!("edition {edition}: {report:?}"),
+        };
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(report.opcode_counters.started_by_opcode[26], 2);
+        assert_eq!(report.opcode_counters.started_by_opcode[10], 2);
+        assert_eq!(
+            report.opcode_counters.operations_started,
+            report.opcode_counters.operations_completed
+        );
+        db.finish_run().unwrap();
+    }
+}
