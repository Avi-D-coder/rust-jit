+}
+#[test]
+fn unchanged_reexport_value_member_keeps_type_namespace_distinct() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let key = Digest::of_bytes(b"official reexport source set");
+        let (mut db, views) = universe(
