+//! Lexicographic UTF-8 byte ordering over private immutable string leases.
+//! This cursor supplies physical evidence only; source PartialOrd is independent.
+use super::*;
+use std::cmp::Ordering;
+
+pub(crate) struct StaticStringOrdering {
+    comparison: StaticByteComparison,
+}
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) enum StaticStringOrderingPoll {
+    Dispatch { pairs: u32 },
+    Complete { ordering: Ordering, pairs: u32 },
+}
+impl StaticStringOrdering {
+    pub(crate) fn require_operands(&self, left: CellId, right: CellId) -> Result<(), Diagnostic> {
+        self.comparison.require_operands(left, right)
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+    }
+}
+impl GuestStore {
+    pub(crate) fn prepare_static_string_ordering(
+        &self,
+        left: CellId,
+        right: CellId,
+    ) -> Result<StaticStringOrdering, Diagnostic> {
+        self.require_static_string_value(left)?;
+        self.require_static_string_value(right)?;
+        Ok(StaticStringOrdering {
+            comparison: self.prepare_static_byte_comparison(left, right)?,
+        })
+    }
+    pub(crate) fn admit_static_string_ordering(
+        &self,
+        cursor: &StaticStringOrdering,
+        left: CellId,
+        right: CellId,
+    ) -> Result<(), Diagnostic> {
+        self.require_static_string_value(left)?;
+        self.require_static_string_value(right)?;
+        self.admit_static_byte_comparison(&cursor.comparison, left, right)
+    }
+    /// One charge per inspected byte pair; at most 256 pairs per dispatch.
+    /// Different lengths decide order only after the common prefix is equal.
+    pub(crate) fn advance_static_string_ordering(
+        &self,
+        cursor: &mut StaticStringOrdering,
+        fuel: &mut RunFuel,
+    ) -> Result<StaticStringOrderingPoll, Diagnostic> {
+        let cursor = &mut cursor.comparison;
+        if cursor.terminal {
+            return Err(lease_fault());
+        }
+        let outcome = self.static_string_ordering_chunk(cursor, fuel);
+        if !matches!(outcome, Ok(StaticStringOrderingPoll::Dispatch { .. })) {
+            cursor.terminal = true;
+        }
+        outcome
+    }
+    fn static_string_ordering_chunk(
+        &self,
+        cursor: &mut StaticByteComparison,
+        fuel: &mut RunFuel,
+    ) -> Result<StaticStringOrderingPoll, Diagnostic> {
+        self.validate_static_byte_comparison(cursor)?;
+        self.require_static_string_value(cursor.left.operand.cell)?;
+        self.require_static_string_value(cursor.right.operand.cell)?;
+        fuel.poll()?;
+        let end = cursor.left.len.min(cursor.right.len);
+        let mut pairs = 0;
+        while cursor.next < end && pairs < PAIRS_PER_DISPATCH {
+            fuel.charge()?;
+            let left = self.comparison_byte(cursor.left, cursor.next)?;
+            let right = self.comparison_byte(cursor.right, cursor.next)?;
+            cursor.next = cursor.next.checked_add(1).ok_or_else(resource)?;
+            pairs += 1;
+            let ordering = left.cmp(&right);
+            if ordering != Ordering::Equal {
+                return Ok(StaticStringOrderingPoll::Complete { ordering, pairs });
+            }
+        }
+        if cursor.next == end {
+            Ok(StaticStringOrderingPoll::Complete {
+                ordering: cursor.left.len.cmp(&cursor.right.len),
+                pairs,
+            })
+        } else {
+            Ok(StaticStringOrderingPoll::Dispatch { pairs })
+        }
+    }
+}
