+//! Unchanged upstream literal operands plus LRR continuation/authority controls.
+//! These physical controls do not execute the whole fixture or its output.
+use super::super::tests::{operand, store};
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity, runtime::shape::ByteLiteralTarget,
+    source::snapshot::SourceBlob, syntax::parse::ParsedFile,
+};
+use ra_ap_syntax::{AstNode, AstToken, ast};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/array-slice-vec/estr-slice.rs"
+);
+
+#[test]
+fn unchanged_estr_literals_order_by_actual_utf8_bytes_and_equal_prefix_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(ORIGINAL.as_bytes().to_vec()).unwrap(),
+            ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            },
+        )
+        .unwrap();
+        assert!(parsed.errors.is_empty());
+        let values: Vec<_> = parsed
+            .parsed
+            .tree()
+            .syntax()
+            .descendants()
+            .filter_map(ast::LetStmt::cast)
+            .filter_map(|binding| {
+                let ast::Expr::Literal(literal) = binding.initializer()? else {
+                    return None;
+                };
+                let token = ast::String::cast(literal.token())?;
+                Some(token.value().unwrap().into_owned())
+            })
+            .collect();
+        assert_eq!(values.len(), 8);
+        let mut store = store();
+        let cells: Vec<_> = values
+            .iter()
+            .enumerate()
+            .map(|(i, text)| {
+                operand(
+                    &mut store,
+                    i.to_string().as_bytes(),
+                    text.as_bytes(),
+                    ByteLiteralTarget::Str,
+                )
+            })
+            .collect();
+        let before = (store.budget.handles(), store.budget.bytes());
+        for (a, left) in values.iter().enumerate() {
+            for (b, right) in values.iter().enumerate() {
+                let mut cursor = store
+                    .prepare_static_string_ordering(cells[a], cells[b])
+                    .unwrap();
+                store
+                    .admit_static_string_ordering(&cursor, cells[a], cells[b])
+                    .unwrap();
+                let mut fuel = RunFuel::new(100).unwrap();
+                let pairs = left
+                    .bytes()
+                    .zip(right.bytes())
+                    .take_while(|(l, r)| l == r)
+                    .count();
+                let inspected = pairs + usize::from(pairs < left.len().min(right.len()));
+                assert_eq!(
+                    store
+                        .advance_static_string_ordering(&mut cursor, &mut fuel)
+                        .unwrap(),
+                    StaticStringOrderingPoll::Complete {
+                        ordering: left.cmp(right),
+                        pairs: inspected as u32
+                    }
+                );
+                assert_eq!(fuel.snapshot().used, inspected as u64);
+                assert!(
+                    store
+                        .advance_static_string_ordering(&mut cursor, &mut fuel)
+                        .is_err()
+                );
+            }
+        }
+        assert_eq!(before, (store.budget.handles(), store.budget.bytes()));
+    }
+}
+#[test]
+fn string_ordering_does_not_rank_lengths_before_inspecting_the_common_prefix() {
+    let mut store = store();
+    for (a, b, expected, pairs) in [
+        ("z", "aaaa", Ordering::Greater, 1),
+        ("aaaa", "z", Ordering::Less, 1),
+        ("c", "cc", Ordering::Less, 1),
+        ("", "cc", Ordering::Less, 0),
+        ("\0é", "\0z", Ordering::Greater, 2),
+    ] {
+        let left = operand(
+            &mut store,
+            format!("l{a}").as_bytes(),
+            a.as_bytes(),
+            ByteLiteralTarget::Str,
+        );
+        let right = operand(
+            &mut store,
+            format!("r{b}").as_bytes(),
+            b.as_bytes(),
+            ByteLiteralTarget::Str,
+        );
+        let mut cursor = store.prepare_static_string_ordering(left, right).unwrap();
+        let mut fuel = RunFuel::new(100).unwrap();
+        assert_eq!(
+            store
+                .advance_static_string_ordering(&mut cursor, &mut fuel)
+                .unwrap(),
+            StaticStringOrderingPoll::Complete {
+                ordering: expected,
+                pairs
+            }
+        );
+        assert_eq!(fuel.snapshot().used, u64::from(pairs));
+    }
+}
+#[test]
+fn string_ordering_bounds_prefix_work_and_refuses_replay_foreign_store_and_cancellation() {
+    let mut first = store();
+    let a = format!("{}a", "c".repeat(600));
+    let b = format!("{}b", "c".repeat(600));
+    let left = operand(&mut first, b"l", a.as_bytes(), ByteLiteralTarget::Str);
+    let right = operand(&mut first, b"r", b.as_bytes(), ByteLiteralTarget::Str);
+    let before = (
+        first.budget.handles(),
+        first.budget.bytes(),
+        first.state(left).unwrap(),
+    );
+    let mut cursor = first.prepare_static_string_ordering(left, right).unwrap();
+    let mut fuel = RunFuel::new(601).unwrap();
+    for _ in 0..2 {
+        assert_eq!(
+            first
+                .advance_static_string_ordering(&mut cursor, &mut fuel)
+                .unwrap(),
+            StaticStringOrderingPoll::Dispatch { pairs: 256 }
+        );
+        assert!(
+            first
+                .admit_static_string_ordering(&cursor, left, right)
+                .is_err()
+        );
+    }
+    assert_eq!(
+        first
+            .advance_static_string_ordering(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticStringOrderingPoll::Complete {
+            ordering: Ordering::Less,
+            pairs: 89
+        }
+    );
+    assert_eq!(fuel.snapshot().used, 601);
+    assert_eq!(
+        before,
+        (
+            first.budget.handles(),
+            first.budget.bytes(),
+            first.state(left).unwrap()
+        )
+    );
+    let second = store();
+    let mut foreign = first.prepare_static_string_ordering(left, right).unwrap();
+    let mut fuel = RunFuel::new(1000).unwrap();
+    assert!(
+        second
+            .advance_static_string_ordering(&mut foreign, &mut fuel)
+            .is_err()
+    );
+    assert!(
+        first
+            .advance_static_string_ordering(&mut foreign, &mut fuel)
+            .is_err()
+    );
+    assert_eq!(fuel.snapshot().used, 0);
+    let empty = operand(&mut first, b"empty", b"", ByteLiteralTarget::Str);
+    for (left, right) in [(empty, empty), (empty, right), (left, left)] {
+        let mut cursor = first.prepare_static_string_ordering(left, right).unwrap();
+        let mut fuel = RunFuel::new(1000).unwrap();
+        fuel.cancellation().cancel();
+        assert!(
+            first
+                .advance_static_string_ordering(&mut cursor, &mut fuel)
+                .is_err()
+        );
+        assert_eq!(fuel.snapshot().used, 0);
+        assert!(
+            first
+                .advance_static_string_ordering(&mut cursor, &mut RunFuel::new(1000).unwrap())
+                .is_err()
+        );
+    }
+    let bytes = operand(&mut first, b"byte-only", b"cc", ByteLiteralTarget::Slice);
+    assert!(first.prepare_static_string_ordering(bytes, left).is_err());
+    let mut cursor = first.prepare_static_string_ordering(left, right).unwrap();
+    let mut fuel = RunFuel::new(256).unwrap();
+    assert_eq!(
+        first
+            .advance_static_string_ordering(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticStringOrderingPoll::Dispatch { pairs: 256 }
+    );
+    assert!(
+        first
+            .advance_static_string_ordering(&mut cursor, &mut fuel)
+            .is_err()
+    );
+    assert!(
+        first
+            .advance_static_string_ordering(&mut cursor, &mut RunFuel::new(1000).unwrap())
+            .is_err()
+    );
+}
