new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/source/value_library_selection.rs
@@ -0,0 +1,552 @@
+//! Explicit live source-library selection, distinct from installed/native sysroot.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{InputKey, InputValue},
+        memo::Database,
+    },
+    facade::value_prelude::{ValuePreludeCatalog, pinned_sources},
+    source::{
+        changes::{PreparedSourceView, SourceSelection},
+        manifest::TargetKind,
+        snapshot::{Snapshot, SourceBlob, SourcePath},
+    },
+};
+use std::collections::BTreeMap;
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+const CORE_ROOT: &str = include_str!("../facade/value_prelude_sources/library/core/src/lib.rs");
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-SOURCE-TYPE-CONTEXT", message.into())
+}
+fn budget() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-METADATA-LIMIT",
+        "selected Value-library metadata/source budget".into(),
+    )
+}
+/// Opaque, preparation-minted input. Its origin is *selected live source*, never
+/// an installed sysroot/native generation or a synthetic macro-facet default.
+/// Raw SourceView IDs, caller stamp lists and serde constructors are absent.
+#[derive(Debug)]
+pub struct PreparedValueLibrarySelection {
+    consumer: SourceSelection,
+    core: SourceSelection,
+    standard: SourceSelection,
+    allocation: Option<SourceSelection>,
+    snapshot: Digest,
+    graph: Digest,
+    catalog: Digest,
+    source_seal: Digest,
+    documents: BTreeMap<SourcePath, SourceBlob>,
+    stamps: BTreeMap<InputKey, Digest>,
+    bytes: usize,
+}
+fn require_provider(
+    snapshot: &Snapshot,
+    view: &PreparedSourceView,
+    name: &str,
+) -> Result<(), Diagnostic> {
+    view.require_original_hygiene()?;
+    view.require_declaration_syntax()?;
+    let selection = view.selection();
+    let profile = &selection.outline.parse.profile;
+    profile.validate_source()?;
+    if !selection.outline.module_path.is_empty() || profile.edition != 2024 {
+        return Err(fault(
+            "Value-library provider must be original owning-edition2024 root",
+        ));
+    }
+    let cargo_path = SourcePath::new(format!("library/{name}/Cargo.toml"))?;
+    let cargo = snapshot
+        .files()
+        .get(&cargo_path)
+        .ok_or_else(|| fault("selected Value-library owning Cargo document absent"))?;
+    let manifest: toml::Value = toml::from_str(cargo.text()?)
+        .map_err(|_| fault("selected Value-library Cargo document invalid"))?;
+    let package = manifest
+        .get("package")
+        .ok_or_else(|| fault("selected Value-library Cargo package absent"))?;
+    let cargo_name = package
+        .get("name")
+        .and_then(toml::Value::as_str)
+        .ok_or_else(|| fault("selected Value-library Cargo package name absent"))?;
+    let cargo_version = package
+        .get("version")
+        .and_then(toml::Value::as_str)
+        .ok_or_else(|| fault("selected Value-library Cargo package version absent"))?;
+    let cargo_edition = package
+        .get("edition")
+        .and_then(toml::Value::as_str)
+        .ok_or_else(|| fault("selected Value-library Cargo edition absent"))?;
+    let key = snapshot
+        .project()
+        .crates
+        .get(&selection.outline.crate_key)
+        .ok_or_else(|| fault("selected Value-library source crate identity is absent"))?;
+    let cfg = snapshot
+        .cfg_by_crate()
+        .get(&selection.outline.crate_key)
+        .ok_or_else(|| fault("selected Value-library source cfg is absent"))?;
+    if key.fingerprint() != selection.outline.crate_key
+        || key.package.package_name != name
+        || cargo_name != name
+        || key.package.version != cargo_version
+        || cargo_edition != "2024"
+        || key.target_name != name
+        || key.target_kind != TargetKind::Library
+        || key.guest_edition != 2024
+        || key.semantics_profile != profile.fingerprint()
+        || key.cfg_fingerprint != cfg.fingerprint()
+        || selection.outline.cfg != cfg.fingerprint()
+    {
+        return Err(fault(
+            "Value-library provider package/profile/edition/cfg differs",
+        ));
+    }
+    let path = SourcePath::new(format!("library/{name}/src/lib.rs"))?;
+    let blob = snapshot
+        .files()
+        .get(&path)
+        .ok_or_else(|| fault("selected Value-library provider root source absent"))?;
+    if blob.content() != selection.outline.parse.content
+        || view.captured_macro_blob()?.content() != blob.content()
+        || view.captured_macro_cfg()?.fingerprint() != cfg.fingerprint()
+    {
+        return Err(fault(
+            "Value-library provider root is not the captured source/cfg",
+        ));
+    }
+    // The full root source binds this exact public module declaration; no
+    // arbitrary renamed/root prelude route may replace the pinned chain.
+    use ra_ap_syntax::{
+        AstNode,
+        ast::{self, HasAttrs, HasModuleItem, HasName, HasVisibility},
+    };
+    let parsed =
+        ra_ap_syntax::ast::SourceFile::parse(blob.text()?, ra_ap_syntax::Edition::Edition2024)
+            .tree();
+    if name == "alloc" {
+        return Ok(());
+    }
+    let mut modules = parsed
+        .items()
+        .filter_map(|item| {
+            if let ast::Item::Module(module) = item {
+                Some(module)
+            } else {
+                None
+            }
+        })
+        .filter(|module| module.name().is_some_and(|n| n.text() == "prelude"));
+    let module = modules
+        .next()
+        .ok_or_else(|| fault("Value-library root prelude declaration absent"))?;
+    if modules.next().is_some()
+        || module
+            .visibility()
+            .is_none_or(|v| v.syntax().text().to_string() != "pub")
+        || module.item_list().is_some()
+    {
+        return Err(fault("Value-library prelude root declaration differs"));
+    }
+    let (enabled, _) = crate::syntax::attributes::effective_metas(
+        module.attrs().filter_map(|attr| attr.meta()).collect(),
+        cfg,
+    )?;
+    if !enabled {
+        return Err(fault("selected library cfg disables the prelude root"));
+    }
+    Ok(())
+}
+impl PreparedValueLibrarySelection {
+    pub(crate) fn capture_live_source(
+        consumer: &PreparedSourceView,
+        core: &PreparedSourceView,
+        standard: &PreparedSourceView,
+        allocation: Option<&PreparedSourceView>,
+        snapshot: &Snapshot,
+    ) -> Result<Self, Diagnostic> {
+        consumer.require_original_hygiene()?;
+        consumer.require_declaration_syntax()?;
+        consumer
+            .selection()
+            .outline
+            .parse
+            .profile
+            .validate_source()?;
+        if !consumer.selection().outline.module_path.is_empty() {
+            return Err(fault(
+                "Value-library selection requires exact consumer root",
+            ));
+        }
+        require_provider(snapshot, core, "core")?;
+        require_provider(snapshot, standard, "std")?;
+        if snapshot.project().selected_crate != core.selection().outline.crate_key
+            && snapshot.project().selected_crate != standard.selection().outline.crate_key
+        {
+            return Err(fault(
+                "captured library snapshot selects another source project",
+            ));
+        }
+        let selected = if snapshot.project().selected_crate == core.selection().outline.crate_key {
+            core
+        } else {
+            standard
+        };
+        if &snapshot.project().root_source != &selected.selection().path {
+            return Err(fault("captured library source root path differs"));
+        }
+        let graph = consumer.source_dependencies()?;
+        let policy = consumer.macro_prelude_policy()?;
+        let aliases = graph.aliases_for(
+            consumer.selection().outline.crate_key,
+            consumer.selection().outline.parse.profile.edition,
+        )?;
+        let core_name = crate::frontend::names::owned_name(
+            "core",
+            consumer.selection().outline.parse.profile.edition,
+        )?;
+        let std_name = crate::frontend::names::owned_name(
+            "std",
+            consumer.selection().outline.parse.profile.edition,
+        )?;
+        if aliases.get(&core_name) != Some(&core.selection().outline.crate_key)
+            || (policy.standard
+                && aliases.get(&std_name) != Some(&standard.selection().outline.crate_key))
+            || aliases
+                .get(&std_name)
+                .is_some_and(|provider| *provider != standard.selection().outline.crate_key)
+        {
+            return Err(fault(
+                "actual source dependency graph does not select the core/std Value policy providers",
+            ));
+        }
+        if core.source_dependencies()?.fingerprint() != graph.fingerprint()
+            || standard.source_dependencies()?.fingerprint() != graph.fingerprint()
+        {
+            return Err(fault(
+                "Value-library provider roots belong to another prepared source world",
+            ));
+        }
+        if let Some(allocation) = allocation {
+            require_provider(snapshot, allocation, "alloc")?;
+            let std_aliases = graph.aliases_for(standard.selection().outline.crate_key, 2024)?;
+            let alloc_aliases =
+                graph.aliases_for(allocation.selection().outline.crate_key, 2024)?;
+            if std_aliases.get(&crate::frontend::names::owned_name("alloc", 2024)?)
+                != Some(&allocation.selection().outline.crate_key)
+                || alloc_aliases.get(&crate::frontend::names::owned_name("core", 2024)?)
+                    != Some(&core.selection().outline.crate_key)
+                || allocation.source_dependencies()?.fingerprint() != graph.fingerprint()
+            {
+                return Err(fault(
+                    "actual selected alloc source graph/root world differs",
+                ));
+            }
+        }
+
+        // Standard/core are prepared together; actual no_std chooses the core
+        // lane at reached admission. Disabled/custom policies do not default to
+        // a different library. Consumer custom policy is refused by its producer.
+        let mut documents = BTreeMap::new();
+        let mut stamps = BTreeMap::new();
+        let mut source_bytes = 0usize;
+        for (path, expected) in pinned_sources()
+            .into_iter()
+            .chain([("library/core/src/lib.rs", CORE_ROOT)])
+        {
+            let path = SourcePath::new(path)?;
+            let blob = snapshot.files().get(&path).ok_or_else(|| {
+                fault("selected Value-library complete export source chain absent")
+            })?;
+            if blob.bytes() != expected.as_bytes() {
+                return Err(fault(
+                    "selected Value-library source generation/export chain differs; no sysroot equivalence",
+                ));
+            }
+            source_bytes = source_bytes
+                .checked_add(blob.bytes().len())
+                .filter(|n| *n <= MAX_BYTES)
+                .ok_or_else(budget)?;
+            stamps.insert(
+                InputKey::SourceBlob(blob.content()),
+                InputValue::SourceBlob(blob.clone()).fingerprint(),
+            );
+            documents.insert(path, blob.clone());
+        }
+        // Do not borrow a temporary path; static closed source paths determine
+        // the observation list, never a caller-selected dependency inventory.
+        // Retain the whole actually captured source bundle as observations.
+        // Extra files do not become declaration/module/trait authority. The
+        // prelude completeness proof still uses exactly the closed pinned chain.
+        if snapshot.files().len() > 100_000 {
+            return Err(budget());
+        }
+        for (path, blob) in snapshot.files() {
+            if documents.contains_key(path) {
+                continue;
+            }
+            source_bytes = source_bytes
+                .checked_add(blob.bytes().len())
+                .filter(|n| *n <= MAX_BYTES)
+                .ok_or_else(budget)?;
+            stamps.insert(
+                InputKey::SourceBlob(blob.content()),
+                InputValue::SourceBlob(blob.clone()).fingerprint(),
+            );
+            documents.insert(path.clone(), blob.clone());
+        }
+        let texts: Vec<_> = pinned_sources()
+            .into_iter()
+            .map(|(path, _)| Ok((path, documents[&SourcePath::new(path)?].text()?)))
+            .collect::<Result<Vec<_>, Diagnostic>>()?;
+        let catalog = ValuePreludeCatalog::from_sources(&texts)?.identity();
+        for view in [Some(consumer), Some(core), Some(standard), allocation]
+            .into_iter()
+            .flatten()
+        {
+            for (key, value) in view.prepared_inputs() {
+                if matches!(key, InputKey::ValueLibrarySelection(_)) {
+                    return Err(fault(
+                        "selection must be captured before an older library input is retained",
+                    ));
+                }
+                let fingerprint = value.fingerprint();
+                if stamps
+                    .insert(key.clone(), fingerprint)
+                    .is_some_and(|old| old != fingerprint)
+                {
+                    return Err(fault("Value-library captured input facts conflict"));
+                }
+            }
+        }
+        if stamps.len() > 100_000 {
+            return Err(budget());
+        }
+        let mut encoded = StableEncoder::new("lrr/v1/selected-live-value-library-source-seal");
+        encoded.record(consumer.selection());
+        encoded.record(core.selection());
+        encoded.record(standard.selection());
+        encoded.option(&allocation, |encoded, allocation| {
+            encoded.record(allocation.selection())
+        });
+        encoded.digest(snapshot.id());
+        encoded.digest(graph.fingerprint());
+        encoded.digest(catalog);
+        encoded.bool(policy.standard);
+        for (path, blob) in &documents {
+            encoded.string(path.as_str());
+            encoded.digest(blob.content());
+        }
+        let source_seal = encoded.finish();
+        let mut bytes = std::mem::size_of::<Self>();
+        for source in [
+            Some(consumer.selection()),
+            Some(core.selection()),
+            Some(standard.selection()),
+            allocation.map(PreparedSourceView::selection),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            bytes = bytes
+                .checked_add(source.metadata_bytes()?)
+                .ok_or_else(budget)?;
+        }
+        for path in documents.keys() {
+            bytes = bytes
+                .checked_add(128 + std::mem::size_of::<(SourcePath, SourceBlob)>())
+                .and_then(|n| n.checked_add(path.as_str().len()))
+                .filter(|n| *n <= MAX_BYTES)
+                .ok_or_else(budget)?;
+        }
+        for key in stamps.keys() {
+            bytes = bytes
+                .checked_add(128 + std::mem::size_of::<(InputKey, Digest)>())
+                .and_then(|n| n.checked_add(key.heap_bytes()))
+                .filter(|n| *n <= MAX_BYTES)
+                .ok_or_else(budget)?;
+        }
+        Ok(Self {
+            consumer: consumer.selection().clone(),
+            core: core.selection().clone(),
+            standard: standard.selection().clone(),
+            allocation: allocation.map(|view| view.selection().clone()),
+            snapshot: snapshot.id(),
+            graph: graph.fingerprint(),
+            catalog,
+            source_seal,
+            documents,
+            stamps,
+            bytes,
+        })
+    }
+    pub(crate) fn consumer(&self) -> &SourceSelection {
+        &self.consumer
+    }
+    pub(crate) fn provider(&self, standard: bool) -> &SourceSelection {
+        if standard { &self.standard } else { &self.core }
+    }
+    pub(crate) fn allocation_provider(&self) -> Option<&SourceSelection> {
+        self.allocation.as_ref()
+    }
+    pub(crate) fn catalog_identity(&self) -> Digest {
+        self.catalog
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn observed_source(&self, path: &SourcePath) -> Option<Digest> {
+        self.documents.get(path).map(SourceBlob::content)
+    }
+    pub(crate) fn blobs(&self) -> impl Iterator<Item = &SourceBlob> {
+        self.documents.values()
+    }
+    pub(crate) fn validate_current(
+        &self,
+        db: &Database,
+        consumer: &PreparedSourceView,
+    ) -> Result<(), Diagnostic> {
+        if consumer.selection() != &self.consumer {
+            return Err(fault(
+                "selected Value-library consumer/source/profile differs",
+            ));
+        }
+        if !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(graph),_)) if graph.fingerprint()==self.graph)
+        {
+            return Err(fault(
+                "selected Value-library source dependency world changed",
+            ));
+        }
+        for (key, expected) in &self.stamps {
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != *expected)
+            {
+                return Err(fault(
+                    "selected Value-library captured source/profile/cfg/input changed",
+                ));
+            }
+        }
+        Ok(())
+    }
+}
+impl StableEncode for PreparedValueLibrarySelection {
+    const DOMAIN: &'static str = "lrr/v1/selected-live-value-library-input";
+    fn encode_fields(&self, encoded: &mut StableEncoder) {
+        encoded.u32(1); // live source lane, never installed/native sysroot
+        encoded.record(&self.consumer);
+        encoded.record(&self.core);
+        encoded.record(&self.standard);
+        encoded.option(&self.allocation, |encoded, source| encoded.record(source));
+        encoded.digest(self.snapshot);
+        encoded.digest(self.graph);
+        encoded.digest(self.catalog);
+        encoded.digest(self.source_seal);
+        encoded.u64(
+            u64::try_from(self.documents.len())
+                .expect("bounded actually captured source documents"),
+        );
+        for (path, blob) in &self.documents {
+            encoded.string(path.as_str());
+            encoded.digest(blob.content());
+        }
+        encoded.u64(u64::try_from(self.stamps.len()).expect("bounded selected library stamps"));
+        for (key, value) in &self.stamps {
+            encoded.record(key);
+            encoded.digest(*value);
+        }
+    }
+}
+
+/// Explicitly selected packaged *live prelude source* generation. The immutable
+/// bundle contains complete prelude export spellings, not the entire std/core
+/// runtime/Value declaration catalogue. Uncaptured target kinds stay unresolved.
+/// This selects licensed source metadata; it never matches an installed sysroot.
+pub(crate) fn packaged_live_prelude_snapshot(
+    consumer_profile: &crate::core::profile::ProfileIdentity,
+) -> Result<Snapshot, Diagnostic> {
+    consumer_profile.validate_source()?;
+    let catalog = ValuePreludeCatalog::pinned()?;
+    let cfg = crate::source::snapshot::CfgSet::guest_default();
+    let mut files = BTreeMap::new();
+    let mut crates = BTreeMap::new();
+    let mut cfgs = BTreeMap::new();
+    let mut selected = None;
+    for (path, text) in pinned_sources()
+        .into_iter()
+        .chain([("library/core/src/lib.rs", CORE_ROOT)])
+    {
+        files.insert(
+            SourcePath::new(path)?,
+            SourceBlob::new(text.as_bytes().to_vec())?,
+        );
+    }
+    for (name, index) in [("core", 8), ("std", 9)] {
+        let manifest: toml::Value = toml::from_str(pinned_sources()[index].1)
+            .map_err(|_| fault("packaged library owning Cargo metadata syntax differs"))?;
+        let package = manifest
+            .get("package")
+            .ok_or_else(|| fault("packaged library Cargo package absent"))?;
+        let actual_name = package
+            .get("name")
+            .and_then(toml::Value::as_str)
+            .ok_or_else(|| fault("packaged library Cargo name absent"))?;
+        let version = package
+            .get("version")
+            .and_then(toml::Value::as_str)
+            .ok_or_else(|| fault("packaged library Cargo version absent"))?;
+        let edition = package
+            .get("edition")
+            .and_then(toml::Value::as_str)
+            .ok_or_else(|| fault("packaged library Cargo edition absent"))?
+            .parse::<u16>()
+            .map_err(|_| fault("packaged library Cargo edition invalid"))?;
+        if actual_name != name || edition != 2024 {
+            return Err(fault(
+                "packaged source library owning Cargo identity/edition differs",
+            ));
+        }
+        let profile = crate::core::profile::ProfileIdentity {
+            edition,
+            semantics: consumer_profile.semantics.clone(),
+        };
+        let key = crate::source::manifest::CrateKey {
+            package: crate::source::manifest::PackageKey {
+                source_identity: format!("lrr-packaged-live-prelude-source:{}", catalog.identity()),
+                package_name: actual_name.into(),
+                version: version.into(),
+            },
+            target_kind: TargetKind::Library,
+            target_name: actual_name.into(),
+            guest_edition: edition,
+            semantics_profile: profile.fingerprint(),
+            cfg_fingerprint: cfg.fingerprint(),
+            dependency_aliases: Digest::of_bytes(b""),
+        };
+        let identity = key.fingerprint();
+        if name == "std" {
+            selected = Some(identity);
+        }
+        crates.insert(identity, key);
+        cfgs.insert(identity, cfg.clone());
+    }
+    Snapshot::new(
+        crate::source::snapshot::ProjectManifest {
+            identity: format!(
+                "explicit-selected-live-prelude-source:{}",
+                catalog.identity()
+            ),
+            root_source: SourcePath::new("library/std/src/lib.rs")?,
+            selected_crate: selected.ok_or_else(|| fault("packaged source std root absent"))?,
+            crates,
+        },
+        files,
+        cfgs,
+        BTreeMap::new(),
+        None,
+    )
+}
diff --git a/crates/lrr/src/frontend/value_library_admission.rs b/crates/lrr/src/frontend/value_library_admission.rs
