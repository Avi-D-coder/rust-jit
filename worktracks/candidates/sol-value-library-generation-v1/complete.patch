diff --git a/crates/lrr/src/source/value_library_prepare.rs b/crates/lrr/src/source/value_library_prepare.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/source/value_library_prepare.rs
@@ -0,0 +1,388 @@
+//! Pure explicit source preparation hook; no file reads, provider or tool effects.
+use super::*;
+use crate::db::dependency::{InputKey, InputValue};
+use crate::{
+    core::digest::StableEncode,
+    source::{
+        dependencies::SourceDependency, snapshot::Snapshot,
+        value_library_selection::PreparedValueLibrarySelection,
+    },
+};
+use std::{collections::BTreeMap, sync::Arc};
+impl PreparedSourceInputs {
+    /// Separately reviewed standalone source-preparation attachment: explicitly
+    /// choose the packaged live prelude source world, not the host sysroot. No
+    /// declaration kind or uncaptured std/core Value membership is invented.
+    pub(crate) fn with_packaged_live_value_libraries(
+        self,
+        consumer: &SourceSelection,
+    ) -> Result<Self, Diagnostic> {
+        let library = crate::source::value_library_selection::packaged_live_prelude_snapshot(
+            &consumer.outline.parse.profile,
+        )?;
+        self.with_pinned_live_value_libraries(consumer, &library)
+    }
+
+    /// Called explicitly by source preparation after capturing the selected live
+    /// library source bundle. This chooses an interpreter source facade/library,
+    /// not the installed host sysroot or a macro facade. It never guesses a match.
+    pub(crate) fn with_pinned_live_value_libraries(
+        self,
+        consumer: &SourceSelection,
+        library: &Snapshot,
+    ) -> Result<Self, Diagnostic> {
+        if self.state._module_origin.is_some() || self.state._ordinary_module_origin.is_some() {
+            return Err(publication_fault(
+                "generated Value-library selection needs separate admission",
+            ));
+        }
+        let SourceSelectionOutcome::Selected(root) = self.select(consumer)? else {
+            return Err(publication_fault(
+                "Value-library consumer root selection changed",
+            ));
+        };
+        if root.outline().items.iter().any(|item| {
+            item.header
+                .attributes
+                .iter()
+                .any(|attribute| attribute.name == "prelude_import")
+        }) {
+            return Err(publication_fault(
+                "custom prelude_import Value-library selection needs actual source admission",
+            ));
+        }
+        if !consumer.outline.module_path.is_empty() {
+            return Err(publication_fault(
+                "Value-library source preparation requires selected consumer root",
+            ));
+        }
+        if self.state.inputs.keys().any(|key| {
+            matches!(
+                key,
+                InputKey::ValueLibrarySelection(_)
+                    | InputKey::DiscoverySeal(_)
+                    | InputKey::GeneratedSyntax(_)
+            )
+        }) {
+            return Err(publication_fault(
+                "Value-library source preparation must precede discovery/old selection",
+            ));
+        }
+        let mut library_roots = BTreeMap::new();
+        for name in ["core", "std", "alloc"] {
+            let mut candidates = library.project().crates.iter().filter(|(_, key)| {
+                key.package.package_name == name
+                    && key.target_name == name
+                    && key.target_kind == crate::source::manifest::TargetKind::Library
+            });
+            let first = candidates.next();
+            if name == "alloc" && first.is_none() {
+                continue;
+            }
+            let (identity, key) = first.ok_or_else(|| {
+                publication_fault("captured live Value-library crate root absent")
+            })?;
+            if candidates.next().is_some()
+                || key.fingerprint() != *identity
+                || key.guest_edition != 2024
+            {
+                return Err(publication_fault(
+                    "captured live Value-library root/profile is ambiguous or unsupported",
+                ));
+            }
+            let cfg = library
+                .cfg_by_crate()
+                .get(identity)
+                .ok_or_else(|| publication_fault("captured Value-library owning cfg absent"))?;
+            let profile = crate::core::profile::ProfileIdentity {
+                edition: 2024,
+                semantics: consumer.outline.parse.profile.semantics.clone(),
+            };
+            let path = SourcePath::new(format!("library/{name}/src/lib.rs"))?;
+            let blob = library
+                .files()
+                .get(&path)
+                .ok_or_else(|| publication_fault("captured Value-library root file absent"))?;
+            if key.cfg_fingerprint != cfg.fingerprint()
+                || key.semantics_profile != profile.fingerprint()
+            {
+                return Err(publication_fault(
+                    "selected Value-library source profile/cfg differs",
+                ));
+            }
+            library_roots.insert(
+                name,
+                SourceUnitInput {
+                    path,
+                    crate_key: *identity,
+                    module_path: vec![],
+                    profile,
+                    cfg: cfg.clone(),
+                    blob: blob.clone(),
+                },
+            );
+        }
+        let mut units = Vec::new();
+        units
+            .try_reserve_exact(
+                self.state.files.len().checked_add(2).ok_or_else(|| {
+                    publication_fault("Value-library source context count overflow")
+                })?,
+            )
+            .map_err(|_| publication_fault("Value-library source context allocation"))?;
+        for (location, file) in &self.state.files {
+            let Some(InputValue::SourceBlob(blob)) = self
+                .state
+                .inputs
+                .get(&InputKey::SourceBlob(file.key.parse.content))
+            else {
+                return Err(publication_fault(
+                    "original source blob absent during Value-library preparation",
+                ));
+            };
+            let Some(InputValue::CrateCfg(cfg)) = self
+                .state
+                .inputs
+                .get(&InputKey::CrateCfg(location.crate_key))
+            else {
+                return Err(publication_fault(
+                    "original source cfg absent during Value-library preparation",
+                ));
+            };
+            units.push(SourceUnitInput {
+                path: location.path.clone(),
+                crate_key: location.crate_key,
+                module_path: location.module_path.clone(),
+                profile: file.key.parse.profile.clone(),
+                cfg: cfg.clone(),
+                blob: blob.clone(),
+            });
+        }
+        let mut dependencies = root.source_dependencies()?.copy_rows()?;
+        let policy = root.macro_prelude_policy()?;
+        if policy.disabled.iter().any(Vec::is_empty) {
+            return Err(publication_fault(
+                "automatic live library selection disabled; explicitly selected dependency lane required",
+            ));
+        }
+        let mut required = vec![
+            (consumer.outline.crate_key, "core"),
+            (library_roots["std"].crate_key, "core"),
+        ];
+        if policy.standard
+            || root
+                .outline()
+                .extern_crates
+                .iter()
+                .any(|row| row.dependency == "std")
+        {
+            required.push((consumer.outline.crate_key, "std"));
+        }
+        if let Some(allocation) = library_roots.get("alloc") {
+            required.push((library_roots["std"].crate_key, "alloc"));
+            required.push((allocation.crate_key, "core"));
+        }
+        for (owner, name) in required {
+            let target = library_roots[name].crate_key;
+            if dependencies
+                .iter()
+                .any(|row| row.consumer == owner && row.alias == name && row.provider != target)
+            {
+                return Err(publication_fault(
+                    "existing source dependency selects another Value-library provider",
+                ));
+            }
+            if !dependencies
+                .iter()
+                .any(|row| row.consumer == owner && row.alias == name)
+            {
+                dependencies.push(SourceDependency {
+                    consumer: owner,
+                    alias: name.into(),
+                    provider: target,
+                });
+            }
+        }
+        for unit in library_roots.into_values() {
+            if units
+                .iter()
+                .any(|old| old.crate_key == unit.crate_key && old.module_path.is_empty())
+            {
+                if !units.iter().any(|old| {
+                    old.crate_key == unit.crate_key
+                        && old.path == unit.path
+                        && old.profile == unit.profile
+                        && old.cfg == unit.cfg
+                        && old.blob.content() == unit.blob.content()
+                }) {
+                    return Err(publication_fault("existing selected library root differs"));
+                }
+            } else {
+                units.push(unit);
+            }
+        }
+        let environment = self
+            .state
+            .inputs
+            .iter()
+            .filter_map(|(key, value)| match (key, value) {
+                (InputKey::CompileEnv(name), InputValue::CompileEnv(value)) => {
+                    Some((name.clone(), value.clone()))
+                }
+                _ => None,
+            })
+            .collect();
+        let mut prepared =
+            Self::refresh_with_dependencies(Some(&self), units, environment, dependencies)?;
+        for value in self.state.inputs.values() {
+            if let InputValue::UnitCompileEnv(environment) = value {
+                prepared = prepared.with_compile_environment(environment.clone())?;
+            }
+        }
+        prepared.with_selected_live_value_libraries(consumer, library)
+    }
+    /// Existing selected dependency lane. Never adds or overrides source aliases;
+    /// the immutable captured roots/graph must already establish the library.
+    /// This is raw source generation authority and is usable independently of
+    /// NoImplicit/custom prelude policy. It grants no pattern membership itself.
+    pub(crate) fn with_selected_live_value_libraries(
+        self,
+        consumer: &SourceSelection,
+        library: &Snapshot,
+    ) -> Result<Self, Diagnostic> {
+        if self.state._module_origin.is_some()
+            || self.state._ordinary_module_origin.is_some()
+            || self.state.inputs.keys().any(|key| {
+                matches!(
+                    key,
+                    InputKey::ValueLibrarySelection(_)
+                        | InputKey::DiscoverySeal(_)
+                        | InputKey::GeneratedSyntax(_)
+                )
+            })
+        {
+            return Err(publication_fault(
+                "selected source-library capture must precede derived/generated publication",
+            ));
+        }
+        let SourceSelectionOutcome::Selected(consumer) = self.select(consumer)? else {
+            return Err(publication_fault(
+                "Value-library consumer changed during pure preparation",
+            ));
+        };
+        let mut providers = BTreeMap::new();
+        for name in ["core", "std", "alloc"] {
+            let mut candidates = library.project().crates.iter().filter(|(_, key)| {
+                key.package.package_name == name
+                    && key.target_name == name
+                    && key.target_kind == crate::source::manifest::TargetKind::Library
+            });
+            let Some((unit, _)) = candidates.next() else {
+                if name == "alloc" {
+                    continue;
+                }
+                return Err(publication_fault("selected live library crate absent"));
+            };
+            if candidates.next().is_some() {
+                return Err(publication_fault("selected live library crate ambiguous"));
+            }
+            let mut roots = self.state.files.iter().filter(|(location, _)| {
+                location.crate_key == *unit && location.module_path.is_empty()
+            });
+            let (location, file) = roots
+                .next()
+                .ok_or_else(|| publication_fault("selected live library root source absent"))?;
+            if roots.next().is_some() {
+                return Err(publication_fault(
+                    "selected live library root source ambiguous",
+                ));
+            }
+            let selection = SourceSelection {
+                path: location.path.clone(),
+                outline: file.key.clone(),
+            };
+            let SourceSelectionOutcome::Selected(view) = self.select(&selection)? else {
+                return Err(publication_fault("selected live library root changed"));
+            };
+            providers.insert(name, view);
+        }
+        let selection = Arc::new(PreparedValueLibrarySelection::capture_live_source(
+            &consumer,
+            &providers["core"],
+            &providers["std"],
+            providers.get("alloc"),
+            library,
+        )?);
+        let mut bytes = self
+            .state
+            .file_metadata_bytes()?
+            .checked_add(selection.metadata_bytes())
+            .ok_or_else(|| publication_fault("Value-library publication metadata overflow"))?;
+        for value in self.state.inputs.values() {
+            bytes = bytes
+                .checked_add(value.estimated_bytes()?)
+                .filter(|n| *n <= 64 * 1024 * 1024)
+                .ok_or_else(|| publication_fault("Value-library publication metadata limit"))?;
+        }
+        // Charge newly staged input records too, before publishing the owning
+        // immutable Arc. Source buffer bytes are separately bounded/accounted.
+        bytes = bytes
+            .checked_add(128 + std::mem::size_of::<(InputKey, InputValue)>())
+            .filter(|n| *n <= 64 * 1024 * 1024)
+            .ok_or_else(|| publication_fault("Value-library selection input record budget"))?;
+        for blob in selection.blobs() {
+            if !self
+                .state
+                .inputs
+                .contains_key(&InputKey::SourceBlob(blob.content()))
+            {
+                bytes = bytes
+                    .checked_add(128 + std::mem::size_of::<(InputKey, InputValue)>())
+                    .filter(|n| *n <= 64 * 1024 * 1024)
+                    .ok_or_else(|| {
+                        publication_fault("Value-library source document input record budget")
+                    })?;
+            }
+        }
+        let mut state = PreparedSourceState {
+            _module_origin: None,
+            _ordinary_module_origin: None,
+            inputs: self.state.inputs.clone(),
+            files: self
+                .state
+                .files
+                .iter()
+                .map(|(location, file)| {
+                    (
+                        location.clone(),
+                        PublishedFile {
+                            key: file.key.clone(),
+                            parsed: file.parsed.clone(),
+                            outline: file.outline.clone(),
+                        },
+                    )
+                })
+                .collect(),
+            parses: self.state.parses.clone(),
+            outlines: self.state.outlines.clone(),
+        };
+        for blob in selection.blobs() {
+            insert_input(
+                &mut state.inputs,
+                InputKey::SourceBlob(blob.content()),
+                InputValue::SourceBlob(blob.clone()),
+            )?;
+        }
+        insert_input(
+            &mut state.inputs,
+            InputKey::ValueLibrarySelection(consumer.selection().outline.crate_key),
+            InputValue::ValueLibrarySelection(selection),
+        )?;
+        Ok(Self {
+            state: Arc::new(state),
+            parsed_files: self.parsed_files,
+            outlined_files: self.outlined_files,
+            reused_files: self.reused_files,
+        })
+    }
+}
