new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/frontend/source_view_library_admission_tests.rs
@@ -0,0 +1,728 @@
+//! Preregistered genuine captured-source component acceptance, never stock runtime pass.
+use super::super::tests::{COPY, INFER, runtime_environment, site, world_unsealed};
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    expand::source_discovery::{SourceDiscovery, SourceDiscoveryStep},
+    facade::value_prelude::{ValuePreludeCatalog, pinned_sources},
+    frontend::value_library_admission::CurrentValueLibraryAdmission,
+    source::{
+        changes::{PreparedSourceInputs, SourceSelectionOutcome, SourceUnitInput},
+        manifest::{CrateKey, PackageKey, TargetKind},
+        snapshot::{CfgSet, ProjectManifest, Snapshot, SourceBlob, SourcePath},
+    },
+};
+use std::sync::Arc;
+fn library_snapshot() -> Snapshot {
+    let profile = ProfileIdentity::current();
+    let cfg = CfgSet::guest_default();
+    let mut crates = BTreeMap::new();
+    let mut cfgs = BTreeMap::new();
+    let mut selected = None;
+    for name in ["core", "std"] {
+        let key = CrateKey {
+            package: PackageKey {
+                source_identity:
+                    "actual captured pinned rustc source facade; not installed sysroot".into(),
+                package_name: name.into(),
+                version: "0.0.0".into(),
+            },
+            target_kind: TargetKind::Library,
+            target_name: name.into(),
+            guest_edition: 2024,
+            semantics_profile: profile.fingerprint(),
+            cfg_fingerprint: cfg.fingerprint(),
+            dependency_aliases: Digest::of_bytes(b""),
+        };
+        let identity = key.fingerprint();
+        if name == "std" {
+            selected = Some(identity);
+        }
+        crates.insert(identity, key);
+        cfgs.insert(identity, cfg.clone());
+    }
+    let mut files: BTreeMap<_, _> = pinned_sources()
+        .into_iter()
+        .map(|(path, text)| {
+            (
+                SourcePath::new(path).unwrap(),
+                SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+            )
+        })
+        .collect();
+    files.insert(
+        SourcePath::new("library/core/src/lib.rs").unwrap(),
+        SourceBlob::new(
+            include_str!("../facade/value_prelude_sources/library/core/src/lib.rs")
+                .as_bytes()
+                .to_vec(),
+        )
+        .unwrap(),
+    );
+    Snapshot::new(
+        ProjectManifest {
+            identity: "selected live source-library generation fixture".into(),
+            root_source: SourcePath::new("library/std/src/lib.rs").unwrap(),
+            selected_crate: selected.unwrap(),
+            crates,
+        },
+        files,
+        cfgs,
+        BTreeMap::new(),
+        None,
+    )
+    .unwrap()
+}
+fn prepared(
+    text: &str,
+    function: &str,
+    edition: u16,
+) -> (PreparedSourceInputs, SourceSelection, Snapshot) {
+    let (_, view, _, _, _, _, _) = world_unsealed(text, function, edition);
+    let input = SourceUnitInput {
+        path: view.selection().path.clone(),
+        crate_key: view.selection().outline.crate_key,
+        module_path: vec![],
+        profile: view.selection().outline.parse.profile.clone(),
+        cfg: view.captured_macro_cfg().unwrap().clone(),
+        blob: view.captured_macro_blob().unwrap().clone(),
+    };
+    let prepared = PreparedSourceInputs::refresh(None, vec![input], BTreeMap::new()).unwrap();
+    (prepared, view.selection().clone(), library_snapshot())
+}
+fn select(prepared: &PreparedSourceInputs, selection: &SourceSelection) -> PreparedSourceView {
+    let SourceSelectionOutcome::Selected(view) = prepared.select(selection).unwrap() else {
+        panic!()
+    };
+    view
+}
+fn seal(db: &mut Database, view: &PreparedSourceView, world: Digest) {
+    let mut discovery = SourceDiscovery::new(
+        vec![view.share()],
+        view.outline().root_scope.clone(),
+        Namespace::Value,
+        world,
+        1,
+    )
+    .unwrap()
+    .with_declarative_compiler(
+        Digest::of_bytes(b"actual source library declaration compiler"),
+        Digest::of_bytes(b"actual source library compiler profile"),
+        Arc::new(
+            crate::frontend::compile_input_catalog::CompileInputCatalog::standalone(
+                &view.selection().outline.parse.profile,
+            )
+            .unwrap(),
+        ),
+    )
+    .unwrap();
+    loop {
+        match discovery.poll().unwrap() {
+            SourceDiscoveryStep::Sealed(_) => break,
+            _ => panic!("unestablished macro/generated library scope prerequisite"),
+        }
+    }
+    discovery.publish(db).unwrap();
+}
+fn retain_no_items(
+    db: &Database,
+    view: &PreparedSourceView,
+    owner: &DefinitionSourcePlan,
+    entered: &mut crate::frontend::source_macros::EnteredMacroIndex<'_>,
+) {
+    let published = db
+        .source_view_scope_certificate(view.selection(), &owner.signature().scope)
+        .unwrap();
+    let InputValue::DiscoverySeal(input) = published.as_ref() else {
+        panic!()
+    };
+    for (_, proof) in input
+        .runtime_no_item_proofs
+        .iter()
+        .filter(|(_, proof)| proof.body() == &owner.body().key())
+    {
+        let catalog =
+            crate::frontend::runtime_macro_catalog::RuntimeMacroCatalog::standard_for_definition(
+                &view.selection().outline.parse.profile,
+                proof.definition(),
+            )
+            .unwrap();
+        entered
+            .accept_no_item_proof(view.selection(), &owner.body().key(), proof, &catalog)
+            .unwrap();
+    }
+}
+fn selected(
+    text: &str,
+    function: &str,
+    edition: u16,
+) -> (
+    Database,
+    PreparedSourceView,
+    crate::frontend::source_macros::PublishedMacroIndex,
+    NameNamespaces,
+    ParsedFile,
+    BodyIndex,
+    Arc<DefinitionSourcePlan>,
+) {
+    let (prepared, selection, library) = prepared(text, function, edition);
+    let prepared = prepared
+        .with_pinned_live_value_libraries(&selection, &library)
+        .unwrap();
+    let view = select(&prepared, &selection);
+    let mut db = Database::default();
+    db.trace.detailed = true;
+    prepared.publish(&mut db).unwrap();
+    seal(
+        &mut db,
+        &view,
+        Digest::of_bytes(b"actual selected source-library consumer world"),
+    );
+    let graph = NameNamespaces::from_outlines(&[view.outline()]).unwrap();
+    let (context, hygiene) =
+        crate::syntax::floating_fixture_hygiene::root(selection.outline.crate_key, edition);
+    let published = crate::frontend::source_macros::PublishedMacroIndex::from_view(
+        view.share(),
+        context,
+        hygiene,
+    )
+    .unwrap();
+    let parsed = db.prepared_parse(&selection.outline.parse).unwrap();
+    let item = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == function)
+        .unwrap();
+    let owner = Arc::new(
+        parsed
+            .source_view_definition_plan(
+                item.body.as_ref().unwrap(),
+                &item.header,
+                &crate::syntax::outline::DeclarationContext {
+                    scope: item.scope.clone(),
+                    range: item.declaration_span,
+                },
+            )
+            .unwrap(),
+    );
+    let index = parsed.index_body(owner.body(), Default::default()).unwrap();
+    // The parser Arc is an immutable lease; reconstructing a pure pinned syntax
+    // value here does not query any future body or execute a provider.
+    let parsed = ParsedFile::parse(
+        view.captured_macro_blob().unwrap(),
+        selection.outline.parse.profile.clone(),
+    )
+    .unwrap();
+    (db, view, published, graph, parsed, index, owner)
+}
+#[test]
+fn original_copy_default_prelude_alias_has_genuine_selected_source_authority_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view, published, names, parsed, index, owner) =
+            selected(COPY, "can_copy_copy", edition);
+        let mut entered = published
+            .enter_body(view.selection(), &owner.body().key())
+            .unwrap();
+        retain_no_items(&db, &view, &owner, &mut entered);
+        let patterns =
+            CurrentPatternNames::prepare(&db, &view, &owner, &entered, &names, SOURCE_VIEW_BUDGET)
+                .unwrap();
+        let locals = entered
+            .local_index(
+                view.selection(),
+                &owner.body().key(),
+                patterns.resolutions(),
+                &[],
+            )
+            .unwrap();
+        let env = runtime_environment(&owner);
+        let alias = parsed
+            .source_view_alias_plan(
+                &owner,
+                &index,
+                &site(
+                    COPY,
+                    &owner,
+                    &index,
+                    "let _a = v;",
+                    crate::ir::pc::Phase::Commit,
+                ),
+            )
+            .unwrap();
+        let seed = declared_binding_view(
+            &db,
+            &parsed,
+            &index,
+            &view,
+            &names,
+            &locals,
+            owner.clone(),
+            &alias.source,
+            Some(&env),
+            TypeId(6),
+            SOURCE_VIEW_BUDGET,
+        )
+        .unwrap();
+        let plan = local_alias_view(
+            &db,
+            &view,
+            &names,
+            &locals,
+            owner,
+            &alias,
+            &seed,
+            SOURCE_VIEW_BUDGET,
+        )
+        .unwrap();
+        let before = db.trace.events.len();
+        let proof = plan
+            .admit_current(&db, &view, Some(&env), SOURCE_VIEW_BUDGET)
+            .unwrap();
+        assert_eq!(proof.source().term(), seed.source.term());
+        assert!(matches!(proof.source().term(), TyTerm::Param(_)));
+        assert_eq!(proof.runtime(), TypeId(6));
+        proof.revalidate(&db, &view, Some(&env), &plan).unwrap();
+        assert_eq!(db.trace.events.len(), before);
+        assert!(db.trace.events.iter().all(|event| !matches!(
+            event.key,
+            crate::db::key::QueryKey::BodyStructure(_) | crate::db::key::QueryKey::Thunk(_)
+        )));
+    }
+}
