--- /dev/null
+++ b/crates/lrr/src/frontend/value_library_admission.rs
@@ -0,0 +1,218 @@
+//! Current joined source-library generation and consumer Value discovery authority.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::{
+        dependency::{InputKey, InputValue},
+        memo::Database,
+        seals::{SealDomain, SealKey},
+    },
+    facade::value_prelude::ValuePreludeCatalog,
+    source::{
+        changes::{PreparedSourceView, SourceSelection},
+        snapshot::SourcePath,
+        value_library_selection::PreparedValueLibrarySelection,
+    },
+    syntax::outline::ScopeKey,
+};
+use std::sync::Arc;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-SOURCE-TYPE-CONTEXT", message.into())
+}
+/// Private-mintable immutable proof over the exact published preparation input.
+/// It grants only the selected closed prelude spelling world, not a trait member,
+/// static checker, native generation, arbitrary foreign symbol or SourceViewId.
+#[derive(Debug)]
+pub(crate) struct CurrentValueLibraryAdmission {
+    selection: Arc<PreparedValueLibrarySelection>,
+    publication: Digest,
+    seal: SealKey,
+    seal_fingerprint: Digest,
+    world: Digest,
+    scope: ScopeKey,
+    standard: bool,
+    bytes: usize,
+}
+impl CurrentValueLibraryAdmission {
+    pub(crate) fn capture_current(
+        db: &Database,
+        source: &PreparedSourceView,
+        scope: &ScopeKey,
+        catalog: &ValuePreludeCatalog,
+    ) -> Result<Self, Diagnostic> {
+        let key = InputKey::ValueLibrarySelection(source.selection().outline.crate_key);
+        let (InputValue::ValueLibrarySelection(selection),publication)=db.published_input(&key).ok_or_else(||fault("matched selected live Value-library generation input absent; macro/sysroot facets are insufficient"))? else{return Err(fault("selected Value-library input variant differs"));};
+        selection.validate_current(db, source)?;
+        if selection.catalog_identity() != catalog.identity() {
+            return Err(fault(
+                "selected Value-library export catalog/generation differs",
+            ));
+        }
+        let captured =
+            crate::facade::value_prelude::CapturedValuePreludePolicy::capture(db, source, scope)?;
+        if captured
+            .catalog()
+            .is_none_or(|actual| actual.identity() != catalog.identity())
+        {
+            return Err(fault(
+                "custom/disabled or mismatched Value-prelude policy needs separate source admission",
+            ));
+        }
+        let policy = source.macro_prelude_policy()?;
+        if scope.owner.is_some()
+            || scope.crate_key != source.selection().outline.crate_key
+            || policy
+                .disabled
+                .iter()
+                .any(|prefix| scope.module_path.starts_with(prefix))
+        {
+            return Err(fault(
+                "Value-library current admission requires the exact implicit module policy",
+            ));
+        }
+        let published = db.source_view_scope_certificate(source.selection(), scope)?;
+        let InputValue::DiscoverySeal(input) = published.as_ref() else {
+            return Err(fault("Value-library consumer Value seal variant differs"));
+        };
+        let declared = input
+            .scope
+            .as_ref()
+            .ok_or_else(|| fault("Value-library exact consumer scope certificate absent"))?;
+        let seal = input.seal.key();
+        seal.validate()?;
+        if declared.scope != *scope
+            || declared.namespace != crate::source::manifest::Namespace::Value
+            || declared.edition != source.selection().outline.parse.profile.edition
+            || !matches!(input.seal.domain(),SealDomain::Scope{id,namespace} if *id==scope.fingerprint()&&*namespace==crate::source::manifest::Namespace::Value)
+            || input.sources.len() != 1
+            || input.sources[0] != *source.selection()
+            || input.seal.unresolved_frontiers() != 0
+        {
+            return Err(fault(
+                "Value-library current consumer source/scope/profile/edition/world differs",
+            ));
+        }
+        if !matches!(db.published_input(&InputKey::ExpansionEpoch),Some((InputValue::ExpansionEpoch(epoch),_)) if *epoch==seal.epoch)
+        {
+            return Err(fault("Value-library current expansion epoch changed"));
+        }
+        if !matches!(db.published_input(&InputKey::SourceDependencies),Some((InputValue::SourceDependencies(graph),_)) if graph.fingerprint()==input.source_dependencies)
+        {
+            return Err(fault(
+                "Value-library current source dependency world changed",
+            ));
+        }
+        for (key, expected) in &input.compiler_inputs {
+            if db
+                .published_input(key)
+                .is_none_or(|(_, actual)| actual != *expected)
+            {
+                return Err(fault(
+                    "Value-library current compiler/source selection facts changed",
+                ));
+            }
+        }
+        if !input.records.is_empty()
+            || !input.procedural_catalogs.is_empty()
+            || !input.helper_declarations.is_empty()
+            || !input.argument_fragments.is_empty()
+            || !input.declaration_fragments.is_empty()
+        {
+            return Err(fault(
+                "generated/native/foreign Value-library selection needs separate admission",
+            ));
+        }
+        let bytes = std::mem::size_of::<Self>()
+            .checked_add(selection.metadata_bytes())
+            .and_then(|n| n.checked_add(scope.heap_bytes()))
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(|| {
+                Diagnostic::new(
+                    "LRR-E-METADATA-LIMIT",
+                    "Value-library current admission metadata budget".into(),
+                )
+            })?;
+        Ok(Self {
+            selection: selection.clone(),
+            publication,
+            seal,
+            seal_fingerprint: published.fingerprint(),
+            world: input.seal.key().unit_graph,
+            scope: scope.clone(),
+            standard: policy.standard,
+            bytes,
+        })
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        let mut encoded = StableEncoder::new("lrr/v1/current-live-value-library-admission");
+        encoded.digest(self.selection.fingerprint());
+        encoded.digest(self.publication);
+        encoded.record(&self.seal);
+        encoded.digest(self.seal_fingerprint);
+        encoded.digest(self.world);
+        encoded.record(&self.scope);
+        encoded.bool(self.standard);
+        encoded.finish()
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn provider(&self, standard: bool) -> &SourceSelection {
+        self.selection.provider(standard)
+    }
+    pub(crate) fn require_allocation_provider(&self) -> Result<&SourceSelection, Diagnostic> {
+        self.selection
+            .allocation_provider()
+            .ok_or_else(|| fault("actual selected alloc live source provider root/graph absent"))
+    }
+    pub(crate) fn require_automatic_absence(
+        &self,
+        catalog: &ValuePreludeCatalog,
+        standard: bool,
+        edition: u16,
+        name: &str,
+    ) -> Result<(), Diagnostic> {
+        if standard != self.standard
+            || edition != self.selection.consumer().outline.parse.profile.edition
+            || catalog.identity() != self.selection.catalog_identity()
+        {
+            return Err(fault(
+                "Value-library absence request owner/profile/policy/generation differs",
+            ));
+        }
+        if catalog.contains_export_spelling(standard, edition, name)? {
+            return Err(fault(
+                "present selected Value-prelude export needs source declaration-kind authority",
+            ));
+        }
+        Ok(())
+    }
+    /// Raw source observation only. An Index/Impl producer still needs actual
+    /// owning namespace, declaration/member and complete ImplCatalog seals.
+    pub(crate) fn require_observed_source(
+        &self,
+        path: &SourcePath,
+        content: Digest,
+    ) -> Result<(), Diagnostic> {
+        if self.selection.observed_source(path) != Some(content) {
+            return Err(fault(
+                "selected live Value-library source observation absent or mismatched",
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+        catalog: &ValuePreludeCatalog,
+    ) -> Result<(), Diagnostic> {
+        let fresh = Self::capture_current(db, source, &self.scope, catalog)?;
+        if fresh.identity() != self.identity() {
+            return Err(fault("selected live Value-library admission is stale"));
+        }
+        Ok(())
+    }
+}
