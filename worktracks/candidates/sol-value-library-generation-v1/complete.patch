+#[test]
+fn stable_selection_tag29_preserves_module_record28_and_all_digest_key_encodings() {
+    use crate::core::digest::StableEncoder;
+    let identity = Digest::of_bytes(b"same retained identity across key variants");
+    let old = InputKey::ModuleRecord(identity);
+    let new = InputKey::ValueLibrarySelection(identity);
+    let mut old_expected = StableEncoder::new("lrr/v2/input-key");
+    old_expected.u32(28);
+    old_expected.digest(identity);
+    assert_eq!(old.fingerprint(), old_expected.finish());
+    let mut new_expected = StableEncoder::new("lrr/v2/input-key");
+    new_expected.u32(29);
+    new_expected.digest(identity);
+    assert_eq!(new.fingerprint(), new_expected.finish());
+    let keys = [
+        new.clone(),
+        old.clone(),
+        InputKey::SourceBlob(identity),
+        InputKey::DefinitionSource(identity),
+        InputKey::DefinitionHeader(identity),
+        InputKey::DefinitionBody(identity),
+        InputKey::DeclarationContext(identity),
+        InputKey::CapturedSource(identity),
+        InputKey::GeneratedSyntax(identity),
+        InputKey::UnitCompileEnv(identity),
+        InputKey::ExpansionRecord(identity),
+        InputKey::IncludeRecord(identity),
+        InputKey::CrateCfg(identity),
+    ];
+    let hashes: std::collections::BTreeSet<_> =
+        keys.iter().map(StableEncode::fingerprint).collect();
+    assert_eq!(hashes.len(), keys.len());
+    for key in keys {
+        let text = serde_json::to_string(&key).unwrap();
+        let parsed: InputKey = serde_json::from_str(&text).unwrap();
+        assert_eq!(parsed, key);
+        if key != new {
+            assert_ne!(parsed, new);
+        }
+    }
+    assert!(serde_json::from_str::<InputKey>("{\"ValueLibrarySelectionV0\":[]}").is_err());
+    let (prepared, selection, snapshot) = prepared(COPY, "can_copy_copy", 2024);
+    let prepared = prepared
+        .with_pinned_live_value_libraries(&selection, &snapshot)
+        .unwrap();
+    let view = select(&prepared, &selection);
+    let InputValue::ValueLibrarySelection(packet) =
+        &view.prepared_inputs()[&InputKey::ValueLibrarySelection(selection.outline.crate_key)]
+    else {
+        panic!()
+    };
+    let mut expected = StableEncoder::new("lrr/v2/input-value");
+    expected.u32(29);
+    expected.record(packet.as_ref());
+    assert_eq!(
+        InputValue::ValueLibrarySelection(packet.clone()).fingerprint(),
+        expected.finish()
+    );
+}
