+#[test]
+fn oversized_actual_observation_bundle_refuses_before_any_prepared_input_attachment() {
+    let (prepared, selection, snapshot) = prepared(COPY, "can_copy_copy", 2024);
+    let mut files = snapshot.files().clone();
+    for ordinal in 0..5 {
+        files.insert(
+            SourcePath::new(format!("large-observation-{ordinal}.rs")).unwrap(),
+            SourceBlob::new(vec![b'a'; 8 * 1024 * 1024]).unwrap(),
+        );
+    }
+    let oversized = Snapshot::new(
+        snapshot.project().clone(),
+        files,
+        snapshot.cfg_by_crate().clone(),
+        BTreeMap::new(),
+        None,
+    )
+    .unwrap();
+    let old_view = select(&prepared, &selection);
+    assert!(
+        !old_view
+            .prepared_inputs()
+            .contains_key(&InputKey::ValueLibrarySelection(
+                selection.outline.crate_key
+            ))
+    );
+    let error = prepared
+        .with_pinned_live_value_libraries(&selection, &oversized)
+        .err()
+        .expect("bounded source observations must refuse");
+    assert_eq!(error.code, "LRR-E-METADATA-LIMIT");
+    assert!(
+        !old_view
+            .prepared_inputs()
+            .contains_key(&InputKey::ValueLibrarySelection(
+                selection.outline.crate_key
+            ))
+    );
+}
