+fn validate_seal(
+    db: &Database,
+    source: &PreparedSourceView,
+    input: &DiscoveryInput,
+    key: &SealKey,
+    scope: &crate::syntax::outline::ScopeKey,
+    namespace: Namespace,
+    sources: &RetainedConstantSources,
