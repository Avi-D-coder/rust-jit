+                &db,
+                &view,
+                &admission,
+                &handle.key(),
+                invocation.range,
+                MAX_BYTES,
+            )
+            .unwrap_err();
+            assert_eq!(error.code, "LRR-E-CONST-MACRO-SOURCE");
+            assert_eq!(db.trace.counts, before);
+        }
+    }
+}
