+    admission: &ConstantSourceAdmission,
+    expected: &ConstantWireType,
+    limits: ConstLimits,
+    byte_limit: usize,
+) -> QueryPoll<Outcome> {
+    fetch_current_constant_mode(db, source, admission, expected, limits, byte_limit, true)
+}
+fn fetch_current_constant_mode(
+    db: &mut Database,
+    source: &PreparedSourceView,
+    admission: &ConstantSourceAdmission,
+    expected: &ConstantWireType,
+    limits: ConstLimits,
+    byte_limit: usize,
+    typed_failures: bool,
+) -> QueryPoll<Outcome> {
+    if admission
+        .metadata_bytes()
+        .checked_mul(2)
+        .and_then(|n| {
+            byte_limit
+                .checked_mul(2)
+                .and_then(|bytes| n.checked_add(bytes))
+        })
+        .filter(|n| *n <= 32 << 20)
+        .is_none()
+    {
+        return QueryPoll::Ready(Err(metadata_limit()));
+    }
+    let proof =
+        match CurrentConstantResultType::capture_current(db, source, admission.clone(), 32 << 20) {
+            Ok(proof) => proof,
+            Err(error) => return QueryPoll::Ready(Err(error)),
+        };
+    fetch_prepared_constant_mode(
+        db,
+        source,
+        proof,
+        expected,
+        limits,
+        byte_limit,
+        typed_failures,
+    )
+}
+fn capture_and_fetch(
+    db: &mut Database,
+    source: &PreparedSourceView,
+    definition: Digest,
+    request: ConstantRequest,
+    expected: &ConstantWireType,
+    limits: ConstLimits,
+    byte_limit: usize,
+) -> QueryPoll<Outcome> {
+    let admission =
+        match ConstantSourceAdmission::capture_current(db, source, definition, request, 32 << 20) {
+            Ok(admission) => admission,
+            Err(error) => return QueryPoll::Ready(Err(error)),
+        };
+    match fetch_constant_preparing_macros(db, source, admission, expected, limits, byte_limit) {
+        QueryPoll::Ready(Ok((_, outcome))) => match outcome.value.as_ref() {
+            QueryValue::ConstantFailure(failure) => {
+                QueryPoll::Ready(Err(failure.diagnostic().clone()))
+            }
+            _ => QueryPoll::Ready(Ok(outcome)),
+        },
+        QueryPoll::Ready(Err(error)) => QueryPoll::Ready(Err(error)),
+        QueryPoll::NeedInput(input) => QueryPoll::NeedInput(input),
+    }
+}
+/// Source-selected named constant. Missing current source/macro/preparation
+/// evidence remains an explicit prerequisite; this never performs discovery.
+pub fn constant(
+    db: &mut Database,
+    source: &PreparedSourceView,
+    definition: Digest,
+    expected: &ConstantWireType,
+    limits: ConstLimits,
+    byte_limit: usize,
+) -> QueryPoll<Outcome> {
+    capture_and_fetch(
+        db,
+        source,
+        definition,
+        ConstantRequest::Constant,
+        expected,
+        limits,
+        byte_limit,
+    )
+}
+/// Exact source const fn with immutable concrete arguments, no guest handles.
+pub fn const_call(
+    db: &mut Database,
+    source: &PreparedSourceView,
+    definition: Digest,
+    arguments: Vec<super::ConstValue>,
+    expected: &ConstantWireType,
+    limits: ConstLimits,
+    byte_limit: usize,
+) -> QueryPoll<Outcome> {
+    capture_and_fetch(
+        db,
+        source,
+        definition,
+        ConstantRequest::ConstCall(arguments),
+        expected,
+        limits,
+        byte_limit,
+    )
+}
+/// Exact selected array-length operand, always in concrete usize context.
+pub fn array_length(
+    db: &mut Database,
+    source: &PreparedSourceView,
+    definition: Digest,
+    range: crate::syntax::spans::SourceRange,
+    limits: ConstLimits,
+    byte_limit: usize,
+) -> QueryPoll<Outcome> {
+    capture_and_fetch(
+        db,
+        source,
+        definition,
+        ConstantRequest::ArrayLength(range),
+        &ConstantWireType::Scalar(crate::ir::op::PrimitiveType::Usize),
+        limits,
+        byte_limit,
+    )
+}
