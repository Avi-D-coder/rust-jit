+                RecipeDraft {
+                    key: pc.clone(),
+                    origin: Origin {
+                        span: self.frame.body.span(node.id)?,
+                        expansion_ancestry: vec![],
+                    },
+                    operations,
+                    exits: vec![RecipeExit::Next(next)],
+                    dependencies,
+                },
+                &self.frame.body,
+            )?;
