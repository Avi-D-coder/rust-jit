+fn pending(
+    db: &mut Database,
+    view: &PreparedSourceView,
+    admission: &ConstantSourceAdmission,
+) -> crate::db::memo::Outcome {
+    fetch_current_constant_data(
+        db,
+        view,
+        admission,
+        &unit(),
+        ConstLimits::default(),
+        1 << 20,
+    )
+    .into_ready()
+    .unwrap()
+    .unwrap()
