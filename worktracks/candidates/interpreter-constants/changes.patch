+        })
+        .and_then(|n| n.checked_add(header_bytes))
+        .and_then(|n| n.checked_add(bytes))
+        .filter(|n| *n <= MAX_HEAP)
+        .ok_or_else(|| invalid("constant wire heap limit"))?;
