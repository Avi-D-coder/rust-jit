+    let mut buf = [0; 1024];
+    init(&mut buf);
+    buf
+}
+
+const BUF: [u8; 1024] = nrvo();
+
+fn main() {
+    assert_eq!(BUF[33], 3);
+    assert_eq!(BUF[19], 0);
+    assert_eq!(BUF[444], 4);
+}
