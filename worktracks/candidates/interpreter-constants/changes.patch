+    let mut store = GuestStore::new(1, 1000, 1 << 20).unwrap();
+    let (mut frame, nodes, body) = frame(&view, &db, text, &mut store);
+    enter(&mut frame, nodes[0]);
+    let node = nodes[0];
+    let span = frame.body.span(node).unwrap();
