+            let memo = db
+                .memo(&query)
+                .ok_or_else(|| call_fault("prepared constant actual memo absent"))?;
+            let capacity = memo
+                .dependencies
+                .len()
+                .checked_add(path.dependencies().len())
+                .and_then(|n| n.checked_add(1))
+                .filter(|n| *n <= 100_000)
+                .ok_or_else(crate::runtime::arena::resource)?;
