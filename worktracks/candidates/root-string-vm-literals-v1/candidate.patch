+//! Intrinsic ordinary UTF-8 literals: source identity precedes physical storage.
+use super::*;
+use crate::{
+    core::digest::{StableEncode, StableEncoder},
+    ir::pc::SlotId,
+    runtime::{cell::byte_literals::PreparedStaticBytes, shape::ByteLiteralTarget},
+    syntax::body_index::{ExpressionKind, NodeRole},
+    traits::term::{RegionTerm, TyTerm},
+};
+pub(super) fn source() -> TyTerm {
+    TyTerm::Ref(RegionTerm::Static, false, Box::new(TyTerm::Str))
+}
+pub(super) fn prepare(
+    frame: &Frame,
+    store: &GuestStore,
+    literal: &LiteralRecipe,
+    destination: SlotId,
+    hint: Option<TypeId>,
+) -> Result<PreparedStaticBytes, Diagnostic> {
+    let Some(DecodedLiteral::String(payload)) = &literal.decoded else {
+        return Err(invalid("string pinned payload absent"));
+    };
+    if literal.kind != LiteralKind::String {
+        return Err(invalid("string payload has another literal kind"));
+    }
+    payload.require(&literal.spelling, &literal.source)?;
+    let node = frame
+        .body
+        .nodes()
+        .get(frame.pc().node as usize)
+        .ok_or_else(|| invalid("string indexed node absent"))?;
+    // Macro operand and generated-token admission must provide their own exact
+    // source certificate. A plain verified Literal operation is insufficient.
+    if node.role != NodeRole::Expression(ExpressionKind::Literal)
+        || frame.pc().phase != 0
+        || node.value != Some(destination)
+        || frame.body.span(node.id)? != literal.source
+    {
+        return Err(invalid("string requires its exact ordinary literal entry"));
+    }
+    let source = source();
+    if frame
+        .source_view_ref(destination)?
+        .is_some_and(|context| context != &source)
+    {
+        return Err(invalid(
+            "string cannot overwrite a different source context",
+        ));
+    }
+    frame.preflight_source_view(destination, Some(&source))?;
+    let needs_cell = frame.literal_destination_needs_cell(destination)?;
+    let mut identity = StableEncoder::new("lrr/v1/static-utf8-literal-site");
+    identity.record(frame.body.body());
+    identity.record(frame.body.profile());
+    identity.digest(frame.body.cfg().fingerprint());
+    identity.u32(literal.source.relative_start);
+    identity.u32(literal.source.relative_end);
+    let plan = store.prepare_static_bytes(
+        identity.finish(),
+        payload.text().as_bytes(),
+        ByteLiteralTarget::Str,
+        hint,
+        needs_cell,
+    )?;
