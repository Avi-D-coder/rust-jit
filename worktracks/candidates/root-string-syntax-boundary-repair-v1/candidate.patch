+fn string_condition_binding_preserves_supported_literal_and_unentered_else() {
+    use lrr::engine::run::{RunPoll, ValueSummary};
+    let result = run("fn case()->i64{if let owned=\"owned\"{3_i64}else{missing()}}");
+    match result {
+        RunPoll::Completed(report) => {
+            assert!(matches!(report.value, ValueSummary::Signed(ref value) if value == "3"));
+            assert_eq!(report.opcode_counters.started_by_opcode[7], 1);
+            assert_eq!(
+                report.opcode_counters.operations_started,
+                report.opcode_counters.operations_completed
+            );
+        }
+        RunPoll::Fault(error) => panic!("supported string condition faulted: {error}"),
+        RunPoll::NeedInput(input) => panic!("cold else caused unexpected demand: {input:?}"),
+        RunPoll::Panicked(report) => panic!("supported string condition panicked: {report:?}"),
+    }
+}
