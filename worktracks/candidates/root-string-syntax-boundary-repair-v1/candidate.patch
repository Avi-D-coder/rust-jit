+//! Owned stock string facts for storage/VM witnesses. Test-only parser boundary.
+use super::{
+    body_index::{BodyIndex, ExpressionKind, NodeRole},
+    parse::ParsedFile,
+};
+use crate::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    ir::{pc::Phase, recipe::VerifiedRecipe},
+    source::snapshot::{CfgSet, SourceBlob},
+};
+use ra_ap_syntax::{AstNode, SyntaxKind, ast};
+fn parsed(source: &str, edition: u16) -> ParsedFile {
+    let parsed = ParsedFile::parse(
+        &SourceBlob::new(source.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        },
+    )
+    .unwrap();
+    assert!(parsed.errors.is_empty());
+    parsed
+}
+pub(crate) fn all_string_tokens(source: &str, edition: u16) -> Vec<String> {
+    parsed(source, edition)
+        .parsed
+        .tree()
+        .syntax()
+        .descendants_with_tokens()
+        .filter_map(|child| child.into_token())
+        .filter(|token| token.kind() == SyntaxKind::STRING)
+        .map(|token| super::ast_adapter::string_value(token.text(), edition).unwrap())
+        .collect()
+}
+pub(crate) fn let_string_values(source: &str, edition: u16) -> Vec<String> {
+    parsed(source, edition)
+        .parsed
+        .tree()
+        .syntax()
+        .descendants()
+        .filter_map(ast::LetStmt::cast)
+        .filter_map(|binding| {
+            let ast::Expr::Literal(literal) = binding.initializer()? else {
+                return None;
+            };
+            let token = literal.token();
+            if token.kind() != SyntaxKind::STRING {
+                return None;
+            }
+            Some(super::ast_adapter::string_value(token.text(), edition).unwrap())
+        })
+        .collect()
+}
+pub(crate) fn main_string_initializer_recipes(
+    original: &str,
+    edition: u16,
+) -> Vec<(BodyIndex, VerifiedRecipe)> {
+    let parsed = parsed(original, edition);
+    let outline = parsed
+        .outline(
+            Digest::of_bytes(b"original UTF8 VM initializer"),
+            vec![],
+            &CfgSet::guest_default(),
+        )
+        .unwrap();
+    let body = outline
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap();
+    let index = parsed.index_body(body, Default::default()).unwrap();
+    parsed
+        .entered_body_root(body)
+        .unwrap()
+        .descendants()
+        .filter_map(ast::LetStmt::cast)
+        .filter_map(|statement| statement.initializer())
+        .filter_map(|expr| match expr {
+            ast::Expr::Literal(literal) if literal.token().kind() == SyntaxKind::STRING => {
+                Some(literal)
+            }
+            _ => None,
+        })
+        .map(|literal| {
+            let range = literal.syntax().text_range();
+            let node = index
+                .nodes()
+                .iter()
+                .find(|node| {
+                    node.role == NodeRole::Expression(ExpressionKind::Literal)
+                        && node.range.start + body.range.start == u32::from(range.start())
+                        && node.range.end + body.range.start == u32::from(range.end())
+                })
+                .unwrap();
+            let pc = index.pc(node.id, Phase::Entry).unwrap();
+            let recipe = parsed.initial_thunk(body, &index, &pc).unwrap();
+            (index.clone(), recipe)
+        })
+        .collect()
+}
