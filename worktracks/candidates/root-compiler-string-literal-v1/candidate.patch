+#[test]
+fn original_include_string_requires_current_sealed_source_record_and_exact_plan() {
+    use crate::{db::dependency::DependencyStamp, expand::identity::MacroIdentity};
+    let (mut db, mut run, _, _) = start_complete_crlf(2024, 100_000);
+    let before = effects(&run);
+    let keys: Vec<_> = run
+        .frame
+        .body
+        .nodes()
+        .iter()
+        .filter(|node| node.role == NodeRole::Expression(ExpressionKind::Macro))
+        .map(|node| {
+            run.frame
+                .body
+                .pc(node.id, crate::ir::pc::Phase::Entry)
+                .unwrap()
+        })
+        .collect();
+    let mut selected = None;
+    for pc in keys {
+        if let Some(plan) = run
+            .declarative_runtime
+            .prepare(&mut db, &run.sources, &run.frame.body, &pc)
+            .into_ready()
+            .unwrap()
+            .unwrap()
+        {
+            assert!(selected.is_none(), "one actual self-include producer");
+            selected = Some((pc, plan));
+        }
+    }
+    let (pc, plan) = selected.expect("original compiler include producer");
+    let recipe = plan.recipe().clone();
+    let expected = recipe
+        .recipe()
+        .dependencies
+        .iter()
+        .find_map(|dependency| {
+            let DependencyStamp::Input {
+                key: InputKey::ExpansionRecord(_),
+                ..
+            } = dependency
+            else {
+                return None;
+            };
+            let DependencyStamp::Input { key, .. } = dependency else {
+                unreachable!()
+            };
+            match db.input(key)?.as_ref() {
+                InputValue::ExpansionRecord(record) => Some(record.descriptor()),
+                _ => None,
+            }
+        })
+        .unwrap();
+    assert!(matches!(
+        expected.key.macro_identity,
+        MacroIdentity::Builtin { .. }
+    ));
+    let source = run
+        .sources
+        .iter()
+        .find(|source| {
+            source
+                .outline()
+                .items
+                .iter()
+                .filter_map(|item| item.body.as_ref())
+                .any(|handle| handle.key() == pc.body)
+        })
+        .unwrap();
+    for mode in 0..7 {
+        let mut wrong = expected.clone();
+        match mode {
+            0 => {
+                wrong.key.macro_identity = MacroIdentity::Builtin {
+                    definition: Digest::of_bytes(b"foreign builtin"),
+                }
+            }
+            1 => {
+                wrong.key.consumer_compile_env = Digest::of_bytes(b"different compile environment")
+            }
+            2 => wrong.key.invocation = Digest::of_bytes(b"different source call"),
+            3 => wrong.key.input_tokens = Digest::of_bytes(b"different original operands"),
+            4 => wrong.key.call_edition = 2015,
+            5 => wrong.key.grammar = crate::expand::identity::GrammarSlot::Statements,
+            _ => wrong.key.engine_version = Digest::of_bytes(b"different expansion engine"),
+        }
+        assert!(
+            matches!(
+                crate::engine::runtime_macros::prepare_declarative_expression(
+                    &mut db,
+                    source,
+                    &run.frame.body,
+                    &pc,
+                    &wrong,
+                ),
+                QueryPoll::Ready(Err(_))
+            ),
+            "invalid compiler binding mode {mode}"
+        );
+        assert_eq!(effects(&run), before);
+    }
+    assert!(
+        !run.declarative_runtime
+            .current_literal_plan(&db, &pc, &recipe)
+            .unwrap()
+    );
+    run.declarative_runtime.retain(plan).unwrap();
+    assert!(
+        run.declarative_runtime
+            .current_literal_plan(&db, &pc, &recipe)
+            .unwrap()
+    );
+    assert!(
+        run.declarative_runtime
+            .current_literal_plan(&Database::default(), &pc, &recipe)
+            .is_err()
+    );
+    let mut changed = recipe.recipe().clone();
+    changed.origin.expansion_ancestry.clear();
+    let changed = crate::ir::validate::verify(
+        crate::ir::recipe::RecipeDraft {
+            key: changed.key,
+            origin: changed.origin,
+            operations: changed.operations.into_vec(),
+            exits: vec![changed.exit],
+            dependencies: changed.dependencies.into_vec(),
+        },
+        &run.frame.body,
+    )
+    .unwrap();
+    assert!(
+        run.declarative_runtime
+            .current_literal_plan(&db, &pc, &changed)
+            .is_err()
+    );
+    let mut foreign = pc.clone();
+    foreign.phase = crate::ir::pc::Phase::Exit.code().unwrap();
+    assert!(
+        !run.declarative_runtime
+            .current_literal_plan(&db, &foreign, &recipe)
+            .unwrap()
+    );
+    assert_eq!(effects(&run), before);
+    db.finish_run().unwrap();
+}
