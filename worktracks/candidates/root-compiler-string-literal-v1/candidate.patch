+    pub(super) fn current_literal_plan(
+        &self,
+        db: &Database,
+        pc: &PcKey,
+        installed: &crate::ir::recipe::VerifiedRecipe,
+    ) -> Result<bool, Diagnostic> {
+        let Some(plan) = self.plans.get(pc) else {
+            return Ok(false);
+        };
+        if plan.recipe().recipe().fingerprint() != installed.recipe().fingerprint() {
+            return Err(invalid());
+        }
+        for dependency in &plan.recipe().recipe().dependencies {
+            let crate::db::dependency::DependencyStamp::Input { key, fingerprint } = dependency
+            else {
+                return Err(invalid());
+            };
+            if db
+                .published_input(key)
+                .is_none_or(|(_, current)| current != *fingerprint)
+            {
+                return Err(invalid());
+            }
+        }
+        Ok(true)
+    }
     pub(super) fn plans(&self) -> impl Iterator<Item = &PreparedDeclarativeExpression> {
         self.plans.values()
