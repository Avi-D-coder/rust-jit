+fn world_unsealed(
+    text: &str,
+    function: &str,
+    edition: u16,
+) -> (
+    Database,
+    PreparedSourceView,
+    PublishedMacroIndex,
+    NameNamespaces,
+    ParsedFile,
+    BodyIndex,
+    Arc<DefinitionSourcePlan>,
+) {
+    let unit = Digest::of_bytes(b"LRR SourceView alias return component");
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let cfg = CfgSet::guest_default();
+    let path = SourcePath::new("source-view-original.rs").unwrap();
+    let blob = SourceBlob::new(text.as_bytes().to_vec()).unwrap();
+    let selection = SourceSelection {
+        path: path.clone(),
+        outline: OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile: profile.clone(),
+            cfg,
+            blob: blob.clone(),
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selection).unwrap() else {
+        panic!()
+    };
+    let graph = NameNamespaces::from_outlines(&[view.outline()]).unwrap();
+    let mut db = Database::default();
+    db.trace.detailed = true;
+    inputs.publish(&mut db).unwrap();
+    let (context, hygiene) = crate::syntax::floating_fixture_hygiene::root(unit, edition);
+    let published = PublishedMacroIndex::from_view(view.share(), context, hygiene).unwrap();
+    let parsed = ParsedFile::parse(&blob, profile).unwrap();
+    let item = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == function)
+        .unwrap();
+    let handle = item.body.as_ref().unwrap();
+    let owner = Arc::new(
+        parsed
+            .source_view_definition_plan(
+                handle,
+                &item.header,
+                &DeclarationContext {
+                    scope: item.scope.clone(),
+                    range: item.declaration_span,
+                },
+            )
+            .unwrap(),
+    );
+    let index = parsed.index_body(handle, Default::default()).unwrap();
+    (db, view, published, graph, parsed, index, owner)
+}
+fn site(
+    text: &str,
+    owner: &DefinitionSourcePlan,
+    index: &BodyIndex,
+    needle: &str,
+    phase: Phase,
+) -> PcKey {
+    let start = u32::try_from(text.find(needle).unwrap()).unwrap() - owner.body.range.start;
+    let end = start + u32::try_from(needle.len()).unwrap();
+    let node = index
+        .nodes()
+        .iter()
+        .find(|node| node.range.start == start && node.range.end == end)
+        .unwrap();
+    index.pc(node.id, phase).unwrap()
+}
+fn read_in(
+    text: &str,
+    owner: &DefinitionSourcePlan,
+    index: &BodyIndex,
+    needle: &str,
+    name: &str,
+) -> PcKey {
+    let start = u32::try_from(text.find(needle).unwrap() + needle.rfind(name).unwrap()).unwrap()
+        - owner.body.range.start;
+    let end = start + u32::try_from(name.len()).unwrap();
+    let node = index
+        .nodes()
+        .iter()
+        .find(|node| node.range.start == start && node.range.end == end)
+        .unwrap();
+    index.pc(node.id, Phase::Entry).unwrap()
+}
+fn runtime_environment(owner: &DefinitionSourcePlan) -> GenericEnv {
+    let signature = owner.signature();
+    let mut symbolic = BTreeMap::new();
+    let mut runtime = BTreeMap::new();
+    for generic in signature
+        .generics
+        .iter()
+        .filter(|generic| generic.kind == GenericKind::Type)
+    {
+        let key = ParamKey {
+            definition: signature.definition,
+            ordinal: generic.ordinal,
+        };
+        symbolic.insert(key, TyTerm::Primitive(PrimitiveType::I32));
+        runtime.insert(key, TypeId(6));
+    }
+    let parameters: Vec<_> = signature
+        .parameters
+        .iter()
+        .map(|parameter| parameter.symbolic.clone().unwrap())
+        .collect();
+    let parameter_descriptors = parameters
+        .iter()
+        .map(|term| match term {
+            TyTerm::Param(_) => TypeId(6),
+            TyTerm::Primitive(primitive) => primitive_runtime_id(*primitive).unwrap(),
+            _ => panic!(),
+        })
+        .collect();
+    let result = signature.result_symbolic.clone();
+    let result_descriptor = match result.as_ref() {
+        Some(TyTerm::Primitive(primitive)) => Some(primitive_runtime_id(*primitive).unwrap()),
+        Some(TyTerm::Param(_)) => Some(TypeId(6)),
+        None => None,
+        _ => panic!(),
+    };
+    GenericEnv::capture(
+        signature,
+        &PreparedCallContracts {
+            definition: signature.definition,
+            source_parameters: parameters,
+            parameter_descriptors,
+            source_substitution: symbolic,
+            runtime_substitution: runtime,
+            source_result: result,
+            result_descriptor,
+            normalized_deferred_return: None,
+        },
+    )
+    .unwrap()
+}
+
+fn world(
+    text: &str,
+    function: &str,
+    edition: u16,
+) -> (
+    Database,
+    PreparedSourceView,
+    PublishedMacroIndex,
+    NameNamespaces,
+    ParsedFile,
+    BodyIndex,
+    Arc<DefinitionSourcePlan>,
+) {
+    let (mut db, view, published, graph, parsed, index, owner) =
+        world_unsealed(text, function, edition);
+    publish_scope(
+        &mut db,
+        &view,
+        Digest::of_bytes(b"LRR source-view admission world"),
+    );
+    (db, view, published, graph, parsed, index, owner)
+}
+fn publish_scope(db: &mut Database, view: &PreparedSourceView, world: Digest) {
+    let profile = &view.selection().outline.parse.profile;
+    let mut discovery = SourceDiscovery::new(
+        vec![view.share()],
+        view.outline().root_scope.clone(),
+        Namespace::Value,
+        world,
+        1,
+    )
+    .unwrap()
+    .with_declarative_compiler(
+        Digest::of_bytes(b"LRR source-view declarative"),
+        Digest::of_bytes(b"LRR source-view compiler"),
+        Arc::new(
+            crate::frontend::compile_input_catalog::CompileInputCatalog::standalone(profile)
+                .unwrap(),
+        ),
+    )
+    .unwrap();
+    loop {
+        match discovery.poll().unwrap() {
+            SourceDiscoveryStep::Sealed(_) => break,
+            SourceDiscoveryStep::NeedExpansion { request } => discovery
+                .admit_expansion(Arc::new(request.expand().unwrap()))
+                .unwrap(),
+            SourceDiscoveryStep::NeedGeneratedExpansion { request } => discovery
+                .admit_expansion(Arc::new(request.expand().unwrap()))
+                .unwrap(),
+            _ => panic!("source-only acceptance needs unestablished discovery authority"),
+        }
+    }
+    discovery.publish(db).unwrap();
+}
+fn parameter_alias(
+    text: &str,
+    function: &str,
+    needle: &str,
+    edition: u16,
+    sealed: bool,
+) -> (Database, PreparedSourceView, GenericEnv, SourceViewPairPlan) {
+    let (db, view, published, graph, parsed, index, owner) = if sealed {
+        world(text, function, edition)
+    } else {
+        world_unsealed(text, function, edition)
+    };
+    let entered = published
+        .enter_body(view.selection(), &owner.body.key())
+        .unwrap();
+    let resolutions = entered
+        .facts()
+        .bindings
+        .iter()
+        .map(|binding| (binding.identity, PatternResolution::Binding))
+        .collect();
+    let locals = entered
+        .local_index(view.selection(), &owner.body.key(), &resolutions, &[])
+        .unwrap();
+    let environment = runtime_environment(&owner);
+    let alias = parsed
+        .source_view_alias_plan(
+            &owner,
+            &index,
+            &site(text, &owner, &index, needle, Phase::Commit),
+        )
+        .unwrap();
+    let value = declared_binding_view(
+        &db,
+        &parsed,
+        &index,
+        &view,
+        &graph,
+        &locals,
+        owner.clone(),
+        &alias.source,
+        Some(&environment),
+        TypeId(6),
+        SOURCE_VIEW_BUDGET,
+    )
+    .unwrap();
+    let alias = local_alias_view(
+        &db,
+        &view,
+        &graph,
+        &locals,
+        owner,
+        &alias,
+        &value,
+        SOURCE_VIEW_BUDGET,
+    )
+    .unwrap();
+    (db, view, environment, alias)
+}
+const EXPLICIT: &str = "fn chosen<T:Copy>(mut x:T){let mut alias=x;let mut later=alias;}fn id<T>(x:T)->T{x}fn main(){}";
+fn explicit() -> (Database, PreparedSourceView, GenericEnv, SourceViewPairPlan) {
+    parameter_alias(EXPLICIT, "chosen", "let mut alias=x;", 2024, true)
+}
+#[test]
+fn original_copy_ambiguity_is_preserved_as_current_pattern_prerequisite_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view, environment, plan) =
+            parameter_alias(COPY, "can_copy_copy", "let _a = v;", edition, true);
+        let before = db.trace.events.len();
+        let error = plan
+            .admit_current(&db, &view, Some(&environment), SOURCE_VIEW_BUDGET)
+            .unwrap_err();
+        assert_eq!(error.code, "LRR-E-SOURCE-TYPE-CONTEXT");
+        assert!(error.message.contains("Value-prelude/pattern witness"));
+        assert_eq!(
+            plan.source.term(),
+            &TyTerm::Param(ParamKey {
+                definition: plan.source.definition.signature.definition,
+                ordinal: 0
+            })
+        );
+        assert_eq!(db.trace.events.len(), before);
+        // Unchanged source component is blocked, not a stock fixture pass.
+    }
+}
+#[test]
+fn explicit_nonmacro_binding_alias_current_admission_keeps_rigid_owner_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, view, environment, plan) =
+            parameter_alias(EXPLICIT, "chosen", "let mut alias=x;", edition, true);
+        let before = db.trace.events.len();
+        let certificate = plan
+            .admit_current(&db, &view, Some(&environment), SOURCE_VIEW_BUDGET)
+            .unwrap();
+        certificate
+            .revalidate(&db, &view, Some(&environment), &plan)
+            .unwrap();
+        assert_eq!(certificate.source().term(), plan.source.term());
+        assert_eq!(certificate.runtime(), TypeId(6));
+        assert!(
+            certificate.source().definition().signature().generics[0]
+                .bounds
+                .iter()
+                .any(|token| token.text == "Copy")
+        );
+        assert!(certificate.metadata_bytes() >= plan.source.metadata_bytes());
+        assert_eq!(db.trace.events.len(), before);
+        // LRR currentness control only; no replacement stock program/pass claim.
+    }
+}
