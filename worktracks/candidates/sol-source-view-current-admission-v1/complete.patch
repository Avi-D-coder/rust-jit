+//! Pure original-source currentness admission, distinct from guest slot/value admission.
+use super::*;
+use crate::db::seals::{SealDomain, SealKey};
+
+/// Private-mintable, immutable owning certificate. No raw SourceViewId or
+/// caller-selected dependency list is accepted. Revalidate before VM admission.
+#[derive(Debug)]
+pub(crate) struct SourceViewAdmission {
+    view: SourceViewPairPlan,
+    environment: Option<Digest>,
+    seal: SealKey,
+    seal_fingerprint: Digest,
+    stamps: BTreeMap<InputKey, Digest>,
+    bytes: usize,
+}
+fn environment_identity(
+    owner: &DefinitionSourcePlan,
+    env: Option<&GenericEnv>,
+) -> Result<Option<Digest>, Diagnostic> {
+    let Some(env) = env else {
+        return Ok(None);
+    };
+    if env.definition() != owner.signature()
+        || env.signature_key() != owner.signature().fingerprint()
+    {
+        return Err(source_fault("source-view ParamEnv or owning bounds differ"));
+    }
+    let mut encoded = StableEncoder::new("lrr/v1/source-view-current-param-env");
+    encoded.record(env.definition());
+    for generic in &owner.signature().generics {
+        if generic.kind != GenericKind::Type {
+            return Err(source_fault(
+                "source-view currentness needs complete const/region admission",
+            ));
+        }
+        let key = ParamKey {
+            definition: owner.signature().definition,
+            ordinal: generic.ordinal,
+        };
+        // GenericEnv owns checked declaration metadata, but its public legacy
+        // capture path is not a general nominal/caller source-call certificate.
+        // Admit only its closed primitive substitutions (or an unused absent
+        // pair); preserve Param(T) in the source view regardless of this table.
+        match (env.symbolic_binding(key), env.runtime_binding(key)) {
+            (None, None) => {}
+            (Some(TyTerm::Primitive(primitive)), Some(runtime))
+                if primitive_runtime_id(*primitive)? == runtime => {}
+            _ => {
+                return Err(source_fault(
+                    "source-view symbolic call substitution lacks current source admission",
+                ));
+            }
+        }
+        encoded.u32(key.ordinal);
+        encoded.option(&env.symbolic_binding(key), |e, term| e.record(*term));
+        encoded.option(&env.runtime_binding(key), |e, descriptor| {
+            e.u32(descriptor.0)
+        });
+    }
+    Ok(Some(encoded.finish()))
+}
+fn owning_signature(
+    db: &Database,
+    identity: Digest,
+    source: &PreparedSourceView,
+) -> Result<crate::syntax::signatures::FunctionSignature, Diagnostic> {
+    let get = |key| {
+        db.published_input(&key)
+            .map(|(value, _)| value)
+            .ok_or_else(|| source_fault("source-view exact definition publication absent"))
+    };
+    let InputValue::DefinitionSource(parse) = get(InputKey::DefinitionSource(identity))? else {
+        return Err(source_fault(
+            "source-view definition source variant differs",
+        ));
+    };
+    let InputValue::DefinitionHeader(header) = get(InputKey::DefinitionHeader(identity))? else {
+        return Err(source_fault(
+            "source-view definition header variant differs",
+        ));
+    };
+    let InputValue::DeclarationContext(context) = get(InputKey::DeclarationContext(identity))?
+    else {
+        return Err(source_fault(
+            "source-view declaration context variant differs",
+        ));
+    };
+    let InputValue::DefinitionBody(body) = get(InputKey::DefinitionBody(identity))? else {
+        return Err(source_fault("source-view definition body variant differs"));
+    };
+    if parse != &source.selection().outline.parse || context.scope.owner.is_some() {
+        return Err(source_fault(
+            "source-view generated/foreign/lexical owner needs separate admission",
+        ));
+    }
+    let item = source
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.fingerprint() == identity)
+        .ok_or_else(|| source_fault("source-view original declaration absent"))?;
+    if &item.header != header
+        || item.scope != context.scope
+        || item.declaration_span != context.range
+        || item.body.as_ref() != Some(body)
+    {
+        return Err(source_fault(
+            "source-view exact declaration publication differs",
+        ));
+    }
+    db.prepared_parse(parse)
+        .ok_or_else(|| source_fault("source-view exact parser lease absent"))?
+        .function_signature(identity, header, context, Some(body))
+}
+fn current_seal(
+    db: &Database,
+    source: &PreparedSourceView,
+    owner: &DefinitionSourcePlan,
+) -> Result<(Arc<InputValue>, SealKey, Digest), Diagnostic> {
+    let published =
+        db.source_view_scope_certificate(source.selection(), &owner.signature().scope)?;
+    let InputValue::DiscoverySeal(input) = published.as_ref() else {
+        return Err(source_fault("source-view discovery variant differs"));
+    };
+    let scope = input
+        .scope
+        .as_ref()
+        .ok_or_else(|| source_fault("source-view exact Value scope certificate absent"))?;
+    let key = input.seal.key();
+    key.validate()?;
+    if scope.scope != owner.signature().scope
+        || scope.namespace != Namespace::Value
+        || scope.edition != owner.signature().header.profile.edition
+        || !matches!(input.seal.domain(), SealDomain::Scope{id,namespace} if *id==scope.scope.fingerprint() && *namespace==Namespace::Value)
+        || input.sources.len() != 1
+        || input.sources[0] != *source.selection()
+        || input.seal.unresolved_frontiers() != 0
+    {
+        return Err(source_fault(
+            "source-view current scope/world/edition differs",
+        ));
+    }
+    if !matches!(db.published_input(&InputKey::ExpansionEpoch), Some((InputValue::ExpansionEpoch(epoch),_)) if *epoch==key.epoch)
+    {
+        return Err(source_fault(
+            "source-view current expansion epoch absent or changed",
+        ));
+    }
+    if !matches!(db.published_input(&InputKey::SourceDependencies), Some((InputValue::SourceDependencies(graph),_)) if graph.fingerprint()==input.source_dependencies)
+    {
+        return Err(source_fault(
+            "source-view current world/source graph differs",
+        ));
+    }
+    for (key, fingerprint) in &input.compiler_inputs {
+        if db
+            .published_input(key)
+            .is_none_or(|(_, actual)| actual != *fingerprint)
+        {
+            return Err(source_fault("source-view compiler input changed"));
+        }
+    }
+    for (key, value) in source.prepared_inputs() {
+        if db
+            .published_input(key)
+            .is_none_or(|(_, actual)| actual != value.fingerprint())
+        {
+            return Err(source_fault(
+                "source-view captured base publication changed",
+            ));
+        }
+    }
+    // General generated/native/dependency worlds need their own exact entered
+    // indexes. This certificate admits only the established original-source lane.
+    if !input.records.is_empty()
+        || !input.procedural_catalogs.is_empty()
+        || !input.helper_declarations.is_empty()
+        || !input.argument_fragments.is_empty()
+        || !input.declaration_fragments.is_empty()
+        || !input.argument_indexes.is_empty()
+    {
+        return Err(source_fault(
+            "source-view generated/native namespace admission is unestablished",
+        ));
+    }
+    let fingerprint = published.fingerprint();
+    Ok((published, key, fingerprint))
+}
+impl SourceViewPairPlan {
+    /// Replay exact original provenance against freshly sealed entered locals.
+    /// No provider runs, no guest body/thunk is prepared, no descriptor seeds a term.
+    pub(crate) fn admit_current(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+        environment: Option<&GenericEnv>,
+        limit: usize,
+    ) -> Result<crate::frontend::source_view::SourceViewAdmission, Diagnostic> {
+        let limit = limit.min(SOURCE_VIEW_BUDGET);
+        if self.source.metadata_bytes() > limit || self.source.provenance.len() > 256 {
+            return Err(metadata_fault());
+        }
+        if self.source.provenance.is_empty() {
+            return Err(source_fault("source-view declared provenance is missing"));
+        }
+        self.source.require_current(db)?;
+        source.require_original_hygiene()?;
+        source.require_declaration_syntax()?;
+        require_definition(db, source, &self.source.definition)?;
+        let signature = owning_signature(db, self.source.definition.signature.definition, source)?;
+        if signature != self.source.definition.signature
+            || signature
+                .generics
+                .iter()
+                .any(|generic| generic.kind != GenericKind::Type)
+        {
+            return Err(source_fault(
+                "source-view signature, bound context or generic namespace differs",
+            ));
+        }
+        let environment_digest = environment_identity(&self.source.definition, environment)?;
+        let (published, seal, seal_fingerprint) =
+            current_seal(db, source, &self.source.definition)?;
+        let InputValue::DiscoverySeal(sealed) = published.as_ref() else {
+            unreachable!()
+        };
+        let provider = crate::expand::source_declarative::SourceDeclarative::new(source.share())?;
+        let published_index = provider.completed_published_index()?;
+        let mut entered =
+            published_index.enter_body(source.selection(), &self.source.definition.body.key())?;
+        for (_, proof) in sealed
+            .runtime_no_item_proofs
+            .iter()
+            .filter(|(_, proof)| proof.body() == &self.source.definition.body.key())
+        {
+            let catalog=crate::frontend::runtime_macro_catalog::RuntimeMacroCatalog::standard_for_definition(&source.selection().outline.parse.profile,proof.definition())?;
+            entered.accept_no_item_proof(
+                source.selection(),
+                &self.source.definition.body.key(),
+                proof,
+                &catalog,
+            )?;
+        }
+        // No current Value-prelude/pattern witness exists in this interface.
+        // Leave BindingOrConstant rows deferred instead of converting module
+        // absence into a binding decision. Explicit binding syntax is admitted
+        // by the pinned local index; unrelated cold names stay deferred.
+        let resolutions = BTreeMap::new();
+        let locals = entered.local_index(
+            source.selection(),
+            &self.source.definition.body.key(),
+            &resolutions,
+            &[],
+        )?;
+        let graph = NameNamespaces::from_outlines(&[source.outline()])?;
+        let parsed = db
+            .prepared_parse(&source.selection().outline.parse)
+            .ok_or_else(|| source_fault("source-view exact original parser absent"))?;
+        let item = source
+            .outline()
+            .items
+            .iter()
+            .find(|item| item.def_key.fingerprint() == signature.definition)
+            .ok_or_else(|| source_fault("source-view owning declaration absent"))?;
+        let owner = Arc::new(
+            parsed.source_view_definition_plan(
+                item.body
+                    .as_ref()
+                    .ok_or_else(|| source_fault("source-view owning body absent"))?,
+                &item.header,
+                &crate::syntax::outline::DeclarationContext {
+                    scope: item.scope.clone(),
+                    range: item.declaration_span,
+                },
+            )?,
+        );
+        if owner.metadata_bytes() != self.source.definition.metadata_bytes() {
+            return Err(source_fault(
+                "source-view definition retained metadata differs",
+            ));
+        }
+        let index = source.index_body(
+            source.selection(),
+            &self.source.definition.body.key(),
+            Default::default(),
+        )?;
+        let mut replay: Option<SourceViewPairPlan> = None;
+        for (ordinal, step) in self.source.provenance.iter().enumerate() {
+            replay = Some(match step {
+                SourcePropagation::DeclaredBinding { binding, site } if ordinal == 0 => {
+                    let read = parsed.source_view_read_plan(&owner, &index, site)?;
+                    if matches!(
+                        locals.lookup_ordinary(
+                            OrdinaryNameSite {
+                                source: source.selection(),
+                                body: &self.source.definition.body.key(),
+                                at: u64::from(read.range.start),
+                                name: &read.name,
+                                context: locals.context(),
+                                namespace: Namespace::Value
+                            },
+                            &graph,
+                            None
+                        )?,
+                        NameLookup::NeedInput(_)
+                    ) {
+                        return Err(source_fault(
+                            "source-view binding-or-constant syntax needs a current Value-prelude/pattern witness",
+                        ));
+                    }
+                    let value = declared_binding_view(
+                        db,
+                        &parsed,
+                        &index,
+                        source,
+                        &graph,
+                        &locals,
+                        owner.clone(),
+                        &read,
+                        environment,
+                        self.runtime,
+                        limit,
+                    )?;
+                    if value.source.binding != Some(*binding) {
+                        return Err(source_fault(
+                            "source-view declared provenance selects another binding",
+                        ));
+                    }
+                    value
+                }
+                SourcePropagation::LocalAlias {
+                    source: from,
+                    destination,
+                    pattern,
+                    site,
+                } => {
+                    let previous = replay.as_ref().ok_or_else(|| {
+                        source_fault("source-view alias lacks declared provenance")
+                    })?;
+                    let alias = parsed.source_view_alias_plan(&owner, &index, site)?;
+                    if previous.source.binding != Some(*from)
+                        || alias.destination != *destination
+                        || alias.pattern.0 != *pattern
+                    {
+                        return Err(source_fault(
+                            "source-view alias provenance differs from exact source",
+                        ));
+                    }
+                    local_alias_view(
+                        db,
+                        source,
+                        &graph,
+                        &locals,
+                        owner.clone(),
+                        &alias,
+                        previous,
+                        limit,
+                    )?
+                }
+                SourcePropagation::NamedReturn {
+                    callee,
+                    signature,
+                    declared,
+                    site,
+                } => {
+                    let previous = replay.as_ref().ok_or_else(|| {
+                        source_fault("source-view named return lacks declared argument provenance")
+                    })?;
+                    let call = parsed.source_view_named_call_plan(&owner, &index, site)?;
+                    if call.arguments.len() != 1 || call.path.contains("::") {
+                        return Err(source_fault(
+                            "source-view named return needs complete multiargument/source-world provenance",
+                        ));
+                    }
+                    let selected = locals.lookup_ordinary(
+                        OrdinaryNameSite {
+                            source: source.selection(),
+                            body: &self.source.definition.body.key(),
+                            at: u64::from(call.at),
+                            name: &call.path,
+                            context: locals.context(),
+                            namespace: Namespace::Value,
+                        },
+                        &graph,
+                        None,
+                    )?;
+                    if !matches!(selected,NameLookup::Defined(found) if found.identity==*callee)
+                        || previous.source.binding
+                            != Some(selected_binding(
+                                &locals,
+                                &graph,
+                                source,
+                                &owner,
+                                &call.arguments[0],
+                            )?)
+                    {
+                        return Err(source_fault(
+                            "source-view named return binding or callee identity changed",
+                        ));
+                    }
+                    let current = owning_signature(db, *callee, source)?;
+                    if current.fingerprint() != *signature
+                        || current.parameters.len() != 1
+                        || current.generics.iter().any(|g| g.kind != GenericKind::Type)
+                        || current.parameters.iter().any(|p| p.receiver || p.variadic)
+                        || current.header.tokens.iter().any(|t| {
+                            matches!(t.text.as_str(), "async" | "gen" | "unsafe" | "extern")
+                        })
+                    {
+                        return Err(source_fault(
+                            "source-view callee signature/bounds/ordinary ABI differs",
+                        ));
+                    }
+                    let names = SignatureNames::new(&graph, source, &current)?;
+                    let parameter = scalar_signature_term(
+                        &names,
+                        current.parameters[0].symbolic.as_ref(),
+                        &current.parameters[0].ty,
+                    )?;
+                    let result = scalar_signature_term(
+                        &names,
+                        current.result_symbolic.as_ref(),
+                        &current.result,
+                    )?;
+                    if result != *declared {
+                        return Err(source_fault("source-view callee declared return changed"));
+                    }
+                    let (term, runtime) = match (&parameter, &result) {
+                        (TyTerm::Param(parameter), TyTerm::Param(result))
+                            if parameter == result
+                                && parameter.definition == *callee
+                                && current.generics.iter().any(|g| {
+                                    g.ordinal == parameter.ordinal && g.kind == GenericKind::Type
+                                }) =>
+                        {
+                            (previous.source.term(), previous.runtime)
+                        }
+                        (TyTerm::Primitive(parameter), TyTerm::Primitive(result))
+                            if previous.source.term() == &TyTerm::Primitive(*parameter)
+                                && primitive_runtime_id(*parameter)? == previous.runtime =>
+                        {
+                            (&result, primitive_runtime_id(*result)?)
+                        }
+                        _ => {
+                            return Err(source_fault(
+                                "source-view named return substitution needs further matched call admission",
+                            ));
+                        }
+                    };
+                    let mut dependencies = require_definition(db, source, &self.source.definition)?;
+                    merge_dependencies(&mut dependencies, &previous.source.dependencies)?;
+                    for key in [
+                        InputKey::DefinitionSource(*callee),
+                        InputKey::DefinitionHeader(*callee),
+                        InputKey::DeclarationContext(*callee),
+                        InputKey::DefinitionBody(*callee),
+                    ] {
+                        let (_, fingerprint) = db
+                            .published_input(&key)
+                            .ok_or_else(|| source_fault("source-view callee publication absent"))?;
+                        dependencies.push((key, fingerprint));
+                    }
+                    checked_pair(
+                        db,
+                        owner.clone(),
+                        term,
+                        None,
+                        previous.source.provenance(),
+                        step.clone(),
+                        dependencies,
+                        runtime,
+                        limit,
+                    )?
+                }
+                _ => {
+                    return Err(source_fault(
+                        "source-view provenance order is not established",
+                    ));
+                }
+            });
+        }
+        let replay = replay.ok_or_else(|| source_fault("source-view provenance is empty"))?;
+        if replay.source.identity() != self.source.identity()
+            || replay.runtime != self.runtime
+            || replay.source.metadata_bytes() != self.source.metadata_bytes()
+        {
+            return Err(source_fault(
+                "source-view immutable plan differs from current source replay",
+            ));
+        }
+        let stamps = db.source_view_namespace_stamps()?;
+        let mut bytes = std::mem::size_of::<SourceViewAdmission>()
+            .checked_add(replay.source.metadata_bytes())
+            .ok_or_else(metadata_fault)?;
+        for key in stamps.keys() {
+            bytes = bytes
+                .checked_add(
+                    std::mem::size_of::<(InputKey, Digest)>()
+                        .checked_add(128)
+                        .ok_or_else(metadata_fault)?,
+                )
+                .and_then(|bytes| bytes.checked_add(key.heap_bytes()))
+                .filter(|bytes| *bytes <= limit)
+                .ok_or_else(metadata_fault)?;
+        }
+        if bytes > limit {
+            return Err(metadata_fault());
+        }
+        Ok(SourceViewAdmission {
+            view: replay,
+            environment: environment_digest,
+            seal,
+            seal_fingerprint,
+            stamps,
+            bytes,
+        })
+    }
+}
+impl SourceViewAdmission {
+    pub(crate) fn identity(&self) -> Digest {
+        let mut encoded = StableEncoder::new("lrr/v1/current-source-view-admission");
+        encoded.digest(self.view.source.identity());
+        encoded.u32(self.view.runtime.0);
+        encoded.option(&self.environment, |encoded, environment| {
+            encoded.digest(*environment)
+        });
+        encoded.record(&self.seal);
+        encoded.digest(self.seal_fingerprint);
+        encoded.u64(u64::try_from(self.stamps.len()).expect("bounded currentness stamps"));
+        for (key, fingerprint) in &self.stamps {
+            encoded.record(key);
+            encoded.digest(*fingerprint);
+        }
+        encoded.finish()
+    }
+    pub(crate) fn source(&self) -> &SourceViewPlan {
+        self.view.source()
+    }
+    pub(crate) fn runtime(&self) -> TypeId {
+        self.view.runtime()
+    }
+    pub(crate) fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+    pub(crate) fn revalidate(
+        &self,
+        db: &Database,
+        source: &PreparedSourceView,
+        environment: Option<&GenericEnv>,
+        expected: &SourceViewPairPlan,
+    ) -> Result<(), Diagnostic> {
+        if self.view.source.identity() != expected.source.identity()
+            || self.view.runtime != expected.runtime
+            || self.stamps != db.source_view_namespace_stamps()?
+        {
+            return Err(source_fault(
+                "source-view certificate plan or current membership changed",
+            ));
+        }
+        let fresh = expected.admit_current(db, source, environment, self.bytes)?;
+        if fresh.environment != self.environment
+            || fresh.seal != self.seal
+            || fresh.seal_fingerprint != self.seal_fingerprint
+            || fresh.stamps != self.stamps
+        {
+            return Err(source_fault(
+                "source-view certificate ParamEnv/seal/world changed",
+            ));
+        }
+        Ok(())
+    }
+}
