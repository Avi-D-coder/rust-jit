+#[test]
+fn descriptor_equality_cannot_admit_tampered_term_provenance_or_dependencies() {
+    let (db, view, environment, plan) = explicit();
+    let mut wrong = plan.clone();
+    wrong.source.term = TyTerm::Primitive(PrimitiveType::I32);
+    assert!(
+        wrong
+            .admit_current(&db, &view, Some(&environment), SOURCE_VIEW_BUDGET)
+            .is_err()
+    );
+    let mut wrong = plan.clone();
+    wrong.source.dependencies = Box::new([]);
+    assert!(
+        wrong
+            .admit_current(&db, &view, Some(&environment), SOURCE_VIEW_BUDGET)
+            .is_err()
+    );
+    let mut wrong = plan.clone();
+    if let Some(SourcePropagation::LocalAlias { destination, .. }) =
+        wrong.source.provenance.last_mut()
+    {
+        *destination = Digest::of_bytes(b"LRR forged alias binding");
+    } else {
+        panic!()
+    }
+    assert!(
+        wrong
+            .admit_current(&db, &view, Some(&environment), SOURCE_VIEW_BUDGET)
+            .is_err()
+    );
+    let mut wrong = plan.clone();
+    wrong.source.bytes = 0;
+    assert!(
+        wrong
+            .admit_current(&db, &view, Some(&environment), SOURCE_VIEW_BUDGET)
+            .is_err()
+    );
+    let mut certificate = plan
+        .admit_current(&db, &view, Some(&environment), SOURCE_VIEW_BUDGET)
+        .unwrap();
+    certificate.stamps.clear();
+    assert!(
+        certificate
+            .revalidate(&db, &view, Some(&environment), &plan)
+            .is_err()
+    );
+}
