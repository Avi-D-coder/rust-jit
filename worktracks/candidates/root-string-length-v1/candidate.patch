+//! Compiler-owned `str::len`: the pinned core body is `self.as_bytes().len()`.
+//! This declaration does not grant receiver/source or physical lease authority.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncoder},
+        profile::ProfileIdentity,
+    },
+    ir::op::PrimitiveType,
+};
+use std::sync::Arc;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-STRING-METHOD", message.into())
+}
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct StringLenMethod {
+    profile: Arc<ProfileIdentity>,
+    core: Digest,
+    signature: Digest,
+    body: Digest,
+    identity: Digest,
+}
+impl StringLenMethod {
+    pub(crate) fn require_profile(&self, profile: &ProfileIdentity) -> Result<(), Diagnostic> {
+        profile.validate_source()?;
+        if self.profile.as_ref() != profile || self.core != super::unit(profile, "core") {
+            return Err(fault("str method owning profile/core differs"));
+        }
+        Ok(())
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>()
+            .checked_add(std::mem::size_of::<ProfileIdentity>())?
+            .checked_add(2 * std::mem::size_of::<usize>())?
+            .checked_add(self.profile.semantics.capacity())
+    }
+}
+#[derive(Debug, Clone)]
+pub(crate) struct StringMethods {
+    profile: Arc<ProfileIdentity>,
+    len: StringLenMethod,
+    identity: Digest,
+}
+impl StringMethods {
+    pub(crate) fn for_profile(profile: &ProfileIdentity) -> Result<Self, Diagnostic> {
+        profile.validate_source()?;
+        let profile = Arc::new(profile.clone());
+        let core = super::unit(&profile, "core");
+        let mut signature = StableEncoder::new("lrr/v1/str-len-signature");
+        signature.digest(core);
+        signature.record(profile.as_ref());
+        signature.string("str");
+        signature.string("len");
+        signature.u8(0); // shared receiver; no explicit arguments or generics
+        signature.u32(0);
+        signature.u32(PrimitiveType::Usize.tag());
+        signature.bool(true); // const
+        let signature = signature.finish();
+        let mut body = StableEncoder::new("lrr/v1/str-len-body");
+        body.digest(signature);
+        body.u8(0); // UTF-8 byte length, including NUL bytes; no scan/effects
+        let body = body.finish();
+        let mut member = StableEncoder::new("lrr/v1/str-len-member");
+        member.digest(core);
+        member.record(profile.as_ref());
+        member.digest(signature);
+        member.digest(body);
+        let len = StringLenMethod {
+            profile: profile.clone(),
+            core,
+            signature,
+            body,
+            identity: member.finish(),
+        };
+        let mut facet = StableEncoder::new("lrr/v1/str-method-facet");
+        facet.record(profile.as_ref());
+        facet.digest(core);
+        facet.digest(len.identity);
+        Ok(Self {
+            profile,
+            len,
+            identity: facet.finish(),
+        })
+    }
+    pub(crate) fn profile(&self) -> &ProfileIdentity {
+        &self.profile
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(crate) fn lookup(&self, name: &str) -> Option<&StringLenMethod> {
+        (name == "len").then_some(&self.len)
+    }
+    pub(crate) fn require_member(&self, member: &StringLenMethod) -> Result<(), Diagnostic> {
+        member.require_profile(&self.profile)?;
+        if member != &self.len {
+            return Err(fault("str method signature/body/member identity differs"));
+        }
+        Ok(())
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(
+                self.len
+                    .allocated_bytes()
+                    .ok_or_else(|| fault("str method metadata overflow"))?,
+            )
+            .ok_or_else(|| fault("str method facet metadata overflow"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn string_member_refuses_changed_signature_body_core_and_profile() {
+        let facet = StringMethods::for_profile(&ProfileIdentity::current()).unwrap();
+        let actual = facet.lookup("len").unwrap();
+        for kind in 0..4 {
+            let mut wrong = actual.clone();
+            match kind {
+                0 => wrong.signature = Digest([231; 32]),
+                1 => wrong.body = Digest([232; 32]),
+                2 => wrong.core = Digest([233; 32]),
+                _ => {
+                    wrong.profile = Arc::new(ProfileIdentity {
+                        edition: 2015,
+                        ..ProfileIdentity::current()
+                    })
+                }
+            }
+            assert!(facet.require_member(&wrong).is_err());
+        }
+        facet.require_member(actual).unwrap();
+        assert!(facet.lookup("as_bytes").is_none());
+    }
+}
