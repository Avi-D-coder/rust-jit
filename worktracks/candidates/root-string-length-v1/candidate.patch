+/// Retain the source-selected member kind with the reached receiver witness.
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) enum PrimitiveMethodAdmission {
+    Float(PrimitiveFloatAdmission),
+    StringLength {
+        written: RuntimePrimitiveMethod,
+        member: crate::facade::string_methods::StringLenMethod,
+    },
+}
+impl PrimitiveMethodAdmission {
+    pub(crate) fn select(
+        written: RuntimePrimitiveMethod,
+        source: &PreparedSourceView,
+        catalog: &RuntimeMacroCatalog,
+        frame: &Frame,
+        store: &GuestStore,
+    ) -> Result<Self, Diagnostic> {
+        if written.kind() == RuntimePrimitiveMethodKind::IsNan {
+            return PrimitiveFloatAdmission::select(written, source, catalog, frame, store)
+                .map(Self::Float);
+        }
+        written.require(&source.selection().outline.parse, frame.pc())?;
+        if frame.body.body() != &written.span().body_key
+            || !matches!(frame.source_view_ref(written.receiver())?,
+                Some(TyTerm::Ref(_, false, target)) if target.as_ref() == &TyTerm::Str)
+        {
+            return Err(fault(
+                "str::len requires its actual shared str source receiver",
+            ));
+        }
+        store.require_static_string_value(frame.cell(written.receiver())?)?;
+        let member = catalog
+            .string_len_method()
+            .ok_or_else(|| fault("str::len compiler member is unavailable"))?;
+        member.require_profile(&source.selection().outline.parse.profile)?;
+        catalog.require_string_len_method(member)?;
+        Ok(Self::StringLength {
+            written,
+            member: member.clone(),
+        })
+    }
+    pub(crate) fn operation(
+        &self,
+        written: &RuntimePrimitiveMethod,
+        source: &PreparedSourceView,
+        key: &PcKey,
+    ) -> Result<Op, Diagnostic> {
+        match self {
+            Self::Float(admission) => admission.operation(written, source, key),
+            Self::StringLength {
+                written: selected,
+                member,
+            } => {
+                written.require(&source.selection().outline.parse, key)?;
+                if written != selected || written.kind() != RuntimePrimitiveMethodKind::StrByteLen {
+                    return Err(fault("str::len admission source phase/member differs"));
+                }
+                member.require_profile(&source.selection().outline.parse.profile)?;
+                Ok(Op::StrByteLen {
+                    source: written.receiver(),
+                    destination: written.destination(),
+                })
+            }
+        }
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>().checked_add(match self {
+            Self::Float(admission) => admission.allocated_bytes()?,
+            Self::StringLength { written, member } => written
+                .allocated_bytes()?
+                .checked_add(member.allocated_bytes()?)?,
+        })
+    }
+}
