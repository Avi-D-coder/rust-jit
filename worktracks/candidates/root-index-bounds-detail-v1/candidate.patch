+        message
+            .try_reserve_exact(CAPACITY)
+            .map_err(|_| resource())?;
+        match self {
+            Self::IndexOutOfBounds { length, index } => {
+                write!(
+                    &mut message,
+                    "index out of bounds: the len is {length} but the index is {index}"
+                )
+                .map_err(|_| resource())?;
+            }
+        }
+        Ok(message)
+    }
