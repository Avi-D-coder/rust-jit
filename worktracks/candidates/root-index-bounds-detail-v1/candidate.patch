+impl PlacePanic {
+    pub(crate) fn message(self) -> Result<String, Diagnostic> {
+        use std::fmt::Write;
+        // Fixed formatting of a u32 length and full evaluated u64 index. Admit
+        // every byte before formatting; no guest-dependent allocation length.
+        const CAPACITY: usize =
+            "index out of bounds: the len is ".len() + 10 + " but the index is ".len() + 20;
