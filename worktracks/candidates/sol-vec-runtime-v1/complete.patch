+// Type-only lexical constraint: suffix/primitive kind, never numeric conversion,
+// name lookup, const evaluation or a callee body query. Unknown shapes need a root source view.
+fn literal_element_context(
+    parsed: &ParsedFile,
+    ranges: &[SourceRange],
+) -> Result<Option<PrimitiveType>, Diagnostic> {
+    let mut category: Option<u8> = None;
+    let mut suffix = None;
+    for r in ranges {
+        let source = parsed
+            .parsed
+            .tree()
+            .syntax()
+            .text()
+            .slice(TextRange::new(
+                TextSize::from(r.start),
+                TextSize::from(r.end),
+            ))
+            .to_string();
+        let wrapped = format!("fn __lrr_vec_type(){{let __x={source};}}");
+        let edition = match parsed.edition {
+            2015 => Edition::Edition2015,
+            2018 => Edition::Edition2018,
+            2021 => Edition::Edition2021,
+            2024 => Edition::Edition2024,
+            _ => return Err(fault("Vec context edition unsupported")),
+        };
+        let ast = ast::SourceFile::parse(&wrapped, edition);
+        if !ast.errors().is_empty() {
+            return Err(fault("Vec context syntax differs"));
+        }
+        let Some(mut expression) = ast
+            .tree()
+            .syntax()
+            .descendants()
+            .find_map(ast::LetStmt::cast)
+            .and_then(|s| s.initializer())
+        else {
+            return Err(fault("Vec type wrapper lacks initializer"));
+        };
+        let mut depth = 0;
+        loop {
+            depth += 1;
+            if depth > 128 {
+                return Err(fault("Vec type grouping limit"));
+            }
+            if expression
+                .syntax()
+                .children()
+                .any(|n| ast::Attr::can_cast(n.kind()))
+            {
+                return Ok(None);
+            }
+            match expression {
+                ast::Expr::ParenExpr(p) => {
+                    expression = p.expr().ok_or_else(|| fault("Vec type group absent"))?
+                }
+                ast::Expr::PrefixExpr(p) if p.op_kind() == Some(ast::UnaryOp::Neg) => {
+                    expression = p.expr().ok_or_else(|| fault("Vec type prefix absent"))?
+                }
+                _ => break,
+            }
+        }
+        use PrimitiveType as P;
+        let (kind, ty) = match expression {
+            ast::Expr::TupleExpr(t) if t.fields().next().is_none() => (5, Some(P::Unit)),
+            ast::Expr::Literal(l) => match l.kind() {
+                ast::LiteralKind::IntNumber(n) => {
+                    let ty = match n.suffix() {
+                        None => None,
+                        Some("i8") => Some(P::I8),
+                        Some("i16") => Some(P::I16),
+                        Some("i32") => Some(P::I32),
+                        Some("i64") => Some(P::I64),
+                        Some("isize") => Some(P::Isize),
+                        Some("u8") => Some(P::U8),
+                        Some("u16") => Some(P::U16),
+                        Some("u32") => Some(P::U32),
+                        Some("u64") => Some(P::U64),
+                        Some("usize") => Some(P::Usize),
+                        _ => return Ok(None),
+                    };
+                    (0, ty)
+                }
+                ast::LiteralKind::FloatNumber(n) => (
+                    1,
+                    match n.suffix() {
+                        None => None,
+                        Some("f32") => Some(P::F32),
+                        Some("f64") => Some(P::F64),
+                        _ => return Ok(None),
+                    },
+                ),
+                ast::LiteralKind::Bool(_) => (2, Some(P::Bool)),
+                ast::LiteralKind::Char(_) => (3, Some(P::Char)),
+                ast::LiteralKind::Byte(_) => (4, Some(P::U8)),
+                _ => return Ok(None),
+            },
+            _ => return Ok(None),
+        };
+        if category.is_some_and(|old| old != kind)
+            || suffix.is_some_and(|old| ty.is_some_and(|t| t != old))
+        {
+            return Ok(None);
+        }
+        category = Some(kind);
+        if ty.is_some() {
+            suffix = ty;
+        }
+    }
+    Ok(suffix.or(match category {
+        Some(0) => Some(PrimitiveType::I32),
+        Some(1) => Some(PrimitiveType::F64),
+        _ => None,
+    }))
+}
