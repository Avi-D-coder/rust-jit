+//! Source-owned Vec macro phases. No guest storage, descriptor guesses or cold operand decoding.
+use crate::{
+    core::diagnostic::Diagnostic,
+    expand::scopes::MacroDefinition,
+    facade::macros::RuntimeMacroKind,
+    frontend::runtime_macro_plan::RuntimeIntrinsicPlan,
+    ir::{
+        op::{DecodedLiteral, HintRecipe, LiteralKind, Op, PrimitiveType},
+        pc::{NodeId, PcKey, Phase, SlotId, SlotKind},
+    },
+    source::manifest::BodyKey,
+    syntax::{
+        ast_adapter::range,
+        body_index::{BodyIndex, ExpressionKind, NodeRole},
+        outline::BodyHandle,
+        parse::{ParseKey, ParsedFile},
+        runtime_macro_arguments::VecForm,
+        spans::{BodySpan, SourceRange},
+        thunks::literal_recipe,
+    },
+};
+use ra_ap_syntax::{AstNode, Edition, TextRange, TextSize, ast};
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-RUNTIME-MACRO", message.into())
+}
+fn pending(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-UNSUPPORTED", message.into())
+}
+#[derive(Debug, Clone)]
+pub struct VectorOperand {
+    span: BodySpan,
+    range: SourceRange,
+    value: SlotId,
+    entry: PcKey,
+    transfer: PcKey,
+}
+impl VectorOperand {
+    pub fn span(&self) -> &BodySpan {
+        &self.span
+    }
+    pub fn value(&self) -> SlotId {
+        self.value
+    }
+    pub fn entry(&self) -> &PcKey {
+        &self.entry
+    }
+    pub fn transfer(&self) -> &PcKey {
+        &self.transfer
+    }
+}
+#[derive(Debug)]
+pub struct SourceVectorPlan {
+    source: ParseKey,
+    body: BodyKey,
+    node: NodeId,
+    definition: MacroDefinition,
+    operands: Vec<VectorOperand>,
+    result: SlotId,
+    entry: PcKey,
+    commit: PcKey,
+    literal_element: Option<PrimitiveType>,
+    cfg: crate::core::digest::Digest,
+}
+impl SourceVectorPlan {
+    pub fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.source.profile.semantics.capacity())
+            .and_then(|n| {
+                n.checked_add(
+                    self.operands
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<VectorOperand>())?,
+                )
+            })
+            .filter(|n| *n <= 32 * 1024 * 1024)
+            .ok_or_else(|| {
+                Diagnostic::new(
+                    "LRR-E-METADATA-LIMIT",
+                    "Vec source plan metadata budget".into(),
+                )
+            })
+    }
+    pub fn source(&self) -> &ParseKey {
+        &self.source
+    }
+    pub fn literal_element(&self) -> Option<PrimitiveType> {
+        self.literal_element
+    }
+    pub fn definition(&self) -> &MacroDefinition {
+        &self.definition
+    }
+    pub fn operands(&self) -> &[VectorOperand] {
+        &self.operands
+    }
+    pub fn entry(&self) -> &PcKey {
+        &self.entry
+    }
+    pub fn commit(&self) -> &PcKey {
+        &self.commit
+    }
+    pub fn result(&self) -> SlotId {
+        self.result
+    }
+    pub fn node(&self) -> NodeId {
+        self.node
+    }
+    /// Root must reserve a real macro construction guard and register ordinary cleanup.
+    /// No even value slot is silently repurposed as a guard.
+    pub fn require_guard(&self, index: &BodyIndex, guard: SlotId) -> Result<(), Diagnostic> {
+        if index.profile() != &self.source.profile
+            || crate::core::digest::StableEncode::fingerprint(index.cfg()) != self.cfg
+            || index.body() != &self.body
+            || index.slot_kind(guard)? != SlotKind::Guard
+            || index.constructor_node(guard)?.id != self.node
+        {
+            return Err(fault("Vec guard is not reserved for this exact macro node"));
+        }
+        Ok(())
+    }
+    pub fn transfer(
+        &self,
+        index: &BodyIndex,
+        ordinal: u32,
+    ) -> Result<VectorTransferProof, Diagnostic> {
+        let guard = index
+            .nodes()
+            .get(self.node.0 as usize)
+            .and_then(|n| n.constructor_guard)
+            .ok_or_else(|| fault("Vec transfer guard unreserved"))?;
+        self.require_guard(index, guard)?;
+        let operand = self
+            .operands
+            .get(ordinal as usize)
+            .ok_or_else(|| fault("Vec transfer ordinal absent"))?;
+        Ok(VectorTransferProof {
+            source: self.source.clone(),
+            body: self.body.clone(),
+            cfg: self.cfg,
+            definition: self.definition.clone(),
+            node: self.node,
+            guard,
+            ordinal,
+            value: operand.value,
+            pc: operand.transfer.clone(),
+            span: operand.span.clone(),
+        })
+    }
+    /// Lower exactly one reached phase; no successor is fetched and no later
+    /// operand is decoded. Root supplies current source dependencies and installs
+    /// the matching prepared frame constructor before executing Entry.
+    pub fn phase_recipe(
+        &self,
+        parsed: &ParsedFile,
+        index: &BodyIndex,
+        key: &PcKey,
+        element: PrimitiveType,
+        after: PcKey,
+        dependencies: Vec<crate::ir::recipe::FactDependency>,
+    ) -> Result<crate::ir::recipe::VerifiedRecipe, Diagnostic> {
+        use crate::ir::{
+            recipe::{Origin, RecipeDraft, RecipeExit},
+            validate::verify,
+        };
+        if parsed.key() != self.source || key.body != self.body || key.node != self.node.0 {
+            return Err(fault(
+                "Vec reached phase differs from prepared source/body/node",
+            ));
+        }
+        let guard = index
+            .nodes()
+            .get(self.node.0 as usize)
+            .and_then(|n| n.constructor_guard)
+            .ok_or_else(|| fault("Vec constructor guard absent"))?;
+        self.require_guard(index, guard)?;
+        let (operations, next) = if key == &self.entry {
+            (
+                vec![Op::ConstructStart { guard }],
+                self.operands
+                    .first()
+                    .map(|o| o.entry.clone())
+                    .unwrap_or_else(|| self.commit.clone()),
+            )
+        } else if key == &self.commit {
+            (
+                vec![Op::ConstructFinish {
+                    guard,
+                    destination: self.result,
+                }],
+                after,
+            )
+        } else {
+            let Phase::Operand(phase) = Phase::from_code(key.phase) else {
+                return Err(fault("Vec phase is not admitted"));
+            };
+            let ordinal = u32::from(phase) / 2;
+            let operand = self
+                .operands
+                .get(ordinal as usize)
+                .ok_or_else(|| fault("Vec reached operand absent"))?;
+            if phase % 2 == 0 {
+                if key != &operand.entry {
+                    return Err(fault("Vec operand Entry identity mismatch"));
+                }
+                (
+                    self.lower_scalar_operand(parsed, ordinal, element)?,
+                    operand.transfer.clone(),
+                )
+            } else {
+                if key != &operand.transfer {
+                    return Err(fault("Vec transfer identity mismatch"));
+                }
+                let next = self
+                    .operands
+                    .get(ordinal as usize + 1)
+                    .map(|o| o.entry.clone())
+                    .unwrap_or_else(|| self.commit.clone());
+                (
+                    vec![Op::VecConstructField {
+                        transfer: Box::new(self.transfer(index, ordinal)?),
+                    }],
+                    next,
+                )
+            }
+        };
+        verify(
+            crate::frontend::thunks::with_temporary_scope_entry(
+                index,
+                RecipeDraft {
+                    key: key.clone(),
+                    origin: Origin {
+                        span: index.span(self.node)?,
+                        expansion_ancestry: vec![],
+                    },
+                    operations,
+                    exits: vec![RecipeExit::Next(next)],
+                    dependencies,
+                },
+            )?,
+            index,
+        )
+    }
+    /// Only this reached field is parsed/decoded. General expression fragments
+    /// require the existing source/expansion continuation integration, not replay.
+    pub fn lower_scalar_operand(
+        &self,
+        parsed: &ParsedFile,
+        ordinal: u32,
+        element: PrimitiveType,
+    ) -> Result<Vec<Op>, Diagnostic> {
+        if parsed.key() != self.source {
+            return Err(fault("Vec operand source/profile is stale"));
+        }
+        crate::runtime::shape::PrimitiveIdentity::from_recipe(element)?;
+        let operand = self
+            .operands
+            .get(usize::try_from(ordinal).map_err(|_| fault("Vec operand ordinal overflow"))?)
+            .ok_or_else(|| fault("Vec reached operand absent"))?;
+        let tree = parsed.parsed.tree();
+        let text = tree
+            .syntax()
+            .text()
+            .slice(TextRange::new(
+                TextSize::from(operand.range.start),
+                TextSize::from(operand.range.end),
+            ))
+            .to_string();
+        let prefix = "fn __lrr_vec_operand(){let __value=";
+        let mut wrapped = String::new();
+        let bytes = prefix
+            .len()
+            .checked_add(text.len())
+            .and_then(|n| n.checked_add(2))
+            .ok_or_else(|| fault("Vec operand wrapper size overflow"))?;
+        wrapped
+            .try_reserve_exact(bytes)
+            .map_err(|_| fault("Vec operand wrapper allocation"))?;
+        wrapped.push_str(prefix);
+        wrapped.push_str(&text);
+        wrapped.push_str(";}");
+        let edition = match parsed.edition {
+            2015 => Edition::Edition2015,
+            2018 => Edition::Edition2018,
+            2021 => Edition::Edition2021,
+            2024 => Edition::Edition2024,
+            _ => return Err(fault("Vec operand edition unsupported")),
+        };
+        let syntax = ast::SourceFile::parse(&wrapped, edition);
+        if !syntax.errors().is_empty() {
+            return Err(fault("Vec operand syntax differs from captured source"));
+        }
+        let mut expression = syntax
+            .tree()
+            .syntax()
+            .descendants()
+            .find_map(ast::LetStmt::cast)
+            .and_then(|s| s.initializer())
+            .ok_or_else(|| fault("Vec operand wrapper initializer absent"))?;
+        let mut depth = 0usize;
+        while let ast::Expr::ParenExpr(p) = &expression {
+            depth += 1;
+            if depth >= 128 {
+                return Err(fault("Vec operand grouping limit"));
+            }
+            if expression
+                .syntax()
+                .children()
+                .any(|n| ast::Attr::can_cast(n.kind()))
+            {
+                return Err(pending(
+                    "Vec attributed operand awaits expansion continuation",
+                ));
+            }
+            expression = p
+                .expr()
+                .ok_or_else(|| fault("Vec operand group missing expression"))?;
+        }
+        let lexical_range = expression.syntax().text_range();
+        let lexical_spelling = expression.syntax().text().to_string();
+        let base = operand.span.relative_start;
+        let map = |offset: TextSize| {
+            u32::from(offset)
+                .checked_sub(
+                    u32::try_from(prefix.len())
+                        .map_err(|_| fault("Vec operand prefix overflow"))?,
+                )
+                .and_then(|n| base.checked_add(n))
+                .ok_or_else(|| fault("Vec literal origin overflow"))
+        };
+        let literal_span = BodySpan {
+            body_key: self.body.clone(),
+            relative_start: map(lexical_range.start())?,
+            relative_end: map(lexical_range.end())?,
+        };
+        let mut negative = false;
+        if let ast::Expr::PrefixExpr(p) = &expression {
+            if p.op_kind() != Some(ast::UnaryOp::Neg) {
+                return Err(pending(
+                    "Vec unary operand awaits general expression continuation",
+                ));
+            }
+            negative = true;
+            expression = p
+                .expr()
+                .ok_or_else(|| fault("Vec negated operand missing literal"))?;
+        }
+        if expression
+            .syntax()
+            .children()
+            .any(|n| ast::Attr::can_cast(n.kind()))
+        {
+            return Err(pending(
+                "Vec attributed operand awaits expansion continuation",
+            ));
+        }
+        if let ast::Expr::TupleExpr(t) = &expression
+            && t.fields().next().is_none()
+            && !negative
+        {
+            if element != PrimitiveType::Unit {
+                return Err(fault(
+                    "Vec unit operand conflicts with concrete element context",
+                ));
+            }
+            return Ok(vec![Op::Unit {
+                destination: operand.value,
+            }]);
+        }
+        let ast::Expr::Literal(literal) = expression else {
+            return Err(pending(
+                "Vec non-literal operand awaits source-owned expression continuation",
+            ));
+        };
+        if !matches!(
+            literal.kind(),
+            ast::LiteralKind::IntNumber(_)
+                | ast::LiteralKind::FloatNumber(_)
+                | ast::LiteralKind::Bool(_)
+                | ast::LiteralKind::Char(_)
+                | ast::LiteralKind::Byte(_)
+        ) {
+            return Err(pending(
+                "Vec owning/borrowed element awaits source/drop integration",
+            ));
+        }
+        let mut recipe = literal_recipe(&literal, literal_span)?;
+        // The whole original operand span is retained; the wrapper never creates a body.
+        recipe.spelling = lexical_spelling;
+        if negative {
+            if recipe.kind != LiteralKind::Integer {
+                return Err(pending(
+                    "Vec folded negation requires an integer literal in this slice",
+                ));
+            }
+            let Some(
+                DecodedLiteral::Integer { negative: flag, .. }
+                | DecodedLiteral::InvalidInteger { negative: flag, .. },
+            ) = recipe.decoded.as_mut()
+            else {
+                return Err(fault("Vec integer decoding unavailable"));
+            };
+            *flag = true;
+        }
+        Ok(vec![Op::Literal {
+            literal: recipe,
+            hint: HintRecipe::Primitive(element),
+            destination: operand.value,
+        }])
+    }
+}
+pub fn prepare_vector_structure(
+    parsed: &ParsedFile,
+    intrinsic: &RuntimeIntrinsicPlan,
+    handle: &BodyHandle,
+    index: &BodyIndex,
+) -> Result<SourceVectorPlan, Diagnostic> {
+    intrinsic.arguments().require_source(&parsed.key())?;
+    handle.require_entry()?;
+    if intrinsic.arguments().kind() != RuntimeMacroKind::Vec {
+        return Err(fault(
+            "Vec phase plan requires selected compiler Vec definition",
+        ));
+    }
+    if parsed.generated_origin.is_some() {
+        return Err(pending(
+            "generated Vec phase plan requires token-origin continuation",
+        ));
+    }
+    if handle.key() != *index.body() {
+        return Err(fault("Vec phase body identity differs"));
+    }
+    match intrinsic.arguments().vec_form() {
+        Some(VecForm::Empty | VecForm::List) => {}
+        Some(VecForm::Repeat) => {
+            return Err(pending(
+                "Vec repeat requires selected Clone and zero-length initializer/drop continuation",
+            ));
+        }
+        None => return Err(fault("Vec source form is absent")),
+    }
+    let invocation = intrinsic.invocation().range();
+    let node = index
+        .nodes()
+        .iter()
+        .find(|n| {
+            n.role == NodeRole::Expression(ExpressionKind::Macro)
+                && n.range.start.checked_add(handle.range.start) == Some(invocation.start)
+                && n.range.end.checked_add(handle.range.start) == Some(invocation.end)
+        })
+        .ok_or_else(|| fault("Vec source range is not this exact entered macro"))?;
+    if !handle.range.contains(invocation) {
+        return Err(fault("Vec invocation escapes body"));
+    }
+    intrinsic
+        .arguments()
+        .operands()
+        .len()
+        .checked_mul(std::mem::size_of::<VectorOperand>())
+        .and_then(|n| n.checked_add(std::mem::size_of::<SourceVectorPlan>()))
+        .filter(|n| *n <= 32 * 1024 * 1024)
+        .ok_or_else(|| {
+            Diagnostic::new(
+                "LRR-E-METADATA-LIMIT",
+                "Vec source operand metadata budget".into(),
+            )
+        })?;
+    let mut operands = Vec::new();
+    operands
+        .try_reserve_exact(intrinsic.arguments().operands().len())
+        .map_err(|_| fault("Vec operand plan allocation"))?;
+    for (ordinal, r) in intrinsic.arguments().operands().iter().enumerate() {
+        if !invocation.contains(*r) {
+            return Err(fault("Vec operand escapes invocation"));
+        }
+        let value = *node
+            .runtime_scalar_slots
+            .get(ordinal)
+            .ok_or_else(|| fault("Vec scalar reservation is exhausted"))?;
+        if index.slot_kind(value)? != SlotKind::Value {
+            return Err(fault("Vec operand reservation is not a value"));
+        }
+        let phase = u16::try_from(ordinal)
+            .ok()
+            .and_then(|n| n.checked_mul(2))
+            .ok_or_else(|| fault("Vec operand phase overflow"))?;
+        if u32::from(node.runtime_scalar_phases) < u32::from(phase) + 2 {
+            return Err(fault(
+                "Vec operand phases exceed original structural reservation",
+            ));
+        }
+        operands.push(VectorOperand {
+            span: BodySpan {
+                body_key: index.body().clone(),
+                relative_start: r
+                    .start
+                    .checked_sub(handle.range.start)
+                    .ok_or_else(|| fault("Vec operand origin overflow"))?,
+                relative_end: r
+                    .end
+                    .checked_sub(handle.range.start)
+                    .ok_or_else(|| fault("Vec operand origin overflow"))?,
+            },
+            range: *r,
+            value,
+            entry: index.pc(node.id, Phase::Operand(phase))?,
+            transfer: index.pc(
+                node.id,
+                Phase::Operand(
+                    phase
+                        .checked_add(1)
+                        .ok_or_else(|| fault("Vec operand phase overflow"))?,
+                ),
+            )?,
+        });
+    }
+    let plan = SourceVectorPlan {
+        source: parsed.key(),
+        body: index.body().clone(),
+        node: node.id,
+        definition: intrinsic.definition().clone(),
+        operands,
+        result: node.value.ok_or_else(|| fault("Vec result value absent"))?,
+        entry: index.pc(node.id, Phase::Entry)?,
+        commit: index.pc(node.id, Phase::Commit)?,
+        literal_element: literal_element_context(parsed, intrinsic.arguments().operands())?,
+        cfg: crate::core::digest::StableEncode::fingerprint(index.cfg()),
+    };
+    plan.metadata_bytes()?;
+    Ok(plan)
+}
