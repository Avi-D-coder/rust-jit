+/// Exact private source descriptor for a macro-token operand, not an arbitrary
+/// relaxation of the ordinary constructor's indexed-child rule.
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct VectorTransferProof {
+    source: ParseKey,
+    body: BodyKey,
+    cfg: crate::core::digest::Digest,
+    definition: MacroDefinition,
+    node: NodeId,
+    guard: SlotId,
+    ordinal: u32,
+    value: SlotId,
+    pc: PcKey,
+    span: BodySpan,
+}
+impl VectorTransferProof {
+    pub fn guard(&self) -> SlotId {
+        self.guard
+    }
+    pub fn ordinal(&self) -> u32 {
+        self.ordinal
+    }
+    pub fn value(&self) -> SlotId {
+        self.value
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>().checked_add(self.source.profile.semantics.capacity())
+    }
+    pub(crate) fn matches(
+        &self,
+        index: &BodyIndex,
+        draft: &crate::ir::recipe::RecipeDraft,
+    ) -> Result<bool, Diagnostic> {
+        if index.body() != &self.body
+            || draft.key != self.pc
+            || self.source.profile != *index.profile()
+            || crate::core::digest::StableEncode::fingerprint(index.cfg()) != self.cfg
+            || draft.origin.span != index.span(self.node)?
+        {
+            return Ok(false);
+        }
+        let Some(node) = index.nodes().get(self.node.0 as usize) else {
+            return Ok(false);
+        };
+        let expected_phase = self
+            .ordinal
+            .checked_mul(2)
+            .and_then(|n| n.checked_add(1))
+            .and_then(|n| u16::try_from(n).ok())
+            .and_then(|n| Phase::Operand(n).code().ok());
+        if node.role != NodeRole::Expression(ExpressionKind::Macro)
+            || node.constructor_guard != Some(self.guard)
+            || node.runtime_scalar_slots.get(self.ordinal as usize) != Some(&self.value)
+            || expected_phase != Some(draft.key.phase)
+            || self.span.body_key != self.body
+            || self.span.relative_start < node.range.start
+            || self.span.relative_end > node.range.end
+        {
+            return Ok(false);
+        }
+        let catalog =
+            crate::frontend::runtime_macro_catalog::RuntimeMacroCatalog::standard_for_definition(
+                index.profile(),
+                &self.definition,
+            )?;
+        Ok(catalog.select(&self.definition)? == Some(RuntimeMacroKind::Vec))
+    }
+}
+impl crate::core::digest::StableEncode for VectorTransferProof {
+    const DOMAIN: &'static str = "lrr/v1/source-vec-field-transfer";
+    fn encode_fields(&self, e: &mut crate::core::digest::StableEncoder) {
+        e.record(&self.source);
+        e.record(&self.body);
+        e.digest(self.cfg);
+        e.digest(self.definition.identity);
+        e.digest(self.definition.defining_unit);
+        e.u16(self.definition.definition_edition);
+        e.u32(self.node.0);
+        e.u32(self.guard.0);
+        e.u32(self.ordinal);
+        e.u32(self.value.0);
+        e.record(&self.pc);
+        e.u32(self.span.relative_start);
+        e.u32(self.span.relative_end);
+    }
+}
