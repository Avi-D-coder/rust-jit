+//! One-transition Vec construction helper. Integration uses the same opcode fuel admission.
+use crate::{
+    core::diagnostic::Diagnostic,
+    runtime::{
+        cell::{CellId, ConstructionCleanupTransfer, ConstructionId, GuestStore, TicketId},
+        shape::TypeId,
+    },
+    vm::fuel::RunFuel,
+};
+#[derive(Debug)]
+pub struct VectorConstruction {
+    guard: ConstructionId,
+    ty: TypeId,
+    next: u32,
+    count: u32,
+    done: bool,
+}
+fn invalid() -> Diagnostic {
+    Diagnostic::new(
+        "LRR-E-OWNERSHIP",
+        "Vec construction continuation differs".into(),
+    )
+}
+impl VectorConstruction {
+    pub fn begin(
+        store: &mut GuestStore,
+        fuel: &mut RunFuel,
+        element: TypeId,
+        count: u32,
+    ) -> Result<Self, Diagnostic> {
+        store.preflight_vector_construction(element, count)?;
+        fuel.charge()?;
+        Self::begin_admitted(store, element, count)
+    }
+    /// Called only after the authoritative step loop charged ConstructStart once.
+    pub(crate) fn begin_admitted(
+        store: &mut GuestStore,
+        element: TypeId,
+        count: u32,
+    ) -> Result<Self, Diagnostic> {
+        let (ty, guard) = store.begin_vector_construction(element, count)?;
+        Ok(Self {
+            guard,
+            ty,
+            next: 0,
+            count,
+            done: false,
+        })
+    }
+    pub fn push(
+        &mut self,
+        store: &mut GuestStore,
+        fuel: &mut RunFuel,
+        source: CellId,
+    ) -> Result<(), Diagnostic> {
+        if self.done || self.next >= self.count {
+            return Err(invalid());
+        }
+        store.preflight_vector_source(self.guard, self.next, source)?;
+        fuel.charge()?;
+        self.push_admitted(store, source)
+    }
+    pub(crate) fn push_admitted(
+        &mut self,
+        store: &mut GuestStore,
+        source: CellId,
+    ) -> Result<(), Diagnostic> {
+        if self.done || self.next >= self.count {
+            return Err(invalid());
+        }
+        let next = self.next.checked_add(1).ok_or_else(invalid)?;
+        store.vector_move_from(self.guard, self.next, source)?;
+        self.next = next;
+        Ok(())
+    }
+    pub fn finish(
+        &mut self,
+        store: &mut GuestStore,
+        fuel: &mut RunFuel,
+    ) -> Result<TicketId, Diagnostic> {
+        if self.done || self.next != self.count {
+            return Err(invalid());
+        }
+        store.preflight_vector_finish(self.guard, self.ty)?;
+        fuel.charge()?;
+        self.finish_admitted(store)
+    }
+    pub(crate) fn finish_admitted(
+        &mut self,
+        store: &mut GuestStore,
+    ) -> Result<TicketId, Diagnostic> {
+        if self.done || self.next != self.count {
+            return Err(invalid());
+        }
+        store.preflight_vector_finish(self.guard, self.ty)?;
+        let ticket = store.commit_construction(self.guard, self.ty)?;
+        self.done = true;
+        Ok(ticket)
+    }
+    /// Kernel convenience for admitted scalar-only guards. The frame must retain
+    /// this guard in ordinary cleanup; cancellation does not discard its owners.
+    /// This executes one existing cleanup transition, never an uninterruptible loop.
+    pub fn cleanup_scalar_step(
+        &mut self,
+        store: &mut GuestStore,
+    ) -> Result<Option<u32>, Diagnostic> {
+        if self.done {
+            return Err(invalid());
+        }
+        match store.construction_cleanup_transfer(self.guard)? {
+            ConstructionCleanupTransfer::Field { ordinal, ticket } => {
+                store.discard(ticket)?;
+                store.finish_construction_cleanup_field(self.guard, ordinal, ticket)?;
+                Ok(Some(ordinal))
+            }
+            ConstructionCleanupTransfer::Complete => {
+                self.done = true;
+                Ok(None)
+            }
+        }
+    }
+    pub fn guard(&self) -> ConstructionId {
+        self.guard
+    }
+    pub fn result_type(&self) -> TypeId {
+        self.ty
+    }
+}
