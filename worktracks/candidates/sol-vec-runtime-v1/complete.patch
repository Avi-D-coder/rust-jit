+//! Scalar Vec buffer admission. Facade storage is distinct from fixed array layout.
+use super::*;
+use crate::runtime::{object::MAX_CONSTRUCTION_FIELDS, shape::FacadeType};
+impl GuestStore {
+    pub(crate) fn preflight_vector_construction(
+        &self,
+        element: TypeId,
+        count: u32,
+    ) -> Result<(), Diagnostic> {
+        if self.types.descriptor(element)?.shape != ShapeCategory::Primitive || element.0 == 16 {
+            return Err(Diagnostic::new(
+                "LRR-E-UNSUPPORTED",
+                "Vec element requires pending non-scalar source/drop integration".into(),
+            ));
+        }
+        let count = usize::try_from(count).map_err(|_| resource())?;
+        if count > MAX_CONSTRUCTION_FIELDS {
+            return Err(resource());
+        }
+        let bytes = ConstructionRecord::estimated_bytes(count)
+            .and_then(|n| n.checked_add(self.constructions.reservation_bytes(1).ok()?))
+            .ok_or_else(resource)?;
+        self.budget.check(1, bytes)
+    }
+    pub fn begin_vector_construction(
+        &mut self,
+        element: TypeId,
+        count: u32,
+    ) -> Result<(TypeId, ConstructionId), Diagnostic> {
+        self.preflight_vector_construction(element, count)?;
+        let ty = self.types.intern(TypeKey::Facade {
+            family: FacadeType::Vec,
+            args: Box::new([element]),
+        })?;
+        let count = usize::try_from(count).map_err(|_| resource())?;
+        let mut expected = Vec::new();
+        expected.try_reserve_exact(count).map_err(|_| resource())?;
+        expected.resize(count, element);
+        let guard = self.begin_construction(&expected)?;
+        self.constructions.get_mut(guard)?.vector = Some(ty);
+        Ok((ty, guard))
+    }
+    pub(crate) fn preflight_vector_source(
+        &self,
+        guard: ConstructionId,
+        ordinal: u32,
+        source: CellId,
+    ) -> Result<(), Diagnostic> {
+        let record = self.constructions.get(guard)?;
+        if record.vector.is_none() || record.completed.len() != ordinal as usize {
+            return Err(ownership());
+        }
+        if !matches!(
+            self.cells.get(source)?.owner,
+            CellOwner::FrameSlot { .. } | CellOwner::Transfer(_)
+        ) {
+            return Err(Diagnostic::new(
+                "LRR-E-UNSUPPORTED",
+                "Vec field requires an already evaluated owning expression cell".into(),
+            ));
+        }
+        let value = self.admit_move(source)?;
+        if !matches!(value.kind, 1..=7) {
+            return Err(Diagnostic::new(
+                "LRR-E-UNSUPPORTED",
+                "Vec field requires reached concrete scalar/source-view integration".into(),
+            ));
+        }
+        self.admit_construction_move(guard, ordinal, source)?;
+        let bytes = self.tickets.reservation_bytes(1)?;
+        self.budget.check(1, bytes)
+    }
+    pub(crate) fn vector_move_from(
+        &mut self,
+        guard: ConstructionId,
+        ordinal: u32,
+        source: CellId,
+    ) -> Result<(), Diagnostic> {
+        self.preflight_vector_source(guard, ordinal, source)?;
+        self.tickets.reserve(1, &mut self.budget)?;
+        self.construction_move_from(guard, ordinal, source)
+    }
+    pub(crate) fn preflight_vector_finish(
+        &self,
+        guard: ConstructionId,
+        ty: TypeId,
+    ) -> Result<(), Diagnostic> {
+        let record = self.constructions.get(guard)?;
+        if record.vector != Some(ty)
+            || record.state != ConstructionState::Building
+            || record.pending_cleanup.is_some()
+            || record.completed.len() != record.fields.len()
+            || record.fields.iter().any(Option::is_none)
+        {
+            return Err(ownership());
+        }
+        if !self.types.is_vector(ty) {
+            return Err(ownership());
+        }
+        let count = record.fields.len();
+        let handles = u32::try_from(count)
+            .ok()
+            .and_then(|n| n.checked_add(2))
+            .ok_or_else(resource)?;
+        let bytes = count
+            .checked_mul(std::mem::size_of::<CellId>())
+            .and_then(|n| n.checked_add(InitializedFields::estimated_bytes(count)?))
+            .and_then(|n| n.checked_add(self.objects.reservation_bytes(1).ok()?))
+            .and_then(|n| n.checked_add(self.cells.reservation_bytes(count).ok()?))
+            .and_then(|n| n.checked_add(self.tickets.reservation_bytes(1).ok()?))
+            .ok_or_else(resource)?;
+        self.budget.check(handles, bytes)
+    }
+    /// Revalidate a private buffer anchor against its current live allocation,
+    /// independent of the old container cell. No raw pointers or type-tag fallback.
+    pub(super) fn validate_vector_reference_anchor(
+        &self,
+        reference: &ReferenceRecord,
+        anchor: usize,
+    ) -> Result<CellId, Diagnostic> {
+        let link = reference.enclosing.get(anchor).ok_or_else(lease_fault)?;
+        let object = self.objects.get(link.object)?;
+        let ObjectStorage::Vector(storage) = &object.storage else {
+            return Err(lease_fault());
+        };
+        let buffer = storage.buffer.ok_or_else(lease_fault)?;
+        if !self.types.is_vector(object.type_id)
+            || buffer.dropping
+            || buffer.generation == 0
+            || Some(buffer.generation) != link.buffer_epoch
+            || storage.variant != link.variant
+            || storage.next_cleanup != 0
+            || storage.pending_cleanup.is_some()
+            || storage.fields.get(link.field as usize) != Some(&link.child)
+            || self.cells.get(link.child)?.owner
+                != (CellOwner::Buffer {
+                    object: link.object,
+                    index: link.field,
+                })
+        {
+            return Err(lease_fault());
+        }
+        let value = ValueRepr {
+            kind: 8,
+            type_id: object.type_id.0,
+            payload: link.object.bits(),
+        };
+        let owner = object.owner.ok_or_else(lease_fault)?;
+        match owner {
+            ValueOwner::Cell(cell) => {
+                if self.admit_live_value(cell)? != value {
+                    return Err(lease_fault());
+                }
+                self.validate_vector_owner_chain(cell)?;
+            }
+            ValueOwner::Ticket(ticket) => {
+                if self.peek_ticket(ticket)? != value {
+                    return Err(lease_fault());
+                }
+            }
+            ValueOwner::Construction { guard, field } => {
+                let record = self.constructions.get(guard)?;
+                if record.state != ConstructionState::Building
+                    || record.pending_cleanup.is_some()
+                    || record.fields.get(field as usize) != Some(&Some(value))
+                {
+                    return Err(lease_fault());
+                }
+            }
+        }
+        self.place_stamp(link.child)?;
+        Ok(link.child)
+    }
+    fn validate_vector_owner_chain(&self, mut cell: CellId) -> Result<(), Diagnostic> {
+        // Existing initialization-parent validation accepts a currently owned
+        // enclosing aggregate ticket, unlike old stack-root lease traversal.
+        // The cumulative handle quota is also a strict bound on this walk.
+        for _ in 0..self.budget.max_handles() {
+            self.admit_live_value(cell)?;
+            match self.initialization_parent(cell)? {
+                Some((_, _, Some(parent))) => cell = parent,
+                Some((_, _, None)) | None => return Ok(()),
+            }
+        }
+        Err(resource())
+    }
+    pub(super) fn storage_child_owner(
+        storage: &AggregateStorage,
+        object: ObjectId,
+        index: u32,
+    ) -> CellOwner {
+        if storage.buffer.is_some() {
+            CellOwner::Buffer { object, index }
+        } else {
+            CellOwner::Field { object, index }
+        }
+    }
+    fn vector_storage(&self, place: &Place) -> Result<&AggregateStorage, PlaceFailure> {
+        let resolved = self.resolve_place(place)?;
+        let ty = resolved.ty;
+        if !self.types.is_vector(ty) {
+            return Err(invalid().into());
+        }
+        let (object, storage) = self.place_object(resolved.target.cell)?;
+        if !matches!(self.objects.get(object)?.storage, ObjectStorage::Vector(_))
+            || storage.buffer.is_none()
+        {
+            return Err(ownership().into());
+        }
+        Ok(storage)
+    }
+    pub fn vector_len(&self, place: &Place) -> Result<u32, PlaceFailure> {
+        u32::try_from(self.vector_storage(place)?.fields.len()).map_err(|_| resource().into())
+    }
+    pub fn vector_capacity(&self, place: &Place) -> Result<u32, PlaceFailure> {
+        Ok(self
+            .vector_storage(place)?
+            .buffer
+            .ok_or_else(ownership)?
+            .capacity)
+    }
+    /// Storage mechanism only. Source opcode preparation must select the exact facade Index member.
+    pub fn vector_index(&self, base: &Place, index: ValueRepr) -> Result<Place, PlaceFailure> {
+        let evaluated = super::super::place::checked_index(index)?;
+        let len = self.vector_len(base)?;
+        if evaluated >= u64::from(len) {
+            return Err(PlaceFailure::GuestPanic(PlacePanic::IndexOutOfBounds));
+        }
+        let ordinal = u32::try_from(evaluated).map_err(|_| resource())?;
+        let place = base.projected(Projection::Index(ordinal))?;
+        self.resolve_place_for_use(&place, PlaceUse::Address)?;
+        Ok(place)
+    }
+}
