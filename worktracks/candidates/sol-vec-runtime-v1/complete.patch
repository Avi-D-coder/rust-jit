+use lrr::{
+    core::{digest::Digest, profile::ProfileIdentity},
+    facade::macros::RuntimeMacroKind,
+    frontend::{
+        macro_names::PathLookup,
+        runtime_macro_catalog::RuntimeMacroCatalog,
+        runtime_macro_plan::{RuntimeMacroPreparation, prepare_runtime_macro},
+    },
+    ir::{
+        op::{DecodedLiteral, Op, PrimitiveType},
+        pc::{Phase, SlotKind},
+    },
+    source::snapshot::{CfgSet, SourceBlob},
+    syntax::{parse::ParsedFile, runtime_vec::prepare_vector_structure, spans::SourceRange},
+};
+#[test]
+fn vector_original_test_box_literal_plan_is_source_exact_and_phase_lazy() {
+    let text =
+        include_str!("../../fixtures/upstream/rustc-checkout/tests/ui/binding/expr-match-panic.rs");
+    for edition in [2015, 2018, 2021, 2024] {
+        let mut profile = ProfileIdentity::current();
+        profile.edition = edition;
+        let parsed = ParsedFile::parse(
+            &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+            profile.clone(),
+        )
+        .unwrap();
+        let outline = parsed
+            .outline(Digest([216; 32]), vec![], &CfgSet::guest_default())
+            .unwrap();
+        let handle = outline
+            .items
+            .iter()
+            .find(|i| i.def_key.declared_name == "test_box")
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap();
+        let body = parsed.index_body(handle, Default::default()).unwrap();
+        let start = u32::try_from(text.find("vec![10]").unwrap()).unwrap();
+        let range = SourceRange {
+            start,
+            end: start + 8,
+        };
+        let call = parsed.macro_call_at(range).unwrap();
+        let catalog = RuntimeMacroCatalog::standard(&profile).unwrap();
+        let def = catalog
+            .definitions()
+            .find(|d| catalog.select(d).unwrap() == Some(RuntimeMacroKind::Vec))
+            .unwrap()
+            .clone();
+        let RuntimeMacroPreparation::Intrinsic(intrinsic) =
+            prepare_runtime_macro(&parsed, call, PathLookup::Defined(def.clone()), &catalog)
+                .unwrap()
+        else {
+            panic!("intrinsic")
+        };
+        let plan = prepare_vector_structure(&parsed, &intrinsic, handle, &body).unwrap();
+        assert_eq!(plan.definition(), &def);
+        assert_eq!(plan.operands().len(), 1);
+        let operand = &plan.operands()[0];
+        assert_eq!(
+            operand.span().relative_start + handle.range.start,
+            start + 5
+        );
+        assert_eq!(operand.span().relative_end + handle.range.start, start + 7);
+        assert_eq!(body.slot_kind(operand.value()).unwrap(), SlotKind::Value);
+        assert_eq!(operand.entry().phase, Phase::Operand(0).code().unwrap());
+        assert_eq!(operand.transfer().phase, Phase::Operand(1).code().unwrap());
+        let guard = body.nodes()[plan.node().0 as usize]
+            .constructor_guard
+            .unwrap();
+        plan.require_guard(&body, guard).unwrap();
+        let after = body.pc(lrr::ir::pc::NodeId(0), Phase::Exit).unwrap();
+        let transfer = plan
+            .phase_recipe(
+                &parsed,
+                &body,
+                operand.transfer(),
+                PrimitiveType::I32,
+                after.clone(),
+                vec![],
+            )
+            .unwrap();
+        assert!(
+            matches!(transfer.recipe().operations.as_ref(),[Op::VecConstructField{transfer}] if transfer.guard()==guard && transfer.ordinal()==0 && transfer.value()==operand.value())
+        );
+        assert_eq!(
+            transfer.recipe().origin.span,
+            body.span(plan.node()).unwrap()
+        );
+        assert!(plan.transfer(&body, 1).is_err());
+        let rebuild = |key, origin, operations| lrr::ir::recipe::RecipeDraft {
+            key,
+            origin,
+            operations,
+            exits: vec![lrr::ir::recipe::RecipeExit::Next(plan.commit().clone())],
+            dependencies: vec![],
+        };
+        assert!(
+            lrr::ir::validate::verify(
+                rebuild(
+                    operand.entry().clone(),
+                    transfer.recipe().origin.clone(),
+                    transfer.recipe().operations.to_vec()
+                ),
+                &body
+            )
+            .is_err()
+        );
+        let mut wrong_origin = transfer.recipe().origin.clone();
+        wrong_origin.span.relative_end -= 1;
+        assert!(
+            lrr::ir::validate::verify(
+                rebuild(
+                    operand.transfer().clone(),
+                    wrong_origin,
+                    transfer.recipe().operations.to_vec()
+                ),
+                &body
+            )
+            .is_err()
+        );
+        assert!(
+            lrr::ir::validate::verify(
+                rebuild(
+                    operand.transfer().clone(),
+                    transfer.recipe().origin.clone(),
+                    vec![Op::ConstructField {
+                        guard,
+                        field: 0,
+                        source: operand.value()
+                    }]
+                ),
+                &body
+            )
+            .is_err()
+        );
+        let ops = plan
+            .lower_scalar_operand(&parsed, 0, PrimitiveType::I32)
+            .unwrap();
+        assert!(
+            matches!(ops.as_slice(),[Op::Literal{literal,hint:lrr::ir::op::HintRecipe::Primitive(PrimitiveType::I32),..}] if matches!(literal.decoded,Some(DecodedLiteral::Integer{magnitude:10,..})))
+        );
+        // Directly enter this original macro's indexed scope chain. This is a
+        // source segment kernel, not execution of test_box's match or function.
+        let mut store = lrr::runtime::cell::GuestStore::new(1, 10000, 4 << 20).unwrap();
+        let root = body.pc(lrr::ir::pc::NodeId(0), Phase::Entry).unwrap();
+        let mut frame = lrr::vm::frame::Frame::new(body.clone(), root.clone(), &mut store).unwrap();
+        let mut scopes = vec![];
+        let mut scope = Some(body.nodes()[plan.node().0 as usize].scope);
+        while let Some(id) = scope {
+            scopes.push(id);
+            scope = body.scopes()[id.0 as usize].parent;
+        }
+        scopes.reverse();
+        assert!(scopes.len() <= 8);
+        let enter = lrr::ir::validate::verify(
+            lrr::ir::recipe::RecipeDraft {
+                key: root,
+                origin: lrr::ir::recipe::Origin {
+                    span: body.span(lrr::ir::pc::NodeId(0)).unwrap(),
+                    expansion_ancestry: vec![],
+                },
+                operations: scopes
+                    .into_iter()
+                    .map(|scope| Op::ScopeEnter { scope })
+                    .collect(),
+                exits: vec![lrr::ir::recipe::RecipeExit::Next(plan.entry().clone())],
+                dependencies: vec![],
+            },
+            &body,
+        )
+        .unwrap();
+        lrr::vm::step::step(&mut frame, &mut store, &enter).unwrap();
+        frame
+            .prepare_vector_constructor(&plan, PrimitiveType::I32, &store)
+            .unwrap();
+        for pc in [
+            plan.entry(),
+            operand.entry(),
+            operand.transfer(),
+            plan.commit(),
+        ] {
+            assert_eq!(frame.pc(), pc);
+            let recipe = plan
+                .phase_recipe(
+                    &parsed,
+                    &body,
+                    pc,
+                    PrimitiveType::I32,
+                    after.clone(),
+                    vec![],
+                )
+                .unwrap();
+            assert!(matches!(
+                lrr::vm::step::step(&mut frame, &mut store, &recipe).unwrap(),
+                lrr::vm::step::StepOutcome::Next(_)
+            ));
+        }
+        let result = lrr::runtime::place::Place::cell(frame.cell(plan.result()).unwrap());
+        assert_eq!(store.vector_len(&result).unwrap(), 1);
+        let indexed = store
+            .vector_index(
+                &result,
+                lrr::runtime::value::ValueRepr::unsigned(lrr::runtime::shape::TypeId(13), 0)
+                    .unwrap(),
+            )
+            .unwrap();
+        assert_eq!(
+            store.read_place(&indexed).unwrap(),
+            lrr::runtime::value::ValueRepr::signed(lrr::runtime::shape::TypeId(6), 10).unwrap()
+        );
+        assert_eq!(
+            frame.fuel_snapshot().used,
+            frame.counters().operations_started + frame.counters().exits_completed
+        );
+        assert_eq!(frame.counters().started_by_opcode[42], 1);
+    }
+    // Constructor/index helper plan only; full original requires root source guard/type/Index integration.
+}
