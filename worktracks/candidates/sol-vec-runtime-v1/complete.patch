+    pub fn prepare_vector_constructor(
+        &mut self,
+        plan: &crate::syntax::runtime_vec::SourceVectorPlan,
+        element: crate::ir::op::PrimitiveType,
+        store: &GuestStore,
+    ) -> Result<(), Diagnostic> {
