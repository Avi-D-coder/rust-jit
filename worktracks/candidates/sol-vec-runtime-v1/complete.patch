+use lrr::{
+    runtime::{
+        cell::{AggregateCleanupTransfer, CellOwner, CellState, GuestStore, StorageContract},
+        place::{Place, PlaceFailure, PlacePanic},
+        reference::Access,
+        shape::{CopyStatus, FacadeType, TypeId, TypeKey},
+        value::ValueRepr,
+    },
+    vm::{fuel::RunFuel, vector::VectorConstruction},
+};
+fn store() -> GuestStore {
+    GuestStore::new(1, 100000, 16 << 20).unwrap()
+}
+fn cell(s: &mut GuestStore, n: i64) -> lrr::runtime::cell::CellId {
+    let frame = s.new_frame_anchor().unwrap();
+    let c = s
+        .new_cell(
+            StorageContract::Exact(TypeId(6)),
+            true,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    let t = s.ticket(ValueRepr::signed(TypeId(6), n).unwrap()).unwrap();
+    s.initialize(c, t).unwrap();
+    c
+}
+fn finish(s: &mut GuestStore, values: &[i64]) -> lrr::runtime::cell::TicketId {
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut v =
+        VectorConstruction::begin(s, &mut fuel, TypeId(6), values.len().try_into().unwrap())
+            .unwrap();
+    for n in values {
+        let c = cell(s, *n);
+        v.push(s, &mut fuel, c).unwrap();
+    }
+    v.finish(s, &mut fuel).unwrap()
+}
+#[test]
+fn vector_core_empty_and_list_have_real_facade_buffer_and_noncopy_ownership() {
+    for values in [&[][..], &[10, 20][..]] {
+        let mut s = store();
+        let ticket = finish(&mut s, values);
+        let repr = s.peek_ticket(ticket).unwrap();
+        let ty = TypeId(repr.type_id);
+        assert!(
+            matches!(s.type_descriptor(ty).unwrap().key.as_ref(),TypeKey::Facade{family:FacadeType::Vec,args} if args.as_ref()==[TypeId(6)])
+        );
+        assert_eq!(s.type_descriptor(ty).unwrap().copy, CopyStatus::NotCopy);
+        let frame = s.new_frame_anchor().unwrap();
+        let c = s
+            .new_cell(
+                StorageContract::Exact(ty),
+                true,
+                CellOwner::FrameSlot { frame, slot: 0 },
+            )
+            .unwrap();
+        s.initialize(c, ticket).unwrap();
+        assert_eq!(s.vector_len(&Place::cell(c)).unwrap(), values.len() as u32);
+        assert_eq!(
+            s.vector_capacity(&Place::cell(c)).unwrap(),
+            values.len() as u32
+        );
+        assert!(s.copy_from(c).is_err());
+        for (i, n) in values.iter().enumerate() {
+            let p = s
+                .vector_index(
+                    &Place::cell(c),
+                    ValueRepr::unsigned(TypeId(13), i as u64).unwrap(),
+                )
+                .unwrap();
+            assert_eq!(
+                s.read_place(&p).unwrap(),
+                ValueRepr::signed(TypeId(6), *n).unwrap()
+            );
+        }
+    }
+}
+#[test]
+fn vector_source_transfers_once_and_low_fuel_or_type_fault_preserves_next_owner() {
+    let mut s = store();
+    let a = cell(&mut s, 10);
+    let b = cell(&mut s, 20);
+    let mut fuel = RunFuel::new(2).unwrap();
+    let mut v = VectorConstruction::begin(&mut s, &mut fuel, TypeId(6), 2).unwrap();
+    v.push(&mut s, &mut fuel, a).unwrap();
+    assert_eq!(s.state(a).unwrap(), CellState::Moved);
+    assert!(v.push(&mut s, &mut fuel, b).is_err());
+    assert!(matches!(s.state(b).unwrap(), CellState::Live(_)));
+    assert_eq!(fuel.snapshot().used, 2);
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), Some(0));
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), None);
+    let mut s = store();
+    let a = cell(&mut s, 10);
+    let mut fuel = RunFuel::new(10).unwrap();
+    let mut v = VectorConstruction::begin(&mut s, &mut fuel, TypeId(6), 2).unwrap();
+    v.push(&mut s, &mut fuel, a).unwrap();
+    let used = fuel.snapshot().used;
+    assert!(v.push(&mut s, &mut fuel, a).is_err());
+    assert_eq!(fuel.snapshot().used, used);
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), Some(0));
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), None);
+}
+#[test]
+fn vector_index_bounds_type_and_buffer_leases_survive_move_then_reject_drop() {
+    let mut s = store();
+    let ticket = finish(&mut s, &[10]);
+    let ty = TypeId(s.peek_ticket(ticket).unwrap().type_id);
+    let frame = s.new_frame_anchor().unwrap();
+    let c = s
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    s.initialize(c, ticket).unwrap();
+    assert!(matches!(
+        s.vector_index(
+            &Place::cell(c),
+            ValueRepr::unsigned(TypeId(13), u64::MAX).unwrap()
+        ),
+        Err(PlaceFailure::GuestPanic(PlacePanic::IndexOutOfBounds))
+    ));
+    assert!(
+        matches!(s.vector_index(&Place::cell(c),ValueRepr::unsigned(TypeId(11),0).unwrap()),Err(PlaceFailure::RuntimeFault(d)) if d.code=="LRR-E-INDEX-TYPE")
+    );
+    let p = s
+        .vector_index(&Place::cell(c), ValueRepr::unsigned(TypeId(13), 0).unwrap())
+        .unwrap();
+    let lease = s.borrow(&p, Access::Mutable).unwrap();
+    let incoming = s.ticket(ValueRepr::signed(TypeId(6), 20).unwrap()).unwrap();
+    let old = s.replace_reference(lease, incoming).unwrap();
+    s.discard(old).unwrap();
+    assert_eq!(
+        s.read_reference(lease).unwrap(),
+        ValueRepr::signed(TypeId(6), 20).unwrap()
+    );
+    let shared = s.borrow(&p, Access::Shared).unwrap();
+    let moved = s.move_from(c).unwrap();
+    assert_eq!(s.read_reference(lease).unwrap().payload, 20);
+    assert_eq!(s.read_reference(shared).unwrap().payload, 20);
+    s.retire_cell(c).unwrap();
+    assert_eq!(s.read_reference(lease).unwrap().payload, 20);
+    let rebound = s
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 1 },
+        )
+        .unwrap();
+    s.initialize(rebound, moved).unwrap();
+    assert_eq!(s.read_reference(shared).unwrap().payload, 20);
+    let incoming = s.ticket(ValueRepr::signed(TypeId(6), 30).unwrap()).unwrap();
+    let old = s.replace_reference(lease, incoming).unwrap();
+    s.discard(old).unwrap();
+    assert_eq!(s.read_reference(shared).unwrap().payload, 30);
+    let dropped = s.begin_drop(rebound).unwrap();
+    assert!(s.read_reference(lease).is_err());
+    assert!(s.read_reference(shared).is_err());
+    let AggregateCleanupTransfer::Field {
+        cell,
+        ticket: child,
+    } = s.aggregate_cleanup_transfer(dropped).unwrap()
+    else {
+        panic!("field")
+    };
+    s.discard(child).unwrap();
+    s.finish_aggregate_cleanup_field(dropped, cell, child)
+        .unwrap();
+    assert!(matches!(
+        s.aggregate_cleanup_transfer(dropped).unwrap(),
+        AggregateCleanupTransfer::Complete
+    ));
+    s.discard(dropped).unwrap();
+}
+#[test]
+fn vector_normal_drop_order_and_partial_rollback_are_separate() {
+    let mut s = store();
+    let ticket = finish(&mut s, &[10, 20]);
+    let mut values = vec![];
+    loop {
+        match s.aggregate_cleanup_transfer(ticket).unwrap() {
+            AggregateCleanupTransfer::Field {
+                cell,
+                ticket: child,
+            } => {
+                values.push(s.peek_ticket(child).unwrap().payload);
+                s.discard(child).unwrap();
+                s.finish_aggregate_cleanup_field(ticket, cell, child)
+                    .unwrap();
+            }
+            AggregateCleanupTransfer::Skipped => panic!("unexpected skip"),
+            AggregateCleanupTransfer::Complete => break,
+        }
+    }
+    assert_eq!(values, [10, 20]);
+    s.discard(ticket).unwrap();
+    let mut s = store();
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut v = VectorConstruction::begin(&mut s, &mut fuel, TypeId(6), 3).unwrap();
+    for n in [10, 20] {
+        let c = cell(&mut s, n);
+        v.push(&mut s, &mut fuel, c).unwrap();
+    }
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), Some(1));
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), Some(0));
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), None);
+}
