+#[cfg(test)]
+mod vector_lease_tests {
+    use super::*;
+    #[test]
+    fn vector_buffer_generation_change_refuses_exact_old_lease() {
+        let mut store = GuestStore::new(1, 1000, 1 << 20).unwrap();
+        let frame = store.new_frame_anchor().unwrap();
+        let source = store
+            .new_cell(
+                StorageContract::Exact(TypeId(6)),
+                true,
+                CellOwner::FrameSlot { frame, slot: 0 },
+            )
+            .unwrap();
+        let ticket = store
+            .ticket(ValueRepr::signed(TypeId(6), 10).unwrap())
+            .unwrap();
+        store.initialize(source, ticket).unwrap();
+        let (ty, guard) = store.begin_vector_construction(TypeId(6), 1).unwrap();
+        store.vector_move_from(guard, 0, source).unwrap();
+        let ticket = store.commit_construction(guard, ty).unwrap();
+        let value = store.peek_ticket(ticket).unwrap();
+        let cell = store
+            .new_cell(
+                StorageContract::Exact(ty),
+                true,
+                CellOwner::FrameSlot { frame, slot: 1 },
+            )
+            .unwrap();
+        store.initialize(cell, ticket).unwrap();
+        let place = store
+            .vector_index(
+                &Place::cell(cell),
+                ValueRepr::unsigned(TypeId(13), 0).unwrap(),
+            )
+            .unwrap();
+        let lease = store.borrow(&place, Access::Shared).unwrap();
+        assert_eq!(store.read_reference(lease).unwrap().payload, 10);
+        // Private stale-epoch control only; growth/reallocation itself is pending.
+        let ObjectStorage::Vector(storage) = &mut store
+            .objects
+            .get_mut(ObjectId::from_bits(value.payload))
+            .unwrap()
+            .storage
+        else {
+            panic!("Vector")
+        };
+        storage.buffer.as_mut().unwrap().generation = 2;
+        assert!(store.read_reference(lease).is_err());
+        let fresh = store.borrow(&place, Access::Shared).unwrap();
+        assert_eq!(store.read_reference(fresh).unwrap().payload, 10);
+    }
