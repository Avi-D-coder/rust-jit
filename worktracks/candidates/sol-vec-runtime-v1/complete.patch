+    let b = cell(&mut s, 20);
+    let mut fuel = RunFuel::new(100).unwrap();
+    let mut v = VectorConstruction::begin(&mut s, &mut fuel, TypeId(6), 2).unwrap();
+    v.push(&mut s, &mut fuel, a).unwrap();
+    fuel.cancellation().cancel();
+    let used = fuel.snapshot().used;
+    assert_eq!(
+        v.push(&mut s, &mut fuel, b).unwrap_err().code,
+        "LRR-E-RUNTIME-RESOURCE"
+    );
+    assert_eq!(fuel.snapshot().used, used);
+    assert!(matches!(s.state(b).unwrap(), CellState::Live(_)));
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), Some(0));
+    assert_eq!(v.cleanup_scalar_step(&mut s).unwrap(), None);
+}
+
+#[test]
+fn vector_refused_new_construction_preserves_existing_buffer_and_leases() {
+    let mut s = store();
+    let ticket = finish(&mut s, &[10]);
+    let ty = TypeId(s.peek_ticket(ticket).unwrap().type_id);
+    let frame = s.new_frame_anchor().unwrap();
+    let cell = s
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    s.initialize(cell, ticket).unwrap();
+    let place = s
+        .vector_index(
+            &Place::cell(cell),
+            ValueRepr::unsigned(TypeId(13), 0).unwrap(),
+        )
+        .unwrap();
+    let lease = s.borrow(&place, Access::Shared).unwrap();
+    let mut fuel = RunFuel::new(0).unwrap();
+    assert!(VectorConstruction::begin(&mut s, &mut fuel, TypeId(6), 1).is_err());
+    assert_eq!(fuel.snapshot().used, 0);
+    assert_eq!(s.read_reference(lease).unwrap().payload, 10);
+    let mut fuel = RunFuel::new(100).unwrap();
+    fuel.cancellation().cancel();
+    assert!(VectorConstruction::begin(&mut s, &mut fuel, TypeId(6), 1).is_err());
+    assert_eq!(fuel.snapshot().used, 0);
+    assert_eq!(s.read_reference(lease).unwrap().payload, 10);
+    let mut fuel = RunFuel::new(100).unwrap();
+    assert!(VectorConstruction::begin(&mut s, &mut fuel, TypeId(6), 100001).is_err());
+    assert_eq!(fuel.snapshot().used, 0);
+    assert_eq!(s.read_reference(lease).unwrap().payload, 10);
+}
