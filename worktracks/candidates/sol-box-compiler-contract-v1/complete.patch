+//! Preregistered finite semantic data/refusal checks; no runtime Box execution.
+use super::*;
+use crate::{
+    db::key::OutlineKey,
+    source::{
+        changes::SourceSelection,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{box_source_headers::capture_box_headers, parse::ParsedFile},
+};
+const BOXED: &str =
+    include_str!("../../../../fixtures/upstream/rustc-checkout/library/alloc/src/boxed.rs");
+fn fixture_headers(text: &str) -> BoxSourceHeaders {
+    let cfg = CfgSet::guest_default();
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity::current(),
+    )
+    .unwrap();
+    let selection = SourceSelection {
+        path: SourcePath::new("library/alloc/src/boxed.rs").unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(b"disclosed pure fixture alloc unit"),
+            module_path: vec!["boxed".into()],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    capture_box_headers(&parsed, &selection, &cfg).unwrap()
+}
+#[test]
+fn finite_box_compiler_contract_is_profile_bound_in_all_official_editions() {
+    let mut identities = std::collections::BTreeSet::new();
+    for edition in [2015, 2018, 2021, 2024] {
+        let profile = ProfileIdentity {
+            edition,
+            ..ProfileIdentity::current()
+        };
+        let compiler = CompileInputCatalog::standalone(&profile).unwrap();
+        let facet = BoxCompilerFacet::from_compiler(&profile, &compiler).unwrap();
+        assert!(identities.insert(facet.fingerprint()));
+        assert_ne!(
+            facet.rule(BoxRule::New),
+            facet.rule(BoxRule::SharedProjection)
+        );
+        assert_ne!(
+            facet.rule(BoxRule::SharedProjection),
+            facet.rule(BoxRule::MutableProjection)
+        );
+    }
+}
+#[test]
+fn empty_user_compiler_catalog_cannot_register_box_by_name_or_digest() {
+    let profile = ProfileIdentity::current();
+    for unit in [
+        crate::facade::unit(&profile, "core"),
+        Digest::of_bytes(b"Box Global native symbols"),
+    ] {
+        let compiler = CompileInputCatalog::new(unit, profile.edition, []).unwrap();
+        assert!(BoxCompilerFacet::from_compiler(&profile, &compiler).is_err());
+    }
+}
+#[test]
+fn compiler_catalog_for_another_profile_is_not_box_permission() {
+    let profile = ProfileIdentity::current();
+    let compiler = CompileInputCatalog::standalone(&profile).unwrap();
+    let other = ProfileIdentity {
+        edition: 2018,
+        ..profile
+    };
+    assert!(BoxCompilerFacet::from_compiler(&other, &compiler).is_err());
+}
+#[test]
+fn original_box_source_generation_is_data_not_selected_source_permission() {
+    let profile = ProfileIdentity::current();
+    let compiler = CompileInputCatalog::standalone(&profile).unwrap();
+    let facet = BoxCompilerFacet::from_compiler(&profile, &compiler).unwrap();
+    let headers = fixture_headers(BOXED);
+    facet.require_reviewed_source(&headers).unwrap();
+    // Pure document/descriptor agreement has no CurrentBoxSemanticContract ctor.
+    assert_eq!(headers.source().outline.parse.profile.edition, 2024);
+}
+#[test]
+fn changed_selected_method_body_never_inherits_the_reviewed_intrinsic_semantics() {
+    let profile = ProfileIdentity::current();
+    let compiler = CompileInputCatalog::standalone(&profile).unwrap();
+    let facet = BoxCompilerFacet::from_compiler(&profile, &compiler).unwrap();
+    let original = fixture_headers(BOXED);
+    let changed = fixture_headers(&BOXED.replacen(
+        "unsafe { mem::transmute(ptr) }",
+        "panic!(\"edited Box new\")",
+        1,
+    ));
+    let before = original
+        .header(Role::NewImpl)
+        .unwrap()
+        .member("new")
+        .unwrap();
+    let after = changed
+        .header(Role::NewImpl)
+        .unwrap()
+        .member("new")
+        .unwrap();
+    assert_eq!(before.signature(), after.signature());
+    assert_ne!(
+        before.body().unwrap().body_hash,
+        after.body().unwrap().body_hash
+    );
+    assert!(facet.require_reviewed_source(&changed).is_err());
+}
