+//! Original associated Target headers, captured data only. Compiler/source/goal
+//! admission is separate; this module never mints an executable witness.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncode, StableEncoder},
+    },
+    db::key::QueryKey,
+    source::{changes::SourceSelection, manifest::DefKey, snapshot::CfgSet},
+    syntax::{
+        ast_adapter::range,
+        box_source_headers::{BoxHeaderRole as Role, BoxSourceHeaders},
+        outline::HeaderRecipe,
+        parse::ParsedFile,
+        spans::SourceRange,
+    },
+};
+use ra_ap_syntax::{
+    AstNode, SyntaxNode,
+    ast::{self, HasGenericParams, HasName, HasTypeBounds},
+};
+const MAX_BYTES: usize = 32 << 20;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-BOX-SOURCE", message.into())
+}
+#[derive(Debug)]
+pub struct BoxTargetHeader {
+    role: Role,
+    parent: DefKey,
+    parent_header: Digest,
+    definition: DefKey,
+    header: HeaderRecipe,
+    range: SourceRange,
+    bounds: String,
+    value: Option<String>,
+}
+impl BoxTargetHeader {
+    pub fn role(&self) -> Role {
+        self.role
+    }
+    pub fn parent(&self) -> &DefKey {
+        &self.parent
+    }
+    pub fn parent_header(&self) -> Digest {
+        self.parent_header
+    }
+    pub fn definition(&self) -> &DefKey {
+        &self.definition
+    }
+    pub fn header(&self) -> &HeaderRecipe {
+        &self.header
+    }
+    pub fn range(&self) -> SourceRange {
+        self.range
+    }
+    pub fn bounds(&self) -> &str {
+        &self.bounds
+    }
+    pub fn value(&self) -> Option<&str> {
+        self.value.as_deref()
+    }
+}
+#[derive(Debug)]
+pub struct BoxTargetHeaders {
+    source: SourceSelection,
+    targets: Vec<BoxTargetHeader>,
+    bytes: usize,
+}
+impl BoxTargetHeaders {
+    pub fn source(&self) -> &SourceSelection {
+        &self.source
+    }
+    pub fn targets(&self) -> &[BoxTargetHeader] {
+        &self.targets
+    }
+    pub fn target(&self, role: Role) -> Option<&BoxTargetHeader> {
+        self.targets.iter().find(|row| row.role == role)
+    }
+    pub fn metadata_bytes(&self) -> usize {
+        self.bytes
+    }
+}
+fn definition_bytes(def: &DefKey) -> Result<usize, Diagnostic> {
+    let mut bytes = def
+        .declared_name
+        .len()
+        .checked_add(
+            def.module_path
+                .len()
+                .checked_mul(std::mem::size_of::<String>())
+                .ok_or_else(|| fault("Box Target definition metadata"))?,
+        )
+        .ok_or_else(|| fault("Box Target definition metadata"))?;
+    for segment in &def.module_path {
+        bytes = bytes
+            .checked_add(segment.len())
+            .ok_or_else(|| fault("Box Target definition metadata"))?;
+    }
+    Ok(bytes)
+}
+fn compact(node: &SyntaxNode) -> Result<String, Diagnostic> {
+    let mut out = String::new();
+    for token in node
+        .descendants_with_tokens()
+        .filter_map(|e| e.into_token())
+        .filter(|t| !t.kind().is_trivia())
+    {
+        let bytes = out
+            .len()
+            .checked_add(token.text().len())
+            .filter(|n| *n <= 65536)
+            .ok_or_else(|| fault("Box Target token bound"))?;
+        out.try_reserve(bytes - out.len())
+            .map_err(|_| fault("Box Target token allocation"))?;
+        out.push_str(token.text());
+    }
+    Ok(out)
+}
+/// Exact top-level original parent + enabled associated declaration. No method
+/// bodies, evaluation, query or caller-supplied normalized type is consulted.
+pub fn capture_box_targets(
+    parsed: &ParsedFile,
+    headers: &BoxSourceHeaders,
+    cfg: &CfgSet,
+) -> Result<BoxTargetHeaders, Diagnostic> {
+    let source = headers.source();
+    if parsed.generated_origin.is_some()
+        || parsed.key() != source.outline.parse
+        || cfg.fingerprint() != source.outline.cfg
+    {
+        return Err(fault("Box Target source/profile/cfg attachment differs"));
+    }
+    let tree = parsed.parsed.tree();
+    if tree.syntax().descendants().take(1_000_001).count() > 1_000_000 {
+        return Err(fault("Box Target structural node bound"));
+    }
+    let mut bytes = std::mem::size_of::<BoxTargetHeaders>()
+        .checked_add(source.metadata_bytes()?)
+        .filter(|n| *n <= MAX_BYTES)
+        .ok_or_else(|| fault("Box Target metadata overflow"))?;
+    let mut targets = Vec::new();
+    for row in headers.headers().iter().filter(|row| {
+        matches!(
+            row.role(),
+            Role::DerefImpl | Role::DerefTrait | Role::DerefMutTrait
+        )
+    }) {
+        let parent = tree
+            .syntax()
+            .children()
+            .find(|node| range(node.text_range()) == row.range())
+            .ok_or_else(|| fault("actual Box Target owning declaration absent"))?;
+        if !(ast::Impl::can_cast(parent.kind()) || ast::Trait::can_cast(parent.kind())) {
+            return Err(fault("Box Target parent is not original impl/trait"));
+        }
+        let associated = parent
+            .children()
+            .find_map(ast::AssocItemList::cast)
+            .ok_or_else(|| fault("Box Target associated header list absent"))?;
+        for alias in associated
+            .syntax()
+            .children()
+            .filter_map(ast::TypeAlias::cast)
+            .filter(|alias| alias.name().is_some_and(|name| name.text() == "Target"))
+        {
+            let span = range(alias.syntax().text_range());
+            let Some(actual) = headers
+                .outline()
+                .items
+                .iter()
+                .find(|item| item.declaration_span == span)
+            else {
+                continue;
+            };
+            if targets
+                .iter()
+                .any(|target: &BoxTargetHeader| target.role == row.role())
+            {
+                return Err(fault("duplicate enabled Box associated Target"));
+            }
+            if alias.generic_param_list().is_some()
+                || alias.where_clause().is_some()
+                || parsed
+                    .errors
+                    .iter()
+                    .any(|e| e.range.start < span.end && e.range.end > span.start)
+            {
+                return Err(fault(
+                    "Box Target generic/predicate/header syntax outside closed contract",
+                ));
+            }
+            let bounds = alias
+                .type_bound_list()
+                .map(|list| compact(list.syntax()))
+                .transpose()?
+                .unwrap_or_default();
+            let value = alias.ty().map(|ty| compact(ty.syntax())).transpose()?;
+            bytes = bytes
+                .checked_add(std::mem::size_of::<BoxTargetHeader>())
+                .and_then(|n| n.checked_add(actual.header.estimated_bytes()))
+                .and_then(|n| n.checked_add(definition_bytes(&actual.def_key).ok()?))
+                .and_then(|n| n.checked_add(definition_bytes(row.definition()).ok()?))
+                .and_then(|n| n.checked_add(bounds.capacity()))
+                .and_then(|n| n.checked_add(value.as_ref().map_or(0, String::capacity)))
+                .filter(|n| *n <= MAX_BYTES)
+                .ok_or_else(|| fault("Box Target metadata bound"))?;
+            targets
+                .try_reserve_exact(1)
+                .map_err(|_| fault("Box Target allocation"))?;
+            targets.push(BoxTargetHeader {
+                role: row.role(),
+                parent: row.definition().clone(),
+                parent_header: row.header().fingerprint(),
+                definition: actual.def_key.clone(),
+                header: actual.header.clone(),
+                range: span,
+                bounds,
+                value,
+            });
+        }
+    }
+    Ok(BoxTargetHeaders {
+        source: source.clone(),
+        targets,
+        bytes,
+    })
+}
+impl StableEncode for BoxTargetHeader {
+    const DOMAIN: &'static str = "lrr/v1/box-associated-target-header";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.u32(self.role.tag());
+        e.record(&self.parent);
+        e.digest(self.parent_header);
+        e.record(&self.definition);
+        e.record(&self.header);
+        e.u32(self.range.start);
+        e.u32(self.range.end);
+        e.string(&self.bounds);
+        e.option(&self.value, |e, value| e.string(value));
+    }
+}
+impl StableEncode for BoxTargetHeaders {
+    const DOMAIN: &'static str = "lrr/v1/box-associated-target-capture";
+    fn encode_fields(&self, e: &mut StableEncoder) {
+        e.string(self.source.path.as_str());
+        e.record(&QueryKey::Outline(self.source.outline.clone()));
+        e.sequence(&self.targets, |e, row| e.record(row));
+    }
+}
