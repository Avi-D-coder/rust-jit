+//! Unchanged source Target capture; fixture identities are disclosed data only.
+use lrr::{
+    core::{
+        digest::{Digest, StableEncode},
+        profile::ProfileIdentity,
+    },
+    db::key::OutlineKey,
+    source::{
+        box_contract_headers::capture_box_targets,
+        changes::SourceSelection,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    syntax::{
+        box_source_headers::{BoxHeaderRole as Role, capture_box_headers},
+        parse::ParsedFile,
+    },
+};
+const BOXED: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/library/alloc/src/boxed.rs");
+const DEREF: &str =
+    include_str!("../../fixtures/upstream/rustc-checkout/library/core/src/ops/deref.rs");
+fn capture(
+    text: &str,
+    module: &[&str],
+    cfg: &CfgSet,
+) -> lrr::source::box_contract_headers::BoxTargetHeaders {
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity::current(),
+    )
+    .unwrap();
+    let source = SourceSelection {
+        path: SourcePath::new(format!(
+            "library/{}/src/{}.rs",
+            module[0],
+            module[1..].join("/")
+        ))
+        .unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(module[0].as_bytes()),
+            module_path: module[1..].iter().map(|s| s.to_string()).collect(),
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let headers = capture_box_headers(&parsed, &source, cfg).unwrap();
+    capture_box_targets(&parsed, &headers, cfg).unwrap()
+}
+#[test]
+fn original_box_impl_target_has_exact_source_parent_definition_and_type() {
+    let targets = capture(BOXED, &["alloc", "boxed"], &CfgSet::guest_default());
+    let target = targets.target(Role::DerefImpl).unwrap();
+    assert_eq!(target.definition().declared_name, "Target");
+    assert_eq!(target.bounds(), "");
+    assert_eq!(target.value(), Some("T"));
+    assert_eq!(
+        target.definition().enclosing_impl,
+        Some(target.parent_header())
+    );
+    assert_ne!(target.header().fingerprint(), target.parent_header());
+}
+#[test]
+fn original_deref_trait_target_is_distinct_from_impl_target_and_has_no_default() {
+    let targets = capture(DEREF, &["core", "ops", "deref"], &CfgSet::guest_default());
+    let target = targets.target(Role::DerefTrait).unwrap();
+    assert_eq!(target.bounds(), "?Sized");
+    assert_eq!(target.value(), None);
+    assert!(targets.target(Role::DerefMutTrait).is_none());
+}
+#[test]
+fn cfg_disabled_associated_target_is_not_replaced_by_spelled_default() {
+    let targets = capture(
+        "impl<T:?Sized,A:Allocator> Deref for Box<T,A>{#[cfg(any())] type Target=T;fn deref(&self)->&T{self}}",
+        &["alloc", "boxed"],
+        &CfgSet::guest_default(),
+    );
+    assert!(targets.target(Role::DerefImpl).is_none());
+}
+#[test]
+fn duplicate_enabled_target_is_a_real_ambiguity_not_first_name_wins() {
+    let text = "impl<T:?Sized,A:Allocator> Deref for Box<T,A>{type Target=T;type Target=();fn deref(&self)->&T{self}}";
+    let cfg = CfgSet::guest_default();
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(text.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity::current(),
+    )
+    .unwrap();
+    let source = SourceSelection {
+        path: SourcePath::new("library/alloc/src/boxed.rs").unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(b"fixture alloc"),
+            module_path: vec!["boxed".into()],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let headers = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    assert!(capture_box_targets(&parsed, &headers, &cfg).is_err());
+}
+
+#[test]
+fn associated_target_capture_refuses_changed_cfg_attachment() {
+    let cfg = CfgSet::guest_default();
+    let parsed = ParsedFile::parse_declarations(
+        &SourceBlob::new(BOXED.as_bytes().to_vec()).unwrap(),
+        ProfileIdentity::current(),
+    )
+    .unwrap();
+    let source = SourceSelection {
+        path: SourcePath::new("library/alloc/src/boxed.rs").unwrap(),
+        outline: OutlineKey {
+            parse: parsed.key(),
+            crate_key: Digest::of_bytes(b"pure fixture alloc"),
+            module_path: vec!["boxed".into()],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let headers = capture_box_headers(&parsed, &source, &cfg).unwrap();
+    let mut changed = cfg;
+    changed.atoms.insert("no_global_oom_handling".into());
+    assert!(capture_box_targets(&parsed, &headers, &changed).is_err());
+}
