--- /dev/null
+++ b/crates/lrr/src/engine/run_byte_comparisons.rs
@@ -0,0 +1,176 @@
+//! Reached source/member admission for byte equality in resolved runtime macros.
+use super::*;
+use crate::{
+    core::digest::Digest,
+    db::dependency::{InputKey, InputValue},
+    facade::byte_equality::{ByteEqualityMember, is_byte_reference},
+    ir::op::NumericBinary,
+    syntax::{
+        body_index::{ExpressionKind, NodeRole},
+        parse::ParseKey,
+    },
+};
+#[derive(Clone, Eq, PartialEq)]
+pub(crate) struct AdmittedByteComparison {
+    pc: PcKey,
+    source: ParseKey,
+    cfg: Digest,
+    recipe: Digest,
+    member: ByteEqualityMember,
+    operator: NumericBinary,
+    left: SlotId,
+    right: SlotId,
+    destination: SlotId,
+}
+impl AdmittedByteComparison {
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.source.profile.semantics.capacity())?
+            .checked_add(self.member.allocated_bytes()?)
+    }
+    pub(crate) fn operands(&self) -> (SlotId, SlotId, SlotId, bool) {
+        (
+            self.left,
+            self.right,
+            self.destination,
+            self.operator == NumericBinary::Ne,
+        )
+    }
+    pub(crate) fn require(
+        &self,
+        frame: &Frame,
+        store: &GuestStore,
+        op: &Op,
+    ) -> Result<(), Diagnostic> {
+        let Op::NumericBinary {
+            operator,
+            left,
+            right,
+            destination,
+        } = op
+        else {
+            return Err(call_fault("byte comparison is not the admitted operator"));
+        };
+        if frame.pc() != &self.pc
+            || frame.body.profile() != &self.source.profile
+            || frame.body.cfg().fingerprint() != self.cfg
+            || (*operator, *left, *right, *destination)
+                != (self.operator, self.left, self.right, self.destination)
+        {
+            return Err(call_fault(
+                "byte PartialEq PC/operator/source binding differs",
+            ));
+        }
+        let left_source = frame
+            .source_view_ref(*left)?
+            .ok_or_else(|| call_fault("byte PartialEq left source absent"))?;
+        let right_source = frame
+            .source_view_ref(*right)?
+            .ok_or_else(|| call_fault("byte PartialEq right source absent"))?;
+        self.member
+            .require(frame.body.profile(), left_source, right_source)?;
+        let (l, r) = self.member.shapes();
+        store.require_static_byte_value(frame.cell(*left)?, l.length())?;
+        store.require_static_byte_value(frame.cell(*right)?, r.length())
+    }
+}
+impl RunMachine {
+    pub(super) fn prepare_macro_byte_comparison(
+        &mut self,
+        db: &mut Database,
+        contexts: &[super::super::runtime_macros::RuntimeMacroContext<'_>],
+        id: super::super::install::RecipeId,
+    ) -> Result<(), Diagnostic> {
+        let key = self.frame.pc();
+        let node = self
+            .frame
+            .body
+            .nodes()
+            .get(key.node as usize)
+            .ok_or_else(|| call_fault("byte comparison node absent"))?;
+        if node.role != NodeRole::Expression(ExpressionKind::Macro) {
+            return self.frame.admit_byte_comparison(None);
+        }
+        let installed = self.installed.get(id)?;
+        let mut selected = None;
+        for op in installed.recipe().operations.iter() {
+            let Op::NumericBinary {
+                operator: operator @ (NumericBinary::Eq | NumericBinary::Ne),
+                left,
+                right,
+                destination,
+            } = op
+            else {
+                continue;
+            };
+            if !is_byte_reference(self.frame.source_view_ref(*left)?)
+                && !is_byte_reference(self.frame.source_view_ref(*right)?)
+            {
+                continue;
+            }
+            if selected
+                .replace((op, *operator, *left, *right, *destination))
+                .is_some()
+            {
+                return Err(call_fault(
+                    "byte comparison phase contains multiple selected operators",
+                ));
+            }
+        }
+        let Some((op, operator, left, right, destination)) = selected else {
+            return self.frame.admit_byte_comparison(None);
+        };
+        let fingerprint = installed.recipe().fingerprint();
+        for context in contexts {
+            let source = context.source();
+            let Some(handle) = source
+                .outline()
+                .items
+                .iter()
+                .filter_map(|item| item.body.as_ref())
+                .find(|handle| handle.key() == key.body)
+            else {
+                continue;
+            };
+            if !matches!(db.input(&InputKey::DefinitionSource(key.body.definition)).as_deref(), Some(InputValue::DefinitionSource(parse)) if parse == &source.selection().outline.parse)
+                || !matches!(db.input(&InputKey::DefinitionBody(key.body.definition)).as_deref(), Some(InputValue::DefinitionBody(body)) if body == handle)
+                || !matches!(db.input(&InputKey::CapturedSource(source.selection().location_identity())).as_deref(), Some(InputValue::CapturedSource(selected)) if selected == source.selection())
+            {
+                return Err(call_fault("byte comparison source publication changed"));
+            }
+            let current = context
+                .resolve_at(
+                    &self.frame.body,
+                    key,
+                    self.runtime_no_item_proofs.values(),
+                    Some((&self.frame, &self.store)),
+                )?
+                .ok_or_else(|| call_fault("byte comparison current intrinsic absent"))?;
+            if current.recipe.recipe().fingerprint() != fingerprint {
+                return Err(call_fault("byte comparison current source recipe differs"));
+            }
+            let member = context.byte_equality_member(
+                self.frame
+                    .source_view_ref(left)?
+                    .ok_or_else(|| call_fault("byte comparison left source absent"))?,
+                self.frame
+                    .source_view_ref(right)?
+                    .ok_or_else(|| call_fault("byte comparison right source absent"))?,
+            )?;
+            let admission = AdmittedByteComparison {
+                pc: key.clone(),
+                source: source.selection().outline.parse.clone(),
+                cfg: source.selection().outline.cfg,
+                recipe: fingerprint,
+                member,
+                operator,
+                left,
+                right,
+                destination,
+            };
+            admission.require(&self.frame, &self.store, op)?;
+            return self.frame.admit_byte_comparison(Some(admission));
+        }
+        Err(call_fault("byte comparison current source context absent"))
+    }
+}
