+//! Store invariants supplement the unchanged rustc token-pair witness in syntax.
+use super::*;
+use crate::runtime::{cell::byte_literals::StaticByteChunkPoll, shape::ByteLiteralTarget};
+
+fn operand(store: &mut GuestStore, site: &[u8], bytes: &[u8], view: ByteLiteralTarget) -> CellId {
+    let frame = store.new_frame_anchor().unwrap();
+    let plan = store
+        .prepare_static_bytes(
+            crate::core::digest::Digest::of_bytes(site),
+            bytes,
+            view,
+            None,
+            true,
+        )
+        .unwrap();
+    let ty = plan.reference_type();
+    let ticket = if bytes.len() <= 256 {
+        store.instantiate_static_bytes(plan).unwrap()
+    } else {
+        let mut cursor = store.prepare_static_byte_chunks(plan).unwrap();
+        let mut fuel = RunFuel::new(100_000).unwrap();
+        loop {
+            match store.advance_static_byte_chunks(&mut cursor, &mut fuel) {
+                StaticByteChunkPoll::Dispatch { .. } => {}
+                StaticByteChunkPoll::Ready => {
+                    break store.commit_static_byte_chunks(&mut cursor).unwrap();
+                }
+                StaticByteChunkPoll::Failed(error) => panic!("{error:?}"),
+            }
+        }
+    };
+    let cell = store
+        .new_cell(
+            StorageContract::Exact(ty),
+            true,
+            CellOwner::FrameSlot { frame, slot: 0 },
+        )
+        .unwrap();
+    store.initialize(cell, ticket).unwrap();
+    cell
+}
+
+fn store() -> GuestStore {
+    GuestStore::new(1, 20_000, 8 << 20).unwrap()
+}
+
+#[test]
+fn byte_comparison_bounds_work_and_fuel_without_allocating_or_mutating_owners() {
+    for view in [ByteLiteralTarget::Array, ByteLiteralTarget::Slice] {
+        let mut store = store();
+        let left = operand(&mut store, b"left", &[7; 600], view);
+        let right = operand(&mut store, b"right", &[7; 600], view);
+        let before = (
+            store.budget.handles(),
+            store.budget.bytes(),
+            store.state(left).unwrap(),
+        );
+        let mut cursor = store.prepare_static_byte_comparison(left, right).unwrap();
+        assert!(cursor.metadata_bytes() < 1024);
+        let mut fuel = RunFuel::new(600).unwrap();
+        for pairs in [256, 256] {
+            assert_eq!(
+                store
+                    .advance_static_byte_comparison(&mut cursor, &mut fuel)
+                    .unwrap(),
+                StaticByteComparisonPoll::Dispatch { pairs }
+            );
+        }
+        assert_eq!(
+            store
+                .advance_static_byte_comparison(&mut cursor, &mut fuel)
+                .unwrap(),
+            StaticByteComparisonPoll::Complete {
+                equal: true,
+                pairs: 88
+            }
+        );
+        assert_eq!(fuel.snapshot().used, 600);
+        assert!(
+            store
+                .advance_static_byte_comparison(&mut cursor, &mut fuel)
+                .is_err()
+        );
+        assert_eq!(
+            before,
+            (
+                store.budget.handles(),
+                store.budget.bytes(),
+                store.state(left).unwrap()
+            )
+        );
+    }
+}
+
+#[test]
+fn byte_comparison_short_circuits_but_cannot_skip_cancelled_empty_or_identical_operands() {
+    let mut store = store();
+    let left = operand(&mut store, b"left", &[7; 600], ByteLiteralTarget::Array);
+    let mut other = [7; 600];
+    other[511] = 8;
+    let right = operand(&mut store, b"right", &other, ByteLiteralTarget::Slice);
+    let mut cursor = store.prepare_static_byte_comparison(left, right).unwrap();
+    let mut fuel = RunFuel::new(600).unwrap();
+    assert_eq!(
+        store
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticByteComparisonPoll::Dispatch { pairs: 256 }
+    );
+    assert_eq!(
+        store
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticByteComparisonPoll::Complete {
+            equal: false,
+            pairs: 256
+        }
+    );
+    assert_eq!(fuel.snapshot().used, 512);
+    let empty = operand(&mut store, b"empty", b"", ByteLiteralTarget::Array);
+    for (a, b) in [(empty, empty), (left, left), (left, empty)] {
+        let mut cursor = store.prepare_static_byte_comparison(a, b).unwrap();
+        let mut fuel = RunFuel::new(1000).unwrap();
+        fuel.cancellation().cancel();
+        assert!(
+            store
+                .advance_static_byte_comparison(&mut cursor, &mut fuel)
+                .is_err()
+        );
+        assert_eq!(fuel.snapshot().used, 0);
+        assert!(cursor.terminal);
+    }
+    let mut cursor = store.prepare_static_byte_comparison(left, empty).unwrap();
+    let mut fuel = RunFuel::new(1).unwrap();
+    assert_eq!(
+        store
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticByteComparisonPoll::Complete {
+            equal: false,
+            pairs: 0
+        }
+    );
+    assert_eq!(fuel.snapshot().used, 0);
+}
+
+#[test]
+fn byte_comparison_refuses_cross_store_reset_replaced_operand_and_fuel_replay() {
+    let mut first = store();
+    let left = operand(&mut first, b"left", &[7; 600], ByteLiteralTarget::Array);
+    let right = operand(&mut first, b"right", &[7; 600], ByteLiteralTarget::Array);
+    let mut second = store();
+    let other_left = operand(&mut second, b"left", &[7; 600], ByteLiteralTarget::Array);
+    let other_right = operand(&mut second, b"right", &[7; 600], ByteLiteralTarget::Array);
+    assert_eq!(
+        (left.bits(), right.bits()),
+        (other_left.bits(), other_right.bits())
+    );
+    let mut cursor = first.prepare_static_byte_comparison(left, right).unwrap();
+    let mut fuel = RunFuel::new(1000).unwrap();
+    assert!(
+        second
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .is_err()
+    );
+    assert_eq!(fuel.snapshot().used, 0);
+    assert!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .is_err()
+    );
+
+    let mut cursor = first.prepare_static_byte_comparison(left, right).unwrap();
+    let mut short = RunFuel::new(256).unwrap();
+    assert_eq!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut short)
+            .unwrap(),
+        StaticByteComparisonPoll::Dispatch { pairs: 256 }
+    );
+    assert!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut short)
+            .is_err()
+    );
+    assert_eq!(short.snapshot().used, 256);
+    assert!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .is_err()
+    );
+
+    let mut cursor = first.prepare_static_byte_comparison(left, right).unwrap();
+    let reference = first.reference_from_cell(right).unwrap();
+    let ticket = first.reference_ticket(reference).unwrap();
+    let replaced = first.replace(left, ticket).unwrap();
+    first.discard(replaced).unwrap();
+    assert!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .is_err()
+    );
+    assert_eq!(fuel.snapshot().used, 0);
+
+    let mut cursor = first.prepare_static_byte_comparison(left, right).unwrap();
+    first.reset(2).unwrap();
+    assert!(
+        first
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .is_err()
+    );
+    assert_eq!(fuel.snapshot().used, 0);
+}
+
+#[test]
+fn byte_comparison_rejects_unowned_roots_mutable_leases_and_damaged_field_edges() {
+    let mut store = store();
+    let left = operand(&mut store, b"left", &[7; 600], ByteLiteralTarget::Array);
+    let right = operand(&mut store, b"right", &[7; 600], ByteLiteralTarget::Array);
+    let reference = store.reference_from_cell(left).unwrap();
+    let root = store.references.get(reference).unwrap().root.cell;
+    let owner = store.cells.get(root).unwrap().owner;
+    let frame = store.new_frame_anchor().unwrap();
+    store.cells.get_mut(root).unwrap().owner = CellOwner::FrameSlot { frame, slot: 0 };
+    assert!(store.prepare_static_byte_comparison(left, right).is_err());
+    store.cells.get_mut(root).unwrap().owner = owner;
+    store.references.get_mut(reference).unwrap().access = Access::Mutable;
+    assert!(store.prepare_static_byte_comparison(left, right).is_err());
+    store.references.get_mut(reference).unwrap().access = Access::Shared;
+    let mut cursor = store.prepare_static_byte_comparison(left, right).unwrap();
+    let mut fuel = RunFuel::new(1000).unwrap();
+    assert_eq!(
+        store
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .unwrap(),
+        StaticByteComparisonPoll::Dispatch { pairs: 256 }
+    );
+    let (_, storage) = store.place_object(root).unwrap();
+    let field = storage.fields[256];
+    store.cells.get_mut(field).unwrap().owner = CellOwner::FrameSlot { frame, slot: 0 };
+    assert!(
+        store
+            .advance_static_byte_comparison(&mut cursor, &mut fuel)
+            .is_err()
+    );
+    assert_eq!(fuel.snapshot().used, 257);
+    assert!(cursor.terminal);
+}
