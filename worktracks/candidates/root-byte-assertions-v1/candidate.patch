@@ -0,0 +1,47 @@
+//! A current source receipt never changes a literal destination's type itself.
+use super::*;
+use crate::{engine::run::byte_macro_literals::AdmittedMacroByteLiteral, ir::op::LiteralRecipe};
+impl Frame {
+    pub(super) fn macro_byte_literal_bytes(&self) -> Option<usize> {
+        self.macro_byte_literal
+            .as_ref()
+            .map_or(Some(0), |proof| proof.allocated_bytes())
+    }
+    pub(crate) fn admit_macro_byte_literal(
+        &mut self,
+        admission: Option<AdmittedMacroByteLiteral>,
+    ) -> Result<(), Diagnostic> {
+        if self.has_byte_literal_activation()
+            && match (&self.macro_byte_literal, &admission) {
+                (None, None) => false,
+                (Some(old), Some(new)) => !old.same_binding(new),
+                _ => true,
+            }
+        {
+            return Err(invalid("active byte literal source receipt changed"));
+        }
+        let extra = admission
+            .as_ref()
+            .map_or(Some(0), |proof| proof.allocated_bytes());
+        Self::metadata_bytes(&self.body, self.parameter_metadata_count())
+            .and_then(|n| n.checked_add(self.constructor_mapping_bytes))
+            .and_then(|n| n.checked_add(self.projection_bytes))
+            .and_then(|n| n.checked_add(self.source_field_bytes()?))
+            .and_then(|n| n.checked_add(self.byte_literal_activation_bytes()?))
+            .and_then(|n| n.checked_add(extra?))
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        self.macro_byte_literal = admission;
+        Ok(())
+    }
+    pub(crate) fn require_macro_byte_literal(
+        &self,
+        literal: &LiteralRecipe,
+        destination: SlotId,
+    ) -> Result<(), Diagnostic> {
+        self.macro_byte_literal
+            .as_ref()
+            .ok_or_else(|| invalid("macro byte literal requires current source admission"))?
+            .require(&self.body, self.pc(), literal, destination)
+    }
+}
