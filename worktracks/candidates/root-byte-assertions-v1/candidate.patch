+//! Original-source admission controls, distinct from the full-main runtime witness.
+use super::*;
+use crate::{
+    core::profile::ProfileIdentity,
+    engine::standalone_macros::CompletedStandaloneRuntimeMacros,
+    expand::source_discovery::{SourceDiscovery, SourceDiscoveryStep},
+    source::{
+        changes::{PreparedSourceInputs, SourceSelection, SourceSelectionOutcome, SourceUnitInput},
+        manifest::Namespace,
+        snapshot::{CfgSet, SourceBlob, SourcePath},
+    },
+    traits::term::{ConstTerm, RegionTerm, TyTerm},
+};
+const ORIGINAL: &str = include_str!(
+    "../../../../fixtures/upstream/rustc-checkout/tests/ui/lexer/crlf-in-byte-string-literal.rs"
+);
+fn discovery(view: &PreparedSourceView, graph: Digest) -> SourceDiscovery {
+    let mut d = SourceDiscovery::new(
+        vec![view.share()],
+        view.outline().root_scope.clone(),
+        Namespace::Type,
+        graph,
+        1,
+    )
+    .unwrap()
+    .with_declarative(
+        Digest::of_bytes(b"byte-macro-dispatch-expansions"),
+        Digest::of_bytes(b"byte-macro-dispatch-generations"),
+    )
+    .unwrap()
+    .with_compiler(std::sync::Arc::new(
+        crate::frontend::compile_input_catalog::CompileInputCatalog::standalone(
+            &view.selection().outline.parse.profile,
+        )
+        .unwrap(),
+    ))
+    .unwrap();
+    assert!(matches!(d.poll().unwrap(), SourceDiscoveryStep::Sealed(_)));
+    d
+}
+fn start_source(
+    source: &str,
+    edition: u16,
+    fuel: u64,
+) -> (
+    Database,
+    RunMachine,
+    CompletedStandaloneRuntimeMacros,
+    PreparedSourceInputs,
+) {
+    let profile = ProfileIdentity {
+        edition,
+        ..ProfileIdentity::current()
+    };
+    let cfg = CfgSet::guest_default();
+    let blob = SourceBlob::new(source.as_bytes().to_vec()).unwrap();
+    let path = SourcePath::new("crlf-in-byte-string-literal.rs").unwrap();
+    let unit = Digest::of_bytes(b"original-byte-macro-dispatch");
+    let selected = SourceSelection {
+        path: path.clone(),
+        outline: crate::db::key::OutlineKey {
+            parse: ParseKey {
+                content: blob.content(),
+                profile: profile.clone(),
+            },
+            crate_key: unit,
+            module_path: vec![],
+            cfg: cfg.fingerprint(),
+        },
+    };
+    let inputs = PreparedSourceInputs::refresh(
+        None,
+        vec![SourceUnitInput {
+            path,
+            crate_key: unit,
+            module_path: vec![],
+            profile,
+            cfg,
+            blob,
+        }],
+        Default::default(),
+    )
+    .unwrap();
+    let mut db = Database::default();
+    db.trace.detailed = true;
+    inputs.publish(&mut db).unwrap();
+    let SourceSelectionOutcome::Selected(view) = inputs.select(&selected).unwrap() else {
+        panic!("source absent")
+    };
+    let body = view
+        .outline()
+        .items
+        .iter()
+        .find(|item| item.def_key.declared_name == "main")
+        .unwrap()
+        .body
+        .as_ref()
+        .unwrap()
+        .key();
+    let d = discovery(&view, Digest::of_bytes(b"first-sealed-dispatch"));
+    let macros = CompletedStandaloneRuntimeMacros::from_discovery(&view, &d).unwrap();
+    db.begin_run().unwrap();
+    let run = RunMachine::start_with_discovery(&mut db, body, fuel, d)
+        .into_ready()
+        .unwrap()
+        .unwrap();
+    (db, run, macros, inputs)
+}
+
+// Execute actual preceding source recipes; stop before the original first byte
+// literal. No synthesized guest body or successful-error prefix is a stock pass.
+fn reach_literal(
+    db: &mut Database,
+    run: &mut RunMachine,
+    contexts: &[crate::engine::runtime_macros::RuntimeMacroContext<'_>],
+) -> (crate::engine::install::RecipeId, LiteralRecipe, SlotId) {
+    for _ in 0..64 {
+        let key = run.frame.pc().clone();
+        let node = &run.frame.body.nodes()[key.node as usize];
+        let prepared = if node.role == NodeRole::Expression(ExpressionKind::Macro) {
+            contexts.iter().find_map(|context| {
+                context
+                    .resolve_at(
+                        &run.frame.body,
+                        &key,
+                        run.runtime_no_item_proofs.values(),
+                        Some((&run.frame, &run.store)),
+                    )
+                    .unwrap()
+            })
+        } else {
+            None
+        };
+        let id = if let Some(prepared) = prepared {
+            if let Some(proof) = prepared.no_item {
+                run.retain_no_item_proof(proof).unwrap();
+            }
+            assert!(prepared.call.is_none() && prepared.primitive_method.is_none());
+            run.installed
+                .install_prepared(db, key, &prepared.recipe)
+                .unwrap()
+        } else {
+            run.installed
+                .resolve(db, key)
+                .into_ready()
+                .unwrap()
+                .unwrap()
+        };
+        for op in run.installed.get(id).unwrap().recipe().operations.iter() {
+            if let Op::Literal {
+                literal,
+                destination,
+                ..
+            } = op
+            {
+                if literal.kind == LiteralKind::ByteString {
+                    return (id, literal.clone(), *destination);
+                }
+            }
+        }
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+    }
+    panic!("original byte literal not reached");
+}
+#[test]
+fn original_byte_operand_requires_actual_macro_admission_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = start_source(ORIGINAL, edition, 1000);
+        let contexts = macros.contexts().unwrap();
+        let (id, literal, destination) = reach_literal(&mut db, &mut run, &contexts);
+        assert!(
+            run.frame
+                .require_macro_byte_literal(&literal, destination)
+                .is_err()
+        );
+        let before = (run.frame.fuel_snapshot(), run.store.budget().handles());
+        run.prepare_macro_byte_literal(&mut db, &contexts, id)
+            .unwrap();
+        run.frame
+            .require_macro_byte_literal(&literal, destination)
+            .unwrap();
+        assert_eq!(
+            (run.frame.fuel_snapshot(), run.store.budget().handles()),
+            before
+        );
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+        run.store
+            .require_static_byte_value(run.frame.cell(destination).unwrap(), Some(0))
+            .unwrap();
+        assert_eq!(
+            run.frame.source_view(destination).unwrap(),
+            Some(TyTerm::Ref(
+                RegionTerm::Static,
+                false,
+                Box::new(TyTerm::Array(
+                    Box::new(TyTerm::Primitive(crate::ir::op::PrimitiveType::U8)),
+                    ConstTerm::Value(0)
+                ))
+            ))
+        );
+        db.finish_run().unwrap();
+    }
+}
+#[test]
+fn macro_byte_admission_cannot_authorize_another_slot_span_phase_or_decode() {
+    let (mut db, mut run, macros, _) = start_source(ORIGINAL, 2024, 1000);
+    let contexts = macros.contexts().unwrap();
+    let (id, literal, destination) = reach_literal(&mut db, &mut run, &contexts);
+    run.prepare_macro_byte_literal(&mut db, &contexts, id)
+        .unwrap();
+    // Frame only exposes validation; the test constructs a receipt here inside
+    // its owning module to exercise changes to its private source bindings.
+    let Some(DecodedLiteral::ByteString(payload)) = &literal.decoded else {
+        panic!("byte payload")
+    };
+    let source = contexts[0].source();
+    let mut proof = AdmittedMacroByteLiteral {
+        pc: run.frame.pc().clone(),
+        source: source.selection().outline.parse.clone(),
+        cfg: source.selection().outline.cfg,
+        recipe: run.installed.get(id).unwrap().recipe().fingerprint(),
+        span: literal.source.clone(),
+        destination,
+        payload: payload.clone(),
+    };
+    proof
+        .require(&run.frame.body, run.frame.pc(), &literal, destination)
+        .unwrap();
+    assert!(
+        proof
+            .require(&run.frame.body, run.frame.pc(), &literal, SlotId(u32::MAX))
+            .is_err()
+    );
+    proof.span.relative_end += 1;
+    assert!(
+        proof
+            .require(&run.frame.body, run.frame.pc(), &literal, destination)
+            .is_err()
+    );
+    proof.span = literal.source.clone();
+    proof.pc.phase += 1;
+    assert!(
+        proof
+            .require(&run.frame.body, run.frame.pc(), &literal, destination)
+            .is_err()
+    );
+    proof.pc = run.frame.pc().clone();
+    proof.source.profile.edition = 2015;
+    assert!(
+        proof
+            .require(&run.frame.body, run.frame.pc(), &literal, destination)
+            .is_err()
+    );
+    proof.source.profile.edition = 2024;
+    // Independently resolving equal source bytes does not produce the installed
+    // decoder allocation bound into this run-owned receipt.
+    let other = contexts[0]
+        .resolve_at(
+            &run.frame.body,
+            run.frame.pc(),
+            run.runtime_no_item_proofs.values(),
+            Some((&run.frame, &run.store)),
+        )
+        .unwrap()
+        .unwrap();
+    let other_literal = other
+        .recipe
+        .recipe()
+        .operations
+        .iter()
+        .find_map(|op| match op {
+            Op::Literal { literal, .. } if literal.kind == LiteralKind::ByteString => Some(literal),
+            _ => None,
+        })
+        .unwrap();
+    assert!(
+        proof
+            .require(&run.frame.body, run.frame.pc(), other_literal, destination)
+            .is_err()
+    );
+    db.finish_run().unwrap();
+}
+#[test]
+fn macro_byte_admission_requires_context_and_current_source_generation_before_effects() {
+    let (mut db, mut run, macros, inputs) = start_source(ORIGINAL, 2024, 1000);
+    let contexts = macros.contexts().unwrap();
+    let (id, _, _) = reach_literal(&mut db, &mut run, &contexts);
+    let before = (run.frame.fuel_snapshot(), run.store.budget().handles());
+    assert!(run.prepare_macro_byte_literal(&mut db, &[], id).is_err());
+    run.prepare_macro_byte_literal(&mut db, &contexts, id)
+        .unwrap();
+    db.finish_run().unwrap();
+    inputs.publish(&mut db).unwrap();
+    db.begin_run().unwrap();
+    assert!(matches!(
+        run.poll_with_runtime_macros(&mut db, &contexts),
+        RunPoll::Fault(Diagnostic {
+            code: "LRR-E-INTERNAL-SNAPSHOT",
+            ..
+        })
+    ));
+    assert_eq!(
+        (run.frame.fuel_snapshot(), run.store.budget().handles()),
+        before
+    );
+    db.finish_run().unwrap();
+}
+
+#[test]
+fn unchanged_crlf_byte_assertions_complete_main_and_both_assertions_all_editions() {
+    for edition in [2015, 2018, 2021, 2024] {
+        let (mut db, mut run, macros, _) = start_source(ORIGINAL, edition, 1000);
+        let contexts = macros.contexts().unwrap();
+        let RunPoll::Completed(report) = run.poll_with_runtime_macros(&mut db, &contexts) else {
+            panic!("unchanged original byte assertions did not complete in edition{edition}");
+        };
+        assert!(matches!(report.value, ValueSummary::Unit));
+        assert_eq!(report.opcode_counters.started_by_opcode[26], 2);
+        assert_eq!(report.opcode_counters.started_by_opcode[10], 2);
+        assert_eq!(
+            report.opcode_counters.operations_started,
+            report.opcode_counters.operations_completed
+        );
+        db.finish_run().unwrap();
+    }
+}
+
+fn reach_comparison(
+    db: &mut Database,
+    run: &mut RunMachine,
+    contexts: &[crate::engine::runtime_macros::RuntimeMacroContext<'_>],
+) -> (crate::engine::install::RecipeId, Op) {
+    let (mut id, _, _) = reach_literal(db, run, contexts);
+    for _ in 0..64 {
+        let operations = &run.installed.get(id).unwrap().recipe().operations;
+        if let Some(op) = operations.iter().find(|op| {
+            matches!(
+                op,
+                Op::NumericBinary {
+                    operator: crate::ir::op::NumericBinary::Eq,
+                    ..
+                }
+            )
+        }) {
+            return (id, op.clone());
+        }
+        run.prepare_macro_byte_literal(db, contexts, id).unwrap();
+        assert!(matches!(
+            step::step(
+                &mut run.frame,
+                &mut run.store,
+                run.installed.get(id).unwrap()
+            )
+            .unwrap(),
+            StepOutcome::Next(_)
+        ));
+        let key = run.frame.pc().clone();
+        let prepared = contexts
+            .iter()
+            .find_map(|context| {
+                context
+                    .resolve_at(
+                        &run.frame.body,
+                        &key,
+                        run.runtime_no_item_proofs.values(),
+                        Some((&run.frame, &run.store)),
+                    )
+                    .unwrap()
+            })
+            .unwrap();
+        if let Some(proof) = prepared.no_item {
+            run.retain_no_item_proof(proof).unwrap();
+        }
+        id = run
+            .installed
+            .install_prepared(db, key, &prepared.recipe)
+            .unwrap();
+    }
+    panic!("original first comparison not reached")
+}
+#[test]
+fn byte_comparison_requires_current_source_and_member_before_operand_or_result_effects() {
+    let (mut db, mut run, macros, _) = start_source(ORIGINAL, 2024, 1000);
+    let contexts = macros.contexts().unwrap();
+    let (id, op) = reach_comparison(&mut db, &mut run, &contexts);
+    let before = (
+        run.frame.fuel_snapshot(),
+        run.store.budget().handles(),
+        serde_json::to_value(&run.frame.counters).unwrap(),
+    );
+    assert!(
+        run.frame
+            .prepare_byte_comparison(&op, &run.store)
+            .unwrap()
+            .is_none()
+    );
+    assert!(run.prepare_macro_byte_comparison(&mut db, &[], id).is_err());
+    run.prepare_macro_byte_comparison(&mut db, &contexts, id)
+        .unwrap();
+    assert!(
+        run.frame
+            .prepare_byte_comparison(&op, &run.store)
+            .unwrap()
+            .is_some()
+    );
+    let Op::NumericBinary {
+        left,
+        right,
+        destination,
+        ..
+    } = op
+    else {
+        panic!("comparison")
+    };
+    let original_source = run.frame.source_view(left).unwrap();
+    run.frame
+        .set_source_view(
+            left,
+            Some(TyTerm::Param(crate::traits::term::ParamKey {
+                definition: run.root_body.definition,
+                ordinal: 0,
+            })),
+        )
+        .unwrap();
+    assert!(
+        run.prepare_macro_byte_comparison(&mut db, &contexts, id)
+            .is_err()
+    );
+    assert!(run.frame.prepare_byte_comparison(&op, &run.store).is_err());
+    run.frame.set_source_view(left, original_source).unwrap();
+    let changed = Op::NumericBinary {
+        operator: crate::ir::op::NumericBinary::Ne,
+        left,
+        right,
+        destination,
+    };
+    assert!(
+        run.frame
+            .prepare_byte_comparison(&changed, &run.store)
+            .is_err()
+    );
+    let changed = Op::NumericBinary {
+        operator: crate::ir::op::NumericBinary::Eq,
+        left,
+        right,
+        destination: left,
+    };
+    assert!(
+        run.frame
+            .prepare_byte_comparison(&changed, &run.store)
+            .is_err()
+    );
+    assert_eq!(
+        (
+            run.frame.fuel_snapshot(),
+            run.store.budget().handles(),
+            serde_json::to_value(&run.frame.counters).unwrap()
+        ),
+        before
+    );
+    db.finish_run().unwrap();
+}
