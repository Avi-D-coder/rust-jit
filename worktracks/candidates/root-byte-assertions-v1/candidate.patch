diff --git a/crates/lrr/src/vm/frame_byte_comparisons.rs b/crates/lrr/src/vm/frame_byte_comparisons.rs
new file mode 100644
--- /dev/null
+++ b/crates/lrr/src/vm/frame_byte_comparisons.rs
@@ -0,0 +1,213 @@
+//! Bounded selected byte PartialEq execution, with one result publication.
+use super::*;
+use crate::{
+    engine::run::byte_comparisons::AdmittedByteComparison,
+    ir::op::{Op, PrimitiveType},
+    runtime::cell::byte_comparison::{StaticByteComparison, StaticByteComparisonPoll},
+    traits::term::TyTerm,
+};
+pub(super) struct BoundByteComparison {
+    pc: PcKey,
+    operation_index: usize,
+    left: CellId,
+    right: CellId,
+    destination: CellId,
+    destination_epoch: u32,
+    scope: ScopeId,
+    prior_source: Option<TyTerm>,
+    physical: StaticByteComparison,
+}
+impl Frame {
+    pub(crate) fn admit_byte_comparison(
+        &mut self,
+        proof: Option<AdmittedByteComparison>,
+    ) -> Result<(), Diagnostic> {
+        if self.byte_comparison_activation.is_some() && self.byte_comparison != proof {
+            return Err(invalid("active byte comparison source admission changed"));
+        }
+        Self::metadata_bytes(&self.body, self.parameter_metadata_count())
+            .and_then(|n| n.checked_add(self.constructor_mapping_bytes))
+            .and_then(|n| n.checked_add(self.projection_bytes))
+            .and_then(|n| n.checked_add(self.source_field_bytes()?))
+            .and_then(|n| n.checked_add(self.macro_byte_literal_bytes()?))
+            .and_then(|n| n.checked_add(self.byte_literal_activation_bytes()?))
+            .and_then(|n| {
+                n.checked_add(
+                    proof
+                        .as_ref()
+                        .map_or(Some(0), AdmittedByteComparison::allocated_bytes)?,
+                )
+            })
+            .and_then(|n| {
+                n.checked_add(
+                    self.byte_comparison_activation
+                        .as_ref()
+                        .map_or(Some(0), |a| {
+                            std::mem::size_of::<BoundByteComparison>()
+                                .checked_add(a.physical.metadata_bytes())?
+                                .checked_add(
+                                    a.prior_source
+                                        .as_ref()
+                                        .map_or(Some(0), TyTerm::heap_bytes)?,
+                                )
+                        })?,
+                )
+            })
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        self.byte_comparison = proof;
+        Ok(())
+    }
+    pub(crate) fn has_byte_comparison_activation(&self) -> bool {
+        self.byte_comparison_activation.is_some()
+    }
+    pub(crate) fn byte_comparison_operation_index(&self) -> Option<usize> {
+        self.byte_comparison_activation
+            .as_ref()
+            .map(|a| a.operation_index)
+    }
+    pub(crate) fn prepare_byte_comparison(
+        &self,
+        op: &Op,
+        store: &GuestStore,
+    ) -> Result<Option<StaticByteComparison>, Diagnostic> {
+        if !matches!(op, Op::NumericBinary { .. }) {
+            return Ok(None);
+        }
+        let Some(proof) = &self.byte_comparison else {
+            return Ok(None);
+        };
+        self.require_store(store)?;
+        proof.require(self, store, op)?;
+        let (left, right, destination, _) = proof.operands();
+        self.preflight_source_view(destination, Some(&TyTerm::Primitive(PrimitiveType::Bool)))?;
+        self.preflight_write_type(destination, TypeId(2), store)?;
+        store
+            .prepare_static_byte_comparison(self.cell(left)?, self.cell(right)?)
+            .map(Some)
+    }
+    pub(crate) fn begin_byte_comparison(
+        &mut self,
+        index: usize,
+        op: &Op,
+        physical: StaticByteComparison,
+        store: &mut GuestStore,
+    ) -> Result<(), Diagnostic> {
+        if self.status != FrameStatus::Running
+            || self.byte_comparison_activation.is_some()
+            || self.byte_activation.is_some()
+            || self.copy_activation.is_some()
+            || self.cleanup_activation.is_some()
+            || self.constant_activation.is_some()
+        {
+            return Err(invalid("byte comparison overlaps another activation"));
+        }
+        let proof = self
+            .byte_comparison
+            .as_ref()
+            .ok_or_else(|| invalid("byte comparison source admission absent"))?;
+        proof.require(self, store, op)?;
+        let (left, right, destination, _) = proof.operands();
+        physical.require_operands(self.cell(left)?, self.cell(right)?)?;
+        let prior_source = self.source_view_ref(destination)?.cloned();
+        Self::metadata_bytes(&self.body, self.parameter_metadata_count())
+            .and_then(|n| n.checked_add(self.constructor_mapping_bytes))
+            .and_then(|n| n.checked_add(self.projection_bytes))
+            .and_then(|n| n.checked_add(self.source_field_bytes()?))
+            .and_then(|n| n.checked_add(self.macro_byte_literal_bytes()?))
+            .and_then(|n| n.checked_add(proof.allocated_bytes()?))
+            .and_then(|n| n.checked_add(std::mem::size_of::<BoundByteComparison>()))
+            .and_then(|n| n.checked_add(physical.metadata_bytes()))
+            .and_then(|n| n.checked_add(prior_source.as_ref().map_or(Some(0), TyTerm::heap_bytes)?))
+            .filter(|n| *n <= 32 << 20)
+            .ok_or_else(crate::runtime::arena::resource)?;
+        self.reserve_primitive_operator_result(destination, store)?;
+        let cell = self.prepare_write(destination, store)?;
+        self.byte_comparison_activation = Some(BoundByteComparison {
+            pc: self.pc.clone(),
+            operation_index: index,
+            left: self.cell(left)?,
+            right: self.cell(right)?,
+            destination: cell,
+            destination_epoch: store.location_epoch(cell)?,
+            scope: self.slot(destination)?.scope,
+            prior_source,
+            physical,
+        });
+        Ok(())
+    }
+    pub(crate) fn check_byte_comparison_activation(
+        &self,
+        index: usize,
+        op: &Op,
+        store: &GuestStore,
+    ) -> Result<(SlotId, bool), Diagnostic> {
+        self.require_store(store)?;
+        let proof = self
+            .byte_comparison
+            .as_ref()
+            .ok_or_else(|| invalid("byte comparison source admission disappeared"))?;
+        proof.require(self, store, op)?;
+        let (left, right, destination, negate) = proof.operands();
+        let a = self
+            .byte_comparison_activation
+            .as_ref()
+            .ok_or_else(|| invalid("byte comparison activation absent"))?;
+        if self.status != FrameStatus::Running
+            || self.pc != a.pc
+            || index != a.operation_index
+            || self.cell(left)? != a.left
+            || self.cell(right)? != a.right
+            || self.slot(destination)?.cell != Some(a.destination)
+            || self.slot(destination)?.scope != a.scope
+            || self.source_view_ref(destination)? != a.prior_source.as_ref()
+            || store.location_epoch(a.destination)? != a.destination_epoch
+            || self.byte_activation.is_some()
+            || self.copy_activation.is_some()
+            || self.cleanup_activation.is_some()
+            || self.constant_activation.is_some()
+        {
+            return Err(invalid("byte comparison continuation binding changed"));
+        }
+        a.physical.require_operands(a.left, a.right)?;
+        self.preflight_write_type(destination, TypeId(2), store)?;
+        self.preflight_source_view(destination, Some(&TyTerm::Primitive(PrimitiveType::Bool)))?;
+        Ok((destination, negate))
+    }
+    pub(crate) fn advance_byte_comparison(
+        &mut self,
+        index: usize,
+        op: &Op,
+        store: &mut GuestStore,
+    ) -> Result<bool, Diagnostic> {
+        let (destination, negate) = self.check_byte_comparison_activation(index, op, store)?;
+        let mut a = self
+            .byte_comparison_activation
+            .take()
+            .ok_or_else(|| invalid("byte comparison activation disappeared"))?;
+        let poll = store.advance_static_byte_comparison(&mut a.physical, &mut self.fuel);
+        self.counters.fuel_used = self.fuel.snapshot().used;
+        match poll? {
+            StaticByteComparisonPoll::Dispatch { pairs } => {
+                if pairs > 256 {
+                    return Err(invalid("byte comparison dispatch exceeded pair bound"));
+                }
+                self.byte_comparison_activation = Some(a);
+                Ok(false)
+            }
+            StaticByteComparisonPoll::Complete { equal, pairs } => {
+                if pairs > 256 {
+                    return Err(invalid("byte comparison completion exceeded pair bound"));
+                }
+                self.fuel.poll()?;
+                let ticket = store.ticket(ValueRepr::boolean(equal != negate))?;
+                if let Err(error) = self.write(destination, ticket, store) {
+                    store.discard(ticket)?;
+                    return Err(error);
+                }
+                self.set_source_view(destination, Some(TyTerm::Primitive(PrimitiveType::Bool)))?;
+                Ok(true)
+            }
+        }
+    }
+}
