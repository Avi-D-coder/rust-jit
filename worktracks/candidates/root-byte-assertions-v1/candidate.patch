+++ b/crates/lrr/src/facade/byte_equality.rs
@@ -0,0 +1,245 @@
+//! Closed core PartialEq declarations for shared U8 array/slice operands.
+//! Source terms select members; runtime descriptors only check that selection.
+use crate::{
+    core::{
+        diagnostic::Diagnostic,
+        digest::{Digest, StableEncoder},
+        profile::ProfileIdentity,
+    },
+    ir::op::PrimitiveType,
+    traits::term::{ConstTerm, TyTerm},
+};
+use std::sync::Arc;
+fn fault(message: &str) -> Diagnostic {
+    Diagnostic::new("LRR-E-TYPE-CONTEXT", message.into())
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ByteShape {
+    Array(u32),
+    Slice,
+}
+impl ByteShape {
+    pub(crate) fn length(self) -> Option<u32> {
+        match self {
+            Self::Array(n) => Some(n),
+            Self::Slice => None,
+        }
+    }
+}
+fn shape(source: &TyTerm) -> Option<ByteShape> {
+    let TyTerm::Ref(_, false, pointee) = source else {
+        return None;
+    };
+    match pointee.as_ref() {
+        TyTerm::Array(element, ConstTerm::Value(n))
+            if **element == TyTerm::Primitive(PrimitiveType::U8) =>
+        {
+            u32::try_from(*n).ok().map(ByteShape::Array)
+        }
+        TyTerm::Slice(element) if **element == TyTerm::Primitive(PrimitiveType::U8) => {
+            Some(ByteShape::Slice)
+        }
+        _ => None,
+    }
+}
+pub(crate) fn is_byte_reference(source: Option<&TyTerm>) -> bool {
+    source.and_then(shape).is_some()
+}
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub(crate) struct ByteEqualityMember {
+    profile: Arc<ProfileIdentity>,
+    identity: Digest,
+    left: TyTerm,
+    right: TyTerm,
+    left_shape: ByteShape,
+    right_shape: ByteShape,
+}
+impl ByteEqualityMember {
+    pub(crate) fn require(
+        &self,
+        profile: &ProfileIdentity,
+        left: &TyTerm,
+        right: &TyTerm,
+    ) -> Result<(), Diagnostic> {
+        if profile != self.profile.as_ref() || left != &self.left || right != &self.right {
+            return Err(fault("byte PartialEq source operands/profile changed"));
+        }
+        Ok(())
+    }
+    pub(crate) fn shapes(&self) -> (ByteShape, ByteShape) {
+        (self.left_shape, self.right_shape)
+    }
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>()
+            .checked_add(std::mem::size_of::<ProfileIdentity>())?
+            .checked_add(2 * std::mem::size_of::<usize>())?
+            .checked_add(self.profile.semantics.capacity())?
+            .checked_add(self.left.heap_bytes()?)?
+            .checked_add(self.right.heap_bytes()?)
+    }
+}
+#[derive(Debug, Clone)]
+pub(crate) struct ByteEqualityFacet {
+    profile: Arc<ProfileIdentity>,
+    identity: Digest,
+}
+impl ByteEqualityFacet {
+    pub(crate) fn for_profile(profile: &ProfileIdentity) -> Result<Self, Diagnostic> {
+        profile.validate_source()?;
+        let mut e = StableEncoder::new("lrr/v1/core-byte-partial-eq-facet");
+        e.record(profile);
+        e.digest(super::unit(profile, "core"));
+        // Shared-reference forwarding, primitive U8 equality and the four
+        // pinned array/slice implementation families, including equal-N arrays.
+        for contract in [
+            "PartialEq::eq",
+            "&A:&B forwarding",
+            "u8:eq",
+            "[u8;N]:[u8;N]",
+            "[u8;N]:[u8]",
+            "[u8]:[u8;N]",
+            "[u8]:[u8]",
+        ] {
+            e.string(contract);
+        }
+        Ok(Self {
+            profile: Arc::new(profile.clone()),
+            identity: e.finish(),
+        })
+    }
+    pub(crate) fn profile(&self) -> &ProfileIdentity {
+        &self.profile
+    }
+    pub(crate) fn identity(&self) -> Digest {
+        self.identity
+    }
+    pub(crate) fn metadata_bytes(&self) -> Result<usize, Diagnostic> {
+        std::mem::size_of::<Self>()
+            .checked_add(std::mem::size_of::<ProfileIdentity>())
+            .and_then(|n| n.checked_add(2 * std::mem::size_of::<usize>()))
+            .and_then(|n| n.checked_add(self.profile.semantics.capacity()))
+            .ok_or_else(|| fault("byte PartialEq facet metadata overflow"))
+    }
+    pub(crate) fn select(
+        &self,
+        profile: &ProfileIdentity,
+        left: &TyTerm,
+        right: &TyTerm,
+    ) -> Result<ByteEqualityMember, Diagnostic> {
+        if profile != self.profile.as_ref() {
+            return Err(fault("byte PartialEq compiler profile differs"));
+        }
+        let l = shape(left)
+            .ok_or_else(|| fault("byte PartialEq left source is not a closed shared U8 view"))?;
+        let r = shape(right)
+            .ok_or_else(|| fault("byte PartialEq right source is not a closed shared U8 view"))?;
+        if matches!((l, r), (ByteShape::Array(a), ByteShape::Array(b)) if a != b) {
+            return Err(fault("array PartialEq requires equal source const lengths"));
+        }
+        let mut e = StableEncoder::new("lrr/v1/core-byte-partial-eq-instance");
+        e.digest(self.identity);
+        e.record(left);
+        e.record(right);
+        Ok(ByteEqualityMember {
+            profile: self.profile.clone(),
+            identity: e.finish(),
+            left: left.clone(),
+            right: right.clone(),
+            left_shape: l,
+            right_shape: r,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        frontend::{
+            compile_input_catalog::CompileInputCatalog, runtime_macro_catalog::RuntimeMacroCatalog,
+        },
+        traits::term::{ParamKey, RegionTerm},
+    };
+    fn reference(shape: ByteShape) -> TyTerm {
+        let element = Box::new(TyTerm::Primitive(PrimitiveType::U8));
+        TyTerm::Ref(
+            RegionTerm::Static,
+            false,
+            Box::new(match shape {
+                ByteShape::Array(n) => TyTerm::Array(element, ConstTerm::Value(n.into())),
+                ByteShape::Slice => TyTerm::Slice(element),
+            }),
+        )
+    }
+    #[test]
+    fn core_byte_equality_selects_source_impl_and_requires_actual_compiler_inventory() {
+        for edition in [2015, 2018, 2021, 2024] {
+            let profile = ProfileIdentity {
+                edition,
+                ..ProfileIdentity::current()
+            };
+            let actual = CompileInputCatalog::standalone(&profile)
+                .unwrap()
+                .runtime_catalog()
+                .unwrap()
+                .unwrap();
+            let macro_only = RuntimeMacroCatalog::standard(&profile).unwrap();
+            for l in [ByteShape::Array(0), ByteShape::Array(600), ByteShape::Slice] {
+                for r in [ByteShape::Array(0), ByteShape::Array(600), ByteShape::Slice] {
+                    let left = reference(l);
+                    let right = reference(r);
+                    assert!(
+                        macro_only
+                            .byte_equality_member(&profile, &left, &right)
+                            .is_err()
+                    );
+                    let result = actual.byte_equality_member(&profile, &left, &right);
+                    if matches!((l,r), (ByteShape::Array(a),ByteShape::Array(b)) if a!=b) {
+                        assert!(result.is_err());
+                    } else {
+                        let selected = result.unwrap();
+                        selected.require(&profile, &left, &right).unwrap();
+                        assert_eq!(selected.shapes(), (l, r));
+                        assert!(selected.allocated_bytes().unwrap() < 4096);
+                    }
+                }
+            }
+            let array = reference(ByteShape::Array(600));
+            let rigid = TyTerm::Param(ParamKey {
+                definition: Digest([90; 32]),
+                ordinal: 0,
+            });
+            assert!(
+                actual
+                    .byte_equality_member(&profile, &rigid, &array)
+                    .is_err()
+            );
+            assert!(
+                actual
+                    .byte_equality_member(&profile, &array, &rigid)
+                    .is_err()
+            );
+            let mutable = TyTerm::Ref(
+                RegionTerm::Static,
+                true,
+                Box::new(TyTerm::Slice(Box::new(TyTerm::Primitive(
+                    PrimitiveType::U8,
+                )))),
+            );
+            assert!(
+                actual
+                    .byte_equality_member(&profile, &mutable, &array)
+                    .is_err()
+            );
+            let foreign = ProfileIdentity {
+                edition: if edition == 2015 { 2024 } else { 2015 },
+                ..profile.clone()
+            };
+            assert!(
+                actual
+                    .byte_equality_member(&foreign, &array, &array)
+                    .is_err()
+            );
+        }
+    }
+}
