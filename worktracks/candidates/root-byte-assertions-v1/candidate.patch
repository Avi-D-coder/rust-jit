+//! Current compiler-intrinsic source admission for a byte literal in opaque
+//! macro operands. A verified recipe alone cannot grant that source authority.
+use super::*;
+use crate::{
+    core::digest::Digest,
+    db::dependency::{InputKey, InputValue},
+    ir::op::{DecodedLiteral, LiteralKind, LiteralRecipe},
+    syntax::{
+        body_index::{ExpressionKind, NodeRole},
+        byte_string_literals::ByteStringLiteral,
+        parse::ParseKey,
+        spans::BodySpan,
+    },
+};
+
+/// Constructed only after current source/name resolution reproduces the actual
+/// installed operation. It is run-owned, never a cached query or guest value.
+pub(crate) struct AdmittedMacroByteLiteral {
+    pc: PcKey,
+    source: ParseKey,
+    cfg: Digest,
+    recipe: Digest,
+    span: BodySpan,
+    destination: SlotId,
+    payload: ByteStringLiteral,
+}
+impl AdmittedMacroByteLiteral {
+    pub(crate) fn allocated_bytes(&self) -> Option<usize> {
+        std::mem::size_of::<Self>()
+            .checked_add(self.source.profile.semantics.capacity())?
+            .checked_add(self.payload.allocated_bytes()?)
+    }
+    pub(crate) fn same_binding(&self, other: &Self) -> bool {
+        self.pc == other.pc
+            && self.source == other.source
+            && self.cfg == other.cfg
+            && self.recipe == other.recipe
+            && self.span == other.span
+            && self.destination == other.destination
+            && self.payload.same_decoded_payload(&other.payload)
+    }
+    pub(crate) fn require(
+        &self,
+        body: &BodyIndex,
+        pc: &PcKey,
+        literal: &LiteralRecipe,
+        destination: SlotId,
+    ) -> Result<(), Diagnostic> {
+        let node = body
+            .nodes()
+            .get(pc.node as usize)
+            .ok_or_else(|| call_fault("macro byte literal source node missing"))?;
+        let Some(DecodedLiteral::ByteString(payload)) = &literal.decoded else {
+            return Err(call_fault("macro byte literal decoder certificate missing"));
+        };
+        if &self.pc != pc
+            || &pc.body != body.body()
+            || self.source.profile != *body.profile()
+            || self.cfg != body.cfg().fingerprint()
+            || node.role != NodeRole::Expression(ExpressionKind::Macro)
+            || !node.runtime_scalar_slots.contains(&destination)
+            || self.span != literal.source
+            || self.span.body_key != pc.body
+            || self.span.relative_start < node.range.start
+            || self.span.relative_end > node.range.end
+            || self.span.relative_start >= self.span.relative_end
+            || self.destination != destination
+            || literal.kind != LiteralKind::ByteString
+            || !self.payload.same_decoded_payload(payload)
+        {
+            return Err(call_fault(
+                "macro byte literal source/phase/destination differs",
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl RunMachine {
+    pub(super) fn prepare_macro_byte_literal(
+        &mut self,
+        db: &mut Database,
+        contexts: &[super::super::runtime_macros::RuntimeMacroContext<'_>],
+        id: super::super::install::RecipeId,
+    ) -> Result<(), Diagnostic> {
+        let key = self.frame.pc();
+        let node = self
+            .frame
+            .body
+            .nodes()
+            .get(key.node as usize)
+            .ok_or_else(|| call_fault("macro byte literal frame node missing"))?;
+        if node.role != NodeRole::Expression(ExpressionKind::Macro) {
+            return self.frame.admit_macro_byte_literal(None);
+        }
+        let installed = self.installed.get(id)?;
+        let mut literals = installed
+            .recipe()
+            .operations
+            .iter()
+            .filter_map(|op| match op {
+                Op::Literal {
+                    literal,
+                    destination,
+                    ..
+                } if literal.kind == LiteralKind::ByteString => Some((literal, *destination)),
+                _ => None,
+            });
+        let Some((literal, destination)) = literals.next() else {
+            return self.frame.admit_macro_byte_literal(None);
+        };
+        if literals.next().is_some() {
+            return Err(call_fault(
+                "macro byte literal phase contains multiple literals",
+            ));
+        }
+        let fingerprint = installed.recipe().fingerprint();
+        for context in contexts {
+            let source = context.source();
+            let Some(handle) = source
+                .outline()
+                .items
+                .iter()
+                .filter_map(|item| item.body.as_ref())
+                .find(|handle| handle.key() == key.body)
+            else {
+                continue;
+            };
+            if !matches!(db.input(&InputKey::DefinitionSource(key.body.definition)).as_deref(), Some(InputValue::DefinitionSource(parse)) if parse == &source.selection().outline.parse)
+                || !matches!(db.input(&InputKey::DefinitionBody(key.body.definition)).as_deref(), Some(InputValue::DefinitionBody(body)) if body == handle)
+                || !matches!(db.input(&InputKey::CapturedSource(source.selection().location_identity())).as_deref(), Some(InputValue::CapturedSource(selected)) if selected == source.selection())
+            {
+                return Err(call_fault("macro byte literal source publication changed"));
+            }
+            // This redoes real lexical/compiler macro selection, not a spelling
+            // check. A user/shadowed/unresolved macro cannot produce this receipt.
+            let current = context
+                .resolve_at(
+                    &self.frame.body,
+                    key,
+                    self.runtime_no_item_proofs.values(),
+                    Some((&self.frame, &self.store)),
+                )?
+                .ok_or_else(|| call_fault("macro byte literal current intrinsic absent"))?;
+            if current.recipe.recipe().fingerprint() != fingerprint {
+                return Err(call_fault(
+                    "macro byte literal current source recipe differs",
+                ));
+            }
+            let Some(DecodedLiteral::ByteString(payload)) = &literal.decoded else {
+                return Err(call_fault("macro byte literal payload absent"));
+            };
+            let admission = AdmittedMacroByteLiteral {
+                pc: key.clone(),
+                source: source.selection().outline.parse.clone(),
+                cfg: source.selection().outline.cfg,
+                recipe: fingerprint,
+                span: literal.source.clone(),
+                destination,
+                payload: payload.clone(),
+            };
+            admission.require(&self.frame.body, key, literal, destination)?;
+            return self.frame.admit_macro_byte_literal(Some(admission));
+        }
+        Err(call_fault(
+            "macro byte literal current source context absent",
+        ))
+    }
+}
+
