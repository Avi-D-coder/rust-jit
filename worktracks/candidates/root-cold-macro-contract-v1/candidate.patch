+#[test]
+fn unresolved_initializer_macro_blocks_discovery_without_evaluating_any_body() {
+    // Spec 8.5 / 50: unknown expression macros can introduce impls. Cold
+    // evaluation does not authorize a false complete declaration catalogue.
+    const SOURCE: &str = "const MAC:u32=missing_initializer!();fn main(){let _=MAC;}";
+    for edition in [2015, 2018, 2021, 2024] {
+        let (db, _) = world_with_macro_frontier(SOURCE, edition, true);
+        assert_no_initializer_demand(&db);
+    }
+}
