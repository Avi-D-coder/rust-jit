+#[test]
+fn utf8_argument_capture_rejects_changed_source_access_and_store_before_effects() {
+    let (mut frame, store, slot) = literal_argument(2024);
+    let captured = ClosedReferenceArgument::capture(&frame, slot, &store).unwrap();
+    let effects = (
+        store.budget().handles(),
+        store.budget().bytes(),
+        store.type_metadata_bytes(),
+        frame.fuel_snapshot(),
+    );
+    for source in [
+        TyTerm::Ref(RegionTerm::Static, true, Box::new(TyTerm::Str)),
+        TyTerm::Ref(
+            RegionTerm::Static,
+            false,
+            Box::new(TyTerm::Primitive(PrimitiveType::U8)),
+        ),
+    ] {
+        frame.set_source_view(slot, Some(source)).unwrap();
+        assert!(ClosedReferenceArgument::capture(&frame, slot, &store).is_err());
+    }
+    let other = GuestStore::new(1, 10_000, 4_000_000).unwrap();
+    let actual = ArgumentType {
+        source: captured.source.clone(),
+        descriptor: TypeId(captured.value.type_id),
+    };
+    assert!(captured.require(&other, &actual).is_err());
+    assert_eq!(
+        (
+            store.budget().handles(),
+            store.budget().bytes(),
+            store.type_metadata_bytes(),
+            frame.fuel_snapshot()
+        ),
+        effects
+    );
+}
