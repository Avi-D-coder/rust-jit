+#[test]
+fn str_header_receipt_rejects_changed_hint_and_expansion_epoch() {
+    let (mut db, view, graph) = source(BORROWED, 2024);
+    let callee = callable(&mut db, &view, &graph, "compare");
+    let QueryPoll::Ready(Ok(ArgumentHintPreparation::Ready(hints))) =
+        prepare_argument_hint(&mut db, &callee, &graph, &[&view], 0)
+    else {
+        panic!()
+    };
+    let proof = hints[0].closed_reference.as_ref().unwrap();
+    let mut wrong = hints[0].clone();
+    wrong.source = TyTerm::Ref(RegionTerm::Static, false, Box::new(TyTerm::Str));
+    assert_eq!(
+        proof.validate_hint(&wrong).unwrap_err().code,
+        "LRR-E-CALL-CONTEXT"
+    );
+    db.begin_expansion_epoch(1).unwrap();
+    assert_eq!(
+        proof.require_current(&mut db, &callee).unwrap_err().code,
+        "LRR-E-CALL-CONTEXT"
+    );
+}
