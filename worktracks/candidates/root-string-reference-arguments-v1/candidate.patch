+#[test]
+fn str_parameter_spelling_does_not_override_shadow_or_grant_mutable_view() {
+    for text in [
+        "type str=bool;fn take(x:&str){}fn main(){}",
+        "fn take(x:&mut str){}fn main(){}",
+    ] {
+        let (mut db, view, graph) = source(text, 2024);
+        let callee = callable(&mut db, &view, &graph, "take");
+        assert!(
+            ClosedReferenceParameter::capture(&mut db, &callee, &graph, &[&view], 0)
+                .unwrap()
+                .is_none()
+        );
+    }
+}
