 #[cfg(test)]
 mod hint_batch_tests {
     use super::*;
+    #[test]
+    fn byte_literal_batch_refusals_leave_no_partial_descriptor_prefix() {
+        // Resource fault injection after a pure preview: the configured worker
+        // budget fits one real array descriptor, but not the full slice batch.
+        let mut one = TypeRegistry::default();
+        one.intern(TypeKey::Array {
+            element: TypeId(9),
+            len: 5,
+        })
+        .unwrap();
+        let limit = one.metadata_bytes();
+        let mut registry = TypeRegistry::default();
+        let plan = registry
+            .preview_byte_literal_types(5, ByteLiteralTarget::Slice)
+            .unwrap();
+        registry.max_metadata_bytes = limit;
+        assert_eq!(
+            registry.commit_byte_literal_types(&plan).unwrap_err().code,
+            "LRR-E-METADATA-LIMIT"
+        );
+        assert!(registry.descriptors.is_empty());
+        assert!(registry.by_key.is_empty());
+        assert_eq!(registry.owned_bytes, 0);
+
+        // Validate a late malformed key before the otherwise valid array/slice
+        // prefix can be interned. This mutates only a private test plan.
+        let mut registry = TypeRegistry::default();
+        let mut plan = registry
+            .preview_byte_literal_types(5, ByteLiteralTarget::Slice)
+            .unwrap();
+        plan.keys.last_mut().unwrap().0 = TypeKey::Ref {
+            mutable: false,
+            target: TypeId(u32::MAX),
+        };
+        assert!(registry.commit_byte_literal_types(&plan).is_err());
+        assert!(registry.descriptors.is_empty());
+        assert!(registry.by_key.is_empty());
+        assert_eq!(registry.owned_bytes, 0);
+    }
+    #[test]
+    fn byte_literal_batches_reuse_complete_and_partially_present_keys() {
+        for view in [ByteLiteralTarget::Array, ByteLiteralTarget::Slice] {
+            for existing in 0..3 {
+                let mut registry = TypeRegistry::default();
+                let array = TypeKey::Array {
+                    element: TypeId(9),
+                    len: 5,
+                };
+                if existing >= 1 {
+                    registry.intern(array.clone()).unwrap();
+                }
+                if existing >= 2 {
+                    registry
+                        .intern(TypeKey::Slice { element: TypeId(9) })
+                        .unwrap();
+                }
+                let plan = registry.preview_byte_literal_types(5, view).unwrap();
+                registry.commit_byte_literal_types(&plan).unwrap();
+                assert_eq!(registry.find(&array), Some(plan.array));
+                assert_eq!(
+                    registry.find(&TypeKey::Ref {
+                        mutable: false,
+                        target: plan.target
+                    }),
+                    Some(plan.reference)
+                );
+                let before = (registry.descriptors.len(), registry.metadata_bytes());
+                let repeat = registry.preview_byte_literal_types(5, view).unwrap();
+                assert!(repeat.keys.is_empty());
+                registry.commit_byte_literal_types(&repeat).unwrap();
+                assert_eq!(
+                    (registry.descriptors.len(), registry.metadata_bytes()),
+                    before
+                );
+            }
+        }
+    }
