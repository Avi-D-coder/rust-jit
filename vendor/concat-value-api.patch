+fn concat_bytes_array_literal(lit: &tt::Literal) -> Result<String, ExpandError> {
+    let byte = match lit.kind {
+        tt::LitKind::Byte => unescape_byte(lit.text())
+            .map_err(|_| ExpandError::other(lit.span, "invalid byte literal"))?,
+        tt::LitKind::Integer if matches!(lit.text_and_suffix().1, "" | "u8") => {
+            concat_number_text(lit)?.parse::<u8>()
+                .map_err(|_| ExpandError::other(lit.span, "array byte is out of range"))?
+        }
+        _ => return Err(ExpandError::other(lit.span, "expected array byte literal")),
+    };
+    Ok(byte.escape_ascii().map(char::from).collect())
+}
