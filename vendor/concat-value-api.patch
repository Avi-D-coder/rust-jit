+// E-M011-002: Rust concat consumes semantic integers and separator-free floats.
+fn concat_number_text(literal: &tt::Literal) -> Result<String, ExpandError> {
+    let (text, suffix) = literal.text_and_suffix();
+    let integer_suffix = matches!(
+        suffix,
+        "" | "i8"
+            | "i16"
+            | "i32"
+            | "i64"
+            | "i128"
+            | "isize"
+            | "u8"
+            | "u16"
+            | "u32"
+            | "u64"
+            | "u128"
+            | "usize"
+            | "f32"
+            | "f64"
+    );
+    let valid_suffix = match literal.kind {
+        tt::LitKind::Integer => integer_suffix,
+        tt::LitKind::Float => matches!(suffix, "" | "f32" | "f64"),
+        _ => false,
+    };
+    if !valid_suffix {
+        return Err(ExpandError::other(literal.span, "invalid numeric suffix in concat"));
+    }
+    let text = text.replace('_', "");
+    if literal.kind == tt::LitKind::Float {
+        return Ok(text);
+    }
+    let (radix, digits) = if let Some(digits) = text.strip_prefix("0x") {
+        (16, digits)
+    } else if let Some(digits) = text.strip_prefix("0o") {
+        (8, digits)
+    } else if let Some(digits) = text.strip_prefix("0b") {
+        (2, digits)
+    } else {
+        (10, text.as_str())
+    };
+    u128::from_str_radix(digits, radix).map(|value| value.to_string()).map_err(|_| {
+        ExpandError::other(literal.span, "invalid or overflowing integer literal in concat")
+    })
 }
 
