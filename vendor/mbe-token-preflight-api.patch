+fn nightly_template_syntax(tokens: tt::TtIter<'_>) -> bool {
+    let mut dollar = false;
+    for token in tokens {
+        if dollar
+            && matches!(
+                &token,
+                tt::TtElement::Leaf(tt::Leaf::Punct(tt::Punct { char: '$', .. }))
+                    | tt::TtElement::Subtree(
+                        tt::Subtree {
+                            delimiter: tt::Delimiter { kind: tt::DelimiterKind::Brace, .. },
+                            ..
+                        },
+                        _
+                    )
+            )
+        {
+            return true;
+        }
+        dollar =
+            matches!(&token, tt::TtElement::Leaf(tt::Leaf::Punct(tt::Punct { char: '$', .. })));
+        if let tt::TtElement::Subtree(_, children) = token {
+            if nightly_template_syntax(children) {
+                return true;
+            }
+        }
+    }
+    false
 }
 
