{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LRR schema4 compile-time tool preparation records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics_profile",
    "toolchain",
    "graph",
    "inputs",
    "artifacts",
    "compile_env",
    "build_outputs"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "semantics_profile": {
      "const": "lrr-2024-v2"
    },
    "toolchain": {
      "$ref": "#/$defs/ToolchainRecord"
    },
    "graph": {
      "$ref": "#/$defs/UnitGraph"
    },
    "inputs": {
      "$ref": "#/$defs/InputInventory"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ToolArtifact"
      },
      "maxProperties": 100000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "compile_env": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CompileEnv"
      },
      "maxProperties": 100000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "build_outputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/BuildOutput"
      },
      "maxProperties": 100000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "$defs": {
    "ToolBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content",
        "selection",
        "version_verbose"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 65536
        },
        "content": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection": {
          "type": "string",
          "maxLength": 65536
        },
        "version_verbose": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "ToolchainRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner",
        "compiler",
        "compiler_commit",
        "host",
        "sysroot",
        "macro_server",
        "macro_protocol",
        "component_manifest",
        "component_manifest_content"
      ],
      "properties": {
        "planner": {
          "$ref": "#/$defs/ToolBinary"
        },
        "compiler": {
          "$ref": "#/$defs/ToolBinary"
        },
        "compiler_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "host": {
          "type": "string",
          "maxLength": 65536
        },
        "sysroot": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 65536
        },
        "macro_server": {
          "$ref": "#/$defs/ToolBinary"
        },
        "macro_protocol": {
          "const": 6
        },
        "component_manifest": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 65536
        },
        "component_manifest_content": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "CargoUnitKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "target_name",
        "target_kind",
        "role",
        "compile_target",
        "test_intent",
        "edition",
        "features",
        "profile_fingerprint",
        "cfg_fingerprint",
        "dependency_edges",
        "rustc_fingerprint"
      ],
      "properties": {
        "package": {
          "type": "string",
          "maxLength": 65536
        },
        "target_name": {
          "type": "string",
          "maxLength": 65536
        },
        "target_kind": {
          "enum": [
            "Library",
            "Binary",
            "IntegrationTest",
            "BuildScript",
            "ProcMacro"
          ]
        },
        "role": {
          "enum": [
            "Live",
            "Native",
            "BuildHost",
            "ProcMacroHost",
            "MacroExport"
          ]
        },
        "compile_target": {
          "type": "string",
          "maxLength": 65536
        },
        "test_intent": {
          "type": "boolean"
        },
        "edition": {
          "enum": [
            2015,
            2018,
            2021,
            2024
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "profile_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cfg_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependency_edges": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rustc_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "DependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "target",
        "public",
        "no_prelude",
        "no_unused"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "maxLength": 65536
        },
        "target": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public": {
          "type": "boolean"
        },
        "no_prelude": {
          "type": "boolean"
        },
        "no_unused": {
          "type": "boolean"
        }
      }
    },
    "NormalizedUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "mode",
        "source_path",
        "dependencies"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/CargoUnitKey"
        },
        "mode": {
          "enum": [
            "Build",
            "Check",
            "Test",
            "RunBuildScript"
          ]
        },
        "source_path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 65536
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          },
          "maxItems": 100000
        }
      }
    },
    "UnitGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "roots",
        "units"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NormalizedUnit"
          },
          "maxProperties": 100000,
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "CfgSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atoms",
        "values"
      ],
      "properties": {
        "atoms": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 65536
            },
            "maxItems": 100000,
            "uniqueItems": true
          },
          "maxProperties": 100000
        }
      }
    },
    "InputInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_files",
        "external_files",
        "environment",
        "directory_membership"
      ],
      "properties": {
        "source_files": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 100000,
          "propertyNames": {
            "type": "string",
            "pattern": "^/[^\\u0000]*$",
            "maxLength": 65536
          }
        },
        "external_files": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 100000,
          "propertyNames": {
            "type": "string",
            "pattern": "^/[^\\u0000]*$",
            "maxLength": 65536
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 65536
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 100000
        },
        "directory_membership": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
            },
            "maxItems": 100000,
            "uniqueItems": true
          },
          "maxProperties": 100000,
          "propertyNames": {
            "type": "string",
            "pattern": "^/[^\\u0000]*$",
            "maxLength": 65536
          }
        }
      }
    },
    "CompileEnv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "host",
        "target",
        "cfg",
        "cargo",
        "rustc_env",
        "declared",
        "out_dir"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host": {
          "type": "string",
          "maxLength": 65536
        },
        "target": {
          "type": "string",
          "maxLength": 65536
        },
        "cfg": {
          "$ref": "#/$defs/CfgSet"
        },
        "cargo": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          },
          "maxProperties": 100000
        },
        "rustc_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          },
          "maxProperties": 100000
        },
        "declared": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 65536
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 100000
        },
        "out_dir": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/[^\\u0000]*$",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ToolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content",
        "kind",
        "auxiliary"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 65536
        },
        "content": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "HostLibrary",
            "BuildProgram",
            "ProcMacroLibrary"
          ]
        },
        "auxiliary": {
          "type": "object",
          "maxProperties": 100000,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "GeneratedBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "path",
        "original_path",
        "content",
        "bytes"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
        },
        "original_path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 65536
        },
        "content": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "maxItems": 8388608
        }
      }
    },
    "GeneratedTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "out_dir",
        "directories",
        "files"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "out_dir": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 65536
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/GeneratedBlob"
          },
          "maxProperties": 100000,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
          }
        }
      }
    },
    "BuildOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "consumers",
        "tree",
        "cfgs",
        "rustc_env",
        "linked_libs",
        "linked_paths",
        "dependency_metadata"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "tree": {
          "$ref": "#/$defs/GeneratedTree"
        },
        "cfgs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "maxItems": 100000,
          "uniqueItems": true
        },
        "rustc_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          },
          "maxProperties": 100000
        },
        "linked_libs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "maxItems": 100000
        },
        "linked_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "maxItems": 100000
        },
        "dependency_metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          },
          "maxProperties": 100000
        }
      }
    }
  },
  "x-lrr-constraints": [
    "Rust ToolManifest::decode additionally rejects duplicate object keys before typed deserialization.",
    "Map keys must match recomputed unit/content identities; dependency graphs are bounded, rooted, ordered and acyclic.",
    "Only host-world tool artifacts are permitted. Generated bytes, producer units, consumer associations and OUT_DIR bindings must match.",
    "Unknown or stale schemas fail; consumers must verify current toolchain and input freshness before adoption.",
    "Manifest wire bytes are bounded to 64 MiB. JSON Schema alone does not establish these semantic or freshness checks."
  ]
}
